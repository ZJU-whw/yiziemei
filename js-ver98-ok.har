          "content": {
            "size": 48414,
            "mimeType": "text/html",
            "compression": 40275,
            "text": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html>\r\n<head>\r\n<title>免抵退税办理审核</title>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\r\n<script language=\"javascript\" type=\"text/javascript\"\r\n\tsrc=\"/swordweb/core/jsimport/Sword.js\"></script>\r\n<script language=\"javascript\" type='text/javascript'\r\n\tsrc=\"/ckts/gy/ckts_common.js\"></script>\r\n<link href=\"/common-css/xd.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n<style>\r\n#div3Table tr th div, #div3Table tr td div {\r\n\twidth: 100%;\r\n\theight: 100%;\r\n\tline-height: 22px;\r\n\ttext-align: center;\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n\t<div sword='PageInit' onsuccess=\"initShSuccess();\"></div>\r\n\t<!-- 如需增加hidden标签，请新增一个SwordForm -->\r\n\t<div sword='SwordForm' name='hidden' userdefine=\"true\"\r\n\t\tstyle=\"border: 0; display: none;\">\r\n\t\t<div name=\"lcswsxDm\" type=\"hidden\"></div>\r\n\t\t<!-- 流程税务事项代码 -->\r\n\t\t<div name=\"djxh\" type=\"hidden\"></div>\r\n\t\t<!-- 登记序号 -->\r\n\t\t<div name=\"shxydm\" type=\"hidden\"></div>\r\n\t\t<!-- 社会信用代码 -->\r\n\t\t<div name=\"tsswjgDm1\" type=\"hidden\"></div>\r\n\t\t<!-- 退税税务机关代码 -->\r\n\t\t<div name=\"lcslid\" type=\"hidden\"></div>\r\n\t\t<!-- 流程实例ID -->\r\n\t\t<div name=\"nsrsbh\" type=\"hidden\"></div>\r\n\t\t<!-- 纳税人识别号 -->\r\n\t\t<div name=\"hgqyDm\" type=\"hidden\"></div>\r\n\t\t<!-- 海关企业代码 -->\r\n\t\t<div name=\"hdslid\" type=\"hidden\"></div>\r\n\t\t<!-- 活动实例ID -->\r\n\t\t<div name=\"ssq\" type=\"hidden\"></div>\r\n\t\t<!-- 所属期 -->\r\n\t\t<div name=\"fsFlag\" type=\"hidden\" defValue='1'></div>\r\n\t\t<!-- 是否有复审 -->\r\n\t\t<div name=\"dcpgFlag\" type=\"hidden\" defValue='1'></div>\r\n\t\t<!-- 是否走调查评估 -->\r\n\t\t<div name=\"hddyid\" type=\"hidden\" defValue=\"mdtsb_sh\"></div>\r\n\t\t<!-- 分流流程实列id -->\r\n\t\t<div name=\"qdlcslid\" type=\"hidden\" defValue=\"\"></div>\r\n\t\t<!-- 免抵额 -->\r\n\t\t<div name=\"mdse\" type=\"hidden\" defValue=\"\"></div>\r\n\t\t<!-- 退税额 -->\r\n\t\t<div name=\"ytse\" type=\"hidden\" defValue=\"\"></div>\r\n\t\t<!-- 环节名称 -->\r\n\t\t<div name=\"hjmc\" type=\"hidden\" defValue=\"sh\"></div>\r\n\t\t<div name=\"shbz\" type=\"hidden\" defValue=\"N\"></div>\r\n\t</div>\r\n\r\n\t<div sword='SwordForm' name='qyxxForm' caption='企业信息' panel=\"true\"\r\n\t\tuserdefine=\"true\">\r\n\t\t<table class=\"tab_form\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t<colgroup>\r\n\t\t\t\t<col style=\"width: 13%\"></col>\r\n\t\t\t\t<col style=\"width: 20.3%\"></col>\r\n\t\t\t\t<col style=\"width: 13%\"></col>\r\n\t\t\t\t<col style=\"width: 20.3%\"></col>\r\n\t\t\t\t<col style=\"width: 13%\"></col>\r\n\t\t\t\t<col style=\"width: 20.4%\"></col>\r\n\t\t\t</colgroup>\r\n\t\t\t<tr>\r\n\t\t\t\t<th>海关企业代码</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"hgqyDm\" caption=\"海关企业代码\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>企业名称</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"nsrmc\" caption=\"企业名称\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>纳税人识别号</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"nsrsbh\" caption=\"纳税人识别号\" type=\"text\" readonly=\"true\"\r\n\t\t\t\t\tcss=\"text-align:center\" disable=\"\"  style=\"color: blue;text-decoration:underline\" onclick=\"queryCktsYhsCkqy();\"></div>\r\n\t\t\t\t\t<div name=\"hgqyDm\" caption=\"海关企业代码\" type=\"hidden\" defValue=\" \"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"ywPk\" type=\"hidden\" css=\"text-align:center\"\r\n\t\t\t\t\t\tdisable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"nsrmc\" caption=\"企业名称\" type=\"hidden\" defValue=\" \"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th>社会信用代码</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"shxydm\" caption=\"社会信用代码\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>是否无纸化企业</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"wzhqy\" caption=\"需提供收汇资料\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>分类管理类别</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"flglcd\" caption=\"分类管理类别\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th>办税人员</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"qybltmsryyxm\" caption=\"办税人员\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>办税人员联系方式</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"qybltmsryylxdh\" caption=\"办税人员联系方式\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"zjfxqy\" caption=\"总局风险企业\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"tglslysfwbz\" caption=\"零税率服务提供者\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"lslfw\" type=\"hidden\" css=\"text-align:center\"\r\n\t\t\t\t\t\tdisable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"tgshzl\" caption=\"需提供收汇资料\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"ssq\" caption=\"申报年月\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"sbpc\" caption=\"申报批次\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"ytse\" caption=\"申报退税额\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t\t<div name=\"mdse\" caption=\"申报免抵退\" type=\"hidden\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t\t<th>大型骨干外贸企业标识</th>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<div name=\"dxggwmqybz\" caption=\"大型骨干外贸企业标识\" type=\"text\"\r\n\t\t\t\t\t\tcss=\"text-align:center\" disable=\"true\"></div>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n\r\n\t<div name=\"tab1\" sword=\"SwordTab\" tabType=\"div\"\r\n\t\ttabTitles=\"向导,申报情况,其他参与计算数据\"\r\n\t\ttabDivs=\"divTab1,divTab2,divTab3\"></div>\r\n\t<div id=\"divTab1\" class=\"xddivsl\"></div>\r\n\t<div id=\"divTab2\">\r\n\t\t<table class=\"tab_form\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\r\n\t\t\tid=\"xxGrid_id\">\r\n\t\t\t<colgroup>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 13%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t\t<col style=\"width: 5%\"></col>\r\n\t\t\t\t<col style=\"width: 5%\"></col>\r\n\t\t\t\t<col style=\"width: 5%\"></col>\r\n\t\t\t\t<col style=\"width: 6%\"></col>\r\n\t\t\t</colgroup>\r\n\t\t\t<tr>\r\n\t\t\t\t<th colspan=\"3\" style=\"text-align: center\">受理</th>\r\n\t\t\t\t<th colspan=\"3\" style=\"text-align: center\">抽查情况</th>\r\n\t\t\t\t<th colspan=\"3\" style=\"text-align: center\">审核情况</th>\r\n\t\t\t\t<th colspan=\"3\" style=\"text-align: center\">调查评估情况</th>\r\n\t\t\t\t<th colspan=\"4\" style=\"text-align: center\">复核处理情况</th>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<th style=\"text-align: center\">序号</th>\r\n\t\t\t\t<th style=\"text-align: center\">申报数据</th>\r\n\t\t\t\t<th style=\"text-align: center\">明细条数</th>\r\n\t\t\t\t<th style=\"text-align: center\">抽查比例%</th>\r\n\t\t\t\t<th style=\"text-align: center\">抽查条数</th>\r\n\t\t\t\t<th style=\"text-align: center\">通过/未通过</th>\r\n\t\t\t\t<th style=\"text-align: center\">已处理/未处理</th>\r\n\t\t\t\t<th style=\"text-align: center\">产生疑点</th>\r\n\t\t\t\t<th style=\"text-align: center\">挑过/未挑过</th>\r\n\t\t\t\t<th style=\"text-align: center\">调查数量</th>\r\n\t\t\t\t<th style=\"text-align: center\">调查完成</th>\r\n\t\t\t\t<th style=\"text-align: center\">调查未完成</th>\r\n\t\t\t\t<th style=\"text-align: center\">已办理</th>\r\n\t\t\t\t<th style=\"text-align: center\">退回</th>\r\n\t\t\t\t<th style=\"text-align: center\">疑点待处理</th>\r\n\t\t\t\t<th style=\"text-align: center\">不予退税</th>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t\t<div sword=\"SwordGrid\" name=\"mdtDetail\" fzbtId=\"xxGrid_id\" dataY=\"440\"\r\n\t\t\tshowHeader=\"false\" fenye=\"false\" scrollX=\"130%\">\r\n\t\t\t<div caption=\"序号\" name=\"rowNum\" type=\"rowNum\" x=\"6%\" disable=\"true\"\r\n\t\t\t\tcss=\"text-align:center\"></div>\r\n\t\t\t<div caption=\"申报数据\" name=\"bzwm\" type=\"text\" disable=\"true\"\r\n\t\t\t\tcss=\"text-align:left\" x=\"13%\"></div>\r\n\t\t\t<div caption=\"明细条数\" name=\"slsl1\" type=\"a\" x=\"6%\" disable=\"false\"\r\n\t\t\t\tcss=\"text-align:right\" onclick=\"mdtCkmx();\"></div>\r\n\t\t\t<div caption=\"抽查比例\" name=\"rgcqBl\" x=\"6%\" disable=\"true\"\r\n\t\t\t\tcss=\"text-align:center\"></div>\r\n\t\t\t<div caption=\"抽查条数\" name=\"rgcqNum\" type=\"a\" disable=\"false\"\r\n\t\t\t\tcss=\"text-align:left\" x=\"6%\" onclick=\"mdtMxcc();\"></div>\r\n\t\t\t<div caption=\"通过/未通过\" name=\"rgwtgNum\" type=\"text\" x=\"6%\"\r\n\t\t\t\tdisable=\"true\" css=\"text-align:right\"></div>\r\n\t\t\t<!-- <div caption=\"审核通过 /未通过 \" name=\"jsjwtgNum\" type=\"text\" x=\"5%\"\r\n\t\t\t\tdisable=\"true\" css=\"text-align:right\"></div> -->\r\n\t\t\t<div caption=\"已处理/未处理\" name=\"jsjwtgNum\" type=\"text\" x=\"6%\"\r\n\t\t\t\tdisable=\"true\" css=\"text-align:right\"></div>\r\n\t\t\t<div caption=\"产生疑点\" name=\"jsjydNum\" type=\"a\" x=\"6%\" disable=\"false\"\r\n\t\t\t\tcss=\"text-align:right\" onclick=\"mdtCsyd();\"></div>\r\n\t\t\t<div caption=\"挑过/未挑过\" name=\"t