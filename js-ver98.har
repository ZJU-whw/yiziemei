            "text": "html {\n  line-height: 1.15;\n  -ms-text-size-adjust: 100%;\n  -webkit-text-size-adjust: 100%;\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  height: 100%;\n  -moz-osx-font-smoothing: grayscale;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n  font-family: Helvetica Neue, Helvetica, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Arial, sans-serif;\n}\n\n* {\n  padding: 0;\n  margin: 0;\n}\n\n*,\n*:before,\n*:after {\n  -webkit-box-sizing: inherit;\n  box-sizing: inherit;\n}\n\na,\na:focus,\na:hover {\n  cursor: pointer;\n  color: inherit;\n  text-decoration: none;\n}\n\n#app {\n  height: 100%;\n}\n\n.headerCls {\n  /* overflow: hidden; */\n  background-color: #fff;\n  z-index: 1;\n  position: fixed;\n  top: 0;\n  left: 0px;\n  right: 0px;\n  height: 70px;\n  padding-top: 5px;\n  padding-left: 5%;\n  display: none;\n}\n\n.header2_huiban {\n  display: none;\n  position: fixed;\n  top: 22px;\n  left: 60px;\n  z-index: 1;\n}\n\n.header2_kexin {\n  display: none;\n  position: fixed;\n  top: 22px;\n  left: 60px;\n  z-index: 1;\n}\n\n\n.page_box {\n  margin: 0;\n  padding: 0;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n}\n\n\n.pageBackground1 {\n  background: url(../image/login_bg1.png) repeat;\n}\n\n.pageBackground2 {\n  background: url(../image/新版登录页面背景.png) repeat;\n}\n\n\n.mainCls {\n  /* top: 60px; */\n  height: 100%;\n  width: 100%;\n  min-width: 1024px;\n\n  background-position: bottom;\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  -webkit-box-align: center;\n  -ms-flex-align: center;\n  align-items: center;\n  position: relative;\n}\n\n.mainCls .container {\n  width: 100%;\n  height: 100%;\n  min-width: 1024px;\n  position: relative;\n  margin: 0 auto;\n  overflow: hidden;\n}\n\n.mainCls .container .bgImgL {\n  display: inline-block;\n  position: relative;\n  top: 30px;\n  left: 2%;\n  width: 60%;\n  padding-left: 5%;\n  min-width: 610px;\n}\n\n.bgImgL {\n  display: inline-block;\n  position: relative;\n  top: 30px;\n  left: 2%;\n  width: 60%;\n  padding-left: 5%;\n  min-width: 610px;\n}\n\n\n.mainCls .container .formDivCls {\n  background: #E5EEFA;\n  position: absolute;\n  margin-top: -220px;\n  top: 50%;\n  right: 10%;\n  width: 480px;\n  height: 440px;\n}\n\n\n.mainCls .container .formDivCls .form_loginType {\n  text-align: center;\n  padding: 10px 50px 0px 50px;\n  /*width: 100%;*/\n  /*height: 400px;*/\n  height: 300px;\n  position: relative;\n}\n\n.mainCls .container .formDivCls .formContent {\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  position: relative;\n}\n\n.mainCls .container .formDivCls .btn_top_rgiht {\n  width: 60px;\n  height: 60px;\n  position: absolute;\n  right: -50px;\n  cursor: pointer;\n}\n\n\n.mainCls .container .formDivCls .form_otherLoginType_btn {\n  font-size: 16px;\n  /*padding-top: 48px;*/\n  line-height: 98px;\n  height: 98px;\n  text-align: center;\n\n}\n\n.mainCls .container .formDivCls .form_otherLoginType_btn .btn_login {\n  padding-left: 0px !important;\n  padding-right: 7px !important;\n}\n.mainCls .container .formDivCls .form_otherLoginType_btn .btn_login:last-child {\n  padding-right: 0px !important;\n}\n\n.mainCls .container .formDivCls .form_otherLoginType .form_otherLoginType_text {\n  text-align: center;\n}\n\n\n\n\n/*\n.mainCls .container .formDivCls .tabsCls {\n  width: 100%;\n  height: 74px;\n} */\n\n.el-row {\n  -webkit-box-sizing: border-box;\n  box-sizing: border-box;\n  position: relative;\n}\n\n.el-row::after,\n.el-row::before {\n  display: table;\n  content: \"\";\n}\n\n*,\n*:before,\n*:after {\n  -webkit-box-sizing: inherit;\n  box-sizing: inherit;\n}\n\n.el-row::after {\n  clear: both;\n}\n\n.el-row::after,\n.el-row::before {\n  display: table;\n  content: \"\";\n}\n\n.justifyCenterEnd {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  -webkit-box-pack: center;\n  -ms-flex-pack: center;\n  justify-content: center;\n  -webkit-box-align: end;\n  -