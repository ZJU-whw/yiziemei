            "mimeType": "application/javascript",
            "text": "var scripts = ['js/bluebird.min.js','js/fpr2.min.js','js/fpr.js']\nfor(var i=0;i<scripts.length;i++) {\n  var script = document.createElement('script');script.src = scripts[i];script.type='text/javascript';document.body.appendChild(script);\n}\n\nvar api = {\n  /*\n   *@functionName:   jsfn\n   *@params1: server_client_hello\n   *@description:serverHello\n   *@author: albert\n   *@date: 2023-07-15 09:44:36\n   *@version: V1.0.5\n  */\n  getLoginServerHello: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/cert/loginServerHello',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-12-05 15:53:38\n   *@version: V1.0.5\n  */\n\n  queryVersion: function (param, callb) {\n    this.sendReq({\n      url: '/acl/wh/app/query/version',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName: jsfn\n   *@params1:\n   {\n    \"access_token\":\"xxxxx\",\n    \"id_card\": \"证件号码\",\n    \"card_type\":\"证件类型\"\n    }\n   *@description:二次认证实人实证-校验证件号码\n   *@author: albert\n   *@date: 2023-08-26 17:12:07\n   *@version: V1.0.5\n  */\n  checkIdCard_Second: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/checkIdCard',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-09-14 15:47:28\n   *@version: V1.0.5\n  */\n  documentConfig: function (param, callb) {\n    this.sendReq({\n      url: '/acl/wh/documentConfig',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n\n  /*\n   *@functionName: jfsn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-08-26 10:24:48\n   *@version: V1.0.5\n  */\n  localDeviceFaceLogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/wh/tax/localDeviceFaceLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName: jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-08-26 17:15:42\n   *@version: V1.0.5\n  */\n  localDeviceFaceLogin_Second: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/localDeviceFaceLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-08-26 10:01:17\n   *@version: V1.0.5\n  */\n  createSerialNumber: function (param, callb) {\n    this.sendReq({\n      url: '/idmtax/wh/internal/taxPerson/createSerialNumber',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-08-26 10:01:17\n   *@version: V1.0.5\n  */\n  createSerialNumber_Second: function (param, callb) {\n    this.sendReq({\n      url: '/idmtax/internal/taxPerson/createSerialNumber',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  /*\n   *@functionName:   jsfn\n   *@params1:\n    {\n    \"id_card\": \"证件号码\",\n    \"card_type\":\"证件类型\"\n    }\n   *@description:\n   *@author: albert\n   *@date: 2023-08-26 09:19:00\n   *@version: V1.0.5\n  */\n  checkIdCard: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/wh/tax/checkIdCard',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-08-25 20:45:24\n   *@version: V1.0.5\n  */\n\n  getFileKey: function (param, callb) {\n    this.sendReq({\n      url: '/acl/wh/documentConfig?key=' + param,\n      method: 'get',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n *@functionName:   jsfn\n *@params1: server_client_hello\n *@description:serverHello\n *@author: albert\n *@date: 2023-07-15 09:44:36\n *@version: V1.0.5\n*/\n  getServerHello: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/cert/serverHello',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName:   jsfn\n   *@params1: 参数1\n   *@params2: 参数2\n   *@params3: 参数3\n   *@params4: 参数4\n   *@description:\n   *@author: albert\n   *@date: 2023-07-15 15:29:42\n   *@version: V1.0.5\n  */\n  getServerAuth: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/cert/serverAuth',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  secondServerAuth: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/cert/second/serverAuth',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },  \n\n  /*\n   *@functionName: jsfn\n   *@params1:\n   {\n \"server_client_hello\":\"123456781234566533522423453536363335363633242\",\n\"access_token\":\"xxxxx\",\n\"function_code\":\"00000\",\n\"link_id\":\"00000\"\n}\n   *@description:二次认证数字证书-第一步获取serverHello\n   *@author: albert\n   *@date: 2023-08-07 21:03:07\n   *@version: V1.0.5\n  */\n  getServerHello_second: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/serverHello',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n *@functionName: jsfn\n *@params1:\n {\n\"client_id\": \"12345678123456781234567812345678\",\n\"redirect_uri\": \"http://www.baidu.com\",\n\"identity\": \"身份标识\",\n\"client_pid\": \"门户id\",\n\"uuid\": \"134daf234sa234afdafawfqrqer2\",\n\"str_client_auth\": \"362737198802123456\",\n\"post_type\": \"0\"\n}\n *@description:二次认证数字证书-第一步获取serverHello\n *@author: albert\n *@date: 2023-08-07 21:03:07\n *@version: V1.0.5\n*/\n  getServerAuth_second: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/serverAuth',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  getNewSmsCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/user/account/getNewSmsCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  taxPersonBinding: function (param, callb, errcal) {\n    this.sendReq({\n      url: '/idmtax/internal/taxPerson/taxPersonBinding',\n      method: 'post',\n      data: param,\n      callb: callb,\n      errcal: 1\n    })\n  },\n\n\n  taxSmsLogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/taxSmsLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  taxSendSmsByPhone: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/taxSendSmsByPhone',\n      method: 'post',\n      data: param,\n      callb: callb,\n      errcal: 1\n    })\n  },\n\n  verifyCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/verifyCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 校验会话是否有效\n  verifyLogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/user/verifyLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 通过应用id查询登录等级\n  get_appLoginLevel: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/getAppLoginLevel',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 校验tpassCode，获取第二个域名的会话\n  verifyTpassCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/white/verifyTpassCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 系统登出接口\n  revokeToken: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/revokeToken',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 虚拟人员登录发送短信验证码\n  taxAdminSendSmsCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/taxAdminSendSmsCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 虚拟人员短信登录\n  taxAdminSmsCodeLogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/taxAdminSmsCodeLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  userinfo: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/userinfo',\n      method: 'post',\n      data: param,\n      callb: function (data) {\n        if (data && data.code == 1000) {\n          api.setUIDS(data && data.datagram && data.datagram.user_id)\n        }\n        callb(data)\n      }\n    })\n  },\n\n  passlogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/taxNameAndPassLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 多身份列表查询交易\n  identityList: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/identityList',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 多身份登录选择身份\n  selectIdentity: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/selectIdentity',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 对接外部系统切换身份\n  changeIdentity: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/changeIdentity',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 查询登出列表\n  getLogOutList: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/logOutList',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 乐企对接获取省局票据\n  getHideCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/getHideCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 乐企对接根据票据获取token\n  verifyHideCodeLogin: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/verifyHideCodeLogin',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 行政管理平台单点登录配置接口\n  queryAppPlatformList: function (callb) {\n    this.sendReq({\n      url: '/acl/appStraightIn/queryAppPlatformList',\n      method: 'post',\n      data: {},\n      callb: callb\n    })\n  },\n  // 登录配置接口\n  getLoginConfig: function (param, callb, returnErr) {\n    api.sendReq({\n      url: '/acl/swr/login/config/query',\n      method: 'post',\n      data: param,\n      callb: callb,\n      returnErr: returnErr\n    })\n  },\n  // 登录配置接口-第二因子\n  getApplicationTwoFactorList: function (param, callb, isAsync) {\n    api.sendReq({\n      url: '/authtax/tax/getApplicationTwoFactorList',\n      method: 'post',\n      data: param,\n      callb: callb,\n      async: isAsync == undefined ? true : isAsync\n    })\n  },\n\n  // 事务编号进行实名核验\n  faceCheck: function (param, callb) {\n    this.sendReq({\n      url: '/idmtax/wh/internal/taxPerson/faceCheck',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  // 登录创建二维码接口\n  createQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/createQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 登录消费二维码接口\n  verifyQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/tax/verifyQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  // 个税app扫码登录-校验二维码 (扫码登录)\n  getItsQrCodeStatus: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/tax/getItsQrCodeStatus',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 个税app扫码登录-登录创建二维码接口\n  getItsQrCode: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/tax/getItsQrCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 税务app扫码登录-校验二维码 (扫码登录)\n  checkTaxAppQrCode: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/wh/tax/checkTaxAppQrCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 税务app扫码登录-登录创建二维码接口\n  createTaxAppQrCode: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/wh/tax/createTaxAppQrCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 个税app扫码-二次认证创建二维码接口\n  createQRCodeOnceMore: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/oauth2/createQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 个税app扫码-二次认证校验二维码接口（扫码认证）\n  createScanItsQRCodeOnceMore: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/oauth2/createItsQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 税务app扫码-二次认证创建二维码接口\n  createTaxAppQRCodeOnceMore: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/oauth2/createTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  // 税务app扫码-二次认证校验二维码接口（扫码认证）\n  checkTaxAppQRCodeOnceMore: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/oauth2/checkTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName: jsfn\n   *@params1:\n   {\n    \"client_id\": \"应用id\",\n    \"redirect_uri\": \"回调地址\",\n    \"account\": \"税务人身份代码或证件号码\"\n    \"identity\": \"身份标识\",\n    \"client_pid\": \"门户id\"\n}\n   *@description:税务app扫脸登录-创建二维码\n   *@author: albert\n   *@date: 2023-11-06 17:19:59\n   *@version: V1.0.5\n  */\n  getTaxAppQRCode_login: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/wh/tax/getTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName: jsfn\n   *@params1:\n   {\n  \"privateKey”:”12345678”,\n  \"qrcode_id”:”qr100000234”,\n  \"client_id\": \"应用id\",\n  \"redirect_uri\": \"回调地址\",\n  \"identity\": \"身份标识\",\n  \"client_pid\": \"门户id\"\n  }\n   *@description:\n   *@author: albert\n   *@date: 2023-11-06 19:21:37\n   *@version: V1.0.5\n  */\n  verifyTaxAppQRCode_login: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/wh/tax/verifyTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  /*\n   *@functionName:   jsfn\n   *@params1:\n   {\n\"access_token\":\"xxxxx\",\n\"function_code\":\"00000\",\n\"link_id\":\"00000\"\n}\n   *@description:\n   *@author: albert\n   *@date: 2023-11-07 16:06:37\n   *@version: V1.0.5\n  */\n  getTaxAppQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/getTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  /*\n   *@functionName:   jsfn\n   *@params1:\n   {\n\"qrcode_id”:”qr100000234”\n}\n   *@description:\n   *@author: albert\n   *@date: 2023-11-07 16:09:29\n   *@version: V1.0.5\n  */\n  verifyTaxAppQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/verifyTaxAppQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n\n\n  // 二次认证消费二维码接口\n  verifyQRCodeOnceMore: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/verifyQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 二次认证消费二维码接口-- 个税APP进行扫码认证\n  verifyScanItsQRCodeOnceMore: function (param, callb) {\n    api.sendReq({\n      url: '/authtax/oauth2/verifyItsQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },  \n  // 二次认证发送短信\n  sendSmsByToken: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/sendSmsByToken',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 二次认证短信验证\n  verifySmsCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/verifySmsCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 初始绑定调用工作流入库\n  addKXUser: function (param, callb) {\n    this.sendReq({\n      url: '/eipuc/api/user/v1/user/addKXUser',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 驱动下载列表\n  driveQuery: function (param, callb) {\n    this.sendReq({\n      url: '/acl/wh/document/point/queryPage',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },  \n  // // 本地设备扫脸登录\n  // localDeviceFaceLogin: function (param, callb) {\n  //   this.sendReq({\n  //     url: '/authtax/tax/localDeviceFaceLogin',\n  //     method: 'post',\n  //     data: param,\n  //     callb: callb\n  //   })\n  // },\n  // 本地调起活体检测页面\n  checkLiveImage: function (param, callb) {\n    this.sendReqFace({\n      url: '/checkLiveImage',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 判断回调地址是否合法\n  checkRedirectUrl: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/wh/oauth2/checkRedirectUrl',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n  getPublicKeyUuid: function (callb, errcal) {\n    this.sendReq({\n      url: '/authtax/oauth2/getRsaPublicKey',\n      method: 'post',\n      data: {},\n      callb: function (data) {\n        if (data && data.code == 1000) {\n          var publicKey = data.datagram.publicKey// 获取公钥，存储cookies\n          localStorage.setItem('naturepublicKey', publicKey)\n          var uuid = data.datagram.uuid// 获取uuid，存储cookies\n          localStorage.setItem('natureuuid', uuid)\n          var idSel = data.datagram.idSel //获取纳税人快捷登录身份选择方式 0从高 1手动\n          localStorage.setItem('idSel', idSel)\n        }\n        callb(data)\n      },\n      errcal: errcal\n    })\n  },\n\n  /**\n   * 增强认证部分接口\n   */\n  // 发送短信验证码\n  enhancedAuthSendSms: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthSendSms',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 校验短信验证码\n  enhancedAuthVerifySmsCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthVerifySmsCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 个税app创建二维码\n  enhancedAuthCreateQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthCreateQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 个税app校验二维码\n  enhancedAuthVerifyQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthVerifyQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 税务app创建二维码\n  enhancedAuthTaxAppCreateQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthTaxAppCreateQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 税务app校验二维码\n  enhancedAuthTaxAppVerifyQRCode: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthTaxAppVerifyQRCode',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 证书增强认证第一步，获取ServerHello\n  enhancedAuthServerHello: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthServerHello',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n  // 证书增强认证第二步\n  enhancedAuthServerAuth: function (param, callb) {\n    this.sendReq({\n      url: '/authtax/oauth2/enhancedAuthServerAuth',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n  /**\n   *\n   * @param {*} param\n   * @param {*} callb\n   * 税务人员账号绑定校验接口，--在绑定功能发短信之前，提前做一次校验\n   */\n  BindingCheck: function (param, callb) {\n    this.sendReq({\n      url: '/idmtax/internal/taxPerson/taxPersonBindingCheck',\n      method: 'post',\n      data: param,\n      callb: callb\n    })\n  },\n\n\n\n\n  // // 压缩方法\n  // pakopackZip: function (packZipData){\n  //     //转普通数组\n  //     var arr = Array.from(pako.gzip(packZipData))\n  //     //获取Unicode编码对应字符串\n  //     var strArr = arr.map(function (x) {\n  //         return String.fromCharCode(x)\n  //     })\n  //     var ysdata = Base64.btoaPolyfill(strArr.join(''))\n  //     return ysdata\n  // },\n\n  sendReq: function (config) {\n    var that = this;\n    config.headers = {}\n    that.setDevIDAndUID(config)\n    var token = window.localStorage.token || $.cookie(\"token\") || $.cookie(\"tokenTemp\") || ''\n    config.headers['Authorization'] = token\n    config.headers['X-APP-CLIENTID'] = localStorage.getItem('clientId') || ''\n    config.headers['Content-Type'] = 'application/json'\n\n    var natureuuid = localStorage.getItem('natureuuid') || ''\n    config.headers['X-TEMP-INFO'] = natureuuid\n    var paramsData = {}\n    var getKey16; // 加密密钥\n    // ie8和正常得存\n    if (localStorage.getItem('new_key16')) {\n      getKey16 = localStorage.getItem('new_key16')\n    } else {\n      getKey16 = this.getK()\n    }\n    config.headers['X-NOT-ENCRYPT-INFO'] = getKey16 // 密钥是单独放到头里给后台\n    if (window.location.href.indexOf(\"innerSiteLogin.html\") > 0 || window.location.href.indexOf(\"areaLogin.html\") > 0\n     || window.location.href.indexOf(\"login.html\") > 0) {\n      localStorage.setItem(\"new_key16\", getKey16)\n    }\n    var getRSAData = ''\n    paramsData['zipCode'] = '0'\n    if (config.method === 'post') {\n      var encrypt = new JSEncrypt();\n      encrypt.setPublicKey(localStorage.getItem('naturepublicKey') || '');\n      // 4.使用公钥对生成的16位key进行SM2加密，结果放到headers X-KEY-INFO\n      config.headers['X-KEY-INFO'] = encrypt.encrypt(getKey16) || '123456789'\n      // 白名单不加密\n      if (config.url === '/authtax/oauth2/getPublicKey'\n        || config.url === '/authtax/oauth2/revokeToken'\n        || config.url === '/authtax/user/logout'\n        || config.url === '/authtax/oauth2/logOutList'\n        || config.url === '/authtax/user/checklogin'\n        || config.url === '/authtax/qrcode/verifyQRCode'\n        || config.url === '/authtax/white/verifyTpassCode'\n        || config.url === '/authtax/message/sendSmsCode'\n        || config.url === '/authtax/user/verifyLogin'\n        || config.url === '/authtax/tax/changeIdentity'\n        || config.url === '/authtax/tax/identityList'\n        || config.url === '/authtax/oauth2/userinfo'\n        || config.url === '/authtax/oauth2/sendSmsByToken'\n        || config.url === '/authtax/oauth2/verifySmsCode'\n        || config.url === '/authtax/oauth2/createQRCode'\n        || config.url === '/authtax/oauth2/createItsQRCode'\n        || config.url === '/authtax/oauth2/verifyQRCode'\n        || config.url === '/authtax/oauth2/verifyItsQRCode'\n        || config.url === '/authtax/oauth2/createTaxAppQRCode'\n        || config.url === '/authtax/oauth2/checkTaxAppQRCode'\n        || config.url === '/authtax/wh/tax/createTaxAppQrCode'\n        || config.url === '/authtax/wh/tax/checkTaxAppQrCode'\n        || config.url === '/acl/appStraightIn/queryAppPlatformList'\n        || config.url === '/authtax/tax/localDeviceFaceLogin'\n        || config.url === '/acl/swr/login/config/query'\n        || config.url === '/authtax/tax/getApplicationTwoFactorList'\n        || config.url === '/authtax/oauth2/checkRedirectUrl'\n        || config.url === '/authtax/message/captchaImage'\n        || config.url === '/authtax/oauth2/getAppLoginLevel'\n        || config.url === '/authtax/oauth2/checkIdCard'\n        || config.url === '/authtax/oauth2/serverHello'\n        || config.url === '/idmtax/wh/internal/taxPerson/createSerialNumber'\n        || config.url === '/authtax/oauth2/serverAuth'\n        || config.url === '/idmtax/internal/taxPerson/createSerialNumber'\n        || config.url === '/authtax/oauth2/localDeviceFaceLogin'\n        || config.url === '/authtax/wh/tax/localDeviceFaceLogin'\n        || config.url === '/authtax/wh/oauth2/checkRedirectUrl'\n        || config.url === '/authtax/oauth2/getTaxAppQRCode'\n        || config.url === '/authtax/oauth2/verifyTaxAppQRCode'\n        || config.url === '/acl/wh/app/query/version'\n        || config.url === '/authtax/oauth2/enhancedAuthSendSms'\n        || config.url === '/authtax/oauth2/enhancedAuthVerifySmsCode'\n        || config.url === '/authtax/oauth2/enhancedAuthCreateQRCode'\n        || config.url === '/authtax/oauth2/enhancedAuthVerifyQRCode'\n        || config.url === '/authtax/oauth2/enhancedAuthTaxAppCreateQRCode'\n        || config.url === '/authtax/oauth2/enhancedAuthTaxAppVerifyQRCode'\n        || config.url === '/authtax/oauth2/enhancedAuthServerHello'\n        || config.url === '/authtax/oauth2/enhancedAuthServerAuth'\n        || config.url === '/authtax/oauth2/getHideCode'\n        || config.url === '/acl/wh/document/point/queryPage'\n\n      ) {\n        paramsData['encryptCode'] = '0'\n        paramsData.datagram = JSON.stringify(config.data)\n        getRSAData = JSON.stringify(config.data) // 签名内层报文使用字符串\n      } else {\n        //控制台打印请求参数\n        // console.log(config.url + '==config.data', config.data)\n        // 2.用16位的key对参数data进行sm4加密\n        //如果报文数据大于10K，先压缩后加密，压缩后标志置'1',\n        var jsonData = JSON.stringify(config.data)\n\n        // var zipTag = false;\n        // if(that.getBytesLength(jsonData) > 102400){\n        //   // 压缩\n        //   var pakopackZipData = that.pakopackZip(jsonData)\n        //   getRSAData = encrypt.encrypt(pakopackZipData)\n        //   paramsData['zipCode'] = '1'\n        //   zipTag = true;\n        //   }else{\n\n        getRSAData = encrypt.encryptLong(jsonData)\n\n        // }\n        paramsData.datagram = getRSAData\n        if (getRSAData) {\n          paramsData['encryptCode'] = '1'\n        } else {\n          paramsData['encryptCode'] = '0'\n          paramsData.datagram = jsonData\n        }\n      }\n    }\n    paramsData['timestamp'] = this.dateFtt('yyyyMMddhhmmss', new Date())\n    paramsData['access_token'] = ''\n    paramsData['signtype'] = 'HMacSHA256'\n    // 3.对步骤2结果进行HmacSHA256加密，使用步骤1生成的16位key,返回值存于signature    zipCode+encrytCode+access_token+datagram+timestamp+signtype\n\n\n    paramsData['signature'] = hex_hmac_sha256(getKey16, paramsData['zipCode'] + paramsData['encryptCode'] + getRSAData + paramsData['timestamp'] + paramsData['signtype'])\n    config.data = JSON.stringify(paramsData)\n\n    $.ajax({\n      url: '/tax-api/v1.0' + config.url,\n      method: config.methods || 'post',\n      headers: config.headers,\n      data: config.data,\n      dataType: 'json',\n      async: config.async == undefined ? true : config.async,\n      success: function (data) {\n        // console.log('success data-->', data)\n        if (data) {\n          if (data.code == 1000) {\n            if (data.datagram) {\n              try{\n                data.datagram = JSON.parse(data.datagram)\n              }catch (e){\n                $(\"body\").append(\"<div style='display: none;'>\"+config.url+\"</div><div style='display: none;'>\"+e+\"</div>\");\n              }\n              // 有会话存储会话\n              if (data.datagram.access_token) {\n                localStorage.setItem(\"new_key16\", getKey16)\n              }\n              config.callb(data)\n            } else {\n              config.callb(data)\n            }\n          } else {\n            if (data.msg) {\n              var reDataCode = data.code == 2601 || data.code == 2602\n              // 登录页不报令牌无效\n              if (data.code == 2101 && window.location.href.indexOf(\"login.html\") > 0 || reDataCode) {\n              } else if (data.code != 1000) {\n\n                //针对扫码将错误提示给屏蔽   //getItsQrCodeStatus',   //verifyQRCode\n                if (\n                  (config.url.indexOf('getItsQrCodeStatus') !== -1 || config.url.indexOf('verifyQRCode') !== -1)\n                  && data.msg.indexOf('请求报文解密失败') !== -1) {\n                  //不做操作\n                } else {\n                  layer.msg(data.msg, { time: 3000 });\n                }\n              }\n              try {\n                sliderValidate.reset()\n              } catch (error) {\n              }\n              // 针对2101的处理，2101直接到登出页\n              if (data.code == 2101 && window.location.href.indexOf(\"/logout.html\") === -1) {\n                setTimeout(function () {\n                  window.location.href = \"./logout.html\"\n                }, 500);\n              }\n              config.callb(data)\n            }\n          }\n        }\n      },\n      error: function (xhr, status, err) {\n        try {\n          sliderValidate.reset()\n        } catch (error) {\n        }\n        var error = { message: \"\" };\n        switch (xhr.status) {\n          case 400: error.message = '请求错误'; break\n          case 401: error.message = '未授权，请登录'; break\n          case 403: error.message = '拒绝访问'; break\n          case 404: error.message = '请求地址出错'; break\n          case 408: error.message = '请求超时'; break\n          case 500: error.message = '服务器内部错误'; break\n          case 501: error.message = '服务未实现'; break\n          case 502: error.message = '网关错误'; break\n          case 503: error.message = '服务不可用'; break\n          case 504: error.message = '网关超时'; break\n          case 505: error.message = 'HTTP版本不受支持'; break\n          default: break\n        }\n        layer.msg(error.message, { time: 3000 });\n\n        //是否返回错误\n        if (config.returnErr) {\n          config.callb(xhr)\n        }\n      }\n    })\n  },\n\n  // 活体检测本地接口调用\n  sendReqFace: function (config) {\n    config.headers = {}\n    config.headers['Content-Type'] = 'application/json'\n    jQuery.support.cors = true; // 支持跨域\n    $.ajax({\n      url: 'http://127.0.0.1:60081/api' + config.url,\n      method: config.methods || 'post',\n      headers: config.headers,\n      data: config.data,\n      dataType: 'json',\n      success: function (data) {\n        if (data) {\n          config.callb(data)\n        }\n      },\n      error: function (xhr, status, err) {\n        var error = { message: \"活体检测调用异常\" };\n        switch (status) {\n          case 400: error.message = '请求错误'; break\n          case 401: error.message = '未授权，请登录'; break\n          case 403: error.message = '拒绝访问'; break\n          case 404: error.message = '请求地址出错'; break\n          case 408: error.message = '请求超时'; break\n          case 500: error.message = '服务器内部错误'; break\n          case 501: error.message = '服务未实现'; break\n          case 502: error.message = '网关错误'; break\n          case 503: error.message = '服务不可用'; break\n          case 504: error.message = '网关超时'; break\n          case 505: error.message = 'HTTP版本不受支持'; break\n          default: break\n        }\n        layer.msg(error.message, { time: 3000 });\n      }\n    })\n  },\n\n  setDevIDAndUID: function (config) {\n    var devid = localStorage.getItem('ded')\n    if (!devid) {\n      devid = this.getUuid(32)\n      localStorage.setItem('ded', devid)\n    }\n    config.headers['deviceIdentyNo'] = devid\n    var uids = localStorage.getItem('ud') || ''\n    config.headers['hUid'] = uids\n  },\n\n  /**\n   * 风险审计登录成功后记录uid\n   * @param userid\n   */\n  setUIDS: function (userid) {\n    if (userid) {\n      var nUid = $.md5(userid)\n      var uids = localStorage.getItem('ud') || ''\n      var uidArr = uids ? uids.split('$') : []\n      var nArr = []\n      for (var i = 0; i < uidArr.length; i++) {\n        var cid = uidArr[i]\n        if (cid != nUid) {\n          nArr.push(cid)\n        }\n      }\n      nArr.push(nUid)\n      var len = nArr.length\n      if (len > 5) {\n        nArr.splice(0, len - 5)\n      }\n      uids = nArr.join('$')\n      localStorage.setItem('ud', uids)\n    }\n  },\n\n  // 指定长度和基数 -随机生成uuid\n  getUuid: function (len, radix) {\n    var chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'.split('');\n    var uuid = [],\n      i;\n    radix = radix || chars.length;\n\n    if (len) {\n      // Compact form\n      for (i = 0; i < len; i++) uuid[i] = chars[0 | Math.random() * radix];\n    } else {\n      // rfc4122, version 4 form\n      var r;\n\n      // rfc4122 requires these characters\n      uuid[8] = uuid[13] = uuid[18] = uuid[23] = '-';\n      uuid[14] = '4';\n\n      // Fill in random data.  At i==19 set the high bits of clock sequence as\n      // per rfc4122, sec. 4.1.5\n      for (i = 0; i < 36; i++) {\n        if (!uuid[i]) {\n          r = 0 | Math.random() * 16;\n          uuid[i] = chars[(i == 19) ? (r & 0x3) | 0x8 : r];\n        }\n      }\n    }\n\n    return uuid.join('');\n  },\n  /**\n   * 获取16位sm4密钥\n   * @type {string}\n   */\n  key16: '',\n  getK: function () {\n    if (!this.key16) {\n      this.key16 = this.getUuid(16, 16)\n    }\n    return this.key16;\n  },\n\n  getBytesLength: function (str) {\n    str = str.replace(/\\r\\n/g, \"\\n\").replace(/\\n/g, \"\\r\\n\");\n    var cArr = str.match(/[^\\x00-\\xff]|[·]/ig);\n    return str.length + (cArr == null ? 0 : cArr.length * 2);\n  },\n\n  // 日期格式化\n  dateFtt: function (fmt, date) { //author: meizz\n    var o = {\n      \"M+\": date.getMonth() + 1,                 //月份\n      \"d+\": date.getDate(),                    //日\n      \"h+\": date.getHours(),                   //小时\n      \"m+\": date.getMinutes(),                 //分\n      \"s+\": date.getSeconds(),                 //秒\n      \"q+\": Math.floor((date.getMonth() + 3) / 3), //季度\n      \"S\": date.getMilliseconds()             //毫秒\n    };\n    if (/(y+)/.test(fmt))\n      fmt = fmt.replace(RegExp.$1, (date.getFullYear() + \"\").substr(4 - RegExp.$1.length));\n    for (var k in o)\n      if (new RegExp(\"(\" + k + \")\").test(fmt))\n        fmt = fmt.replace(RegExp.$1, (RegExp.$1.length == 1) ? (o[k]) : ((\"00\" + o[k]).substr((\"\" + o[k]).length)));\n    return fmt;\n  },\n\n  ded: '', ud: '',\n  clearStorage: function (delCookie) {\n    delCookie = delCookie == undefined ? true : delCookie\n    // if (!this.ded) {\n    //   this.ded = localStorage.getItem('ded') || ''\n    // }\n    var ded0 = localStorage.getItem('ded0') || ''\n    var ded = localStorage.getItem('ded') || ''\n    var ud = localStorage.getItem('ud') || ''\n    localStorage.clear();\n    if (delCookie) {\n      api.setCookie('token', \"\");\n    }\n    localStorage.setItem('ded0', ded0)\n    localStorage.setItem('ded', ded)\n    localStorage.setItem('ud', ud)\n  },\n\n  closeWindow: function () {\n    var userAgent = navigator.userAgent;\n    if (userAgent.indexOf(\"Firefox\") != -1 || userAgent.indexOf(\"Chrome\") != -1) {\n      window.location.href = \"about:blank\";\n      window.close();\n    } else {\n      window.opener = null;\n      window.open(\"\", \"_self\");\n      window.close();\n    }\n  },\n\n  /**\n   * 设置Cookie（会话级，浏览器关闭后自动清除）\n   * @param {string} name - Cookie名称\n   * @param {string} value - Cookie值\n   * @param {Object} [options={}] - 可选配置项\n   * @param {string} [options.path='/'] - Cookie路径，默认根路径\n   */\n  setCookie: function (name, value, options) {\n    $.cookie(name, value);\n    // var isHttps = window.location.protocol === 'https:';\n    // var path = '/';\n    // if (options && options.path) {\n    //     path = options.path;\n    // }\n    // var cookieStr = name + '=' + encodeURIComponent(value) + '; path=' + path;\n    // // 过期时间\n    // if (options && options.days) {\n    //     var days = options.days;\n    //     var date = new Date();\n    //     date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));\n    //     cookieStr += '; expires=' + date.toUTCString();\n    // }\n    // if (isHttps) {\n    //   // HTTPS 环境\n    //   cookieStr += '; Secure; SameSite=None';\n    // } else {\n    //   // HTTP 环境\n    //   // cookieStr += '; SameSite=