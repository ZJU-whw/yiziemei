          "content": {
            "size": 4938,
            "mimeType": "application/javascript",
            "text": "// 获取url后面的参数\nfunction getParams(url) {\n  // 获取? 后面第一个字符的索引\n  var index = url.indexOf('?') + 1\n  // url中?后面的字符串 name=zs&age=18&a=1&b=2\n  var params = url.substr(index)\n  // 使用& 切割字符串 ，返回一个数组\n  var arr = params.split('&')\n  var o = {}\n  // 数组中每一项的样子 key = value\n  for (var i = 0; i < arr.length; i++) {\n    var tmpArr = arr[i].split('=')\n    var key = tmpArr[0]\n    var value = tmpArr[1]\n\n    o[key] = value\n  }\n  return o\n}\n\nfunction getParamsDecodeUri(url) {\n  if (url.indexOf('?') == -1) {\n    return null\n  }\n  // 获取? 后面第一个字符的索引\n  var index = url.indexOf('?') + 1\n  // url中?后面的字符串 name=zs&age=18&a=1&b=2\n  var params = url.substr(index)\n  // 使用& 切割字符串 ，返回一个数组\n  var arr = params.split('&')\n  var o = {}\n  // 数组中每一项的样子 key = value\n  for (var i = 0; i < arr.length; i++) {\n    var tmpArr = arr[i].split('=')\n    var key = tmpArr[0]\n    var value = tmpArr[1]\n\n    o[key] = decodeURIComponent(value)\n  }\n  return o\n}\n\n// 获取当前服务域名\nfunction getOrigin() {\n  // 设置origin\n  if (!window.location.origin) {\n    window.location.origin = window.location.protocol + \"//\" + window.location.hostname + (window.location.port ? ':' + window.location.port : '');\n  }\n  return window.location.origin;\n}\n\nvar origin = getOrigin();\n// export const creditCode = getParams(window.location.href).shxydm //地址栏获取带出\n// export const clientId = getParams(window.location.href).client_id //地址栏获取带出\n// export const redirectURI = getParams(window.location.href).redirect_uri //地址栏获取redirect_uri\n//地址栏获取统一社会信用代码\nfunction getCreditCode() {\n  var creditCode = getParams(window.location.href).shxydm || ''\n  creditCode = creditCode == 'null' ? '' : creditCode\n  return creditCode\n}\n\n\n\n//*地址栏获取带出client_type\nfunction getClientType() {\n  return getParams(window.location.href).client_type || ''\n}\n//*地址栏获取带出client_page\nfunction getClient_page() {\n  return getParams(window.location.href).client_page || ''\n}\n//*地址栏获取带出client_id\nfunction getClientId() {\n  return getParams(window.location.href).client_id || ''\n}\n\n//*地址栏获取带出transNo\nfunction getTransNo() {\n  return getParams(window.location.href).transNo || ''\n}\n\n//*地址栏获取带出transNo\nfunction getSuccess() {\n  return getParams(window.location.href).success || ''\n}\n\n//*地址栏获取带出redirect_type\nfunction getRedirect_type() {\n  return getParams(window.location.href).redirect_type || ''\n}\n\n//*地址栏获取redirect_uri\nfunction getRedirectURI() {\n  return decodeURIComponent(getParams(window.location.href).redirect_uri || '')\n}\n\n//*地址栏获取app_login_level\nfunction getApp_login_level() {\n  return decodeURIComponent(getParams(window.location.href).app_login_level || '')\n}\n\n// 获取redirectURI在同域名下的hashpath，便于router跳转\nfunction getRedirectPath(redirect_uri) {\n  var path = '';\n  if (redirect_uri && redirect_uri.indexOf(origin) >= 0 && redirect_uri.indexOf('/#/') >= 0) {\n    path = redirect_uri.replace(origin, '');\n    var hashIndex = path.indexOf('/#/');\n    path = path.substring(hashIndex + 2)\n    var queryIndex = path.indexOf('?')\n    if (queryIndex >= 0) {\n      path = path.substring(0, queryIndex)\n    }\n  }\n  return path;\n}\n\n// 关联关系类型\nfunction getRelatedType() {\n  return getParams(window.location.href).relatedType || ''\n}\n\n// 获取当前url参数\nfunction getCurrentUrlParams() {\n  return getParamsDecodeUri(window.location.href)\n}\n\n// 获取地之栏code\nfunction getCode() {\n  return getParams(window.location.href).code || ''\n}\n// 获取参数state\nfunction getState() {\n  return getParams(window.location.href).state || ''\n}\n// 获取参数tpassCode\nfunction getTpassCode() {\n  return getParams(window.location.href).tpassCode || ''\n}\n// 获取参数tpassCode\nfunction getOpenPage() {\n  return getParams(window.location.href).openPage || ''\n}\n// 获取参数client_pid\nfunction getclientPid() {\n  return getParams(window.location.href).client_pid || ''\n}\n// 获取参数identity\nfunction getIdentity() {\n  return getParams(window.location.href).identity || ''\n}\n// 获取参数uuid\nfunction getUUID() {\n  return getParams(window.location.href).uuid || ''\n}\n// 获取参数areaCode\nfunction getAreaCode() {\n  return getParams(window.location.href).areaCode || ''\n}\n// 获取参数hideCode\nfunction getHideCode() {\n  return getParams(window.location.href).hideCode || ''\n}\n// 获取参数naturepublicKey\nfunction getNaturepublicKey() {\n  return getParams(window.location.href).naturepublicKey || ''\n}\n// 新增获取url中指定参数方法\nfunction getUrlParam(param) {\n  return getParams(window.location.href)[param] || ''\n}\n// 获取指定url参数\nfunction getDecodeUrlParams(url) {\n  return getParamsDecodeUri(url)\n}\n"
          },
