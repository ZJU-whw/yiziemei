            "size": 1337,
            "mimeType": "text/javascript",
            "compression": 811,
            "text": "var myarr;\n\n/**\n * 下载文件（判断文件是否存在）\n * @param filepath\n */\nfunction downloadFile(param) {\n    var submit = new WingsSubmit();\n    submit.pushData(\"type\", param.type);\n    submit.pushData(\"filepath\", param.filepath);\n    submit.setCtrl(\"YxscxGyCtrl_eixstsFile\");\n    submit.setFunction(\"onSuccess\", \"loadSuccess()\");\n    submit.setFunction(\"onException\", \"gyException()\");\n    submit.setFunction('onError', 'gyException()');\n    submit.submit();\n}\n\n/**\n * 执行下载文件\n * @param filepath\n */\nfunction loadSuccess(res) {\n    var filepath = res.getAttr(\"filepath\");\n    var sfcz = res.getAttr(\"sfcz\");\n    if (sfcz == \"Y\") {\n        zxdownloadFile(filepath);\n    } else {\n        WingsDialog.alert(\"下载文件不存在，请联系运维人员处理！\");\n        return;\n    }\n}\n\n/**\n * 执行下载文件\n * @param filepath\n */\nfunction zxdownloadFile(filepath) {\n    if (!checkNull(filepath)) {\n        WingsDialog.alert(\"下载文件不存在，请联系运维人员处理！\");\n        return;\n    }\n\n    var submit = new WingsSubmit();\n    submit.pushData(\"filepath\", filepath);\n    submit.options.postType = \"download\";\n    submit.setCtrl(\"YxscxGyCtrl_downloadFile\");\n    submit.setFunction(\"onException\", \"gyException()\");\n    submit.setFunction('onError', 'gyException()');\n    submit.submit();\n}\n\n"
          },
