            "text": "* {\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    width: 100%;\n    height: 100%;\n}\n\ninput::-webkit-input-placeholder { /*WebKit browsers*/\n    color: #A0A3A4;\n}\n\ninput::-moz-input-placeholder { /*Mozilla Firefox*/\n    color: #A0A3A4;\n}\n\ninput::-ms-input-placeholder { /*Internet Explorer*/\n    color: #A0A3A4;\n}\n\n.title {\n    text-align: center;\n    font-size: 40px;\n    margin-bottom: 2%;\n}\n\n.content {\n    /* width: 60%;\n    margin: 0 auto; */\n    width: 80%;\n    margin-left: 20%;\n    text-align: center;\n}\n\n.input {\n    border: 1px #C0C9CC solid;\n    width: 83%;\n    height: 36px;\n    background: #FDFEFF;\n    border-radius: 4px;\n    padding-left: 10px;\n    outline: none;\n    float: left;\n    margin-top: 35px;\n}\n\n.sousuo {\n    box-sizing: border-box;\n    color: white;\n    border: 1px #009EE4 solid;\n    float: left;\n    width: 16%;\n    text-align: center;\n    line-height: 36px;\n    border-radius: 4px;\n    font-size: 14px;\n    background: url(/yhscx/common/img/search.png) 28px 8px #52C2F8 no-repeat;\n    background-size: 20px;\n    margin-top: 35px;\n    margin-left: 1%;\n    height: 36px;\n    min-width: 114px;\n    cursor: pointer;\n}\n\n.sousuo span {\n    margin-left: 16px;\n}\n\n.sousuo span:hover {\n    font-size: 16px;\n}\n\n.navi {\n    width: 93%;\n    margin-left: 1%;\n    /* \theight: 200px; */\n    float: left;\n    background: url(/yhscx/common/img/serach_bg.png) no-repeat;\n    background-size: 100% 120px;\n}\n\n.navi_content {\n    width: 100%;\n    height: 100%;\n    /* margin: 0 auto; */\n    margin-left: 3%;\n}\n\n.navi_title {\n    color: #005A8A;\n    /* \tline-height: 90px; */\n    font-size: 18px;\n    font-weight: bold;\n}\n\n.nav > li > a:focus, .nav > li > a:hover {\n    background: white;\n}\n\n.contentEvery {\n    float: left;\n    width: 100%;\n    height: 400px;\n    margin-top: 20px;\n}\n\n.content_center {\n    margin: 0 auto;\n    height: 100%;\n    width: 94%;\n    background: rgba(255, 255, 255, 0.5);\n    /*box-shadow: 0 0 3px #888888;*/\n    border-radius: 6px;\n}\n\n.content_head {\n    height: 40px;\n    background: #C9E8F5;\n    line-height: 40px;\n}\n\n.rectangle {\n    width: 11px;\n    height: 28px;\n    float: left;\n    line-height: 40px;\n    background: url(/yhscx/common/img/Rectangle.png) no-repeat;\n    margin-left: 18px;\n    margin-top: 6px;\n    margin-right: 12px;\n}\n\n.content_title {\n    color: #0096F2;\n    font-weight: bold;\n}\n\n.tabContent {\n    height: 160px;\n    width: 100%;\n}\n\n.tab {\n    height: 100%;\n    width: 100%;\n}\n\n.foot {\n    width: 100%;\n    height: 200px;\n    background: url(/yhscx/common/img/line.png) no-repeat;\n    background-size: 1398px 240px;\n    position: absolute;\n    left: 0;\n    top: 100%;\n    margin-top: -200px;\n    z-index: -2;\n}\n\n.tabFooter {\n    height: 40px;\n    border-top: 1px #D8D6D2 solid;\n    margin-top: 10px;\n    background: url(/yhscx/common/img/detail.png) 46% 11px no-repeat;\n    color: #0096F2;\n    text-align: center;\n    line-height: 40px;\n    font-weight: bold;\n    /*font-size: 2rem;*/\n}\n\n.watch:hover {\n    cursor: pointer;\n}\n\n.contentJbxx {\n    float: left;\n    width: 100%;\n    height: 400px;\n}\n\n#myTabContent {\n    float: left;\n    border-bottom: 1px #F1F3F7 solid;\n}\n\n#jbxx ul li {\n    list-style: none;\n    float: left;\n    padding: 0 15px;\n    margin: 5px 0;\n}\n\n#jbxx ul li:hover {\n    border-bottom: 2px #24ABE8 solid;\n    cursor: pointer;\n    margin-bottom: 3px;\n}\n\n.head {\n    width: 60%;\n    margin: 0 auto;\n    text-align: center;\n    color: #C0C9CC;\n}\n\n.nav-tabs > li > a {\n    border: 0;\n    border-radius: 6px 6px 0 0;\n}\n\n.nav-tabs > li.active > a, .nav-tabs > li.active > a:focus, .nav-tabs > li.active > a:hover {\n    border: 0;\n}\n\n.nav-tabs {\n    border: 0;\n    font-weight: bold;\n    /* font-size: 16px; */\n}\n\n.nav > li > a {\n    padding: 5px 15px;\n}\n\na {\n    color: #68