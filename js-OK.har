            "mimeType": "text/javascript",
            "compression": 824,
            "text": "/*!\n * \n * gyUtils - v1.0.0 (2020-11-26 17:27)\n * \n */\nvar gyUtils = {\n\t/**\n\t * 判断元素是否为空\n\t * @param {o} 元素\n\t * @return boolean 为空：true\n\t */\n\tisNull: function (o) {\n\t\t//undefined判断\n\t\tif (!$chk(o) || typeof (o) === undefined || o === \"undefined\" || o === undefined || typeof (o) == undefined || o == \"undefined\" || o == undefined) {\n\t\t\treturn true;\n\t\t}\n\t\t//null判断\n\t\tif (o === null || o === \"\" || o === \"null\" || o == null || o == \"null\") {\n\t\t\treturn true;\n\t\t}\n\t\t//json及数组判断（单层）\n\t\tif (o === {} || o === [] || o === \"{}\" || o === \"[]\" || o === \"[{}]\" || o == {} || o == \"{}\" || o == \"[]\" || o == \"[{}]\") {\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t},\n\n\t/**\n\t * 判断一个元素是否在数组中\n\t * @param {arr} 数组\n\t * @param {val} 元素值\n\t * @return boolean  包含：true\n\t */\n\tcontains: function (arr, val) {\n\t\treturn arr.indexOf(val) != -1 ? true : false;\n\t},\n\n\t/**\n\t * 判断原始值是否为空，若为空返回默认值\n\t * @param {v} 原始值\n\t * @param {d} 默认值\n\t * @return obj 返回值\n\t */\n\tgetDefaultData(v, d) {\n\t\treturn !this.isNull(v) ? v : this.isNull(d) ? \"\" : d;\n\t},\n\t/**\n\t * 清空Wings-select 下拉列表数据及选中值\n\t * @param {f} formName\n\t * @param {k} divName\n\t */\n\tresetSelectData(f, k) {\n\t\t$.wingsWidget(f).setValue(k, \"\") && $.wingsWidget(f).getWidget(k).initDataByJson('[]');\n\t},\n\tGetRequest() {\n\t\tvar url = location.search; //获取url中\"?\"符后的字串\n\t\tvar theRequest = new Object();\n\t\tif (url.indexOf(\"?\") != -1) {\n\t\t\tvar str = url.substr(1);\n\t\t\tstrs = str.split(\"&\");\n\t\t\tfor (var i = 0; i < strs.length; i++) {\n\t\t\t\ttheRequest[strs[i].split(\"=\")[0]] = decodeURI(strs[i].split(\"=\")[1]);\n\t\t\t}\n\t\t}\n\t\treturn theRequest;\n\t},\n\n}"
          },
