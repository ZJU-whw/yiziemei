            "text": "var common = common || {};\nvar msg = '错误信息'; //校验错误信息\nif($.validator){\n\t/**\n\t * jquery validate 增加正则校验 使用方法 $(form).validate({ rules:{ sjh:{\n\t * pattern:/^0?1[3|4|5|8][0-9]\\d{8}$/ } }, messages: { sjh: { pattern :\n\t * \"手机号格式错误\" } } });\n\t */\n\t$.validator.addMethod(\"regexp\", function(value, element, regstr) {\n\t\tvar reg=new RegExp(regstr);\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"格式错误\");\n\t//数字类\n\t$.validator.addMethod(\"number\", function(value, element) {\n\t\tvar reg=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\t\tvar reg2 = new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\t\treturn this.optional(element) || (reg.test(value)) || (reg2.test(value));\n\t}, \"格式错误\");\n\t//数字类-整型\n\t$.validator.addMethod(\"numberInt\", function(value, element) {\n\t\tvar reg=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"格式错误\");\n\t//数字类-浮点型\n\t$.validator.addMethod(\"numberFloat\", function(value, element) {\n\t\tvar reg=new RegExp(\"^(-?\\\\d+)(\\\\.\\\\d+)$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"格式错误\");\n\t//数字类-科学计数法\n\t$.validator.addMethod(\"numberScience\", function(value, element) {\n\t\tvar reg=new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"格式错误\");\n\t//字符类-英文\n\t$.validator.addMethod(\"english\", function(value, element) {\n\t\tvar reg=new RegExp(\"^[A-Za-z]+$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效英文字符\");\n\t//字符类-中文\n\t$.validator.addMethod(\"chinese\", function(value, element) {\n\t\tvar reg=new RegExp(\"^[\\u4e00-\\u9fa5]+$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效中文字符\");\n\t//字符类\n\t$.validator.addMethod(\"character\", function(value, element) {\n\t\tvar reg=new RegExp(\"^[A-Za-z\\u4e00-\\u9fa5]+$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效中英文字符\");\n\t//数字汉字加英文字母类\n\t$.validator.addMethod(\"numbercharacter\", function(value, element) {\n\t\tvar reg=new RegExp(\"^[0-9A-Za-z\\u4e00-\\u9fa5]+$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效中英文字符或数字\");\n\t//qq类\n\t$.validator.addMethod(\"qq\", function(value, element) {\n\t\tvar reg=new RegExp(\"[1-9][0-9]{4,9}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效qq号码\");\n\t//固定电话\n\t$.validator.addMethod(\"telephone\", function(value, element) {\n\t\tvar reg=new RegExp(\"^\\\\d{3}-\\\\d{8}|\\\\d{4}-\\\\d{7}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效电话号码\");\n\t//邮箱\n\t$.validator.addMethod(\"email\", function(value, element) {\n\t\tvar reg=new RegExp(\"^\\\\w+([-+.]\\\\w+)*@\\\\w+([-.]\\\\w+)*.\\\\w+([-.]\\\\w+)*$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效email地址\");\n\t//手机号码\n\t$.validator.addMethod(\"cellphone\", function(value, element) {\n\t\tvar reg=new RegExp(\"^1[3|4|5|7|8][0-9]\\\\d{8}$\");\n\t\tconsole.log(this.optional(element)+'-----'+(reg.test(value)));\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效手机号码\");\n\t//身份证号\n\t$.validator.addMethod(\"idcard\", function(value, element) {\n\t\tvar reg=new RegExp(\"^(\\\\d{15}$|^\\\\d{17}(\\\\d|X|x))$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效身份证号\");\n\t//邮政编码\n\t$.validator.addMethod(\"postal\", function(value, element) {\n\t\tvar reg=new RegExp(\"^[0-9]{6}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效邮政编码\");\n\t//货币格式\n\t$.validator.addMethod(\"currency\", function(value, element) {\n\t\tvar reg=new RegExp(\"^\\\\$[0-9]{1,}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入有效货币格式，以“$”开头\");\n\t//url连接\n\t$.validator.addMethod(\"url\", function(value, element) {\n\t\tvar reg=new RegExp(\"^http://([\\\\w-]+\\\\.)+[\\\\w-]+(/[\\\\w-./?%&=]*)?$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入正确的url地址 例如: http://www.163.com\");\n\t//日期类\n\t$.validator.addMethod(\"date\", function(value, element) {\n\t\tvar reg=new RegExp(\"[0-9]{4}-([0][1-9]|[1][0-2])-([0][1-9]|[1|2][0-9]|[3][0|1])$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, \"请输入正确的日期 默认为yyyy-MM-dd\");\n\t//比较类 arg格式{>1;<4}或者{>1}\n\t$.validator.addMethod(\"contrast\", function(value, element,arg) {\n\t\targ =arg.substr(1).substr(0,arg.length-2);\n\t\tvar arr = [];\n\t\tvar para = [];\n\t\tarr = arg.split(\";\");\n\t\tif(arr.length == 1){\n\t\t\tif(arr[0].split(\"-\").length == 2){\n\t\t\t\tpara[0] = arr[0].split(\"-\")[0];\n\t\t\t\tpara[1] = \"-\"+arr[0].split(\"-\")[1];;\n\t\t\t}else{\n\t\t\t\tpara[0] = arr[0].split(/\\d+$/gi)[0];\n\t\t\t\tpara[1] = arr[0].match(/\\d+$/gi)[0];\n\t\t\t}\n\t\t\tif(compare(value,para[0],para[1])){\n\t\t\t\t\n\t\t\t}else{\n\t\t\t\tmsg = '错误！输入值应为'+para[0]+para[1];\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}else if(arr.length == 2){\n\t\t\tif(arr[0].split(\"-\").length == 2){\n\t\t\t\tpara[0] = arr[0].split(\"-\")[0];\n\t\t\t\tpara[1] = \"-\"+arr[0].split(\"-\")[1];;\n\t\t\t}else{\n\t\t\t\tpara[0] = arr[0].split(/\\d+$/gi)[0];\n\t\t\t\tpara[1] = arr[0].match(/\\d+$/gi)[0];\n\t\t\t}\n\t\t\tif(arr[1].split(\"-\").length == 2){\n\t\t\t\tpara[2] = arr[1].split(\"-\")[0];\n\t\t\t\tpara[3] = \"-\"+arr[1].split(\"-\")[1];;\n\t\t\t}else{\n\t\t\t\tpara[2] = arr[1].split(/\\d+$/gi)[0];\n\t\t\t\tpara[3] = arr[1].match(/\\d+$/gi)[0];\n\t\t\t}\n\t\t\tif(compare(value,para[0],para[1]) && compare(value,para[2],para[3])){\n\t\t\t\t\n\t\t\t}else{\n\t\t\t\tmsg = '错误！输入值应为'+para[0]+para[1]+\"并且\"+para[2]+para[3];\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}else{\n\t\t\tmsg = '判断条件书写错误！';\n\t\t}\n\t\tvar reg=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\t\treturn this.optional(element) || (reg.test(value));\n\t}, function(){return msg;});\n\t//字符串长度范围比较 使用样例：{1;4}\n\t$.validator.addMethod(\"length\",function(value,element,arg){\n\t\targ =arg.substr(1).substr(0,arg.length-2);//去除花括号\n\t\tvar arr = arg.split(\";\");\n\t\tif(arr.length == 1){\n\t\t\tif(value.length >= parseInt(arr[0])){\n\t\t\t\t\n\t\t\t}else{\n\t\t\t\tmsg = \"错误，字符长度不小于\"+arr[0];\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}else if(arr.length == 2){\n\t\t\tif(value.length >= parseInt(arr[0]) && value.length <= parseInt(arr[1])){\n\t\t\t\t\n\t\t\t}else{\n\t\t\t\tmsg = \"错误，字符长度不小于\"+arr[0]+\"不大于\"+arr[1];\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n\t\treturn true;\n\t},function(){return msg;});\n\t//自定义函数校验  调用时arg参数为方法名\n\t$.validator.addMethod(\"customFunction\",function(value,element,arg){\n\t\tvar func = eval(arg);\n\t\tnew func(value);\n\t},function(){return msg;});\n\tfunction custom(val){\n\t\tif(parseInt(val)>4){\n\t\t\tmsg = '';\n\t\t}else{\n\t\t\tmsg = '不符合规则';\n\t\t}\n\t}\n\n\t$.validator.setDefaults({\n\t\terrorElement: \"em\",\n\t\terrorPlacement: function ( error, element ) {\n\t\t\t// Add the `help-block` class to the error element\n\t\t\terror.addClass( \"help-block\" );\n\t\t\t//error.addClass( \"tooltip bottom\" );\n\t\t\t//error.append('<div class=\"tooltip-arrow\"></div><div class=\"tooltip-inner\">Tooltip on the bottom</div>');\n\n\t\t\tif ( element.prop( \"type\" ) === \"checkbox\" ) {\n\t\t\t\terror.insertAfter( element.parent( \"label\" ) );\n\t\t\t\terror.css({'top':'25%','left':'28%'});\n\t\t\t} else {\n\t\t\t\terror.insertAfter( element );\n\t\t\t}\n\t\t},\n\t\thighlight: function ( element, errorClass, validClass ) {\n\t\t\t$( element ).parents( \".col-sm-10\" ).addClass( \"has-error\" ).removeClass( \"has-success\" );\n\t\t},\n\t\tunhighlight: function (element, errorClass, validClass) {\n\t\t\t$( element ).parents( \".col-sm-10\" ).addClass( \"has-success\" ).removeClass( \"has-error\" );\n\t\t}\n\t});\n\t$.extend($.validator.messages, {\n\t\tnumber: \"请输入有效的数字\",\n\t\tnumberInt:\"请输出有效整数\",\n\t\tnumberFloat : \"请输入有效浮点数\",\n\t\tnumberScience:\"请输入有效数字\",\n\t\trequired:\"不能为空\"\n\t});\n}\n\n/**\n * 屏蔽submit执行验证\n */\n// $.validator.setDefaults({\n// submitHandler: function() {\n// return;\n// }\n// });\n/**\n * 解决ie8 数组不支持indexOf方法\n */\nif (!Array.prototype.indexOf) {\n\tArray.prototype.indexOf = function(elt /* , from */) {\n\t\tvar len = this.length >>> 0;\n\t\tvar from = Number(arguments[1]) || 0;\n\t\tfrom = (from < 0) ? Math.ceil(from) : Math.floor(from);\n\t\tif (from < 0)\n\t\t\tfrom += len;\n\t\tfor (; from < len; from++) {\n\t\t\tif (from in this && this[from] === elt)\n\t\t\t\treturn from;\n\t\t}\n\t\treturn -1;\n\t};\n}\n/**\n * 解决ie8 js 字符串不支持trim方法\n */\nif (!String.prototype.trim) {\n\tString.prototype.trim = function() {\n\t\treturn this.replace(/^\\s+/g, \"\").replace(/\\s+$/g, \"\");\n\t}\n}\n\nfunction compare(val,arg1,arg2){\n\tval = parseInt(val);\n\targ2 = parseInt(arg2);\n\tif(arg1!=null && arg2!=null){\n\t\tswitch(arg1)\n\t\t{\n\t\tcase '>': \n\t\t\tif(val > arg2){\n\t\t\t\treturn true;\n\t\t\t}else {\n\t\t\t\treturn false;\n\t\t\t}\n\t\tcase '>=':\n\t\t\tif(val >= arg2){\n\t\t\t\treturn true;\n\t\t\t}else{\n\t\t\t\treturn false;\n\t\t\t}\n\t\tcase '==':\n\t\t\tif(val == arg2){\n\t\t\t\treturn true;\n\t\t\t}else{\n\t\t\t\treturn false;\n\t\t\t}\n\t\tcase '!=':\n\t\t\tif(val != arg2){\n\t\t\t\treturn true;\n\t\t\t}else{\n\t\t\t\treturn false;\n\t\t\t}\n\t\tcase '<=':\n\t\t\tif(val <= arg2){\n\t\t\t\treturn true;\n\t\t\t}else{\n\t\t\t\treturn false;\n\t\t\t}\n\t\tcase '<':\n\t\t\tif(val < arg2){\n\t\t\t\treturn true;\n\t\t\t}else{\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n\t}\n}\n/*//重写默认alert\nwindow.alert = function(){\n\tvar title='提示',msg=\"\";\n\tvar numargs = arguments.length;\n\tif(numargs>1){\n\t\ttitle = arguments[0],\n\t\tmsg = arguments[1];\n\t}else if(numargs==1){\n\t\tmsg = arguments[0];\n\t}\n\twindow.top.BootstrapDialog.show({\n\t\t//size: BootstrapDialog.SIZE_SMALL,\n\t\ttitle: title,\n\t\tmessage:msg,\n\t\tdraggable: true,\n\t\tbuttons: [{\n\t\t\ticon: 'icon-ok', \n\t\t\tcssClass: 'btn-sm btn-primary', \n\t        autospin: false,\n            label: '确定',\n            action: function(dialog) {\n            \tdialog.close();\n            }\n        }]\n\t}).getModalDialog().css('padding-top', '130px');\n}\n//确认框\nwindow.confirm = function(){\n\tvar title='提示',msg=\"\",ok,cancel;\n\tvar numargs = arguments.length;\n\ttitle = arguments[0],\n\tmsg = arguments[1];\n\tif(numargs==3){\n\t\tok = arguments[2];\n\t}else if(numargs==4){\n\t\tok = arguments[2];\n\t\tcancel = arguments[3];\n\t}\n\twindow.top.BootstrapDialog.show({\n\t\ttitle: title,\n\t\tmessage:msg,\n\t\tdraggable: true,\n\t\tbuttons: [{\n\t\t\ticon: 'icon-ok', \n\t\t\tcssClass: 'btn-sm btn-primary', \n\t        autospin: false,\n            label: '确定',\n            action: function(dialog) {\n            \tif(ok){\n            \t\tok(dialog);\n            \t}\n            \tdialog.close();\n            }\n        },{\n\t\t\ticon: 'icon-ban-circle', \n\t\t\tcssClass: 'btn-sm btn-primary', \n\t        autospin: false,\n            label: '取消',\n            action: function(dialog) {\n            \tif(cancel){\n            \t\tcancel(dialog);\n            \t}\n            \tdialog.close();\n            }\n        }]\n\t}).getModalDialog().css('padding-top', '130px');\n}\n//重写prompt,args title msg value callback\nwindow.prompt = function(){\n\tvar title=arguments[0],msg=arguments[1],value=arguments[2],okCallback=arguments[3],cancelCallback=arguments[4];\n\twindow.top.BootstrapDialog.show({\n\t\t//size: BootstrapDialog.SIZE_SMALL,\n\t\ttitle: title,\n\t\tmessage:msg+'<input type=\"text\" class=\"form-control\" value=\"'+value+'\">',\n\t\tdraggable: true,\n\t\tbuttons: [{\n\t\t\ticon: 'icon-ok', \n\t\t\tcssClass: 'btn-xs btn-primary', \n\t        autospin: false,\n            label: '确定',\n            action: function(dialog) {\n            \tvar val = dialog.getModalBody().find('input').val();\n            \tvar returnV = okCallback(val);\n            \tif(returnV!=false){\n            \t\tdialog.close();\n            \t}\n            }\n        },{\n\t\t\ticon: 'icon-ban-circle',\n\t\t\tcssClass: 'btn-xs btn-primary', \n\t        autospin: false,\n            label: '取消',\n            action: function(dialog) {\n            \tif(cancelCallback){\n            \t\tvar val = dialog.getModalBody().find('input').val();\n                \tvar returnV = cancelCallback(val);\n                \tif(returnV!=false){\n                \t\tdialog.close();\n                \t}\n            \t}else{\n            \t\tdialog.close();\n            \t}\n            }\n        }]\n\t}).getModalDialog().css('padding-top', '130px');\n}\n\n*//**\n * 模态对话框\n * 参数options 实例window.showModalDialog({\n * \ttitle:'标题'\n * \turl:'/sword?ctrl=xxxxxx\n *  buttons:[{label: '按钮1',action: handler,icon: 'icon-ban-circle',cssClass: 'btn-sm btn-primary'},\n *  {label: '按钮2',action: handler,icon: 'icon-ban-circle',cssClass: 'btn-sm btn-primary'}]\n * });\n * \n *//*\nwindow.showModalDialog = function(options){\n\tvar buttons = [];\n\tif(options.buttons){\n\t\t$(options.buttons).each(function(i,b){\n\t\t\tvar btn = {label:'',icon:'',cssClass:'btn-sm btn-primary'};\n\t\t\tbtn.label = b.label;\n\t\t\tif(b.icon)\n\t\t\t\tbtn.icon = b.icon;\n\t\t\tif(b.cssClass)\n\t\t\t\tbtn.cssClass = b.cssClass;\n\t\t\tif(b.action){\n\t\t\t\tbtn.action = function(dialog){\n\t\t\t\t\tvar doc = dialog.getModalBody();\n\t\t\t\t\tif(!options.noiframe){\n\t\t\t\t\t\tdoc = $(dialog.getModalBody().find('iframe').prop('contentWindow').document);\n\t\t\t\t\t}\n\t\t\t\t\tb.action(dialog,doc);\n\t\t\t\t};\n\t\t\t}\n\t\t\tbuttons.push(btn);\n\t\t});\n\t}\n\tvar winH = $(window).height()-100;\n\tvar message = options.noiframe?$('<div></div>').load(options.url):$('<iframe style=\"frameborder:no;border:0;width:100%;height:'+winH+'px\" src=\"'+options.url+'\"></iframe>');\n\tvar dialog = window.top.BootstrapDialog.show({\n\t\tsize:options.size?options.size:BootstrapDialog.SIZE_WIDE,\n\t\ttitle:options.title,\n\t\tdraggable: true,\n        message:message,\n        buttons:buttons,\n        closable:options.closable,\n        onshow: function(dialog){\n        \tif(options.onshow){\n        \t\tvar doc = dialog.getModalBody();\n\t\t\t\tif(!options.noiframe){\n\t\t\t\t\tdoc = $(dialog.getModalBody().find('iframe').prop('contentWindow').document);\n\t\t\t\t}\n        \t\toptions.onshow(dialog,doc);\n        \t}\n        },\n        onshown: function(dialog){\n        \tif(options.onshown){\n        \t\tvar doc = dialog.getModalBody();\n        \t\tif(!options.noiframe){\n\t\t\t\t\tdoc = $(dialog.getModalBody().find('iframe').prop('contentWindow').document);\n\t\t\t\t}\n        \t\toptions.onshown(dialog,doc);\n        \t}\n        },\n        onhide: function(dialog){\n        \tif(options.onhide){\n        \t\tvar doc = dialog.getModalBody();\n        \t\tif(!options.noiframe){\n\t\t\t\t\tdoc = $(dialog.getModalBody().find('iframe').prop('contentWindow').document);\n\t\t\t\t}\n        \t\toptions.onhide(dialog,doc);\n        \t}\n        },\n        onhidden: function(dialog){\n        \tif(options.onhidden){\n        \t\tvar doc = dialog.getModalBody();\n        \t\tif(!options.noiframe){\n\t\t\t\t\tdoc = $(dialog.getModalBody().find('iframe').prop('contentWindow').document);\n\t\t\t\t}\n        \t\toptions.onhidden(dialog,doc);\n        \t}\n        }\n    });\n}*/\n/**\n * 关闭全部dialog\n */\nwindow.closeModalDialog = function(){\n\tvar succ=false;\n\t$.each(window.top.BootstrapDialog.dialogs, function(id, dialog){\n\t\tsucc = true;\n        dialog.close();\n    });\n\treturn succ;\n}\nvar gtabid=1;\n/**\n * 添加tab方法\n */\nwindow.addTabPage = function(options){\n\tif(!options.id){\n\t\toptions.id='custom_tabpage_'+(++gtabid);\n\t}\n\twindow.top.MainPage.newTab (options.id,options.title,options.icon,options.url,true);\n}\n/**\n * 关闭当前tab方法\n */\nwindow.closeCurrTabPage = function(){\n\twindow.top.MainPage.closeTab();\n}\nwindow.openNewWin = function(xmid, xmmc) {\n\tvar name = '我的项目';\n\tvar tempForm = document.createElement(\"form\");\n\tte