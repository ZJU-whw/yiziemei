            "text": "\n/* CSS Document */\n.btn-toolbar{ margin:0; padding:0; display:inline-block; font-size:12px; color:#fff; }\n.btn-toolbar div{float:left; font-size:12px;cursor: pointer;}\n.glyphicon {position: relative;top:2px; left: -3px;display: inline-block; font-family: 'Glyphicons Halflings'; font-style: normal; font-weight: normal;    line-height: 1; -webkit-font-smoothing: antialiased; padding-left:3px;}\n.default,.unused,.add,.clos,.print,.export,.import,.back,.preview,.inspect,.previousPage,.nextPage,.firstPage,.endPage,.delete,.edit,.find,.save,.refresh{width:auto;padding: 0 10px 1px 25px;margin:5px 2px; height:28px; text-align:center; line-height:27px; -moz-border-radius:3px; -webkit-border-radius:3px; border-radius:3px; background:#f1f6fa;color:#333; border:1px solid #d3e1e4;}\n.default:hover,.add:hover,.clos:hover,.print:hover,.export:hover,.import:hover,.back:hover,.preview:hover,.inspect:hover,.previousPage:hover,.nextPage:hover,.firstPage:hover,.endPage:hover,.delete:hover,.edit:hover,.find:hover,.save:hover,.refresh:hover{ ;/*opacity: 0.8; visibility: visible;*/ }\n.default:hover{background:#2eacd9;color:#fff;}\n.add{background:url(\"../img/add.png\") no-repeat 8px center;}\n.add:hover{background:#2eacd9 url(\"../img/add-hover.png\") no-repeat 8px center; color:#fff;}\n.clos{background:url(\"../img/clos.png\") no-repeat 8px center;}\n.clos:hover{background:#2eacd9 url(\"../img/clos-hover.png\") no-repeat 8px center; color:#fff;}\n.print{background:url(\"../img/print.png\") no-repeat 8px center;}\n.print:hover{background:#2eacd9 url(\"../img/print-hover.png\") no-repeat 8px center; color:#fff;}\n.export{background:url(\"../img/export.png\") no-repeat 8px center;}\n.export:hover{background:#2eacd9 url(\"../img/export-hover.png\") no-repeat 8px center; color:#fff;}\n.import{background:url(\"../img/import.png\") no-repeat 8px center;}\n.import:hover{background:#2eacd9 url(\"../img/import-hover.png\") no-repeat 8px center; color:#fff;}\n.back{background:url(\"../img/back.png\") no-repeat 8px center;}\n.back:hover{background:#2eacd9 url(\"../img/back-hover.png\") no-repeat 8px center; color:#fff;}\n.preview{background:url(\"../img/preview.png\") no-repeat 8px center;}\n.preview:hover{background:#2eacd9 url(\"../img/preview-hover.png\") no-repeat 8px center; color:#fff;}\n.inspect{background:url(\"../img/inspect.png\") no-repeat 8px center;}\n.inspect:hover{background:#2eacd9 url(\"../img/inspect-hover.png\") no-repeat 8px center; color:#fff;}\n.previousPage{background:url(\"../img/previousPage.png\") no-repeat 8px center;}\n.previousPage:hover{background:#2eacd9 url(\"../img/previousPage-hover.png\") no-repeat 8px center; color:#fff;}\n.nextPage{background:url(\"../img/nextPage.png\") no-repeat 8px center;}\n.nextPage:hover{background:#2eacd9 url(\"../img/nextPage-hover.png\") no-repeat 8px center; color:#fff;}\n.firstPage{background:url(\"../img/firstPage.png\") no-repeat 8px center;}\n.firstPage:hover{background:#2eacd9 url(\"../img/firstPage-hover.png\") no-repeat 8px center; color:#fff;}\n.endPage{background:url(\"../img/endPage.png\") no-repeat 8px center;}\n.endPage:hover{background:#2eacd9 url(\"../img/endPage-hover.png\") no-repeat 8px center; color:#fff;}\n.delete{background:url(\"../img/delete.png\") no-repeat 8px center;}\n.delete:hover{background:#2eacd9 url(\"../img/delete-hover.png\") no-repeat 8px center; color:#fff;}\n.edit{background:url(\"../img/edit.png\") no-repeat 8px center;}\n.edit:hover{background:#2eacd9 url(\"../img/edit-hover.png\") no-repeat 8px center; color:#fff;}\n.find{background:url(\"../img/find.png\") no-repeat 8px center;}\n.find:hover{background:#2eacd9 url(\"../img/find-hover.png\") no-repeat 8px center; color:#fff;}\n.save{background:url(\"../img/save.png\") no-repeat 8px center;}\n.save:hover{background:#2eacd9 url(\"../img/save-hover.png\") no-repeat 8px center; color:#fff;}\n.refresh{background:url(\"../img/refresh.png\") no-repeat 8px center;}\n.refresh:hover{background:#2eacd9 url(\"../img/refresh-hover.png\") no-repeat 8px center; color:#fff;}\n\n.wingToolbarDiv{height:40px;}\n.wingToolbarStyle{width:100%;height:40px;top:0px;background-color:#f7f7f7;z-index:99;}\n\n.unused{\n\tcolor:#A8A8A8;\n}\n\n.unused:hover{\n\tcolor:#A8A8A8;\n}\n\n.unused_1{\n    background:rgb(218,218,218);\n    color:#555;\n    border-color:#555;\n}\n.unused_1:hover{\n    background:rgb(218,218,218)!important;\n    color:#555!important;\n    border-color:#555!important;\n}\n.unused_1:focus{\n    background:rgb(218,218,218)!important;\n    color:#555!important;\n    border-color:#555!important;\n}\n.unused_1:visited{\n    background:rgb(218,218,218)!important;\n    color:#555!important;\n    border-color:#555!important;\n}\n.btn_new{\n    padding:3px 15px!important;\n}\n\n\n\n/* toolsbar2 */\n \n .s-tool {      \n    position: fixed;\n    top: 0px;\n    right: 0;\n    text-align: center;\n    z-index: 99;\n    overflow: hidden;\n    height: 600px;\n    width: 150px;\n    /* background: #fff; */\n    }\n    \n .s-tool_2 {      \n    position: absolute;\n    top:30px;\n    overflow: hidden;\n    height: 240px;\n    width: 150px;\n    display: block;\n    /* background: #fff; */\n    }\n    \n.s-tool_2 img {\n        margin: 20px 0;background: #316EB4;\n}\n\n.s-tool a{ \n\theight: 60px;\n     width: 60px;\n    display: block;\n    /* background: red; */\n    background: #316EB4;\n    margin: 0 0 0 auto;\n }\n    \n.s-tool .wings_toolbar_up{\n\theight: 30px;\n    position: absolute;\n    right:0;\n    top:0;\n   \n}\n.s-tool .wings_toolbar_down{\n\theight: 30px;\n    position: absolute;\n    right:0;\n    top:210px;\n}\n\n.wings_toolbar_up_span{\n\tbackground:url(\"../plugins/wingsToolbar/image/up_arrow.png\") no-repeat center 0;\n    width:50px;\n}\n.wings_toolbar_down_span{\n\tbackground:url(\"../plugins/wingsToolbar/image/down_arrow.png\") no-repeat center 0;\n    width:50px;\n}\n    \n\n.s-tool .border{border-bottom:1px solid #e6e5e5;}\n\n.s-tool_2 a span {\n    display: none;\n    color: #fff;\n    position: absolute;\n    right: 40px;\n    width: 85px;\n    line-height: 66px;\n    background: #316EB4;\n    height: 60px;padding: 0 15px 0 5px;text-algin:center;margin-right:20px;opacity: 0.8;\n}\n.s-tool_2 a:hover{opacity: 0.8;width:60px;/*background:#959BB1;*/}\n.s-tool_2 a:hover>span{display:block;}\n\n.s-tool_indiv{\n\tposition:absolute;\n    width: 150px;\n\t}\n\n\n\n/* toolsbar3 */\n \n .s-tool-3 {      \n    position: fixed;\n    top: 0px;\n    right: 0;\n    text-align: center;\n    z-index: 99;\n    overflow: hidden;\n    height: 100%;\n    width: 50px;\n    /* background: #fff; */\n    }\n    \n .s-tool_3 {      \n    position: absolute;\n    top:30px;\n    overflow: hidden;\n    height: 240px;\n    width: 50px;\n    display: block;\n    /* background: #fff; */\n    }\n    \n\n.s-tool-3 a{ \n\tcolor:#656667;\n\theight: 50px;\n     width: 50px;\n    display: block;\n    /* background: red; */\n    /*background: #316EB4;*/\n    margin: 0 0 0 auto;\n    padding:0 0 0 0;\n    text-decoration:none;\n    padding-top:5px;\n }\n    \n.s-tool_3 img {\n        margin: 5px 0;/*background: #316EB4;*/\n}\n.s-tool_3 a span{\n    display: block;\n    width: 50px;\n    font-size:12px;\n    padding: 5px 0 3px 0;\n}\n\n.s-tool-3 .wings_toolbar_up{\n\theight: 30px;\n    position: absolute;\n    right:0;\n    top:0;\n    padding:0;\n   \n}\n.s-tool-3 .wings_toolbar_down{\n\theight: 30px;\n    position: absolute;\n    right:0;\n    top:210px;\n}\n\n.s-tool-3 .border{border-bottom:1px solid #e6e5e5;}\n\n.s-tool_3 a.actTool3:hover{width:50px;background:#6C9CF0;color:#FFFFFF}\n\n.s-tool_3 a.actTool3.action3{width:50px;background:#6C9CF0;color:#FFFFFF}\n\n.s-tool_indiv_3{\n\tposition:absolute;\n\t}\n/* 鍥炬爣 */\n.s-tool_3 a span.a_row_number_not_click{background:url(\"../plugins/wingsToolbar/image3/a_row_number_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.a_row_number_not_click {background:url(\"../plugins/wingsToolbar/image3/a_row_number_click_icon.png\") no-repeat center 0;;}\n.a_row_number_click {background:url(\"../plugins/wingsToolbar/image3/a_row_number_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.a_row_number_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/a_row_number_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_double_screen_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_double_screen_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_double_screen_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_double_screen_click_icon.png\") no-repeat center 0;;}\n.accessory_double_screen_click {background:url(\"../plugins/wingsToolbar/image3/accessory_double_screen_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_double_screen_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_double_screen_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_first_copy_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_first_copy_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_first_copy_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_first_copy_click_icon.png\") no-repeat center 0;;}\n.accessory_first_copy_click {background:url(\"../plugins/wingsToolbar/image3/accessory_first_copy_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_first_copy_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_first_copy_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_quit_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_quit_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_quit_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_quit_click_icon.png\") no-repeat center 0;;}\n.accessory_quit_click {background:url(\"../plugins/wingsToolbar/image3/accessory_quit_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_quit_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_quit_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_save_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_save_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_save_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_click_icon.png\") no-repeat center 0;;}\n.accessory_save_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_save_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_save_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_save_exit_copy_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_copy_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_save_exit_copy_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_copy_click_icon.png\") no-repeat center 0;;}\n.accessory_save_exit_copy_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_copy_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_save_exit_copy_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_copy_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_save_exit_setup_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_setup_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_save_exit_setup_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_setup_click_icon.png\") no-repeat center 0;;}\n.accessory_save_exit_setup_click {background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_setup_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_save_exit_setup_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_save_exit_setup_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\n.s-tool_3 a span.accessory_send_not_click{background:url(\"../plugins/wingsToolbar/image3/accessory_send_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.accessory_send_not_click {background:url(\"../plugins/wingsToolbar/image3/accessory_send_click_icon.png\") no-repeat center 0;;}\n.accessory_send_click {background:url(\"../plugins/wingsToolbar/image3/accessory_send_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.accessory_send_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/accessory_send_unclickable_icon.png\") no-repeat center 0;;}\t\n\t\t\n.s-tool_3 a span.adopt_not_click{background:url(\"../plugins/wingsToolbar/image3/adopt_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.adopt_not_click {background:url(\"../plugins/wingsToolbar/image3/adopt_click_icon.png\") no-repeat center 0;;}\n.adopt_click {background:url(\"../plugins/wingsToolbar/image3/adopt_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.adopt_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/adopt_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\t\t\t\n.s-tool_3 a span.anew_dispatching_not_click{background:url(\"../plugins/wingsToolbar/image3/anew_dispatching_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.anew_dispatching_not_click {background:url(\"../plugins/wingsToolbar/image3/anew_dispatching_click_icon.png\") no-repeat center 0;;}\n.anew_dispatching_click {background:url(\"../plugins/wingsToolbar/image3/anew_dispatching_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.anew_dispatching_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/anew_dispatching_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\t\t\t\n.s-tool_3 a span.backlog_not_click{background:url(\"../plugins/wingsToolbar/image3/backlog_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.backlog_not_click {background:url(\"../plugins/wingsToolbar/image3/backlog_click_icon.png\") no-repeat center 0;;}\n.backlog_click {background:url(\"../plugins/wingsToolbar/image3/backlog_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.backlog_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/backlog_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\t\t\t\t\n.s-tool_3 a span.backlog_cancel_stick_not_click{background:url(\"../plugins/wingsToolbar/image3/backlog_cancel_stick_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.backlog_cancel_stick_not_click {background:url(\"../plugins/wingsToolbar/image3/backlog_cancel_stick_click_icon.png\") no-repeat center 0;;}\n.backlog_cancel_stick_click {background:url(\"../plugins/wingsToolbar/image3/backlog_cancel_stick_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.backlog_cancel_stick_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/backlog_cancel_stick_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\t\t\t\n.s-tool_3 a span.backlog_collect_not_click{background:url(\"../plugins/wingsToolbar/image3/backlog_collect_not_click_icon.png\") no-repeat center 0;}\n.s-tool_3 a:hover>span.backlog_collect_not_click {background:url(\"../plugins/wingsToolbar/image3/backlog_collect_click_icon.png\") no-repeat center 0;;}\n.backlog_collect_click {background:url(\"../plugins/wingsToolbar/image3/backlog_collect_click_icon.png\") no-repeat center 0;;}\n.s-tool_3 a span.backlog_collect_unclickable {color:#B6BFC2;background:url(\"../plugins/wingsToolbar/image3/backlog_collect_unclickable_icon.png\") no-repeat center 0;;}\n\t\t\t\t\t\n.s-tool_3 a span.backlog_delete_not_click{background:url(\"../plugins/wingsToolbar/image3/backlog_delete_not_click_icon.png