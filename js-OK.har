          "content": {
            "size": 8780,
            "mimeType": "text/javascript",
            "compression": 5789,
            "text": "/* 导出页面数据(页面所有gird) */\nfunction exportPageData() {\n    var names = [];\n    var wg = $('div[wings=\"WingsGrid\"]');\n    for (var i = 0; i < wg.length; i++) {\n        var gridName = $(wg[i]).attr('name');\n        names.push(gridName);\n    }\n    _expPageData.exportDataByName(names);\n}\n\n/* 组装grid数据，判断数据取自前台还是后端查询数据 */\nvar _expPageData = {\n    expRemindUrl: '', expReminParam: {}, _funName: 'exportExcel', _names: [], _pageBaseData: {}\n    // expRemindUrl: '', expReminParam: {}, _funName: 'exportExcelNew', _names: [], _pageBaseData: {}\n};\n\n/**\n * 导出页面指定Grid表格数据\n * @param names grid名称数组\n */\n_expPageData.exportDataByName = function (names) {\n    var b = true;\n    //判断是否存在可导出数据（全部grid无导出数据时提示）\n    for (var i = 0; i < names.length; i++) {\n        var gd = $w(names[i]).getAllGridData();\n        if (gd.trs.length > 0) {\n            b = false;\n        }\n    }\n\n    if (b) {\n        WingsDialog.alert(\"没有可导出的数据！\");\n        return;\n    }\n    _expPageData._names = names;\n    //公用提示模式进入\n    if (_expPageData.expRpBz == 'Y') {\n        commExportRemind(_expPageData.expRP.sjzcyyDm, _expPageData.expRP.sjzcgnDm, _expPageData.expRP.sjzcbdDm, _expPageData.expRP.backFunction, _expPageData.expRemindUrl);\n    } else {\n        _expPageData.exportSubmit();\n    }\n}\n\n/**\n * 条件导出信息\n */\n_expPageData.exportSubmit = function () {\n    var excelParams = {};\n    excelParams.filename = '';//导出文件名称\n    var sheetList = [];\n    $.each(_expPageData._names, function (i, v) {\n        var _d = _expPageData.getGridDataByName(v);\n        if (checkNull(_d)) {\n            sheetList.push(_d);\n        }\n    });\n    excelParams.sheetList = sheetList;\n\n    //var ajaxParam = $.wingsWidget(names[0]).getOptions().ajaxParam;\n    $.each(_expPageData._pageBaseData, function (key, value) {\n        //特殊字符处理\n        excelParams[key] = checkNull(value) && typeof (value) == 'string' ? value.replace(/\\'/g, \"#d#\") : value;\n    });\n\n    var paramData = new createFormData('dataForm');\n    paramData.setMapData(excelParams);\n\n    var dpSubmit = $.extend(true, {}, _zdySubmit);\n    dpSubmit._ctrl = 'ExportDataCtrl';\n    dpSubmit._postType = 'download';\n    dpSubmit._zdyDataQuerySubmitByPostType(paramData.getFormData(), _expPageData._funName, '', dpSubmit);\n}\n\n_expPageData.getGridDataByName = function (n) {\n    var paramsData = {};\n    if (!checkNull($.wingsWidget(n))) {\n        return paramsData;\n    }\n\n    var option = $.wingsWidget(n).getOptions();\n    var fields = [];\n    var columns = []\n    if ($chk(option.fzbtid)) {\n        //兼容处理动态生产Grid表格带复杂表头导出，获取表头信息\n        var theadOrTbody = option.fzbtid.split('-').length > 1 ? 'thead' : 'tbody';\n        var tzbtBody = $(\"div[name='\" + option.name + \"'] div.ie9bugClass:not(.fixedTablePosition) table.dataTable \" + theadOrTbody).eq(0);\n        tzbtBody.find('tr').each(function (i, p) {\n            var btDataTr = [];\n            $(this).find(\"th\").each(function (i, p) {\n                var th = {\n                    rows: $(this).attr(\"rowspan\"), cols: $(this).attr(\"colspan\"), caption: $(this).text(), colname: $(this).attr(\"colname\"), visible: $(this).is(':visible')\n                };\n                if (th.visible == true) {\n                    btDataTr.push(th);\n                    if ((!$chk(th.cols) || parseInt(th.cols) == 1) && $chk(th.colname)) {\n                        fields.push(th.colname);\n                    }\n                }\n            })\n            columns.push(btDataTr);\n        })\n        if (fields.length < 1) {\n            var header = $.wingsWidget(option.name).getHeader();\n            var btDataTr = [];\n            for (var i = 0; i < header.length; i++) {\n                if (header[i].hasOwnProperty(\"name\")) {\n                    fields.push(header[i][\"name\"]);\n                }\n            }\n        }\n    } else {\n        var header = $.wingsWidget(option.name).getHeader();\n        var btDataTr = [];\n        for (var i = 0; i < header.length; i++) {\n            if (header[i].hasOwnProperty(\"name\")) {\n                fields.push(header[i][\"name\"]);\n            }\n            if (header[i].hasOwnProperty(\"caption\")) {\n                var th = {\n                    rows: \"1\", cols: \"1\", caption: header[i][\"caption\"], colname: header[i][\"name\"], visible: true\n                };\n                btDataTr.push(th);\n            }\n        }\n        columns.push(btDataTr);\n    }\n    var gridData = checkNull(option.ptid) ? [] : _expPageData.getPageGridDdata(option.name);\n    //页面数据为空是否需要导出表格？\n    if ((!checkNull(option.ptid)) && gridData.length == 0) {\n        return paramsData;\n    }\n\n\n    //若存在合计行数据，默认导出\n    var hjData = [];\n    if (checkNull(option.showHJ) && option.showHJ) {\n        var hjtr = $('#' + n + '_hjtr td');\n        for (var i = 0; i < hjtr.length; i++) {\n            var colNameStr = $(hjtr[i]).attr('id');\n            var hjName=colNameStr.split('_').length>3?colNameStr.split('_')[3]:'';//2023-05-31 容错处理\n            hjData.push({name: hjName, value: $(hjtr[i]).text()});\n        }\n    }\n\n    $.extend(_expPageData._pageBaseData, option.ajaxParam);\n    //paramsData.sheetName = $('div[name=\"' + option.name + '\"]').parent().find('div.part_header > span').text();\n    paramsData[n + 'HjData'] = hjData;\n    paramsData.sheetName = $('div[name=\"' + option.name + '\"]').closest('.diy-part').find('div.part_header > span').eq(0).text();\n    paramsData.sheetDataName = checkNull(_expPageData._pageBaseData.gName) ? _expPageData._pageBaseData.gName : option.name;\n    paramsData.sheetFields = fields;\n    if($chk(_expPageData._pageBaseData.callColsbackfun) && $.isFunction(_expPageData._pageBaseData.callColsbackfun)){\n        columns = _expPageData._pageBaseData.callColsbackfun(columns);\n    }\n    paramsData.sheetColumns = columns;\n    paramsData.sheetStyles = {};\n    paramsData.sheetTitle = '';\n    paramsData.sheetSjlybz = checkNull(option.ptid) ? '1' : '0';//0-来源页面数据，1-后端查询数据\n    paramsData.sheetDataList = gridData;\n    paramsData.total = $.wingsWidget(n).getAllGridData().totalRows;\n    return JSON.encode(paramsData);\n}\n\n/* 组装单个Grid页面Json数据 */\n_expPageData.getPageGridDdata = function (n) {\n    var gridData = $w(n).getAllGridData();\n    var data = [];\n    for (var i = 0; i < gridData.trs.length; i++) {\n        var tdsData = gridData.trs[i];\n        var rowMap = {};\n        var tds = tdsData.tds;\n        for (var col in tds) {\n            if (!tds.hasOwnProperty(col)) {\n                continue;\n            }\n            rowMap[col] = tds[col]['value'];\n        }\n        rowMap['xh'] = (i + 1);\n        data.push(rowMap);\n    }\n    return data;\n}\n\n/**\n * 固定导出按钮模式初始化导出按钮\n * @param data 页面加载基础数据\n * @param toolbarName\n * @param name\n * @param _onclickFun 自定义按钮点击事件名称\n */\n_expPageData.initExportButton = function (data, toolbarName, _onclickFun) {\n    $.extend(_expPageData._pageBaseData, data);\n    var siJson = jQuery.parseJSON((data.systemInfo).replace(/\\'/g, \"\\\"\"));\n    var exportFlag = siJson.exportFlag;\n    var funName = checkNull(_onclickFun) ? _onclickFun : 'exportPageData';\n    if (\"Y\" == exportFlag) {\n        $('div[name=\"exportButton\"]').remove();\n        var exportButStr = '<div name=\"exportButton\" type=\"button\" onclick=\"' + funName + '()\" class=\"export\" ' + 'data-size=\"default\" style=\"width: max-content; min-width: 80px; margin-left: 2px;\" data-name=\"button\">导出</div>';\n        $('div[name=\"' + toolbarName + '\"]').append(exportButStr);\n\n        //加载公用导出提示js文件及参数\n        var expJson = jQuery.parseJSON((data.exportInfo).replace(/\\'/g, \"\\\"\"));\n        _expPageData.expRpBz = checkIsNull(expJson.expRpBz) ? 'N' : expJson.expRpBz;\n        if (_expPageData.expRpBz == 'Y') {\n            _expPageData.expRP = {sjzcyyDm: expJson.sjzcyyDm, sjzcgnDm: expJson.sjzcgnDm, sjzcbdDm: expJson.sjzcbdDm, backFunction: \"_expPageData.exportSubmit();\"};\n            _expPageData.expRemindUrl = expJson.expRemindUrl;\n            var ga = document.createElement('script');\n            ga.type = 'text/javascript';\n            ga.async = true;\n            ga.src = '/yxscx/common/exportremind/commexportremind.js';\n            var s = document.getElementsByTagName('script')[0];\n            s.parentNode.insertBefore(ga, s);\n        }\n    }\n}\n\n\n_expPageData.setHideExpButton = function () {\n    $('div[name=\"exportButton\"]').hide();\n}\n\n_expPageData.setShowExpButton = function () {\n    $('div[name=\"exportButton\"]').show();\n}\n\n\n"
          },
