            "mimeType": "text/javascript",
            "compression": 11201,
            "text": "(function($) {\n\t$.fn.wingsTabSelect = function(options) {\n\t\t// 参数赋值\n\t\tvar opts = $.extend( {}, $.fn.wingsTabSelect.defaults, options);\n\t\t//\t\tif (opts.treeType == 0) {\n\t\t//\t\t\t//默认树\n\t\t//\t\t\topts.showCheck = false;\n\t\t//\t\t} else if (opts.treeType == 1) {\n\t\t//\t\t\t//单选树\n\t\t//\t\t\topts.showCheck = true;\n\t\t//\t\t\topts.single = true;\n\t\t//\t\t} else if (opts.treeType == 2) {\n\t\t//\t\t\t//多选树\n\t\t//\t\t\topts.showCheck = true;\n\t\t//\t\t\topts.single = false;\n\t\t//\t\t}\n\n\t\t// 设置数据方法\n\t\tvar $tabSelectThis = $(this);\n\t\t//获取div节点\n\t\tvar $tree = $tabSelectThis[0].parentNode;\n\n\t\t$tabSelectThis.setRule = function(rules) {\n\t\t\topt.rules = rules;\n\t\t};\n\t\t//公共校验方法(传递必要参数即可)\n\t\t$tabSelectThis.validObj = function() {\n\t\t\t//调用校验规则\n\t\t\tif (opts.isNewValidate == \"true\" && opts.rules\n\t\t\t\t\t&& opts.rules.length > 0) {\n\t\t\t\treturn $.wingsValidate2.validObj(opts.v_id, opts.v_obj, $tabSelectThis.getValue(), opts.rules);\n\t\t\t}\n\t\t}\n\n\t\t//判断是否是input\n\t\tvar tagName = $tabSelectThis[0].tagName;\n\t\tvar ele;\n\t\tif ('INPUT' === tagName) {\n\t\t\t//使用字符串替换代替attr方法，IE8不支持attr\n\t\t\tvar inputHTML = $($tabSelectThis.prop(\"outerHTML\"));\n\t\t\tif (!inputHTML.hasClass('col-xs-12')) {\n\t\t\t\tinputHTML.addClass('col-xs-12');\n\t\t\t}\n\n\t\t\tvar viewSpan = $('<span class=\"col-xs-12 wtreeSpan\"></span>');\n\t\t\tvar viewDown = $('<a class=\"wtree_down\"></a>')\n\t\t\tvar inputDiv = $('<div class=\"input-group col-xs-12 no-padding-left no-padding-right wingsTreeInputClass\"></div>');\n\t\t\tinputDiv.append(viewSpan);\n\t\t\tinputDiv.append(viewDown);\n\t\t\tinputDiv.append(inputHTML);\n\n\t\t\topts.showDivId = \"div_treeTemp_\" + opts.p_name + \"_\" + opts.name\n\t\t\t\t\t+ \"_\" + Math.floor(Math.random() * 1000);\n\t\t\tvar treeDiv = $('<div class=\"wtreeDiv\" id=\"' + opts.showDivId + '\" style=\" position: absolute;\" tabindex=\"100\" ></div>');\n\t\t\topts.treeid = $tabSelectThis.attr('id') + \"_treediv\" + \"_\"\n\t\t\t\t\t+ Math.floor(Math.random() * 1000);\n\t\t\tvar treeUl = $('<ul id=\"' + opts.treeid\n\t\t\t\t\t+ '\" class=\"ztree\" style=\"height:' + opts.height\n\t\t\t\t\t+ 'px;\" style=\"margin-top:0;\"></ul>')\n\t\t\ttreeDiv.append(treeUl);\n\t\t\t$('body').append(treeDiv);\n\n\t\t\t//添加显示隐藏事件\n\t\t\t$('#' + opts.showDivId).on(\"mouseenter\", function() {\n\t\t\t\topts.leaveSign = true\n\t\t\t});\n\t\t\t$('#' + opts.showDivId).on(\"mouseleave\", function() {\n\t\t\t\topts.leaveSign = false\n\t\t\t});\n\n\t\t\t$('#' + opts.showDivId).on(\"blur\", function() {\n\t\t\t\tif (!opts.leaveSign) {\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t\t$tabSelectThis.validObj();\n\t\t\t\t\tif (opts.treeType == 2) {\n\t\t\t\t\t\thide();\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\t$('#' + opts.showDivId).focus();\n\t\t\t\t}\n\t\t\t});\n\n\t\t\tvar toogleTreeDiv = function(e) {\n\n\t\t\t\tvar display = treeDiv.css('display') === 'none';\n\t\t\t\tif (display) {\n\t\t\t\t\t_treeShow(e);\n\t\t\t\t} else {\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t}\n\t\t\t}\n\t\t\tviewSpan.click(function(oEvent) {\n\t\t\t\t//控制pulltree 是否可用\n\t\t\t\t\tif (opts.pullTreeAble != \"false\") {\n\t\t\t\t\t\ttoogleTreeDiv(oEvent);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\tviewDown.click(function(oEvent) {\n\t\t\t\teval(viewSpan.click())\n\t\t\t});\n\t\t\tvar hide = function() {\n\t\t\t\tif (opts.onHideBefore != null) {\n\t\t\t\t\tvar tempFn = wings_getFunc(opts.onHideBefore);\n\t\t\t\t\tfor ( var b = 0; b < tempFn.length; b++) {\n\t\t\t\t\t\tvar func = eval(tempFn[b]);\n\t\t\t\t\t\tif (typeof func == \"function\") {\n\t\t\t\t\t\t\tvar result = new func();\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t;\n\t\t\t\t}\n\t\t\t\t$tabSelectThis.validObj();\n\t\t\t\tif (opts.treeType == 1) {\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar _treeShow = function(e, parem) {\n\n\t\t\t\tvar obj = $(e.target);\n\t\t\t\t//自定义下拉树宽度高度\n//\t\t\t\tvar width = $($tree).attr('dataWidth') ? $($tree).attr(\n//\t\t\t\t\t\t'dataWidth') : obj.outerWidth();\n\t\t\t\tvar width = $(window).width() -20 ;\n\t\t\t\tvar height = $($tree).attr('dataHeight');\n\t\t\t\tif (parem && parem.width) {\n\t\t\t\t\twidth = parem.width;\n\t\t\t\t}\n\t\t\t\t//设置下拉树的显示位置\n\t\t\t\tvar top = obj.offset().top + obj.outerHeight() + \"px\";\n//\t\t\t\tvar left = obj.offset().left + \"px\";\n\t\t\t\tvar left = \"10px\";\n\t\t\t\tif (!!height) {\n\t\t\t\t\t$('#' + opts.showDivId).css( {\n\t\t\t\t\t\tminWidth : width,\n\t\t\t\t\t\twidth : width,\n\t\t\t\t\t\theight : height,\n\t\t\t\t\t\ttop : top,\n\t\t\t\t\t\tleft : left\n\t\t\t\t\t});\n\t\t\t\t} else {\n\t\t\t\t\t$('#' + opts.showDivId).css( {\n\t\t\t\t\t\tminWidth : width,\n\t\t\t\t\t\twidth : width,\n\t\t\t\t\t\ttop : top,\n\t\t\t\t\t\tleft : left\n\t\t\t\t\t});\n\t\t\t\t}\n\n\t\t\t\t$('#' + opts.treeid).css( {\n\t\t\t\t\twidth : width\n\t\t\t\t});\n\t\t\t\ttreeDiv.show();\n\t\t\t\t//\t\t\t\t$(document).one('click',dochide);\n\n\t\t\t\t$('#' + opts.showDivId).focus();\n\t\t\t}\n\n\t\t\tele = treeUl;\n\t\t\t$tabSelectThis.replaceWith(inputDiv);\n\t\t}\n\n\t\t//初始化方法\n\t\t$tabSelectThis.init = function(filterData) {\n\t\t\tif (!filterData) {\n\t\t\t\t//显示用数据\n\t\t\t\t$tabSelectThis.showArrData = filterData;\n\t\t\t}else{\n\t\t\t\t//显示用数据\n\t\t\t\t$tabSelectThis.showArrData = $tabSelectThis.pullTreeData;\n\t\t\t};\n\t\t\t//刷新数据\n\t\t\t$tabSelectThis.dataMap = new Map();\n\t\t\tvar tempArr = $tabSelectThis.showArrData;\n\t\t\t\n\t\t\t//保存所有数据\n\t\t\t$tabSelectThis._saveTreeData(tempArr,$tabSelectThis.dataMap)\n\t\t\t\n\t\t\t//生成对应的控件\n\t\t\t//解析数据，生成\n\t\t\tvar arr = [];\n\t\t\tif( tempArr && tempArr.length > 0){\n\t\t\t\tfor(var i =0 ;i< tempArr.length;i++){\n\t\t\t\t\tvar obj = tempArr[i];\n\t\t\t\t\tarr.push(tempArr[i]);\n\t\t\t\t}\n\t\t\t}\n\t\t\t//显示\n//\t\t\tvar tempStr = '<ul class=\"wingsTabSelect_head_ul\"><li class=\"action\">请选择</li><li>请选择</li></ul>';\n//\t\t\ttempStr += '<ul class=\"wingsTabSelect_head_body\"><li>北京</li><li>辽宁</li><li>黑龙江</li></ul>';\n\t\t\t\n\t\t\tvar tempStr = '<ul class=\"wingsTabSelect_head_ul\" id=\"w_head_'+opts.treeid+'\" ></ul>';\n\t\t\t\n\t\t\t//清空其他\n\t\t\t$('#'+ opts.treeid).empty();\n\t\t\t$('#'+ opts.treeid).append(tempStr);\n\t\t\t\n\t\t\t//生成第一个,并展示\n\t\t\t$tabSelectThis._createShowtab(arr,\"true\");\n\t\t\t\n\t\t\t\n\t\t};\n\t\t//递归，保存多有的树节点\n\t\t$tabSelectThis._saveTreeData = function(arr,map){\n\t\t\t\n\t\t\tif( arr && arr.length > 0){\n\t\t\t\tfor(var i =0 ;i< arr.length;i++){\n\t\t\t\t\tvar obj = arr[i];\n\t\t\t\t\tmap.put(obj.code,obj);\n\t\t\t\t\tif(obj.children && obj.children.length >0){\n\t\t\t\t\t\t$tabSelectThis._saveTreeData(obj.children,map);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t//递归，生成一级选择页面\n\t\t$tabSelectThis._createShowtab = function( arr,showFlag,code){\n\t\t\t\n\t\t\tvar c_obj = $tabSelectThis.dataMap.get(code);\n\t\t\t\n\t\t\t//(1)去掉其他高亮，并隐藏其他选择框  \n\t\t\t$('#w_head_'+opts.treeid).find(\">li\").removeClass(\"action\");\n\t\t\t$('#w_head_'+opts.treeid).parent().find(\"ul.wingsTabSelect_head_body\").hide();\n\t\t\t\n\t\t\t//(2)生成tab 和 生成子选项\n\t\t\tvar tsId = $tabSelectThis.attr('id') + \"_sub_tSdiv\" + \"_\"\n\t\t\t\t\t+ Math.floor(Math.random() * 1000);\n\n\t\t\tvar tempStr =\"\";\n\t\t\t//tab\n\t\t\tif(c_obj){\n\t\t\t\t//设置选中的值\n\t\t\t\ttempStr += '<li class=\"action\" id=\"tab_'+tsId+'\" >'+c_obj.caption+'</li>'\n\t\t\t}else{\n\t\t\t\ttempStr += '<li class=\"action\" id=\"tab_'+tsId+'\" >请选择</li>'\n\t\t\t}\n\t\t\t$('#w_head_'+opts.treeid).append(tempStr);\n\t\t\t\n\t\t\t//子选项\n\t\t\ttempStr = \"\";\n\t\t\ttempStr += '<ul class=\"wingsTabSelect_head_body\" id=\"'+tsId+'\" >';\n\t\t\tfor(var i =0 ;i< arr.length;i++){\n\t\t\t\tif(code == arr[i].code){\n\t\t\t\t\ttempStr +='<li code=\"'+arr[i].code+'\" class=\"action\" >'+arr[i].caption+'</li>';\n\t\t\t\t}else{\n\t\t\t\t\ttempStr +='<li code=\"'+arr[i].code+'\" >'+arr[i].caption+'</li>';\n\t\t\t\t}\n\t\t\t};\n\t\t\ttempStr += '</ul>';\n\t\t\t$('#w_head_'+opts.treeid).parent().append(tempStr);\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t//(4)设置tab的点击事件\n\t\t\t$('#tab_'+tsId).on('click',function(e){\n\t\t\t\t//获得目标\n\t\t\t\tvar $ths = $(e.target);\n\t\t\t\t//选中效果\n\t\t\t\t$ths.parent().find(\">li\").removeClass(\"action\");\n\t\t\t\t$ths.addClass(\"action\");\n\t\t\t\tvar sid = $ths.attr(\"id\");\n\t\t\t\tsid = sid.replace(\"tab_\",\"\");\n\t\t\t\t$ths.parent().parent().find(\"ul.wingsTabSelect_head_body\").hide();\n\t\t\t\t$('#'+sid).show();\n\t\t\t})\n\t\t\t\n\t\t\t//(5)设置子项目的点击事件\n\t\t\t$('#'+ tsId).find(\">li\").on('click',function(e){\n\t\t\t\t//获得目标\n\t\t\t\tvar $ths = $(e.target);\n\t\t\t\t//选中效果\n\t\t\t\t$ths.parent().find(\">li\").removeClass(\"action\");\n\t\t\t\t$ths.addClass(\"action\");\n\t\t\t\t//删除后续选项\n\t\t\t\tif($ths.parent().next().hasClass(\"wingsTabSelect_head_body\") ){\n\t\t\t\t\tvar p_tsId = $ths.parent().attr(\"id\");\n\t\t\t\t\t//删除后放所有\n\t\t\t\t\t$('#tab_'+p_tsId).nextAll().remove();\n\t\t\t\t\t$('#'+p_tsId).nextAll().remove();\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t\n\t\t\t\tvar obj = $tabSelectThis.dataMap.get($ths.attr(\"code\"));\n\t\t\t\t//设置值 \n\t\t\t\tviewSpan.html(obj.caption);\n\t\t\t\tinputHTML.val(obj.code);\n\t\t\t\t\n\t\t\t\t//处理单击事件\n\t\t\t\tif (opts.onCheckBefore) {\n\t\t\t\t\tvar onCheckBeforeParam = [ opts.treeid, obj ];\n\t\t\t\t\tonCheckBeforeParam = onCheckBeforeParam\n\t\t\t\t\t\t\t.concat(opts.onCheckBeforeParam);\n\t\t\t\t\tvar tempFn = wings_getFunc(opts.onCheckBefore);\n\t\t\t\t\tfor ( var b = 0; b < tempFn.length; b++) {\n\t\t\t\t\t\tvar func = eval(tempFn[b]);\n\t\t\t\t\t\tif (typeof func == \"function\") {\n\t\t\t\t\t\t\tvar result = func.apply($tabSelectThis,\n\t\t\t\t\t\t\t\t\tonCheckBeforeParam);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tvar sid = $ths.parent().attr(\"id\");\n\t\t\t\t$('#tab_'+sid).html(obj.caption);\n\t\t\t\t//生成下一个选择\n\t\t\t\tif(obj.children && obj.children.length >0){\n\t\t\t\t\t$tabSelectThis._createShowtab(obj.children,\"true\");\n\t\t\t\t}else{\n\t\t\t\t\t//关闭选择页面\n\t\t\t\t\ttreeDiv.hide();\