            "compression": 452,
            "text": "function addWaterMark(showText) {\n    const antArr = document.getElementsByClassName('innerContent');\n    var font = '20px 楷体';\n    const cw = document.createElement('canvas');\n    cw.id = 'watermark';\n    cw.width = 500;\n    cw.height = 100;\n    const ctx = cw.getContext('2d'); // 返回一个用于在画布上绘图的环境\n    ctx.clearRect(0, 0, 160, 100); // 绘制之前画布清除\n    ctx.font = font;\n    ctx.rotate(-10 * Math.PI / 180);\n    ctx.fillStyle = 'rgba(100,100,100,0.26)';\n    ctx.fillText(showText, -10, 80);\n    ctx.rotate(10 * Math.PI / 180); // 坐标系还原\n    const img_src = cw.toDataURL();\n\n    //增加水印\n    var selectors = ['div[wings=\"WingsGrid\"]', 'div[wings=\"WingsForm\"]', 'div.watermark'];\n    for (let i = 0; i < selectors.length; i++) {\n        $(selectors[i]).css({\"background\": \"#ffffff\", \"background-image\": \"url(\" + img_src + \")\"});\n    }\n\n    //剔除不需要增加水印部分\n    var notFormOrGridDiy = $('div.noWaterMark');\n    for (let i = 0; i < notFormOrGridDiy.length; i++) {\n        $(notFormOrGridDiy[i]).css({\"background\": \"\", \"background-image\": \"\"});\n    }\n\n}\n"
          },
