}\n    });\n    $(this).prev().find('div').each(function (i) {\n        var act = $(this).parent().find('div').eq(0).attr('class');\n        if (act.indexOf('active') != -1) {\n            $(this).removeClass(\"in active\")\n            $(this).parent().find('div').eq(3).addClass(\"in active\");\n            return false;\n        }\n        var cls = $(this).attr('class');\n        if (cls.indexOf('active') != -1) {\n            $(this).removeClass('in active');\n            $(this).prev().addClass('in active');\n            return false;\n        }\n    });\n});\n\n$(document).on('click', '.upIn', function () {\n    $(this).prev().prev().prev().find('li').each(function (i) {\n        if (i > 2) {\n            var first = $(this).parent().find('li').eq(0);\n            $(this).removeClass(\"active\")\n            first.addClass(\"active\");\n            return false;\n        }\n        var cls = $(this).attr('class');\n        if (cls) {\n            $(this).removeClass(\"active\")\n            $(this).next().addClass(\"active\");\n            return false;\n        }\n    });\n    $(this).prev().prev().find('div').each(function (i) {\n        if (i > 2) {\n            var first = $(this).parent().find('div').eq(0);\n            $(this).removeClass(\"in active\")\n            first.addClass(\"in active\");\n            return false;\n        }\n        var cls = $(this).attr('class');\n        if (cls.indexOf('active') != -1) {\n            $(this).removeClass('in active');\n            $(this).next().addClass('in active');\n            return false;\n        }\n    });\n});\n\n//解决IE8之类不支持getElementsByClassName\nif (!document.getElementsByClassName) {\n    document.getElementsByClassName = function (className, element) {\n        var children = (element || document).getElementsByTagName('*');\n        var elements = new Array();\n        for (var i = 0; i < children.length; i++) {\n            var child = children[i];\n            var classNames = child.className.split(' ');\n            for (var j = 0; j < classNames.length; j++) {\n                if (classNames[j] == className) {\n                    elements.push(child);\n                    break;\n                }\n            }\n        }\n        return elements;\n    };\n}\n\nfunction changeInput() {\n    isEnable(\".btnSave\", \"N\");\n    isEnable(\".btnSaveAs\", \"N\");\n    isEnable(\".btnExport\", \"N\");\n}\n\nfunction isEnable(selector, flag) {\n    if (flag == 'Y') {\n        $(selector).css(\"background-color\", \"\");\n        $(selector).removeAttr('disabled');\n    } else if (flag == 'N') {\n        $(selector).css(\"background-color\", \"#ccc\");\n        $(selector).attr('disabled', 'disabled');\n    }\n}\n\n//用于区域外点击时隐藏树，全局id\nvar idTree;\n\nfunction initSwjgList(swjgList, id) {\n    if (checkNull(swjgList.data)) {\n        var data = swjgList.data;\n        $(\"#orgCode\" + id).val(data[0].code);\n        $(\"#orgName\" + id).val(data[0].caption);\n    }\n}\n\n\nfunction hideTree(id) {\n    $('#' + id).css('display', 'none');\n    $(\"body\").unbind(\"mousedown\", onBodyDownByActionType);\n    return false;\n}\n\nfunction ParamsChange(data) {\n    var str = checkNull(data) ? \"'\" + data.replace(new RegExp(',', \"g\"), \"','\") + \"'\" : \"\";\n    return str;\n}\n\n//区域外点击事件\nfunction onBodyDownByActionType(event) {\n    if (event.target.id.indexOf(idTree) == -1) {\n        if (event.target.id != 'selectDevType') {\n            hideTree(idTree);\n        }\n    }\n}\n\nvar _hiddenNodesCache = {};\nvar _pullTreeInputRun = {};\nvar _treeOnmouseout = {};\n\n// 节点点击事件\nfunction zTreeOnClick2(id, code, caption, event, treeId) {\n    /*$('#caption'+id).val(treeId.caption);\n    $('#code'+id).val(treeId.code);*/\n    /*$('input[name=\"'+code+'\"]').val(treeId.code);\n    $('input[name=\"'+caption+'\"]').val(treeId.caption);*/\n    if ($chk(treeId['qxbj'])) {\n        if (\"Y\" != treeId['qxbj']) {\n            return false;\n        }\n    }\n    treeId.code = checkNull(treeId.code) && treeId.code.indexOf(\"-\") > -1 ? treeId.code.split('-')[0] : treeId.code;\n    var codeEl = $('input[name=\"' + code + '\"]');\n    codeEl.val(treeId.code);\n    var captionEl = $('input[name=\"' + caption + '\"]');\n    captionEl.val(treeId.caption);\n    captionEl.data(code, treeId.code);\n    captionEl.data(caption, treeId.caption);\n    $('#' + id).css('display', 'none');\n    try {\n        var formEl = $('#' + id).closest('div[wings=\"WingsForm\"]');\n        if ($chk(formEl) && formEl.length > 0) {\n            var formName = formEl.attr(\"name\");\n            if ($chk(formName)) {\n                $w(formName).setValue(code, treeId.code);\n                $w(formName).setValue(caption, treeId.caption);\n            }\n        }\n    } catch (e) {\n        e.message;\n    }\n}\n\nfunction treeOnmouseover(id) {\n    _treeOnmouseout[id] = true;\n}\n\nfunction treeOnmouseleave(id, code, caption, inputCaptionId) {\n    _treeOnmouseout[id] = false;\n    setTimeout(function () {\n        $(\"#\" + inputCaptionId).focus();\n    }, 1);\n}\n\nfunction findOnmouseover(id) {\n    _treeOnmouseout[id] = true;\n}\n\nfunction findOnmouseout(id) {\n    _treeOnmouseout[id] = false;\n}\n\nfunction hideTree21(id, code, caption) {\n    //var isFocus = $(\"#\"+id).is(\":focus\");\n    /*if(true==isFocus){\n        alert(\"focus\");\n    }else{\n        alert(\"blur\");\n        if ($('#'+id).css('display') == 'none')\n    }*/\n    if (!$chk(_treeOnmouseout[id]) || !_treeOnmouseout[id]) {\n        hideTree2(id, code, caption);\n    }\n    /* var hidefocus=$(\"#\"+id).find(\"[hidefocus='true']\");\n     if(hidefocus.length=1){\n         //hideTree2(id,code,caption);\n     }else {\n         hideTree2(id,code,caption);\n     }*/\n}\n\nfunction initPullTreeByformData(formName, codeName, captionName) {\n    try {\n        var caption = $('input[name=\"' + captionName + '\"]');\n        var code = $('input[name=\"' + codeName + '\"]');\n        var initCaption = $w(formName).getValue(captionName);\n        var initCode = $w(formName).getValue(codeName);\n        caption.val(initCaption);\n        code.val(initCode);\n        caption.data(codeName, initCode);\n        caption.data(captionName, initCaption);\n    } catch (e) {\n        e.message;\n    }\n}\n\nfunction hideTree2(id, code, caption) {\n    _treeOnmouseout[id] = false;\n    var codeEl = $('.wingsSelect-table input.zdy-wingstree-code-input[name=\"' + code + '\"]');\n    var captionEl = $('.wingsSelect-table input.zdy-wingstree-input[name=\"' + caption + '\"]');\n\n    var codeValue = codeEl.val() || captionEl.data(code);\n    var captionValue = captionEl.val() || captionEl.data(caption);\n\n    codeEl.val(codeValue);\n    captionEl.val(captionValue);\n    try {\n        var formEl = $('#' + id).closest('div[wings=\"WingsForm\"]');\n        if ($chk(formEl) && formEl.length > 0) {\n            var formName = formEl.attr(\"name\");\n            if ($chk(formName)) {\n                $w(formName).setValue(code, codeValue);\n                $w(formName).setValue(caption, captionValue);\n            }\n        }\n    } catch (e) {\n        e.message;\n    }\n    $('#' + id).css('display', 'none');\n}\n\n// 下拉框显示 隐藏\nfunction showTree2(id, code, caption, inputCaptionId) {\n    if ($('#' + id).css('display') == 'none') {\n        $('#' + id).css('display', 'block');\n        if ($chk(_hiddenNodesCache[id]) && _hiddenNodesCache[id]) {\n            var treeObj = $w(id).getTreeRealObj();\n            var allNode = treeObj.transformToArray(treeObj.getNodes());\n            treeObj.showNodes(allNode);\n        }\n        var inputwidth = $(\"#\" + inputCaptionId).css(\"width\");\n        //.offset().top; .offset().left;.position().top;.position().left;\n        var inputTop = $(\"#\" + inputCaptionId).offset().top;\n        var inputLeft = $(\"#\" + inputCaptionId).offset().left;\n        $('#' + id).offset({top: inputTop + 35, left: inputLeft});\n        var unit = inputwidth.slice(-2);\n        var inputwidth = parseFloat(inputwidth);\n        $('#' + id).css(\"width\", inputwidth + \"\" + unit);\n        /*var inputheight = $(\"#\"+inputCaptionId).parent().css(\"height\");\n        var unit=inputheight.slice(-2);\n        var inputheight=parseFloat(inputheight);\n        if(inputheight>40){\n            $('#' + id).parent().css({\"top\":\"-12px\"});\n        }*/\n    } else {\n        hideTree2(id, code, caption);\n    }\n}\n\n\nfunction searchNodes2(self, treeid, code, caption, inputTime) {\n    if (!$chk(_pullTreeInputRun[treeid]) || \"\" == _pullTreeInputRun[treeid]) {\n        if (!$chk(inputTime)) {\n            inputTime = \"500\";\n        }\n        inputTime = parseInt(inputTime);\n        setTimeout(function () {\n            searchNodes(self, treeid, code, caption);\n        }, inputTime);\n        _pullTreeInputRun[treeid] = \"true\";\n    }\n}\n\n\n// 节点点击事件\nfunction zTreeOnClick2(id, code, caption, event, treeId) {\n    /*$('#caption'+id).val(treeId.caption);\n    $('#code'+id).val(treeId.code);*/\n    /*$('input[name=\"'+code+'\"]').val(treeId.code);\n    $('input[name=\"'+caption+'\"]').val(treeId.caption);*/\n    if ($chk(treeId['qxbj'])) {\n        if (\"Y\" != treeId['qxbj']) {\n            return false;\n        }\n    }\n    //查询到指定层级机关树代码值数据还原\n    treeId.code = checkNull(treeId.code) && treeId.code.indexOf(\"-\") > -1 ? treeId.code.split('-')[0] : treeId.code;\n    var codeEl = $('input[name=\"' + code + '\"]');\n    codeEl.val(treeId.code);\n    var captionEl = $('input[name=\"' + caption + '\"]');\n    captionEl.val(treeId.caption);\n    captionEl.data(code, treeId.code);\n    captionEl.data(caption, treeId.caption);\n    $('#' + id).css('display', 'none');\n    try {\n        var formEl = $('#' + id).closest('div[wings=\"WingsForm\"]');\n        if ($chk(formEl) && formEl.length > 0) {\n            var formName = formEl.attr(\"name\");\n            if ($chk(formName)) {\n                $w(formName).setValue(code, treeId.code);\n                $w(formName).setValue(caption, treeId.caption);\n            }\n        }\n    } catch (e) {\n        e.message;\n    }\n}\n\n/* 表格中下拉 树 自定义 */\nfunction treeOnmouseleaveIntable(id, rowIndex, codeName, inputId) {\n    _treeOnmouseout[id] = false;\n    var inputCaptionId = inputId + rowIndex;\n    setTimeout(function () {\n        $(\"#\" + inputCaptionId).focus();\n    }, 1);\n}\n\nfunction hideTreeIntable1(id, rowIndex, codeName, inputId) {\n    if (!$chk(_treeOnmouseout[id]) || !_treeOnmouseout[id]) {\n        hideTreeIntable(id, rowIndex, codeName, inputId);\n    }\n}\n\nfunction hideTreeIntable(id, rowIndex, codeName, inputId) {\n    _treeOnmouseout[id] = false;\n    $('#' + id).css('display', 'none');\n}\n\n// 下拉框显示 隐藏\nfunction showTreeIntable(id, rowIndex, codeName, inputId) {\n    $('#' + id).data(\"inputCaptionId\", \"\");\n    $('#' + id).data(\"codeName\", \"\");\n    if ($('#' + id).css('display') == 'none') {\n        $('#' + id).css('display', 'block');\n        if ($chk(_hiddenNodesCache[id]) && _hiddenNodesCache[id]) {\n            var treeObj = $w(id).getTreeRealObj();\n            var allNode = treeObj.transformToArray(treeObj.getNodes());\n            treeObj.showNodes(allNode);\n        }\n        var inputCaptionId = inputId + rowIndex;\n        $('#' + id).data(\"inputCaptionId\", inputCaptionId);\n        $('#' + id).data(\"codeName\", codeName);\n        var inputwidth = $(\"#\" + inputCaptionId).css(\"width\");\n        //.offset().top; .offset().left;.position().top;.position().left;\n        var inputTop = $(\"#\" + inputCaptionId).offset().top;\n        var inputLeft = $(\"#\" + inputCaptionId).offset().left;\n        $('#' + id).offset({top: inputTop + 35, left: inputLeft});\n        var unit = inputwidth.slice(-2);\n        var inputwidth = parseFloat(inputwidth);\n        $('#' + id).css(\"width\", inputwidth + \"\" + unit);\n        /*var inputheight = $(\"#\"+inputCaptionId).parent().css(\"height\");\n        var unit=inputheight.slice(-2);\n        var inputheight=parseFloat(inputheight);\n        if(inputheight>40){\n            $('#' + id).parent().css({\"top\":\"-12px\"});\n        }*/\n    } else {\n        hideTreeIntable(id, rowIndex, codeName, inputId);\n    }\n}\n\nfunction searchNodesIntable(self, treeid, rowIndex, codeName, inputTime) {\n    return;\n    if (!$chk(_pullTreeInputRun[treeid]) || \"\" == _pullTreeInputRun[treeid]) {\n        if (!$chk(inputTime)) {\n            inputTime = \"500\";\n        }\n        inputTime = parseInt(inputTime);\n        setTimeout(function () {\n            searchNodes2(self, treeid, code, caption);\n        }, inputTime);\n        _pullTreeInputRun[treeid] = \"true\";\n    }\n}\n\n\n// 节点点击事件\nfunction zTreeOnClickIntable(id, rowIndex, codeName, inputId, event, treeId) {\n    /*$('#caption'+id).val(treeId.caption);\n    $('#code'+id).val(treeId.code);*/\n    /*$('input[name=\"'+code+'\"]').val(treeId.code);\n    $('input[name=\"'+caption+'\"]').val(treeId.caption);*/\n    $('#' + id).css('display', 'none');\n\n}\n\nfunction searchNodes(self, treeid, code, caption) {\n    _pullTreeInputRun[treeid] = \"\";\n    //showTree2(treeid,code,caption);\n    $('#' + treeid).css('display', 'block');\n    var _this = $(self);\n    _hiddenNodesCache[treeid] = false;\n    var findValue = _this.data(\"findValue\");\n    var findValueCount = _this.data(\"findValueCount\");\n    var hidden = _this.data(\"hidden\");\n    findValueCount = $chk(findValueCount) ? parseInt(findValueCount) : 0;\n    var treeObj = $w(treeid).getTreeRealObj();\n    var keywords = $('input[name=\"' + caption + '\"]').val();\n    //var keywords = $(\"#orgName\" + treeid).val();\n    if ($chk(hidden) && hidden) {\n        var allNode = treeObj.transformToArray(treeObj.getNodes());\n        treeObj.hideNodes(allNode);\n        //显示上次搜索后背隐藏的结点\n        /*if ($chk(_hiddenNodesCache[treeid])) {\n            treeObj.showNodes(_hiddenNodesCache[treeid]);\n        }*/\n\n        //查找不符合条件的叶子节点\n        function filterFunc(node) {\n            try {\n                if (node.caption.indexOf(keywords) != -1) {\n                    return true;\n                } else {\n                    return false;\n                }\n            } catch (e) {\n                e.messages;\n                return true;\n            }\n        };\n\n        function findParent(treeObj, node) {\n            treeObj.expandNode(node, true, false, false);\n            var pNode = node.getParentNode();\n            if (pNode != null) {\n                nodeList.push(pNode);\n                findParent(treeObj, pNode);\n            }\n        };\n        if ($chk(keywords) && \"\" != keywords) {\n            //获取不符合条件的叶子结点\n            var nodeList = treeObj.getNodesByFilter(filterFunc);\n            nodeList = treeObj.transformToArray(nodeList);\n            for (var n in nodeList) {\n                if (nodeList.hasOwnProperty(n)) {\n                    findParent(treeObj, nodeList[n]);\n                }\n            }\n            if (nodeList.length == 0) {\n                //hideTree2(treeid,code,caption);\n                //$('#'+treeid).css('display', 'none');\n            }\n            treeObj.showNodes(nodeList);\n            _hiddenNodesCache[treeid] = true;\n            //隐藏不符合条件的叶子结点\n            //treeObj.hideNodes(hiddenNodes);\n            /*if(nodeList.length>20){\n                treeObj.expandAll(false);\n            }else{\n                treeObj.expandAll(true);\n            }*/\n        } else {\n            treeObj.showNodes(allNode);\n            //treeObj.expandAll(false);\n        }\n    } else {\n        var nodes = treeObj.getNodesByParamFuzzy(\"caption\", keywords, null);\n        if (nodes.length > 0) {\n            if (findValue == keywords) {\n                var index = nodes.length > findValueCount ? findValueCount : 0;\n                treeObj.selectNode(nodes[index]);\n                _this.data(\"findValue\", keywords);\n                _this.data(\"findValueCount\", index + 1);\n            } else {\n                treeObj.selectNode(nodes[0]);\n                _this.data(\"findValue\", keywords);\n                _this.data(\"findValueCount\", 1);\n            }\n        } else {\n            WingsDialog.alert(\"没有搜索到数据！\")\n        }\n    }\n}\n\n\nfunction clearInputData(self, treeid, code, caption) {\n    var codeEl = $('input[name=\"' + code + '\"]');\n    codeEl.val(\"\");\n    var captionEl = $('input[name=\"' + caption + '\"]');\n    captionEl.val(\"\");\n    captionEl.data(code, \"\");\n    captionEl.data(caption, \"\");\n    //$('#' + treeid).css('display', 'none');\n    try {\n        var formEl = $('#' + treeid).closest('div[wings=\"WingsForm\"]');\n        if ($chk(formEl) && formEl.length > 0) {\n            var formName = formEl.attr(\"name\");\n            if ($chk(formName)) {\n                $w(formName).setValue(code, \"\");\n                $w(formName).setValue(caption, \"\");\n            }\n        }\n    } catch (e) {\n        e.message;\n    }\n\n    var keywords = $('input[name=\"' + caption + '\"]').val();\n    var keywords = $('input[name=\"' + code + '\"]').val();\n}\n\n// 节点点击事件\nfunction zTreeOnClick(id, event, treeId) {\n    $('#orgName' + id).val(treeId.caption);\n    $('#orgCode' + id).val(treeId.code);\n    hideTree(id);\n}\n\n// 下拉框显示 隐藏\nfunction showTree(id) {\n    if ($('#' + id).css('display') == 'none') {\n        $('#' + id).css('display', 'block');\n        var treeObj = $w(id).getTreeRealObj();\n        var allNode = treeObj.transformToArray(treeObj.getNodes());\n        treeObj.showNodes(allNode);\n    } else {\n        $('#' + id).css('display', 'none');\n    }\n    $(\"body\").bind(\"mousedown\", onBodyDownByActionType);\n    idTree = id;\n}\n\n\n//空判断  JSON.stringify(value)==\"{}\"\nfunction checkNull(value) {\n    if (typeof value == undefined || value == 'undefined' || value == null || value == \"NaN\" || value == \"\" || value == \"[]\" || value == \"[{}]\" || value == \"null\" || value == \"{}\" || value == {}) {\n        return false;\n    }\n    return true;\n}\n\n//空判断，为空返回true\nfunction checkIsNull(value) {\n    return !checkNull(value);\n}\n\nfunction error(res) {\n    var debugObj = {};\n    debugObj.exceptionMes = res.exceptionMes;\n    debugObj.debugMes = res.debugMes;\n    WingsDialog.alertDebugMsg(debugObj);\n    $(\"#menban\").hide();//消失\n}\n\n\nfunction createFormData(name) {\n    var _ = this;\n    _.data = {};//new Array();\n    _.formdata = {\"sword\": 'SwordForm', \"name\": name, \"data\": _.data}\n    _.setData = function (name, value) {\n        _.data[name] = {\"value\": value};\n    }\n    _.getData = function (name) {\n        return _.data[name][\"value\"];\n    }\n    _.setMapData = function (map) {\n        for (var key in map) {\n            _.data[key] = {\"value\": map[key]};\n        }\n    }\n    _.getFormData = function () {\n        _.formdata[\"data\"] = _.data;\n        return _.formdata;\n    }\n    return _;\n}\n\n\n///根据传入的json数组、form元素，给form赋值\nfunction loadFormData(jsondata, formys) {\n\n    $.each(jsondata, function (name, ival) {\n        var $oinput = formys.find(\"#\" + name);\n        if ($oinput.attr(\"type\") == \"radio\" || $oinput.attr(\"type\") == \"checkbox\") {\n            $oinput.each(function () {\n                if (Object.prototype.toString.apply(ival) == '[object Array]') {//是复选框，并且是数组\n                    for (var i = 0; i < ival.length; i++) {\n                        if ($(this).val() == ival[i]) $(this).attr(\"checked\", \"checked\");\n                    }\n                } else {\n                    if ($(this).val() == ival) $(this).attr(\"checked\", \"checked\");\n                }\n            });\n            $oinput.attr('disabled', true);\n        } else if ($oinput.attr(\"type\") == \"textarea\") {//多行文本框\n            $oinput.html(ival);\n            $oinput.attr('readonly', true);\n        } else {\n            $oinput.val(ival);\n            $oinput.attr('readonly', true);\n        }\n    });\n};\n\nfunction gyException(res) {\n    offMenban();\n    //仅大屏开发使用\n    let _dpBz = typeof (_CON_DP_EOR_BZ) == \"undefined\" ? '' : _CON_DP_EOR_BZ;\n    if (_dpBz == 'Y') {\n        $(\"#menban\").show();\n        if ($chk($(\"#menban > div.pic\")[0])) {\n            $(\"#menban > div.pic\").css({'background': 'unset', 'background-color': '#55b5da', 'padding-left': '60px'});\n            $(\"#menban > div.pic\")[0].innerHTML = '抱歉，查询异常，请联系运维管理人员！';\n        }\n        return;\n    }\n\n    var dialogException = $('div.modal-dialog .modal-body .wings-exception-detail');\n    var exceptionMes_o = dialogException.text();\n    if ($chk(exceptionMes_o)) {//不为空\n        var closeButtn = dialogException.parents('.modal-dialog').find('.bootstrap-dialog-close-button');\n        closeButtn.trigger('click');\n        var len = eval(\"exceptionMes_o.match(/简要异常堆栈信息/ig).length\");\n        res.debugMes = '第' + len + '个错误信息-------------------------------------------------------- \\r\\n' + res.debugMes + '\\r\\n' + exceptionMes_o.replace(/\\n/g, '\\r\\n');\n    }\n\n    if (!$chk(res) || !$chk(res.exceptionMes)) {\n        WingsDialog.alertWrong(\"错误\", \"业务处理过程中出现不可预见的错误！\" + !$chk(res) ? \"\" : res);\n        return;\n    }\n    var debugObj = {};\n    var mes = res.exceptionMes.replace(/&lt;br&gt;/g, '<br>');\n    var code = res.exceptionName;\n    var exnum = code.substring(0, 15);\n    var debugMes = ['<pre style=\"text-align: left;height: 280px;\">', res.debugMes, '</pre>'].join('');\n    debugObj.exceptionName = code;\n    debugObj.exceptionMes = mes;\n    debugObj.debugMes = debugMes;\n    /* var tag = 1;\n     if (/^(\\d{15})$/.test(exnum)) {\n         tag = exnum.substring(5, 6);\n     }\n     if (tag == 1) {\n         WingsDialog.alert(\"提示\", debugObj.exceptionMes);\n     } else if (tag == 2) {\n         WingsDialog.alertWarn(\"警告\", debugObj.exceptionMes);\n     } else if (tag == 3) {\n         WingsDialog.alertWrong(\"错误\", debugObj.exceptionMes);\n     } else {\n         WingsDialog.alertDebugMsg(debugObj);\n     }*/\n    //WingsDialog.alertWrong(debugObj.exceptionMes);\n\n    //格式化显示内容\n    debugObj.debugMes = debugObj.debugMes.replace(/\\n/g, '');\n    WingsDialog.alertDebugMsg(debugObj);\n};\n\n\n/**\n * 按钮置灰\n *\n * @returns\n */\nfunction anzh(but_name) {\n    $(\"#\" + but_name + \"\").attr(\"disabled\", true);\n    $(\"#\" + but_name + \"\").addClass(\"disable\");\n    $(\"#\" + but_name + \"\").css(\"background-color\", \"#ccc\");\n    $(\"#\" + but_name + \"\").css(\"cursor\", \"not-allowed\");\n    $(\"#\" + but_name + \"\").attr('onclick', '')\n}\n\n/**\n * 启用按钮\n *\n * @returns\n */\nfunction qyan(but_name) {\n    $(\"#\" + but_name + \"\").removeAttr('disabled');\n    $(\"#\" + but_name + \"\").removeClass(\"disable\");\n    $(\"#\" + but_name + \"\").css(\"background-color\", \"\");\n    $(\"#\" + but_name + \"\").css(\"cursor\", \"\");\n}\n\n/**\n * 打开蒙版，message不为空时，修改提示信息\n * @param message\n */\nfunction openMenban(message) {\n    //判断蒙版元素是否存在\n    if ($(\"#menban\").length == 0) {\n        var str = '<div class=\"loading\" style=\"display:none;\" id=\"menban\"><div class=\"pic\">查询中,请稍后。。。</div><div className=\"jiazai\" class=\"jiazai\"></div></div>';\n        $(\"body\").append(str);\n    } else if ($(\"#menban\").length > 1) {\n        //清理多余加载元素\n        $(\"#menban\").remove();\n    }\n\n    $(\"#menban\").show();\n    if ($chk(message)) {\n        menbanMassage(message);\n    }\n}\n\n/**\n * 关闭蒙版\n */\nfunction offMenban() {\n    $(\"#menban\").hide();\n}\n\n//蒙版提示信息\nfunction menbanMassage(massage) {\n    /*if ($chk($(\"#menban > div.jiazai-ts\")[0])) {\n        $(\"#menban > div.jiazai-ts\")[0].innerHTML = massage;\n    }*/\n    if ($chk($(\"#menban > div.pic\")[0])) {\n        $(\"#menban > div.pic\")[0].innerHTML = massage;\n    }\n}\n\n//日期格式处理\nfunction dateStyles_ts(str) {\n    if (checkNull(str)) {\n        var namesStr = str.split(\",\");\n        for (var i = 0; i < namesStr.length; i++) {\n            var obj = document.getElementsByName(namesStr[i])[0];\n            obj.classList.remove(\"input-group\");//删除原有样式\n            obj.classList.add(\"form-control\");\n            obj.classList.add(\"input-group-ts\");//添加新样式\n        }\n    }\n}\n\nfunction isTop() {\n    try {\n        var tab = top.pc.getWidget('tab1');\n        var iframes = window.top.document.getElementsByTagName(\"iframe\");\n        var curTabItem = tab.curTabItem;\n        return window.top == window.self || typeof (curTabItem) === \"undefined\";\n    } catch (e) {\n        return false;\n    }\n}\n\nfunction addTabItemAndCloseCurTab(ctrl, paramsString, title, id) {\n    try {\n        var tab = top.pc.getWidget('tab1');\n        //var iframes = window.top.document.getElementsByTagName(\"iframe\");\n        var curTabItem = tab.curTabItem;\n        addTabItemLocal(ctrl, paramsString, title, id);\n        if (window.top == window.self || typeof (curTabItem) === \"undefined\") {\n            window.close()\n        } else {\n            tab.removeTabItem(curTabItem.options.id);\n        }\n    } catch (e) {\n        window.close()\n    }\n}\n\nfunction getCurTab() {\n    try {\n        var tab = top.pc.getWidget('tab1');\n        //var iframes = window.top.document.getElementsByTagName(\"iframe\");\n        var curTabItem = tab.curTabItem;\n        return curTabItem.options.id;\n    } catch (e) {\n        return null;\n    }\n}\n\nfunction closeTabById(id) {\n    try {\n        if (!$chk(id)) {\n            window.close();\n            return;\n        }\n        var tab = top.pc.getWidget('tab1');\n        //var iframes = window.top.document.getElementsByTagName(\"iframe\");\n        var curTabItem = tab.curTabItem;\n        if (window.top == window.self || typeof (curTabItem) === \"undefined\") {\n            window.close();\n        } else {\n            tab.removeTabItem(id);\n        }\n    } catch (e) {\n        window.close()\n    }\n}\n\nfunction closeCurTab() {\n    try {\n        var tab = top.pc.getWidget('tab1');\n        //var iframes = window.top.document.getElementsByTagName(\"iframe\");\n        var curTabItem = tab.curTabItem;\n        if (window.top == window.self || typeof (curTabItem) === \"undefined\") {\n            window.close()\n        } else {\n            tab.removeTabItem(curTabItem.options.id);\n        }\n    } catch (e) {\n        window.close()\n    }\n}\n\nvar prefix = \"http://\";\nvar host = window.location.host;\n\n// 以添加表头形式打开\nfunction addTabItemLocal(url, params, title, idStr) {\n    var iWidth = window.screen.availWidth - 10;\n    var iHeight = window.screen.availHeight - 30;\n    var iTop = 0;\n    var iLeft = 0;\n    var baseurl = url;\n    params = EncryptUtils.encryptStr(params);\n    var PageUrl = prefix + host + baseurl + params;\n    if (window.top == window.self) {\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=0, left=0, toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n        return;\n    }\n    try {\n        top.addTabItem({\n            id: idStr,/*唯一标识码*/\n            title: title, tabContentType: 'iframe', src: PageUrl, isCloseBtn: 'true', tabItemWidth: 150, isShowMenuItem: [\"false\", \"true\", \"true\", \"true\"], tempData: title\n        });\n    } catch (e) {\n        e.message;\n        var openUrl = \"\";\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=' + iTop + ', left=' + iLeft + ', toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,width=' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n    }\n}\n\n//20260318，新增传入固定url增加tab方法\nfunction addTabItemLocalWithUrl(url, params, title, idStr) {\n    var iWidth = window.screen.availWidth - 10;\n    var iHeight = window.screen.availHeight - 30;\n    var iTop = 0;\n    var iLeft = 0;\n    params = EncryptUtils.encryptStr(params);\n    var PageUrl = url;\n    try {\n        top.addTabItem({\n            cxbj: 'N',\n            id:  Math.random(),/*唯一标识码*/\n            title: title,\n            src: PageUrl + params,  //打开tab页面，参数不能编码\n        });\n    } catch (e) {\n        e.message;\n        params = encodeURI(params); //浏览器打开页面，参数增加编码\n        PageUrl = PageUrl + params;\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=' + iTop + ', left=' + iLeft + ', toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,width=' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n    }\n}\n\n/**\n * 将指定id元素置灰不可编辑或使用\n * @param id_name\n * @returns\n */\nfunction setDisable(id_name) {\n    $(\"#\" + id_name + \"\").attr(\"disabled\", \"disabled\");\n    $(\"#\" + id_name + \"\").css(\"background-color\", \"#ccc\");\n    $(\"#\" + id_name + \"\").css(\"cursor\", \"not-allowed\");\n}\n\n;(function ($) {\n    $.HashMap = function () {\n        var _this = this;\n        _this.obj = {};\n        _this.size = 0;\n        _this.get = function (key) {\n            return _this.obj[key];\n        };\n        _this.put = function (key, value) {\n            _this.obj[key] = value;\n            _this.size++;\n        };\n        _this.containsKey = function (key) {\n            return eval(_this.obj[key]);\n        };\n        _this.size = function () {\n            _this.size = 0;\n            $.each(_this.obj, function (key, value) {\n                _this.size++;\n            });\n            return _this.size;\n        };\n        _this.remove = function (name) {\n            delete _this.obj[name];\n            _this.size--;\n        };\n        _this.clear = function () {\n            _this.obj = {};\n            _this.size = 0;\n        };\n        return _this;\n    };\n    $.ArrayList = function () {\n        var _this = this;\n        _this.obj = [];\n        _this.size = 0;\n        _this.get = function (index) {\n            return _this.obj[index];\n        };\n        _this.inArray = function (value) {\n            return $.inArray(value, _this.obj);\n        };\n        _this.find = function (value) {\n            var index = _this.inArray(value);\n            if (-1 == index) {\n                return null;\n            }\n            return _this.obj[index];\n            var filterarray = $.grep(_this.obj, function (itemValue) {\n                return itemValue == value;\n            });\n            return filterarray;\n\n        };\n        _this.add = function (value) {\n            var index = _this.inArray(value);\n            if (-1 == index) {\n                _this.obj.push(value);\n            }\n        };\n        _this.join = function (value) {\n            return _this.obj.join(value);\n        };\n        _this.toString = function () {\n            return _this.obj.join(\",\");\n        };\n        _this.size = function () {\n            return _this.obj.length;\n            /*size = 0;\n            $.each(obj,function(key,value) {\n                size++;\n            });\n            return size;*/\n        };\n        _this.remove = function (value) {\n            var index = _this.inArray(value);\n            if (-1 == index) {\n                return null;\n            }\n            return _this.obj.splice(index, 1);\n        };\n        _this.clear = function () {\n            _this.obj = [];\n        };\n        return _this;\n    };\n})(window.jQuery);\n\nvar $common = {};\n$common.newCheckedControl = false;\n$common.gridCheckedDataManager = new $.HashMap();\n$common.regGridCheckedDataManager = function (options) {\n    var grid = $(\"div[name='\" + options.gridName || 'rwxxGrid' + \"']\");\n    var gridCheckedData = grid.gridCheckedData(options);\n    $common.gridCheckedDataManager.put(options.gridName, gridCheckedData);\n    $common.newCheckedControl = true;\n};\n$common.initGridCheckedData = function (gridName) {\n    var gridCheckedData = $common.gridCheckedDataManager.get(gridName);\n    gridCheckedData.init();\n};\n$common.getCheckedData = function (gridName) {\n    var gridCheckedData = $common.gridCheckedDataManager.get(gridName);\n    return gridCheckedData.getCheckedData();\n};\n$common.getXzOrWxzKey = function (gridName) {\n    var gridCheckedData = $common.gridCheckedDataManager.get(gridName);\n    return gridCheckedData.getXzOrWxzKey();\n};\n$common.getGridCheckedData = function (gridName) {\n    return $common.gridCheckedDataManager.get(gridName);\n};\n;(function ($) {\n    $.fn.gridCheckedData = function (options) {\n        // 设置组件参数\n        var _this = this;\n        var $this = $(this);\n        var opt = $.extend({}, $.fn.gridCheckedData.defaults, options);\n        var dataTableCheckAll_checked_status = false;\n        var keys = new $.ArrayList();\n        //1= 未选用，2=选用\n        var selecType = 1;\n        var gridName = null;\n        var keyColName = opt.keyColName || 'rwBh';\n        var checkboxColName = opt.checkboxColName || 'xz';\n        var allGridData = null;\n        var isFyData = true;\n        _this.reset = function () {\n            dataTableCheckAll_checked_status = false;\n            keys = new $.ArrayList();\n            //1= 未选用，2=选用\n            selecType = 1;\n            gridName = null;\n            keyColName = opt.keyColName || 'rwBh';\n            checkboxColName = opt.checkboxColName || 'xz';\n            allGridData = null;\n            isFyData = true;\n        };\n        _this.init = function (checked) {\n            _this.reset();\n            gridName = opt.gridName;\n            gridName = gridName || $this.attr(\"name\");//$(b).parents(\"div[wings='WingsGrid']\").attr(\"name\");\n            if (!$chk(gridName)) {\n                return;\n            }\n            allGridData = $w(gridName).getAllGridData();\n            if (allGridData.totalRows == allGridData.trs.length) {\n                isFyData = false;\n            }\n            _this.setAllCheckedStatus(checked || opt.initAllChecked);\n            if (allGridData.trs.length < 1) {\n                $this.find(\".dataTableCheckAll\").prop('checked', false);\n            }\n            $pageInitGridExFun(gridName);\n        };\n        _this.setAllCheckedStatus = function (checked) {\n            checked = eval(checked);\n            //var _this = $(this);//$(\"div[name='\" + _sp_gridName + \"']\");\n            $this.find('.dataTableCheckAll').prop('checked', checked);\n            /*if ($(gridEl).find('.dataTableCheckAll').is(':checked')) {*/\n            $this.find('.rowSelect').prop('checked', checked);\n            $this.find('.wingscheckbox').prop('checked', checked);\n            /*} else {\n                $(e).find('.rowSelect').prop('checked', false);\n                $(e).find('.wingscheckbox').prop('checked', false);\n            }*/\n            $this.find('.rowSelect').change();\n            $this.find('.wingscheckbox').change();\n            updateAllCheckData(checked);\n            if (typeof opt.initCallback == \"function\") {\n                opt.initCallback();\n            }\n        };\n        _this.setPagingCheckAllStatus = function () {\n            $this.find(\".dataTableCheckAll\").prop('checked', dataTableCheckAll_checked_status);\n            $this.find('.dataTableCheckAll')[0].checked = dataTableCheckAll_checked_status;\n            /*if(dataTableCheckAll_checked_status == true){\n                _this.setAllCheckedStatus(true);\n            }*/\n        };\n\n        function updateAllCheckData(checked) {\n            keys.clear();\n            dataTableCheckAll_checked_status = eval(checked);\n            if (isFyData == false) {\n                selecType = 2;\n            } else if (dataTableCheckAll_checked_status === true) {\n                selecType = 1;\n            } else {\n                selecType = 2;\n            }\n            if (isFyData == false && dataTableCheckAll_checked_status === true) {\n                getCheckedDataKey(true);\n            }\n        };\n\n        function getCheckedDataKey(isAll) {\n            allGridData = $w(gridName).getAllGridData();\n            var checkedRowData = allGridData;\n            if (isAll != true) {\n                checkedRowData = $w(gridName).getCheckedData(checkboxColName);\n            }\n            for (var i = 0; i < checkedRowData.trs.length; i++) {\n                var keyValue = getValueBykey(checkedRowData.trs[i].tds, keyColName);\n                keys.add(keyValue);\n            }\n        };\n\n        //根据key名称或者value值\n        function getValueBykey(data, key) {\n            var keyValue = \"\";\n            $.each(data, function (name, item) {\n                if (key == name) {\n                    keyValue = item.value;\n                    return false;//跳出循环\n                }\n            });\n            return keyValue;\n        };_this.onChecked = function (a, b, c) {\n            var keyValue = getValueBykey(a, keyColName);\n            var allchecked = $this.find('.dataTableCheckAll')[0].checked;\n            var check = $(b).find(\"input[type='checkbox'][name='\" + checkboxColName + \"']\").prop(\"checked\");\n            //b.cells[index].children[_checkbox_colName].checked;\n            var allcheckedStatus = false;\n            if (selecType == 2) {\n                if (check === true) {\n                    keys.add(keyValue);\n                }\n                if (check === false) {\n                    keys.remove(keyValue);\n                }\n                allcheckedStatus = allGridData.totalRows == keys.size();\n            }\n            if (selecType == 1) {\n                if (check === true) {\n                    keys.remove(keyValue);\n                }\n                if (check === false) {\n                    keys.add(keyValue);\n                }\n                allcheckedStatus = keys.size() == 0;\n            }\n            dataTableCheckAll_checked_status = allcheckedStatus;\n            $this.find(\".dataTableCheckAll\").prop('checked', allcheckedStatus);\n            $this.find('.dataTableCheckAll')[0].checked = allcheckedStatus;\n        };\n        _this.onAllChecked = function (name, el) {\n            var allchecked = $this.find(\".dataTableCheckAll\")[0].checked;\n            _this.setAllCheckedStatus(allchecked);\n        };\n        _this.onAfterCreateRowData = function (a, b) {\n            var keyValue = getValueBykey(a, keyColName);\n            if (selecType == 2 && keys.inArray(keyValue) != -1) {\n                _this.setRowChecked(b);\n            } else if (selecType == 1 && keys.inArray(keyValue) == -1) {\n                _this.setRowChecked(b);\n            }\n        }\n        //设置复选框选中\n        _this.setRowChecked = function (b) {\n            $(b).find(\"input[type='checkbox'][name='\" + checkboxColName + \"']\").prop(\"checked\", true);\n            //b.rowDom.cells[index].children[_checkbox_colName].checked = true;//将勾选上的复选框勾上\n            if (b.node.classList == undefined) {//兼容IE8设置class属性\n                b.node.setAttribute('className', 'selected');\n                b.node.setAttribute('className', 'wingsDataTableCheckBox');\n            } else {\n                b.node.classList.add(\"selected\");\n                b.node.classList.add(\"wingsDataTableCheckBox\");//添加选中样式\n            }\n            /*if ($(gridEl).find('.dataTableCheckAll').is(':checked')) {*/\n            $(b.node).find('.rowSelect').prop('checked', true);\n            $(b.node).find('.wingscheckbox').prop('checked', true);\n            /*} else {\n                $(e).find('.rowSelect').prop('checked', false);\n                $(e).find('.wingscheckbox').prop('checked', false);\n            }*/\n            $(b.node).find('.rowSelect').change();\n            $(b.node).find('.wingscheckbox').change();\n        };\n        _this.getCheckedData = function () {\n            allGridData = $w(gridName).getAllGridData();\n            if (allGridData.totalRows == allGridData.trs.length) {\n                isFyData = false;\n            }\n            if (isFyData === false) {\n                var allData_len = allGridData.trs.length;\n                var newDataGrid = {};// 创建一个新的GridData\n                newDataGrid.name = allGridData.name;\n                newDataGrid.beanname = allGridData.beanname;\n                newDataGrid.pageNum = allGridData.pageNum;\n                newDataGrid.rows = allGridData.rows;\n                newDataGrid.sword = allGridData.sword;\n                newDataGrid.trs = [];\n                for (var i = 0; i < allData_len; i++) {\n                    var keyValue = getValueBykey(allGridData.trs[i].tds, keyColName);\n                    if (selecType == 2 && keys.inArray(keyValue) != -1) {\n                        newDataGrid.trs.push(allGridData.trs[i]);// 取下标数据放入新的trs数组中\n                    } else if (selecType == 1 && keys.inArray(keyValue) == -1) {\n                        newDataGrid.trs.push(allGridData.trs[i]);// 取下标数据放入新的trs数组中\n                    }\n                }\n                newDataGrid.totalRows = newDataGrid.trs.length;\n                //var checkedRowData = $w(gridName).getCheckedData(checkboxColName);\n                return newDataGrid;\n            }\n            return allGridData;\n        };\n        _this.getXzOrWxzKey = function () {\n            var data = [{name: \"xzbz\", value: selecType}, {name: \"data\", value: keys.join(\",\")}, {\n                name: \"isFyData\", value: isFyData\n            }];\n            return data;\n        };\n        return _this;\n    };\n    // 默认参数\n    $.fn.gridCheckedData.defaults = {\n        keyColName: 'rwBh', checkboxColName: 'xz', initAllChecked: false, gridName: null,\n    };\n\n})(window.jQuery);\n\nfunction __allCheck(falg, keyName, GridName, checkboxColName) {\n    _grid_Checked_data[GridName] = {};\n    _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n    _grid_Checked_data[GridName]._is_allChecked = true;//初始化时是否默认选中全选框\n    _grid_Checked_data[GridName]._is_allChecked_bz = \"1\";//初始化时是否默认选中全选框\n    _grid_Checked_data[GridName]._initQxbz = true;//初始全选\n    _grid_Checked_data[GridName]._csqx = \"1\";//初始全选参数： 1-全选,空值-非全选\n    _grid_Checked_data[GridName]._only_key = keyName;//唯一主键值，用于控制选中非选中\n    _grid_Checked_data[GridName]._Grid_name = GridName;//grid名称\n    if (!$chk(checkboxColName)) {\n        checkboxColName = \"xz\";\n    }\n    _grid_Checked_data[GridName]._checkbox_colName = checkboxColName;\n    //_Grid_name = GridName;\n    //_only_key = keyName;\n    if (falg == false) {\n        /*_keyStrs = \"\";// 暂存未勾选唯一key\n        _is_allChecked = false;// 初始化时是否默认选中全选框\n        _is_allChecked_bz = \"2\";// 初始化时是否默认选中全选框\n        _initQxbz = false;// 初始全选\n        _csqx = \"\";// 初始全选参数： 1-全选,空值-非全选*/\n        _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n        _grid_Checked_data[GridName]._is_allChecked = false;//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._is_allChecked_bz = \"2\";//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._initQxbz = false;//初始全选\n        _grid_Checked_data[GridName]._csqx = \"\";//初始全选参数： 1-全选,空值-非全选\n    } else {\n        /*_keyStrs = \"\";// 暂存未勾选唯一key\n        _is_allChecked = true;// 初始化时是否默认选中全选框\n        _is_allChecked_bz = \"1\";// 初始化时是否默认选中全选框\n        _initQxbz = true;// 初始全选\n        _csqx = \"1\";// 初始全选参数： 1-全选,空值-非全选*/\n        _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n        _grid_Checked_data[GridName]._is_allChecked = true;//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._is_allChecked_bz = \"1\";//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._initQxbz = true;//初始全选\n        _grid_Checked_data[GridName]._csqx = \"1\";//初始全选参数： 1-全选,空值-非全选\n    }\n}\n\n/********************************************************** 页面复选框选择翻页状态丢失问题解决 ***********************************************************/\n\n/**\n 1.页面js需要调用以下方法初始化参数\n setCheckInitCs(falg,主键名称,Grid名称); falg - false 设置初始化不选中\n\n 2.Grid需要开启以下3个属性：\n onRowClick=\"onChecked();\"\n onAfterInitData=\"onAfterinitData();\"\n onAfterCreateRow=\"onAfterCreateRowData();\"\n\n 3.选择列开启以下两个属性：\n allCheckOnclick=\"onAllChecked();\"  onClick=\"onChecked();\"\n *\n */\nvar _grid_Checked_data = {};\n\n/**\n * 默认初始化全部选中，falg - false 设置初始化不选中\n * @param falg\n * @returns\n */\nfunction setCheckInitCs(falg, keyName, GridName, checkboxColName) {\n    _grid_Checked_data[GridName] = {};\n    _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n    _grid_Checked_data[GridName]._is_allChecked = true;//初始化时是否默认选中全选框\n    _grid_Checked_data[GridName]._is_allChecked_bz = \"1\";//初始化时是否默认选中全选框\n    _grid_Checked_data[GridName]._initQxbz = true;//初始全选\n    _grid_Checked_data[GridName]._csqx = \"1\";//初始全选参数： 1-全选,空值-非全选\n    _grid_Checked_data[GridName]._only_key = keyName;//唯一主键值，用于控制选中非选中\n    _grid_Checked_data[GridName]._Grid_name = GridName;//grid名称\n    if (!$chk(checkboxColName)) {\n        checkboxColName = \"xz\";\n    }\n    _grid_Checked_data[GridName]._checkbox_colName = checkboxColName;\n    //_Grid_name = GridName;\n    //_only_key = keyName;\n    if (falg == false) {\n        /*_keyStrs = \"\";// 暂存未勾选唯一key\n        _is_allChecked = false;// 初始化时是否默认选中全选框\n        _is_allChecked_bz = \"2\";// 初始化时是否默认选中全选框\n        _initQxbz = false;// 初始全选\n        _csqx = \"\";// 初始全选参数： 1-全选,空值-非全选*/\n        _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n        _grid_Checked_data[GridName]._is_allChecked = false;//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._is_allChecked_bz = \"2\";//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._initQxbz = false;//初始全选\n        _grid_Checked_data[GridName]._csqx = \"\";//初始全选参数： 1-全选,空值-非全选\n    } else {\n        /*_keyStrs = \"\";// 暂存未勾选唯一key\n        _is_allChecked = true;// 初始化时是否默认选中全选框\n        _is_allChecked_bz = \"1\";// 初始化时是否默认选中全选框\n        _initQxbz = true;// 初始全选\n        _csqx = \"1\";// 初始全选参数： 1-全选,空值-非全选*/\n        _grid_Checked_data[GridName]._keyStrs = \"\";//暂存未勾选唯一key\n        _grid_Checked_data[GridName]._is_allChecked = true;//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._is_allChecked_bz = \"1\";//初始化时是否默认选中全选框\n        _grid_Checked_data[GridName]._initQxbz = true;//初始全选\n        _grid_Checked_data[GridName]._csqx = \"1\";//初始全选参数： 1-全选,空值-非全选\n    }\n}\n\n/**\n * 获取页面所有选择数据，仅对前台分页有效\n *\n * @param wingsGridName\n * @returns\n */\nfunction getCheckedDataBySelected(wingsGridName) {\n    if (!$chk(wingsGridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        return $common.getCheckedData(wingsGridName);\n    }\n    var wingsGrid = $.wingsWidget(wingsGridName);\n    var gridName = wingsGridName;\n    if (!$chk(wingsGrid) || !$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _only_key = _grid_Checked_data[gridName]._only_key;\n    var _is_allChecked_bz = _grid_Checked_data[gridName]._is_allChecked_bz;\n    var _is_allChecked = _grid_Checked_data[gridName]._is_allChecked;\n    var _csqx = _grid_Checked_data[gridName]._csqx;\n    var _keyStrs = _grid_Checked_data[gridName]._keyStrs;\n    var wingsGridData = wingsGrid.getAllGridData();\n    var allData_len = wingsGridData.trs.length;\n    var newDataGrid = {};// 创建一个新的GridData\n    newDataGrid.name = wingsGridData.name;\n    newDataGrid.beanname = wingsGridData.beanname;\n    newDataGrid.pageNum = wingsGridData.pageNum;\n    newDataGrid.rows = wingsGridData.rows;\n    newDataGrid.sword = wingsGridData.sword;\n    newDataGrid.trs = [];\n    for (var i = 0; i < allData_len; i++) {\n        var keyValue = getValueBykey(wingsGridData.trs[i].tds, _only_key);\n        if (_csqx == '1') {\n            if (_keyStrs.indexOf(keyValue.replace(',', '')) < 0) {// 选中数据\n                newDataGrid.trs.push(wingsGridData.trs[i]);// 取下标数据放入新的trs数组中\n            }\n        } else {\n            if (_keyStrs.indexOf(keyValue.replace(',', '')) >= 0) {// 选中数据\n                newDataGrid.trs.push(wingsGridData.trs[i]);// 取下标数据放入新的trs数组中\n            }\n        }\n    }\n    newDataGrid.totalRows = newDataGrid.trs.length;\n    return newDataGrid;\n}\n\n//Gird表格每行数据构建完成后触发\nfunction onAfterCreateRowData(a, b, c) {\n    var gridName = $(c).parents(\"div[wings='WingsGrid']\").attr(\"name\");\n    if (!$chk(gridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        return $common.getGridCheckedData(gridName).onAfterCreateRowData(a, b);\n    }\n    if (!$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _only_key = _grid_Checked_data[gridName]._only_key;\n    var _is_allChecked_bz = _grid_Checked_data[gridName]._is_allChecked_bz;\n    var _is_allChecked = _grid_Checked_data[gridName]._is_allChecked;\n    var _initQxbz = _grid_Checked_data[gridName]._initQxbz;\n    var _csqx = _grid_Checked_data[gridName]._csqx;\n    var _keyStrs = _grid_Checked_data[gridName]._keyStrs;\n    var keyValue = getValueBykey(a, _only_key);\n    if (_csqx == \"1\" && _keyStrs.indexOf(keyValue) == -1) {\n        setChecked(b, gridName);\n    }\n    if (_csqx === \"\" && _keyStrs.indexOf(keyValue) != -1) {\n        setChecked(b, gridName);\n    }\n}\n\n\nfunction onAfterinitData(gridName) {\n    if (!$chk(gridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        $common.initGridCheckedData(gridName);\n        return;\n    }\n    if (!$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _initQxbz = _grid_Checked_data[gridName]._initQxbz;\n    if ($.wingsWidget(gridName).getAllGridData().trs.length < 1) {\n        $(\".dataTableCheckAll\").prop('checked', false);\n        //$('.dataTableCheckAll')[0].checked = false;\n    } else {\n        if (_initQxbz == true) {\n            $(\".dataTableCheckAll\").prop('checked', true);\n            //$('.dataTableCheckAll')[0].checked = false;\n        } else {\n            $(\".dataTableCheckAll\").prop('checked', false);\n            //$('.dataTableCheckAll')[0].checked = false;\n        }\n    }\n\n    var _only_key = _grid_Checked_data[gridName]._only_key;\n    var _is_allChecked_bz = _grid_Checked_data[gridName]._is_allChecked_bz;\n    var _initQxbz = _grid_Checked_data[gridName]._initQxbz;\n    var _keyStrs = _grid_Checked_data[gridName]._keyStrs;\n\n    // 全选框勾上\n    if (\"\" == _keyStrs && _is_allChecked_bz == \"1\" && $.wingsWidget(gridName).getAllGridData().trs.length > 0) {\n        $('.dataTableCheckAll')[0].checked = true;\n    } else if (\"\" == _keyStrs && _is_allChecked_bz == \"2\" && $.wingsWidget(gridName).getAllGridData().trs.length > 0 && _initQxbz == true) {\n        _keyStrs = \"\";\n        var wingsGrid = $.wingsWidget(gridName).getAllGridData();\n        for (var i = 0; i < wingsGrid.trs.length; i++) {\n            var keyValue = getValueBykey(wingsGrid.trs[i].tds, _only_key);\n            _keyStrs = _keyStrs + keyValue;\n        }\n    }\n    _grid_Checked_data[gridName]._keyStrs = _keyStrs;\n}\n\nfunction getAllCheckedData(gridName) {\n    var _keyStrs = \"\";\n    var _only_key = _grid_Checked_data[gridName]._only_key;\n    var wingsGrid = $.wingsWidget(gridName).getAllGridData();\n    for (var i = 0; i < wingsGrid.trs.length; i++) {\n        var keyValue = getValueBykey(wingsGrid.trs[i].tds, _only_key);\n        _keyStrs = _keyStrs + keyValue;\n    }\n    _grid_Checked_data[gridName]._keyStrs = _keyStrs;\n}\n\n// 全选事件\nfunction onAllChecked(name, el) {\n    var girdEl = $(name).parents(\"div[wings='WingsGrid']\");\n    var gridName = girdEl.attr(\"name\");\n    if (!$chk(gridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        $common.gridCheckedDataManager.get(gridName).onAllChecked(name, el);\n        return;\n    }\n    if (!$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _is_allChecked = $(girdEl).find(\".dataTableCheckAll\")[0].checked;\n    _grid_Checked_data[gridName]._is_allChecked = _is_allChecked;\n    _grid_Checked_data[gridName]._keyStrs = \"\";\n    if (_is_allChecked == true) {//全选上\n        _grid_Checked_data[gridName]._is_allChecked_bz = \"1\";\n        _grid_Checked_data[gridName]._csqx = \"1\";\n        setAllCheck2(gridName, true);\n    } else if (_is_allChecked == false) {// 全去掉\n        _grid_Checked_data[gridName]._is_allChecked_bz = \"2\";\n        _grid_Checked_data[gridName]._csqx = \"\";\n        setAllCheck2(gridName, false);\n    }\n}\n\n//根据key名称或者value值\nfunction getValueBykey(data, key) {\n    var keyValue = \"\";\n    $.each(data, function (name, item) {\n        if (key == name) {\n            keyValue = item.value + \",\";\n            return false;//跳出循环\n        }\n    });\n    return keyValue;\n}\n\n\n//设置复选框选中\nfunction setChecked(b, gridName) {\n    if (!$chk(gridName)) {\n        return;\n    }\n    var _checkbox_colName = _grid_Checked_data[gridName]._checkbox_colName;\n    $(b).find(\"input[type='checkbox'][name='\" + _checkbox_colName + \"']\").prop(\"checked\", true);\n    //b.rowDom.cells[index].children[_checkbox_colName].checked = true;//将勾选上的复选框勾上\n    if (b.node.classList == undefined) {//兼容IE8设置class属性\n        b.node.setAttribute('className', 'selected');\n        b.node.setAttribute('className', 'wingsDataTableCheckBox');\n    } else {\n        b.node.classList.add(\"selected\");\n        b.node.classList.add(\"wingsDataTableCheckBox\");//添加选中样式\n    }\n    $(b.node).find('.rowSelect').prop('checked', true);\n    $(b.node).find('.wingscheckbox').prop('checked', true);\n    $(b.node).find('.rowSelect').change();\n    $(b.node).find('.wingscheckbox').change();\n}\n\nfunction getCheckBoxIndex(gridName) {\n    if (!$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _Grid_name = gridName;\n    if (!$chk($.wingsWidget(_Grid_name))) {\n        return;\n    }\n    var header = $.wingsWidget(_Grid_name).getHeader();\n    var len = header.length;\n    var index = 0;\n    for (var i = 0; i < len; i++) {\n        if (header[i].type == 'rowNum') {\n            index = header[i].index;\n        }\n    }\n    return index;\n}\n\n/**\n * 点击复选框后触发,记录未选中唯一标识keyValue\n * @param a\n * @param b\n * @param c\n * @returns\n */\nfunction onChecked(a, b, c) {\n\n    var gridName = $(b).parents(\"div[wings='WingsGrid']\").attr(\"name\");\n    if (!$chk(gridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        $common.gridCheckedDataManager.get(gridName).onChecked(a, b, c);\n        return;\n    }\n    //var gridName = $(b).parents(\"div[wings='WingsGrid']\").attr(\"name\");\n\n    if (!$chk(gridName) || !$chk(_grid_Checked_data[gridName])) {\n        return;\n    }\n    var _only_key = _grid_Checked_data[gridName]._only_key;\n    var _initQxbz = _grid_Checked_data[gridName]._initQxbz;\n    var _csqx = _grid_Checked_data[gridName]._csqx;\n    var _keyStrs = _grid_Checked_data[gridName]._keyStrs;\n    var keyValue = getValueBykey(a, _only_key);\n    var allchecked = $('.dataTableCheckAll')[0].checked;\n\n    _keyStrs = (checkNull(_keyStrs) && (!_keyStrs.endWith(','))) ? (_keyStrs + \",\") : _keyStrs;\n\n    //var index = getCheckBoxIndex(gridName);\n    var totalRows = $w(gridName).getAllGridData().totalRows;\n    var _checkbox_colName = _grid_Checked_data[gridName]._checkbox_colName;\n    var check = $(b).find(\"input[type='checkbox'][name='\" + _checkbox_colName + \"']\").prop(\"checked\");\n    // b.cells[index].children[_checkbox_colName].checked;\n\n    if ((_csqx === \"\" && check == false && _keyStrs.indexOf(keyValue) != -1) || (_csqx === \"1\" && check == true && _keyStrs.indexOf(keyValue) != -1)) {\n        _keyStrs.replace(keyValue, \"\");\n        var reg = new RegExp(keyValue, \"g\");// g,表示全部替换。\n        _keyStrs = _keyStrs.replace(reg, \"\");\n    } else if ((_csqx === \"1\" && check == false && _keyStrs.indexOf(keyValue) == -1) || (_csqx === \"\" && check == true && _keyStrs.indexOf(keyValue) == -1)) {\n        _keyStrs = _keyStrs + keyValue;\n    }\n    if (check != true && allchecked == true && _csqx === \"1\" && totalRows === (_keyStrs.split(',').length - 1)) {\n        $(\".dataTableCheckAll\").prop('checked', false);\n        $('.dataTableCheckAll')[0].checked = false;\n        _grid_Checked_data[gridName]._is_allChecked = false;\n        _grid_Checked_data[gridName]._is_allChecked_bz = 0;\n        _grid_Checked_data[gridName]._csqx = \"\";\n        _keyStrs = \"\";\n    } else if (allchecked != true) {\n\n    }\n    //0 = 部分，1=全，2全不\n    _grid_Checked_data[gridName]._keyStrs = _keyStrs;\n}\n\n\n//获取选中或未选中主键值\nfunction getXzOrWxzKey(gridName) {\n    if (!$chk(gridName)) {\n        return;\n    }\n    if ($common.newCheckedControl) {\n        return $common.getXzOrWxzKey(gridName);\n    }\n    if (!$chk(gridName) || _grid_Checked_data.length < 1) {\n        return;\n    }\n    if (!$chk(gridName)) {\n        for (var item in _grid_Checked_data) {\n            gridName = item;\n        }\n    }\n    var _Grid_name = gridName;\n    var _csqx = _grid_Checked_data[gridName]._csqx;\n    var _keyStrs = _grid_Checked_data[gridName]._keyStrs;\n    if (!$chk(_Grid_name)) {\n        return;\n    }\n    var XzOrWxzKey = [];\n    //去掉尾部逗号处理\n    _keyStrs = !checkNull(_keyStrs) ? \"\" : (_keyStrs.endWith(\",\") ? _keyStrs.substr(0, _keyStrs.length - 1) : _keyStrs);\n    if (_csqx == '1') {\n        XzOrWxzKey = [{\"name\": \"xzbz\", \"value\": \"1\"}, {\"name\": \"data\", \"value\": _keyStrs}];\n        //console.log(\"1-未选中主键信息：\"+_keyStrs);\n    } else {\n        XzOrWxzKey = [{\"name\": \"xzbz\", \"value\": \"2\"}, {\"name\": \"data\", \"value\": _keyStrs}];\n        //console.log(\"2-选中主键信息：\"+_keyStrs);\n    }\n    return XzOrWxzKey;\n}\n\n/********************************************************** 页面复选框选择翻页状态丢失问题解决 end ***********************************************************/\n\n\n/**\n * 获取浏览器信息，Sys.browser得到浏览器的类型，sys.ver得到浏览器的版本\n * @returns\n */\nfunction getBrowserInfo() {\n    var Sys = {};\n    var ua = navigator.userAgent.toLowerCase();\n    var re = /(msie|firefox|chrome|opera|version).*?([\\d.]+)/;\n    var m = ua.match(re);\n    Sys.browser = m[1].replace(/version/, \"'safari\");\n    Sys.ver = m[2];\n    return Sys;\n}\n\n\n//获取时间 年月日\nfunction getNowFormatDate() {\n    var date = new Date();\n    var seperator1 = \"-\";\n    var seperator2 = \":\";\n    var month = date.getMonth() + 1;\n    var strDate = date.getDate();\n    if (month >= 1 && month <= 9) {\n        month = \"0\" + month;\n    }\n    if (strDate >= 0 && strDate <= 9) {\n        strDate = \"0\" + strDate;\n    }\n    var currentdate = date.getFullYear() + seperator1 + month + seperator1 + strDate;\n    return currentdate;\n}\n\n\n/**\n * 显示WingsDialog，对WingsDialog.showModalDialog进一步封装：加入“disableESC”，[boolean]，即传入true时可禁用按下ESC关闭窗口的操作\n * @param options\n */\nfunction showWingsDialog(options) {\n    options = options || {};\n    WingsDialog.showModalDialog(options);\n    var dialog = WingsDialog.getModalDialog();\n    if (typeof dialog !== 'undefined' && options.disableESC) {\n        // 由于Wings框架未传入closeByKeyboard属性至BootstrapDialog\n        // 现手工关闭BootstrapDialog自带的ESC键截获处理\n        dialog.options.closeByKeyboard = false;\n    }\n}\n\n\n/**\n * 设置WingsGrid表格排序列，当光标滑入时，光标变为手指形状\n * 调用示例：onAfterCreateRow（表格创建完毕后）方法里面调用\n */\nfunction setSortColspointer() {\n    var sorting_disabled = document.getElementsByClassName(\"sorting_disabled\");\n    if (sorting_disabled.length > 0) {\n        var len = sorting_disabled.length;\n        for (var i = 0; i < len; i++) {\n            if (sorting_disabled[i].childNodes.length > 1) {\n                sorting_disabled[i].className += ' pointer';\n            }\n        }\n    }\n}\n\n/**\n * 将form表单组装成分页查询AjaxParam参数\n * @param formData\n * @returns\n */\nfunction getAjaxParam(formData) {\n    var AjaxParam = {};\n    $.each(formData, function (key, map) {\n        AjaxParam[key] = map.value;\n    });\n    return AjaxParam;\n}\n\n/**\n * 生成指定位数随机数\n * @param num\n * @returns {number}\n */\nfunction getRoundByWs(num) {\n    return Math.round(Math.random() * num);\n}\n\n/**\n * 下载附件信息\n * @param fjxx\n */\nfunction commomDownloadFile(fjxx) {\n    if (checkNull(fjxx)) {\n        var urlArr = fjxx.split(\"@\");\n        for (var i = 1; i < urlArr.length; i++) {\n            var pathUrl = urlArr[i];\n            var filename = pathUrl.indexOf(\"\\\\\") >= 0 ? (pathUrl.substring(pathUrl.lastIndexOf(\"\\\\\") + 1, pathUrl.length)) : (pathUrl.substring(pathUrl.lastIndexOf(\"\\/\") + 1, pathUrl.length));\n            var sp = $(\"<a class='wingsDTA pointer' ><span>\").html(filename);\n            sp.attr(\"id\", urlArr[i] + \"@@message\" + i);\n            sp.appendTo($(\"#fjlist\"));\n            var me = $(\"<span style='color:red;'>\");\n            me.attr(\"id\", \"message\" + i);\n            me.appendTo($(\"#fjlist\"));\n            $(\"#fjlist\").append($(\"<br>\"));\n        }\n        ;$(\"#fjlist a\").click(function () {\n            downloadFile($(this).attr(\"id\"));\n        });\n    }\n}\n\n\n/**\n * 根据绑定name获取res中的值\n * @param res\n * @param Name\n * @returns {*}\n */\nfunction getResDataByName(res, Name) {\n    var data;\n    var len = res.data.length;\n    for (var i = 0; i < len; i++) {\n        if (res.data[i].name == Name) {\n            data = res.data[i].data;\n            return data;\n        }\n    }\n}\n\n\n/**\n * 过滤数据，剔除选中数据\n * @param AllGridData 所有数据\n * @param CheckedGridData 选中数据\n * @param gridName grid名称\n * @param filterName 过滤字段名\n * @returns {{sword: string, trs: number[], name: *}}\n */\nfunction filterData(AllGridData, CheckedGridData, gridName, filterName) {\n    var chk_len = CheckedGridData.trs.length;\n    var all_len = AllGridData.trs.length;\n    var newInitData = [];\n    var a = 0;\n    for (var i = 0; i < all_len; i++) {\n        var bool = false;\n        for (var j = 0; j < chk_len; j++) {\n            if (CheckedGridData.trs[j].tds[filterName].value == AllGridData.trs[i].tds[filterName].value) {//排除掉已提交数据\n                bool = true;\n                break;\n            }\n        }\n        if (!bool) {\n            newInitData.push(AllGridData.trs[i]);\n            a++;\n        }\n    }\n    return {\"sword\": \"SwordGrid\", \"name\": gridName, \"trs\": newInitData};\n}\n\n\nfunction $defined(a) {\n    return (a != undefined)\n}\n\nfunction refreshOrReload() {\n    if (typeof _sp_allDataChecked != \"undefined\" && $defined(_sp_allDataChecked) && $chk(_sp_allDataChecked) && true == _sp_allDataChecked) {\n        refreshDbrw();\n    } else {\n        window.location.reload();\n    }\n}\n\n\nfunction compareDateDyDy(bjrqq, bjrqz) {\n    var bool = true;\n    var q = bjrqq.replace(/-/g, \"\");\n    var z = bjrqz.replace(/-/g, \"\");\n    if (q >= z) {\n        bool = false;\n    }\n    return bool;\n}\n\n/**\n * 日期比较\n * @param bjrqq\n * @param bjrqz\n * @returns {boolean}\n */\nfunction compareDate(bjrqq, bjrqz) {\n    var q = creatCompareDate(bjrqq);\n    var z = creatCompareDate(bjrqz);\n    return q > z ? false : true;\n}\n\nfunction creatCompareDate(qd) {\n    var str = qd.split('-');\n    for (i = 0; i < (3 - str.length); i++) {\n        str.push('01');\n    }\n    return new Date(Number(str[0]), (Number(str[1]) - 1), Number(str[2]));\n}\n\n\nfunction getTodayDate() {\n    var endDate = new Date();\n    var endYear = endDate.getFullYear();\n    var endMonth = endDate.getMonth() + 1;\n    endMonth = (endMonth < 10 ? \"0\" + endMonth : endMonth);\n    var strDate = endDate.getDate();\n    if (strDate <= 9) strDate = '0' + strDate;\n    var dqrq = endYear + \"-\" + endMonth + \"-\" + strDate;\n    return dqrq;\n}\n\nfunction CheckDateToDay(formName, fieldName, oldfieldName) {\n    var from = $.wingsWidget(formName);\n    var fieldValue = from.getValue(fieldName);\n    var oldfieldValue = \"\";\n    if ($chk(oldfieldName)) {\n        oldfieldValue = from.getValue(oldfieldName);\n    }\n    var date = getTodayDate();\n    if (compareDateDyDy(fieldValue, date)) {\n        $.wingsWidget(formName).setValue(fieldName, oldfieldValue);\n        WingsDialog.alert(\"选择的日期小于当前日期！选择的日期应大于等于当前日期\");\n        return;\n    }\n}\n\nfunction onDateChangeByGridCol(colName, elvalue, eltarget, trWs) {\n    if (elvalue == \"\") {\n        WingsDialog.alert(\"选择的日期不能为空!\");\n        var cell = trWs.getCell(colName);\n        var realvalue = $(cell).attr('realvalue');\n        eltarget.value = realvalue;\n    }\n}\n\nfunction setAllCheck2(gridName, checked) {\n    if (!$chk(checked)) {\n        checked = false;\n    }\n    var gridEl = $(\"div[name='\" + gridName + \"']\");\n    gridEl.find('.dataTableCheckAll').prop('checked', checked);\n    /*if ($(gridEl).find('.dataTableCheckAll').is(':checked')) {*/\n    gridEl.find('.rowSelect').prop('checked', checked);\n    gridEl.find('.wingscheckbox').prop('checked', checked);\n    /*} else {\n        $(e).find('.rowSelect').prop('checked', false);\n        $(e).find('.wingscheckbox').prop('checked', false);\n    }*/\n    gridEl.find('.rowSelect').change();\n    gridEl.find('.wingscheckbox').change();\n}\n\nfunction $cellSetIndex(el) {\n    /*el.__proto__.constructor.prototype.getIndex =  function() {\n\n        if (this.pagingObj != null) {\n            this.index.row = (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize()\n                + this.index.row;\n        }\n        return this.index;\n    }*/\n    /*重写原型方法*/\n    el.getIndex = function () {\n        if (this.pagingObj != null) {\n            this.index.row = (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize() + this.index.row;\n        }\n        return this.index;\n    }\n}\n\nfunction setPagingCallback(gridName) {\n    var ee = $.wingsWidget(gridName);\n    ee.pagingCallback = function () {\n        var e = $.wingsWidget(gridName);\n        var opt = e.getOptions();\n        opt.pageLength = e.gridData.rows;\n        e.setOptions(opt);\n        //!$chk(opt.ajax) && !$chk(opt.ptid) &&\n        if ($common.newCheckedControl == true) {\n            var gridCheckedData = $common.gridCheckedDataManager.get(gridName);\n            gridCheckedData.setPagingCheckAllStatus();\n        } else {\n            if ($chk(_grid_Checked_data[gridName])) {\n                if (_grid_Checked_data[gridName]._is_allChecked) {\n                    $(\".dataTableCheckAll\").prop('checked', true);\n                } else {\n                    $(\".dataTableCheckAll\").prop('checked', false);\n                }\n            }\n        }\n\n    };\n}\n\nfunction $pageInitGridExFun(gridName) {\n    setPagingCallback(gridName);\n}\n\n(function ($) {\n\n})(jQuery);\n\n$(function () {\n    var page_effect = $('#page_effect');\n    if (page_effect && page_effect.length > 0) {\n        page_effect.hide();\n    }\n});\n\nvar $setPageSizeCnf = {};\n\n/* $getPageSize */\nfunction $getPageSize(gridName) {\n    var rows = $.wingsWidget(gridName).getPagingObj().getPageSize();\n    $setPageSizeCnf[gridName] = rows;\n    return rows;\n}\n\n/* $setPageSize */\nfunction $setPageSize(gridName) {\n    if ($chk($setPageSizeCnf[gridName])) {\n        var rows = $setPageSizeCnf[gridName];\n        $('div[wings=\"WingsGrid\"][name=\"' + gridName + '\"]').attr(\"pageLength\", rows);\n        $.wingsWidget(gridName).getPagingObj().setPageSize(rows);\n        $.wingsWidget(gridName).getPagingObj().refreshInfo();\n    }\n}\n\n/**\n *\n * 分析期起止默认为当月1日到系统当前日期\n * @param formName\n * @param rwcjsjq\n * @param rwcjsjz\n */\nfunction setDefCreateDate(formName, rwcjsjq, rwcjsjz) {\n    var form = $.wingsWidget(formName);\n    var curdate = new Date();\n    var curYear = curdate.getFullYear();\n    var curMonth = curdate.getMonth() + 1;\n\n    var cjrqz = curYear + '-' + curMonth + '-' + curdate.getDate();\n    curMonth = (curMonth < 10 ? \"0\" + curMonth : curMonth);\n    var cjrqq = (curYear.toString() + \"-\" + curMonth.toString() + \"-01\");\n\n    form.setValue(rwcjsjq, cjrqq);\n    form.setValue(rwcjsjz, cjrqz)\n}\n\n//清理下拉树选中值\nfunction clearTreeInput(code, caption) {\n    var codeEl = $('input[name=\"' + code + '\"]');\n    codeEl.val(\"\");\n    var captionEl = $('input[name=\"' + caption + '\"]');\n    captionEl.val(\"\");\n    captionEl.data(code, \"\");\n    captionEl.data(caption, \"\");\n}\n\n/*重新加载页面*/\nfunction reloadPage() {\n    window.location.reload();\n}\n\n/*重新加载页面*/\nfunction reSetDataByWidgets(widgets) {\n    var widgetsList = widgets.split(',');\n    $.each(widgetsList, function (i, widget) {\n        var widgetObj = $.wingsWidget(widget);\n        if ($chk(widgetObj)) {\n            if (widgetObj.hasOwnProperty('clearSetDefValue')) {\n                widgetObj.clearSetDefValue();\n                if (typeof resetPageData == 'function') {\n                    resetPageData(widget);\n                }\n            }\n            if (widgetObj.hasOwnProperty('emptyData')) {\n                widgetObj.emptyData();\n            }\n        } else {\n            $(widget).val(\"\");\n        }\n    });\n    //window.location.reload();\n}\n\nfunction getRequest() {\n    var url = location.search; //获取url中\"?\"符后的字串\n    var theRequest = new Object();\n    var queryStr = \"\";\n    if (url.indexOf(\"?\") != -1) {\n        var str = url.substr(1);\n        var strs = str.split(\"&\");\n        for (var i = 0; i < strs.length; i++) {\n            var paramItems = strs[i].split(\"=\");\n            if (\"ctrl\" != paramItems && \"tid\" != paramItems) {\n                theRequest[paramItems[0]] = unescape(paramItems[1]);\n                queryStr = \"&\" + strs[i];\n            }\n        }\n    }\n    return queryStr;\n}\n\n/**\n *\n * @type {{encrypt_AES: (function(*): string), decrypt_AES: (function(*, *=): *)}}\n */\nvar EncryptUtils = {\n    jmbz: false, defKey: \"5a6e91e23c12bd3b21bcb36db16e7184\", defIv: \"687252257734315e7161542650595442\", encrypt_AES: function (tplEle) {\n        var key = checkNull(tplEle.key) ? tplEle.key : this.defKey;\n        var iv = checkNull(tplEle.iv) ? tplEle.key : this.defIv;\n        var data = tplEle.data;\n        key = CryptoJS.enc.Hex.parse(key);\n        iv = CryptoJS.enc.Hex.parse(iv);\n        var encrypt = CryptoJS.AES.encrypt(data, key, {\n            iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7\n        });\n        var dataEncrypt = encrypt.ciphertext.toString()\n        // WingsConsole.log(\"加密：\", dataEncrypt);\n        return dataEncrypt;\n    }, decrypt_AES: function (tplEle, tplHex) {\n        var key = tplEle.key;\n        var iv = tplEle.iv;\n        var data = tplEle.data;\n        key = CryptoJS.enc.Hex.parse(key);\n        iv = CryptoJS.enc.Hex.parse(iv);\n        var decrypt = CryptoJS.AES.decrypt(CryptoJS.format.Hex.parse(data), key, {\n            iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7\n        });\n        var dataDecrypt = CryptoJS.enc.Utf8.stringify(decrypt);\n        //WingsConsole.log('解密:', dataDecrypt);\n        return dataDecrypt;\n    }, encryptStr: function (paramsStr) {\n        return _zdySubmit._jmbz ? '&%23tsaec%23=' + EncryptUtils.encrypt_AES({'data': paramsStr, 'key': ''}) : paramsStr;\n    }\n};\n\n/**\n * 通过树形结构第一个节点值设置懒加载树默认值\n * @param treeName  树形treeName\n * @param codeName 对应codeName\n * @param captionName 对应captionName\n */\nfunction setLazyTreeDefValueByFristNode(treeName, codeName, captionName) {\n    var treeObj = $w(treeName).getTreeRealObj();\n    var nodes = treeObj.getNodes();\n    zTreeOnClick2(treeName, codeName, captionName, null, nodes[0]);\n}\n\n\nfunction CheckNullDate(formName, sjqName, sjzName, checkbs, msgxx) {\n    //同年度时间校验\n    var _name = formName.split(\"-\");\n    var from = $.wingsWidget(_name[0]);\n    var q = from.getValue(sjqName);\n    var z = from.getValue(sjzName);\n    if (checkNull(q) && checkNull(z)) {\n        var n = \"\";\n        var msg = \"\";\n        var bool = false;\n        if ($chk(_name[1]) && \"Y\" == _name[1] && q.substring(0, 4) != z.substring(0, 4)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"时间起止应为同一年度\";\n            bool = true;\n        } else if (!compareDate(q, z)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"1\" == checkbs ? \"时间起大于时间止\" : \"时间止小于时间起\";\n            bool = true;\n        }\n    } else {\n        if ((new Date(z) > new Date()) || (new Date(q) > new Date())) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = checkNull(msgxx) ? msgxx : \"时间请勿大于当前日期\"\n            bool = true;\n        }\n    }\n\n    if (bool) {\n        from.setValue(n, \"\");\n        WingsDialog.alert(msg);\n    }\n    return bool;\n}\n\n/**\n * 【税款所属期】类型日期不对日期与当前日期判断\n * @param formName form名称 formName-[N/Y/K/S]:非同一年度、同一年度、不校验空值、不校验税款所属期与当前日期比较\n * @param sjqName 时间起名称\n * @param sjzName 时间止名称\n * @param checkbs 校验标识，1-校验时间起，2-校验时间止\n * @constructor\n */\nvar enterTimes = 0;\n\nfunction CheckDate(formName, sjqName, sjzName, checkbs, msgxx) {\n    //同年度时间校验\n    var _name = formName.split(\"-\");\n    var from = $.wingsWidget(_name[0]);\n    var q = from.getValue(sjqName);\n    var z = from.getValue(sjzName);\n\n    var dateTime = new Date();\n    dateTime = dateTime.setDate(dateTime.getDate() + 1);\n    dateTime = new Date(dateTime);\n\n    if (checkNull(q) && checkNull(z)) {\n        var n = \"\";\n        var msg = \"\";\n        var bool = false;\n        if ($chk(_name[1]) && \"Y\" == _name[1] && q.substring(0, 4) != z.substring(0, 4)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"时间起止应为同一年度\";\n            bool = true;\n        } else if (!compareDate(q, z)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"1\" == checkbs ? \"时间起大于时间止\" : \"时间止小于时间起\";\n            bool = true;\n        } else if (!((_name[1]) && \"S\" == _name[1]) && (new Date(z) > dateTime)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = checkNull(msgxx) ? msgxx : \"时间止请勿大于当前日期\"\n            bool = true;\n        }\n\n        if (bool) {\n            from.setValue(n, \"\");\n            WingsDialog.alert(msg);\n        }\n        return bool;\n    } else {\n        if ('K' == _name[1]) {\n\n        } else {\n            if ($('.wings-alert-message').length == 0) {\n                let n = \"1\" == checkbs ? sjqName : sjzName;\n                let msg = \"1\" == checkbs ? '起' : '止';\n                if (checkIsNull(from.getValue(n))) {\n                    WingsDialog.alert('时间' + msg + '为空');\n                }\n            }\n            /*enterTimes++;\n            let n = \"1\" == checkbs ? sjqName : sjzName;\n            let msg = \"1\" == checkbs ? '起' : '止';\n            if (checkIsNull(from.getValue(n)) && enterTimes == 2) {\n                enterTimes = 0;\n                WingsDialog.alert('时间' + msg + '为空');\n            }*/\n        }\n    }\n\n}\n\nfunction CheckDateNew(formName, sjqName, sjzName, checkbs, msgxx) {\n    //同年度时间校验\n    var _name = formName.split(\"-\");\n    var from = $.wingsWidget(_name[0]);\n    var q = from.getValue(sjqName);\n    var z = from.getValue(sjzName);\n\n    var dateTime = new Date();\n    dateTime = dateTime.setDate(dateTime.getDate() + 1);\n    dateTime = new Date(dateTime);\n\n    if (checkNull(q) && checkNull(z)) {\n        var n = \"\";\n        var msg = \"\";\n        var bool = false;\n        if ($chk(_name[1]) && \"Y\" == _name[1] && q.substring(0, 4) != z.substring(0, 4)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"时间起止应为同一年度\";\n            bool = true;\n        } else if (!compareDate(q, z)) {\n            n = \"1\" == checkbs ? sjqName : sjzName;\n            msg = \"1\" == checkbs ? \"时间起大于时间止\" : \"时间止小于时间起\";\n            bool = true;\n        }\n\n        if (bool) {\n            from.setValue(n, \"\");\n            WingsDialog.alert(msg);\n        }\n        return bool;\n    } else {\n        if ('K' == _name[1]) {\n\n        } else {\n            if ($('.wings-alert-message').length == 0) {\n                let n = \"1\" == checkbs ? sjqName : sjzName;\n                let msg = \"1\" == checkbs ? '起' : '止';\n                if (checkIsNull(from.getValue(n))) {\n                    WingsDialog.alert('时间' + msg + '为空');\n                }\n            }\n            /*enterTimes++;\n            let n = \"1\" == checkbs ? sjqName : sjzName;\n            let msg = \"1\" == checkbs ? '起' : '止';\n            if (checkIsNull(from.getValue(n)) && enterTimes == 2) {\n                enterTimes = 0;\n                WingsDialog.alert('时间' + msg + '为空');\n            }*/\n        }\n    }\n\n}\n\nfunction CheckOneDate(formName, sjqName, checkbs, msgxx) {\n    //同年度时间校验\n    var from = $.wingsWidget(formName);\n    var sj = from.getValue(sjqName);\n    if (checkNull(sj)) {\n        var msg = \"\";\n        var bool = false;\n        if (new Date(sj) > new Date()) {\n            msg = checkNull(msgxx) ? msgxx : \"时间止请勿大于当前日期\"\n            bool = true;\n        }\n        if (bool) {\n            from.setValue(sjqName, \"\");\n            WingsDialog.alert(msg);\n        }\n        return bool;\n    } else {\n        WingsDialog.alert(\"时间为空\");\n    }\n\n}\n\n// 调整父页面中IFrame的高度为此页面的高度\nfunction IFrameResize() {\n    try {\n        try {\n            document.domain = \"sat.tax\";//一户式查询打开二级tab页时，嵌入的iframe页面自适应大小，如又跨域问题可以添加上该行，配置的为域名（domain.js配置的），引用domain.js无效时，进行添加\n        } catch (e) {\n        }\n        if (checkNull(parent.document)) {\n            var iframFather = parent.document.getElementById(\"pageiframe\");\n            if (checkNull(iframFather)) {\n                var minheight = parent.window.innerHeight - 308;\n                var diysHeight = 0;\n                var bodyChilds = $('body')[0].children;\n                for (var i = 0; i < bodyChilds.length; i++) {\n                    var h = bodyChilds[i].offsetHeight;\n\n                    //特殊处理tab切换iframe嵌套子页面iframe高度异常 2022-08-25\n                    if ($(bodyChilds[i]).is('.tab-content')) {\n                        h = $(bodyChilds[i]).find('.active .tab_detail')[0].clientHeight;\n                    }\n\n                    // update chen 20251106 过滤掉modal蒙版高度\n                    var childDoc = $(bodyChilds[i]);\n                    var id = childDoc.attr('id');\n                    if (id == 'menban' || (childDoc.hasClass('modal-backdrop') || (childDoc.hasClass('modal')) && childDoc.hasClass('bootstrap-dialog'))) {\n                        continue;\n                    }\n                    diysHeight += h > 0 ? h + 22 : 0;\n                }\n                $(iframFather).css(\"height\", diysHeight > minheight ? diysHeight : minheight);\n            } else {\n                //非iframe页面时\n                $('body').css(\"overflow\", \"\");\n            }\n\n            //Grid表格选择\"每页显示**条\"数据时触发页面尺寸重新计算\n            var selectorId = $('div[wings=\"WingsGrid\"] select[id$=\"pagingBar_info_pageSize\"]');\n            $(selectorId).each(function () {\n                $(this).change(function () {\n                    IFrameResize();\n                });\n            });\n        }\n    } catch (e) {\n        console.log('IFrameREesize function is error');\n    }\n}\n\n//置灰tab\nfunction disableTabs(ulId, tabsArr) {\n    var a = $('ul#' + ulId + ' li a');\n    for (var i = 0; i < a.length; i++) {\n        var ali = $(a[i]);\n\n        for (var j = 0; j < tabsArr.length; j++) {\n            if (ali.attr('href') == ('#' + tabsArr[j])) {\n                var h = $(ali).parent().height();\n                $(ali).parent().css('background', ' #ddd');\n                $(ali).parent().append('<div style=\" height:' + (h + 2) + 'px;padding: 8px 12px\">' + ali[0].innerText + '</div>');\n                ali.remove();\n            }\n        }\n    }\n}\n\n//近半年\nfunction get6MonthBefor() {\n    var resultDate, year, month, date, hms;\n    var currDate = new Date();\n    year = currDate.getFullYear();\n    month = currDate.getMonth() + 1;\n    //date = currDate.getDate();\n    //hms = currDate.getHours() + ':' + currDate.getMinutes() + ':' + (currDate.getSeconds() < 10 ? '0'+currDate.getSeconds() : currDate.getSeconds());\n    switch (month) {\n        case 1:\n        case 2:\n        case 3:\n        case 4:\n        case 5:\n            month += 7;\n            year--;\n            break;\n        default:\n            month -= 5;\n            break;\n    }\n    month = (month < 10) ? ('0' + month) : month;\n    resultDate = year + '-' + month + \"-01\";\n    return resultDate;\n}\n\n//Grid表格标签添加Title属性\nfunction addGridTdTitle(gridName) {\n    addGridTdTitleText(gridName);\n    addGridTdTitleEvent(gridName);\n}\n\nfunction addGridTdTitleText(gridName) {\n    var a = $('div[name=\"' + gridName + '\"] tbody td');\n    for (var j = 0; j < a.length; j++) {\n        if (checkNull($(a[j]).attr('realvalue'))) {\n            $(a[j]).attr('title', a[j].innerText);\n        }\n    }\n    //grid中所有a标签连接增加手型标志\n    var aTar = $('div[name=\"' + gridName + '\"] tbody td a');\n    aTar.css('cursor', 'pointer');\n}\n\nfunction addPageOnGridTdTitleClick(gridName, selectorId) {\n    $(selectorId).each(function () {\n        $(this).bind(\"click\", function () {\n            addGridTdTitleText(gridName);\n            if (selectorId == (\"#\" + gridName + \"_pagingBar_info_pageSize\")) {\n                addPageOnGridTdTitleClick(gridName, \"a.paginate_button.pageDetail\");\n            }\n        });\n    });\n}\n\nfunction addGridTdTitleEvent(gridName) {\n    try {\n        //上一页、下一页、页码、选择每页条数加载\n        var _jtIds = [\"#\" + gridName + \"_pagingBar a.paginate_button.previous\", \"#\" + gridName + \"_pagingBar a.paginate_button.next\", \"#\" + gridName + \"_pagingBar_info_pageDetail\", \"#\" + gridName + \"_pagingBar_info_pageSize\"];\n        for (var i = 0; i < _jtIds.length; i++) {\n            addPageOnGridTdTitleClick(gridName, _jtIds[i]);\n        }\n        //跳转指定页面事件绑定\n        $(\"#\" + gridName + '_pagingBar_info_runtopage').on(\"blur\", function () {\n            addGridTdTitleText(gridName);\n        }).on(\"keydown\", function (e) {\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                return false;\n            }\n        }).on(\"keydown\", function (e) {\n            if (!e) {\n                e = window.event;\n            }\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                $(this).blur();\n            }\n        });\n    } catch (e) {\n        console.log(\"最后一页设置合计请求异常：\" + e)\n    }\n}\n\n\n/*********** grid自定义合计显示 - start ************/\n/**\n * grid自定义合计显示\n * @param gridName\n */\nvar htfyHjParams = {};//后台分页合计值计算\n\nfunction onAfterInitZdyShowHj(gridName) {\n    try {\n        if (!checkNull($.wingsWidget(gridName))) {\n            return;\n        }\n        htfyHjParams[gridName] = false;\n        var data = $.wingsWidget(gridName).getAllData();\n        if (data.length <= 0) return;//没有数据不设置合计;\n        //上一页、下一页、页码、选择每页条数加载\n        var _jtIds = [\"#\" + gridName + \"_pagingBar a.paginate_button.previous\", \"#\" + gridName + \"_pagingBar a.paginate_button.next\", \"#\" + gridName + \"_pagingBar_info_pageDetail\", \"#\" + gridName + \"_pagingBar_info_pageSize\"];\n        for (var i = 0; i < _jtIds.length; i++) {\n            addPageOnClick(gridName, _jtIds[i]);\n        }\n\n        //跳转指定页面事件绑定\n        runToPageFun(gridName);\n\n        //首次初始化查询\n        queryZdyShowHjData(gridName);\n    } catch (e) {\n        console.log(\"最后一页设置合计请求异常：\" + e)\n    }\n}\n\n//跳转指定页面事件绑定\nfunction runToPageFun(gridName) {\n    $(\"#\" + gridName + '_pagingBar_info_runtopage').on(\"blur\", function () {\n        addGridTdTitleText(gridName);\n        queryZdyShowHjData(gridName);\n    }).on(\"keydown\", function (e) {\n        var key = window.event ? e.keyCode : e.which;\n        if (key.toString() == \"13\") {\n            return false;\n        }\n    }).on(\"keydown\", function (e) {\n        if (!e) {\n            e = window.event;\n        }\n        var key = window.event ? e.keyCode : e.which;\n        if (key.toString() == \"13\") {\n            $(this).blur();\n        }\n    });\n}\n\nfunction queryZdyShowHjData(gridName) {\n    var _hjtr = $(\"#\" + gridName + \"_hjtr\");\n    if (!htfyHjParams[gridName].sfycx) {\n        var opts = $.wingsWidget(gridName).getOptions();\n        var ptidObj = opts.ptid || '';\n        var fzbtObj = opts.fzbtid || '';\n        if (checkNull(ptidObj)) {//走后台分页查询\n            getHjAjaxData(gridName);\n        } else if (fzbtObj) {//走复杂表头前端合计控制\n            fzbtHjtr(_hjtr, gridName);\n        }\n    } else {\n        //仅第一次需要请求查询数据，非第一次进入事件，刷新合计行数据\n        //复杂表头grid表格合计值wings默认显示在第一行，处理为显示在每页最后一行\n        var fzbtObj = $.wingsWidget(gridName).getOptions().fzbtid || '';\n        if (checkNull(fzbtObj)) {\n            fzbtHjtr(_hjtr, gridName);\n        } else {\n            _hjtr.empty();\n            _hjtr.append(htfyHjParams[gridName].trHTML);\n        }\n    }\n}\n\nfunction fzbtHjtr(_hjtr, gridName) {\n    var hjtrHtml = _hjtr[0].outerHTML;\n    var tbody = _hjtr.parent().parent().find('tbody');\n    var i = 0;//预防死循环\n    while ($(\"#\" + gridName + \"_hjtr\").length > 0 || i > 50) {\n        $(\"#\" + gridName + \"_hjtr\").remove();\n        i++;\n    }\n    $(tbody[tbody.length - 1]).append(hjtrHtml);\n}\n\n\n/**\n * 事件绑定\n * @param gridName\n * @param selectorId\n * @param bool\n */\nfunction addPageOnClick(gridName, selectorId) {\n    $(selectorId).each(function () {\n        if (selectorId == (\"#\" + gridName + \"_pagingBar_info_pageSize\")) {\n            $(selectorId).bind(\"change\", function () {\n                queryZdyShowHjData(gridName);\n            });\n            addPageOnClick(gridName, \"a.paginate_button.pageDetail\");\n        } else {\n            $(this).bind(\"click\", function () {\n                addGridTdTitleText(gridName);\n                queryZdyShowHjData(gridName);\n            });\n        }\n    });\n}\n\nfunction getHjAjaxData(gridName) {\n    var opts = $.wingsWidget(gridName).getOptions();\n    opts.ajaxParam.showlastHj = \"true\";\n    var ajxData = {};\n    if (checkNull(opts.ajaxParam)) {\n        $.each(opts.ajaxParam, function (key, value) {\n            ajxData[key] = value;\n        });\n    }\n    ajxData.hjOption = getHjOption(gridName);\n    if ($chk(ajxData.hjOption)) {\n        $.ajax({\n            url: opts.ptid, async: \"async\", data: ajxData, dataType: 'json', wingsSubmitAjax: true, success: function (res) {\n                $(\"#\" + gridName + \"_hjtr\").css(\"display\", \"none\");\n                var hjData = $pc.getResData('hjResMap', res);\n                hjData = JSON.parse(hjData.value);\n\n                var hjTr = $(\"#\" + gridName + \"_hjtr\");\n                var obj = hjTr[0].children;\n                var len = obj.length;\n                var gridOptions = $.wingsWidget(gridName).getOptions();\n                var aoColumns = gridOptions.aoColumns;\n\n                $.each(hjData, function (key, value) {\n                    ajxData[key] = value;\n                    var keyMap = {};\n                    for (var i = 0; i < aoColumns.length; i++) {\n                        if (key == aoColumns[i].name) {\n                            keyMap = aoColumns[i];\n                            break;\n                        }\n                    }\n\n                    for (var i = 0; i < len; i++) {\n                        if (obj[i].id.indexOf(\"_\" + key + \"_\") > 0) {\n                            var hjObjValue;\n                            //优先自定义手动自定查询格式化\n                            if ($chk(ajxData.numFormat) && ajxData.numFormat == 'num2Wan') {\n                                hjObjValue = formatNumberWithQFW(num2Wan(value), {\"contain_decimal\": true});\n                            } else {\n                                hjObjValue = $chk(keyMap.format) ? sword_fmt.formatText(value, keyMap.format, \"\", \"\").value : formatNumberWithQFW(Number(value).toFixed(2), {\"contain_decimal\": true});\n\n                            }\n\n                            obj[i].innerHTML = hjObjValue;\n                            $(obj[i]).attr('title', hjObjValue);\n                        }\n                    }\n                });\n                htfyHjParams[gridName] = {'sfycx': true, 'trHTML': $(\"#\" + gridName + \"_hjtr\")[0].innerHTML};\n\n                //复杂表头grid表格合计值wings默认显示在第一行，处理为显示在每页最后一行\n                var fzbtObj = gridOptions.fzbtid || '';\n                if (checkNull(fzbtObj)) {\n                    var hjtrHtml = hjTr[0].outerHTML;\n                    var tbody = hjTr.parent().parent().find('tbody');\n                    hjTr.remove();\n                    $(tbody[tbody.length - 1]).append(hjtrHtml);\n                }\n                $(\"#\" + gridName + \"_hjtr\").css(\"display\", \"\");\n            }, error: function (e, info) {\n                alert(info);\n            }\n        });\n    } else {\n        document.getElementById(gridName + \"_hjtr\").style.display = \"\";\n    }\n\n}\n\nfunction getHjOption(gridName) {\n    var hjl = [];\n    var options = $.wingsWidget(gridName).getOptions().columns;\n    $.each(options, function (index, item) {\n        if (item.hjLabel == \"true\") {\n\n        }\n        if (item.hj == \"true\") {\n            hjl.push(item.name);\n        }\n    });\n    return hjl.toString();\n}\n\n/*********** grid自定义合计显示 - end ************/\n\n\n/*********** grid自定义查询下1000条数据 - start ************/\n/**\n * grid-显示下1000条数据\n * @param gridName\n */\nvar _fun_nextYQT = \"\";\nvar _boolNextBz = {};\n\nfunction onAfterInitZdyShowNextYQ(gridName) {\n    try {\n        scjrCheck(gridName);\n        //上一页、下一页、页码、选择每页条数加载\n        var _jtIds = [\"#\" + gridName + \"_pagingBar a.paginate_button.previous\", \"#\" + gridName + \"_pagingBar a.paginate_button.next\", \"#\" + gridName + \"_pagingBar_info_pageDetail\", \"#\" + gridName + \"_pagingBar_info_pageSize\"];\n        for (var i = 0; i < _jtIds.length; i++) {\n            bindClick(gridName, _jtIds[i]);\n        }\n        runToLastPageFun(gridName);\n    } catch (e) {\n        console.log(\"OTS分页查询、页面按钮事件绑定异常：\" + e);\n    }\n}\n\n//跳转指定页面事件绑定\nfunction runToLastPageFun(gridName) {\n    $(\"#\" + gridName + '_pagingBar_info_runtopage').on(\"blur\", function () {\n        checkLastPage(gridName);\n    }).on(\"keydown\", function (e) {\n        checkLastPage(gridName);\n    });\n}\n\n/**\n * 首次进入判断\n * @param gridName\n */\nfunction scjrCheck(gridName) {\n    if (!!$('a.paginate_button.next').attr('disabled') || _boolNextBz[gridName] == true) {\n        addNextYqtButton(gridName);\n    } else {\n        $('#' + gridName + '_nextYQT').remove();\n    }\n}\n\nfunction checkLastPage(gridName) {\n    $('#' + gridName + '_nextYQT').remove();\n    //判断是否为尾页\n    if (!!$('a.paginate_button.next').attr('disabled')) {\n        addNextYqtButton(gridName);\n    }\n}\n\n/**\n * 绑定点击事件\n * @param gridName\n * @param selectorId\n */\nfunction bindClick(gridName, selectorId) {\n    $(selectorId).each(function () {\n        $(this).bind(\"click\", function () {\n            checkLastPage(gridName);\n            if (selectorId == (\"#\" + gridName + \"_pagingBar_info_pageSize\")) {\n                bindClick(gridName, \"a.paginate_button.pageDetail\");\n            }\n        });\n    });\n}\n\n\nfunction addNextYqtButton(gridName) {\n    var grid = $.wingsWidget(gridName).getAllGridData();\n    if (_boolNextBz[gridName] && grid.trs.length > 0) {\n        var lastNext = $('form#' + gridName + '_pagingBar_form div.dataTables_paginate > a.paginate_button.next.disabled');\n        lastNext.after('<a id=\"' + gridName + '_nextYQT\" class=\"paginate_button next\">加载下1000条数据</a>');\n        $('#' + gridName + '_nextYQT').bind(\"click\", function () {\n            try {\n                eval(_fun_nextYQT);\n            } catch (e) {\n                console.log('查询【' + gridName + '】下1000条数据异常' + e);\n            }\n        });\n    }\n}\n\n/*********** grid自定义查询下1000条数据 - end ************/\n\n/*\n * 获取热力图颜色区间值\n * datas 数据\n * colors 颜色数组\n * param data数据取值\n * isWan 是否转换数据为万元,亿元,Y = 亿，W = 万\n * num 控制保留几位小数\n * 通用单位 元、份\n * */\nfunction splitListVal(datas, colors, param, isWan, num) {\n    var splitListVal = [];\n    var map = {}, dataNum = 0;\n    var xhcs = Math.ceil(datas.length / colors.length);\n\n    for (var i = 0; i < xhcs; i++) {\n        for (j = 0; j < colors.length; j++) {\n            if (dataNum <= datas.length) {\n                if (map.hasOwnProperty(j)) {\n                    map[j] += 1;\n                } else {\n                    map[j] = 1;\n                }\n                dataNum++;\n            }\n        }\n    }\n\n    var startVal = 0;\n    $.each(map, function (k, data) {\n        if (gyUtils.isNull(datas[startVal + data - 1])) {\n            return;\n        }\n        if (!gyUtils.isNull(isWan) && isWan == \"W\") {\n            splitListVal.push({\n                start: Number(num2Wan(datas[startVal + data - 1][param], num)), end: Number(num2Wan(datas[startVal][param], num)), color: colors[k]\n            });\n        } else if (!gyUtils.isNull(isWan) && isWan == \"Y\") {\n            splitListVal.push({\n                start: Number(num2Yi(datas[startVal + data - 1][param], num)), end: Number(num2Yi(datas[startVal][param], num)), color: colors[k]\n            });\n        } else {\n            splitListVal.push({\n                start: Number(datas[startVal + data - 1][param]), end: Number(datas[startVal][param]), color: colors[k]\n            });\n        }\n        startVal = startVal + data;\n    });\n    if (splitListVal.length > 0 && splitListVal.length < colors.length) {\n        splitListVal.push({value: 0, color: colors[colors.length - 1]});\n    }\n    splitListVal.length == 0 ? splitListVal.push({start: 0, end: 0, color: colors[colors.length - 1]}) : splitListVal;\n    return splitListVal;\n}\n\n\n/**\n * 列合并使用\n * @param _gridName\n * @param _xhName\n * @param _valName\n */\nfunction initDbrwtjStyle(_gridName, _xhName, _valName) {\n    try {\n        var dataMap = {xh: 0, values: {}, class: \"zdyOdd\"};\n        var _grid = $.wingsWidget(_gridName);\n        var gridData = _grid.getAllGridData();\n\n        //处理合并数量及值\n        for (var i = 0; i < gridData.trs.length; i++) {\n            var val = gridData.trs[i].tds[_valName].value;\n            if (!checkNull(dataMap.values[val])) {\n                dataMap.values[val] = val + \"-1\";\n            } else {\n                dataMap.values[val] = val + \"-\" + (Number(dataMap.values[val].split(\"-\")[1]) + 1);\n            }\n        }\n        for (var i = 0; i < gridData.trs.length; i++) {\n            var value = gridData.trs[i].tds[_valName].value;\n            var ysEl = _grid.getRowEl(i).getCell(_valName);\n            //var xhEl = _grid.getRowEl(i).getCell(_xhName);\n            ysEl.parentNode.classList.add(dataMap.class);\n\n            var key = dataMap.values[value];\n\n            if (key.split(\"-\").length < 3) {\n                dataMap.xh++;\n                ysEl.rowSpan = dataMap.values[value].split(\"-\")[1];\n                //xhEl.rowSpan = dataMap.values[value].split(\"-\")[1];\n                //xhEl.innerHTML = dataMap.xh;\n                dataMap.values[value] = dataMap.values[value] + \"-T\"\n            } else {\n                ysEl.remove();\n                //xhEl.remove();\n                dataMap.class = dataMap.class == \"zdyOdd\" ? \"zdyEven\" : \"zdyOdd\";\n            }\n        }\n\n        var classNams = [\"zdyOdd\", \"zdyEven\"];\n        for (var a = 0; a < classNams.length; a++) {\n            var zdyOdds = $('.' + classNams[i]);\n            for (var i = 0; i < zdyOdds.length; i++) {\n                zdyOdds[i].removeAttribute(\"class\");\n                zdyOdds[i].classList.add(classNams[a].replace(\"zdy\", \"\").toLowerCase());\n            }\n        }\n    } catch (e) {\n        console.log(\"列合并异常：\" + _gridName + \",\" + _valName + \",\" + e);\n    }\n}\n\nfunction checkResNull(resData, name) {\n    return checkNull(resData.getAttr(name)) && checkNull(JSON.parse(resData.getAttr(name)));\n}\n\n/**\n * 获取近12月月份\n */\nfunction getJ12YStr() {\n    var dataArr = [];\n    var data = new Date();\n    var year = data.getFullYear();\n    data.setMonth(data.getMonth() + 1, 1)//获取到当前月份,设置月份\n    for (var i = 0; i < 12; i++) {\n        data.setMonth(data.getMonth() - 1);//每次循环一次 月份值减1\n        var m = data.getMonth() + 1;\n        m = m < 10 ? \"0\" + m : m;\n        dataArr.push(data.getFullYear() + '' + (m))\n    }\n    return dataArr;\n}\n\n/**\n * 近12月数据补齐\n * @param resultData\n * @param key\n * @returns {[]}\n */\nfunction bqj12yData(resultData, key) {\n    var dateArr = getJ12YStr();\n    var echarstData = [];\n    for (var i = 0; i < dateArr.length; i++) {\n        var tempData = $.extend({}, resultData[0]);\n        var bool = true;\n        for (var j = 0; j < resultData.length; j++) {\n            if (dateArr[i] == resultData[j][key]) {\n                tempData = resultData[j];\n                bool = false;\n                break;\n            }\n        }\n        if (bool) {\n            $.each(tempData, function (key, val) {\n                tempData[key] = 0;\n            });\n            tempData[key] = dateArr[i];\n        }\n        echarstData.push(tempData);\n    }\n    return echarstData;\n}\n\n\n//数据排序，默认降序\nfunction sortData(data, key, type) {\n    for (var i = 0; i < data.length - 1; i++) {\n        for (var j = 0; j < data.length - i - 1; j++) {\n            var bool = type == 'desc' ? Number(data[j][key]) < Number(data[j + 1][key]) : Number(data[j][key]) > Number(data[j + 1][key]);\n            if (bool) {\n                var temp = data[j];\n                data[j] = data[j + 1];\n                data[j + 1] = temp;\n            }\n        }\n    }\n}\n\n// 以添加表头形式打开\nfunction addTabItemLocal2(url, params, title, idStr) {\n    var iWidth = window.screen.availWidth - 10;\n    var iHeight = window.screen.availHeight - 30;\n    var iTop = 0;\n    var iLeft = 0;\n    var baseurl = url;\n    //params = EncryptUtils.encryptStr(params);\n    var PageUrl = prefix + host + baseurl + params;\n    if (window.top == window.self) {\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=0, left=0, toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n        return;\n    }\n    try {\n        top.addTabItem({\n            id: idStr,/*唯一标识码*/\n            title: title, tabContentType: 'iframe', src: PageUrl, isCloseBtn: 'true', tabItemWidth: 150, isShowMenuItem: [\"false\", \"true\", \"true\", \"true\"], tempData: title\n        });\n    } catch (e) {\n        e.message;\n        var openUrl = \"\";\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=' + iTop + ', left=' + iLeft + ', toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,width=' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n    }\n}\n\n\n/**\n * 获取近N个月日期数据，参数:n-近N月、b-是否包含当前月份true包含（默认包含）,返回数据格式yyyyyMMddd\n */\nfunction solveDate(n, b) {\n    var solveDate = {};\n    var date = new Date();\n    let year = date.getFullYear();\n    let month = date.getMonth() + 1;\n    let day = date.getDate();\n\n    var bool = checkNull(b) ? b : true;\n    var yn = bool ? n - 1 : n;\n\n    const tjnyqDate = new Date(year, (month - yn - 1), 1);\n    solveDate.tjnyq = tjnyqDate.getFullYear() + \"\" + B0(tjnyqDate.getMonth() + 1) + \"01\";\n    solveDate.tjnyz = year + \"\" + B0(month) + B0(day);\n\n    return solveDate;\n}\n\nfunction B0(num) {\n    return num < 10 ? \"0\" + num : num;\n}\n\n/**\n * 获取指定日期时间\n * @param y 年\n * @param m 月\n * @param d 日\n * @param nd 指定起始时间，时间格式：yyyy-mm-dd\n * @returns {string}\n */\nfunction getNday(y, m, d, nd) {\n    var date = new Date();\n    if (checkNull(nd)) {\n        let len = nd.split('-').length;\n        var nds = nd;\n        //时间格式补位\n        if (len == 3) {//格式：yyyy-mm-dd\n            nds = nd;\n        } else if (len == 2) {//格式：yyyy-mm\n            nds = nd + '-' + B0(date.getDate());\n        } else if (len == 1) {//格式：yyyy\n            nds = nd + '-' + date.getMonth() + '-' + B0(date.getDate());\n        }\n        let ndStr = nds.split('-');\n        date = new Date(Number(ndStr[0]), (Number(ndStr[1]) - 1), Number(ndStr[2]));\n    }\n    const newDate = new Date((date.getFullYear() + y), (date.getMonth() + m), (date.getDate() + d));\n    return newDate.getFullYear() + '-' + B0((newDate.getMonth() + 1)) + '-' + B0(newDate.getDate());\n}\n\n\n/**\n * 获取任意时间（非指定起始）\n * @param y\n * @param m\n * @param d\n * @param h\n * @param mi\n * @param s\n * @returns {string}\n */\nfunction getNtime(y, m, d, h, mi, s) {\n    var date = new Date();\n    const newDate = new Date((date.getFullYear() + y), (date.getMonth() + m), (date.getDate() + d), (date.getHours() + h), (date.getMinutes() + mi), (date.getSeconds() + s));\n    return newDate.getFullYear() + '-' + B0((newDate.getMonth() + 1)) + '-' + B0(newDate.getDate()) + ' ' + B0(newDate.getHours()) + ':' + B0(newDate.getMinutes()) + ':' + B0(newDate.getSeconds());\n}\n\n/**\n * 月份时间段控制，例：控制查询某一个时间段\n * @param formName 表单名称\n * @param qsyfn 起始月份名称\n * @param zzyfn 终止月份名称\n * @param checkbs 当前选择标识：1-起始，2-终止\n * @param num 间隔月份数\n */\nfunction yfSjdCheck(formName, qsyfn, zzyfn, checkbs, num) {\n    //同年度时间校验\n    var form = $.wingsWidget(formName);\n    var qsyf = form.getValue(qsyfn).split('-').length == 3 ? form.getValue(qsyfn) : form.getValue(qsyfn) + '-01';\n    var zzyf = form.getValue(zzyfn).split('-').length == 3 ? form.getValue(zzyfn) : form.getValue(zzyfn) + '-01';\n    var n = Number(num) - 1;\n    if (checkNull(qsyf) && checkNull(zzyf)) {\n        var dqyf = getNday(0, 0, 0, '');//当前月份\n        if ('1' == checkbs) {//选择起始月份时\n            var zzyf2 = '';\n            var tsyf = getNday(0, n, 0, qsyf);//后推n个月\n            if (regexYf2Num(tsyf) > regexYf2Num(dqyf)) {\n                if (regexYf2Num(dqyf) < regexYf2Num(qsyf)) {\n                    tsyf = getNday(0, -n, 0, dqyf);//前推n个月\n                    form.setValue(qsyfn, tsyf);\n                    form.setValue(zzyfn, dqyf);\n                } else {\n                    form.setValue(zzyfn, dqyf);\n                }\n            } else if (regexYf2Num(tsyf) < regexYf2Num(zzyf)) {\n                form.setValue(zzyfn, tsyf);\n            } else if (regexYf2Num(zzyf) < regexYf2Num(qsyf)) {\n                if (regexYf2Num(tsyf) > regexYf2Num(dqyf)) {\n                    form.setValue(zzyfn, dqyf);\n                } else {\n                    form.setValue(zzyfn, tsyf);\n                }\n            } else if (regexYf2Num(dqyf) < regexYf2Num(qsyf)) {\n                tsyf = getNday(0, -n, 0, dqyf);//前推n个月\n                form.setValue(qsyfn, tsyf);\n                form.setValue(zzyfn, dqyf);\n            }\n        } else {//选择终止月份时\n            var tsyf = getNday(0, -n, 0, zzyf);//前推n个月\n            if (regexYf2Num(zzyf) > regexYf2Num(dqyf)) {\n                tsyf = getNday(0, -n, 0, dqyf);//前推n个月\n                if (regexYf2Num(tsyf) > regexYf2Num(qsyf)) {\n                    form.setValue(qsyfn, tsyf);\n                    form.setValue(zzyfn, dqyf);\n                } else {\n                    form.setValue(zzyfn, dqyf);\n                }\n            } else if (regexYf2Num(zzyf) < regexYf2Num(qsyf)) {\n                form.setValue(qsyfn, tsyf);\n            } else if (regexYf2Num(tsyf) > regexYf2Num(qsyf)) {\n                form.setValue(qsyfn, tsyf);\n            }\n        }\n    } else {\n        WingsDialog.alert(\"时间为空\");\n    }\n}\n\nfunction regexYf2Num(yf) {\n    return Number(yf.replace(/-/g, ''));\n}\n\n/**\n * 修改伪类[::before]中content值\n * @param a 选择器\n * @param t 文字\n */\nfunction editBeforeContent(a, t) {\n    $(a + ' style').remove();\n    $(a).append('<style>' + a + '::before{content: ' + t + ' !important;}</style>');\n}\n\n/**\n * 隐藏选中元素\n * @param selects\n */\nfunction setSelectsHide(selects) {\n    $.each(selects, function (i, s) {\n        $(s).hide();\n    });\n}\n\n/**\n * 显示选中元素\n * @param selects\n */\nfunction setSelectsShow(selects) {\n    $.each(selects, function (i, s) {\n        $(s).show();\n    });\n}\n\n/**\n * 只有广东省查询全电票信息用PG库，其他走原来一户式查询-电子发票管理库\n * rulesArray是规则数组\n * rule是被判断值\n * result 是paramsData.result\n * s 是keyCode需要添加字段\n * @param rulesArray\n * @param rule\n * @param result\n * @param s\n * @returns {*}\n */\nfunction qdsChange(rulesArray, rule, result, s) {\n    if (rulesArray.includes(rule)) {\n        for (var m of result) {\n            m.keyCode += s;\n        }\n    }\n    return result\n}\n\n/**\n * 重置grid表格\n * @param g\n */\nfunction resetGridData(g) {\n    $w(g).emptyData();\n    $.wingsWidget(g).initData({trs: []});\n}\n\n/**\n * 跳转一户式查询\n * @param djxh\n * @param nsrsbh\n * @param nsrmc\n */\nfunction _openYhscxItem(param) {\n    //以下内容从统一工作平台获取\n    var systemInfoJson = {\n        \"zndm\": \"01\", \"gndm\": \"Z1000068T1000002\", \"gwssswjg\": \"00000000000\", \"gwxh\": \"6171361be29a4d49a2703914df514778\", \"gt3zyydm\": \"Z1000068\", \"gt3ywfldm\": \"T10\", \"tygzpt\": \"0\",// 0代表功能来自总局，1代表功能来自省局【必须参数】\n        \"source\": \"0\"// 0代表一户式查询（全国），1代表一户式查询（网格）【必须参数】\n    };\n    var systemInfo = JSON.stringify(systemInfoJson);\n    //域名和端口根据预生产和生产环境不同发生变化\n    var url = \"/sword?ctrl=DhcxCtrl_loadIndexPage&djxh=\" + param.djxh + \"&nsrsbh=\" + param.nsrsbh + \"&nsrmc=\" + param.nsrmc + \"&systemInfo=\" + systemInfo;\n    addTabItemLocal(url, \"\", \"一户式查询\", \"YXSCX-XX-\" + (new Date()));\n}\n\n/*************************************** 设置Grid校验组件提示 Start *******************************************/\n/**\n * 设置Grid校验组件提示\n * @param msg\n * @param gnId\n * @param colname\n * @param rowEl\n */\nfunction setShowToolTips(msg, colname, rowEl) {\n    if (msg != \"\") {\n        var gnId = rowEl.wingsGrid.getOptions().name;\n        var grid = $.wingsWidget(gnId);\n        //grid.getCellEl(rowEl.index, colname).setValue(\"\");\n        var cell = grid.getCellEl(rowEl.index, colname);\n        showToolTips(gnId, msg, cell.getObj().offsetLeft, cell.getObj().offsetTop);\n    }\n}\n\nfunction showToolTips(gnId, msg, x, y) {\n    var withLen = getboeAbstractLength(msg);\n    var tooltip = $(\"<div class = 'tooltips' style='width: \" + (withLen * 6 + 12) + \"px'>\" + msg + \"<div class=\\\"erroe_wings_sj\\\" style=\\\"top:20px;\\\"></div></div>\");\n    $(\"div[name='\" + gnId + \"'] table:nth-child(1)\").append(tooltip);\n    tooltip.css({\"left\": x, \"top\": y - tooltip.height()});\n    setTimeout(removeTooltip, 1 * 1000);\n}\n\nfunction removeTooltip() {\n    $(\".tooltips\").fadeTo(\"slow\", 0.05, function () {//fade 变淡\n        $(this).slideUp(\"slow\", function () {//slide up 叠起\n            $(this).remove();//then remove from the DOM\n        });\n    });\n}\n\n//校验长度，区分中英文\nfunction getboeAbstractLength(str) {\n    var len = 0;\n    for (var i = 0; i < str.length; i++) {\n        var c = str.charCodeAt(i);\n        //单字节加1\n        if ((c >= 0x0001 && c <= 0x007e) || (0xff60 <= c && c <= 0xff9f)) {\n            len++;\n        } else {\n            len += 2;\n        }\n    }\n    return len;\n}\n\n/*************************************** 设置Grid校验组件提示 end *******************************************/\n\n\n/*********** grid列合并处理 - start ************/\n//hbColName=[{name:swjgmc,valueName:'swjgmc,'sxlb'}]\nvar cellObj_DL = {};\n\nfunction onCreateRowDhblFun(keys, fzlxmlxs, rowData, rowEl) {\n    var hbln = [];\n    $.each(keys, function (i, v) {\n        hbln.push(fzlxmlxs[v].split('-')[0]);\n    });\n    var hbCols = [];\n    for (var i = 0; i < keys.length; i++) {\n        var valueName = '';\n        for (var j = 0; j < (i + 1); j++) {\n            valueName += hbln[j] + ',';\n        }\n        valueName = valueName.endWith(',') ? valueName.substr(0, valueName.length - 1) : valueName;\n        hbCols.push({name: hbln[i], valueName: valueName});\n    }\n\n    makeLhbDLFun(hbCols, rowData, rowEl);\n}\n\n/*多列合并列处理*/\nfunction makeLhbDLFun(hbCols, rowData, rowEl) {\n    for (var i = (hbCols.length - 1); i >= 0; i--) {\n\n        var cols = hbCols[i];\n        var hbColName = cols.name;\n        var cValue = '';\n        var col = cols.valueName.split(',');\n        if (col.length > 1) {\n            for (var j = 0; j < col.length; j++) {\n                cValue += rowData[col[j]].value;\n            }\n        } else {\n            cValue = rowData[cols.valueName].value;\n            //合并列值为空时使用空字符串占位\n            cValue = checkNull(cValue) ? cValue : ' ';\n        }\n        if (rowEl.index == 0) {\n            cellObj_DL[hbColName] = {value: '', objEl: null, k: 1};\n        }\n\n        //首次进入时数据归零\n        if (cellObj_DL[hbColName].value != cValue) {\n            if (rowEl.index > 0) {\n                $(cellObj_DL[hbColName].objEl).attr('rowspan', cellObj_DL[hbColName].k);\n            }\n\n            cellObj_DL[hbColName].value = cValue;\n            cellObj_DL[hbColName].objEl = rowEl.getCell(hbColName);\n            cellObj_DL[hbColName].k = 1;\n        } else {\n            cellObj_DL[hbColName].k++;\n            if (cellObj_DL[hbColName].k > 1) {\n                rowEl.getCell(hbColName).remove();\n            }\n        }\n\n        var xh = $(rowEl.getCell('xh')).text();\n        var totalRows = rowEl.pagingObj.getTotalRows();\n\n        //每页加载数据条数判断是否为当前也最后一次加载\n        if (rowEl.pagingObj.getPageSize() == (rowEl.index + 1) || xh == totalRows) {\n            $(cellObj_DL[hbColName].objEl).attr('rowspan', cellObj_DL[hbColName].k);\n        }\n    }\n}\n\nvar cellObj = {value: '', objEl: null, k: 1};\n\n/*合并列处理*/\nfunction makeLhb(hbColName, rowData, rowEl) {\n    if (rowEl.index == 0) {\n        cellObj = {value: '', objEl: null, k: 1};\n    }\n\n    //首次进入时数据归零\n    if (cellObj.value != rowData[hbColName].value) {\n        if (rowEl.index > 0) {\n            $(cellObj.objEl).attr('rowspan', cellObj.k);\n        }\n\n        cellObj.value = rowData[hbColName].value;\n        cellObj.objEl = rowEl.getCell(hbColName);\n        cellObj.k = 1;\n    } else {\n        cellObj.k++;\n        if (cellObj.k > 1) {\n            rowEl.getCell(hbColName).remove();\n        }\n    }\n\n    var xh = $(rowEl.getCell('xh')).text();\n    var totalRows = rowEl.pagingObj.getTotalRows();\n\n    //每页加载数据条数判断是否为当前也最后一次加载\n    if (rowEl.pagingObj.getPageSize() == (rowEl.index + 1) || xh == totalRows) {\n        $(cellObj.objEl).attr('rowspan', cellObj.k);\n    }\n}\n\n/*********** grid列合并处理 - end ************/\n\n\n/**\n * 弹窗公用方法，弹窗高度自适应\n * @param p\n */\nfunction yxscxShowModalDialog(p) {\n    var w = checkNull(p.w) ? p.w : getViewPort().width * 0.85;\n    var h = checkNull(p.h) ? p.h : '0px';\n    var data = checkNull(p.data) ? p.data : [];\n    WingsDialog.showModalDialog({\n        param: data, title: p.title, url: p.url, width: w, height: h,\n    });\n\n    var iframeId = WingsDialog.getModalDialog().defaultOptions.id;\n    var iframe = $('#' + iframeId).find('iframe');\n    //onresize=\"iframeOnload(this)\" onpageshow=\"iframeOnload(this)\" onload=\"iframeOnload(this)\"\n\n    iframe.attr('onresize', 'zdyDiaLogIframeOnload(' + \"'\" + iframeId + \"'\" + ')');\n    iframe.attr('onpageshow', 'zdyDiaLogIframeOnload(' + \"'\" + iframeId + \"'\" + ')');\n    iframe.attr('onload', 'zdyDiaLogIframeOnload(' + \"'\" + iframeId + \"'\" + ')');\n\n    var minH = checkNull(p.minH) ? p.minH : '500';\n    iframe.css({/*'min-width':,*/'min-height': minH + 'px'});\n}\n\nfunction zdyDiaLogIframeOnload(iframeId) {\n    var iframe = $('#' + iframeId).find('iframe');\n    var iframeBody = $(iframe).contents().find('body');\n    if (iframeBody.length > 0) {\n        var height = iframeBody[0].scrollHeight;\n        //height = height < 500 ? 500 : height;\n        if (height != iframe.height) {\n            iframe.height(height);\n        }\n    }\n    setTimeout(function () {\n        zdyDiaLogIframeOnload(iframeId);\n    }, 1000);\n}\n\nfunction showRowData(gridName, data, rowIndex) {\n    var grid = $.wingsWidget(gridName);\n    //var gridData = grid.getAllGridData();\n    var gridData = data;\n    $.each(gridData.trs, function (i, item) {\n        var rows = grid.getRowEl(i);\n        /*$.each(data[i], function (key, val) {\n            item.tds[key] = val;\n        });*/\n        try {\n            $.each(rows.wingsGrid.getOptions().aoColumns, function (h, v) {\n                //日期格式处理\n                if (checkNull(rows.getCell(v.name)) && rows.getCell(v.name).outerHTML.indexOf('yyyy-mm-dd') > 0) {\n                    item.tds[v.name].value = checkNull(item.tds[v.name]) ? item.tds[v.name].value.substring(0, 10) : item.tds[v.name].value;\n                }\n            });\n\n            grid.updateRow(rows, item);\n        } catch (e) {\n        }\n    });\n}\n\nfunction hiddenRowData(gridName, data, rowIndex) {\n    var grid = $.wingsWidget(gridName);\n    //var gridData = grid.getAllGridData();\n    var gridData = data;\n    $.each(gridData.trs, function (i, item) {\n        var rows = grid.getRowEl(i);\n        /*$.each(data, function (key, value) {\n            item.tds[key] = value;\n        });*/\n        try {\n            grid.updateRow(rows, item);\n        } catch (e) {\n        }\n    });\n}\n\n\n/**\n * 获取岗位权限信息传递\n * @returns {string}\n */\nfunction getGwQxUrl() {\n    var u = window.location.search.split('&');\n    var n = 'gwssswjg,zndm,gndm,gwxh,gt3zyydm,gt3ywfldm,qddm'.split(\",\");\n    var m = {};\n    for (var i = 0; i < u.length; i++) {\n        if (u[i].indexOf('=') > -1) {\n            var k = u[i].split('=')[0];\n            var v = u[i].split('=')[1];\n            m [k] = v;\n        }\n    }\n\n\n    var url = '';\n    $.each(n, function (i, v) {\n        url += '&' + v + '=' + m[v];\n    });\n    return url;\n}\n\nfunction checkCktsData(rqStr, formName, sjqName, sjzName, checkbs) {\n    if (checkNull(rqStr)) {\n        var _name = formName.split(\"-\");\n        var from = $.wingsWidget(_name[0]);\n        var q = from.getValue(sjqName);\n        var z = from.getValue(sjzName);\n        let q_str = q.replaceAll(\"-\", \"\").length > 6 ? q.replaceAll(\"-\", \"\").substr(0, 6) : q.replaceAll(\"-\", \"\");\n        let z_str = z.replaceAll(\"-\", \"\").length > 6 ? z.replaceAll(\"-\", \"\").substr(0, 6) : z.replaceAll(\"-\", \"\");\n        let msg = \"\";\n        let msg_q = Number(q_str) < Number(rqStr) ? \"查询期起不能小于\" + rqStr : \"\";\n        let msg_z = Number(z_str) < Number(rqStr) ? \"查询期止不能小于\" + rqStr : \"\";\n        msg = checkNull(msg_q) ? msg_q : (checkNull(msg_z) ? msg_z : \"\");\n        if (checkNull(msg)) {\n            WingsDialog.alert(msg);\n            if (checkNull(msg_q)) {\n                from.setValue(sjqName, \"\");\n            }\n            if (checkNull(msg_z)) {\n                from.setValue(sjzName, \"\");\n            }\n            return;\n        }\n    }\n    CheckDate(formName, sjqName, sjzName, checkbs);\n}\n\n/*当前登录人岗位权限机关选择*/\nfunction gydlrqxselect(baseData, treeNames, _callbackName) {\n    if (!gyUtils.isNull(baseData) && !gyUtils.isNull(baseData.swjgGwQxList) && baseData.swjgGwQxList.length > 1) {\n        let param = {\n            title: '请选择该岗位的职能税务机关',\n            url: \"/yxscx/common/jsp/common_dlrqxselect.jsp\",\n            w: getViewPort().width * 0.45,\n            h: 400,\n            minH: 300,\n            data: [{\"baseData\": baseData, \"treeNames\": treeNames, \"_callbackName\": _callbackName}]\n        };\n        yxscxShowModalDialog(param);\n    }\n}\n\n\n/*岗位权限选择返回固定方法*/\nfunction ZnqxSelectSuccess(result, _callbackName) {\n    if (!gyUtils.isNull(result)) {\n        var treeData = [];\n        treeData.push({\n            caption: result.gwqxswjgmc, code: result.gwqxswjgdm, pcode: \"\", isParent: \"true\", nocheck: \"true\", TYPE: \"tree\"\n        });\n        $.each(result.treeNames, function (i, v) {\n            $.wingsWidget(v).initData({'data': treeData});\n            $(\"#orgCode\" + v).val(result.gwqxswjgdm);\n            $(\"#orgName\" + v).val(result.gwqxswjgmc);\n        });\n    }\n    //若传入回调方法名称，则调用回调方法处理私有页面数据\n    if (checkNull(_callbackName)) {\n        var fn = eval(_callbackName);\n        if (typeof (fn) === 'function') {\n            eval(fn(result));\n        }\n    }\n    return true;\n}"
          },
