          "content": {
            "size": 7099,
            "mimeType": "text/javascript",
            "compression": 4511,
            "text": "/**\n * dateTime封装成jquery 插件\n */\n(function($) {\n\t\n\t$.fn.wingsDatetime = function(options) {\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsDatetime.defaults, options);\n\t\t\n\t\tvar $timeObj =$(this);\n\t\t\n\t\tvar minView = converFormatToMinView(opts.format);\n\t\tvar startView = converFormatToStartView(opts.format, minView);\n\t\t\n\t\tvar pickerPosition = \"bottom-right\";\n\t\tif( opts.upDown == 'up'){\n\t\t\t//显示在上方\n\t\t\tpickerPosition = \"top-left\";\n\t\t}\n\t\tif( opts.upDown == 'upRight'){\n\t\t\t//显示在上方\n\t\t\tpickerPosition = \"top-right\";\n\t\t}\n\t\t$(this).datetimepicker({\n\t\t\tformat:opts.format,\n\t\t\tweekStart:opts.weekStart,\n\t\t\ttodayBtn :opts.todayBtn ,\n\t\t\tautoclose : true,\n\t\t\ttodayHighlight:1,\n\t\t\tstartView : startView,\n\t\t\tminView: minView,\n\t\t\tforceParse: 1,\n\t\t\tshowMeridian : opts.showMeridian,\n\t\t\tlanguage: 'zh-CN',\n\t\t\tstartDate : opts.startDate,\n\t\t\tendDate : opts.endDate,\n\t\t\tpickerPosition:pickerPosition\n\t\t});\n\t\t//追加弹出窗口事件\n\t\t\n\t\tif(opts.onShowFn){\t\t\t\t\t\n\t\t\t$(this).datetimepicker().on(\"show\",function(){\n\t\t\t\tvar onShowFn = wings_getFunc(opts.onShowFn);\n\t\t\t\tfor (var b = 0; b < onShowFn.length; b++) {\n\t\t\t        var  func = eval(onShowFn[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t\t\t\t    \tvar result = new func();\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t})\n\t\t};\n\t\t  \n\t\t//公共校验方法(传递必要参数即可)\n\t\t$timeObj.validObj = function(){\n  \t\t\t//调用校验规则\n\t\t\tif(opts.isNewValidate == \"true\" && opts.rules && opts.rules.length > 0){\n\t\t\t\treturn $.wingsValidate2.validObj(opts.v_id, $timeObj ,$timeObj.getValue() ,opts.rules);\n\t\t\t}\n\t\t}\n\t\t$timeObj.setRule = function(rules){\n\t\t\topts.rules = rules;\n\t\t};\n\t\t\n\t\tif(opts.onHideFn){\t\t\t\t\t\n\t\t\t$(this).datetimepicker().on(\"hide\",function(){\n\t\t\t\tvar onHideFn = wings_getFunc(opts.onHideFn);\n\t\t\t\tfor (var b = 0; b < onHideFn.length; b++) {\n\t\t\t        var  func = eval(onHideFn[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t\t\t\t    \tvar result = new func();\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t})\n\t\t};\n\t\t\n\t\t//适配 校验组件（jq Validate）\n//\t\t$(this).datetimepicker().on(\"changeDate\",function(){\n//\t\t\t$('#'+opts.inputId).focus();\n//\t\t\t$('#'+opts.inputId).blur();\n//\t\t})\n\t\t\n\t\t\n\t\t//获得值设置值\n\t\t$timeObj.setValue = function(value){\n\t\t\topts.isOnChageEnable = \"false\";//阻止变更事件\n\t\t\t$('#'+opts.inputId).val(value);\n\t\t\tdbsj = value;\n\t\t\tif(value == ''){\n\t\t\t\t$timeObj.datetimepicker('clear');\n\t\t\t}else{\n//\t\t\t\t$timeObj.datetimepicker('update');//设置时间  性能优化\n//\t\t\t\t$timeObj.datetimepicker('setValue');//应用format\n\t\t\t\t$timeObj.datetimepicker('setFormatValue',value);//应用format\n\t\t\t}\n\t\t\topts.isOnChageEnable = \"true\";//放开变更事件\n\t\t\t\n\t\t};\n\t\t//获得值设置值\n\t\t$timeObj.setNotFormatedValue = function(value){\n\t\t\topts.isOnChageEnable = \"false\";//阻止变更事件\n\t\t\t$('#'+opts.inputId).val(value);\n\t\t\tif(value == ''){\n\t\t\t\t$timeObj.datetimepicker('clear');\n\t\t\t}else{\n\t\t\t\t$timeObj.datetimepicker('setNotFormatedValue',value);//应用format\n\t\t\t}\n\t\t\topts.isOnChageEnable = \"true\";//放开变更事件\n\t\t\t\n\t\t};\n\t\t$timeObj.getValue = function(){\n\t\t\treturn $('#'+opts.inputId).val();\n\t\t};\n\t\t//设置 有效无效\n\t\t$timeObj.setDisable = function(){\n  \t\t\topts.selfObj.attr('disabled',\"true\");\n\t\t\t$('#span_'+opts.inputId).hide();\n  \t\t\t\n\t\t};\n\t\t$timeObj.setEnable = function(){\n  \t\t\topts.selfObj.attr('disabled',null);\n\t\t\t$('#span_'+opts.inputId).show();\n\t\t};\n\t\t\n\t\t$timeObj.setEndDate = function(endDate){\n\t\t\t$(this).datetimepicker('setEndDate',endDate,\"false\");\n\t\t};\n\t\t$timeObj.setStartDate = function(startDate){\n\t\t\t$(this).datetimepicker('setStartDate',startDate,\"false\");\n\t\t};\n\t\t\n\t\tvar dbsj = null ;\n\t  \topts.selfObj.change(function(el){\n\t  \t\tvar srsj = el.target.value;\n\t  \t\tif(srsj == dbsj ){\n\t  \t\t\treturn;\n\t  \t\t}\n\t  \t\tdbsj = el.target.value;\n  \t\t\tif(opts.onDateChange){\n\t  \t\t\tif(opts.isOnChageEnable === \"false\"){\n\t  \t\t\t\treturn;\n\t  \t\t\t};\n\t\t\t\t//执行前方法\n\t\t  \t\tvar onDateChange = wings_getFunc(opts.onDateChange);\n\t\t\t\tfor (var b = 0; b < onDateChange.length; b++) {\n\t\t\t\t\tvar  func = eval(onDateChange[b]);\n\t\t\t\t\tif (typeof func == \"function\") {\n\t\t\t\t\t\tvar result2 = new func(el.target.value);\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t\t\n  \t\t\t};\n\t\t  \t//追加校验事件\n\t\t  \t$timeObj.validObj();\n  \t\t});\n\t\t\n  \t\t//disable\n  \t\tif(opts.disable && opts.disable == \"true\"){\n  \t\t\t$timeObj.setDisable();\n  \t\t}else{\n  \t\t\t$timeObj.setEnable();\n  \t\t};\n\t\t\n  \t\t\n\t \t//select销毁方法\n\t\t$timeObj.destroy = function(){\n\t\t\t$timeObj.datetimepicker('remove');//应用format\n\t\t\t$.each(opts,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$.each($timeObj,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$timeObj.remove();\n\t\t\t$timeObj = null;\n\t\t};\n  \t\t\n\t\treturn $timeObj;\n\t};\n\t\n\tvar data = [\n    \t['s', 'hour',  0], \n    \t['i', 'hour',  0],\n    \t['h', 'day' ,  1],\n    \t['d', 'month', 2],\n    \t['m', 'year' , 3],\n    \t['y', 'decade',4],\n    ];\n\n\tif (!Array.prototype.indexOf){  \n        Array.prototype.indexOf = function(elt /*, from*/){  \n        var len = this.length >>> 0;  \n        var from = Number(arguments[1]) || 0;  \n        from = (from < 0)  \n             ? Math.ceil(from)  \n             : Math.floor(from);  \n        if (from < 0)  \n          from += len;  \n        for (; from < len; from++)  \n        {  \n          if (from in this &&  \n              this[from] === elt)  \n            return from;  \n        }  \n        return -1;  \n      };  \n    } \n\tthis.converFormatToMinView = function(format){\n    \tformat = format.toLowerCase();\n    \tfor(var i=0; i<data.length; i++){\n    \t\tvar tempData = data[i];\n    \t\tif(format.indexOf(tempData[0]) >= 0){\n    \t\t\treturn tempData[1];\n    \t\t}\n    \t}\n    \treturn 'month';\n    };\n\n    \n    this.converFormatToStartView = function(format, minView){\n    \tvar result = 'month';\n    \tformat = format.toLowerCase();\n    \tfor(var i=5; i>0; i--){\n    \t\tvar tempData = data[i];\n    \t\tif(format.indexOf(tempData[0]) > 0){\n    \t\t\tresult = tempData[1];\n    \t\t\tbreak;\n    \t\t}\n    \t }\n    \n    \tif(minView == 'hour' || minView == 'day'){ // h\n    \t\tif(result != 'hour' && result != 'day'){\n    \t\t\tresult = 'month';\n    \t\t}\n    \t}else{\n    \t\tresult = minView;\n    \t}\n    \treturn result;\n    };\n    \n\n\t\n\t// 默认设置\n\t$.fn.wingsDatetime.defaults = {\n\t\t\tformat :\"yyyy-mm-dd\",\n\t\t//\tweekStart: 1,//一周从哪一天开始\n\t        todayBtn:  1,//则在日期时间选择器组件的底部显示一个 \"Today\" 按钮用以选择当前日期。如果是true的话\n\t\t\tautoclose: true, //当选择一个日期之后是否立即关闭此日期时间选择器。\n\t\t//\ttodayHighlight: 1, //如果为true, 高亮当前日期。\n\t\t\tstartView: 2, //日期时间选择器打开之后首先显示的视图\n\t\t\tforceParse: 0,//当选择器关闭的时候，是否强制解析输入框中的值。也就是说，当用户在输入框中输入了不正确的日期，选择器将会尽量解析输入的值，并将解析后的正确值按照给定的格式format设置到输入框中。\n\t        showMeridian: 1,\n\t        minuteStep :5, //此数值被当做步进值用于构建小时视图。对于每个 minuteStep 都会生成一组预设时间（分钟）用于选择\n\t        startDate: null,\n\t        endDate : null\n\t};\n})(window.jQuery);"
          },
