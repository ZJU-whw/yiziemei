            "text": "(function($) {\n\n\t$.fn.wingsMove = function(options) {\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsMove.defaults, options);\n\t\t//this.options = $.extend({}, $.fn.wingsMove.defaults, options);\n\t\t\n\t\tthis.such = null;\n\t\t\t\t\n//\t\tvar outData = opts.data;\n//\t\tif (outData) {\n//\t\t\t//初始化只能有一种方式\n//\t\t\t$(this).html('');\n//\t\t\tfor (var i = 0; i < outData.length; i++) {\n//\t\t\t\tvar code = outData[i].code\n//\t\t\t\tvar caption = outData[i].caption\n//\t\t\t\t$(this).append(\"<option value='\" + code + \"'>\" + caption + \"</option>\");\n//\t\t\t}\n//\t\t};\n\t\t\n\t\tthis.initData = function(leftData, rightData){\n\t\t\tthis.loadInitData(leftData, \"0\");\n\t\t\tthis.loadInitData(rightData, \"1\");\n\t\t\topts.initDataArray = jQuery.extend(true, [], opts.leftInitDataArray, opts.rightInitDataArray);\n\t\t\tif(this.such)this.such.init();\n\t\t}\n\t\t\n\t\tthis.initLeftForSword = function(leftData){\n\t\t\topts.leftDataName = leftData.name;\n\t\t\tvar data = this.convertSword2Normal(leftData);\n\t\t\tthis.loadInitData(data, \"0\");\n\t\t\topts.initDataArray = jQuery.extend(true, [], opts.initDataArray, opts.leftInitDataArray);\n\t\t};\n\t\t\n\t\tthis.initRightForSword = function(rightData){\n\t\t\topts.rightDataName = rightData.name;\n\t\t\tvar data = this.convertSword2Normal(rightData);\n\t\t\tthis.loadInitData(data, \"1\");\n\t\t\topts.initDataArray = jQuery.extend(true, [], opts.initDataArray, opts.rightInitDataArray);\n\t\t};\n\t\t\n\t\tthis.convertSword2Normal = function(swordData){\n\t\t\tvar normalData = [];\n\t\t\tif(swordData && swordData.trs){\n\t\t\t\tvar trs = swordData.trs;\n\t\t\t\tfor(var i=0; i<trs.length; i++){\n\t\t\t\t\tvar tds = trs[i].tds;\n\t\t\t\t\tif(tds){\n\t\t\t\t\t\tnormalData[i] = {};\n\t\t\t\t\t\t$.each(tds, function(key, value){\n\t\t\t\t\t\t\tif(value.value)\n\t\t\t\t\t\t\tnormalData[i][key] = value.value;\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn normalData;\n\t\t};\n\t\t\n\t\tthis.convertNormal2Sword = function(data, name){\n\t\t\tvar swordData = {};\n\t\t\tvar trs = [];\n\t\t\tfor(var i=0; i<data.length; i++){\n\t\t\t\tvar tds = {};\n\t\t\t\t$.each(data[i], function(key, value){\n\t\t\t\t\ttds[key] = {\"value\": value};\n\t\t\t\t});\n\t\t\t\ttrs[i] = {\"status\":null, \"tds\": tds};\n\t\t\t}\n\t\t\tswordData[\"trs\"] = trs;\n\t\t\tswordData[\"name\"] = name;\n\t\t\tswordData[\"sword\"] = \"SwordGrid\";\n\t\t\treturn swordData;\n\t\t};\n\t\t\n\t\t\n\t\t// 初始化数据\n\t\tthis.loadInitData = function(data,flag) {\n\t\t\tvar obj;\n\t\t\tif(flag == \"1\"){\n\t\t\t\t//right\n\t\t\t\tobj = $('#' + opts.rightSelId)\n\t\t\t}else{\n\t\t\t\t//left\n\t\t\t\tobj = $('#' + opts.leftSelId)\n\t\t\t}\n\t\t\tobj.html('');\n\t\t\tif (data != null) {\n\t\t\t\tvar codeName = \"code\";\n\t\t\t\tvar captionName = \"caption\";\n\t\t\t\tif(flag == \"1\"){\n\t\t\t\t\t//right\n\t\t\t\t\tcodeName = opts.rightCodeName;\n\t\t\t\t\tcaptionName = opts.rightShowName;\n\t\t\t\t\topts.rightInitDataArray = jQuery.extend(true, [], data);\n\t\t\t\t}else{\n\t\t\t\t\t//left\n\t\t\t\t\tcodeName = opts.leftCodeName;\n\t\t\t\t\tcaptionName = opts.leftShowName;\n\t\t\t\t\topts.leftInitDataArray = jQuery.extend(true, [], data);\n\t\t\t\t};\n\t\t\t\tfor (var i = 0; i < data.length; i++) {\n\t\t\t\t\tvar code = data[i][codeName]\n\t\t\t\t\tvar caption = data[i][captionName]\n\t\t\t\t\tobj.append(\"<option value='\" + code + \"'>\" + caption + \"</option>\");\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t\t\n\n\t\tvar $this = $(this);\n\t\tthis.such = $this.multiselect(opts);\n\t\t\n\n//\t\t// 获取选中值\n//\t\tthis.getValue = function() {\n//\t\t\treturn select.val();\n//\t\t};\n\t\t\n\t\tthis.getLeftInsertData = function(){\n\t\t\treturn this.getInsertData(\"0\");\n\t\t};\n\t\t\n\t\tthis.getRightInsertData = function(){\n\t\t\treturn this.getInsertData(\"1\");\n\t\t};\n\n\t\t// 获取插入数据\n\t\tthis.getInsertData = function(flag) {\n\t\t\tvar result = this.getData(flag);\n\t\t\tvar origData;\n\t\t\tif(flag == \"1\"){\n\t\t\t\torigData = opts.rightInitDataArray;//right\n\t\t\t}else{\n\t\t\t\torigData = opts.leftInitDataArray;//left\n\t\t\t};\n\t\t\tfor (var i = 0; i < origData.length; i++) {\n\t\t\t\t$.each(result, function(index,item){  \n\t\t\t\t\tif(item.code == origData[i].code && item.caption == origData[i].caption){\n\t\t\t\t\t\tresult.splice(index,1);\n\t\t\t\t\t\treturn false;\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\t\t\treturn result;\n\t\t};\n\t\t\n\t\tthis.getLeftDeleteData = function(){\n\t\t\treturn this.getDeleteData(\"0\");\n\t\t};\n\t\t\n\t\tthis.getRightDeleteData = function(){\n\t\t\treturn this.getDeleteData(\"1\");\n\t\t};\n\n\t\t//获取删除数据\n\t\tthis.getDeleteData = function(flag) {\n\t\t\tvar result = this.getInitData(flag);\n\t\t\tvar id = (flag == \"1\") ? opts.rightSelId : opts.leftSelId;\n\t\t\tvar nodes = $('#' + id).find(\"option\");\n\t\t\tfor (var i = 0; i < nodes.length; i++) {\n\t\t\t\t$.each(result, function(index,item){  \n\t\t\t\t\tif(nodes[i].value == item.code && nodes[i].innerHTML == item.caption){\n\t\t\t\t\t\tresult.splice(index,1);\n\t\t            \treturn false;\n\t\t        \t}\n\t\t\t\t});\n\t\t\t}\n\t\t\treturn result;\n\t\t}\n\t\t\n\t\t//获取初始数据\n\t\tthis.getInitData = function(flag){\n\t\t\tvar initData;\n\t\t\tif(flag == \"1\"){\n\t\t\t\tinitData = jQuery.extend(true,[], opts.rightInitDataArray);//right\n\t\t\t}else{\n\t\t\t\tinitData = jQuery.extend(true,[], opts.leftInitDataArray);//left\n\t\t\t};\n\t\t\treturn initData;\n\t\t}\n\t\t\n\t\tthis.getLeftData = function(){\n\t\t\treturn this.getData(\"0\");\n\t\t};\n\t\t\n\t\tthis.getRightData = function(){\n\t\t\treturn this.getData(\"1\");\n\t\t};\n\t\t\n\t\tthis.getLeftSubmitData = function(){\n\t\t\treturn this.convertNormal2Sword(this.getLeftData(), opts.leftDataName);\n\t\t};\n\n\t\tthis.getRightSubmitData = function(){\n\t\t\treturn this.convertNormal2Sword(this.getRightData(), opts.rightDataName);\n\t\t};\n\t\t\n\t\t//获取当前数据\n\t\tthis.getData = function(flag){\n\t\t\tvar id = (flag == \"1\") ? opts.rightSelId : opts.leftSelId;\n\t\t\tvar codeName = (flag == \"1\") ? opts.rightCodeName : opts.leftCodeName;\n\t\t\tvar captionName = (flag == \"1\") ? opts.rightShowName : opts.leftShowName;\n\t\t\tvar nodes = $('#' + id).find(\"option\");\n\t\t\tvar currentData = [];\n\t\t\tvar idx = 0;\n\t\t\t$.each(nodes, function(i,item){ \n\t\t\t\tvar el = {};\n\t\t\t\tel[codeName] = item.value;\n\t\t\t\tel[captionName] = item.innerHTML;\n\t\t\t\tcurrentData[idx++] = el;\n//\t\t\t\t$.each(opts.initDataArray, function(j,el){\n//\t\t\t\t\tif(item.value == el[codeName] && item.innerHTML == el[captionName]){\n//\t\t\t\t\t\tcurrentData[idx++] = el;\n//\t\t\t\t\t\treturn false;//break\n//\t\t        \t}\n//\t\t\t\t});\n\t\t\t});\n\t\t\treturn currentData;\n\t\t}\n\t\t/*\n\t\t *  暂不提供 \n\t\t this.insertValue = function(newValue) {\n\t\t\tif (newValue != null) {\n\t\t\t\tvar a = $(this).find(\"option[value=\" + newValue.code + \"]\").remove();\n\t\t\t\t$(this).append(\"<option value='\" + newValue.code + \"'>\" + newValue.caption + \"</option>\");\n\t\t\t}\n\t\t}*/\n\t\t\n//\t\topts.leftInitDataArray = jQuery.extend(true, [], this.getData(\"0\"));\n//\t\topts.rightInitDataArray = jQuery.extend(true, [], this.getData(\"1\"));\n\t\t\n\n\t\treturn this;\n\t};\n\t\n\t// 默认设置\n\t$.fn.wingsMove.defaults = {\n\t\tleftAll : 'leftAll',\n\t\trightAll : 'rightAll',\n\t\tleftSelected : 'leftSelected',\n\t\trightSelected : 'rightSelected',\n\t\tundo : 'undo',\n\t\tredo : 'redo',\n\t\tleftCodeName : 'code',\n\t\tleftShowName : 'caption',\n\t\trightCodeName : 'code',\n\t\trightShowName : 'caption',\n\t\tleftDataName : '',\n\t\trightDataName : '',\n\t\tdata : null,\n\t\tleftInitDataArray: [],\n\t\trightInitDataArray: [],\n\t\tinitDataArray: [],\n\t\tkeepRenderingSort: true\n\t};\n})(window.jQuery);"
