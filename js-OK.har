            "text": "\nfunction initSuccess(){\n\n    \n}\n\nfunction onLtidBefore_fn(params){\n\t\tparams.lei123456 = \"mmo12345\";\n\t\tparams.test007 = \"lei007\";\n\t}\n\n\nfunction sugDisable(){\n\tvar sug = $.wingsWidget('leiSuggest');\n\t//获取值\n//\talert(sug.getValue());\n\t//设置值\n//\tsug.setValue(\"lei\");\n\t//设置无效\n\tsug.disable();\n}\n\nfunction sugEnable(){\n\tvar sug = $.wingsWidget('leiSuggest');\n\t//设置有效\n\tsug.enable();\n}\n\nfunction sugShow(){\n\tvar sug = $.wingsWidget('leiSuggest');\n\t//展开\n\tsug.show();\n}\n\nfunction sugHide(){\n\tvar sug = $.wingsWidget('leiSuggest');\n\t//隐藏\n\tsug.hide();\n}\n\n"
