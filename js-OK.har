          "content": {
            "size": 7296,
            "mimeType": "text/css",
            "compression": 5199,
            "text": "@font-face{font-family:'FontAwesome';src:url('../../../include/font/fontawesome-webfont.eot?v=3.2.1');src:url('../../../include/font/fontawesome-webfont.eot?#iefix&v=3.2.1') format('embedded-opentype'),url('../../../include/font/fontawesome-webfont.woff?v=3.2.1') format('woff'),url('../../../include/font/fontawesome-webfont.ttf?v=3.2.1') format('truetype'),url('../../../include/font/fontawesome-webfont.svg#fontawesomeregular?v=3.2.1') format('svg');font-weight:normal;font-style:normal;}\n\n\n/* 鍘熸潵鐨勬牱寮�*/\n/*from bootstrap.css */\n\n.nav1 {\n  padding-left: 0;\n  margin-bottom: 0;\n  list-style: none;\n}\n.nav1 > li {\n  position: relative;\n  display: block;\n}\n.nav1 > li > a {\n  position: relative;\n  display: block;\n /* padding: 10px 15px;*/\n}\n.nav1 > li > a:hover,\n.nav1 > li > a:focus {\n  text-decoration: none;\n  /*background-color: #eee;*/\n}\n.nav1 > li > a > img {\n  max-width: none;\n}\n.nav1-tabs {\n  /*border-bottom: 1px solid #ddd;*/\n}\n.nav1-tabs > li {\n  float: left;\n  margin-bottom: -1px;\n}\n.nav1-tabs > li > a {\n  margin-right: 2px;\n  line-height: 1.42857143;\n  border: 1px solid transparent;\n  border-radius: 4px 4px 0 0;\n}\n.nav1-tabs > li > a:hover {\n/*  border-color: #eee #eee #ddd;*/\n}\n.nav1-tabs > li.active > a,\n.nav1-tabs > li.active > a:hover,\n.nav1-tabs > li.active > a:focus {\n  color: #555;\n  cursor: default;\n /*  background-color: #fff;\n border: 1px solid #ddd;\n  border-bottom-color: transparent;*/\n}\n\n\n/*from css.min.css */\n\n.nav1-tabs.background-blue {\n\theight:40px;\n\tbackground-color: #edeff2;\n\t/*border: 1px solid #c5d0dc*/\n}\n.nav1-tabs.tab-color-blue {\n\tborder-bottom-color: #c5d0dc\n}\n\n.nav1-tabs.tab-color-blue>li.active>a,\n.nav1-tabs.tab-color-blue>li.active>a:focus,\n.nav1-tabs.tab-color-blue>li.active>a:hover {\n\tcolor: #4c718a;\n\tborder-color: #7db4d8 #7db4d8 transparent\n}\n\n.panel-primary > .panel-heading{font-weight: bold;}\n\n\n\n.nav1-tabs {\n\tborder-color: #c5d0dc;\n\tmargin-bottom: 0;\n\tmargin-left: 0;\n\tposition: relative;\n\t/* top: 1px */\n}\n.nav-tabs>li{\n\tpadding-top: 6px;\n}\n\n.nav-tabs>li>a {\n\tpadding: 8px 12px\n}\n.nav-tabs>li>.tab-sm{\n\tpadding: 8px 3px;\n}\n.nav1-tabs>li{\n\t/*padding-top: 6px;*/\n}\n\n.nav1-tabs>li>a {\n\t/*padding: 8px 12px*/\n}\n.nav1-tabs>li>.tab-sm{padding: 7px 1px; /*width:21px;*/ }\n.nav1-tabs>li>a,\n.nav1-tabs>li>a:focus {/*padding-top:6px;*/\n    color: #1b6393;\n\tfloat:left;\n\tborder-radius: 0!important;\n\t/*background-color: #f9f9f9;\n\tcolor: #999;*/\n\tmargin-right: -1px;\n\tline-height: 16px;\n\tposition: relative;\n\tz-index: 11;\n\t\n\t/*border-color: #c5d0dc*/\n}\n\n.nav1-tabs>li>a:hover {\n\t/*background-color: #FFF;border-color: #c5d0dc\n\tcolor: #4c8fbd;*/\n\t\n}\n\n.nav1-tabs>li>a:active,\n.nav1-tabs>li>a:focus {\n\toutline: none!important\n}\n\n.nav1-tabs>li:first-child>a {\n\tmargin:3px 8px 3px 9px;\n}\n/*tab-goleft宸︿晶鏍囩*/\n.left{border-right:1px solid #fefefe; padding-right:1px;}\n.left:hover{background:#edeff2;}\n#tab-goright{border-right:1px solid #d0d0d0; width:28px;}\n.icon-chevron-right{background:url(../../plugins/wingsFrameTab/img/L-larrow.png) no-repeat 7px center; display:inline-block; width:24px; height:21px;}\n.icon-chevron-right:hover{ background: url(../../plugins/wingsFrameTab/img/L-larrow-hover.png) no-repeat 7px center;}\n/*tab-goright鍙充晶鏍囩*/\n.right{border-left:1px solid #d0d0d0;}\n.right:hover{background:#edeff2;}\n#tab-goleft{border-left:1px solid #fefefe; width:28px;}\n.icon-chevron-left{background:url(../../plugins/wingsFrameTab/img/R-rarrow.png) no-repeat 7px center; display:inline-block; width:24px; height:21px;}\n.icon-chevron-left:hover{ background: url(../../plugins/wingsFrameTab/img/R-rarrow-hover.png) no-repeat 7px center;}\n\n\n\n.nav1-tabs>li.active>a,\n.nav1-tabs>li.active>a:hover,\n.nav1-tabs>li.active>a:focus { font-size: 12px;  border:0;cursor:pointer;color: #fff; }\na.tab-sm.tabs-close {/* position: absolute; top: 3px;  right: -10px;*/ background:url(../../plugins/wingsFrameTab/img/shutS.png) no-repeat center top;}\n\n\n.nav1-tabs>.right{\n\tfloat:right;\n}\n\n/* 鍏朵粬鏍峰紡 */\n .l_col-md-3{\n  position: relative;\n  min-height: 1px;\n  padding-right:0;\n  padding-left:10px;\n}\n.l_col-md-9{\n  position: relative;\n  min-height: 1px;\n  padding-right:0;\n  padding-left:0;\n}\n .l_col-md-3, .l_col-md-9 {\n    float: left;\n  }\n  .l_col-md-9 {\n    width: 75%;\n  }\n  .l_col-md-3 {\n    width: 25%;\n  }\n\n  /*tab鏍忔牱寮�/\n a{display:inline-block;}\n.panel{ margin-bottom:0; border:0;}\n.a-panel-group{border:1px solid #e6e6e6;}\n.a-panel-group ul.menu{height:38px; padding:0; border-bottom:1px solid #e6e6e6; margin:0;}\n.a-panel-group ul.menu li{float:left;text-align:center;width:50%;height:30px;line-height:30px;list-style:none;font-size:14px;cursor:pointer; margin:4px 0 2px 0;}\n.a-panel-group ul.menu li.line{border-right:1px solid #e6e6e6;}\n.a-panel-group ul.menu li a{width:66px; height:30px;text-decoration:none; color:#999;}\n.a-panel-group ul.menu li a.cd{ background: url(../../plugins/wingsFrameTab/img/menu-hover.png) no-repeat left center;}\n.a-panel-group ul.menu li a.sc{ background: url(../../plugins/wingsFrameTab/img/collection.png) no-repeat left center;}\n.a-panel-group ul.menu li a:hover{color:#0098cb;}\n.a-panel-group ul.menu li a.cd:hover{background: url(../../plugins/wingsFrameTab/img/menu.png) no-repeat left center;}\n.a-panel-group ul.menu li a.sc:hover{ background: url(../../plugins/wingsFrameTab/img/collection-hover.png) no-repeat left center;}\n.a-panel-group ul.menu li.active{color:#fff;}\n/*h4鏍囩*/\n.panel-title .xm1{ padding-left:24px; display:inline-block; width:100%; text-decoration: none; height:39px; line-height:39px; font-size:12px; color:#fff; border-bottom:1px solid #e1e4e5; background:#0098cb url(../../plugins/wingsFrameTab/img/D-arrow.png) no-repeat 95% center;}\n/*.panel-title .collapsed {padding-left:24px; display:inline-block; width:100%; text-decoration: none; height:39px; line-height:39px; font-size:12px; color:#333; border-bottom:1px solid #e1e4e5; background: url(../../plugins/wingsFrameTab/img/L-arrow.png) no-repeat 95% center; }*/\na.xm1{ width:100%;text-decoration:none;padding-left:24px;}\n\n/*panel-body*/\n.panel-body{ margin:0; padding:12px 0 0 24px; border-bottom:1px solid #e6e6e6; background:#f5f9fa; color:#999;}\nli.active { background:#4393c7; /*padding:4px;*/}\nli.active a{/* padding-top:7px;*/}\n/*.tabs-close{position:absolute; top:5px; right:6px; background: url(../../plugins/wingsFrameTab/img/shutS.png) no-repeat 8px 4px;}*/\n\n\n/*鍙充晶鏍峰紡*/\n.tabs-close{\n\t\n\tposition:absolute;\n\tfont-size:1px;\n\tdisplay:block;\n\tpadding:0px;\n\twidth:11px;\n\theight:11px;\n\ttop:3px;\n\t\n\topacity:0.6;\n\tfilter:alpha(opacity=60);\n\tbackground:url('img/tabs_close.gif') no-repeat;\n}\n.tabLi{background: #8cbddd;\n    margin: 6px 5px 2px 5px;\n    height: 28px;\n    font-size: 12px;\n    color: #1b6393;}\n\t\n\t\n\t\n\t\n.tabLi .wings_frame_a{ display:inline-block; padding:6px 0 0 10px; float:left;}\n.tabLi .tabs-close{width:20px;}\n.container {width: 100%;}\n\n/*.tabs-close{ height:8px; margin:0; background:#0C6; width:20px; background: url(../../plugins/wingsFrameTab/img/shutS.png) no-repeat 8px 4px;}\n.tabs-close:hover{ border:0; background: url(../../plugins/wingsFrameTab/img/shutS.png) no-repeat 8px 4px;}*/\n\n.panel-group .panel + .panel{ margin:0;}\n\n.icon-remove{\n\tline-height:28px;right:3px; top:0; position:absolute;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
