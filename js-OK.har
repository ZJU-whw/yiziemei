            "mimeType": "text/css",
            "compression": 2254,
            "text": "\n::-webkit-scrollbar-track-piece {\n    background-color: rgba(255, 255, 255, 0);\n    -webkit-border-radius: 6px;\n}\n\n::-webkit-scrollbar {\n    width: 5px;\n    height: 5px;\n    border-radius: 5px;\n}\n\n::-webkit-scrollbar-thumb {\n    background-color: rgba(0, 0, 0, 0.25);\n    background-clip: padding-box;\n    min-height: 28px;\n    padding: 5px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n    background-color: rgba(0, 0, 0, 0.4);\n}\n\n::-webkit-scrollbar-thumb:vertical {\n\n    -webkit-border-radius: 6px;\n}\n\n::-webkit-scrollbar-thumb:horizontal {\n\n    -webkit-border-radius: 6px;\n}\n\nhtml, body {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    height: 100%;\n    min-width: 1200px;\n    overflow: auto;\n}\n\n.nsrxxList_content_dhcx {\n    background-color: rgb(255, 255, 255);\n    padding: 0px 20px;\n    margin: 20px 20px 10px;\n\n}\n\n.nsrxxList_content_dhcx > .img {\n    border: 0px solid rgb(63, 119, 219);\n    height: 65px;\n}\n\n.nsrxxList_content_dhcx div.qyxx_title {\n    height: 32px;\n    line-height: 32px;\n}\n\n.nsrxxList_content_dhcx div.qyxx_jbxx {\n    height: 33px;\n    line-height: 42px;\n}\n\n.nsrxxList_content_dhcx:hover {\n    background-color: #fff;\n}\n\n.tab-con {\n    overflow: hidden;\n}\n\n.tab-con > div:nth-child(1) {\n    width: 100%;\n    overflow-x: scroll;\n}\n\n#myTab {\n    width: 1320px;\n    min-width: 100%;\n    border-bottom: 2px solid #3f77db;\n}\n\n.nav > li > a {\n    line-height: 36px;\n    padding: 0px !important;\n    height: 36px !important;\n\n}\n\n#myTab li {\n    width: 120px;\n    text-align: center;\n    height: 36px;\n    line-height: 36px;\n    border-top-left-radius: 4px;\n    border-top-right-radius: 4px;\n    float: left;\n    display: inline-block;\n    padding: 0\n}\n\n#myTab li.active, #myTab li:hover {\n    background-color: #3f77db;\n}\n\n.nav-tabs > li.active > a, .nav-tabs > li.active > a:focus, .nav-tabs > li.active > a:hover {\n    color: #fff;\n}\n\n.nav-tabs > li:hover > a {\n    color: #fff;\n}\n\n.nav-tabs > li.active > a, .nav-tabs > li.active > a:hover, .nav-tabs > li.active > a:focus {\n    background-color: rgba(255, 255, 255, 0);\n    border: 0;\n}\n\n.nav-tabs > li:hover > a {\n    background-color: rgba(255, 255, 255, 0);\n    border: 0;\n}\n\n#gnxx ul li {\n    list-style: none;\n    float: left;\n    padding: 0 20px;\n    margin: 0;\n    height: 35px;\n    line-height: 35px;\n    border: 1px solid #3f77db;\n    border-radius: 20px;\n    margin-right: 5px;\n    margin-top: 10px;\n    color: #3f77db;\n}\n\n#gnxx ul li.active, #gnxx ul li:hover {\n    background-color: #3f77db;\n    color: #fff;\n    margin: 0px 10px 0px 0px;\n    margin-right: 5px;\n    margin-top: 10px;\n    border: 1px solid #3f77db;\n    padding: 0 20px;\n    height: 35px;\n    line-height: 35px;\n}\n\n#gnxxul {\n    /*margin-top: 10px;*/\n    height: 35px;\n}\n\n#myTabContent {\n    float: left;\n    border-bottom: 1px #fff solid;\n}\n\n.content_center {\n    padding: 0 !important;\n    margin: 0 !important;\n    width: calc(100% + 68px) !important;\n    margin-left: -26px !important;\n}\n\n.dhcx_dataTime {\n    position: absolute;\n    top: 10px;\n    height: 25px;\n    bottom: 20px;\n    right: 20px;\n    font-style: italic;\n    color: #3f77db;\n    font-size: 14px;\n}\n"
