dName) {\n    try {\n        _zdyGridFixedColumn.tableFixedColObj = $(\"div[name='{gridName}']\".substitute({gridName: gridName})).wingsTableFixedCol();\n        _zdyGridFixedColumn.tableFixedColObj.initFixedCols();\n    } catch (e) {\n        console.log(\"grid自定义冻结列处理异常：\" + e)\n    }\n}\n\n//页面缩放事件处理\nwindow.addEventListener('resize', function () {\n    if (_zdyGridFixedColumn.tableFixedColObj) {\n        _zdyGridFixedColumn.tableFixedColObj.initFixedCols();\n    }\n});\n\n/*********** grid自定义冻结列处理 - end ************/\n\n\n/*********** _zdyWingsGridFixedColumn自定义冻结列处理 - Start ************/\n\nvar _zdyWingsGridFixedColumn = {\n    tableFixedColObj: null, gridFixedTempData: {}, //跳转指定页面事件绑定\n    runToPageFun: function (gridName, n) {\n        //跳转指定页面事件绑定\n        $(\"#\" + gridName + '_pagingBar_info_runtopage').on(\"blur\", function () {\n            _zdyWingsGridFixedColumn.createFixedColsStyle(gridName, n);\n        }).on(\"keydown\", function (e) {\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                return false;\n            }\n        }).on(\"keydown\", function (e) {\n            if (!e) {\n                e = window.event;\n            }\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                $(this).blur();\n            }\n        });\n    }, //切换每页显示条数\n    changePageSize: function (gridName, n) {\n        $(\"#\" + gridName + \"_pagingBar_info_pageSize\").on(\"change\", function () {\n            _zdyWingsGridFixedColumn.createFixedColsStyle(gridName, n);\n        });\n    }, /**\n     * 绑定点击事件\n     * @param gridName\n     * @param selectorId\n     */\n    bindClick: function (gridName, selectorId, n) {\n        $(selectorId).each(function () {\n            $(this).bind(\"click\", function () {\n                var clickSj = $(this).context.className;//点击事件名称\n                _zdyWingsGridFixedColumn.createFixedColsStyle(gridName, n);\n            });\n        });\n    }, /**\n     * 构建固定列处理\n     * @param gridName\n     */\n    createFixedColsStyle: function (gridName, n) {\n        var left = 0;\n        for (var i = 1; i <= n; i++) {\n            var theadTrTh = $('table[id^=\"' + gridName + '_wingsGrid\"] thead tr:nth-child(' + i + ') th:nth-child(' + i + ')');\n            var theadTrTh2 = $('table[id^=\"' + gridName + '_wingsGrid\"] thead tr:nth-child(' + i + ') th');\n            theadTrTh.css({'z-index': '4'});\n            theadTrTh2.css({'position': 'sticky', 'top': '0', 'z-index': '2'});\n\n            var th = $('table[id^=\"' + gridName + '_wingsGrid\"] thead tr th:nth-child(' + i + ')');\n            var td = $('table[id^=\"' + gridName + '_wingsGrid\"] tbody tr td:nth-child(' + i + ')');\n            th.css({'position': 'sticky', 'left': left + 'px', 'z-index': '3'});\n            td.css({'position': 'sticky', 'left': left + 'px', 'z-index': '3', 'background-color': '#ffffff'});\n            left = left + th[0].offsetWidth;\n        }\n\n        $('table[id^=\"' + gridName + '_wingsGrid\"] thead th').css({'background-color': '#D7E8F7'});\n    }\n}\n\nfunction wingsGridFixedCols(value) {\n    try {\n\n        var a = value.split('-');\n        var gridName = a[0];\n        var n = Number(a[1]);\n\n        //首次进入\n        var a = _zdyWingsGridFixedColumn;\n        setTimeout(function () {\n            a.createFixedColsStyle(gridName, n);\n        }, 50);\n\n        //上一页、下一页、页码、选择每页条数加载\n        var _jtIds = [\"#\" + gridName + \"_pagingBar a.paginate_button.previous\", \"#\" + gridName + \"_pagingBar a.paginate_button.next\", \"#\" + gridName + \"_pagingBar_info_pageDetail\"];\n        for (var i = 0; i < _jtIds.length; i++) {\n            a.bindClick(gridName, _jtIds[i], n);\n        }\n\n        //每页显示数据条数切换\n        a.changePageSize(gridName, n);\n\n        //跳转指定页面事件处理\n        a.runToPageFun(gridName, n);\n\n        //页面缩放事件处理\n        window.addEventListener('resize', function () {\n            a.createFixedColsStyle(gridName, n);\n        });\n\n    } catch (e) {\n        console.log(\"wingsGridFixedCols自定义冻结列处理异常：\" + e)\n    }\n}\n\n/*********** _zdyWingsGridFixedColumn自定义冻结列处理 - end ************/\n\nvar _jgTrees = {};\n\n/**\n * 权限税务机关顶层数据初始化\n * @param baseData\n * @param treeName\n */\nfunction defQxSwjgTree(baseData, treeName) {\n    if (checkNull(baseData) && checkNull(baseData.qxSwjgTreeList) && checkJgTree(treeName)) {\n        var treeData = [];\n        try {\n            treeData = JSON.parse(baseData.qxSwjgTreeList);\n        } catch (e) {\n            //JSON格式数据解析错误，单引号替换为双引号\n            try {\n                treeData = JSON.parse(baseData.qxSwjgTreeList.replace(/'/g, '\"'));\n            } catch (e) {\n                treeData = [];\n            }\n        }\n\n        var jgTree = $.wingsWidget(treeName);\n        jgTree.initData({'data': treeData});\n        _jgTrees[treeName] = true;\n    }\n}\n\nfunction checkJgTree(tn) {\n    return checkNull(_jgTrees[tn]) ? _jgTrees[tn] != true : true;\n}\n\n/**\n * 机关树加载之前触发（可赋查询机关树值，得到指定机关树信息）\n * @param a\n * @param b\n */\nfunction onSwjgTreeLtidBefore(a, b) {\n    var levelCode = swjgLevelCode || '';\n    levelCode = levelCode == '0' ? '' : levelCode;\n    if (checkNull(b) && checkNull(levelCode)) {\n        if (b.code.indexOf(\"-\") > -1) {\n            b.code = b.code.split('-')[0];\n        } else {\n            b.code = b.code + '-' + levelCode;\n        }\n    }\n}\n\n"
