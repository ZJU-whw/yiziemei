            "text": "@CHARSET \"UTF-8\";\n\n.wingsfileupload {\n    position: relative;\n    display: inline-block;\n    background: #337ab7;\n    border: 1px solid #337ab7;\n    border-radius: 4px;\n    padding: 6px 12px 6px 12px;\n    color: #fff;\n    overflow: hidden;\n    text-decoration: none;\n    text-indent: 0;\n    /* line-height: 20px; */\n    *display: inline;\n    *zoom: 1;\n    top: 13px;\n}\n.wingsfileupload input {\n    position: absolute;\n    font-size: 20px;\n    right: 10px;\n    top: 0;\n    opacity: 0;\n    filter: alpha(opacity=0);\n    cursor: pointer;\n}\n.wingsfileupload:hover {\n    background: #204d74;\n    border-color: #204d74;\n    color: #fff;\n    text-decoration: none;\n}\n\n.wingsdownloadlink{\n\tpadding: 5px;\n\ttext-decoration:none;\n}\n.wingsdownloadlink:hover,.wingsdownloadlink:visited{\n\ttext-decoration:none;\n}\n\n.wingsdeletelink{\n\tpadding-right: 10px;\n    color: red;\n\ttext-decoration:none;\n}\n\n.wingsdeletelink:hover, .wingsdeletelink:focus .wingsdeletelink:visited{\n    color: #ff1c1c;\n\ttext-decoration:none;\n}"
