            "mimeType": "text/css",
            "compression": 3561,
            "text": "span.shut_down {\n    margin: 20px 10px 0px 10px;\n    background: url(/yxscx/theme/wings/wingsNewBlue/public/images/icon_select.png) no-repeat;\n    width: 20px;\n    height: 20px;\n    background-size: 16px 8px;\n    cursor: pointer;\n    display: inline-block;\n    float: right;\n    text-decoration: none;\n}\n\nspan.shut_up {\n    margin: 20px 10px 0px 10px;\n    background: url(/yxscx/theme/wings/wingsNewBlue/public/images/icon_select2.png) no-repeat;\n    width: 20px;\n    height: 20px;\n    background-size: 16px 8px;\n    cursor: pointer;\n    display: inline-block;\n    float: right;\n    text-decoration: none;\n}\n\n/*grid单位*/\n.part_dw {\n    float: right;\n    padding-right: 1%;\n}\n\n.panel-primary > .panel-heading {\n    color: #666;\n    background-color: #fff;\n    border-color: #499dff;\n    border: 0;\n    display: flex;\n    justify-content: flex-end;\n}\n\n/*grid单位*/\n\n/*复杂表头grid样式*/\ndiv[fzbtid] table.dataTable thead th {\n    background-color: rgba(63, 119, 219, 0.1);\n    border: 0;\n    font-size: 14px;\n    color: #656565;\n    font-weight: 500;\n    height: 36px;\n    border-bottom: 1px solid #ddd;\n    border-left: 1px solid #ddd;\n    font-weight: bold;\n\n    height: 36px;\n    font-size: 16px;\n    color: #666;\n    background-color: rgba(63, 119, 219, 0.1);\n    font-family: Microsoft YaHei;\n    font-weight: bold;\n    border: 1px solid #ffffff;\n}\n\n/*复杂表头grid样式*/\n\n\n.table_body::-webkit-scrollbar-thumb {\n    border-radius: 0.1rem;\n    /*background-color: #4fd9fc;*/\n    background-color: #C1C1C1;\n}\n\n.table_body::-webkit-scrollbar { /*婊氬姩鏉℃暣浣撴牱寮�*/\n    width: 6px; /*楂樺鍒嗗埆瀵瑰簲妯珫婊氬姩鏉＄殑灏哄*/\n    height: 6px;\n}\n\n.table_body::-webkit-scrollbar-thumb { /*婊氬姩鏉￠噷闈㈠皬鏂瑰潡*/\n    border-radius: 3px;\n    /*background: #5AD5F7;*/\n    background: #C1C1C1;\n}\n\n.table_body::-webkit-scrollbar-track { /*婊氬姩鏉￠噷闈㈣建閬�*/\n    border-radius: 3px;\n    background: none;\n}\n\n.dataTable th[class*=sorting_] {\n    font-weight: bold !important;\n}\n\n.diy-part {\n    margin-left: 26px;\n    margin-right: 26px;\n}\n\n.breadcrumb_nav1 > li:last-child > a,\n.breadcrumb_nav2 > li:last-child > a {\n    color: #fff;\n}\n\n.breadcrumb_nav1 li a:hover,\n.breadcrumb_nav2 li a:hover {\n    color: #3F77DB;\n    cursor: pointer;\n    color: #fff;\n}\n\nhtml, body {\n    /*\n    background: #f3f8ff;\n    */\n    /*background: linear-gradient(90deg, rgba(102, 125, 182, 1) 0%, rgba(102, 125, 182, 1) 0%, rgba(80, 123, 181, 1) 20%, rgba(0, 127, 195, 1) 39%, rgba(0, 126, 196, 1) 59%, rgba(21, 126, 192, 1) 72%, rgba(90, 122, 179, 1) 87%, rgba(102, 125, 181, 1) 100%, rgba(102, 125, 181, 1) 100%);*/\n}\n\n.navigation > span > a {\n    text-decoration: none;\n}\n\n.navigation > span > a:hover {\n    color: #3F77DB;\n}\n\n.modal-content .modal-header {\n    background: url(/yxscx/common/css/Eject_bg3.png) no-repeat 10px center;\n    background-size: 4px 24px;\n    padding-left: 16px;\n}\n\n.margin-top-26 {\n    margin-top: 26px;\n}\n\n/* 模态框的类样式 */\n/* tab页样式 */\n.two {\n    margin-left: 26px;\n    margin-right: 26px;\n}\n\n/* 解决按钮背景灰色，和没有边距问题*/\ndiv[data-target='footWingsToolBar'] {\n    padding: 16px 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #fff !important;\n}\n\ndiv[data-target='headWingsToolBar'] {\n    padding: 20px 30px;\n    background-color: #fff !important;\n}\n\n.wingsToolbar {\n    height: 100% !important;\n}\n\n/* 解决按钮背景灰色，和没有边距问题*/\n/* 提示框文字靠左问题 */\n.bootstrap-dialog .bootstrap-dialog-message {\n    text-align: center;\n}\n\n/* 提示框文字靠左问题 */\n\n/* 提示标题左边距问题*/\n.bootstrap-dialog .bootstrap-dialog-title {\n    color: #333;\n    padding-left: 5px;\n}\n\n/* 下拉框展示不全问题 */\n.wingsSelect-list-inner div {\n    min-height: 40px;\n    line-height: 40px;\n    color: #646464;\n    padding: 0 0 0 19px;\n    text-overflow: ellipsis;\n    overflow: hidden;\n    white-space: nowrap;\n}\n\n.zdyDialog-part {\n    height: 100%;\n}\n\n/* 关闭非查询条件右侧滚动条 */\n/*\nhtml, body {\n    height: calc(100% - 20px);\n}*/\n\n/* 自定义复杂表头样式 */\n.zdyfzbtHead table[role=\"grid\"] tbody th {\n    height: 36px;\n    font-size: 16px;\n    color: #666;\n    background-color: rgba(63, 119, 219, 0.1);\n    font-family: Microsoft YaHei;\n    font-weight: bold;\n}\n\n/* 复杂表头样式 */\n.zdyfzbtHead table tbody:first-child th {\n    border: 1px solid #ffffff;\n}\n\n/*滚动条整体样式 - 宽度*/\n.dataTables_wrapper > div > div::-webkit-scrollbar {\n    height: 7px;\n}\n\n/*滚动条整体样式 - 颜色*/\n.dataTables_wrapper > div > div::-webkit-scrollbar-thumb {\n    background-color: rgb(27 25 25 / 25%);\n}\n\ndiv[wings='WingsGrid'] {\n    padding: 10px 20px;\n}\n\ndiv[wings='WingsGrid'] .wingsDtTdRight {\n    text-align: right !important;\n    /* padding-right: 2% !important;*/\n}\n\n.zdyFixedHeadTh {\n    height: 36px;\n    font-size: 16px;\n    color: #666;\n    background-color: rgba(63, 119, 219, 0.1);\n    font-family: Microsoft YaHei;\n    font-weight: bold;\n}\n\n.tooltips {\n    position: absolute;\n    /*width: auto;*/\n    height: auto;\n    border-radius: 2px;\n    border: 1px solid red;\n    font-size: 12px;\n    z-index: 10000;\n    background-color: white;\n    box-shadow: 1px red;\n    /*overflow: auto;*/\n}\n\n.erroe_wings_sj {\n    border: 5px solid transparent;\n    border-top-color: red;\n    position: absolute;\n    left: 5px;\n    top: 28px;\n}"
