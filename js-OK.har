            "mimeType": "text/javascript",
            "compression": 18243,
            "text": "(function (global, $, factory) {\n    if (typeof module === \"object\" && typeof module.exports === \"object\") {\n        module.exports = global.document ?\n            factory(global, $, true) :\n            function (w, jq) {\n                if (!w.document || !jq) {\n                    throw new Error(\"CommonFormat  requires a window with a document,jQuery,wings\");\n                }\n                return factory(w, jq);\n            };\n    } else {\n        factory(global, $);\n    }\n\n// Pass this if window is not defined yet\n}(typeof window !== \"undefined\" ? window : this, typeof jQuery !== \"undefined\" ? jQuery : null, function (window, $, noGlobal) {\n\n    /*!(function ($, w) {\n    \"use strict\";*/\n    if (typeof $ === \"undefined\") {\n        throw new Error(\"CommonFormat  requires a window with a document,jQuery,wings\");\n    }\n\n    /* ------------------------------------------------------------------------- */\n    /*功能工具*/\n    /*var numFormat = {};*/\n    var commonFormat = {};\n    var number = commonFormat.number = {};\n    var cast = commonFormat.cast = {};\n    var check = commonFormat.check = {};\n    var calc = commonFormat.calc = {};\n    var page = commonFormat.page = {};\n    var format = commonFormat.format = {};\n    format.ndjdFormat = function (value) {\n        value = value +\"\";\n        if(value.length!=5){\n            return value;\n        }\n        var nd = value.substring(0,4);\n        var jd = value.substring(4);\n        return nd+'年'+jd+'季度';\n    }\n    //组装1季度、1-2季度、1-3季度\n    format.ndjd2Format = function (value) {\n        value = value +\"\";\n        var jdmach = {\"1\":\"1\",\"2\":\"1~2\",\"3\":\"1~3\",\"4\":\"1~4\"}\n        var nd = value.substring(0,4);\n        var jd = value.substring(4);\n        return nd+'年'+jdmach[jd]+'季度';\n    }\n    /** 获取亿位数，无小数*/\n    number.getIntYi = function getIntYi(yNum) {\n        var yi = 0;\n        var len = number.getNumLenNoDecimal(yNum);\n        if (len == 9 && yNum < 0) {\n            return 0;\n        }\n        if (len > 8) {\n            yi = cast.numToStr(yNum).substring(0, len - 8);\n        }\n        return yi;\n    }\n    /** 获取万位数 ，无小数*/\n    number.getIntWan = function getIntWan(wNum) {\n        var wan = 0;\n        var len = number.getNumLenNoDecimal(wNum);\n        if (len == 9 && wNum < 0) {\n            wan = cast.numjqz(cast.numToStr(wNum).substring(len - 9, len - 4));\n            return wan;\n        }\n        if (len > 4) {\n            wan = cast.numjqz(cast.numToStr(wNum).substring(len - 8, len - 4));\n        }\n        return wan;\n    }\n    /** 获取千位数，无小数*/\n    number.getIntThousand = function getIntThousand(tNum) {\n        var qi = 0;\n        var len = number.getNumLenNoDecimal(tNum);\n        if (len > 0) {\n            qi = cast.numjqz(cast.numToStr(tNum).substring(len - 4, len));\n        }\n        return qi;\n    }\n    /***100,2位小数，无单位*/\n    number.num2Percent = function (num) {\n        if (num == 0 || num == \"0\") {\n            return \"0\";\n        }\n        return Math.round(Number(num) * 10000)/100.00 ;// 小数点后两位百分比\n    }\n    /** parseInt返回整数 */\n    number.num2Int = function num2Int(num) {\n        if (checkValIsNull(num) || num == 0 || num == \"0\") {\n            return 0;\n        }\n        var newNum = Number(num);\n        return parseInt(newNum);\n    };\n    /** 返回一个保留n小数位的亿数 */\n    number.num2YiFiexd = function num2YiFiexd(num, fixNum) {\n        var newNum = Number(num);\n        return (newNum / 100000000).toFixed(fixNum);\n    };\n    /** 返回一个亿数 2位小数*/\n    number.num2Yi = function (num) {\n        var newNum = Number(num);\n        return (newNum / 100000000).toFixed(2);\n    };\n    /** n返回一个万数,2(n)位小数*/\n    number.num2WanFixed = function num2WanFixed(num, num2) {\n        if (checkValIsNull(num) || num == 0 || num == \"0\") {\n            return 0;\n        }\n        var newNum = Number(num);\n        return (newNum / 10000).toFixed(num2);\n    };\n    /** 返回一个万数,2位小数 根据初始化参数-机关层级*/\n    number.num2Wan = function num2Wan(num) {\n        if (checkValIsNull(num)) {\n            return 0;\n        }\n        //市局以下默认为户、元\n        /*if (__.PageVariable.currentJgcj >= 3) {\n            return num;\n        }*/\n        var newNum = Number(num);\n        return (newNum / 10000).toFixed(2);\n    };\n\n    /** 获取整型数字长度（去除小数点后的长度）*/\n    number.getNumLenNoDecimal = function getNumLenNoDecimal(num) {\n        var numStr = cast.numToStr(num);\n        var intLen = 0;\n        if (\"-1\" == numStr.indexOf(\".\")) {\n            intLen = numStr.length;\n        } else {\n            intLen = numStr.lastIndexOf(\".\");\n        }\n        return intLen;\n    }\n\n    /*** 按千分位格式化数字* @param number* @param options* @return {string}*/\n    number.formatNumberWithQFW = function formatNumberWithQFW(number, options) {\n        options = $.extend({\n            split_length: SPLIT_CONSTANTS.QFW.SPLIT_LENGTH\n        }, options);\n        return formatNumber(number, options);\n    }\n    /*** 按千分位格式化数字,带小数 * @param number* @param options* @return {string}*/\n    number.formatNumberWithQFWFloat = function formatNumberWithQFWFloat(num) {\n        var value = number.formatNumberWithQFW(num, {contain_decimal: true});\n        value = cast.removeDecimalZero(value);\n        return value;\n    }\n\n    /** 保留两位小数*/\n    number.formatNumberwith2 = function formatNumberwith2(num,precision) {\n        if (checkValIsNull(num)) {\n            return 0;\n        }\n        var newNum = Number(num);\n        precision = precision || SPLIT_CONSTANTS.DEFAULT_RESERVE_PRECISION;\n        return newNum.toFixed(precision);\n    }\n\n    /** 去掉小数点最后面的0,如为0.00则连小数点去掉*/\n    cast.removeDecimalZero = function removeDecimalZero(num) {\n        if (typeof num == 'undefined') {\n            return 0;\n        }\n        num = (num + \"\").replace(/(\\.\\d*?)0*$/, '$1').replace(/(\\d+?)\\.$/, '$1');\n        return num;\n    }\n    /** 数了小数位按长度补0*/\n    cast.numAdd0 = function numAdd0(num, length) {\n        if (checkValIsNull(num)) {\n            return 0;\n        }\n        length = length || 2;\n        var f = Number(num);\n        // var f = Math.round(x * 100) / 100;\n        var s = f.toString();\n        var rs = s.indexOf(\".\");\n        if (rs < 0) {\n            rs = s.length;\n            s += \".\";\n        }\n        while (s.length <= rs + length) {\n            s += \"0\";\n        }\n        return s;\n    };\n    /** 获取一个数字字符串*/\n    cast.numToStr = function numToStr(num) {\n        return num + \"\";\n    }\n    /** 数字去零*/\n    cast.numjqz = function numjqz(num) {\n        var str = num;\n        var j = 0;\n        if (str.substring(0, 1) == \"0\") {\n            for (var i = 1; i < str.length; i++) {\n                var n = str.substring(i, i + 1);\n                if (n != \"0\") {\n                    j = i;\n                    break;\n                }\n            }\n            if (j < str.length) {\n                str = str.substring(j, str.length);\n            } else {\n                str = \"\";\n            }\n        }\n        if (str.substring(0, 1) == \".\") {\n            str = \"0\" + str;\n        }\n        return str;\n    }\n    /** 返回整数 不为数字返回默认值 0*/\n    cast.getIntValue = function getIntValue(value, defValue) {\n        if (!$chk(defValue)) {\n            defValue = 0;\n        }\n        return isNaN(parseInt(value)) ? defValue : parseInt(value);\n    }\n    /** 返回浮点数 不为数字返回默认值 0*/\n    cast.getFloatValue = function getFloatValue(value, defValue) {\n        if (!$chk(defValue)) {\n            defValue = 0;\n        }\n        return isNaN(parseFloat(value)) ? defValue : parseFloat(value);\n    }\n\n\n    /** 正则判断是否为数字校验只要是数字（包含正负整数，0以及正负浮点数）就返回true!(typeof value === 'number' && !isNaN(value)); */\n    check.isNumberReg = function isNumberReg(val) {\n        var regPos = /^\\d+(\\.\\d+)?$/; //非负浮点数\n        var regNeg = /^(-(([0-9]+\\.[0-9]*[1-9][0-9]*)|([0-9]*[1-9][0-9]*\\.[0-9]+)|([0-9]*[1-9][0-9]*)))$/; //负浮点数\n        if (regPos.test(val) && regNeg.test(val)) {\n            return true;\n        } else {\n            return false;\n        }\n\n    }\n    /** 是否为数字*/\n    check.isNumber = function isNumber(value) {\n        return !isNaN(parseInt(value, 10));\n    }\n    check.isNull = function isNull(obj) {\n        // if (typeOf(x) == \"undefined\")\n        // if (typeOf(x) != \"object\")\n        // if(!x) || !$chk(obj) || (typeOf(obj) == \"undefined\")\n        if(null === obj || \"\" === obj || !$chk(obj) || !obj ){\n            return true;\n        }\n        return false;\n    }\n    /* */\n    check.isNullObj =  function isNullObj(obj) {\n        // if (typeOf(x) == \"undefined\")\n        // if (typeOf(x) != \"object\")\n        // if(!x) !$chk(obj) || (typeOf(obj) == \"undefined\") || !obj || (typeOf(obj)\n        // != \"object\")\n        if(null === obj || !$chk(obj) ){\n            return true;\n        }\n        return false;\n    }\n\n    /** 求占比值，不*100，保留2位小数， 分母为0时返回默认值 */\n    calc.ratioDecimal2 = function (fz, fm, defValue) {\n        if (!$chk(defValue)) {\n            defValue = 0;\n        }\n        if (fm == 0) {\n            return defValue\n        } else {\n            return Math.round(fz / fm * 100) / 100;\n        }\n    }\n    /** 求百分比数值*100, 保留2位小数， 分母为0时返回默认值 */\n    calc.percentageDecimal2 = function (fz, fm, defValue) {\n        if (!$chk(defValue)) {\n            defValue = 0;\n        }\n        fz = cast.getFloatValue(fz)\n        fm = cast.getFloatValue(fm)\n        if (fm == 0) {\n            return defValue\n        } else {\n            return Math.round(fz / fm * 10000) / 100;\n        }\n    }\n    /** 求百分比数值*100, 同比计算 保留2位小数， 分母为0时返回默认值 */\n    calc.percentageDecimal2_Tb = function (bq, sq, defValue) {\n        if (!$chk(defValue)) {\n            defValue = 0;\n        }\n        bq = cast.getFloatValue(bq)\n        sq = cast.getFloatValue(sq)\n        if (sq == 0) {\n            return defValue\n        } else {\n            return Math.round((bq - sq) / sq * 10000) / 100;\n        }\n    }\n\n    /** 求值的N次方*/\n    calc.valeu2power = function (value,k) {\n        if (!$chk(value)) {\n            value = 0;\n        }\n        if(!$chk(k)){\n            k = 1/3;\n        }\n        value = cast.getFloatValue(value);\n        var b = Math.pow((1+value),k)-1;\n        return b;\n    }\n\n    /** 计算占比*100,2位小数，带单位% */\n    calc.toPercentUnit = function (num, total) {\n        if (total == 0 || total == \"0\") {\n            return \"0%\";\n        }\n        return Math.round(Number(num) / Number(total) * 10000) / 100.00 + \"%\";// 小数点后两位百分比\n    }\n    /**计算占比*100,2位小数，带单位% ，+ total为0时，显示100%*/\n    calc.toPercentUnit2 = function (num, total) {\n        if (num == 0 || num == \"0\") {\n            return \"0%\";\n        }\n        if (total == 0 || total == \"0\") {\n            return \"100%\";\n        }\n        return Math.round(Number(num) / Number(total) * 10000) / 100.00 + \"%\";// 小数点后两位百分比\n    }\n    /**计算占比*100,2位小数，无单位*/\n    calc.toPercent = function (num, total) {\n        if (total == 0 || total == \"0\") {\n            return \"0%\";\n        }\n        return Math.round(Number(num) / Number(total) * 100) + \"%\";// 小数点后两位百分比\n    }\n\n    /**计算占比*100,2位小数，无单位, + total为0时，显示100*/\n    calc.toPercent2 = function toPercent(num, total) {\n        if (num == 0 || num == \"0\") {\n            return 0;\n        }\n        if (total == 0 || total == \"0\") {\n            return 100;\n        }\n        return Math.round(Number(num) / Number(total) * 10000) / 100.00;// 小数点后两位百分比\n    },\n\n        calc.toPercentWithZero = function toPercent(num, total) {\n            if(!checkNull(num) || !checkNull(total)){\n                return 0;\n            }\n            if (num == 0 || num == \"0\") {\n                return 0;\n            }\n            if (total == 0 || total == \"0\") {\n                return 100;\n            }\n            return Math.round(Number(num) / Number(total) * 10000) / 100.00;// 小数点后两位百分比\n        },\n        /**计算占比*100,1位小数，无单位, + total为0时，显示100*/\n        calc.toPercent2Fixed1 = function (num, total) {\n            if (num == 0 || num == \"0\") {\n                return 0;\n            }\n            if (total == 0 || total == \"0\") {\n                return 100;\n            }\n            return Math.round(Number(num) / Number(total) * 1000) / 10.0;// 小数点后两位百分比\n        }\n\n    /**\n     * obj转百分比（四舍五入）  有小数，有单位，空显示0\n     * @param obj\n     * @param precision 精度（保留几位小数，默认为2）\n     * @returns {*}\n     */\n    calc.obj2percentDecimalUnit = function (obj, precision) {\n        if (obj) {\n            try {\n                if (isNaN(obj)) {\n                    return \"0.00%\";\n                }\n                var num = Number(obj);\n                if (checkValIsNull(precision)) {\n                    precision = 2;\n                }\n                var temp = (num * 100).toFixed(precision);\n                return temp + \"%\";\n            } catch (e) {\n                return \"0.00%\";\n            }\n        } else {\n            return \"0.00%\";\n        }\n    }\n    /**\n     * obj转百分比（四舍五入） 无小数，有单位，空显示0\n     * @param obj\n     * @returns {*}\n     */\n    calc.obj2percentUnit = function (obj) {\n        if (obj) {\n            try {\n                if (isNaN(obj)) {\n                    return \"0%\";\n                }\n                var num = Number(obj);\n                var temp = Math.round(num * 100);\n                return temp + \"%\";\n            } catch (e) {\n                return \"0%\";\n            }\n        } else {\n            return \"0%\";\n        }\n    }\n    /**\n     * obj转百分比（四舍五入） 2位小数，无单位，空显示0\n     * @param obj\n     * @returns {*}\n     */\n    calc.obj2percentDecimal2 = function (obj) {\n        if (obj) {\n            try {\n                if (isNaN(obj)) {\n                    return \"0.00\";\n                }\n                var num = Number(obj);\n                var temp = (Math.round(num * 10000) / 100).toFixed(2);\n                return temp + \"\";\n            } catch (e) {\n                return \"0.00\";\n            }\n        } else {\n            return \"0.00\";\n        }\n    }\n    /**\n     * obj转整数字（四舍五入）  0位小数，无单位，空显示-\n     * @param obj\n     * @returns {*}\n     */\n    calc.obj2percent = function (obj) {\n        if (obj) {\n            try {\n                if (isNaN(obj)) {\n                    return \"0\";\n                }\n                var num = Number(obj);\n                var temp = Math.round(num);\n                return temp + \"\";\n            } catch (e) {\n                return \"0\";\n            }\n        } else {\n            return \"0\";\n        }\n    }\n    /**\n     * 除法\n     * @param divided 除数\n     * @param dividend 被除数\n     */\n    calc.divide = function (divided, dividend) {\n        if (divided == 0 || divided == \"0\") {\n            return 0;\n        }\n        if (dividend == 0 || dividend == \"0\") {\n            return \"-\";\n        }\n        return Number(divided) / Number(dividend);\n    }\n\n    /*cast function*/\n\n    /**\n     *添加换行符\n     * @param provideNumber //一行几个字\n     * @param params 字符串\n     * @returns {String}\n     */\n    cast.addEnter = function (provideNumber, params) {\n        var newParamsName = \"\";\n        var paramsNameNumber = params.length;\n        var rowNumber = Math.ceil(paramsNameNumber / provideNumber);\n        if (paramsNameNumber > provideNumber) {\n            for (var p = 0; p < rowNumber; p++) {\n                var tempStr = \"\";\n                var start = p * provideNumber;\n                var end = start + provideNumber;\n                if (p == rowNumber - 1) {\n                    tempStr = params.substring(start, paramsNameNumber);\n                } else {\n                    tempStr = params.substring(start, end) + \"\\n\";\n                }\n                newParamsName += tempStr;\n            }\n\n        } else {\n            newParamsName = params;\n        }\n        return newParamsName\n    }\n\n    /** 数组转万元 @param numArr @returns {Array}*/\n    cast.arrayToWan = function (numArr) {\n        var wanArr = [];\n        for (var i = 0; i < numArr.length; i++) {\n            var num = numArr[i];\n            wanArr.push(number.num2Wan(num));\n        }\n        return wanArr;\n    }\n    /** 数组转亿元@param numArr@returns {Array}*/\n    cast.arrayToYi = function (numArr) {\n        var wanArr = [];\n        for (var i = 0; i < numArr.length; i++) {\n            var num = numArr[i];\n            wanArr.push(number.num2Yi(num));\n        }\n        return wanArr;\n    }\n\n\n    /*-------------------------------内部方法------------------------------------------*/\n    /**\n     * 判断判空是否为空,true 为空，false不为空\n     * @param value value\n     * @returns {Boolean}\n     */\n    function checkValIsNull(value) {\n        if (typeof (value) == undefined || value == \"undefined\" || value == undefined) {\n            return true;\n        }\n        if (value == null || value == \"\" || value == \"null\") {\n            return true;\n        }\n        if (value == {} || value == [] || value == \"{}\" || value == \"[]\" || value == \"[{}]\") {\n            return true;\n        }\n        return false;\n    }\n\n    /**\n     * 拆分数字常量定义\n     * @type {{QFW: {ZH_UNIT: string[], SPLIT_LENGTH: number}, DEFAULT_RESERVE_PRECISION: number, WFW: {ZH_UNIT: string[], SPLIT_LENGTH: number}}}\n     */\n    var SPLIT_CONSTANTS = {\n        /**\n         * 千分位\n         * @property SPLIT_LENGTH 拆分长度：3\n         * @property ZH_UNIT 中文单位\n         */\n        QFW: {SPLIT_LENGTH: 3, ZH_UNIT: [\"元\"]},\n        /**\n         * 万分位\n         * @property SPLIT_LENGTH 拆分长度：4\n         * @property ZH_UNIT 中文单位\n         */\n        WFW: {SPLIT_LENGTH: 4, ZH_UNIT: [\"元\", \"万\", \"亿\", \"万亿\"]},\n        /**\n         * 默认小数保留精度\n         */\n        DEFAULT_RESERVE_PRECISION: 2\n    };\n\n    /**\n     * 检查number是否是数值或可转换为数值\n     * @param number\n     */\n    function checkNumeric(number) {\n        if (!number || isNaN(number)) {\n            return number;\n        }\n    }\n\n    /**\n     * 拆分数值，以字符串形式保留原值，不清除最高位“0”\n     * @param number 数值\n     * @param dimension 整数部分拆分维度：3-千分位（默认）；4-万分位\n     * @param precision 小数部分保留精度：2（默认）\n     * @return {Object} {negative: true|false, integer_part: [由低位至高位存放], decimal_part: \"按精度格式化后的小数串\"}\n     * @example\n     *  splitNumber(-10100092.38) -> {negative: true, integer_part: [\"092\", \"100\", \"10\"], decimal_part: \"38\"}\n     *  splitNumber(3000000027.279, 3, 2) -> {negative: false, integer_part: [\"027\", \"000\", \"000\", \"3\"], decimal_part: \"28\"}\n     */\n    function splitNumber(number, dimension, precision) {\n        checkNumeric(number);\n        dimension = dimension || SPLIT_CONSTANTS.QFW.SPLIT_LENGTH;\n        precision = precision || SPLIT_CONSTANTS.DEFAULT_RESERVE_PRECISION;\n        var splitted = {negative: Number(number) < 0};\n        splitted.integer_part = splitIntegerPart(number, dimension);\n        splitted.decimal_part = splitDecimalPart(number, precision);\n        return splitted;\n    }\n\n    /**\n     * 拆分整数部分\n     * @param number 数值\n     * @param dimension 拆分维度：3-千分位（默认）；4-万分位\n     * @return {Array} 由低位至高位存放\n     */\n    function splitIntegerPart(number, dimension) {\n        checkNumeric(number);\n        var splitted = [];\n        dimension = dimension || SPLIT_CONSTANTS.QFW.SPLIT_LENGTH;\n        var src = Math.floor(Math.abs(Number(number))) + \"\";\n        while (src.length >= dimension) {\n            var tmp = src.substr(-dimension);\n            splitted.push(tmp);\n            src = src.substr(0, src.length - dimension);\n        }\n        if (src.length > 0) {\n            splitted.push(src);\n        }\n        return splitted;\n    }\n\n    /**\n     * 拆分小数部分\n     * @param number 数值\n     * @param precision 保留精度：2（默认）\n     * @return {string}\n     */\n    function splitDecimalPart(number, precision) {\n        checkNumeric(number);\n        precision = precision || SPLIT_CONSTANTS.DEFAULT_RESERVE_PRECISION;\n        var src = Number(number).toFixed(precision);\n        return src.substr(-precision);\n    }\n\n\n    /**\n     * 格式化数字\n     * @param number\n     * @param options\n     * @return {string}\n     */\n    function formatNumber(number, options) {\n        this.default_options = {\n            split_length: SPLIT_CONSTANTS.QFW.SPLIT_LENGTH,\n            separator: \",\",\n            negative_symbol: \"-\",\n            contain_decimal: false,\n            use_unit: false\n        };\n\n        options = $.extend(this.default_options, options || {});\n        if (options.split_length !== SPLIT_CONSTANTS.QFW.SPLIT_LENGTH && options.split_length !== SPLIT_CONSTANTS.WFW.SPLIT_LENGTH) {\n            throw new Error(\"金额类数字必须按照3位或4位进行拆分显示！\");\n        }\n\n        var splitted = splitNumber(number, options.split_length);\n\n        var format = splitted.integer_part.reverse().join(options.separator);\n        if (options.use_unit) {\n            switch (options.split_length) {\n                case SPLIT_CONSTANTS.QFW.SPLIT_LENGTH: {\n                    format += SPLIT_CONSTANTS.QFW.ZH_UNIT[0];\n                    break;\n                }\n                case SPLIT_CONSTANTS.WFW.SPLIT_LENGTH: {\n                    format = \"\";\n                    for (var i = splitted.integer_part.reverse().length - 1; i >= 0; i--) {\n                        format += Number(splitted.integer_part[i]) + (SPLIT_CONSTANTS.WFW.ZH_UNIT[i] || \"\");\n                    }\n                }\n            }\n        }\n        if (options.contain_decimal) {\n            format += \".\" + splitted.decimal_part;\n        }\n        if (splitted.negative) {\n            format = options.negative_symbol + format;\n        }\n\n        return