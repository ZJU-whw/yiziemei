            "text": "(function($) {\n\t$.fn.wingsTree = function(options) {\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsTree.defaults, options);\n\t\tif(opts.treeType==0){\n\t\t\t//默认树\n\t\t\topts.showCheck = false;\n\t\t}else if(opts.treeType==1){\n\t\t\t//单选树\n\t\t\topts.showCheck = true;\n\t\t\topts.single = true;\n\t\t}else if(opts.treeType==2){\n\t\t\t//多选树\n\t\t\topts.showCheck = true;\n\t\t\topts.single = false;\n\t\t}\n\t\t\n\t\t// 设置数据方法\n\t\tvar $treeThis = $(this);\n\t\t//获取div节点\n\t\tvar $tree = $treeThis[0].parentNode;\n\t\t\n\t\t\n\t\t$treeThis.setRule = function(rules){\n\t\t\topt.rules = rules;\n\t\t};\n\t\t//公共校验方法(传递必要参数即可)\n\t\t$treeThis.validObj = function(){\n  \t\t\t//调用校验规则\n\t\t\tif(opts.isNewValidate == \"true\" && opts.rules && opts.rules.length > 0){\n\t\t\t\treturn $.wingsValidate2.validObj(opts.v_id, opts.v_obj ,$treeThis.getValue() ,opts.rules);\n\t\t\t}\n\t\t}\n\t\t\n\t\t//为追加token值\n\t\tvar tempUrl = opts.url;\t\n\t\tif(tempUrl){\n\t\t\t//如果有值，才设置\n\t\t\tif (\"undefined\" != typeof $wings_url_tokenName_store && \"undefined\" != typeof store ){\n\t\t\t\t//从store中获得值，设置安全用的 token\n\t\t\t\tvar urlValue =  store.get($wings_url_tokenName_store);\n\t\t\t\tif(urlValue && urlValue != ''){\n\t\t\t\t\ttempUrl += \"&\"+ $wings_url_tokenName_store + \"=\" + urlValue;\n\t\t\t\t};\n\t\t\t};\n\t\t}\n\t\tvar viewText=\"\";\n\t\tvar setting = {\n\t\t\tasync : {\n\t\t\t\tenable : opts.async,\n\t\t\t\turl : tempUrl ,\n\t\t\t\ttype : 'post',\n\t\t\t\tdataType : 'json',\n\t\t\t\tautoParam : [ \"code\", \"caption\", \"level\" ],\n\t\t\t\tcontentType: opts.contentType,//处理中文乱码\n\t\t\t\totherParam : opts.params,\n\t\t\t\tdataFilter : function(treeId, parentNode, responseData) {\n\t\t\t\t\t//选中默认值\n\t\t\t\t\tif (responseData&&opts.checkedNodes&&opts.checkedNodes.length>0) {\n\t\t\t\t\t\tvar values = new Array() ;\n\t\t\t\t\t\tfor(var i=0;i<opts.checkedNodes.length;i++){\n\t\t\t\t\t\t\tvalues.push(opts.checkedNodes[i].code);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tvar cchecked = function(node){\n\t\t\t\t\t\t\tfor(var j=0;j<values.length;j++){\n\t\t\t\t\t\t\t\tif(node.code==values[j]){\n\t\t\t\t\t\t\t\t\tnode.checked = true;\n\t\t\t\t\t\t\t\t\tif(viewText==null){\n\t\t\t\t\t\t\t\t\t\tviewText = node.caption;\n\t\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\tviewText += ','+node.caption;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(node.children){\n\t\t\t\t\t\t\t\tfor(var i=0;i<node.children.length;i++){\n\t\t\t\t\t\t\t\t\tcchecked(node.children[i]);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor (var i = 0; i < responseData.length; i++) {\n\t\t\t\t\t\t\tcchecked(responseData[i]);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t//默认值选中\n\t\t\t\t\tif(opts.checkedNodes&&opts.checkedNodes.length>0){\n\t\t\t\t\t\tvar checkedNodeName=\"\" ,checkedNodeValue=\"\";\n\t\t\t\t\t\t$.each(opts.checkedNodes,function(index,checkedNode){\n\t\t\t\t\t\t\tcheckedNodeName += checkedNode.caption + \",\";\n\t\t\t\t\t\t\tcheckedNodeValue += checkedNode.code +\",\";\n\t\t\t\t\t\t});\n\t\t\t\t\t\tcheckedNodeName = checkedNodeName.substring(0,checkedNodeName.length-1);\n\t\t\t\t\t\tcheckedNodeValue = checkedNodeValue.substring(0,checkedNodeValue.length-1);\n\t\t\t\t\t\t\n\t\t\t\t\t\tif(checkedNodeName){\n\t\t\t\t\t\t\tviewSpan.html(checkedNodeName);\n\t\t\t\t\t\t}else if(viewSapn){\n\t\t\t\t\t\t\tviewSpan.html(viewText);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(inputHTML){\n\t\t\t\t\t\t\tinputHTML.val(checkedNodeValue);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\treturn responseData;\n\t\t\t\t}\n\t\t\t},\n\t\t\tcheck : {\n\t\t\t\tenable : opts.showCheck?opts.showCheck:false,\n\t\t\t\tchkStyle:opts.single?'radio':'checkbox',\n\t\t\t\tradioType : \"all\",\n\t\t\t\tchkboxType : {\n\t\t\t\t\t\"Y\" : \"ps\",\n\t\t\t\t\t\"N\" : \"ps\"\n\t\t\t\t}\n\t\t\t},\n\t\t\tview : {\n\t\t\t\tdblClickExpand : true,\n\t\t\t\taddDiyDom: function(treeId, treeNode){\n\t\t\t\t\t//设置回来的显示\n\t\t\t\t\tif(opts.menuTree == 'true'){\n\t\t\t\t\t\tvar spaceWidth = 10;\n\t\t\t\t\t\tvar switchObj = $(\"#\" + treeNode.tId + \"_switch\"),\n\t\t\t\t\t\ticoObj = $(\"#\" + treeNode.tId + \"_ico\");\n\t\t\t\t\t\t//去掉加号 减号\n\t\t\t\t\t\tswitchObj.remove();\n\t\t\t\t\t\ticoObj.before(switchObj);\n\t\t\t\t\t\t//编辑图标class\n\t\t\t\t\t\tvar spaceStr = \"<span style='display: inline-block;width:\" + (spaceWidth * treeNode.level)+ \"px'></span>\";\n\t\t\t\t\t\tswitchObj.before(spaceStr);\n\t\t\t\t\t}\n\t\t\t\t\t//机构选择树\n\t\t\t\t\tif(opts.isJgxzs == 'true'){\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t\tdata : {\n\t\t\t\tsimpleData : {\n\t\t\t\t\tenable : opts.simpleDataEnable?opts.simpleDataEnable:true,\n\t\t\t\t\tidKey :opts.idKey?opts.idKey:'id',\n\t\t\t\t\tpIdKey:opts.pIdKey?opts.pIdKey:'pid',\n\t\t\t\t\trootPId: opts.rootPId?opts.rootPId:null\n\t\t\t\t},\n\t\t\t\tkey:{\n\t\t\t\t\tname : opts.caption?opts.caption:'name'\n\t\t\t\t}\n\t\t\t},\n\t\t\tcallback : {\n\t\t\t\tbeforeClick : function(treeId, treeNode) {\n\t\t\t\t\t//追加只选节点 功能\n\t\t\t\t\tif(opts.isOnlyLeaf ==\"true\"){\n\t\t\t\t\t\tif(treeNode.isParent){\n\t\t\t\t\t\t\treturn false;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t\t\t\n\t\t\t\t\ttree.checkNode(treeNode, !treeNode.checked, null, true);\n\t\t\t\t\t\t       \t\n\t\t\t\t\t//点击父节点展开叶子节点\n\t\t\t\t\tif (treeNode.isParent && opts.autoExtendCaption ==\"true\") {\n\t\t\t\t\t\topts.tree.expandNode(treeNode, true, null, false, null);\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\t//叶子节点出发 点击事件\n\t\t\t       \tif(opts.onNodeClickFn ){\n\t\t\t\t\t\tfor (var b = 0; b < opts.onNodeClickFn.length; b++) {\n\t\t\t\t            var  func = eval(opts.onNodeClickFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(treeId, $wings_formatObjWtoS(treeNode));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t}\n\t\t\t\t\tif(opts.onClick){\n\t\t\t\t\t\topts.onClick(treeNode);\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\treturn true;\n\t\t\t\t},\n\t\t\t\tbeforeExpand : function(treeId, treeNode) {\n\t\t\t\t\t\n\t\t\t\t\t//展开时出发事件\n\t\t\t       \tif(opts.beforeExpandFn ){\n\t\t\t\t\t\tfor (var b = 0; b < opts.beforeExpandFn.length; b++) {\n\t\t\t\t            var  func = eval(opts.beforeExpandFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(treeId, $wings_formatObjWtoS(treeNode));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\treturn true;\n\t\t\t\t},\n\t\t\t\t\n\t\t\t\tbeforeCheck:function(treeId, treeNode){\n\t\t\t\t\tif(opts.onCheck){\n\t\t\t\t\t\topts.onCheck(treeNode);\n\t\t\t\t\t}\n\t\t\t\t\treturn true;\n\t\t\t\t},\n//\t\t\t\tonExpand:function(event, treeId, treeNode) {\n//\t\t\t\t\talert(treeId);\n//\t\t\t\t},\n//\t\t\t\tonCollapse:function(event, treeId, treeNode) {\n//\t\t\t\t\talert(treeId);\n//\t\t\t\t},\n\t\t\t\tonAsyncSuccess: function(event, treeId, treeNode, msg){\n\t\t\t\t\tif(treeNode){\n\t\t\t\t\t\tvar childrenNodes = treeNode.children;\n\t\t\t\t\t\tif(treeNode.children == \"\"){\n\t\t\t\t\t\t\t//处理没有子节点时 父节点变子节点\n\t\t\t\t\t\t\ttreeNode.isParent = false;\n\t\t\t\t\t\t\topts.tree.updateNode(treeNode);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t//默认展开一层\n\t\t\t\t\tif(opts.expand>1){\n\t\t\t\t\t\tvar asyncNodes = function(nodes) {\n\t\t\t\t\t\t\tif (!nodes) return;\n\t\t\t\t\t\t\tfor (var i=0, l=nodes.length; i<l; i++) {\n\t\t\t\t\t\t\t\tif (nodes[i].isParent && nodes[i].zAsync) {\n\t\t\t\t\t\t\t\t\t//asyncNodes(nodes[i].children);\n\t\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t\ttree.reAsyncChildNodes(nodes[i], \"refresh\", true);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\ttree.expandNode(nodes[i], true, null, false, null);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\t//回调\n\t\t\t\t\t\t\tif(!treeNode){//第0级\n\t\t\t\t\t\t\t\tvar nodes = tree.getNodes();\n\t\t\t\t\t\t\t\tasyncNodes(nodes);\n\t\t\t\t\t\t\t}else if(treeNode.level+2<opts.expand){\n\t\t\t\t\t\t\t\tvar nodes = tree.getNodesByParam('level',treeNode.level+1,treeNode);\n\t\t\t\t\t\t\t\tasyncNodes(nodes);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t//追加 调用后的成功方法\n\t\t\t       \tif(opts.onAfterLoadData ){\n\t\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onAfterLoadData);\n\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(treeNode);\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t       \t}\n\t\t\t\t\t\n\t\t\t\t},beforeCheck: function(treeId, treeNode){\n\t\t\t\t\t\n\t\t\t\t\t//追加只选节点 功能\n\t\t\t\t\tif(opts.isOnlyLeaf ==\"true\"){\n\t\t\t\t\t\tif(treeNode.isParent){\n\t\t\t\t\t\t\treturn false;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t       \tif(opts.onCheckBefore ){\n\t\t\t      var onCheckBeforeParam = [treeId,treeNode];\n\t\t\t      onCheckBeforeParam = onCheckBeforeParam.concat(opts.onCheckBeforeParam);\n\t\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onCheckBefore);\n\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = func.apply($treeThis,onCheckBeforeParam);\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t       \t}\n\t\t\t\t\t//如果是机关选择树,特殊处理 \n\t\t\t\t\tif(opts.isJgxzs == \"true\"){\n\t\t\t\t\t\t//是选中状态\n\t\t\t\t\t\tif(treeNode.checked == false){\n\t\t\t\t\t\t\t//清空所有上级父节点(递归)\n\t\t\t\t\t\t\tvar pNodeArr = [];\n\t\t\t\t\t\t\tif(treeNode.getParentNode()){\n\t\t\t\t\t\t\t\tpNodeArr = temp_getAllParent(pNodeArr,treeNode);\n\t\t\t\t\t\t\t\tfor(var i=0;i<pNodeArr.length;i++){\n\t\t\t\t\t\t\t\t\ttree.checkNode(pNodeArr[i],false,false,false);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t//清空所有下级子节点(递归)\n\t\t\t\t\t\t\tvar cNodeArr = [];\n\t\t\t\t\t\t\tif(treeNode.children){\n\t\t\t\t\t\t\t\tcNodeArr = temp_getAllChildren(cNodeArr,treeNode);\n\t\t\t\t\t\t\t\tfor(var i=0;i<cNodeArr.length;i++){\n\t\t\t\t\t\t\t\t\ttree.checkNode(cNodeArr[i],false,false,false);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t//机关选择树的选中事件(如果是选中状态，则额外返回被取消选中的父节点，和子节点)\n\t\t\t\t\t       \tif(opts.onJgxzsCheck ){\n\t\t\t\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onJgxzsCheck);\n\t\t\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t\t\t            \tvar result = new func(treeId, treeNode,pNodeArr,cNodeArr);\n\t\t\t\t\t\t\t       \t}\n\t\t\t\t\t\t\t    }\n\t\t\t\t\t       \t}\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t//机关选择树的选中事件（如果是取消状态，则不返回其他节点信息）\n\t\t\t\t\t       \tif(opts.onJgxzsCheck ){\n\t\t\t\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onJgxzsCheck);\n\t\t\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t\t\t            \tvar result = new func(treeId, treeNode);\n\t\t\t\t\t\t\t       \t}\n\t\t\t\t\t\t\t    }\n\t\t\t\t\t       \t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t},onRightClick: function(event,treeId, treeNode){\n\t\t\t\t\t//右键 添加menu\n\t\t\t       \tif(opts.onNodeContextMenu ){\n\t\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onNodeContextMenu);\n\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(event,treeId, treeNode);\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t       \t}\n\t\t\t\t},\n\t\t\t\tbeforeAsync: function(treeId, treeNode){\n\t\t\t       \tif(opts.onLtidBefore ){\n\t\t\t       \t\tvar tempFn =  wings_getFunc(opts.onLtidBefore);\n\t\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(opts.params,treeNode);\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t\tif(opts.tree){\n\t\t\t\t\t\t\topts.tree.setting.async.otherParam = opts.params;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t//如果是机关选择树\n\t\tif(opts.isJgxzs == \"true\"){\n\t\t\t//设置父子节点选中，没有关系\n\t\t\tsetting.check.chkboxType = {\n\t\t\t\t\t\t\"Y\" : \"\",\n\t\t\t\t\t\t\"N\" : \"\"\n\t\t\t\t\t}\n\t\t\t//版勾选状态设置为true\n\t\t\tsetting.check.enable = true;\n\t\t}\n\t\t//get所有子节点（递归）\n\t\tvar temp_getAllChildren = function (nodeArr,treeNode){\n\t\t\tif(!nodeArr){\n\t\t\t\tnodeArr = [];\n\t\t\t}\n\t\t\tif (treeNode.isParent){\n\t\t\t\t\tfor(var obj in treeNode.children){\n\t\t\t\t\t\tnodeArr.push(treeNode.children[obj]);\n\t\t\t\t\t\ttemp_getAllChildren(nodeArr,treeNode.children[obj]);\n\t\t\t\t\t}\n\t\t\t   }\n\t\t\treturn nodeArr;\n\t\t}\n\t\t//get所有父节点（递归）\n\t\tvar temp_getAllParent = function (nodeArr,treeNode){\n\t\t\tif(!nodeArr){\n\t\t\t\tnodeArr = [];\n\t\t\t}\n\t\t\tif (treeNode.getParentNode()){\n\t\t\t\tnodeArr.push(treeNode.getParentNode());\n\t\t\t\ttemp_getAllParent(nodeArr,treeNode.getParentNode());\n\t\t\t}\n\t\t\treturn nodeArr;\n\t\t}\n\n\t\t\n\t\tif(opts.params){\n\t\t\tvar params = [];\n\t\t\tfor(var k in opts.params){\n\t\t\t\tparams.push(k),\n\t\t\t\tparams.push(opts.params[k]);\n\t\t\t}\n\t\t\tsetting.async.otherParam = params;\n\t\t}\n\t\t//判断是否是input\n\t\tvar tagName = $treeThis[0].tagName;\n\t\tvar ele;\n\t\tif('INPUT'===tagName){\n\t\t\t//使用字符串替换代替attr方法，IE8不支持attr\n\t\t\tvar inputHTML = $($treeThis.prop(\"outerHTML\"));\n//\t\t\tvar input = $treeThis.prop(\"outerHTML\").replace(\"type=text\",\"type=hidden\");\n//\t\t\tinputHtml = $(input);\n\t\t\t\n\t\t\tif(!inputHTML.hasClass('col-xs-12')){\n\t\t\t\tinputHTML.addClass('col-xs-12');\n\t\t\t}\n\t\t\t/*var viewSpan = $('<span class=\"wtreeSpan\"></span>');\n\t\t\tvar viewDown = $('<a class=\"wtree_down\"></a>')\n\t\t\tvar inputDiv = $('<div class=\"input-group col-xs-12 no-padding-left no-padding-right wingsTreeInputClass\"></div');\n\t\t\tinputDiv.append(viewSpan);\n\t\t\tinputDiv.append(viewDown);\n\t\t\tinputDiv.append(inputHTML);*/\n\t\t\t\n\t\t\tvar viewSpan = $('<span class=\"col-xs-12 wtreeSpan\"></span>');\n\t\t\tvar viewDown = $('<a class=\"wtree_down\"></a>')\n\t\t\tvar inputDiv = $('<div class=\"input-group col-xs-12 no-padding-left no-padding-right wingsTreeInputClass\"></div>');\n\t\t\tinputDiv.append(viewSpan);\n\t\t\tinputDiv.append(viewDown);\n\t\t\tinputDiv.append(inputHTML);\n\t\t\t\n\t\t\t//追加placeholder \n\t\t\tif(opts.placeholder){\n\t\t\t\tviewSpan.html(opts.placeholder);\n\t\t\t}else if(\"undefined\" != typeof $wings_pulltree_select_placeholder ){\n\t\t\t\tviewSpan.html($wings_pulltree_select_placeholder);\n\t\t\t}\n\t\t\t\n\t  \t\t\t\t\t\t\t\n\t\t  \topts.showDivId = \"div_treeTemp_\" + opts.p_name+\"_\"+ opts.name + \"_\" + Math.floor(Math.random()*1000);\n\t\t\tvar treeDiv = $('<div class=\"wtreeDiv\" id=\"'+opts.showDivId+'\" style=\" position: absolute;\" tabindex=\"100\" ></div>');\n\t\t\tvar treeid = $treeThis.attr('id')+\"_treediv\" + \"_\" + Math.floor(Math.random()*1000);\n\t\t\tvar treeUl = $('<ul id=\"'+treeid+'\" class=\"ztree\" style=\"height:'+opts.height+'px;\" style=\"margin-top:0;\"></ul>')\n\t\t\ttreeDiv.append(treeUl);\n//\t\t\tinputDiv.append(treeDiv);\n\t\t\t$('body').append(treeDiv);\n\t\t\t\n\t\t\t//添加显示隐藏事件\n\t\t\t$('#'+opts.showDivId).on(\"mouseenter\",function(){\n\t\t\t\topts.leaveSign = true\n\t\t\t});\n\t\t\t$('#'+opts.showDivId).on(\"mouseleave\",function(){\n\t\t\t\topts.leaveSign = false\n\t\t\t});\n\t\t\t\n\t\t\t$('#'+opts.showDivId).on(\"blur\",function(){\n    \t\t\tif (!opts.leaveSign) {\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t\t$treeThis.validObj();\n\t\t\t\t\tif(opts.treeType==2){\n\t\t\t\t\t\thide();\n\t\t\t\t\t}\n\t\t\t\t}else{\n//\t\t\t\t\t$('#'+opts.showDivId).focus();\n\t\t\t\t\tsetTimeout(function(){$('#'+opts.showDivId).focus();},0);//兼容火狐\n\t\t\t\t}\n\t\t\t});\n\t\t\t\t\n\t\t\tvar toogleTreeDiv = function(e){  \n\t\t\t\t\n\t\t\t\tvar display = treeDiv.css('display')==='none';\n\t\t\t\tif(display){\n\t\t\t\t\t_treeShow(e);\n\t\t\t\t}else{\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t}\n\t\t\t}\n\t\t\tviewSpan.click(function(oEvent){\n\t\t\t\t//控制pulltree 是否可用\n\t\t\t\tif(opts.pullTreeAble != \"false\"){\n\t\t\t\t\ttoogleTreeDiv(oEvent);\n\t\t\t\t}\n\t\t\t});\n\t\t\tviewDown.click(function(oEvent){\n\t\t\t\teval(viewSpan.click())\n\t\t\t});\n\t\t\tvar hide=function(){\n\t\t\t\tif(opts.onHideBefore!=null){\n\t\t\t\t\tvar tempFn =  wings_getFunc(opts.onHideBefore);\n\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t            \tvar result = new func();\n\t\t\t\t       \t}\n\t\t\t\t    };\n\t\t\t\t}\n\t\t\t\t$treeThis.validObj();\n\t\t\t\tif(opts.treeType== 1){\n\t\t\t\t\ttreeDiv.hide();\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar _treeShow = function(e ,parem){\n\t\t\t\t\n//\t\t\t\tvar ev=ev?ev:event;  \n//  \t\t\t\tvar obj=ev.srcElement?ev.srcElement:ev.target; \n\t\t\t\t\n\t\t\t\tvar obj = $(e.target);\n\t\t\t\t//自定义下拉树宽度高度\n  \t\t\t\tvar width = $($tree).attr('dataWidth' )? $($tree).attr('dataWidth') : obj.outerWidth();\n  \t\t\t\tvar height = $($tree).attr('dataHeight');\n  \t\t\t\tif(parem && parem.width){\n  \t\t\t\t\twidth = parem.width;\n  \t\t\t\t}\n\t\t\t\t//设置下拉树的显示位置\n\t\t\t\tvar top = obj.offset().top +obj.outerHeight()+ \"px\";\n\t\t\t\t\n\t\t\t\tif( opts.upDown == 'up'){\n\t\t\t\t\t//显示在上方\n\t\t\t\t\tvar temp = $('#'+opts.showDivId).css(\"height\");\n\t  \t\t\t\tif(temp){\n\t  \t\t\t\t\ttemp = temp.replace(\"px\",\"\");\n\t  \t\t\t\t}\n\t\t\t\t\ttop = obj.offset().top - temp + \"px\";\n\t\t\t\t}\n\t\t\t\tvar left= obj.offset().left + \"px\";\n\t\t\t\tif(!!height){\n\t\t\t\t\t$('#'+opts.showDivId).css({\n\t\t\t\t\t\tminWidth:width,\n\t\t\t\t        width : width,\n\t\t\t\t        height : height,\n\t\t\t\t        top:    top,\n\t\t\t\t        left:   left\n\t\t\t\t      });\n\t\t\t\t}else{\n\t\t\t\t\t$('#'+opts.showDivId).css({\n\t\t\t\t\t\tminWidth:width,\n\t\t\t\t        width : width,\n\t\t\t\t        top:    top,\n\t\t\t\t        left:   left\n\t\t\t\t      });\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t$('#'+treeid).css({\n\t\t\t        width : width\n\t\t\t      });\n\t\t\t\ttreeDiv.show();\n//\t\t\t\t$(document).one('click',dochide);\n\t\t\t\t\n\t\t\t\t$('#'+opts.showDivId).focus();\n\t\t\t}\n//\t\t\tvar dochide = function(e){\n//\t\t\t\t\n//\t\t\t\tif(!(e.target == inputDiv || $.contains(inputDiv.get(0), $(e.target).get(0))\n//\t\t\t\t\t\t||$.contains(treeDiv.get(0), $(e.target).get(0)))) {\n//\t\t\t\t\thide();\n//\t\t\t\t}else{\n//\t\t\t\t\t$(document).one('click',dochide);\n//\t\t\t\t}\n//\t\t\t}\n\t\t\t\n\t\t\t//选中取消事件，更新文本框和span\n\t\t\tsetting.callback.onCheck=function(){\n\t\t\t\t//包含不可编辑的选中项目\n\t\t\t\t// 遍历所有节点，恢复禁用状态为活动状态\n\t\t\t\tvar dsblNodes = tree.getNodesByParam(\"chkDisabled\", true);\n\t\t\t\t\n\t\t\t\t// 遍历节点取消禁用状态\n\t\t\t\tfor (var i=0, l=dsblNodes.length; i < l; i++) {\n\t\t\t\t    // 取消禁用状态\n\t\t\t\t    tree.setChkDisabled(dsblNodes[i], false);\n\t\t\t\t}\n\t\t\t\tvar selecteds = tree.getCheckedNodes(true);\n\t\t\t\t// 遍历节点恢复禁用状态\n\t\t\t\tfor (var i=0, l=dsblNodes.length; i < l; i++) {\n\t\t\t\t    // 恢复禁用状态\n\t\t\t\t    tree.setChkDisabled(dsblNodes[i], true);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tvar ids,names;\n\t\t\t\tif(selecteds.length<=0){\n\t\t\t\t\tviewSpan.html('');\n\t\t\t\t\tinputHTML.val('');\n\t\t\t\t\t//追加placeholder \n\t\t\t\t\tif(opts.placeholder){\n\t\t\t\t\t\tviewSpan.html(opts.placeholder);\n\t\t\t\t\t}else if(\"undefined\" != typeof $wings_pulltree_select_placeholder ){\n\t\t\t\t\t\tviewSpan.html($wings_pulltree_select_placeholder);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t$(selecteds).each(function(i,v){\n\t\t\t\t\tif(ids){\n\t\t\t\t\t\tids += ','+v.code;\n\t\t\t\t\t\tnames += ','+v.caption;\n\t\t\t\t\t}else{\n\t\t\t\t\t\tids = v.code;\n\t\t\t\t\t\tnames = v.caption;\n\t\t\t\t\t}\n\t\t\t\t\tviewSpan.html(names);\n\t\t\t\t\tinputHTML.val(ids);\n\t\t\t\t});\n\t\t\t\t//追加单选时，点击后，隐藏下拉树\n\t\t\t\n\t\t\t\tif(opts.