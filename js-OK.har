选 的节点集合\n\t\t\t\tvar tempNodes = [];\n\t\t\t\tvar selecteds = tree.getCheckedNodes(true);\n\t\t\t\t$(selecteds).each(function(i,obj){\n\t\t\t\t\tif(obj.isParent == false){\n\t\t\t\t\t\ttempNodes.push(obj);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\treturn tempNodes;\n\t\t\t\t\n\t\t\t}else{\n\t\t\t \treturn tree.getCheckedNodes(true);\n\t\t\t}\n\t\t\t\t\n\t\t};\n\t\t//勾选全部节点\n\t\t$treeThis.checkAllNodes= function(){\n\t\t\ttree.checkAllNodes(true);\n\t\t};\n\t\t//取消勾选全部节点\n\t\t$treeThis.uncheckAllNodes= function(){\n\t\t\tif(opts.treeType==1){\n\t\t\t\t//单选树\n\t\t\t\tvar nodes = tree.getCheckedNodes(true);\n \t\t\t\ttree.checkNode(nodes);\n\t\t\t}\n\t\t\ttree.checkAllNodes(false);\n\t\t};\n\t\t//增加一个节点 node ={id,pId,name}\n\t\t$treeThis.addNode = function(node){\n\t\t\t//获取父节点\n\t\t\tvar parentTreeNode = tree.getNodeByParam(\"code\", node.pcode, null);\n\t\t\ttree.addNodes(parentTreeNode, node);\n\t\t};\n\t\t//删除选中的节点\n\t\t$treeThis.delcheckedNode = function(){\n\t\t\tvar nodes = $treeThis.getCheckedNodes();\n\t\t\tfor (var i=0, l=nodes.length; i < l; i++) {\n\t\t\t\ttree.removeNode(nodes[i]);\n\t\t\t}\n\t\t};\n\t\t//删除指定id节点\n\t\t$treeThis.delNode = function(id){\n\t\t\t//查找 id = 1 的节点数据 getNodeByParam(\"id\", 1, null); null：全部结点中查找\n\t\t\tvar node = tree.getNodeByParam(opts.idKey, id, null);\n\t\t\ttree.removeNode(node);\n\t\t};\n\t\t//判断treeNode是不是叶子节点\n\t\t$treeThis.isLeaf = function(treeNode){\n\t\t\treturn !treeNode.isParent;\n\t\t};\n\t\t\n\t\t$treeThis.initData= function(data){\n\t\t  $treeThis.pullTreeData = data.data;\n      //执行前方法\n      var filterData = data.data;\n      var filterD = this.setDataFilter(opts.dataFilter,null);\n      if(filterD.length>0){\n        filterData = filterD;\n      }\n      $.fn.zTree.init(ele,setting,filterData);\n\t\t};\n\t\t$treeThis.setDataFilter = function(funcName,param){\n\t\t  var filterData = [];\n\t\t  if(funcName!=null ){\n        var onDataFilter = wings_getFunc(funcName);\n        for (var b = 0; b < onDataFilter.length; b