            "compression": 11656,
            "text": "String.prototype.startWith=function(str){     \n\t  var reg=new RegExp(\"^\"+str);     \n\t  return reg.test(this);        \n\t}  \nString.prototype.endWith=function(str){     \n  var reg=new RegExp(str+\"$\");     \n  return reg.test(this);        \n}\n$(function(){\t\n//校验组件核心方法扩展\nif($.wingsValidate2){\n\t//追加校验规则的方法\n\t$.wingsValidate2.addMethod = function(v_fn_id ,fn ,msg){\n\t\tvar ruleMobj = {\n\t\t\tr_id:v_fn_id,\n\t\t\tfn:fn,\n\t\t\tmsg:msg\n\t\t}\n\t\t$.wingsValidate2.opts.v_method.put(v_fn_id,ruleMobj);\n\t};\n\t//追加核心校验方法\n\t$.wingsValidate2.validRules= function(realValue,rulesArr){\n\t\tif(realValue === null){\n\t\t\trealValue = \"\";\n\t\t}\n\t\trealValue = realValue + \"\";\n\t\tvar result ={\n\t\t\tflag:'true',\n\t\t\terrorId :'',\n\t\t\terrorMsg:''\n\t\t};\n\t\t//汇总所有校验规则\n\t\tvar curRule_Arr = [];\n\t\tvar blinkZero = \"\";\n\t\tfor(var i = 0 ;i<rulesArr.length ;i++){\n\t\t\tvar ruleKey = rulesArr[i];\n\t\t\tif(ruleKey){\n\t\t\t\tvar temp_Arr = ruleKey.split(\"_\");\n\t\t\t\tfor(var j=0;j<temp_Arr.length;j++){\n\t\t\t\t\tcurRule_Arr.push(temp_Arr[j]);\n\t\t\t\t\tblinkZero += temp_Arr[j];\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif((realValue == \"\")&&(blinkZero.indexOf(\"must\") == -1)){\n\t\t\treturn result\n\t\t}\n\t\t//循环校验\n\t\tfor(var j=0;j<curRule_Arr.length;j++){\n\t\t\tvar res = true;\n\t\t\tif(curRule_Arr[j].indexOf(\"contrast\") != \"-1\"){\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(\"contrast\");\n\t\t\t\truleMobj.msg = \"\";\n\t\t\t\tvar argArr = curRule_Arr[j].split(\";\");\n\t\t\t\tif(argArr.length == 2){\n\t\t\t\t\tvar arg = argArr[1]\n\t\t\t\t\tres = ruleMobj.fn(realValue,arg);\n\t\t\t\t\truleMobj.msg = \"数值\" + arg;\n\t\t\t\t}else{\n\t\t\t\t\tfor(var k=1;k<argArr.length;k++){\n\t\t\t\t\t\tres = res && ruleMobj.fn(realValue,argArr[k]);\n\t\t\t\t\t\tif(!res){\n\t                        ruleMobj.msg = ruleMobj.msg == \"\" ? \"数值\" + argArr[k] : ruleMobj.msg + \"且数值\" + argArr[k];\n\t\t\t\t\t\t}\n\t\t\t\t\t}\t\n\t\t\t\t}\n\t\t\t}else if(curRule_Arr[j].indexOf(\"number(\") != \"-1\"){\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(\"number\");\n\t\t\t\truleMobjLength = $.wingsValidate2.opts.v_method.get(\"length\");\n\t\t\t\truleMobjDegree = $.wingsValidate2.opts.v_method.get(\"degree\");\n\t\t\t\t\n\t\t\t\tvar argArr = curRule_Arr[j].split(\"(\")[1].replace(\")\",\"\").split(\",\");\n\t\t\t\tvar lengthArr = new Array();\n\t\t\t\tvar degreeArr = new Array();\n\t\t\t\tlengthArr.push(0);\n\t\t\t\tlengthArr.push(argArr[0] - argArr[1]);\n\t\t\t\tdegreeArr.push(0);\n\t\t\t\tdegreeArr.push(argArr[1]);\n\t\t\t\truleMobj.msg = \"数字,且整数部分最多\" + lengthArr[1] + \"位\" + \",且小数部分最多\" + degreeArr[1] + \"位\";\t\n\t\t\t\tvar lengthValue = realValue.split(\".\")[0];\n\t\t\t\tlengthValue = lengthValue<0 ? lengthValue.multiple(-1) : lengthValue;\n\t\t\t\tres = ruleMobj.fn(realValue) && ruleMobjLength.fn(lengthValue,lengthArr) && ruleMobjDegree.fn(realValue,degreeArr);\n\n\t\t\t}else if(curRule_Arr[j].indexOf(\"regexp;\") != \"-1\"){\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(\"regexp\");\n\t\t\t\tvar arg = curRule_Arr[j].split(\";\")[1];\n\t\t\t\tres = ruleMobj.fn(realValue,arg);\n\t\t\t}else if(curRule_Arr[j].indexOf(\"customFunction\") != \"-1\"){\n\t\t\t\t//自定义校验\n\t\t\t\tvar argArr = curRule_Arr[j].split(\";\");\n\t\t\t\tif(argArr.length == 2){\n\t\t\t\t\tvar argfn = argArr[1];//自定义方法\n\t\t\t\t\tvar tempFn =  wings_getFunc(argfn);\n\t\t            var resultFn={};\n\t\t\t\t\tfor (var b = 0; b < tempFn.length; b++) {\n\t\t\t            var  func = eval(tempFn[b]);\n\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t       \t\tresultFn = new func(realValue);\n\t\t\t\t       \t}\n\t\t\t\t    };\n\t\t\t\t    ruleMobj = {}  //随便写一个，为了创建对象\n\t\t\t\t    ruleMobj.msg = resultFn.msg\n\t\t\t       \t//返回值\n\t\t\t       \tif(resultFn && resultFn.state === false ){\n\t\t\t\t\t\tres = false;\n\t\t\t       \t}else{\n\t\t\t       \t\tres = true;\n\t\t\t       \t}\t\n\t\t\t\t}\n\t\t\t}else if(curRule_Arr[j].indexOf(\"length(\") != \"-1\"){\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(\"length\");\n\t\t\t\tvar argArr = curRule_Arr[j].split(\"(\")[1].replace(\")\",\"\").split(\",\");\n\t\t\t\tif( argArr[0] == \"0\"){\n\t\t\t\t\truleMobj.msg = \"长度最多\" + argArr[1] + \"位\";\n\t\t\t\t}else{\n\t\t\t\t\truleMobj.msg = \"长度应在,\" +argArr[0] + \"至\" + argArr[1] + \"位之间\";\n\t\t\t\t}\n\t\t\t\tres = ruleMobj.fn(realValue,argArr);\n\n\t\t\t}else if(curRule_Arr[j].indexOf(\"degree(\") != \"-1\"){\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(\"degree\");\n\t\t\t\tvar argArr = curRule_Arr[j].split(\"(\")[1].replace(\")\",\"\").split(\",\");\n\t\t\t\tif( argArr[0] == \"0\"){\n\t\t\t\t\truleMobj.msg = \"小时部分最多\" + argArr[1] + \"位\";\n\t\t\t\t}else{\n\t\t\t\t\truleMobj.msg = \"小数部分应在,\" +argArr[0] + \"至\" + argArr[1] + \"位之间\";\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tres = ruleMobj.fn(realValue,argArr);\n\n\t\t\t}else{\n\t\t\t\truleMobj = $.wingsValidate2.opts.v_method.get(curRule_Arr[j]);\n\t\t\t\tif(ruleMobj){\n\t\t\t\t\tif((curRule_Arr[j] != \"must\")&&(realValue == \"\")){\n\t\t\t\t\t\tres = true\n\t\t\t\t\t}else{\n\t\t\t\t\t\tres = ruleMobj.fn(realValue);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\tif((result.errorMsg)&&(result.errorMsg != \"\")){\n\t\t\t\tresult.errorMsg = result.errorMsg + \",且\" + ruleMobj.msg;\t\t\t\n\t\t\t}else{\n\t\t\t\tresult.errorMsg = ruleMobj.msg;\n\t\t\t}\n\t\t\t\n\t\t\tif(res == false){\n\t\t\t\tresult.flag = 'false';\n\t\t\t}\n\t\t};\n\t\t\n\t\tvar msgArray = result.errorMsg.split(\"\");\n\t\tif(msgArray.length > 21){\n\t\t\tmsgArray[19] = msgArray[19] + \"<br />\";\n\t\t}\n\t\tresult.errorMsg = msgArray.join(\"\");\n\t\treturn result;\n\t};\n\t\n\t//===============  注册 校验规则   ===============\n\t//必录项目\n\t$.wingsValidate2.addMethod(\"must\", function(value) {\n\t\tvar result = validate_must(value);\n\t\treturn result;\n\t}, \"不能为空\");\n\t//数字类\n\t$.wingsValidate2.addMethod(\"number\", function(value) {\n\t\tvar result = validate_numberNew(value);\n\t\treturn result;\n\t}, \"请输入数字\");\n\t\n\t//数字类-整型\n\t$.wingsValidate2.addMethod(\"numberInt\", function(value) {\n\t\tvar result = validate_numberInt(value);\n\t\treturn result;\n\t}, \"请输入整型数字\");\n\t//数字类-浮点型\n\t$.wingsValidate2.addMethod(\"numberFloat\", function(value) {\n\t\tvar result = validate_numberFloat(value);\n\t\treturn result;\n\t}, \"请输入浮点型数字\");\n\t//数字类-科学计数法\n\t$.wingsValidate2.addMethod(\"numberScience\", function(value) {\n\t\tvar result = validate_numberScience(value);\n\t\treturn result;\n\t}, \"请输入科学计算数字\");\t\n\t//字符类-英文\n\t$.wingsValidate2.addMethod(\"english\", function(value) {\n\t\tvar result = validate_english(value);\n\t\treturn result;\n\t}, \"请输入有效英文字符\");\n\t//字符类-中文\n\t$.wingsValidate2.addMethod(\"chinese\", function(value) {\n\t\tvar result = validate_chinese(value);\n\t\treturn result;\n\t}, \"请输入有效中文字符\");\n\t//字符类\n\t$.wingsValidate2.addMethod(\"character\", function(value) {\n\t\tvar result = validate_character(value);\n\t\treturn result;\n\t}, \"请输入有效中英文字符\");\n\t//数字汉字加英文字母类\n\t$.wingsValidate2.addMethod(\"numbercharacter\", function(value) {\n\t\tvar result = validate_numberOrCharacter(value);\n\t\treturn result;\n\t}, \"请输入有效中英文字符或数字\");\n\t//qq类\n\t$.wingsValidate2.addMethod(\"qq\", function(value) {\n\t\tvar result = validate_qq(value);\n\t\treturn result;\n\t}, \"请输入有效qq号码\");\n\t//手机号码\n\t$.wingsValidate2.addMethod(\"cellphone\", function(value) {\n\t\tvar result = validate_cellPhone(value);\n\t\treturn result;\n\t}, \"请输入有效手机号码\");\n\t//固定电话\n\t$.wingsValidate2.addMethod(\"telephone\", function(value) {\n\t\tvar result = validate_phone(value);\n\t\treturn result;\n\t}, \"请输入有效电话号码\");\n\t//手机或者电话\n\t$.wingsValidate2.addMethod(\"phone\", function(value) {\n\t\tvar result = validate_phoneAll(value);\n\t\treturn result;\n\t}, \"请输入有效电话号码\");\n\t//邮箱\n\t$.wingsValidate2.addMethod(\"email\", function(value) {\n\t\tvar result = validate_Email(value);\n\t\treturn result;\n\t}, \"请输入有效email地址\");\n\t//身份证号\n\t$.wingsValidate2.addMethod(\"idcard\", function(value) {\n\t\tvar result = validate_IDCard(value);\n\t\treturn result;\n\t}, \"请输入有效身份证号\");\n\t//邮政编码\n\t$.wingsValidate2.addMethod(\"postal\", function(value) {\n\t\tvar result = validate_postal(value);\n\t\treturn result;\n\t}, \"请输入有效邮政编码\");\n\t//货币格式\n\t$.wingsValidate2.addMethod(\"currency\", function(value) {\n\t\tvar result = validate_currency(value);\n\t\treturn result;\n\t}, \"请输入有效货币格式，以“$”开头\");\n\t//url连接\n\t$.wingsValidate2.addMethod(\"url\", function(value) {\n\t\tvar result = validate_url(value);\n\t\treturn result;\n\t}, \"请输入正确的url地址 例如: http://www.163.com\");\n\t//日期类\n\t$.wingsValidate2.addMethod(\"date\", function(value) {\n\t\tvar result = validate_date(value);\n\t\treturn result;\n\t}, \"请输入正确的日期 默认为yyyy-MM-dd\");\n\t//正则类\n\t$.wingsValidate2.addMethod(\"regexp\", function(value,arg) {\n\t\tvar result = validate_regexpNew(value,arg);\n\t\treturn result;\n\t}, \"请输入正确的格式\");\n\t//比较类 arg格式{>1;<4}或者{>1}\n\t$.wingsValidate2.addMethod(\"contrast\", function(value,arg) {\n\t\tvar result = validate_contrastNew(value,arg);\n\t\treturn result;\n\t}, \"请输入正确的格式\");\n\t//字符串长度范围比较 使用样例：{1;4}\n\t$.wingsValidate2.addMethod(\"length\",function(value,arg){\n\t\tvar result = validate_lengthNew(value,arg);\n\t\treturn result;\n\t}, \"请输入正确的长度\");\n\t//精度校验\n\t$.wingsValidate2.addMethod(\"degree\",function(value,arg){\n\t\tvar result = validate_degreeNew(value,arg);\n\t\treturn result;\n\t}, \"请输入正确的精度\");\n\t//车牌号校验\n\t$.wingsValidate2.addMethod(\"plateNumber\",function(value,arg){\n\t\tvar result = validate_plateNumber(value,arg);\n\t\treturn result;\n\t}, \"请输入正确的车牌号\");\n}\n\t\t\n\n//===================== 具体使用的校验方法 =====================\n//校验方法集合开始\n//正则校验\nfunction validate_regexpNew(value,regStr){\n\tvar reg = new RegExp(regStr);\n\treturn reg.test(value);\n}\n//数字校验\nfunction validate_numberNew(value){\n\tvar value = value + \"\";\n\tif((value.startWith(\"0\")&&(Number(value) >= 1))||(value.startWith(\"00\"))){\n\t\treturn false;\n\t}\n\tvar reg_One=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\tvar reg_Second = new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\tvar reg_Three = new RegExp(\"^(-?\\\\d+)(\\\\.\\\\d+)$\");\n\treturn (reg_One.test(value)) ||(reg_Three.test(value));\n}\n//数字整型校验\nfunction validate_numberInt(value){\n\tvar value = value + \"\";\n\tif((value.startWith(\"0\")&&(Number(value) >= 1))||(value.startWith(\"00\"))){\n\t\treturn false;\n\t}\n\tvar reg=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\treturn reg.test(value);\n}\n//数字浮点校验\nfunction validate_numberFloat(value){\n\tvar value = value + \"\";\n\tif((value.startWith(\"0\")&&(Number(value) >= 1))||(value.startWith(\"00\"))){\n\t\treturn false;\n\t}\n\tvar reg=new RegExp(\"^(-?\\\\d+)(\\\\.\\\\d+)$\");\n\treturn reg.test(value);\n}\n//数字科学计数校验\nfunction validate_numberScience(value){\n\tvar reg=new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\treturn reg.test(value);\n}\n//英文校验\nfunction validate_english(value){\n\tvar reg=new RegExp(\"^[A-Za-z]+$\");\n\treturn reg.test(value);\n}\n//中文校验\nfunction validate_chinese(value){\n\tvar reg=new RegExp(\"^[\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//中英文校验\nfunction validate_character(value){\n\tvar reg=new RegExp(\"^[A-Za-z\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//数字加中英文\nfunction validate_numberOrCharacter(value){\n\tvar reg=new RegExp(\"^[0-9A-Za-z\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//qq\nfunction validate_qq(value){\n\tvar reg=new RegExp(\"[1-9][0-9]{4,9}$\");\n\treturn reg.test(value);\n}\n//固定电话\nfunction validate_phone(value){\n\tvar reg=new RegExp(\"^\\\\d{3,4}-\\\\d{7,8}$\");\n\treturn reg.test(value);\n}\n//邮箱\nfunction validate_Email(value){\n\tvar reg=new RegExp(\"^\\\\w+([-+.]\\\\w+)*@\\\\w+([-.]\\\\w+)*.\\\\w+([-.]\\\\w+)*$\");\n\treturn reg.test(value);\n}\n//手机号码\nfunction validate_cellPhone(value){\n\tvar reg=new RegExp(\"^1[3|4|5|6|7|8|9][0-9]\\\\d{8}$\");\n\treturn reg.test(value);\n}\n//固定电话或者手机号码\nfunction validate_phoneAll(value){\n\tvar reg_One=new RegExp(\"^\\\\d{3,4}-\\\\d{7,8}$\");\n\tvar reg_Second=new RegExp(\"^1[3|4|5|6|7|8|9][0-9]\\\\d{8}$\");\n\treturn (reg_One.test(value)) || (reg_Second.test(value))\n}\n//身份证号\nfunction validate_IDCard(value){\n\tvar city={11:\"北京\",12:\"天津\",13:\"河北\",14:\"山西\",15:\"内蒙古\",21:\"辽宁\",22:\"吉林\",23:\"黑龙江 \",31:\"上海\",32:\"江苏\",33:\"浙江\",34:\"安徽\",35:\"福建\",36:\"江西\",37:\"山东\",41:\"河南\",42:\"湖北 \",43:\"湖南\",44:\"广东\",45:\"广西\",46:\"海南\",50:\"重庆\",51:\"四川\",52:\"贵州\",53:\"云南\",54:\"西藏 \",61:\"陕西\",62:\"甘肃\",63:\"青海\",64:\"宁夏\",65:\"新疆\",71:\"中国台湾\",81:\"香港\",82:\"澳门\",91:\"国外 \"};\n\tif(!city[value.substr(0,2)]){\n        pass = false;\n    }\n\t\n    var format = /^(([1][1-5])|([2][1-3])|([3][1-7])|([4][1-6])|([5][0-4])|([6][1-5])|([7][1])|([8][1-2]))\\d{4}(([1][9]\\d{2})|([2]\\d{3}))(([0][1-9])|([1][0-2]))(([0][1-9])|([1-2][0-9])|([3][0-1]))\\d{3}[0-9xX]$/;\n    //号码规则校验\n    if(!format.test(value)){\n        return false;\n    }\n    //区位码校验\n    //出生年月日校验   前正则限制起始年份为1900;\n    var year = value.substr(6,4),//身份证年\n        month = value.substr(10,2),//身份证月\n        date = value.substr(12,2),//身份证日\n        time = Date.parse(month+'-'+date+'-'+year),//身份证日期时间戳date\n        now_time = Date.parse(new Date()),//当前时间戳\n        dates = (new Date(year,month,0)).getDate();//身份证当月天数\n    if(time>now_time||date>dates){\n        return false;\n    }\n    //校验码判断\n    var c = new Array(7,9,10,5,8,4,2,1,6,3,7,9,10,5,8,4,2);   //系数\n    var b = new Array('1','0','X','9','8','7','6','5','4','3','2');  //校验码对照表\n    var value_array = value.split(\"\");\n    var sum = 0;\n    for(var k=0;k<17;k++){\n        sum+=parseInt(value_array[k])*parseInt(c[k]);\n    }\n    if(value_array[17].toUpperCase() != b[sum%11].toUpperCase()){\n        return false\n    }\n    return true;\n}\n//邮政编码\nfunction validate_postal(value){\n\tvar reg=new RegExp(\"^[0-9]{6}$\");\n\treturn reg.test(value);\n}\n//货币格式\nfunction validate_currency(value){\n\tvar reg=new RegExp(\"^\\\\$[0-9]{1,}$\");\n\treturn reg.test(value);\n}\n//url链接\nfunction validate_url(value){\n\tvar reg=new RegExp(\"^http://([\\\\w-]+\\\\.)+[\\\\w-]+(/[\\\\w-./?%&=]*)?$\");\n\treturn reg.test(value);\n}\n//日期\nfunction validate_date(value){\n\tvar reg=new RegExp(\"[0-9]{4}-([0][1-9]|[1][0-2])-([0][1-9]|[1|2][0-9]|[3][0|1])$\");\n\treturn reg.test(value);\n}\n//比较\nfunction validate_contrastNew(value,arg){\n\tvar result = false;\n\tif(validate_numberNew(value)){\n\t\tvar ant = value+arg;\n\t\tif(eval(ant)){\n\t\t\tresult = true\n\t\t}\n\t}\n\treturn result;\n}\n//长度 \nfunction validate_lengthNew(value,arg){\n\tif((!!!arg)||(arg.length<2)){\n\t\treturn false;\n\t}\n\trealValue = value + \"\";\n\tvar result = false;\n\tvar minLength = parseInt(arg[0]);\n\tvar maxLength = parseInt(arg[1]);\n\t\n\tif((realValue.length <= maxLength) && (realValue.length >= minLength)){\n\t\tresult = true;\n\t}\n\treturn result;\n}\n//精度 \nfunction validate_degreeNew(value,arg){\n\tif(!validate_numberNew(value)){\n\t\treturn false;\n\t}\n\tif((!!!arg)||(arg.length<2)){\n\t\treturn false;\n\t}\n\t\n\tvalue = value + \"\";\n\tif(value.indexOf(\".\") == -1){\n\t\tvalue = value + \".\";\n\t}\n\tvar result = false;\n\tvar realValue = value.split(\".\")[1];\n\n\tvar\tminLength = parseInt(arg[0]);\n\tvar\tmaxLength = parseInt(arg[1]);\n\t\n\t\n\tif(realValue < 0){\n\t\tmaxLength = eval(maxLength + 1);\n\t}\n\tif((realValue.length <= maxLength) && (realValue.length >= minLength)){\n\t\tresult = true;\n\t}\n\treturn result;\n}\n//必填项\nfunction validate_must(value){\n\tvar result = false;\n\tvalue = value + \"\";\n\tvalue = value.replace(/^\\s+|\\s+$/g,\"\");\n\tif(value != \"\"){\n\t\tresult = true;\n\t}\n\treturn result;\n}\n//车牌号校验\nfunction validate_plateNumber(value){\n\tvar reg = /^[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼使领A-Z]{1}[A-Z]{1}[A-Z0-9]{4}[A-Z0-9挂学警港澳]{1}$/;\n\treturn reg.test(value)\n}\n//反格式化整形\nfunction formatNumber(value){\n\tvar valueArr = value.split(\",\");\n\tvar realValue = \"\";\n\tfor(var i=0;i<valueArr.length;i++){\n\t\trealValue += valueArr[i];\n\t}\n\treturn value;\n}\n//科学计数法转整型\nfunction scientificToNumber(num) {\n    var result = new Number(num);\n    result = (result-0).toLocaleString(); \n    result = result.toString().replace(/\\$|\\,/g, '');           \n    return result;\n}\n\n//校验方法集合结束\n});"
          },
