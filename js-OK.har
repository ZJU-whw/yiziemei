            "mimeType": "text/css",
            "compression": 743,
            "text": "\n/* CSS Document */\ntable.tab_form {font-family: \"微软雅黑\"; width: 100%; color:#000; font-size:12px;}\ntable.tab_form td{border: 1px solid #b7d5d3; height:27px; line-height:27px;  font-weight:100; margin:0; padding:0; }\ntable.tab_form th{border: 1px solid #b7d5d3; height:30px; line-height:30px;  font-weight:100; margin:0; padding:0;}\n\ntable.tab_form th{ text-align: right;  background:#eff5fb;}\ntable.tab_form td{}\n.wingsInput{height: 30px; line-height: 30px; width: 100%;margin: 0; border: 0;}\n\ntable.tab_form th text{margin:0;padding:0;}\nlabel {display: inline-block; max-width: 100%; margin-bottom: 0; margin-right: 10px; font-weight:100;}\n\nspan.input-group-addon {background: #fff; border: 0; color: #66ade7;}\n.input-group .wtreeSpan{ border:1px solid #fff;}\n.selection .select2-container--default .select2-selection--single{ border:1px solid #fff;}\ntextarea {width: 100%; height:100px;border: 0; margin-top: 5px;}\n.input-group .form-control {border: 0; line-height: 34px;  width: 100%; padding:0;}\ninput#studentForm_csTime_44 {border: 0; box-shadow: inset 0 0 0;}\nspan.select2-selection.select2-selection--single {border: 0;}\n.col-xs-12{padding-left:0;}\n\n.input-group-wingsTime{\n    width: 100%;\n}\n.input-group-wingsTime .form-control {\n    border: 0;\n    line-height: 34px;\n    width: 100%;\n    padding: 0;\n    width: 100%\\9\\0;\n    z-index:0;\n}\n\n\n"
          },
