          "content": {
            "size": 19093,
            "mimeType": "text/javascript",
            "compression": 14790,
            "text": "/**\n *\n * 自定义提交查询\n * @private\n */\nvar _zdySubmit = {\n    _ctrl: \"YxscxGyCtrl\", _cxbj: true,/*zdy请求标记*/\n    _jmbz: false,/*请求加密标志*/\n    _jmKey: \"\", _sfkqmb: true,/*默认开启蒙版*/\n    /**\n     * 组装form数据\n     * @param name\n     * @param paramsData\n     * @returns {createFormData.formdata}\n     */\n    createFormDataForName: function (paramsData, _formName) {\n        //設置分页请求参数\n        var ajaData = {};\n        if (checkNull(_formName) && checkNull($.wingsWidget(_formName))) {\n            var cxtjFormData = $.wingsWidget(_formName).getSubmitData();\n            $.each(cxtjFormData.data, function (key, map) {\n                ajaData[key] = map.value;\n            });\n        }\n        if (checkNull(paramsData)) {\n            $.each(paramsData, function (key, value) {\n                ajaData[key] = key == 'result' ? JSON.stringify(value) : value;\n            });\n        }\n        //设置查询参数\n        if (checkNull(ajaData.result)) {\n            var a = JSON.parse(ajaData.result);\n            for (var i = 0; i < a.length; i++) {\n                if (a[i].type == 'grid') {\n                    var gn = checkNull(a[i].gs) ? a[i].gs : a[i].name;\n                    var grid = $.wingsWidget(gn);\n                    if (checkNull(grid) && checkNull(grid.getOptions().ptid)) {\n                        a[i].fybz = \"Y\";\n\n                        //自定义参数控制\n                        var resultData = JSON.parse(ajaData.result);\n                        for (var j = 0; j < resultData.length; j++) {\n                            if (a[i].name == resultData[j].name) {\n                                if (checkNull(resultData[j].keyCode)) {\n                                    ajaData.keyCode = resultData[j].keyCode;\n                                    break;\n                                }\n                            }\n                        }\n                        //20220613 修复初始参数含【ctrl】参数，导致后台分页查询异常\n                        if (checkNull(ajaData.ctrl)) {\n                            ajaData.ctrl = grid.getOptions().ptid;\n                        }\n                        this.setFyAjaxParams(_formName, gn, ajaData);\n                    }\n                }\n            }\n            ajaData.result = JSON.stringify(a);\n        }\n        var data = new createFormData('dataForm');\n        data.setMapData(ajaData);\n        return data.getFormData();\n    }, createFormData: function (name) {\n        var _ = this;\n        _.data = {};\n        _.formdata = {\"sword\": 'SwordForm', \"name\": name, \"data\": _.data}\n        _.setData = function (name, value) {\n            _.data[name] = {\"value\": value};\n        }\n        _.setMapData = function (map) {\n            for (var key in map) {\n                _.data[key] = {\"value\": map[key]};\n            }\n        }\n        _.getFormData = function () {\n            _.formdata[\"data\"] = _.data;\n            return _.formdata;\n        }\n        return _;\n    }, /**\n     * 组装分页查询组装请求参数,params-非from表单请求参数\n     * @param _formName\n     * @param _gridName\n     * @param map\n     * @returns {createFormData.formdata}\n     */\n    setFyAjaxParamsByFormData: function (_formData, _gridName) {\n        //設置分页请求参数\n        var ajaData = {};\n        var cxtjFormData = _formData;\n        $.each(cxtjFormData.data, function (key, map) {\n            ajaData[key] = map.value;\n        });\n        //添加非form表单里面的请求条件\n        ajaData.pagesize = $.wingsWidget(_gridName).getPagingObj().getPageSize();//处理wing默认首次查询20条数据问题\n        ajaData.gridName = _gridName;//设置Grid名称\n        var data = new createFormData('dataForm');\n        data.setMapData(ajaData);\n        $.wingsWidget(_gridName).setAjaxParam(ajaData);\n        return data.getFormData();\n    }, /**\n     * 处理默认点击排序异常(默认没有点击grid查询，点击表头抛出异常)\n     * @param gridName\n     */\n    initDefGridSort: function (gridName) {\n        this.setFyAjaxParams(\"\", gridName, {});\n    }, /**\n     * 组装分页查询组装请求参数,params-非from表单请求参数\n     * @param _formName\n     * @param _gridName\n     * @param map\n     * @returns {createFormData.formdata}\n     */\n    setFyAjaxParams: function (_formName, _gridName, params) {\n        //設置分页请求参数\n        var ajaData = {};\n        if (checkNull(_formName) && checkNull($.wingsWidget(_formName))) {\n            var cxtjFormData = $.wingsWidget(_formName).getSubmitData();\n            $.each(cxtjFormData.data, function (key, map) {\n                ajaData[key] = map.value;\n            });\n        }\n\n        //添加非form表单里面的请求条件\n        params.pagesize = $.wingsWidget(_gridName).getPagingObj().getPageSize();//处理wing默认首次查询20条数据问题\n        if (checkNull(params)) {\n            $.each(params, function (key, value) {\n                ajaData[key] = value;\n            });\n        }\n        ajaData.gridName = _gridName;//设置Grid名称\n        var data = new createFormData('dataForm');\n        data.setMapData(ajaData);\n        $.wingsWidget(_gridName).setAjaxParam(ajaData);\n        return data.getFormData();\n    }, /**\n     * 自定义分页查询后端分页数据\n     */\n    _zdyHdFyQueryGridData: function (_formName, _gridName, _funName, params, mskMessge, _callbackName) {\n        var submitData = this.setFyAjaxParams(_formName, _gridName, params);\n        this._zdySubmitData(submitData, _funName, mskMessge, _callbackName);\n    }, /**\n     * 公共分页查询表格数据\n     */\n    _zdyFeyeQueryGridData: function (_formName, _gridName, params, mskMessge, _callbackName) {\n        var submitData = this.setFyAjaxParams(_formName, _gridName, params);\n        this._zdySubmitData(submitData, \"queryGridFenyeData\", mskMessge, _callbackName);\n    },\n\n    /**\n     * 公共查询表格数据\n     */\n    _zdyQueryGridData: function (_formName, params, mskMessge, _callbackName) {\n        var submitData = this.createFormDataForName(_formName, params);\n        this._zdySubmitData(submitData, \"queryGridData\", mskMessge, _callbackName);\n    }, /**\n     * 公共查询数据\n     */\n    _zdyQueryData: function (_formName, params, _funName, mskMessge, _callbackName) {\n        var submitData = this.createFormDataForName(params, _formName);\n        this._zdySubmitData(submitData, _funName, mskMessge, _callbackName);\n    }, /**\n     * 提交查询（大屏专用）\n     * @param submitData\n     * @param mskMessge\n     * @param _callbackName\n     * @private\n     */\n    _zdyVueDataQuerySubmit: function (submitParams, _funName, mskMessge, _dpSubmit, reqParams) {\n        var submitData = this.createFormDataForName(submitParams);\n        var mbbz = false;\n        if (this._sfkqmb && checkNull(mskMessge)) {\n            mbbz = true;\n            openMenban(mskMessge + \"中,请稍后。。。\");\n        }\n        var sub = new WingsSubmit();\n        if ($chk(reqParams) && !$.isEmptyObject(reqParams)) {\n            for (var p in reqParams) {\n                sub.pushData(p, reqParams[p]);\n            }\n        }\n        sub.pushData(submitData);\n        sub.options.data = this._encryptSubmitOptionsData(sub);\n        sub.setCtrl(this._ctrl + \"_\" + _funName);\n        sub.setOptions({\n            onSuccess: function (res) {\n                offMenban();\n                _dpSubmit._zdyDataQueryOnSuccess(res);\n            }\n        });\n        sub.setFunction(\"onException\", \"gyException()\");\n        sub.setFunction(\"onError\", \"Error()\");\n        sub.submit();\n    }, /**\n     * 提交查询（大屏专用）\n     * @param submitData\n     * @param mskMessge\n     * @param _callbackName\n     * @private\n     */\n    _zdyDataQuerySubmit: function (submitData, _funName, mskMessge, _dpSubmit, reqParams) {\n        var mbbz = false;\n        if (this._sfkqmb && checkNull(mskMessge)) {\n            mbbz = true;\n            openMenban(mskMessge + \"中,请稍后。。。\");\n        }\n        var sub = new WingsSubmit();\n        /*add by zhanghuo */\n        if ($chk(reqParams) && !$.isEmptyObject(reqParams)) {\n            for (var p in reqParams) {\n                sub.pushData(p, reqParams[p]);\n            }\n        }\n        /*add by zhanghuo end */\n        sub.pushData(submitData);\n        sub.options.data = this._encryptSubmitOptionsData(sub);\n        sub.setCtrl(this._ctrl + \"_\" + _funName);\n        sub.setOptions({\n            onSuccess: function (res) {\n                offMenban();\n                _dpSubmit._zdyDataQueryOnSuccess(res);\n            }\n        });\n        sub.setFunction(\"onException\", \"gyException()\");\n        sub.setFunction(\"onError\", \"Error()\");\n        sub.submit();\n    }, /**\n     * 提交查询（添加提交类型控制）\n     * @param submitData\n     * @param mskMessge\n     * @param _callbackName\n     * @private\n     */\n    _zdyDataQuerySubmitByPostType: function (submitData, _funName, mskMessge, _dpSubmit) {\n        var mbbz = false;\n        if (this._sfkqmb && checkNull(mskMessge)) {\n            mbbz = true;\n            openMenban(mskMessge + \"中,请稍后。。。\");\n        }\n        var sub = new WingsSubmit();\n        sub.pushData(submitData);\n        /*add by zhanghuo 添加提交类型控制*/\n        var postType = _dpSubmit._postType || \"ajax\";\n        sub.options.data = this._encryptSubmitOptionsData(sub);\n        sub.options.postType = postType;\n        sub.setCtrl(this._ctrl + \"_\" + _funName);\n        sub.setOptions({\n            onSuccess: function (res) {\n                offMenban();\n                _dpSubmit._zdyDataQueryOnSuccess(res);\n            }\n        });\n        sub.setFunction(\"onException\", \"gyException()\");\n        sub.setFunction(\"onError\", \"Error()\");\n        sub.submit();\n    },\n\n    _zdyDataQueryOnSuccess: function (res) {\n    }, _queryDataSubmit: function (_dpSubmit, paramsData, baseData) {\n        $.extend(paramsData, baseData);\n        var msg = checkNull(paramsData.message) ? paramsData.message : \"查询\";\n        _dpSubmit._zdyDataQuerySubmit(_dpSubmit.createFormDataForName(paramsData, ''), \"getQueryData\", msg, _dpSubmit);\n    }, /**\n     * 提交查询\n     * @param submitData\n     * @param mskMessge\n     * @param _callbackName\n     * @private\n     */\n    _zdySubmitData: function (submitData, _funName, mskMessge, _callbackName) {\n        var mbbz = false;\n        if (this._sfkqmb && checkNull(mskMessge)) {\n            mbbz = true;\n            openMenban(mskMessge + \"中,请稍后。。。\");\n        }\n        var sub = new WingsSubmit();\n        sub.pushData(submitData);\n        sub.options.data = this._encryptSubmitOptionsData(sub);\n        sub.setCtrl(this._ctrl + \"_\" + _funName);\n        sub.setFunction('onSuccess', '_zdySubmit.zdyQueryFunSuccess(' + _callbackName + ',' + mbbz + ')');\n        sub.setFunction(\"onException\", \"gyException()\");\n        sub.setFunction(\"onError\", \"Error()\");\n        sub.submit();\n    }, _encryptSubmitData: function (submitData) {\n        return JSON.stringify(EncryptUtils.encrypt_AES({'data': JSON.stringify(submitData), 'key': _zdySubmit._jmKey}));\n    }, /* 数据处理 */\n    _encryptSubmitOptionsData: function (subData) {\n        //针对一户式查询分析加密处理\n        var menuCode = \"\";\n        try {\n            menuCode = checkNull(subData.options.data[0].data.menuCode) ? subData.options.data[0].data.menuCode.value : \"\";\n        } catch (e) {\n            menuCode = \"\";\n        }\n\n        var jmBoolean = menuCode.indexOf(\"dhcx\") > -1;\n\n        if (this._jmbz || jmBoolean) {\n            EncryptUtils.jmbz = this._jmbz;\n            //this._jmKey = \"5a6e91e23c12bd3b21bcb36db16e7184\";\n            //return '#AES#' + this._encryptSubmitData(subData.options.data);\n            return [{\"sword\": \"SwordForm\", \"name\": \"jmpdsdeForm\", \"data\": {\"#jmpdsdeData#\": {\"value\": this._encryptSubmitData(subData.options.data)}}}];\n        } else {\n            return subData.options.data;\n        }\n    }, /**\n     * 提交查询\n     * @param submitData\n     * @param mskMessge\n     * @param _callbackName\n     * @private\n     */\n    _commonSubmitData: function (submitData, _funName, mskMessge, _callbackName) {\n        var mbbz = false;\n        if (this._sfkqmb && checkNull(mskMessge)) {\n            mbbz = true;\n            openMenban(mskMessge + \"中,请稍后。。。\");\n        }\n        var sub = new WingsSubmit();\n        for (var i = 0; i < submitData.length; i++) {\n            sub.pushData(submitData[i]);\n        }\n        sub.setCtrl(_funName);\n        sub.options.data = this._encryptSubmitOptionsData(sub);\n        sub.setFunction('onSuccess', '_zdySubmit.zdyQueryFunSuccess(' + _callbackName + ',' + mbbz + ')');\n        sub.setFunction(\"onException\", \"gyException()\");\n        sub.setFunction(\"onError\", \"Error()\");\n        sub.submit();\n    }, zdyQueryFunSuccess: function (_callbackName, mbbz, res) {\n        if (mbbz) {\n            offMenban();\n        }\n        _zdySubmit._initGridSortType(res);\n        //回调自定义回调函数方法\n        if (checkNull(_callbackName)) {\n            var fn = eval(_callbackName);\n            if (typeof (fn) === 'function') {\n                eval(fn(res));\n            }\n        }\n        IFrameResize();\n    }, //初始化Grid数据时加载排序字段类型显示\n    _initGridSortType: function (res) {\n        var d = res.data;\n        var len = d.length;\n        for (var i = 0; i < len; i++) {\n            if (checkNull(d[i].sword) && 'SwordGrid' == d[i].sword && checkNull(d[i].sortName)) {\n                var sort = d[i].sortName;\n                var n = sort.split('-')[0];\n                var t = sort.split('-')[1];\n\n                var showCol = $.wingsWidget(d[i].name).getOptions().showColumns;\n                if (showCol) {//增加判断-----yl\n                    for (var j = 0; j < showCol.length; j++) {\n                        if (n == showCol[j].name) {\n                            var ths = $('table[id^=\"' + d[i].name + '_wingsGrid\"] > thead > tr > th');\n                            for (var k = 0; k < ths.length; k++) {\n                                if (k == j) {\n                                    var ta = 'down' == t ? '↓' : '↑';\n                                    $(ths[j]).find('a').attr({'sort': t, 'class': ''});\n                                    $(ths[j]).find('a').text(ta);\n                                } else {\n                                    $(ths[k]).find('a').attr({'sort': 'up', 'class': 'wingsGridSort'});\n                                    $(ths[k]).find('a').text('');\n                                }\n                            }\n\n                            break;\n                        }\n                    }\n                }\n\n\n            }\n        }\n    }\n};\n\n/* 重新wings提供方法AddBizCode2URL */\nfunction AddBizCode2URL(c, b) {\n    if (!c) {\n        return \"\"\n    }\n    if (checkNull(_zdySubmit) && _zdySubmit._cxbj) {\n        //仅一X式查询系统使用\n        var n = [\"gwxh\", \"gndm\", \"zndm\", \"gnjdm\", \"jsdm\", \"gwssswjg\", \"cxbj\"];\n        var v = {};\n        var href = window.location.search;\n        var systemInfo = {};\n        if (href.indexOf('systemInfo') >= 0) {\n            href = decodeURIComponent(href);\n            href = decodeURIComponent(href);\n            href = href.substring(href.indexOf('systemInfo'), href.lastIndexOf('}') + 1);\n            href = href.substring(href.indexOf('{'), href.indexOf('}') + 1);\n            href = href.replace(new RegExp(\"'\", \"g\"), \"\\\"\");\n            systemInfo = jQuery.parseJSON(href);\n\n            for (var i = 0; i < n.length; i++) {\n                v[n[i]] = checkNull(systemInfo[n[i]]) ? systemInfo[n[i]] : \"\";\n            }\n        } else {\n            var hrefStr = href.substring(href.indexOf('?'), href.length);\n            var hp = hrefStr.split('&');\n            for (var i = 0; i < hp.length; i++) {\n                v[hp[i].split('=')[0]] = hp[i].split('=') > 1 ? hp[i].split('=')[1] : \"\";\n\n            }\n        }\n\n        for (var d in v) {\n            var a = v[d];\n            if (a && d != \"cxbj\") {\n                c = (c + ((c.indexOf(\"?\") == -1) ? \"?\" : \"&\") + d + \"=\" + a)\n            }\n        }\n        //加密\n        if (checkNull(EncryptUtils) && EncryptUtils.jmbz) {\n            c = c.split('?')[0] + '?%23aes%23=' + EncryptUtils.encrypt_AES({'data': c.split('?')[1], 'key': _zdySubmit._jmKey});\n        }\n    } else {\n        var f = _getBizCode_(b);\n        for (var d in f) {\n            var a = f[d];\n            if (a && d != \"cxbj\") {\n                c = (c + ((c.indexOf(\"?\") == -1) ? \"?\" : \"&\") + d + \"=\" + a)\n            }\n        }\n    }\n\n    /* 系统页面集成，增加系统标识 add chen 2022-10-13*/\n    var url = c;\n    if ((c.indexOf('LdtsDpbCtrl_getQueryData') > -1 && c.indexOf('ajax.sword') > -1) || (href.indexOf('8f7dd6e781d24340ac49be123746aa17') > -1 && c.indexOf('ajax.sword') > -1)) {\n        url = '/yxscx' + c;\n        //url = c.replace('ajax.sword', 'ajax.sword');\n    }\n    return url;\n    //return c.replace('ajax.sword', 'ajax.sword.dsj');\n}\n\n\nfunction Param(name, value) {\n    this.name = name;\n    this.value = value;\n}\n\nfunction loadWingsPageData(baseData) {\n    var paramsKeys = ['djxh', 'sjlybz', 'clsbh', 'menuCode', 'appId', 'sortType', 'sortName', 'keyCode', 'formNames', 'gridNames', 'zfbzsf'];\n    var paramsData = {};\n    for (var i = 0; i < paramsKeys.length; i++) {\n        paramsData[paramsKeys[i]] = checkNull(baseData[paramsKeys[i]]) ? baseData[paramsKeys[i]] : '';\n    }\n    paramsData.gridNames = getGridNames(paramsData);\n    paramsData.formNames = getFormNames();\n    //提交数据\n    _zdySubmit._zdySubmitData(_zdySubmit.createFormDataForName(paramsData), \"queryPageData\", \"加载\", null);\n}\n\n/**\n * 获取页面Grid名称集合,并对分页Grid设置初始AjaxParams\n * @param paramsData\n * @returns {string}\n */\nfunction getGridNames(paramsData) {\n    var gridNames = \"\";\n    //判断grid表数据是否为分页数据\n    var wingsGrids = $('div[wings=\"WingsGrid\"]');\n    for (var i = 0; i < wingsGrids.length; i++) {\n        var gridName = $(wingsGrids[i]).attr('name');\n        var grid = $.wingsWidget(gridName);\n        if (checkNull(grid.getOptions().ptid)) {\n            paramsData.gridName = gridName;\n            _zdySubmit.setFyAjaxParams(null, gridName, paramsData);\n        }\n        gridNames = checkNull(grid.getOptions().ptid) ? gridName + \"-Y,\" + gridNames : gridName + \"-N,\" + gridNames;\n    }\n    return gridNames;\n}\n\n/**\n * 获取页面Form名称集合\n * @returns {string}\n */\nfunction getFormNames() {\n    var formNames = \"\";\n    //判断grid表数据是否为分页数据\n    var wingsForms = $('div[wings=\"WingsForm\"]');\n    for (var i = 0; i < wingsForms.length; i++) {\n        if (checkNull($(wingsForms[i]).attr('isQuery')) && $(wingsForms[i]).attr('isQuery') == 'false') {\n            continue;\n        }\n        formNames = $(wingsForms[i]).attr('name') + \",\" + formNames;\n    }\n    return formNames;\n}"
          },
