          "content": {
            "size": 3363,
            "mimeType": "text/css",
            "compression": 2575,
            "text": "/* 删除from表单伪元素 */\n.delAfterTh::after {\n    display: none;\n}\n\n/* 删除from表单wings新版伪元素样式 */\ntable.tab_form > tbody > tr > th::after {\n    display: none;\n}\n\ntable.dataTable.stripe tbody tr.odd.selected, table.dataTable.display tbody tr.odd.selected {\n    background-color: #e6e9ef;\n}\n\ntable.dataTable tbody tr.selected {\n    background-color: #d2d4da;\n}\n\nbutton.newBtnImport {\n    outline: none;\n    height: .28rem;\n    line-height: .28rem;\n    padding: 0 .14rem 0 .36rem;\n    border-radius: .04rem !important;\n    background: #fff url(\"../../wingsNewBlue/public/images/btn_import.png\") no-repeat .14rem center;\n    font-size: 12px;\n    color: #60c6ec;\n    background-size: .14rem;\n    border: 1px solid #60c6ec;\n    word-break: keep-all\n}\n\nbutton.newBtnImport:hover {\n    color: #fff;\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_import_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\n\nbutton.newBtnImport:active {\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_import_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\n\nbutton.newBtnQuery {\n    outline: none;\n    height: .28rem;\n    line-height: .28rem;\n    padding: 0 .14rem 0 .36rem;\n    border-radius: .04rem !important;\n    background: #fff url(\"../../wingsNewBlue/public/images/btn_find.png\") no-repeat .14rem center;\n    font-size: 12px;\n    color: #60c6ec;\n    background-size: .14rem;\n    border: 1px solid #60c6ec;\n    word-break: keep-all\n}\nbutton.newBtnQuery:hover {\n    color: #fff;\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_find_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\n\nbutton.newBtnQuery:active {\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_find_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\nbutton.newSure {\n    outline: none;\n    height: .28rem;\n    line-height: .28rem;\n    padding: 0 .14rem 0 .36rem;\n    border-radius: .04rem !important;\n    background: #fff url(\"../../wingsNewBlue/public/images/btn_sure.png\") no-repeat .14rem center;\n    font-size: 12px;\n    color: #60c6ec;\n    background-size: .14rem;\n    border: 1px solid #60c6ec;\n    word-break: keep-all\n}\n\nbutton.newSure:hover {\n    color: #fff;\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_sure_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\n\nbutton.newSure:active {\n    background: #60c6ec url(\"../../wingsNewBlue/public/images/btn_sure_hover.png\") no-repeat .14rem center;\n    background-size: .14rem;\n}\n\n\n.mxTable, .mxTable2 {\n    width: 100%;\n    margin: 0 auto;\n    border: 0;\n    margin-top: 20px;\n    border-collapse: collapse;\n    text-align: center;\n}\n\n.mxTable tr td, .mxTable2 tr td {\n    /*color:#777;*/\n    font-size: 12px;\n}\n\n.mxTableDw1 {\n    background-color: #b1e4c1;\n    color: #398f54;\n}\n\n.mxTableDw2 {\n    background-color: #ddf7e9;\n    color: #64c081;\n}\n\n.mxTableDw3 {\n    background-color: #f9e1e1;\n    color: #f14c4c;\n}\n\n.mxTableDw4 {\n    background-color: #fba9a9;\n    color: #c23b3b;\n}\n\n.mxTable tr:nth-child(1) td {\n    /*  color: #0077EA;*/\n    font-weight: bold;\n}\n\n.mxTable tr:nth-child(1) td:nth-child(3), .mxTable2 tr:nth-child(1) td:nth-child(3) {\n    background: none;\n}\n\n.mxTable td, .mxTable2 td {\n    height: 30px;\n    border: 1px #E2E0DB solid;\n}\n"
