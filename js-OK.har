ngsToolBar\"].btn-toolbar.btn-group div:hover {\n    background-color: #3F77DB;\n    color: #fff;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar.btn-group .unused {\n    border: solid 1px #bfbfbf;\n    color: #bfbfbf;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar.btn-group .unused:hover {\n    border: solid 1px #bfbfbf;\n    color: #bfbfbf;\n    background-color: #fff;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar.btn-group > div[data-size=\"small\"] {\n    height: 28px;\n    margin: 10px 20px 10px 0;\n    padding: 0 14px 0 36px;\n    background-position: 13px center;\n    background-size: 14px;\n    line-height: 28px;\n    font-size: 14px;\n    border-radius: 4px !important;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar div[data-size=\"small\"]:hover,\ndiv[wings=\"WingsToolBar\"].btn-toolbar div[data-size=\"small\"]:active {\n    background-position: 13px center;\n    background-size: 14px;\n    box-shadow: 0 0 6px 0 #3F77DB;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar div[data-size='default'] {\n    height: 32px;\n    margin: 0 20px 0 0;\n    padding: 0 24px 0 52px;\n    background-position: 24px center;\n    background-size: 15px;\n    line-height: 32px;\n    font-size: 16px;\n    border-radius: 04px !important;\n    outline: none;\n    white-space: nowrap;\n}\n\ndiv[wings=\"WingsToolBar\"].btn-toolbar div[data-size='default']:hover,\ndiv[wings=\"WingsToolBar\"].btn-toolbar div[data-size='default']:active {\n    background-position: 24px center;\n    background-size: 15px;\n    box-shadow: 0 0 6px 0 #3F77DB;\n}\n\ndiv[data-target='headWingsToolBar'] {\n    padding: 0px 30px;\n}\n\ndiv[wings='WingsGrid'] {\n    padding: 10px 0;\n}\n\ndiv[data-target='footWingsToolBar'] {\n    padding: 10px 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n/**\n * @pageName: uploading.less\n **/\n.loading {\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.2);\n    position: fixed;\n    left: 0;\n    top: 0;\n    z-index: 999999;\n}\n\n.pic {\n    width: 360px;\n    height: 100px;\n    position: absolute;\n    z-index: 4;\n    margin: auto;\n    left: 0;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    background: url(\"../public/images/qq.gif\") 60px 30px no-repeat;\n    background-size: 40px 40px;\n    font-size: 18px;\n    color: #fff;\n    background-color: #3f77db;\n    padding-left: 120px;\n    border-radius: 4px;\n    line-height: 100px;\n    font-weight: bold;\n    font-family: MicrosoftYaHei-Bold;\n}\n\n.jiazai {\n    width: 120px;\n    height: 50px;\n    text-align: center;\n    position: relative;\n    top: 55%;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    margin: auto;\n    color: #666;\n}\n\n.loading .pic i {\n    width: 6px;\n    height: 50px;\n    margin: 0 2px;\n    background-color: #399;\n    display: block;\n    float: left;\n    transform: scaleY(0.4);\n    -webkit-animation: load 1.2s infinite;\n    animation: load 1.2s infinite;\n}\n\n.loading .pic i:nth-child(2) {\n    -webkit-animation-delay: 0.1s;\n    animation-delay: 0.1s;\n}\n\n.loading .pic i:nth-child(3) {\n    -webkit-animation-delay: 0.2s;\n    animation-delay: 0.2s;\n}\n\n.loading .pic i:nth-child(4) {\n    -webkit-animation-delay: 0.3s;\n    animation-delay: 0.3s;\n}\n\n.loading .pic i:nth-child(5) {\n    -webkit-animation-delay: 0.4s;\n    animation-delay: 0.4s;\n}\n\n@-webkit-keyframes load {\n    0%,\n    40%,\n    100% {\n        transform: scaleY(0.4);\n    }\n    20% {\n        transform: scaleY(1);\n    }\n}\n\n@keyframes load {\n    0%,\n    40%,\n    100% {\n        transform: scaleY(0.4);\n    }\n    20% {\n        transform: scaleY(1);\n    }\n}\n\n/**\n * @pageName: validate.less\n **/\n/*改写bootatrap边框一些初始化样式*/\n.col-sm-5 {\n    border: none;\n    padding: 0;\n    height: auto;\n}\n\n.col-sm-5 div {\n    height: 100%;\n}\n\n.col-sm-5 div input {\n    height: 32px;\n    vertical-align: middle;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    outline: none;\n    padding-left: 9px;\n}\n\n.col-sm-5 div textarea {\n    border: 1px solid #ccc;\n}\n\n.row {\n    border: none;\n    background: #fff;\n}\n\n.container {\n    padding-right: 0;\n    padding-left: 0;\n}\n\n/*validate样式优化*/\n.form-horizontal .control-label {\n    color: #666;\n    font-weight: normal;\n    line-height: 36px;\n    letter-spacing: 1px;\n    margin-right: 0;\n    padding: 0;\n}\n\n.form-horizontal .form-group {\n    margin-right: 0;\n    margin-left: 0;\n    border: none;\n}\n\ninput[type=\"text\"]:focus,\ninput[type=\"password\"]:focus {\n    border: 1px solid #3F77DB;\n    box-shadow: none;\n}\n\n.panel-body {\n    background: #fff;\n}\n\n.panel {\n    /*width: calc(100% + 2px);*/\n    border: 1px solid transparent;\n    box-shadow: none;\n    margin-bottom: 0;\n}\n\n/**\n * @pageName: wingsUploader.less\n **/\n.left {\n    width: 18%;\n    height: 470px;\n    border: 1px #b7d5d3 solid;\n    float: left;\n    margin-left: 1px;\n}\n\n.right {\n    width: 81%;\n    height: 470px;\n    border: 1px #b7d5d3 solid;\n    float: right;\n    margin-right: 1px;\n}\n\n[name=\"xyrxxGrid\"] table {\n    width: 100%;\n}\n\n.panel-heading {\n    font-weight: bold;\n}\n\n.cover {\n    display: inline-block;\n    /* border:1px solid red; */\n    width: 30px;\n    height: 30px;\n    position: absolute;\n    right: 2px;\n    top: 0px;\n    z-index: 100;\n    cursor: pointer;\n}\n\n.form-group {\n    margin-bottom: 10px;\n    overflow: hidden;\n    border: none;\n    background: #fff;\n}\n\n.btns {\n    display: flex;\n    justify-content: center;\n    margin-bottom: 10px;\n}\n\n.webuploader-pick {\n    position: relative;\n    color: #3F77DB;\n    font-size: 16px;\n    text-align: center;\n    border-radius: 4px;\n    overflow: hidden;\n    width: 104px;\n    height: 40px;\n    background: #fff;\n    border: 1px solid #3F77DB;\n}\n\n.webuploader-pick:hover {\n    color: #fff;\n    background: #3F77DB;\n}\n\n.downloadBtn {\n    width: 104px;\n    height: 40px;\n    text-align: center;\n    line-height: 40px;\n    border: 1px solid #3F77DB;\n    border-radius: 4px;\n    font-size: 16px;\n    color: #3F77DB;\n    cursor: pointer;\n    margin: 0 32px;\n}\n\n.downloadBtn:hover {\n    background: #3F77DB;\n    color: #fff;\n}\n\n.downloadBtn:focus {\n    outline: none;\n}\n\n.uploader-list {\n    min-height: 80px;\n    padding: 0 10px;\n    width: 100%;\n    margin-bottom: 26px;\n}\n\n.uploader-list > div {\n    border: none !important;\n    width: 100%;\n    min-height: 68px;\n    background: #fafafa url(../public/images/dialog-file-m.png) no-repeat 21px center;\n    padding-left: 61px;\n    border-radius: 4px;\n    margin-bottom: 20px;\n}\n\n.uploader-list > div:hover {\n    box-shadow: 0px 0px 5px 2px rgba(96, 198, 236, 0.5);\n}\n\n.uploader-list .file_btn {\n    display: block;\n    float: right;\n    width: 40px;\n    height: 68px;\n    cursor: pointer;\n}\n\n.uploader-list .file_btn.file_preview {\n    background: url(../public/images/dialog_pre_m.png) no-repeat center center;\n}\n\n.uploader-list .file_btn.file_delete {\n    margin-right: 15px;\n    background: url(../public/images/dialog_del_m.png) no-repeat center center;\n}\n\n.uploader-list .file_btn.file_preview:hover {\n    background: url(../public/images/dialog_pre_m_hover.png) no-repeat center center;\n}\n\n.uploader-list .file_btn.file_delete:hover {\n    background: url(../public/images/dialog_del_m_hover.png) no-repeat center center;\n}\n\n.uploader-list .info,\n.uploader-list .state {\n    display: inline-block;\n    margin-top: 25px;\n    margin-bottom: 7px;\n}\n\n.uploader-list .progress {\n    height: 6px;\n}\n\n.hint_info {\n    width: 100%;\n    min-height: 89px;\n    padding: 10px;\n}\n\n.btn-default:hover {\n    color: #fff;\n    background-color: #3F77DB;\n    border-color: #3F77DB;\n}\n"
