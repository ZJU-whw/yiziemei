          "content": {
            "size": 77872,
            "mimeType": "text/css",
            "compression": 65560,
            "text": "\n::-webkit-scrollbar-track-piece {\n    background-color: rgba(255, 255, 255, 0);\n    -webkit-border-radius: 6px;\n}\n\n::-webkit-scrollbar {\n    width: 5px;\n    height: 5px;\n    border-radius: 5px;\n}\n\n::-webkit-scrollbar-thumb {\n    background-color: rgba(0, 0, 0, 0.25);\n    background-clip: padding-box;\n    min-height: 28px;\n    padding: 5px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n    background-color: rgba(0, 0, 0, 0.4);\n}\n\n::-webkit-scrollbar-thumb:vertical {\n\n    -webkit-border-radius: 6px;\n}\n\n::-webkit-scrollbar-thumb:horizontal {\n\n    -webkit-border-radius: 6px;\n}\n\n/**\n * @pageName: breadcrumb_nav.less\n **/\n.breadcrumb_nav1,\n.breadcrumb_nav2 {\n    margin-bottom: 0;\n    padding: 20px 32px 0 32px;\n}\n\n.breadcrumb_nav1 > li:first-child > a {\n    padding-left: 1px;\n}\n\n.breadcrumb_nav1 > li:last-child > a,\n.breadcrumb_nav2 > li:last-child > a {\n    color: #3f77db;\n}\n\n.bg_blue .breadcrumb_nav1 > li:last-child > a,\n.bg_blue .breadcrumb_nav2 > li:last-child > a {\n    color: #fff;\n}\n\n.breadcrumb_nav2 > li:first-child > a {\n    padding-left: 1px;\n}\n\n.breadcrumb_nav1 li,\n.breadcrumb_nav2 li {\n    float: left;\n    list-style: none;\n    font-size: 16px;\n}\n\n.breadcrumb_nav1:after,\n.breadcrumb_nav2:after {\n    content: \"\";\n    display: block;\n    height: 0;\n    clear: both;\n    visibility: hidden;\n}\n\n.breadcrumb_nav1 li a {\n    padding: 0 15px;\n    text-decoration: none;\n}\n\n.breadcrumb_nav2 li a {\n    padding: 0 10px;\n    text-decoration: none;\n}\n\n.breadcrumb_nav1 li:last-child i {\n    display: none;\n}\n\n.breadcrumb_nav1 li a,\n.breadcrumb_nav1 li i,\n.breadcrumb_nav2 li a,\n.breadcrumb_nav2 li i {\n    color: #fff;\n}\n\n.breadcrumb_nav1 li a:hover,\n.breadcrumb_nav2 li a:hover {\n    color: #3f77db;\n    cursor: pointer;\n}\n\n.bg_blue .breadcrumb_nav1 li a,\n.bg_blue .breadcrumb_nav1 li i,\n.bg_blue .breadcrumb_nav2 li a,\n.bg_blue .breadcrumb_nav2 li i {\n    color: rgba(255, 255, 255, 0.7);\n}\n\n.bg_blue .breadcrumb_nav1 li a:hover,\n.bg_blue .breadcrumb_nav2 li a:hover {\n    color: #fff;\n}\n\n.breadcrumb_nav2 li span {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    background: #666;\n    color: #fff;\n    font-size: 12px;\n    padding: 3px 6px;\n    margin-left: 7px;\n}\n\n.bg_blue .breadcrumb_nav2 li span {\n    color: #3f77db;\n    background: #fff;\n}\n\n.breadcrumb_nav2 li:last-child span {\n    background: #3f77db;\n}\n\n.bg_blue .breadcrumb_nav2 li:last-child span {\n    background: #fff;\n}\n\n.breadcrumb_nav2 li.disable span {\n    background: #666;\n}\n\n.bg_blue .breadcrumb_nav2 li.disable span {\n    background: rgba(255, 255, 255, 0.7);\n}\n\n.breadcrumb_nav2 li.disable b {\n    padding: 3px 6px;\n    font-size: 16px;\n    margin-left: 7px;\n    color: #666;\n    font-weight: normal;\n}\n\n.bg_blue .breadcrumb_nav2 li.disable b {\n    color: rgba(255, 255, 255, 0.7);\n}\n\n.disImg {\n    margin-left: 5px;\n}\n\n/**\n * @pageName: button&switch.less\n **/\n.btn:focus,\n.btn:active:focus,\n.btn.active:focus,\n.btn.focus,\n.btn:active.focus,\n.btn.active.focus {\n    outline: none;\n}\n\n.btn {\n    width: auto;\n    height: auto;\n    padding: 10px 30px;\n    font-size: 0.16rem;\n    line-height: 0.16rem;\n    border-radius: 0.04rem;\n    border: 1px solid #3F77DB;\n    font-family: Microsoft Yahei;\n    text-align: center;\n    margin: 5px 2px;\n}\n\n/* 按钮大小设置 */\n.btn.btn-l {\n    padding: 15px 40px;\n    font-size: 0.18rem;\n    line-height: 0.18rem;\n}\n\n.btn.btn-s {\n    padding: 7px 20px;\n    font-size: 0.14rem;\n    line-height: 0.14rem;\n}\n\n.btn.btn-xs {\n    padding: 4px 10px;\n    font-size: 0.12rem;\n    line-height: 0.12rem;\n}\n\n.btn.btn-icon {\n    padding: 3px 28px 4px 54px;\n    line-height: 0.22rem;\n}\n\n/* 按钮颜色设置 */\n.btn.default {\n    background-color: #fff;\n    color: #3F77DB;\n}\n\n.btn.default:hover {\n    background: #3F77DB;\n    color: #fff;\n    box-shadow: 0 0 6px 0 #3F77DB;\n}\n\n.btn.danger {\n    background-color: #fff;\n    color: #D9534F;\n    border: 1px solid #D9534F;\n}\n\n.btn.danger:hover {\n    background: #fb404b;\n    color: #fff;\n    box-shadow: 0 0 6px 0 #fb404b;\n}\n\n/* 样式设置 */\n.radius {\n    border-radius: 0.4rem;\n}\n\n.btn.default.fill {\n    background: #3F77DB;\n    color: #fff;\n}\n\n/* switches */\n.switches input[type=\"checkbox\"] {\n    display: none;\n}\n\n.switches input[type=\"checkbox\"] + label {\n    display: inline-block;\n    width: 40px;\n    height: 20px;\n    position: relative;\n    transition: 0.3s;\n    margin: 0px 20px;\n    box-sizing: border-box;\n}\n\n.switches input[type=\"checkbox\"] + label:after {\n    content: '';\n    display: block;\n    position: absolute;\n    left: 0px;\n    top: 0px;\n    width: 20px;\n    height: 20px;\n    transition: 0.3s;\n    cursor: pointer;\n}\n\n#s2:checked + label.red,\n#s3:checked + label.red {\n    background: #ECA9A7;\n}\n\n#s2:checked + label.red:after,\n#s3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#s2:checked + label.blue,\n#s3:checked + label.blue {\n    background: rgba(72, 141, 233, 0.5);\n}\n\n#s2:checked + label.blue:after,\n#s3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#s2:checked + label:after,\n#s3:checked + label:after,\n#s4:checked + label:after {\n    left: calc(100% - 20px);\n}\n\n#s2 + label,\n#s3 + label,\n#s4 + label {\n    background: #ddd;\n    border-radius: 20px;\n    box-shadow: 1px 1px 3px #aaa;\n}\n\n#s2 + label:after,\n#s3 + label:after,\n#s4 + label:after {\n    background: #fff;\n    border-radius: 50%;\n    box-shadow: 1px 1px 3px #aaa;\n}\n\n#md_2:checked + label.red,\n#md_3:checked + label.red {\n    background: #ECA9A7;\n}\n\n#md_2:checked + label.red:after,\n#md_3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#md_2:checked + label.blue,\n#md_3:checked + label.blue {\n    background: rgba(72, 141, 233, 0.5);\n}\n\n#md_2:checked + label.blue:after,\n#md_3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#md_2:checked + label:after,\n#md_3:checked + label:after,\n#md_4:checked + label:after {\n    left: calc(100% - 20px);\n}\n\n#md_2 + label,\n#md_3 + label,\n#md_4 + label {\n    background: #ddd;\n    border-radius: 20px;\n    height: 10px;\n}\n\n#md_2 + label:after,\n#md_3 + label:after,\n#md_4 + label:after {\n    background: #fff;\n    border-radius: 50%;\n    top: -5px;\n    box-shadow: 0px 0px 3px #aaa;\n}\n\n#mds_2:checked + label.red,\n#mds_3:checked + label.red {\n    background: #ECA9A7;\n}\n\n#mds_2:checked + label.red:after,\n#mds_3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#mds_2:checked + label.blue,\n#mds_3:checked + label.blue {\n    background: rgba(72, 141, 233, 0.5);\n}\n\n#mds_2:checked + label.blue:after,\n#mds_3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#mds_2:checked + label:after,\n#mds_3:checked + label:after,\n#mds_4:checked + label:after {\n    left: calc(100% - 20px);\n}\n\n#mds_2 + label,\n#mds_3 + label,\n#mds_4 + label {\n    background: #ddd;\n    height: 3px;\n}\n\n#mds_2 + label:after,\n#mds_3 + label:after,\n#mds_4 + label:after {\n    background: #fff;\n    border-radius: 50%;\n    top: -9px;\n    box-shadow: 0px 0px 3px #aaa;\n}\n\n#border_2:checked + label.red,\n#border_3:checked + label.red {\n    border-color: #ECA9A7;\n}\n\n#border_2:checked + label.red:after,\n#border_3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#border_2:checked + label.blue,\n#border_3:checked + label.blue {\n    border-color: rgba(72, 141, 233, 0.5);\n}\n\n#border_2:checked + label.blue:after,\n#border_3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#border_2:checked + label:after,\n#border_3:checked + label:after {\n    left: calc(100% - 14px);\n}\n\n#border_2 + label,\n#border_3 + label {\n    border: 2px solid #ddd;\n    border-radius: 20px;\n}\n\n#border_2 + label:after,\n#border_3 + label:after {\n    background: #ddd;\n    border-radius: 50%;\n    width: 12px;\n    height: 12px;\n    top: 2px;\n    left: 2px;\n}\n\n#inset_2:checked + label.red,\n#inset_3:checked + label.red {\n    background: #ECA9A7;\n}\n\n#inset_2:checked + label.red:after,\n#inset_3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#inset_2:checked + label.blue,\n#inset_3:checked + label.blue {\n    background: rgba(72, 141, 233, 0.5);\n}\n\n#inset_2:checked + label.blue:after,\n#inset_3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#inset_2:checked + label:after,\n#inset_3:checked + label:after,\n#inset_4:checked + label:after {\n    left: calc(100% - 18px);\n}\n\n#inset_2 + label,\n#inset_3 + label,\n#inset_4 + label {\n    background: #ddd;\n    border-radius: 20px;\n}\n\n#inset_2 + label:after,\n#inset_3 + label:after,\n#inset_4 + label:after {\n    background: #fff;\n    border-radius: 50%;\n    width: 16px;\n    height: 16px;\n    top: 2px;\n    left: 2px;\n}\n\n#box_2:checked + label.red,\n#box_3:checked + label.red {\n    background: #ECA9A7;\n}\n\n#box_2:checked + label.red:after,\n#box_3:checked + label.red:after {\n    background: #D9534F;\n}\n\n#box_2:checked + label.blue,\n#box_3:checked + label.blue {\n    background: rgba(72, 141, 233, 0.5);\n}\n\n#box_2:checked + label.blue:after,\n#box_3:checked + label.blue:after {\n    background: #488de9;\n}\n\n#box_2:checked + label:after,\n#box_3:checked + label:after,\n#box_4:checked + label:after {\n    left: calc(100% - 18px);\n}\n\n#box_2 + label,\n#box_3 + label,\n#box_4 + label {\n    background: #ddd;\n}\n\n#box_2 + label:after,\n#box_3 + label:after,\n#box_4 + label:after {\n    background: #fff;\n    width: 16px;\n    height: 16px;\n    top: 2px;\n    left: 2px;\n}\n\n#s4:checked + label.blue,\n#md_4:checked + label.blue,\n#mds_4:checked + label.blue,\n#inset_4:checked + label.blue,\n#box_4:checked + label.blue {\n    background: #488de9;\n}\n\n.switches {\n    margin-bottom: 20px;\n}\n\n/**\n * @pageName: card.less\n **/\nhtml,\nbody {\n    background: #f3f8ff;\n    background: linear-gradient(90deg, rgba(102, 125, 182, 1) 0%, rgba(102, 125, 182, 1) 0%, rgba(80, 123, 181, 1) 20%, rgba(0, 127, 195, 1) 39%, rgba(0, 126, 196, 1) 59%, rgba(21, 126, 192, 1) 72%, rgba(90, 122, 179, 1) 87%, rgba(102, 125, 181, 1) 100%, rgba(102, 125, 181, 1) 100%);\n}\n\n.bg_blue {\n    height: auto;\n    background: url(../public/images/normal_wings_bg_d.png) repeat-y center center/100% 100%;\n}\n\n.part_parent {\n    overflow: hidden;\n    padding: 0 20px;\n}\n\n.diy-part {\n    background-color: #fff;\n    border-radius: 4px;\n    overflow: auto;\n    margin: 20px 0;\n    padding-bottom: 10px;\n    box-shadow: 0 0 18px rgba(0, 0, 0, 0.18);\n}\n\n.diy-part-firstChild {\n    margin-top: 0px;\n    border-top-left-radius: 0px;\n    border-top-right-radius: 0px;\n}\n\n.diy-part .part_header {\n    position: relative;\n    height: 40px;\n    padding-left: 33px;\n    margin-bottom: 10px;\n    background: #fff url(../public/images/Eject_bg3.png) no-repeat;\n    background-size: 4px 20px;\n    background-position: 20px 10px;\n}\n\n.part_header:after {\n    content: '';\n    position: absolute;\n    left: 20px;\n    bottom: 0;\n    width: calc(100% - 40px);\n    height: 1px;\n    background: rgba(63, 119, 219, 0.3);\n}\n\n.diy-part .part_header span {\n    line-height: 40px;\n    font-size: 16px;\n    color: #666;\n    font-family: Microsoft YaHei;\n    font-weight: bold;\n}\n\n.diy-part .part_subheader {\n    height: 44px;\n    line-height: 44px;\n    padding-left: 30px;\n}\n\n.diy-part .part_subheader span {\n    vertical-align: middle;\n    color: #333;\n    font-size: 16px;\n    font-family: Microsoft YaHei;\n}\n\n.btspan {\n    color: red;\n    font-size: 16px;\n    position: relative;\n    top: 4px;\n    left: -2px;\n}\n\n/**\n * @pageName: chartsl.less\n **/\n.charts {\n    width: 49%;\n    height: 340px;\n    float: left;\n    background: #fff;\n}\n\n/**\n * @pageName: checkbox_radio.less\n **/\n/*单选框和复选框样式优化*/\n.icheckbox_flat-lightblue,\n.iradio_flat-lightblue {\n    display: inline-block;\n    vertical-align: middle;\n    margin: 0;\n    padding: 0;\n    width: 20px;\n    height: 20px;\n    background: url(../public/images/bluetwo.png) no-repeat;\n    border: none;\n    cursor: pointer;\n}\n\n.icheckbox_flat-lightblue {\n    background-position: 0 0;\n}\n\n.icheckbox_flat-lightblue.checked {\n    background-position: -22px 0;\n}\n\n.icheckbox_flat-lightblue.disabled {\n    background-position: -44px 0;\n    cursor: default;\n}\n\n.icheckbox_flat-lightblue.checked.disabled {\n    background-position: -66px 0;\n}\n\n.iradio_flat-lightblue {\n    background-position: -88px 0;\n}\n\n.iradio_flat-lightblue.checked {\n    background-position: -110px 0;\n}\n\n.iradio_flat-lightblue.disabled {\n    background-position: -132px 0;\n    cursor: default;\n}\n\n.iradio_flat-lightblue.checked.disabled {\n    background-position: -154px 0;\n}\n\n/* HiDPI support */\n@media (-webkit-min-device-pixel-ratio: 1.25), (min-resolution: 120dpi), (min-resolution: 1.25dppx) {\n    .icheckbox_flat-lightblue,\n    .iradio_flat-lightblue {\n        background-image: url(../public/images/blue@2xtwo.png);\n        background-size: 176px 22px;\n    }\n}\n\ninput[type=\"radio\"],\ninput[type=\"checkbox\"] {\n    margin-top: 1px \\9;\n    line-height: normal;\n    margin-right: 7px;\n}\n\ninput[type=\"radio\"] {\n    margin-top: -2px;\n    line-height: normal;\n}\n\ninput[type=\"radio\"],\ninput[type=\"radio\"]:checked {\n    background: none;\n}\n\ninput[type=\"checkbox\"]::before {\n    display: block;\n    content: \"\";\n    color: #3F77DB;\n    width: 16px;\n    height: 16px;\n    border: 1px solid #3F77DB;\n    background: #fff;\n}\n\ninput[type=\"checkbox\"]:checked::before {\n    content: \"\\2714\";\n    font-size: 10px;\n    text-align: center;\n    line-height: 15px;\n}\n\ninput[type=\"radio\"]::before {\n    display: block;\n    content: \"\";\n    color: #3F77DB;\n    width: 16px;\n    height: 16px;\n    border: 1px solid rgb(204, 204, 204);\n    border-radius: 100%;\n    background: #fff;\n    top: -1px;\n    left: -1px;\n    position: relative;\n}\n\ninput[type=\"radio\"]:checked::before {\n    background: #fff url(\"../public/images/icon_circle.png\") no-repeat center center;\n    background-size: 50% 50%;\n    color: #3F77DB;\n    border: 1px solid #3F77DB;\n}\n\n/**\n * @pageName: date.less\n **/\n.glyphicon-calendar:before {\n    content: \"\\e109\";\n    color: #3F77DB;\n}\n\nspan.input-group-addon {\n    background: #fff;\n    padding: 6px 10px;\n    border: 1px solid #ccc;\n    border-left: none;\n}\n\n.datetimepicker table tr td.active:active,\n.datetimepicker table tr td.active:hover:active,\n.datetimepicker table tr td.active.disabled:active,\n.datetimepicker table tr td.active.disabled:hover:active,\n.datetimepicker table tr td.active.active,\n.datetimepicker table tr td.active:hover.active,\n.datetimepicker table tr td.active.disabled.active,\n.datetimepicker table tr td.active.disabled:hover.active {\n    background: #3F77DB;\n}\n\n.datetimepicker table tr td span.active:active,\n.datetimepicker table tr td span.active:hover:active,\n.datetimepicker table tr td span.active.disabled:active,\n.datetimepicker table tr td span.active.disabled:hover:active,\n.datetimepicker table tr td span.active.active,\n.datetimepicker table tr td span.active:hover.active,\n.datetimepicker table tr td span.active.disabled.active,\n.datetimepicker table tr td span.active.disabled:hover.active {\n    background: #3F77DB;\n}\n\n.form-horizontal .control-label {\n    color: #737373;\n    font-weight: normal;\n}\n\n.glyphicon-arrow-left:before {\n    content: \"\\e091\";\n    color: #737373;\n}\n\n.glyphicon-arrow-right:before {\n    content: \"\\e092\";\n    color: #737373;\n}\n\n.datetimepicker th.switch {\n    color: #737373;\n}\n\n.datetimepicker thead tr:first-child th:hover,\n.datetimepicker tfoot th:hover,\n.datetimepicker thead tr .prev:hover .glyphicon-arrow-left:before,\n.datetimepicker thead tr .next:hover .glyphicon-arrow-right:before {\n    background: #fff;\n    color: #3F77DB;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form div[wings=\"WingsCalendar\"] input[type=\"text\"]:focus {\n    border-color: #3F77DB;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form div[wings=\"WingsCalendar\"] input[type=\"text\"]:hover {\n    border-color: #3F77DB;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form div[wings=\"WingsCalendar\"] input[type=\"text\"] {\n    padding-left: 10px;\n    border: 1px solid #ccc;\n    border-right: none;\n    box-shadow: none;\n    border-top-right-radius: 0;\n    border-bottom-right-radius: 0;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form div[wings=\"WingsCalendar\"] input[type=\"text\"]:focus + .input-group-addon {\n    border-color: #3F77DB;\n    border-left: none;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form div[wings=\"WingsCalendar\"] input[type=\"text\"]:hover + .input-group-addon {\n    border-color: #3F77DB;\n    border-left: none;\n}\n\n.dropdown-menu {\n    border: 1px solid #3F77DB;\n}\n\n/**\n * @pageName: echarts_map.less\n **/\n.echarts_map {\n    height: 360px;\n    width: 100%;\n}\n\n/**\n * @pageName: file_upload.less\n **/\n.wingsfileupload {\n    background: #fff;\n    border: 1px solid #3F77DB;\n    color: #3F77DB;\n    line-height: 0.32rem;\n    padding: 0 0.3rem;\n    font-size: 0.16rem;\n}\n\n.wingsfileupload:hover {\n    background: #3F77DB;\n    border: 1px solid #3F77DB;\n    color: #fff;\n}\n\n.modal-lg {\n    width: 900px;\n    position: absolute;\n    top: 50%;\n    margin-top: 0 !important;\n    left: 50%;\n    margin-left: 0 !important;\n    transform: translate(-50%, -50%) !important;\n    -webkit-transform: translate(-50%, -50%) !important;\n}\n\n.modal-sm {\n    padding-top: 169px;\n    width: 400px;\n    position: absolute;\n    left: 50%;\n    margin-left: -200px;\n}\n\n.bootstrap-dialog.type-primary .modal-header {\n    background-color: #fff;\n}\n\n.modal-footer {\n    border-top: 1px solid transparent;\n}\n\n.bootstrap-dialog-footer-buttons .btn-default {\n    padding: 5px 20px;\n    color: #499dff;\n    line-height: 1.5;\n}\n\n.bootstrap-dialog-footer-buttons .btn-default:hover {\n    padding: 5px 20px;\n    color: #fff;\n    line-height: 1.5;\n}\n\n/**\n * @pageName: file_upload11111.less\n **/\n.wingsfileupload {\n    background: #fff;\n    border: 1px solid #3F77DB;\n    color: #3F77DB;\n    line-height: 0.32rem;\n    padding: 0 0.3rem;\n    font-size: 0.16rem;\n}\n\n.wingsfileupload:hover {\n    background: #3F77DB;\n    border: 1px solid #3F77DB;\n    color: #fff;\n}\n\n.modal-lg {\n    width: 900px;\n    position: absolute;\n    top: 50%;\n    margin-top: 0 !important;\n    left: 50%;\n    margin-left: 0 !important;\n    transform: translate(-50%, -40%) !important;\n    -webkit-transform: translate(-50%, -40%) !important;\n}\n\n.modal-sm {\n    padding-top: 169px;\n    width: 400px;\n    position: absolute;\n    left: 50%;\n    margin-left: -200px;\n}\n\n.bootstrap-dialog.type-primary .modal-header {\n    background-color: #fff;\n    position: relative;\n}\n\n.bootstrap-dialog.type-primary .modal-header::after {\n    position: absolute;\n    content: \"\";\n    display: block;\n    width: 95%;\n    height: 2px;\n    background: #3F77DB;\n    opacity: 0.3;\n    bottom: 0;\n    left: 2.5%;\n}\n\n.modal-dialog .modal-sm\n.modal-footer {\n    border-top: 1px solid transparent;\n}\n\n.bootstrap-dialog-footer-buttons .btn-icon:first-of-type {\n    background: url(../public/images/icon-qd-blue.png) no-repeat .32rem center / .16rem .1rem\n}\n\n.bootstrap-dialog-footer-buttons .btn-icon:first-of-type:hover {\n    background: url(../public/images/icon-qd.png) no-repeat .32rem center /.16rem .1rem, #3F77DB\n}\n\n.bootstrap-dialog-footer-buttons .btn-icon:last-of-type {\n    background: url(../public/images/icon-qx-blue.png) no-repeat .32rem center / .14rem .14rem\n}\n\n.bootstrap-dialog-footer-buttons .btn-icon:last-of-type:hover {\n    background: url(../public/images/icon-qx.png) no-repeat .32rem center /.14rem .14rem, #3F77DB\n}\n\n/* .bootstrap-dialog-footer-buttons .btn-default {\n  padding: 5px 20px;\n  color: #499dff;\n  line-height: 1.5;\n}\n.bootstrap-dialog-footer-buttons .btn-default:hover {\n  padding: 5px 20px;\n  color: #fff;\n  line-height: 1.5;\n} */\n/**\n * @pageName: font.less\n **/\n@font-face {\n    /* font-properties */\n    font-family: LCDN;\n    src: url('/yxscx/theme/wings/blueWingsNew/public/font/LCDN.TTF'), url('/yxscx/theme/wings/blueWingsNew/public/font/LCDN.TTF');\n    /* IE9 */\n}\n\n/**\n * @pageName: form.less\n **/\ndiv[wings=\"WingsForm\"] table.tab_form th {\n    text-align: right;\n    background: #fff;\n    border: 1px solid transparent;\n    height: 36px;\n    margin: 0;\n    padding: 0;\n    color: #666;\n    font-weight: normal;\n    line-height: 20px;\n    letter-spacing: 1px;\n    padding-right: 5px;\n    font-size: 14px;\n}\n\ndiv[wings=\"WingsForm\"] tr {\n    height: 52px;\n}\n\n.diy-part [wings=\"WingsForm\"] {\n    padding: 0 20px;\n}\n\n.diy-part .tab_detail [wings=\"WingsForm\"] {\n    margin-right: 14px;\n    padding: 0;\n}\n\n.modal_dialog_content div[wings=\"WingsForm\"] {\n    margin-right: 26px;\n}\n\n.infoBox {\n    border: 1px solid #666;\n    min-height: 20px;\n    line-height: 20px;\n    background-color: #fff;\n    color: #333;\n    position: absolute;\n    bottom: -10px;\n    left: 50px;\n    z-index: 1000000;\n    word-wrap: break-word;\n    padding: 2px 10px;\n    font-weight: 500;\n    border-radius: 4px;\n}\n\n/**\n * @pageName: frame_tab.less\n **/\n.container {\n    height: 100%;\n}\n\n.container .row {\n    height: 100%;\n}\n\ndiv[wings=\"WingsAccordion\"] {\n    border: none !important;\n    height: 100%;\n    background: rgba(0, 0, 0, 0.6);\n}\n\n.a-panel-default {\n    border: none;\n}\n\n.panel-title .xm1 {\n    font-size: 14px;\n    border-bottom: none;\n    background: transparent url(../wings/core/plugins/wingsFrameTab/img/D-arrow.png) no-repeat 95% center;\n    color: #fff;\n}\n\ndiv[wings=\"WingsAccordion\"] .panel-body {\n    border-bottom: 1px solid transparent;\n    background: transparent;\n    color: #fff;\n    padding: 0;\n    padding-left: 35px;\n    height: 36px;\n    line-height: 36px;\n    cursor: pointer;\n}\n\ndiv[wings=\"WingsAccordion\"] .panel-body:hover {\n    background: hsla(0, 0%, 100%, 0.23);\n}\n\n.nav1-tabs.background-blue li.active {\n    background-color: #3F77DB;\n}\n\n.right {\n    border-left: none;\n}\n\n#tab-goleft {\n    border-left: none;\n}\n\n#tab-goright {\n    border-right: none;\n}\n\n.nav1-tabs > li > a {\n    color: #3F77DB;\n}\n\n.tabLi .wings_frame_a {\n    padding-right: 20px;\n}\n\n.tabLi {\n    background-color: #fff;\n    padding-left: 5px;\n    padding-right: 5px;\n}\n\n.nav1-tabs.background-blue .right {\n    width: auto;\n    height: auto;\n    border: none;\n}\n\n.l_col-md-3 {\n    padding-left: 0;\n    height: 100%;\n    background: url(../public/images/fengjing.jpg) no-repeat center center;\n    background-size: 100% 100%;\n    width: 280px;\n}\n\n.l-accordion-header {\n    border: none;\n}\n\n.panel {\n    width: 100%;\n    background: none;\n}\n\n.panel-group {\n    margin-bottom: 0;\n}\n\n.panel-group .panel {\n    border-radius: 0;\n}\n\n.l_col-md-9 {\n    width: calc(100% - 280px);\n    height: 100%;\n}\n\n.tab-content {\n    height: calc(100% - 40px);\n}\n\n.tab-content > .active {\n    width: 100%;\n    height: 100%;\n}\n\n.tab-content iframe {\n    width: 100%;\n    height: 100% !important;\n}\n\n.nav1-tabs > li {\n    border-radius: 4px;\n}\n\n/**\n * @pageName: gird.less\n **/\ntable.dataTable {\n    width: calc(100% + 1px);\n}\n\ntable[role=\"grid\"] thead th {\n    height: 36px;\n    font-size: 16px;\n    color: #666;\n    background-color: rgba(63, 119, 219, 0.1);\n    font-family: Microsoft YaHei;\n    font-weight: bold;\n}\n\ntable.dataTable.row-border tbody th,\ntable.dataTable.row-border tbody td,\ntable.dataTable.display tbody th,\ntable.dataTable.display tbody td {\n    border-top: 1px solid #ededed;\n    font-size: 14px;\n    height: 36px;\n    color: #89898a;\n    text-align: center;\n}\n\n.wingsDtTdRight {\n    text-align: right !important;\n    padding-right: 2% !important;\n}\n\n.table-striped .even {\n    background-color: rgba(63, 119, 219, 0.03);\n}\n\ndiv.dataTables_wrapper div.dataTables_paginate {\n    margin: 20px 20px 0;\n    text-align: center;\n    float: none !important;\n}\n\n.dataTables_wrapper .dataTables_paginate .paginate_button {\n    height: 30px;\n    display: inline-block;\n    padding: 5px 10px 0;\n    border-radius: 3px;\n    font-size: 13px;\n    text-decoration: none;\n    cursor: pointer;\n    color: #888 !important;\n    border: 1px solid #d1d1d1;\n    margin-left: 5px;\n    margin-right: 5px;\n}\n\n.dataTables_wrapper .dataTables_paginate .paginate_button:hover {\n    height: 30px;\n    display: inline-block;\n    padding: 4px 10px 0 10px;\n    border-radius: 3px;\n    font-size: 13px;\n    color: #fff !important;\n    background: #3F77DB;\n    border: 1px solid #d1d1d1;\n}\n\n.dataTables_wrapper .dataTables_paginate .paginate_button.current,\n.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {\n    color: #fff !important;\n    background: #3F77DB;\n    border-radius: 3px;\n    border: 1px solid transparent;\n    display: inline-block;\n    padding: 4px 10px 0;\n    font-size: 13px;\n}\n\n.dataTables_wrapper .dataTables_length,\n.dataTables_wrapper .dataTables_filter,\n.dataTables_wrapper .dataTables_info,\n.dataTables_wrapper .dataTables_processing,\n.dataTables_wrapper .dataTables_paginate {\n    color: #999;\n}\n\n.dataTables_wrapper .dataTables_paginate .paginate_button.disabled,\n.dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover,\n.dataTables_wrapper .dataTables_paginate .paginate_button.disabled:active {\n    background: #ededed;\n    color: #999;\n}\n\n.dataTables_length select {\n    width: 50px;\n    height: 25px;\n    border-radius: 3px;\n    font-size: 13px;\n    font-weight: normal;\n    /*复写Chrome和Firefox里面的边框*/\n    border: 1px solid #c2cad8;\n    padding-left: 6px;\n    margin: 0 10px;\n    /*清除默认样式*/\n    appearance: none;\n    -moz-appearance: none;\n    -webkit-appearance: none;\n    /*在选择框的最右侧中间显示小箭头图片*/\n    /*background: url(../img/icon/icon_select.png) no-repeat scroll right center transparent;*/\n    /*为下拉小箭头留出一点位置，避免被文字覆盖*/\n    padding-right: 14px;\n    background: url(\"../public/images/grid-page-down.png\") no-repeat right 6px center;\n    outline: none;\n}\n\n.dataTables_length {\n    color: #666;\n    font-size: 13px;\n}\n\n.form-control:focus,\nselect:focus {\n    color: #888;\n    border-color: #3F77DB;\n}\n\n/*单选框和复选框样式优化*/\n.icheckbox_flat-lightblue,\n.iradio_flat-lightblue {\n    display: inline-block;\n    vertical-align: middle;\n    margin: 0;\n    padding: 0;\n    width: 20px;\n    height: 20px;\n    background: url(../public/images/bluetwo.png) no-repeat;\n    border: none;\n    cursor: pointer;\n}\n\n.icheckbox_flat-lightblue {\n    background-position: 0 0;\n}\n\n.icheckbox_flat-lightblue.checked {\n    background-position: -22px 0;\n}\n\n.icheckbox_flat-lightblue.disabled {\n    background-position: -44px 0;\n    cursor: default;\n}\n\n.icheckbox_flat-lightblue.checked.disabled {\n    background-position: -66px 0;\n}\n\n.iradio_flat-lightblue {\n    background-position: -88px 0;\n}\n\n.iradio_flat-lightblue.checked {\n    background-position: -110px 0;\n}\n\n.iradio_flat-lightblue.disabled {\n    background-position: -132px 0;\n    cursor: default;\n}\n\n.iradio_flat-lightblue.checked.disabled {\n    background-position: -154px 0;\n}\n\n/* HiDPI support */\n@media (-webkit-min-device-pixel-ratio: 1.25), (min-resolution: 120dpi), (min-resolution: 1.25dppx) {\n    .icheckbox_flat-lightblue,\n    .iradio_flat-lightblue {\n        background-image: url(../public/images/blue@2xtwo.png);\n        background-size: 176px 22px;\n    }\n}\n\ninput[type=\"checkbox\"].wingsradio {\n    margin-top: -2px;\n    line-height: normal;\n}\n\ninput[type=\"checkbox\"].wingsradio,\ninput[type=\"checkbox\"].wingsradio:checked {\n    background: none;\n}\n\ninput[type=\"checkbox\"]::before {\n    display: block;\n    content: \"\";\n    color: #666;\n    width: 16px;\n    height: 16px;\n    background: #fff;\n    border: 1px solid rgb(204, 204, 204);\n}\n\ninput[type=\"checkbox\"]:checked::before {\n    content: \"\\2714\";\n    font-size: 10px;\n    text-align: center;\n    line-height: 15px;\n    color: #3F77DB;\n    border: 1px solid #3F77DB;;\n}\n\ninput[type=\"checkbox\"].wingsradio::before {\n    display: block;\n    content: \"\";\n    color: #3F77DB;\n    width: 16px;\n    height: 16px;\n    border: 1px solid #3F77DB;\n    border-radius: 8px;\n    background: #fff;\n}\n\ninput[type=\"checkbox\"].wingsradio:checked::before {\n    content: \"\\2022\";\n    font-size: 30px;\n    text-align: center;\n    line-height: 15px;\n}\n\ninput[type=\"checkbox\"].wingsradio:focus {\n    -webkit-appearance: none;\n    outline: none;\n}\n\n.diy-paddingTop10 {\n    padding-top: 10px;\n}\n\ndiv[wings=\"WingsGrid\"] a {\n    color: #3F77DB;\n}\n\ndiv[wings=\"WingsGrid\"] a:hover {\n    color: #3F77DB;\n}\n\ntable.dataTable.display tbody tr:hover {\n    background: #EAF1FE;\n}\n\ntable.dataTable.display tbody tr:hover td:first-child {\n    position: relative;\n}\n\ntable.dataTable.display tbody tr:hover td:first-child:after {\n    content: \"\";\n    width: 4px;\n    height: 36px;\n    position: absolute;\n    left: 0;\n    top: 0;\n    background: #3F77DB;\n}\n\n/**\n * @pageName: grid_fzbtid.less\n **/\ndiv[fzbtid] table.dataTable.row-border tbody tr,\ndiv[fzbtid] table.dataTable.display tbody tr {\n    border-top: 1px solid #ebebeb;\n    border-bottom: 1px solid #ebebeb;\n    font-size: 14px;\n    height: 36px;\n    color: #89898a;\n}\n\ndiv[fzbtid] table.dataTable thead th {\n    border-left: 1px solid #fff;\n    font-size: 16px;\n    color: #656565;\n    font-weight: 500;\n    height: 36px;\n    border-bottom: none;\n}\n\ndiv[fzbtid] table.dataTable thead tr:nth-child(2) th {\n    border-top: 1px solid #fff;\n}\n\ndiv[fzbtid] table.dataTable thead tr:nth-child(1) th:nth-child(1) {\n    border-left: none;\n}\n\n/**\n * @pageName: input.less\n **/\n.panel-primary > .panel-heading {\n    color: #ffffff;\n    background-color: #3F77DB;\n    border-color: #3F77DB;\n}\n\n.shut-up {\n    background: url(../public/images/up.png) no-repeat;\n    width: 20px;\n    height: 20px;\n    margin: 3px;\n}\n\n.shut-down {\n    background: url(../public/images/down.png) no-repeat;\n    width: 20px;\n    height: 20px;\n    margin: 3px;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form input[type=\"text\"] {\n    height: 32px;\n    width: 100%;\n    border-radius: 4px;\n    padding-left: 10px;\n    border: 1px solid #ccc;\n    outline: none;\n    color: #333;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form input[type=\"text\"]:hover,\ndiv[wings=\"WingsForm\"] table.tab_form input[type=\"text\"]:focus {\n    border-color: #3F77DB;\n}\n\n/**\n * @pageName: input_tree.less\n **/\ninput.inputTree {\n    background: url(\"../public/images/icon_select.png\") no-repeat right 10px center;\n    background-size: 12px 6px;\n}\n\ninput.inputTree:focus {\n    background: url(\"../public/images/icon_select2.png\") no-repeat right 10px center;\n    background-size: 12px 6px;\n}\n\n.menuContent .ztree {\n    /* width: calc(100% + 83px); */\n    height: 254px;\n    background-color: #fff;\n    border: 1px solid #3F77DB;\n    border-top: none;\n}\n\n.menuContent .ztree::-webkit-scrollbar {\n    display: none;\n}\n\ndiv[type=\"pulltree\"] {\n    width: 100%;\n}\n\n.borders .wtreeSpan {\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    height: 32px;\n    padding-right: 33px;\n    line-height: 32px;\n    padding-left: 10px;\n}\n\n.ztree {\n    border: 1px solid transparent;\n    border-top: none;\n    outline: none;\n}\n\n.wtree_down {\n    position: absolute;\n    padding-top: 10px;\n    padding-bottom: 5px;\n    width: 33px;\n    right: 0;\n    margin-right: 1px;\n    margin-top: 4px;\n    display: block;\n    background: url(../public/images/icon_select.png) no-repeat right 10px center;\n    background-size: 12px 6px;\n}\n\n.wingsTreeInputClass:hover {\n    border: 1px solid #3F77DB;\n    border-radius: 4px;\n}\n\n.wingsTreeInputClass:hover .wtreeSpan {\n    border-color: transparent;\n}\n\n/**\n * @pageName: input_tree1.less\n **/\n.ztree > li {\n    border-bottom: 1px solid transparent;\n}\n\n.ztree li ul {\n    height: auto;\n}\n\n.ztree li ul.line {\n    background: none;\n    border-right: 1px solid transparent;\n}\n\n.ztree li span.button {\n    background-image: url(\"../public/images/zTreeStandard.png\");\n}\n\n.ztree li a {\n    padding: 1px 3px 0 0;\n    margin: 9px 0 9px 0;\n    cursor: pointer;\n    height: 17px;\n    color: #333;\n    background-color: transparent;\n    text-decoration: none;\n    vertical-align: top;\n    display: inline-block;\n}\n\n.ztree li a .node_name {\n    font-size: 12px;\n    color: #666;\n    font-weight: 500;\n}\n\n.ztree li a:hover {\n    text-decoration: none;\n}\n\n.ztree li span.button.switch {\n    margin-top: 9px;\n    display: inline-block;\n}\n\n.ztree li span.button.ico_open,\n.ztree li span.button.ico_close,\n.ztree li span.button.ico_docu {\n    margin-right: 4px;\n}\n\n.ztree li span.button.ico_close {\n    margin-right: 2px;\n    vertical-align: top;\n    background-position: -111px 0;\n}\n\n.ztree li a.curSelectedNode {\n    padding-top: 1px;\n    background-color: #fff;\n    opacity: 1;\n    border: 0 solid transparent;\n    height: 17px;\n}\n\n.ztree li a.curSelectedNode .node_name {\n    color: #3f77db;\n}\n\n.ztree li span.button.chk {\n    margin: 9px 3px 0 0;\n}\n\n/**\n * @pageName: input_tree2.less\n **/\n.wtreeDiv {\n    outline: none;\n    border: 1px solid #3F77DB;\n}\n\n/**\n * @pageName: menu.less\n **/\n/* MENU */\n#nav_wings_menu {\n    float: left;\n    margin: 0;\n    padding: 0;\n    border: 1px solid #3F77DB;\n    border-radius: 5px;\n}\n\n#nav_wings_menu li {\n    list-style: none;\n    position: relative;\n    width: 120px;\n    border-bottom: 1px solid #3F77DB;\n    text-align: center;\n}\n\n#nav_wings_menu li:last-child {\n    border-bottom: none;\n}\n\n#nav_wings_menu li a {\n    text-decoration: none;\n    color: #3F77DB;\n    /* background: -moz-linear-gradient(top, black, #3c3c3c 1px, #292929 25px);\n      background: -webkit-gradient(linear, left top, left 25, from(black), color-stop(4%, #3c3c3c), to(#292929)); */\n    display: block;\n    font-size: 14px;\n    line-height: 30px;\n    height: 30px;\n}\n\n#nav_wings_menu li a:hover {\n    background: #3F77DB;\n    color: #fff;\n}\n\n/* Submenu */\n/*lei：所有子菜单隐藏*/\n#nav_wings_menu li ul {\n    display: none;\n    position: absolute;\n    left: 0;\n    top: 100%;\n    padding: 0;\n    margin-left: 3px;\n    border: 1px solid #3F77DB;\n    border-radius: 5px;\n}\n\n/*lei：有子菜单的显示*/\n#nav_wings_menu li:hover > ul {\n    left: 100%;\n    top: 0;\n    display: block;\n}\n\n#nav_wings_menu li ul li,\n#nav_wings_menu li ul li a {\n    float: none;\n}\n\n#nav_wings_menu li ul li {\n    margin-bottom: 0;\n}\n\n#nav_wings_menu li ul li a {\n    display: block;\n}\n\n/* SUBSUB Menu */\n#nav_wings_menu li ul li ul {\n    display: none;\n}\n\n/**\n * @pageName: modal_dialog.less\n **/\n.dialog_l {\n    margin: 26px 13px 0 26px;\n}\n\n.dialog_r {\n    margin: 26px 26px 0 13px;\n}\n\n.diy-part.dialog_l {\n    width: 337px;\n}\n\n.diy-part.dialog_r {\n    width: 885px;\n}\n\n.modal-content .icon-info-sign:before {\n    content: \"\";\n}\n\n.modal-content .modal-header {\n    background: url(../public/images/Eject_bg3.png) no-repeat 10px center / 4px 20px;\n    padding-left: 25px;\n    border-bottom: none;\n}\n\n.modal-content .modal-body body {\n    background: #fff;\n}\n\n.modal_dialog_content {\n    width: 100%;\n    height: 100%;\n    background: #fff;\n    padding-top: 26px;\n}\n\n.fileBtnA {\n    position: relative;\n    display: inline-block;\n    width: auto;\n    padding: 0 20px 0 20px;\n    height: 36px;\n    text-align: center;\n    line-height: 36px;\n    border-radius: 4px;\n    background: #fff;\n    color: #3F77DB;\n    border: 1px solid #3F77DB;\n    margin-bottom: 16px;\n}\n\n.fileBtnA:hover {\n    background: linear-gradient(to right, #FFAD4A 0, #FF9362 50%);\n    background: -webkit-linear-gradient(to right, #FFAD4A 0, #FF9362 50%);\n    color: #fff !important;\n    text-decoration: none;\n    background: #3F77DB;\n}\n\n.fileBtnA input {\n    position: absolute;\n    width: 100%;\n    top: 0;\n    left: 0;\n    bottom: 0;\n    opacity: 0;\n    cursor: pointer;\n}\n\n.file_list {\n    list-style: none;\n    min-height: 57px;\n    height: auto;\n    border: 1px solid #eaeaea;\n    border-radius: 4px;\n    outline: none;\n    margin: 10px 0;\n    line-height: 57px;\n    overflow: hidden;\n    padding: 5px;\n}\n\n.file_list li {\n    display: block;\n    float: left;\n    height: 36px;\n    line-height: 36px;\n    border-radius: 4px;\n    padding-left: 37px;\n    color: #333;\n    font-family: Microsoft YaHei;\n    background: rgba(0, 0, 0, 0.1) url(../public/images/dialog-file-s.png) no-repeat 5px center;\n    margin: 5px;\n}\n\n.file_btn_s {\n    height: 100%;\n    border: none;\n    width: 26px;\n    vertical-align: middle;\n    outline: none;\n}\n\n.file_upload_s {\n    background: transparent url(../public/images/dialog-del-s.png) no-repeat center center;\n    margin-right: 5px;\n}\n\n.file_upload_s:hover {\n    background: transparent url(../public/images/dialog-del-s-hover.png) no-repeat center center;\n}\n\n.file_upload_s::after {\n    content: \"\";\n}\n\n.file_pre_s {\n    background: transparent url(../public/images/dialog_pre_s.png) no-repeat center center;\n}\n\n.file_pre_s:hover {\n    background: transparent url(../public/images/dialog_pre_s_hover.png) no-repeat center center;\n}\n\n.file_download_s {\n    background: transparent url(../public/images/btn_download_u.png) no-repeat center center;\n    margin-left: 20px;\n}\n\n.file_download_s:hover {\n    background: transparent url(../public/images/btn_download.png) no-repeat center center;\n}\n\n.modal-body {\n    padding: 0;\n}\n\n.wings-alert-img {\n    float: none;\n    margin: 0;\n}\n\n/* 对号和叉号的动销 */\n.done {\n    width: 50px;\n    height: 50px;\n    border-radius: 50%;\n    display: block;\n    stroke-width: 2;\n    stroke: #fff;\n    stroke-miterlimit: 10;\n    margin: 10px auto;\n    box-shadow: inset 0px 0px 0px #3F77DB;\n    -webkit-animation: fill-green 0.5s ease-in-out 0.5s forwards, scale 0.3s ease-in-out 0.7s both;\n    animation: fill-green 0.5s ease-in-out 0.5s forwards, scale 0.3s ease-in-out 0.7s both;\n}\n\n.done .circle {\n    stroke-dasharray: 166;\n    stroke-dashoffset: 166;\n    stroke-width: 2;\n    stroke-miterlimit: 10;\n    stroke: #3F77DB;\n    fill: none;\n    -webkit-animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;\n    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;\n}\n\n.done .check {\n    transform-origin: 50% 50%;\n    stroke-dasharray: 48;\n    stroke-dashoffset: 48;\n    -webkit-animation: stroke 0.7s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;\n    animation: stroke 0.7s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;\n}\n\n.error {\n    width: 50px;\n    height: 50px;\n    border-radius: 50%;\n    display: block;\n    stroke-width: 2;\n    stroke: #fff;\n    stroke-miterlimit: 10;\n    margin: 10px auto;\n    box-shadow: inset 0px 0px 0px #e74c3c;\n    -webkit-animation: fill-red 0.5s ease-in-out 0.5s forwards, scale 0.3s ease-in-out 0.7s both;\n    animation: fill-red 0.5s ease-in-out 0.5s forwards, scale 0.3s ease-in-out 0.7s both;\n}\n\n.error .circle {\n    stroke-dasharray: 166;\n    stroke-dashoffset: 166;\n    stroke-width: 2;\n    stroke-miterlimit: 10;\n    stroke: #e74c3c;\n    fill: none;\n    -webkit-animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;\n    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;\n}\n\n.error .line {\n    transform-origin: 50% 50%;\n    stroke-dasharray: 48;\n    stroke-dashoffset: 48;\n    -webkit-animation: stroke 0.7s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;\n    animation: stroke 0.7s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;\n}\n\n.error .line:nth-child(1) {\n    -webkit-animation-delay: 1s;\n    animation-delay: 1s;\n}\n\n.error .line:nth-child(2) {\n    /* Animate */\n    -webkit-animation-delay: 0.7s;\n    animation-delay: 0.7s;\n}\n\n@-webkit-keyframes stroke {\n    100% {\n        stroke-dashoffset: 0;\n    }\n}\n\n@keyframes stroke {\n    100% {\n        stroke-dashoffset: 0;\n    }\n}\n\n@-webkit-keyframes scale {\n    0%,\n    100% {\n        transform: none;\n    }\n    50% {\n        transform: scale3d(1.2, 1.2, 1);\n    }\n    80% {\n        transform: scale3d(0.8, 0.8, 1);\n    }\n}\n\n@keyframes scale {\n    0%,\n    100% {\n        transform: none;\n    }\n    50% {\n        transform: scale3d(1.2, 1.2, 1);\n    }\n    80% {\n        transform: scale3d(0.8, 0.8, 1);\n    }\n}\n\n@-webkit-keyframes fill-green {\n    100% {\n        box-shadow: inset 0px 0px 0px 25px #3F77DB;\n    }\n}\n\n@keyframes fill-green {\n    100% {\n        box-shadow: inset 0px 0px 0px 25px #3F77DB;\n    }\n}\n\n@-webkit-keyframes fill-red {\n    100% {\n        box-shadow: inset 0px 0px 0px 25px #e74c3c;\n    }\n}\n\n@keyframes fill-red {\n    100% {\n        box-shadow: inset 0px 0px 0px 25px #e74c3c;\n    }\n}\n\n.modal-sm .modal-footer .btn-icon {\n    font-size: 0.14rem;\n}\n\n/**\n * @pageName:modalbox.less\n **/\n/*修改头部背景色*/\n.modal-content .modal-header {\n    border-radius: 6px 6px 0 0;\n    color: #333;\n}\n\n.bootstrap-dialog .bootstrap-dialog-title {\n    color: #333;\n}\n\n.modal-footer {\n    border-top: 1px solid transparent;\n}\n\n.modal-footer .btn {\n    margin: 5px 5px 0px 5px;\n}\n\n.modal-content .modal-footer .bootstrap-dialog-footer-buttons .btn-primary:hover,\n.modal-content .modal-footer .bootstrap-dialog-footer-buttons .btn-default:hover {\n    background: #3F77DB;\n    color: #fff;\n}\n\n.modal-content .modal-footer .bootstrap-dialog-footer-buttons .btn-primary,\n.modal-content .modal-footer .bootstrap-dialog-footer-buttons .btn-default {\n    min-width: 90px;\n    min-height: 36px;\n    text-align: center;\n    line-height: 32px;\n    font-size: 14px;\n    padding: 0;\n    border-color: #3F77DB;\n    background-color: #fff;\n    color: #3F77DB;\n}\n\n.icon-warning-sign:before {\n    content: \"\";\n    width: 0px;\n    height: 18px;\n    border-radius: 4px;\n    background-color: transparent;\n}\n\n.close {\n    float: right;\n    font-size: 21px;\n    font-weight: bold;\n    line-height: 1;\n    color: #000;\n    text-shadow: 0 1px 0 #fff;\n    filter: alpha(opacity=20);\n    opacity: 0.2;\n    background-color: #fff;\n    border: 1px solid #3F77DB;\n    width: auto;\n    height: auto;\n    border-radius: 4px;\n}\n\n.close:hover {\n    float: right;\n    font-size: 21px;\n    font-weight: bold;\n    line-height: 1;\n    color: #000;\n    text-shadow: 0 1px 0 #fff;\n    filter: alpha(opacity=20);\n    opacity: 0.2;\n    background-color: #fff;\n    border: 1px solid #3F77DB;\n    width: auto;\n    height: auto;\n    border-radius: 4px;\n}\n\n.close:hover,\n.close:focus {\n    color: #000;\n    text-decoration: none;\n    cursor: pointer;\n    filter: alpha(opacity=50);\n    opacity: 0.5;\n    background-color: #fff;\n    border-color: transparent;\n}\n\n.icon-warning-sign:before {\n    width: 0;\n}\n\n.icon-ok-sign:before {\n    content: \"\";\n}\n\n/**\n * @pageName: move.less\n **/\ndiv[wings=\"wingsMove\"] {\n    background-color: #fff;\n}\n\ndiv[wings=\"wingsMove\"] .wingsTab_main_class .panel-primary > .panel-heading {\n    background-color: #fff;\n    border-color: #fff;\n    color: #000;\n    text-align: left;\n    padding-left: 0px;\n    margin-bottom: 0;\n    font-size: 16px;\n    line-height: 24px;\n}\n\ndiv[wings=\"wingsMove\"] .wingsTab_main_class .panel-primary > .panel-heading:before {\n    content: '';\n    display: inline-block;\n    width: 20px;\n    height: 20px;\n    background: url(../public/images/title_icon_second.png) no-repeat center center;\n    vertical-align: middle;\n    margin-right: 16px;\n}\n\ndiv[wings=\"wingsMove\"] select[multiple],\nselect[size] {\n    border: 1px solid #eaeaea;\n    min-height: 414px;\n    overflow: hidden;\n}\n\ndiv[wings=\"wingsMove\"] select option,\ndiv[wings=\"wingsMove\"] select.form-control option {\n    padding: 3px 10px;\n    color: #333;\n    font-size: 16px;\n}\n\ndiv[wings=\"wingsMove\"] div[type=\"wingsMoveLeft\"] select option,\ndiv[wings=\"wingsMove\"] div[type=\"wingsMoveLeft\"] select.form-control option {\n    color: #999;\n}\n\ndiv[wings=\"wingsMove\"] select option:hover,\ndiv[wings=\"wingsMove\"] select.form-control option:hover,\ndiv[wings=\"wingsMove\"] select option:focus,\ndiv[wings=\"wingsMove\"] select.form-control option:focus {\n    background-color: #fff;\n    color: #3F77DB;\n}\n\ndiv[wings=\"wingsMove\"] select option:active,\ndiv[wings=\"wingsMove\"] select.form-control option:active {\n    background-color: #3F77DB !important;\n    color: #fff !important;\n}\n\ndiv[wings=\"wingsMove\"] .form-control:focus {\n    border-color: #3F77DB;\n    box-shadow: none;\n}\n\ndiv[wings=\"wingsMove\"] td {\n    padding: 0 1% 1% 1%;\n}\n\ndiv[wings=\"wingsMove\"] td:nth-child(2) > div {\n    padding-top: 30px;\n}\n\ndiv[wings=\"wingsMove\"] .btn-default {\n    border: solid 1px #3F77DB;\n    /* padding:0; */\n    /* height:40px */\n}\n\n/*div[wings=\"wingsMove\"] .btn-default:hover {*/\n/*!*color: #fff;*!*/\n/*!*background-color: @color_blue;*!*/\n/*!*border-color: @color_blue;*!*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn .btn-default .btn-block {\n    padding: 0;\n    height: 30px;\n    min-width: 45px;\n}\n\n/*div[wings=\"wingsMove\"] .glyphicon {*/\n/*width: 16px;*/\n/*height: 10px;*/\n/*padding-left: 1px;*/\n/*left: calc(50% - 8px);*/\n/*margin: 0 auto;*/\n/*top:calc(50% - 5px);*/\n/*}*/\ndiv[wings=\"wingsMove\"] .glyphicon-forward:before {\n    color: #3F77DB;\n}\n\n/*div[wings=\"wingsMove\"] .glyphicon-forward {*/\n/*background: url(../public/images/icon-piliangdaoru.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .glyphicon-chevron-right:before {\n    color: #3F77DB;\n}\n\n/*div[wings=\"wingsMove\"] .glyphicon-chevron-right {*/\n/*background: url(../public/images/icon-daoru.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .glyphicon-chevron-left:before {\n    color: #3F77DB;\n}\n\n/*div[wings=\"wingsMove\"] .glyphicon-chevron-left {*/\n/*background: url(../public/images/icon-daochu.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .glyphicon-backward:before {\n    color: #3F77DB;\n}\n\n/*div[wings=\"wingsMove\"] .glyphicon-backward {*/\n/*background: url(../public/images/icon-piliangdaochu.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn-default:hover .glyphicon-forward:before {\n    color: #fff;\n}\n\n/*div[wings=\"wingsMove\"] .btn-default:hover .glyphicon-forward {*/\n/*background: url(../public/images/icon-piliangdaoru-h.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn-default:hover .glyphicon-chevron-right:before {\n    color: #fff;\n}\n\n/*div[wings=\"wingsMove\"] .btn-default:hover .glyphicon-chevron-right {*/\n/*background: url(../public/images/icon-daoru-h.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn-default:hover .glyphicon-chevron-left:before {\n    color: #fff;\n}\n\n/*div[wings=\"wingsMove\"] .btn-default:hover .glyphicon-chevron-left {*/\n/*background: url(../public/images/icon-daochu-h.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn-default:hover .glyphicon-backward:before {\n    color: #fff;\n}\n\n/*div[wings=\"wingsMove\"] .btn-default:hover .glyphicon-backward {*/\n/*background: url(../public/images/icon-piliangdaochu-h.png) 0px 0px no-repeat;*/\n/*background-size: 100% 100%;*/\n/*}*/\ndiv[wings=\"wingsMove\"] .btn-warning,\ndiv[wings=\"wingsMove\"] .btn-primary {\n    color: #3F77DB;\n    background-color: #fff;\n    border-color: #3F77DB;\n}\n\ndiv[wings=\"wingsMove\"] .btn-primary:hover,\n.btn-primary:active:hover,\n.btn-warning:focus,\n.btn-primary:focus,\n.btn-primary.focus,\n.btn-warning:hover,\n.btn-warning:active:hover {\n    /*border-color: @color_blue;*/\n    /*background-color: @color_blue;*/\n}\n\ndiv[wings=\"wingsMove\"] .btn-warning:active:focus,\ndiv[wings=\"wingsMove\"] .btn-primary:active:focus,\ndiv[wings=\"wingsMove\"] .btn-default:active {\n    color: #fff;\n    background-color: #3F77DB;\n    border-color: #3F77DB;\n}\n\ndiv[wings=\"wingsMove\"] .btn-block:nth-last-child(2),\n.btn-block:nth-last-child(4) {\n    margin-top: 30px;\n}\n\ndiv[type=\"wingsMoveButton\"] .btn:hover {\n    color: #fff;\n    background-color: #3F77DB;\n}\n\n/**\n * @pageName: progressbar.less\n **/\n.spinner > div {\n    background-color: transparent !important;\n}\n\n.spinner {\n    background-color: #3F77DB;\n    width: 360px;\n    height: 100px;\n}\n\n.progress-striped .progress-bar {\n    background-color: #3F77DB;\n    background-image: none;\n    /*background-image: -webkit-linear-gradient(45deg, rgba(255, 255, 255, .15) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, .15) 50%, rgba(255, 255, 255, .15) 75%, transparent 75%, transparent);*/\n}\n\n.uploader-list > div {\n    border: 1px solid transparent !important;\n}\n\n/**\n * @pageName: search.less\n **/\n.wingsSearch {\n    width: 100%;\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form .wingsSearch input[type=\"text\"] {\n    width: 70%;\n    float: left;\n    border-top-right-radius: 0;\n    border-bottom-right-radius: 0;\n    border: 1px solid #3F77DB;\n    border-right: none;\n}\n\n.wingsSearch button {\n    float: left;\n    height: 32px;\n    color: #fff;\n    font-size: 12px;\n    text-align: center;\n    outline: none;\n}\n\n.wingsSearch .search_del {\n    border: 1px solid #3F77DB;\n    border-left: none;\n    width: 10%;\n    padding: 0;\n    background: #fff url(../public/images/btn_deny.png) no-repeat center center;\n    border-radius: 0;\n}\n\n.wingsSearch .search_btn {\n    width: 20%;\n    border-radius: 0 4px 4px 0;\n    background: #3F77DB;\n    border: 1px solid #3F77DB;\n}\n\n/**\n * @pageName: select.less\n **/\n.wingsSelect_down_img {\n    background: url(../public/images/icon_select.png) no-repeat center center;\n    background-size: 12px 6px;\n    width: 36px;\n    height: 36px;\n    border: 1px solid #eaeaea;\n    border-left: none;\n    border-bottom-right-radius: 4px;\n    border-top-right-radius: 4px;\n}\n\n.wingsSelect-list {\n    border: 1px solid transparent;\n    background: #fff;\n    border-radius: 0 0 4px 4px;\n}\n\n.wingsSelect-list-inner div {\n    height: 40px;\n    line-height: 40px;\n    color: #646464;\n    padding: 0 0 0 19px;\n}\n\n.wingsSelect-list .wingsSelect-selected {\n    height: 40px;\n    line-height: 40px;\n    color: #3F77DB;\n    background: #fff;\n    padding: 0 0 0 19px;\n}\n\n.wingsSelect-list .wingsSelect-selected-fix {\n    height: 40px;\n    line-height: 40px;\n    color: #3F77DB;\n    background: #fff;\n    padding: 0 0 0 19px;\n}\n\n.wingsSelect-list {\n    border: 1px solid #3F77DB;\n    /* width: 450px!important; */\n}\n\ndiv[wings=\"WingsForm\"] table.tab_form td {\n    border: 0 solid transparent;\n    background-color: #fff;\n    height: 27px;\n    line-height: 27px;\n    font-weight: 100;\n    margin: 0;\n    padding: 0;\n}\n\ndiv[wings=\"WingsForm\"] div[type=\"select\"] .wingsSelect-table .wingsSelect-td1 {\n    width: 100%;\n}\n\ndiv[wings=\"WingsForm\"] div[type=\"select\"] input[type=\"text\"] {\n    border-radius: 4px;\n    height: 32px;\n    width: 100%;\n}\n\ndiv[wings=\"WingsForm\"] div[type=\"select\"] input[disabled=\"disabled\"] {\n    background: #eee;\n}\n\n.x-trigger-cell {\n    display: none;\n}\n\n.wingsSelect_input_self {\n    background: url(../public/images/icon_select.png) no-repeat right 10px center;\n    background-size: 12px 6px;\n}\n\n/**\n * @pageName: side_bar.less\n **/\nhtml,\nbody {\n    width: 100%;\n    height: 100%;\n}\n\n.side_bar {\n    width: 0;\n    height: calc(100% - 70px);\n    position: fixed;\n    left: 0;\n    top: 70px;\n    background-color: #ffffff;\n    box-shadow: 0 0 18px 0 rgba(0, 0, 0, 0.18);\n    border-radius: 0 4px 0 0;\n}\n\n.side_bar_content {\n    display: none;\n    border-radius: 0 4px 0 0;\n}\n\n.side_bar_switch {\n    width: 18px;\n    height: 140px;\n    background: url(\"../public/images/zhankai.png\") no-repeat center center;\n    background-size: 100% 100%;\n    position: absolute;\n    top: calc(50% - 35px);\n    left: 0;\n    cursor: pointer;\n}\n\n.side_bar .two {\n    border-radius: 0 4px 0 0;\n}\n\n.side_bar .nav-tabs > li > a {\n    padding: 8px 15px;\n    color: #999;\n    font-size: 16px;\n}\n\n.side_bar_operation {\n    padding: 10px 0;\n}\n\n.side_bar_operation:after {\n    content: \"\";\n    display: block;\n    height: 0;\n    clear: both;\n    visibility: hidden;\n}\n\n.side_bar_operation .search {\n    /* width: 188px; */\n    height: 26px;\n    border-radius: 4px;\n    border: solid 1px #3F77DB;\n    float: left;\n    margin-left: 20px;\n}\n\n.side_bar_operation .search input {\n    width: 160px;\n    height: 24px;\n    padding-left: 10px;\n    border: none;\n    color: #333;\n    float: left;\n}\n\n.side_bar_operation .search a {\n    display: inline-block;\n    width: 24px;\n    height: 24px;\n    background: url(\"../public/images/btn_find.png\") no-repeat center center;\n    background-size: 12px 12px;\n    cursor: pointer;\n    float: left;\n}\n\n.side_bar_operation .search a:active {\n    background-size: 15px 15px;\n}\n\n.side_bar_delete {\n    width: 26px;\n    height: 26px;\n    border-radius: 4px;\n    border: solid 1px #3F77DB;\n    float: left;\n    margin-left: 12px;\n    background: url(\"../public/images/btn_tovoid.png\") no-repeat center center;\n    background-size: 13px 13px;\n    cursor: pointer;\n}\n\n.side_bar_delete:hover {\n    background: #3F77DB url(\"../public/images/btn_tovoid_hover.png\") no-repeat center center;\n    background-size: 13px 13px;\n}\n\n.side_bar_back {\n    width: 26px;\n    height: 26px;\n    border-radius: 4px;\n    border: solid 1px #3F77DB;\n    float: left;\n    margin-left: 10px;\n    background: url(\"../public/images/btn_last.png\") no-repeat center center;\n    background-size: 13px 13px;\n    cursor: pointer;\n}\n\n.side_bar_back:hover {\n    background: #3F77DB url(\"../public/images/btn_last_hover.png\") no-repeat center center;\n    background-size: 13px 13px;\n}\n\n.side_bar .tab-content {\n    height: calc(100% - 89px);\n    z-index: 1000;\n    overflow: auto;\n}\n\n/*滚动条高宽及背景 高宽分别对应横竖滚动条的尺寸*/\n.side_bar .tab-content::-webkit-scrollbar {\n    width: 10px;\n    height: 10px;\n    background-color: #F5F5F5;\n}\n\n/*定义滚动条轨道 内阴影+圆角*/\n.side_bar .tab-content::-webkit-scrollbar-track {\n    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);\n    border-radius: 5px;\n    background-color: #F5F5F5;\n}\n\n/*定义滑块 内阴影+圆角*/\n.side_bar .tab-content::-webkit-scrollbar-thumb {\n    border-radius: 5px;\n    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);\n    background-color: #999;\n}\n\n.side_bar .ztree {\n    width: 300px;\n    height: auto !important;\n    color: #666;\n    font-size: 14px;\n    padding: 0 20px;\n}\n\n.side_bar .ztree li span.button.chk {\n    display: none;\n}\n\n/**\n * @pageName: side_bar_ztree.less\n **/\n.side_bar_ztree .ztree li span.button.chk {\n    display: inline-block;\n}\n\n.side_bar_ztree .ztree li span.button {\n    background-image: url(../public/images/zTreeStandard.png);\n}\n\n.side_bar_ztree .ztree li span.button.switch {\n    margin-top: 0;\n}\n\n.side_bar_ztree .ztree li a .node_nam {\n    font-size: 14px;\n}\n\n.side_bar_ztree .ztree li {\n    margin-top: 10px;\n}\n\n.side_bar_ztree .ztree li:hover {\n    text-decoration: none;\n}\n\n.side_bar_ztree .ztree li ul.line {\n    margin-top: 10px;\n}\n\n.side_bar_ztree .ztree li ul.line {\n    background: none;\n}\n\n.side_bar_ztree .ztree li a.curSelectedNode {\n    background-color: #fff;\n    border: none;\n    text-decoration: none;\n}\n\n.side_bar_ztree .ztree li span.button.add {\n    margin-left: 2px;\n    background-position: -144px 0;\n    vertical-align: top;\n}\n\n.side_bar_ztree .ztree li span.button.edit {\n    margin: 0 5px;\n}\n\n.side_bar_ztree .ztree li a:hover {\n    text-decoration: none;\n}\n\n/**\n * @pageName: suggest.less\n **/\ndiv[wings=\"wingsSuggest\"] .input-group .form-control:last-child,\ndiv[wings=\"wingsSuggest\"] .input-group .form-control:first-child {\n    border-top-right-radius: 0;\n    border-bottom-right-radius: 0;\n    width: calc(100% - 64px);\n    height: 36px;\n    border: 1px solid #3F77DB;\n    border-right: none;\n    box-shadow: none;\n    padding-left: 10px;\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n}\n\ndiv[wings=\"wingsSuggest\"] .input-group-btn:last-child > .btn {\n    height: 35px;\n    width: 30px;\n    background: #3F77DB;\n    vertical-align: top;\n    border-top-right-radius: 4px;\n    border-bottom-right-radius: 4px;\n    padding: 0 58px 0 2px;\n    border: 1px solid #3F77DB;\n    outline: none;\n    font-size: 12px;\n    color: #fff;\n    font-family: Microsoft YaHei;\n}\n\ndiv[wings=\"wingsSuggest\"] .input-group-btn:last-child > .btn::after {\n    content: \"立即搜索\";\n}\n\ndiv[wings=\"wingsSuggest\"] .btn-default:hover {\n    background: #fff;\n}\n\ndiv[wings=\"wingsSuggest\"] .caret {\n    border: none;\n}\n\ndiv[wings=\"wingsSuggest\"] .form-control {\n    font-size: 12px;\n    display: inline-block;\n    border-radius: 4px;\n    box-sizing: border-box;\n    vertical-align: top;\n    border: 1px solid #3F77DB;\n}\n\ndiv[wings=\"wingsSuggest\"] .form-control::-moz-placeholder {\n    color: #999;\n    text-indent: 10px;\n}\n\ndiv[wings=\"wingsSuggest\"] .form-control:-ms-input-placeholder {\n    color: #999;\n    text-indent: 10px;\n}\n\ndiv[wings=\"wingsSuggest\"] .form-control::placeholder {\n    color: #999;\n    text-indent: 10px;\n}\n\ndiv[wings=\"wingsSuggest\"] input[type=\"text\"]:focus {\n    border: 1px solid #3F77DB;\n}\n\ndiv[wings=\"wingsSuggest\"] .input-group {\n    width: 100%;\n}\n\n.page_head {\n    width: 400px;\n}\n\n.page_head div[wings=\"wingsSuggest\"] .input-group .form-control {\n    vertical-align: middle;\n}\n\n.page_head div[wings=\"wingsSuggest\"] .input-group .form-control:last-child,\n.page_head div[wings=\"wingsSuggest\"] .input-group .form-control:first-child,\n.page_head div[wings=\"wingsSuggest\"] .input-group-btn:last-child > .btn {\n    height: 50px;\n    vertical-align: middle;\n}\n\n/**\n * @pageName: tab1.less\n **/\n/*移入tab时改变鼠标样式*/\n.nav-tabs > li {\n    cursor: pointer;\n    padding-top: 0;\n}\n\n/*修改tab栏背景样式*/\n.one {\n    background: #f5f5f6;\n    border-bottom: 1px solid #f5f5f6;\n}\n\n.one a {\n    background: #3f77db;\n    color: #fff;\n    font-weight: normal;\n    font-size: 17px;\n}\n\n.one .nav-tabs {\n    border-bottom: none;\n}\n\n.one > li > a {\n    position: relative;\n    color: #555555;\n    font-size: 18px;\n    padding: 9px 22px 9px 28px;\n    background: #f5f5f6 url(../public/images/Eject_bg2.jpg) no-repeat 10px 8px;\n    background-size: 4px 26px;\n    cursor: pointer;\n}\n\n.one > li.active a {\n    background: #fff url(../public/images/Eject_bg3.png) no-repeat 10px 8px;\n    background-size: 4px 26px;\n    color: #333;\n}\n\n.one > li.active a:hover {\n    background: #fff url(../public/images/Eject_bg3.png) no-repeat 10px 8px;\n    background-size: 4px 26px;\n    cursor: pointer;\n}\n\n.tab_detail {\n    padding: 10px 20px;\n}\n\n/**\n * @pageName: tab2.less\n **/\n.two .line {\n    display: none;\n}\n\n.two {\n    border-bottom: solid 1px #dddddd;\n}\n\n.two li {\n    margin: 0;\n}\n\n.two .nav-tabs > li > a {\n    border-bottom: 1px solid transparent;\n    transition: all 0.3s ease-in 0s;\n    -moz-transition: all 0.3s ease-in 0s;\n    -webkit-transition: all 0.3s ease-in 0s;\n    -o-transition: all 0.3s ease-in 0s;\n}\n\n.two > li.active > a,\n.two > li.active > a:hover,\n.two > li.active > a:focus {\n    color: #3F77DB;\n    border-bottom: 2px solid #3F77DB;\n}\n\n.nav-tabs > li > a:hover {\n    border-color: transparent;\n}\n\n/**\n * @pageName: tab3.less\n **/\n.tab_three li.active a {\n    background: #fff url(../public/images/Eject_bg3.png) no-repeat 20px center /4px 20px;\n    color: #333;\n}\n\n.tab_three > li > a {\n    color: #555555;\n    font-size: 18px;\n    padding: 9px 22px 9px 33px;\n    background: #f5f5f6 url(../public/images/Eject_bg2.jpg) no-repeat 20px center/4px 20px;\n}\n\n.tab_three {\n    background: #f5f5f6;\n    border-bottom: 1px solid #f5f5f6;\n}\n\n/**\n * @pageName: tab_page.less\n **/\nul,\nli {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n}\n\n.bg_blue .tab-header a,\n.bg_blue .tab-header a:hover,\n.bg_blue .tab-header a:active,\n.bg_blue .tab-header a:focus {\n    text-decoration: none;\n    color: #fff;\n    font-family: Microsoft YaHei;\n}\n\n.tab-header a,\n.tab-header a:hover,\n.tab-header a:active,\n.tab-header a:focus {\n    text-decoration: none;\n    color: #333;\n    font-family: Microsoft YaHei;\n}\n\n.tab-header {\n    height: 40px;\n}\n\n.bg_blue .tab-header {\n    background: rgba(0, 0, 0, 0.1);\n}\n\n.tab-header {\n    background: rgba(102, 102, 102, 0.2);\n}\n\n.tab-header li {\n    height: 40px;\n    line-height: 40px;\n    padding: 0 50px 0 20px;\n    float: left;\n    position: relative;\n}\n\n.tab-header li.line {\n    padding: 0;\n    height: 28px;\n    margin-top: 6px;\n    border-right: 1px solid rgba(102, 102, 102, 0.3);\n}\n\n.bg_blue .tab-header li.line {\n    border-right: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.tab-header li .home_page {\n    display: inline-block;\n    vertical-align: middle;\n    width: 20px;\n    height: 20px;\n    background: url(../public/images/icon-sy.png) no-repeat center center;\n    background-size: 100% 100%;\n    cursor: pointer;\n}\n\n.bg_blue .tab-header li .home_page {\n    background: url(../public/images/icon-zhuye.png) no-repeat center center;\n}\n\n.tab-header li:first-child {\n    padding: 0 20px;\n}\n\n.bg_blue .tab-header li:not(:first-child):not(:nth-child(2)):after {\n    content: \"\";\n    position: absolute;\n    right: 20px;\n    top: 15px;\n    width: 10px;\n    height: 10px;\n    background: url(../public/images/icon-guanbi.png) no-repeat center center;\n    background-size: 100% 100%;\n    cursor: pointer;\n}\n\n.tab-header li:not(:first-child):not(:nth-child(2)):after {\n    content: \"\";\n    position: absolute;\n    right: 20px;\n    top: 15px;\n    width: 10px;\n    height: 10px;\n    background: url(../public/images/icon-guanbi2.png) no-repeat center center;\n    background-size: 100% 100%;\n    cursor: pointer;\n}\n\n.bg_blue .tab-header li.active {\n    -webkit-animation: fade-in 600ms ease-out 0s 1 normal forwards;\n    animation: fade-in 600ms ease-out 0s 1 normal forwards;\n}\n\n@-webkit-keyframes fade-in {\n    from {\n        background: transparent;\n    }\n    to {\n        background: rgba(255, 255, 255, 0.1);\n    }\n}\n\n@keyframes fade-in {\n    from {\n        background: transparent;\n    }\n    to {\n        background: rgba(255, 255, 255, 0.1);\n    }\n}\n\n.tab-header li.active {\n    -webkit-animation: fade-in2 600ms ease-out 0s 1 normal forwards;\n    animation: fade-in2 600ms ease-out 0s 1 normal forwards;\n}\n\n@-webkit-keyframes fade-in2 {\n    from {\n        background: transparent;\n    }\n    to {\n        background: #f3f8ff;\n    }\n}\n\n@keyframes fade-in2 {\n    from {\n        background: transparent;\n    }\n    to {\n        background: #f3f8ff;\n    }\n}\n\n/**\n * @pageName: textarea.less\n **/\n.form-horizontal .control-label {\n    color: #333;\n    font-weight: normal;\n    line-height: 36px;\n    letter-spacing: 1px;\n}\n\ntextarea {\n    resize: vertical;\n    min-height: 72px;\n    width: 100%;\n    font-size: 14px;\n    color: #333;\n    font-weight: normal;\n    line-height: 22px;\n    padding-top: 10px;\n    padding-left: 15px;\n    background-color: #fff;\n    border-radius: 4px;\n    margin: 8px 0;\n    border: 1px solid #ccc;\n}\n\ntextarea:focus {\n    border-color: #3F77DB;\n    box-shadow: none;\n    outline: none;\n}\n\ntextarea[disabled=\"disabled\"] {\n    background: #eee;\n}\n\n/**\n * @pageName: toolbar.less\n **/\n.btn-toolbar div {\n    float: left;\n    cursor: pointer;\n}\n\n.wingToolbarStyle {\n    background-color: #fff;\n    height: auto;\n    z-index: 0;\n}\n\n/* --------------- */\ndiv[data-name=\"add\"] {\n    background: #fff url(../public/images/btn_add.png) no-repeat;\n}\n\ndiv[data-name=\"add\"]:hover {\n    background: #3F77DB url(../public/images/btn_add_hover.png) no-repeat;\n}\n\ndiv[data-name=\"add\"]:active {\n    background: #4cb2dc url(../public/images/btn_add_hover.png) no-repeat;\n}\n\ndiv[data-name=\"add\"].unused {\n    background: #fff url(../public/images/btn_add_u.png) no-repeat;\n}\n\ndiv[data-name=\"close\"] {\n    background: #fff url(../public/images/btn_close.png) no-repeat;\n}\n\ndiv[data-name=\"close\"]:hover {\n    background: #3F77DB url(../public/images/btn_close_hover.png) no-repeat;\n}\n\ndiv[data-name=\"close\"]:active {\n    background: #4cb2dc url(../public/images/btn_close_hover.png) no-repeat;\n}\n\ndiv[data-name=\"close\"].unused {\n    background: #fff url(../public/images/btn_close_u.png) no-repeat;\n}\n\ndiv[data-name=\"print\"] {\n    back