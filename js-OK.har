            "mimeType": "text/javascript",
            "compression": 33221,
            "text": "/**\n * \n */\n(function($) {\n\t$.fn.dataTable.Api.register( 'column().title()', function () {\n\t    var colheader = this.header();\n\t    return $(colheader).text().trim();\n\t});\n\t$.fn.dataTable.Api.register( 'column().data().sum()', function () {\n\t    return this.reduce( function (a, b) {\n\t        var x = parseFloat( a ) || 0;\n\t        var y = parseFloat( b ) || 0;\n\t        return x + y;\n\t    } );\n\t});\n\t$.fn.dataTable.Api.register('columns().header().hideMenuList()',function(excludeCols,unhideCols){\n\t\tvar table = this.table();\n\t\thideMenuList(table,excludeCols,unhideCols);\n\t});\n\tvar hideMenuList = function (table,excludeCols,unhideCols){\n\t\tvar li ='';\n\t\t//构建下拉菜单\n\t\t$(table.columns().header()).each(function(i,e){\n\t\t\tif(excludeCols.indexOf(i)>=0){\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\tif(unhideCols.indexOf(i)>=0){\n\t\t\t\tli+= '<li><a tabindex=\\\"-1\\\" href=\\\"#\\\">'+$(e).text()+'</a></li>';\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\tli+= '<li><a tabindex=\\\"-1\\\" href=\\\"#\\\"><input type=\"checkbox\" checked=\"checked\" class=\"headerdropdown\" dTcolumnIndex=\"'+i+'\" >'+$(e).text()+'</input></a></li>';\n\t\t});\n\t\tfunction setHeaderCheckBox(){\n\t\t\tvar allvisible = table.columns().visible();\n\t\t\t$(allvisible).each(function(i,e){\n\t\t\t\tvar $ckbox = $(table.columns().header()).find('[dTcolumnIndex=\"'+i+'\"]');\n\t\t\t\tif($ckbox.length!=0){\n\t\t\t\t\tif(e){\n\t\t\t\t\t\t$ckbox.prop('checked',true);\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$ckbox.prop('checked',false);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t});\n\t\t\t\n\t\t}\n\t\t$(table.columns().header()).each(function(i,e){\n\t\t\tif(excludeCols.indexOf(i)>=0){\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\tvar html =$(e).html();\n\t\t\tvar html1 = '<div class=\\\"btn-group\\\"> <div  class=\\\"dropdown-toggle\\\"data-toggle=\\\"dropdown\\\" aria-expanded=\\\"false\\\">'+html+'<span class=\\\"caret\\\"></span> </div> <ul class=\\\"dropdown-menu\\\">'+li+'</ul> </div>';\n\t\t\t$(e).empty().append(html1);\n\t\t\t$(e).find(\".dropdown-toggle\").click(function(e){\n\t\t\t\t$('.dropdown-toggle').dropdown();\n\t\t\t\treturn false;\n\t\t\t});\n\t\t\t$(e).find('.headerdropdown').each(function(i,e){\n\t\t\t\t$(e).change(function(i,e){\n\t\t\t\t\tvar columnIndex = $(this).attr('dTcolumnIndex');\n\t\t\t\t\tif($(this).is(':checked')){\n\t\t\t\t\t\ttable.column(columnIndex).visible(true);\n\t\t\t\t\t\tsetHeaderCheckBox();\n\t\t\t\t\t\t$(table.columns().header()).find('.btn-group').removeClass('open');\n\t\t\t\t\t}else{\n\t\t\t\t\t\ttable.column(columnIndex).visible(false);\n\t\t\t\t\t\tsetHeaderCheckBox();\n\t\t\t\t\t\t$(table.columns().header()).find('.btn-group').removeClass('open');\n\t\t\t\t\t}\n\t\t\t\t\treturn false;\n\t\t\t\t});\n\t\t\t});\n\t\t});\n\t}\n\t$.fn.dataTable.Api.register('columns().header().show()',function(boolean){\n\t\tvar table = this.table();\n\t\tif(boolean){\n\t\t\t$(table.columns().header()).parent().parent().show();\n\t\t}else{\n\t\t\t$(table.columns().header()).parent().parent().hide();\n\t\t}\n\t});\n\t$.fn.wingsPaging = function(options){\n\t\tvar paging = this;\n\t\tvar $paging = $(this);\n\t\tvar opts = $.extend(true,{},$.fn.wingsPaging.defaults,options);\n\t\tcreatePaging();\n\t\tthis.init = function(){\n\t\t\treturn $paging.wingsPaging(options);\n\t\t}\n\t\tthis.loadPage = function(pageNum){\n\t\t\tvar data = null;\n\t\t\tif(opts.cache.data!=null&&opts.cache.data.trs!=null){\n\t\t\t\tdata = getPageDataInCache(pageNum);\n\t\t\t}\n\t\t\tif(data==null){\n\t\t\t\tif(opts.ajax.url!=null){\n\t\t\t\t\tdata = getPageDataByAjax(pageNum)\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn data;\n\t\t}\n\t\tthis.paging = function(pageNum,isLoad){\n\t\t\t\n\t\t\tif(pageNum!=null&&pageNum<=opts.totalPages){\n\t\t\t\topts.pageNum = pageNum;\n\t\t\t}\n\t\t\tvar cacheStatus = null;\n\t\t\tif(opts.cache.data!=null&&opts.cache.data.trs!=null){\n\t\t\t\tcacheStatus = paging.cache();\n\t\t\t}else{\n\t\t\t\tcacheStatus = null;\n\t\t\t}\n\t\t\t//【lei】修改点击搜索后，后台翻页gird会自己再访问一次的问题 2019/03/13\n//\t\t\tif(cacheStatus==null||cacheStatus.data.trs.length<this.getPageSize()){ //旧\n\t\t\tif((cacheStatus==null||cacheStatus.data.trs.length<this.getPageSize())\n\t\t\t\t\t&& isLoad != \"search\"){ //新\n\t\t\t\tif(opts.ajax.url!=null&&opts.cache.loadType==2){\n\t\t\t\t\tpaging.ajax();\n\t\t\t\t}\n\t\t\t}\n\t\t\topts.pagingCallback();\n\t\t\tthis.refreshInfo();\n\t\t}\n\t\tthis.lastPage = function(){\n\t\t\topts.pageNum--;\n\t\t\topts.pageNum = opts.pageNum>0?opts.pageNum:1;\n\t\t\tvar cacheStatus = null;\n\t\t\tif(opts.cache.data!=null&&opts.cache.data.trs!=null){\n\t\t\t\tcacheStatus = paging.cache();\n\t\t\t}else{\n\t\t\t\tcacheStatus = null;\n\t\t\t}\n\t\t\tif(cacheStatus==null){\n\t\t\t\tif(opts.ajax.url!=null){\n\t\t\t\t\tpaging.ajax();\n\t\t\t\t}\n\t\t\t}\n\t\t\topts.pagingCallback();\n\t\t\tthis.refreshInfo();\n\t\t}\n\t\tthis.nextPage = function(){\n\t\t\t//页数变更\n\t\t\topts.pageNum++;\n\t\t\topts.pageNum = opts.pageNum>opts.totalPages?opts.totalPages:opts.pageNum;\n\t\t\t//查询缓存\n\t\t\tvar cacheStatus = null;\n\t\t\tif(opts.cache.data!=null){\n\t\t\t\tcacheStatus = paging.cache();\n\t\t\t}else{\n\t\t\t\tcacheStatus = null;\n\t\t\t}\n\t\t\t//查询后台\n\t\t\tif(cacheStatus==null){\n\t\t\t\tif(opts.ajax.url!=null){\n\t\t\t\t\tpaging.ajax();\n\t\t\t\t}\n\t\t\t}\n\t\t\topts.pagingCallback();\n\t\t\tthis.refreshInfo();\n\t\t}\n\t\tthis.cache = function(){\n\t\t\t//构建回调接口数据格式\n//\t\t\tvar cacheArray = $.extend(true,cacheArray,opts.cache.data); \n//\t\t\tcacheArray = {data:{cacheArray}};\n//\t\t\tcacheArray.data.pageNum = opts.pageNum;\n//\t\t\tcacheArray.data.rows = opts.pageSize;\n//\t\t\t\n//\t\t\tcacheArray.data.trs =[];\n\t\t\tvar showArray = {data:{trs:[]}};\n\t\t\tvar trs = opts.cache.data.trs;\n\t\t\tvar isExsit = false;\n\t\t\t//取出当前页的数据\n\t\t\t$(trs).each(function(i,e){\n\t\t\t\tif(e.pageNum==opts.pageNum){\n\t\t\t\t\tif(e.status!=\"delete\"){\n\t\t\t\t\t\tshowArray.data.trs.push(e);\n\t\t\t\t\t}\n\t\t\t\t\tisExsit = true;\n\t\t\t\t}\n\t\t\t});\n\t\t\t//如果当前页有一条数据就执行success方法\n\t\t\tif(isExsit){\n\t\t\t\topts.cache.success(showArray.data);\n\t\t\t\treturn showArray;\n\t\t\t}else{\n\t\t\t\treturn null;\n\t\t\t}\n\t\t}\n\t\tthis.ajax = function(){\n\t\t\t//点击页码跳转方法【lei】\n\t\t  opts.loding&&wingsPageLoading.show();\n\t\t\tvar param = opts.ajax.param;\n\t\t\tvar data ={\"ctrl\":opts.ajax.url,\"pageNum\":parseInt(opts.pageNum),\"rows\":opts.pageSize,'totalRows':opts.totalRows};\n\t\t\tfor(var i in param){\n\t\t\t\tdata[i] = param[i];\n\t\t\t}\n\t\t\t\n\t\t\t//为追加token值\n\t\t\tvar tempUrl = opts.ajax.url;\t\n\t\t\tif(tempUrl){\n\t\t\t\tif(tempUrl.indexOf('?')==-1){\n\t\t\t\t\ttempUrl += '?1=1';\n\t\t\t\t}\n\t\t\t\t//如果有值，才设置\n\t\t\t\tif (\"undefined\" != typeof $wings_url_tokenName_store && \"undefined\" != typeof store ){\n\t\t\t\t\t//从store中获得值，设置安全用的 token\n\t\t\t\t\tvar urlValue =  store.get($wings_url_tokenName_store);\n\t\t\t\t\tif(urlValue && urlValue != ''){\n\t\t\t\t\t\ttempUrl += \"&\"+ $wings_url_tokenName_store + \"=\" + urlValue;\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t}\n\t\t\tvar postData = JSON.stringify(data);\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t// ============== 适配  jsCtrlMode======================================== \n\t\t\tif (\"undefined\" != typeof $wings_param_isSwordAction && $wings_param_isSwordAction == 'jsCtrlModel') {\n\t\t\t\t//纯jsCtrl模式,默认走最下方逻辑\n\t\t\t\t\n\t\t\t\t//处理参数\n\t\t\t\tvar jsData = data;\n\t\t\t\t\n\t\t\t\t//jsCtrlMode   \n\t\t\t\t//追加js名称map，防止重复引用js\n\t\t\t\tvar jsUrl = tempUrl; ///demoCtrl/leiCtrl.js?method=leiText001\n\t\t\t\t//1.解析路径\n\t\t\t\tvar arr = jsUrl.split(\"?\");\n\t\t\t\tif(!arr || arr.length < 2){\n\t\t\t\t\tWingsDialog.alert(\"提示\",'没有找到js或ctrl方法');\n\t\t\t\t\treturn;\n\t\t\t\t};\n\t\t\t\tvar jsFile = arr[0];\n\t\t\t\tvar ctrlFn =  arr[1].replace('method=','');\n\t\t\t\tif(jsFile == '' || ctrlFn == ''){\n\t\t\t\t\tWingsDialog.alert(\"提示\",'没有找到js或ctrl方法');\n\t\t\t\t\treturn;\n\t\t\t\t};\n\t\t\t\t//alert( jsFile+ \"  \" + ctrlFn);\n\t\t\t\t//2.加载  \n\t\t\t\tif(jsCtrlMap.get(jsFile) == \"true\"){\n\t\t\t\t\t//已存在\n\t\t            //执行后续方法\n\t\t            var req = new WingsReqData(jsData);\n\t\t            var res;\n\t\t            var ctrlFunc = eval(ctrlFn);\n\t\t\t\t\tif (typeof ctrlFunc == \"function\") {\n\t\t\t\t\t\tres = ctrlFunc(req);\n\t\t\t\t\t}\n\t\t            \n\t\t//\t\t\t\t\t\t// 成功\n\t\t\t\t\t var allData = res.data;\n\t\t\t\t\t var resData = null;\n\t\t\t          var columns =  allData.filter(function(item,i,array){\n\t\t\t            if(item.name == opts.gridName){\n\t\t\t              return true;\n\t\t\t            }\n\t\t\t          });\n\t\t\t          if(columns.length<=0){\n\t\t\t            alert(\"排序方法返回的table数据key应为333：\"+opts.gridName);\n\t\t\t          }else{\n\t\t\t            resData = columns[0];\n\t\t\t          }\n\t\t\t\t\t\t\t\tif(allData!=null&&resData.totalRows!=null){\n\t\t\t\t\t\t\t\t\tpaging.setTotalRows(resData.totalRows)\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t\tvar halfPageCacheDatas = {data:[{trs:[]}]}; \n\t\t\t\t\t\t\t\tvar noInsertIndex = 0;\n\t\t\t\t\t\t\t\tvar halfData = [];\n\t\t\t\t\t\t\t\t$(opts.cache.data.trs).each(function(i,e){\n\t\t\t\t\t\t\t\t\tif(e.pageNum == opts.pageNum){\n\t\t\t\t\t\t\t\t\t\tif(e.status!='insert'){\n\t\t\t\t\t\t\t\t\t\t\tnoInsertIndex++;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\thalfPageCacheDatas.data[0].trs.push(e);\n\t\t\t\t\t\t\t\t\t\thalfData.push(e);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t\t$(opts.cache.data.trs).each(function(i,e){\n\t\t\t\t\t\t\t\t\tif(e.pageNum==paging.getPageNum()){\n\t\t\t\t\t\t\t\t\t\tvar index = opts.cache.data.trs.indexOf(e);\n\t\t\t\t\t\t\t\t\t\topts.cache.data.trs.splice(index,1);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t\tfor(var dataI=noInsertI