          "content": {
            "size": 283861,
            "mimeType": "text/javascript",
            "compression": 237282,
            "text": "/**\n * datatables封装成jquery 插件\n */\nfunction WingsGrid(divName, options) {\n\n    var $tableDiv = $(\"div[wings='WingsGrid'][name='\" + divName + \"']\");\n    $tableDiv.empty();\n    var I = divName + \"_wingsGrid_\" + Math.floor(Math.random() * 100);\n    $tableDiv\n        .append('<table id=\"' + I + '\" class=\"display\" width=\"99%\"></table>');\n    var wingsTableObj = $('#' + I).wingsDataTables(options);\n    return wingsTableObj;\n}\n\n(function ($) {\n\n    /**\n     * @param options\n     * @returns\n     */\n    $.fn.wingsDataTables = function (options) {\n\n        var $table = this;\n        var oldOptions = $.extend(false, oldOptions, options);\n        // 类型转换\n        typeConversion(options);\n        if (options.lengthMenu != null) {\n            var lengthMenu = [];\n            lengthMenu[0] = options.lengthMenu;\n            lengthMenu[1] = options.lengthMenu;\n            options.lengthMenu = lengthMenu;\n        }\n        var createOptions = $.extend({}, $.fn.wingsDataTables.defaults, options);\n        createColumns(createOptions, $table);\n        var opts = $.extend(true, opts, createOptions);\n        // 禁用原排序功能\n        if (opts.ordering) {\n            opts.wingsOrdering = opts.ordering;\n            opts.ordering = false;\n        }\n        if (opts.ajax != null) {\n            opts.isAjax = true;\n        }\n        if (opts.fenye != null && opts.fenye) {\n            opts.paging = false;\n            opts.pinfo = opts.info;\n            opts.info = false;\n        }\n        var idIndex = -1;\n        var checkBoxIndex = -1;\n        // 参数赋值\n        var data = [];\n        // sword初始化数据处理(前端分页)\n        if (!opts.isAjax) {\n            var swordData = opts.data;\n            if (null != swordData) {\n                data = conversionTrs(swordData.trs);\n                if (swordData.rows != null) {\n                    opts.pageLength = swordData.rows;\n                }\n                opts.displayStart = (swordData.pageNum - 1) * swordData.rows;\n            }\n            opts.data = data;\n            swordData = null;\n            data = null;\n        } else {\n            if (opts.ajax) {\n                opts.serverSide = true;\n                var url = opts.ajax.url;\n                var type = 'post';\n                if (opts.ajax.type != null) {\n                    type = opts.ajax.type;\n                }\n                if (url) {\n                    opts.ajax = function (data, callback, settings) {\n                        var param = {};\n                        var searchColumns = {};\n                        for (i in data.columns) {\n                            var columns = data.columns[i];\n                            if (columns.data != null) {\n                                // searchColumns[columns.data]=\n                                // columns.search.value;\n                                param[\"search_\" + columns.data] = columns.search.value;\n                            }\n                        }\n                        // param['search_columns'] =\n                        // JSON.stringify(searchColumns);\n                        // 分页\n                        if (opts.paging) {\n                            param.pagenum = data.start / data.length + 1;\n                            param.pagesize = data.length;\n                        }\n                        // 排序\n                        // if(opts.ordering){\n                        // param.ordercolumn =\n                        // data.columns[data.order[0].column].data;\n                        // param.ordersort = data.order[0].dir;\n                        // }\n                        // 过滤\n                        if (opts.searching) {\n                            param.search = data.search.value;\n                        }\n                        $.ajax({\n                            type: type,\n                            url: AddBizCode2URL(url),\n                            cache: false, // 禁用缓存\n                            data: param, // 传入已封装的参数\n                            async: false,\n                            dataType: \"json\",\n                            wingsSubmitAjax: true,\n                            success: function (result) {\n                                // 异常判断与处理\n                                // if (result.errorCode) {\n                                // $.dialog.alert(\"查询失败。错误码：\"+result.errorCode);\n                                // return;\n                                // }\n                                var resdata = null;\n                                for (var i = 0; i < result.data.length; i++) {\n                                    if (result.data[i].hasOwnProperty('trs')) {\n                                        var swordData = result.data[i];\n                                        resdata = conversionTrs(swordData.trs);\n                                    }\n                                }\n                                // 封装返回数据，这里仅演示了修改属性名\n                                var returnData = {};\n                                returnData.draw = data.draw;// 这里直接自行返回了draw计数器,应该由后台返回\n                                returnData.recordsTotal = swordData.totalRows;\n                                // returnData.recordsFiltered =\n                                // 101;//后台不实现过滤功能，每次查询均视作全部结果\n                                returnData.data = resdata;\n                                // 关闭遮罩\n                                // $wrapper.spinModal(false);\n                                // 调用DataTables提供的callback方法，代表数据已封装完成并传回DataTables进行渲染\n                                // 此时的数据需确保正确无误，异常判断应在执行此回调前自行处理完毕\n                                callback(returnData);\n                            }\n                            // error: function(XMLHttpRequest, textStatus,\n                            // errorThrown) {\n                            // $.dialog.alert(\"查询失败\");\n                            // $wrapper.spinModal(false);\n                            // }\n                        });\n                    }\n                }\n            }\n        }\n        var dragFlag = true;\n        // 源生行创建后执行方法\n        opts.createdRow = function (row, data, index) {\n            var noDelIndex = 0;\n            $(gridData.trs).each(function (i, e) {\n                if (pagingObj != null) {\n                    if (e.pageNum == pagingObj.getPageNum()) {\n                        if (e.status != \"delete\") {\n                            if (noDelIndex == index) {\n                                row.setAttribute(\"row\", i);\n                                return false;\n                            }\n                            noDelIndex++;\n                        }\n                    }\n                } else {\n                    if (e.status != \"delete\") {\n                        if (noDelIndex == index) {\n                            row.setAttribute(\"row\", i);\n                            return false;\n                        }\n                        noDelIndex++;\n                    }\n                }\n            });\n            $table.initRowAfterCallback(row, data, index);\n            if (opts.onAfterCreateRow != null) {\n                var tempFn = wings_getFunc(opts.onAfterCreateRow);\n                var rowEl = $table.getRowEl(index, row);\n                var rowValue = rowEl.getValue();\n                for (var b = 0; b < tempFn.length; b++) {\n                    var func = eval(tempFn[b]);\n                    if (typeof func == \"function\") {\n                        var result = new func(rowValue, rowEl, $table);\n//            rowEl.destroy();\n                        result = null;\n                    }\n                    func = null;\n                }\n                tempFn = null;\n            }\n        };\n        // 构建参数============================================================================================\n        // 初始化================================================================================\n        // dom对象转换jquery对象\n        var $this = $(this);\n        if (opts.fixedColumns != null) {\n            opts.fixedColumns = opts.fixedColumns[0];\n            opts.scrollX = true;\n        }\n        //关闭底层提示框\n        $.fn.dataTable.ext.errMode = 'none';\n        // 初始化表格\n        var table = $this.DataTable(opts);\n        if (opts.fixedColumns != null) {\n            $(\".DTFC_LeftBodyWrapper\").css(\"top\", \"1px\");\n            $(\".DTFC_LeftBodyLiner\").css(\"overflow-y\", \"hidden\");\n            $(\".DTFC_RightBodyWrapper\").css(\"top\", \"1px\");\n            $(\".DTFC_RightBodyLiner\").css(\"overflow-y\", \"hidden\");\n        }\n\n        // $this.find(\".DTFC_LeftBodyLiner>table>tbody\").append(\"\")\n        if ($(\"#\" + options.name + \"_wingsConsole\")[0] == null) {\n            createConsole();\n        }\n        this.rightMenu = null;\n        // if(opts.rightMenu!=null){\n        createRightMenu(this);\n        // }\n        bodyBind();\n        $this.find(\"tbody\").on('change', 'input[type=checkbox]', function () {\n            // if (event.stopPropagation) {\n            // event.stopPropagation();\n            // } else if (window.event) {\n            // window.event.cancelBubble = true;\n            // }\n            if (opts.selectColor) {\n                //临时修改，ie9下dom捕获顺序有问题，导致函数触发顺序错误，选中变色失效\n                /*if ($(this).prop('checked')) {\n          $(this).closest('tr').addClass('selected');\n        } else {\n          $(this).closest('tr').removeClass('selected');\n        }*/\n            }\n        });\n        // checkbox的click事件\n        $this.find(\"tbody\").on('click', 'input[wingsCheckBoxClick]', function (e) {\n            var row = $(this).closest('tr');\n            var rowEl = $table.getRowEl(row);\n            var data = rowEl.getValue();\n            var node = table.row(row).nodes();\n            var index = table.row(row).index();\n            var wingsOnClick = wings_getFunc($(this).attr('wingsCheckBoxClick'));\n            if (wingsOnClick) {\n                for (var b = 0; b < wingsOnClick.length; b++) {\n                    var func = eval(wingsOnClick[b]);\n                    if (typeof func == \"function\") {\n                        var result = new func(data, node[0], this, e);\n                        result = null;\n                    }\n                    func = null;\n                }\n            }\n//      rowEl.destroy();\n            row = null;\n            node = null;\n            wingsOnClick = null;\n\n        });\n        // 获取dataTable原生对象\n        this.getTable = function () {\n            return table;\n        }\n        this.debug = function (debugState) {\n            opts.debug = debugState;\n        }\n        // 复杂表头\n        if (opts.fzbtid != null) {\n            if ($(\"#\" + opts.fzbtid).length > 0) {\n//         table.columns().header().show(false);\n                showHeader(false);\n                var fzbt = $(\"#\" + opts.fzbtid).html();\n                $(\"#\" + opts.fzbtid).hide();\n                $(table.table().node()).prepend(fzbt);\n            }\n        }\n        // 固定列宽\n        if (opts.fixedColWidth) {\n            $(table.table().node()).css('table-layout', 'fixed');\n        } else {\n            $(table.table().node()).css('table-layout', null);\n        }\n        // 字体大小设置\n        if (opts.dataFontSize != null) {\n            $(table.table().node()).css('font-size', opts.dataFontSize);\n        }\n        $(table.table().node()).parent().addClass(\"ie9bugClass\");\n        // 横向滚动条\n        if (opts.dataX != null) {\n            $(table.table().node()).closest('[dataX]').css({\n                width: opts.dataX\n            });\n            $(table.table().node()).parent().css({\n                overflowX: 'auto',\n                position: 'relative',\n                width: '100%',\n                height: '100%'\n            });\n        } else {\n            $(table.table().node()).parent()[0].style.overflowX = 'hidden';\n        }\n        // 纵向滚动条\n        if (opts.dataY != null) {\n            buildY(opts.dataY);\n        } else {\n            $(table.table().node()).parent()[0].style.overflowY = 'hidden';\n        }\n\n        if (options.scrollX1 != null) {\n            $(table.table().node()).css('width', opts.scrollX1);\n        } else {\n            $(table.table().node()).css('width', opts.scrollX1);\n            $($(table.table().node()).closest(\"div .ie9bugClass\")).css('overflow-x',\n                'hidden');\n        }\n        // 隐藏列功能\n        if (opts.hideMenu) {\n            this.setExcludeHideColumn = function (hideMenu_exclude) {\n                opts.hideMenu_exclude = hideMenu_exclude;\n            }\n            this.setUnHideColumn = function (hideMenu_unhide) {\n                opts.hideMenu_unhide = hideMenu_unhide;\n            }\n            table.columns().header().hideMenuList(opts.hideMenu_exclude,\n                opts.hideMenu_unhide);\n        }\n        // 显示边框线\n        if (opts.border && !$this.hasClass('table-bordered')) {\n            $this.addClass('table-bordered');\n        }\n        if (opts.striped && !$this.hasClass('table-striped')) {\n            $this.addClass('table-striped');\n        }\n        if (opts.showHeader != null && !opts.showHeader) {\n            showHeader(false);\n        }\n        if (!opts.fenye && !opts.paging) {\n            $(\".rowright\").closest(\"div .row\").hide();\n        }\n        // 页面重绘触发事件\n        table\n            .on(\n                'draw.dt',\n                function () {\n                    if (opts.emptyDataMsg == null) {\n                        $this.find(\".dataTables_empty\").hide();\n                    } else {\n                        $this.find(\".dataTables_empty\").text(opts.emptyDataMsg);\n                    }\n                    var dateDraw1 = new Date();\n//                      table.columns().header().show(true);\n                    showHeader(true);\n                    // 固定表头\n                    if (opts.fixedHead) {\n                        // $this.closest(\"div .ie9bugClass\")[0].style.overflow =\n                        // 'scroll';\n                        //浏览器边框像素\n                        if ($(table.table().node()).parent()[0].clientWidth < $(table.table().node()).parent()[0].offsetWidth - 2) {\n                            $(table.table().node()).addClass(\"fixedHead\");\n                        } else {\n                            $(table.table().node()).addClass(\"fixedHeadNoScroll\");\n                        }\n                        var thead = $this.find(\"thead\").prop(\"outerHTML\");\n//                        $this.find(\"thead\").hide();\n                        var oldId = $this.attr('id');\n                        var fixedHeadTableId = oldId + \"_fixedHead\";\n                        var headTable = $(\"<table bgcolor='#00FF00'></table>\");\n                        var tablewidth = $this.parent().css(\"width\");\n                        if (!$this.hasClass(\"fixedHeadNoScroll\")) {\n                            tablewidth = parseInt(tablewidth) - 17;\n                        }\n                        var $headTableDiv = $('<div class=\"wingsgrid_div\" style=\"position: absolute;z-index:999;overflow-x:hidden;overflow-y:hidden;background:#fff;width:' + tablewidth + 'px\" id=\"'\n                            + fixedHeadTableId + '_Div\"></div>');\n                        headTable.attr(\"class\", $this.attr(\"class\")\n                            + ' fixedHeadClass');\n                        headTable.attr(\"style\", $this.attr(\"style\"));\n                        headTable.attr(\"id\", fixedHeadTableId)\n                        headTable.append(thead);\n                        $headTableDiv.append(headTable);\n                        if ($(\"#\" + fixedHeadTableId)[0] == null) {\n                            $this.parent().before($headTableDiv);\n                            headBind(fixedHeadTableId);\n                            dragWidth();\n                            $(\"#\" + fixedHeadTableId).on(\"click\", '.dataTableCheckAll', allCheck);\n\n                        }\n                        if (opts.showHeader != null && !opts.showHeader) {\n                            if (opts.fixedHead) {\n                                $(\"#\" + fixedHeadTableId).hide();\n                            }\n                        } else {\n                            $this.parent().scroll(function () {\n                                var left = this.scrollLeft;\n                                $(\"#\" + fixedHeadTableId + \"_Div\")[0].scrollLeft = left;\n                                if (this.scrollLeft != $(\"#\" + fixedHeadTableId + \"_Div\")[0].scrollLeft) {\n                                    this.scrollLeft = $(\"#\" + fixedHeadTableId + \"_Div\")[0].scrollLeft;\n                                }\n                            });\n                        }\n                        table.columns().nodes().each(\n                            function (e, i) {\n                                if ($(e).eq(0).index() != -1) {\n                                    var width = $(\"#\" + fixedHeadTableId).find(\"th\").eq($(e).eq(0).index()).css(\"width\");\n                                    var padding = $(\"#\" + fixedHeadTableId).find(\"th\").eq($(e).eq(0).index()).css(\"padding\");\n                                    $(e).css({'padding': padding, 'width': width});\n                                }\n                            });\n                        thead = null;\n                        headTable = null;\n                        $headTableDiv = null;\n                    } else {\n                        $(table.table().node()).removeClass(\"fixedHead\");\n                        $(table.table().node()).removeClass(\"fixedHeadNoScroll\");\n                        // 隐藏表头\n                        if (opts.showHeader != null && !opts.showHeader) {\n//                          table.columns().header().show(false);\n                            showHeader(false);\n                            var tds = $table.find(\"tbody>tr\").find(\"td\");\n                            $(table.header()[0]).find(\"th\").each(function (i, e) {\n                                if (tds[i] != null) {\n                                    tds[i].style.width = e.style.width;\n                                }\n                            })\n                        }\n                    }\n                    if (opts.fzbtid != null || !opts.showHeader) {\n                        table.columns().header().show(false);\n//                        showHeader(false);\n                    }\n                    // 内容省略\n                    for (var i = 0; i < opts.columns.length; i++) {\n                        var col = opts.columns[i];\n                        $(table.column(i).nodes()).each(function (i1, e) {\n                            if (col.contentLen != null) {\n                                contentLenProcess($(this), col.contentLen)\n                            }\n                            // //固定列\n                            // if(true||col.fixedCol!=null&&col.fixedCol==\"true\"){\n                            //\n                            // }\n                        });\n                    }\n                    if (!opts.fenye && !opts.paging) {\n                        $(\".rowright\").closest(\"div .row\").hide();\n                    }\n                    if (opts.showHJ\n                        && (!isEmptyObject($table.getHj()) || opts.emptyDataMsg == null)) {\n                        var sumRow = [{}];\n                        $(opts.columns)\n                            .each(\n                                function (i1, e1) {\n                                    if (e1.visible != null && !e1.visible) {\n                                        return true;\n                                    }\n                                    var obj = {\n                                        \"value\": \"\",\n                                        \"style\": {}\n                                    };\n                                    if (e1.hj != null && e1.hj) {\n                                        obj.value = $table.getHj(e1.data);\n                                    }\n                                    if (e1.hjLabel != null\n                                        && e1.hjLabel == \"true\") {\n                                        obj.value = \"合计\";\n                                    } else if (e1.hjLabel != null\n                                        && e1.hjLabel != \"false\") {\n                                        obj.value = e1.hjLabel;\n                                    }\n                                    var cellEl = $table.getCellEl(0, e1.data);\n                                    if (cellEl.getObj() != null) {\n                                        var width = cellEl.getObj().style.width;\n                                        var padding = cellEl.getObj().style.padding;\n                                        obj.style = {\n                                            width: width,\n                                            padding: padding\n                                        };\n                                    }\n                                    sumRow[0][e1.data] = obj;\n                                    obj = null;\n//                                          cellEl.destroy();\n                                });\n                        if ($(\"#\" + options.name + \"_hjtr\")[0] == null) {\n                            createRow(sumRow[0], $($this.find('tbody')));\n                        }\n                        if (opts.fixedColumns != null) {\n                            // 处理固定表头的合计行\n                            var hjTr = $this.find(\"tbody\")[0].rows[$this.find(\n                                \"tbody\").children().length - 1];\n                            if (opts.fixedColumns.leftColumns != null\n                                && opts.fixedColumns.leftColumns > 0) {\n                                var $tr = $(\"<tr style='height:27px'></tr>\");\n                                for (var i = 0; i < opts.fixedColumns.leftColumns; i++) {\n                                    var td = $(hjTr.cells[i].outerHTML);\n                                    $tr.append($(td));\n                                    td = null;\n                                }\n                                $this.closest(\"div[name=leiTable]\").find(\n                                    \".DTFC_LeftBodyLiner>table>tbody\").append(\n                                    $tr);\n                                $tr = null;\n                            }\n                            if (opts.fixedColumns.rightColumns != null\n                                && opts.fixedColumns.rightColumns > 0) {\n                                var $tr = $(\"<tr style='height:27px'></tr>\");\n                                for (var i = 0; i < opts.fixedColumns.rightColumns; i++) {\n                                    var td = $(hjTr.cells[i].outerHTML);\n                                    $tr.append($(td));\n                                    td = null;\n                                }\n                                $this.closest(\"div[name=leiTable]\").find(\n                                    \".DTFC_RightBodyLiner>table>tbody\").append(\n                                    $tr);\n                                $tr = null;\n                            }\n                            hjTr = null;\n                        }\n                    }\n                    $this.find(\".dataTableCheckAll\").prop('checked', false);\n                    $(\"#\" + options.name + \"_hjtr\").children().removeClass('NoEdit');\n                    $(\"#\" + options.name + \"_hjtr\").children().addClass('NoEdit');\n                });\n\n        // 单元格内容长度省略\n        function contentLenProcess($obj, contentLen) {\n            if ($obj.text().length > contentLen) {\n                if ($obj.attr('title') == null) {\n                    var title = $obj.text();\n                    $obj.attr('title', title);\n                }\n                if ($obj.children().length > 0) {\n                    $obj.children().text($obj.text().substring(0, contentLen) + \"...\");\n                } else {\n                    $obj.text($obj.text().substring(0, contentLen) + \"...\");\n                }\n            }\n        }\n\n        // 选择列(需要样式支持，td.selected)\n        // if(opts.selectColumn){\n        // $this.on('click','th',function(){\n        // table.column($(this).index()).nodes().each(function(element,i){\n        // if($(element).hasClass(\"selected\")){\n        // $(element).removeClass(\"selected\");\n        // }else{\n        // $(element).addClass(\"selected\");\n        // }\n        // });\n        // });\n        // }\n        // 初始化================================================================================\n        // 构建方法============================================================================================\n        // 查询单元格对象方法\n        this.getCell = function (selector) {\n            return table.cell(selector);\n        }\n        this.getCellData = function (selector) {\n            return table.cell(selector).data();\n        }\n        this.getCellNode = function (selector) {\n            return table.cell(selector).node();\n        }\n        this.getCellIndex = function (selector) {\n            return table.cell(selector).index();\n        }\n        this.getCellsData = function (selector) {\n            return table.cells(selector).data();\n        }\n        this.getCellsNode = function (selector) {\n            return table.cells(selector).nodes();\n        }\n        this.getCellsIndexes = function (selector) {\n            return table.cells(selector).indexes();\n        }\n        // 查询单行对象方法\n        this.getRowData = function (selector) {\n            return table.row(selector).data();\n        }\n        this.getRowDom = function (selector) {\n            return table.row(selector).nodes();\n        }\n        this.getRowIndexes = function (selector) {\n            table.row(selector).index();\n        }\n        // 查询多行行对象方法，返回值在数组中\n        this.getRowsData = function (selector) {\n            return table.rows(selector).data();\n        }\n        this.getRowsDom = function (selector) {\n            return table.rows(selector).nodes();\n        }\n        this.getRowsIndexes = function (selector) {\n            table.rows(selector).indexes();\n        }\n        this.showHeader = function (boolean) {\n//      table.columns().header().show(boolean);\n            showHeader(boolean);\n        }\n        // 查询单列对象\n        this.getColumn = function (selector, visible) {\n            if ('number' == typeof (selector)) {\n                if (visible == \"undefined\" || !visible) {\n                    return table.column(selector);\n                } else if (visible) {\n                    return table.column('{' + selector + '}:visible');\n                }\n            } else if ('string' == typeof (selector)) {\n                return table.column(selector + ':name');\n            } else {\n                return table.column();\n            }\n        }\n        this.getColumnData = function (selector, visible) {\n            return this.getColumn(selector, visible).data();\n        }\n        this.getColumnDom = function (selector, visible) {\n            return this.getColumn(selector, visible).nodes();\n        }\n        // 查询多列对象，返回值在数组中\n        this.getColumns = function (selector, visible) {\n            if ('number' == typeof (selector)) {\n                if (visible == \"undefined\" || !visible) {\n                    return table.columns(selector);\n                } else if (visible) {\n                    return table\n                        .columns('{' + selector + '}:visible');\n                }\n            } else if ('string' == typeof (selector)) {\n                return table.columns(selector + ':name');\n            } else {\n                return table.columns();\n            }\n        }\n        this.getColumnsData = function (selector, visible) {\n            return this.getColumns(selector, visible).data();\n        }\n        this.getColumnsDom = function (selector, visible) {\n            return this.getColumns(selector, visible).nodes();\n        }\n        this.getAllData = function () {\n            return table.data();\n        }\n        // 添加一行 rowData是数组(一行数据)\n        // var rowData = [{name:'1',position:\"2\",salary:\"3\"},{...}];\n        this.addRow = function (rowData) {\n            table.rows.add(rowData).draw(true);\n        }\n        // 删除行\n        this.removeRow = function (selector) {\n            table.rows(selector).remove().draw(false);\n        }\n        // 隐藏列(原始)\n        this.hideColumns = function (selector) {\n            var column = this.getColumn(selector);\n            if (column.visible()) {\n                column.visible(false);\n            } else {\n                column.visible(true);\n            }\n        }\n        // 隐藏列\n        this.hideColumn = function (selector) {\n            var column = this.getColumn(selector);\n            column.visible(false);\n            opts.columns[column.index()].visible = false;\n            if (opts.showHJ) {\n                $(\"#\" + this[0].id + \"_\" + opts.columns[column.index()].name + \"_hj\").hide();\n            }\n            /* debugger; */\n            if (getIeVersion() == 8) {\n                var table = this.getTable().table().node();\n                table.style.display = \"inline-table\";\n                window.setTimeout(function () {\n                    table.style.display = \"\";\n                }, 0);\n            }\n            column = null;\n        }\n        // 显示列\n        this.showColumn = function (selector) {\n            var column = this.getColumn(selector);\n            column.visible(true);\n            opts.columns[column.index()].visible = true;\n            if (opts.showHJ) {\n                $(\"#\" + this[0].id + \"_\" + opts.columns[column.index()].name + \"_hj\").show();\n            }\n            column = null;\n        }\n        // 销毁表格\n        this.destroyTable = function () {\n\n            table.destroy();\n            gridData.trs = null;\n            $this.empty();\n        }\n        // 获取选中变色的行对象\n        this.getSelectedRow = function () {\n            var rows = [];\n            var rowDts = table.rows('.selected')[0];\n            $(rowDts).each(function (i, e) {\n                var rowEl = $table.getRowEl(e);\n                if (!rowEl.isNull) {\n                    rows.push(rowEl);\n                }\n//        rowEl.destroy();\n                rowEl = null;\n            });\n            return rows;\n        }\n        // 获取选中变色行的值\n        this.getSelectedData = function () {\n            var selectedData = {\n                sword: \"SwordGrid\",\n                name: wingsName,\n                beanname: null,\n                trs: []\n            };\n            var trs = {\n                \"status\": null,\n                \"tds\": {},\n                \"init\": \"load\"\n            };\n            $(this.getSelectedRow()).each(function (i, e) {\n                trs.tds = e.getValue();\n                selectedData.trs.push(trs);\n            });\n            return selectedData;\n        }\n        // 获取数据\n        this.getCheckedRow = function (checkboxName) {\n            var rows = [];\n            var rowDts = [];\n            if (checkboxName == null) {\n                rowDts = table.rows('.wingsDataTableCheckBox')[0];\n            } else {\n                $(table.columns(checkboxName + ':name').nodes()[0]).each(\n                    function (i, e) {\n                        if ($(e.children).is(':checked')) {\n                            rowDts.push($(e).parent());\n                        }\n                    });\n            }\n            $(rowDts).each(function (i, e) {\n                if (!$table.getRowEl(e).isNull) {\n                    rows.push($table.getRowEl(e));\n                }\n            });\n            return rows;\n        }\n        this.getCheckedData = function (checkboxName) {\n            var checkData = {\n                sword: \"SwordGrid\",\n                name: wingsName,\n                beanname: null,\n                trs: []\n            };\n            $(this.getCheckedRow(checkboxName)).each(function (i, e) {\n                var trs = {\n                    \"status\": null,\n                    \"tds\": {},\n                    \"init\": \"load\"\n                };\n                trs.tds = e.getValue();\n                checkData.trs.push(trs);\n            });\n            return checkData;\n        }\n        this.formatData = function (type, Data) {\n            if (type === 'sword') {\n                var checkData = {\n                    sword: \"SwordGrid\",\n                    name: wingsName,\n                    beanname: null,\n                    trs: []\n                };\n                var trs = {\n                    \"status\": null,\n                    \"tds\": Data,\n                    \"init\": \"load\"\n                };\n                checkData.trs.push(trs);\n                return checkData;\n            }\n        }\n        var oldData = null;\n        if (opts.fenye != null && opts.fenye) {\n            var pagingObj = {};\n            // 画分页部分\n            var pagId = opts.name + \"_pagingBar\";\n            var $pagingDiv = $(\"<div id='\" + pagId + \"' style='font-size:\"\n                + opts.pageFontSize + \";' ></div>\");\n            $this.parent().after($pagingDiv);\n            var loaType = opts.ptid != null ? \"2\" : \"1\";\n            // 分页组件参数\n            var pageOpts = {\n                loding: opts.mask,\n                gridName: opts.name,\n                pageSize: opts.pageLength,\n                pageSizeMenu: opts.lengthMenu,\n                info: opts.pinfo,\n                pageSizeInfo: opts.pageSizeInfo,\n                pageSizeType: opts.pageSizeType,\n                pageType: opts.pagingType,// number：只显示数字simple：只显示上下页simple_numbers：显示数字上下页(默认)full:显示首尾页，上下页full_numbers：显示首尾页，上下页，数字\n                pageInfo: opts.pageInfo,\n                runTo: opts.runTo,\n                ajax: {\n                    // /ajax.sword?ctrl=WingsFormCtrl_getGridFyData1\n                    url: AddBizCode2URL(opts.ptid),\n                    async: false,\n                    param: opts.ajaxParam,\n                    method: \"POST\",\n                    success: function (data, halfData) {\n                        // var resData = null;\n                        // var columns = data.data.filter(function(item,i,array){\n                        // if(item.name == $table.getOptions().name){\n                        // return true;\n                        // }\n                        // });\n                        // if(columns.length<=0){\n                        // alert(\"排序方法返回的table数据key应为：\"+$table.getOptions().name);\n                        // }else{\n                        // resData = columns[0];\n                        // }\n//\t\t\talert(\"girdAjax333\");【lei】测试\n                        if (opts.showHJ) {\n                            // 删除半页数据合计\n                            if (halfData.length > 0) {\n                                $(halfData).each(function (i, e) {\n                                    $(opts.columns).each(function (i1, e1) {\n                                        if (e1.hj != null && e1.hj) {\n                                            if ($table.hthjflag) {\n                                                return false;\n                                            } else {\n                                                var hjvalue = e.tds[e1.data] != null ? e.tds[e1.data].value : \"\";\n                                                if (e.status != 'delete') {\n                                                    $table.doHj(e1.data, hjvalue, '-');\n                                                } else {\n                                                    $table.doHj(e1.data, hjvalue, '+');\n                                                }\n                                            }\n                                        }\n                                    });\n                                });\n                            }\n                            $(data.data[0].trs).each(function (i, e) {\n                                $(opts.columns).each(function (i1, e1) {\n                                    if (e1.hj != null && e1.hj) {\n                                        if ($table.hthjflag) {\n                                            return false;\n                                        } else {\n                                            var hjvalue = e.tds[e1.data] != null ? e.tds[e1.data].value : \"\";\n                                            if (e.status != 'delete') {\n                                                $table.doHj(e1.data, hjvalue);\n                                            } else {\n                                                $table.doHj(e1.data, e.tds[e1.data].value, '-');\n                                            }\n                                        }\n                                    }\n                                });\n                            });\n                        }\n                        if (!opts.ptid) {\n                            $.merge(gridData.trs, data.data[0].trs);\n                        }\n                        $table.drawData(data.data[0]);\n                    }\n                },\n                cache: {\n                    loadType: loaType,\n                    success: function (data) {\n                        if (!opts.ptid) {\n                            var pageNum = 0;\n                            var i1 = 0;\n                            $(gridData.trs).each(function (i, e) {\n                                if (e.status == 'insert') {\n                                    return true;\n                                }\n                                if (i1 % pagingObj.getPageSize() == 0) {\n                                    pageNum++;\n                                }\n                                e.pageNum = pageNum;\n                                i1++;\n                            });\n                        }\n                        $table.drawData(data);\n                    }\n                },\n                changeSizeCallback: function (data) {\n                    var resData = null;\n                    var columns = data.data.filter(function (item, i, array) {\n                        if (item.name == $table.getOptions().name) {\n                            return true;\n                        }\n                    });\n                    if (columns.length <= 0) {\n                        alert(\"排序方法返回的table数据key应为：\" + $table.getOptions().name);\n                    } else {\n                        resData = columns[0];\n                    }\n                    if (opts.showHJ) {\n                        gridDataSum = {};\n                        $(resData.trs).each(function (i, e) {\n                            $(opts.columns).each(function (i1, e1) {\n                                if (e1.hj != null && e1.hj) {\n                                    var hjvalue = e.tds[e1.data] != null ? e.tds[e1.data].value : \"\";\n                                    $table.doHj(e1.data, hjvalue);\n                                }\n                            });\n                        });\n                    }\n                    $table.drawData(resData);\n                },\n                pagingCallback: function () {\n                    gridData.pageNum = pagingObj.getPageNum();\n                    gridData.rows = pagingObj.getPageSize();\n                    $(\".dataTableCheckAll\").prop('checked', false);\n                    // 调用翻页后回调方法\n                    if ($table.pagingCallback) {\n                        if ($table.pagingCallback != null) {\n                            var func = eval($table.pagingCallback);\n                            if (typeof func == \"function\") {\n                                var result = new func();\n                            } else {\n                                alert('pagingCallback属性必须是一个function');\n                            }\n                        }\n                    }\n                }\n            };\n            // 初始化分页\n            pagingObj = $pagingDiv.wingsPaging(pageOpts);\n            this.initData = function (data) {\n                setDefaultValue(data);\n                oldData = data;\n                gridDataSum = {};\n                // 重新初始化分页\n                pageOpts.ajax.param = opts.ajaxParam;\n//        if(data.pageNum&&data.pageNum!=1){\n//          pageOpts.pageNum = data.pageNum;\n//        }\n//        pageOpts.totalRows = data.totalRows;\n                pagingObj = pagingObj.init(pageOpts);\n                // 构建grid数据\n                gridData.trs = data.trs;\n                gridData.pageNum = pagingObj.getPageNum();\n                // 每页显示条数\n                if (typeof opts.pageLength == 'number' && opts.pageLength != null) {\n                    gridData.rows = opts.pageLength;\n                } else {\n                    gridData.rows = data.rows;\n                }\n                pagingObj.setPageSize(gridData.rows);\n                // 数据总数\n                if (data.totalRows != null && opts.ptid != null) {\n                    gridData.totalRows = data.totalRows;\n                } else {\n                    gridData.totalRows = data.trs != null ? data.trs.length : 0;\n                }\n                if (!opts.lazy) {\n                    var datapageNum = data.pageNum || 1;\n                    gridDataSum = {};\n                    $(gridData.trs).each(function (i, e) {\n                        if (e.status != \"delete\") {\n                            e.pageNum = datapageNum;\n                            // 给数据加分页标签\n                            if (i + 1 % pagingObj.getPageSize() == 0) {\n                                datapageNum++;\n                            }\n                            e.index = i + 1;\n                            if (opts.showHJ) {\n                                $(opts.columns).each(function (i1, e1) {\n                                    if (data.hjConfig && data.hjConfig[e1.data]) {\n                                        $table.hthjflag = true;\n                                        $table.doHj(e1.data, null, null, data.hjConfig[e1.data]);\n                                    } else {\n                                        if (e1.hj != null && e1.hj) {\n                                            var hjvalue = e.tds[e1.data] != null ? e.tds[e1.data].value : \"\";\n                                            $table.doHj(e1.data, hjvalue);\n                                        }\n                                    }\n                                });\n                            }\n                        }\n                    });\n                    // 设置分页参数\n                    pagingObj.setCache(gridData);\n                    pagingObj.setPageNum(gridData.pageNum);\n                    pagingObj.setPageSize(gridData.rows);\n                    pagingObj.setTotalRows(gridData.totalRows);\n                    pagingObj.refreshInfo();\n                    var showData = {};\n                    if (!opts.ptid) {\n                        // 从griddata中取出每页显示的数据\n                        var min = (pagingObj.getPageNum() - 1) * pagingObj.getPageSize() + 1;\n                        var max = pagingObj.getPageNum() * pagingObj.getPageSize();\n                        showData.trs = gridData.trs.slice(min - 1, max);\n                        refreshShowData();\n                    } else {\n                        showData.trs = gridData.trs;\n                    }\n                    this.drawData(showData);\n                    //【lei】修改点击搜索后，后台翻页gird会自己再访问一次的问题 2019/03/13\n//          pagingObj.paging(data.pageNum);//旧\n                    pagingObj.paging(data.pageNum, \"search\");//新\n                } else {\n                    pagingObj.setTotalRows(gridData.totalRows);\n                    pagingObj.paging(pagingObj.getPageNum());\n                    pagingObj.setCache(gridData);\n                }\n                this.initDataAfterCallback();\n            }\n            this.insertRow = function (dataObj, items, rowNum, treeInsertType, where) {\n                $.wingsValidate2.hideAll();\n                // 构建insert数据\n                var tds = null;\n                var newRow = {}\n                if (dataObj == null || isEmptyObject(dataObj.tds)) {\n                    $(oldOptions.columns).each(function (i, e) {\n                        newRow[e.name] = {\n                            'value': e.defaultValue ? e.defaultValue : \"\"\n                        };\n                    });\n                } else {\n                    newRow = dataObj.tds;\n                }\n                tds = {\n                    tds: newRow,\n                    status: 'insert',\n                    pageNum: pagingObj.getPageNum()\n                };\n                // 插入数据到gridData里\n                // var selectIndex = 0;\n                var selectIndex = $(this).find('.selected').eq(0).closest('tr').attr(\"row\");\n                if (selectIndex == null) {\n                    selectIndex = 0;\n                }\n                if (where == 'top') {\n                    gridData.trs.splice(0, 0, tds);\n                } else if (where == 'before') {\n                    if (selectIndex == 0) {\n                        tds.pageNum = '1';\n                    }\n                    gridData.trs.splice(selectIndex, 0, tds);\n                } else if (where == 'after') {\n                    gridData.trs.splice(selectIndex + 1, 0, tds);\n                } else if (where == 'end') {\n                    tds.pageNum = pagingObj.getTotalPages();\n                    gridData.trs.splice(gridData.trs.length, 0, tds);\n                } else {\n                    gridData.trs.splice(selectIndex, 0, tds);\n                }\n                if (opts.showHJ) {\n                    $(opts.columns).each(function (i1, e1) {\n                        if (e1.hj != null && e1.hj) {\n                            var hjvalue = tds.tds[e1.data] != null ? tds.tds[e1.data].value : \"\";\n                            $table.doHj(e1.data, hjvalue);\n                        }\n                    });\n                }\n                //*beta s\n//        var newtds = [];\n//        newtds.push(tds);\n//        if (newtds != null) {\n//          var datas = conversionTrs(newtds);\n//          this.addRow(datas);\n//        }\n                //*beta e\n//        this.insertStatus = true;\n                if (opts.ptid) {\n                    this.drawData(this.getCurPageNoDeleteGridData());\n                } else {\n                    refreshShowData();\n                    this.drawData(this.getCurPageShowData());\n                }\n//        this.insertStatus = false;\n                //*beta o\n                tds = null;\n                newRow = null;\n            }\n            // this.addAjaxParam = function(param) {\n            // opts.ajaxParam.dTsortTitle = param.dTsortTitle;\n            // var pagingOpts = pagingObj.getOptions();\n            // pagingOpts.ajax.ajaxParam.dTsortTitle = param.dTsortTitle;\n            // pagingObj.setOptions(pagingOpts);\n            // }\n            $pagingDiv = null;\n        } else {\n            this.initData = function (data) {\n                setDefaultValue(data);\n                gridDataSum = {};\n                if (data == null) {\n                    data.trs = null;\n                }\n                if (data.trs != null && data.trs.length > 1000) {\n                    alert(\"超过1000条数据请使用后台分页！\");\n                    return false;\n                }\n                gridData.trs = data.trs;\n                $(gridData.trs).each(function (i, e) {\n                    if (opts.showHJ && e.status != 'delete') {\n                        $(opts.columns).each(function (i1, e1) {\n                            if (e1.hj != null && e1.hj) {\n                                if (data.hjConfig && data.hjConfig[e1.data]) {\n                                    $table.hthjflag = true;\n                                    $table.doHj(e1.data, null, null, data.hjConfig[e1.data]);\n                                } else {\n                                    var hjvalue = e.tds[e1.data] != null ? e.tds[e1.data].value : \"\";\n                                    $table.doHj(e1.data, hjvalue);\n                                }\n                            }\n                        });\n                    }\n                });\n                this.drawData(data);\n                // 下面这种方式会很慢\n                // $(datas).each(function(i,e){\n                // $table.addRow([e]);\n                // var row = $table.getRowEl(i).getObj();\n                // $table.initRowAfterCallback(row,e,i);\n                // });\n                // if(data.pageNum!=null&&data.pageNum!=''){\n                // table.page(data.pageNum-1).draw();\n                // }\n                this.initDataAfterCallback();\n            }\n            this.insertRow = function (dataObj, items, rowNum, treeInsertType, where) {\n                $.wingsValidate2.hideAll();\n                var tds = null;\n                var newRow = {}\n                var dtRow = {}\n                if (dataObj == null || isEmptyObject(dataObj.tds)) {\n                    // for(var attr in gridData.trs[0].tds){\n                    // newRow[attr] = {\n                    // 'value': ''\n                    // };\n                    // }\n                    $(oldOptions.columns).each(function (i, e) {\n                        if (e.name != null) {\n                            newRow[e.name] = {\n                                'value': e.defaultValue ? e.defaultValue : \"\"\n                            };\n                            dtRow[e.name] = '';\n                        }\n                    });\n                } else {\n                    newRow = dataObj.tds;\n                    for (var i in newRow) {\n                        dtRow[i] = newRow.value;\n                    }\n                }\n                tds = {\n                    tds: newRow,\n                    status: 'insert'\n                };\n                // var selectIndex = 0;\n                var selectIndex = table.row('.selected').index();\n                if (selectIndex == null) {\n                    selectIndex = 0;\n                }\n                if (where == 'top') {\n                    gridData.trs.splice(0, 0, tds);\n                } else if (where == 'before') {\n                    gridData.trs.splice(selectIndex, 0, tds);\n                } else if (where == 'after') {\n                    gridData.trs.splice(selectIndex + 1, 0, tds);\n                } else if (where == 'end') {\n                    gridData.trs.splice(gridData.trs.length, 0, tds);\n                } else {\n                    gridData.trs.splice(selectIndex, 0, tds);\n                }\n                //*beta s\n//        var newtds = [];\n//        newtds.push(tds);\n//        if (newtds != null) {\n//          var datas = conversionTrs(newtds);\n//          this.addRow(datas);\n//        }\n                //*beta e\n                this.initData(this.getAllGridData());\n                //*beta o\n                tds = null;\n                newRow = null;\n                dtRow = null;\n            }\n        }\n        this.getCurPageGridData = function () {\n            // 性能优化\n            var curPageGridData = {};\n            if (pagingObj != null) {\n                curPageGridData.name = gridData.name;\n                curPageGridData.beanname = gridData.beanname;\n                curPageGridData.pageNum = gridData.pageNum;\n                curPageGridData.rows = gridData.rows;\n                curPageGridData.totalRows = gridData.totalRows;\n                curPageGridData.trs = [];\n                var curPageNum = pagingObj.getPageNum();\n                $(gridData.trs).each(function (i, e) {\n                    if (e.pageNum == curPageNum) {\n                        curPageGridData.trs.push(e);\n                    }\n                });\n            } else {\n                curPageGridData = gridData;\n            }\n            return curPageGridData;\n        }\n        this.getCurPageNoDeleteGridData = function () {\n            var curPageGridData = {};\n            if (pagingObj != null) {\n                curPageGridData.name = gridData.name;\n                curPageGridData.beanname = gridData.beanname;\n                curPageGridData.pageNum = gridData.pageNum;\n                curPageGridData.rows = gridData.rows;\n                curPageGridData.totalRows = gridData.totalRows;\n                curPageGridData.trs = [];\n                var curPageNoDelNum = pagingObj.getPageNum();\n                $(gridData.trs).each(function (i, e) {\n                    if (e.pageNum == curPageNoDelNum) {\n                        if (e.status != 'delete') {\n                            curPageGridData.trs.push(e);\n                        }\n                    }\n                });\n            } else {\n                curPageGridData = this.getAllNoDeleteGridData();\n            }\n            return curPageGridData;\n        }\n        this.updateRow = function (rows, dataObj) {\n            var self = this;\n            var rows1 = [];\n            if (rows.objType && rows.objType == 'row') {\n                rows1.push(rows);\n            } else {\n                row1 = rows;\n            }\n            $(rows1).each(function (i, e) {\n                $(e.getElement()).each(function (i1, e1) {\n                    if (dataObj.tds[e1.name] != null) {\n                        var dataValue = dataObj.tds[e1.name].value;\n                        if (e1.node) {\n                            var dataname = $(e1.node).attr(\"dataname\");\n                            var popdisplay = $(e1.node).attr(\"popdisplay\");\n                            var table = $.wingsWidget(self.closest(\"div[wings]\").attr(\"name\"));\n                            var options = table.getOptions();\n                            var column = options.columns[$(e1.node).attr('col')];\n                            var wingsType = column.wingsType;\n                            var data = null;\n                            var showValue = null;\n                            if (wingsType && \"pulltree\" === wingsType.toLowerCase()) {\n                                data = column.treeOption.data;\n                                showValue = table.showCodeOrCaption(dataname, popdisplay, dataValue, data);\n                            } else if (wingsType && \"select\" === wingsType.toLowerCase()) {\n                                data = column.selectOption.data;\n                                showValue = table.showCodeOrCaption(dataname, popdisplay, dataValue, data);\n                            } else if (wingsType && \"a\" === wingsType.toLowerCase()) {\n                                showValue = e1.get$Obj().children().text(dataValue);\n                            } else {\n                                if (e1.columnOpts.format) {\n                                    showValue = sword_fmt.formatText(dataValue, e1.columnOpts.format, \"\", \"\").value;\n                                }\n                            }\n                            self.updateCell(e1, dataValue, showValue);\n                        } else {\n                            e1.setValue(dataValue);\n                        }\n                    }\n                });\n            });\n        }\n        this.setAjaxParam = function (param) {\n            opts.ajaxParam = param;\n            if (pagingObj != null) {\n                var pagingOpts = pagingObj.getOptions();\n                pagingOpts.ajax.ajaxParam = param\n                pagingOpts.ajax.param = param\n                pagingObj.setOptions(pagingOpts);\n                pagingOpts = null;\n            }\n        }\n        this.addAjaxParam = function (param) {\n            for (var i in param) {\n                opts.ajaxParam[i] = param[i];\n            }\n            if (pagingObj != null) {\n                var pagingOpts = pagingObj.getOptions();\n                var ajaxParam = pagingOpts.ajax.ajaxParam;\n                var pgparam = pagingOpts.ajax.param;\n                for (var i in param) {\n                    ajaxParam[i] = param[i];\n                    pgparam[i] = param[i];\n                }\n                pagingObj.setOptions(pagingOpts);\n                pagingOpts = null;\n                ajaxParam = null;\n                pgparam = null;\n            }\n        }\n        this.getAjaxParam = function () {\n            // if (pagingObj != null) {\n            // return pagingObj.getOptions().ajax.ajaxParam;\n            // } else {\n            return opts.ajaxParam;\n            // }\n        }\n        headBind();\n        this.drawData = function (dataDt) {\n            if (dataDt.trs != null) {\n                var datas = conversionTrs(dataDt.trs);\n                table.clear();\n                this.addRow(datas);\n                reSetRowIndex();\n            }\n        }\n        this.initRowAfterCallback = function (row, rowData, index) {\n            // $(row).attr('row',index);\n            var rowChildren = $(row).children();\n            if (opts.onRowClick != null) {\n                $(row).attr('wingsOnClick', opts.onRowClick);\n                $table.setStyle(row, {\n                    cursor: 'pointer'\n                });\n            }\n            if (opts.onRowDbClick != null) {\n                $(row).attr('wingsOnDbClick', opts.onRowDbClick);\n            }\n            if (opts.rightMenu != null || opts.tableCopy) {\n                rowChildren.each(function (i, e) {\n                    $(e).attr('rightMenu', \"true\");\n                });\n            }\n            if (opts.onRowRightClick != null) {\n                rowChildren.each(function (i, e) {\n                    $(e).attr('wingsonrightclick', opts.onRowRightClick);\n                });\n            }\n            var showCols = [];\n            $(opts.columns).each(function (i, e) {\n                e.realIndex = i;\n                if (e.visible == null || e.visible) {\n                    showCols.push(e);\n                }\n            });\n\n//      var optsTds = {tds:[],pageNum:pagingObj.getPageNum()};\n//      var showCellOpts = $table.getShowCellOpts();\n            // 编辑单元格\n            for (var i = 0; i < showCols.length; i++) {\n                var $cell = $(rowChildren[i]);\n                var cellOpts = opts.columns[showCols[i].realIndex];\n\n//        if(cellOpts.disable==\"true\"){\n//          $cell.children().attr(\"disabled\",\"true\");\n//        }else{\n//          $cell.children().attr(\"disabled\",\"false\");\n//        }\n\n//        var text = $cell.text();\n//        var cellEl = this.getCellEl(index, showCols[i].realIndex);\n//        var code = $cell.text();\n                var code = null;\n                if ($cell.closest('tr').index() && $cell.attr(\"col\")) {\n                    code = $table.getCellEl($cell.closest('tr').index(), $cell.attr('col')).getValue();\n                } else {\n                    code = $cell.text();\n                }\n                $cell.attr(\"realValue\", code);\n//        var cellopts = null;\n//        if($cell.closest('tr').index()&&$cell.attr(\"col\")&&showCellOpts.trs.length>=$cell.closest('tr').index()){\n//          cellopts = showCellOpts.trs[parseInt($cell.closest('tr').attr('row'))].tds[parseInt($cell.attr(\"col\"))];\n//        }else{\n//          cellopts = opts.columns[showCols[i].realIndex];\n//        }\n                var bvisible = opts.columns[showCols[i].realIndex].bVisible;\n                if (bvisible != null && !bvisible) {\n                    $cell.remove();\n                }\n                if (opts.columns[showCols[i].realIndex].wingsmouseover != null) {\n                    $cell.attr('wingsmouseover',\n                        opts.columns[showCols[i].realIndex].wingsmouseover);\n                }\n                if (opts.columns[showCols[i].realIndex].wingsmouseout != null) {\n                    $cell.attr('wingsmouseout',\n                        opts.columns[showCols[i].realIndex].wingsmouseout);\n                }\n                if (opts.columns[showCols[i].realIndex].wingsmouseenter != null) {\n                    $cell.attr('wingsmouseenter',\n                        opts.columns[showCols[i].realIndex].wingsmouseenter);\n                }\n                if (opts.columns[showCols[i].realIndex].wingsOnClick != null) {\n                    $cell.attr('wingsOnClick',\n                        opts.columns[showCols[i].realIndex].wingsOnClick);\n                    $table.setStyle($cell[0], {cursor: 'pointer'});\n//          cellEl.destroy();\n                }\n                var rowIndex = 0;\n                if (pagingObj != null) {\n                    rowIndex = (pagingObj.getPageNum() - 1) * pagingObj.getPageSize()\n                        + index;\n                } else {\n                    rowIndex = $(row).index();\n                }\n                var realIndex = showCols[i].realIndex;\n                $cell.attr('row', rowIndex);\n                $cell.attr('col', realIndex);\n                var notitle = opts.columns[showCols[i].realIndex].notitle;\n                if (!(notitle && notitle == 'true')) {\n                    $cell.attr('title', code);\n                }\n                $cell.attr('tid', 'td_' + $cell.closest('tr').attr('row') + \"_\" + realIndex);\n//        $cell.attr('name', \"td_\"+$(row).attr('row')+\"_\"+$cell.attr('col'));\n                var cols = opts.columns[showCols[i].realIndex];\n                if (cols.required) {\n                    $cell.attr('required', cols.required);\n                }\n                if (cols.zdyRule) {\n                    $cell.attr('zdyRule', cols.zdyRule);\n                }\n                $cell.attr('rule', cols.rule);\n                if (!opts.wordBreak) {\n                    $cell.css(\"word-wrap\", null);\n                    if (opts.fixedColWidth) {\n                        $table.css({\n                            \"display\": \"table\",\n                            \"table-layout\": \"fixed\"\n                        });\n                    }\n                } else {\n                    $cell.css(\"word-wrap\", \"break-word\");\n                }\n                var column = opts.columns[$cell.attr('col')];\n                if ($(this).attr(\"disable\") != \"false\"\n                    && (column.disable == \"true\" || $(this)\n                        .attr(\"disable\") == \"true\")) {\n                    $cell.removeClass(\"NoEdit\");\n                    $cell.addClass(\"NoEdit\");\n                }\n                var wingsType = opts.columns[showCols[i].realIndex].wingsType;\n//        var wingsType= cellopts.wingsType;\n//        var copts = {};\n//        $.extend(true,copts,opts.columns[showCols[i].realIndex]);\n//        optsTds.tds.push(copts);\n                $cell.attr(\"wingsType\", wingsType);\n                $cell.attr(\"wingsgridtype\", \"td\");\n                // 集成select组件\n                if (wingsType && wingsType.toLowerCase() == 'select') {\n                    // var code = cellWs.getValue();\n                    var selectOption = options.columns[$cell.attr('col')].selectOption;\n                    cacheDataByDataName(selectOption.dataName);\n                    var showData = $table.showCodeOrCaption(selectOption.dataName,\n                        selectOption.popDisplay, code, selectOption.data);\n                    $cell.attr(\"title\", showData);\n                    $cell.text(showData);\n                    $cell.attr(\"dataName\", selectOption.dataName);\n                    $cell.attr(\"popDisplay\", selectOption.popDisplay);\n                    // $cell.attr(\"sbmitcontent\",selectOption.sbmitcontent);\n                } else if (wingsType && wingsType.toLowerCase() == \"pulltree\") {\n                    // var code = cellWs.getValue();\n                    var treeOption = options.columns[$cell.attr('col')].treeOption;\n                    cacheDataByDataName(treeOption.name);\n                    var showData = $table.showCodeOrCaption(treeOption.name,\n                        treeOption.popDisplay, code);\n                    $cell.attr(\"title\", showData);\n                    $cell.text(showData);\n                    $cell.attr(\"dataName\", treeOption.name);\n                    $cell.attr(\"popDisplay\", treeOption.popDisplay);\n                } else if (wingsType && wingsType == \"wingsDate\") {\n                    if (opts.columns[showCols[i].realIndex].format != null) {\n                        $cell.attr(\"format\", opts.columns[showCols[i].realIndex].format);\n                    } else {\n                        $cell.attr(\"format\", \"yyyy-mm-dd\");\n                    }\n                } else if (wingsType && wingsType.toLowerCase() == \"text\"\n                    || wingsType && wingsType.toLowerCase() == \"password\") {\n                    if (wingsType && wingsType.toLowerCase() == \"password\") {\n                        $cell.attr('pwd', code);\n                        var showValue = \"\";\n                        var length = 0;\n                        if ($cell.attr('pwd') != null && $cell.attr('pwd') != \"\") {\n                            length = $cell.attr('pwd').length\n                        }\n                        for (var j = 0; j < length; j++) {\n                            showValue += '*';\n                        }\n                        $cell.text(showValue);\n                    }\n                    if (wingsType && wingsType.toLowerCase() == \"text\") {\n                        showValue = code;\n                        var format = null;\n                        if (opts.columns[showCols[i].realIndex].format != null) {\n                            format = opts.columns[showCols[i].realIndex].format;\n                            showValue = sword_fmt.formatText(code, format, \"\", \"\").value;\n                        }\n                        $cell.text(showValue);\n                    }\n                    $cell.on(\n                        'blur',\n                        '>input',\n                        function () {\n                            var val = $(this).val();\n                            var td = $(this).closest('td');\n                            var wingsType = td.attr('wingsType');\n                            if (wingsType && wingsType.toLowerCase() == \"text\"\n                                || wingsType && wingsType.toLowerCase() == \"password\") {\n//                            td[0].style.padding = \"\";\n                                var tr = $(this).closest('tr');\n\n                                var cellW = $table.getCellEl(tr.index(), $(this).attr('col'));\n                                var showValue = val;\n                                if (opts.columns[$(this).attr('col')].wingsType == \"password\") {\n                                    var length = 0;\n                                    if (val != null && val != \"\") {\n                                        length = val.length;\n                                    }\n                                    for (var j = 0; j < length; j++) {\n                                        showValue += '*';\n                                    }\n                                } else {\n                                    var format = null;\n                                    if (opts.columns[$(this).attr('col')].format != null) {\n                                        format = opts.columns[$(this).attr('col')].format;\n                                        showValue = sword_fmt.formatText(val, format,\n                                            \"\", \"\").value;\n                                    }\n                                }\n//                            if (!opts.rowCheckValidator || $(this).wingsValid()) {\n                                $table.updateCell(cellW, val, showValue);\n//                            } else {\n//                              var $inputObj = td.find(\"input\");\n//                              var em = td.find(\"em\");\n//                              var inputOffset = $inputObj.offset();\n//                              em.offset({\n//                                top: inputOffset.top - 25,\n//                                left: inputOffset.left\n//                              });\n//                              $inputObj = null;\n//                              em = null;\n//                            }\n                                // 内容长度缩写\n                                if (opts.columns[$(this).attr('col')].contentLen != null) {\n                                    contentLenProcess(td, opts.columns[$(this).attr(\n                                        'col')].contentLen);\n                                }\n                                // 对外提供onblur接口\n                                if (opts.columns[$(this).attr('col')].wingsOnCellBlur != null) {\n                                    var realvalue = val;\n                                    var $node = $(this);\n                                    var rowData = $table.getRowEl(tr);\n                                    var wingsOnCellBlur = wings_getFunc(opts.columns[$(\n                                        this).attr('col')].wingsOnCellBlur);\n                                    if (wingsOnCellBlur) {\n                                        for (var b = 0; b < wingsOnCellBlur.length; b++) {\n                                            var func = eval(wingsOnCellBlur[b]);\n                                            if (typeof func == \"function\") {\n                                                var result = new func(realvalue, showValue,\n                                                    rowData, cellW.getObj(), rowData\n                                                        .getObj(),\n                                                    cellW.getValue(), $table);\n                                                result = null;\n                                            }\n                                            func = null;\n                                        }\n                                    }\n                                    $node = null;\n//                              rowData.destroy();\n                                    wingsOnCellBlur = null;\n                                }\n                                $table.validate(null, cellW);\n                                td = null;\n                                tr = null;\n//                            cellW.destroy();\n                                return true;\n                            }\n                        })\n                        .on(\n                            \"change\",\n                            \">input\",\n                            function () {\n                                var td = $(this).closest('td');\n                                var wingsType = td.attr('wingsType');\n                                if (wingsType && wingsType.toLowerCase() == \"text\"\n                                    || wingsType && wingsType.toLowerCase() == \"password\") {\n                                    // 对外提供onblur接口\n                                    if (opts.columns[$(this).attr('col')].wingsOnCellChange != null) {\n                                        var wingsOnCellChange = wings_getFunc(opts.columns[$(\n                                            this).attr('col')].wingsOnCellChange);\n                                        if (wingsOnCellChange) {\n                                            for (var b = 0; b < wingsOnCellChange.length; b++) {\n                                                var func = eval(wingsOnCellChange[b]);\n                                                if (typeof func == \"function\") {\n                                                    var result = new func();\n                                                    result = null;\n                                                }\n                                                func = null;\n                                            }\n                                        }\n                                        wingsOnCellChange = null;\n                                    }\n                                }\n                            })\n                        .on(\n                            \"focus\",\n                            \">input\",\n                            function () {\n                                var td = $(this).closest('td');\n                                var wingsType = td.attr('wingsType');\n                                if (wingsType && wingsType.toLowerCase() == \"text\"\n                                    || wingsType && wingsType.toLowerCase() == \"password\") {\n                                    // 对外提供onblur接口\n                                    if (opts.columns[$(this).attr('col')].wingsOnCellFocus != null) {\n                                        // var data = val;\n                                        // var $node = $(this)\n                                        var wingsOnCellFocus = wings_getFunc(opts.columns[$(\n                                            this).attr('col')].wingsOnCellFocus);\n                                        if (wingsOnCellFocus) {\n                                            for (var b = 0; b < wingsOnCellFocus.length; b++) {\n                                                var func = eval(wingsOnCellFocus[b]);\n                                                if (typeof func == \"function\") {\n                                                    var result = new func();\n                                                    result = null;\n                                                }\n                                                func = null;\n                                            }\n                                        }\n                                        wingsOnCellFocus = null;\n                                    }\n                                }\n                            })\n                } else if (wingsType && wingsType.toLowerCase() == \"checkbox\" || wingsType && wingsType.toLowerCase() == \"radio\") {\n                    $cell.attr(\"title\", showData);\n                } else if (wingsType && wingsType.toLowerCase() != \"a\" && wingsType.toLowerCase() != \"userdefine\") {\n                    $cell.addClass(\"NoEdit\");\n                }\n                if (wingsType) {\n                    $cell.addClass(\"wingsgrid_\" + wingsType.toLowerCase());\n                }\n                if (wingsType && wingsType != 'userdefine') {\n                    $cell.on('click', cellClick);\n                }\n                if (opts.togglecell) {\n                    $cell.on(\"keydown\", \">input\", function (e) {\n                        var key = window.event ? e.keyCode : e.which;\n                        if (key.toString() == \"13\") {\n                            searchEditTd(this, function ($nextTd, e) {\n                                $(e).blur();\n                                $nextTd.click();\n                            });\n                        }\n                    });\n                }\n                if (opts.showHJ) {\n                    if (opts.columns[showCols[i].realIndex].hj != null\n                        && opts.columns[showCols[i].realIndex].hj) {\n                        if (pagingObj != null && pagingObj.getCache(index) == null) {\n                            $table.doHj(opts.columns[showCols[i].realIndex].data,\n                                rowData[opts.columns[showCols[i].realIndex].data]);\n                        }\n                    }\n                }\n                if (opts.selectColor) {\n                    if (wingsType && wingsType.toLowerCase() == \"checkbox\"\n                        || wingsType && wingsType.toLowerCase() == \"radio\") {\n                        if ($cell.find(\"input.wingscheckbox\").is(':checked')\n                            || $cell.find(\"input.wingsradio\").is(':checked')) {\n                            $cell.closest(\"tr\").addClass(\"selected\");\n                        }\n                    }\n                }\n                $cell = null;\n            }\n//      if(!$table.insertStatus){\n//        showCellOpts.trs.push(optsTds);\n//      }\n            cells = null;\n            showCols = null;\n        }\n        this.initDataAfterCallback = function () {\n            // rowSelect列===============================================================================================================\n            if (opts.fenye != null && opts.fenye) {\n                // 如果checkbox变色联动开启，选中变色也默认开启\n                if (opts.rowSelect == 'radio' || opts.rowSelect == 'noselect') {\n                    // 单选按钮绑定change事件\n                    $this.find('tbody').on(\n                        'change',\n                        '.rowSelect',\n                        function (event) {\n                            if (event.stopPropagation) {\n                                event.stopPropagation();\n                            } else if (window.event) {\n                                window.event.cancelBubble = true;\n                            }\n                            if ($(this).is(':checked')) {\n                                $(this).closest('tr').addClass('wingsDataTableCheckBox');\n                                // var array =\n                                // $(table.column($this.find('.rowSelect').eq(0).parent().index()).nodes());\n                                var col = $table.getColEl($(this).closest('td').index()\n                                    + ':visIdx');\n                                var array = col.get$Obj();\n                                array.splice($(this).closest('tr').index(), 1);\n                                $(array).each(\n                                    function (i, e) {\n                                        $(e).find(\".rowSelect\").prop('checked', false);\n                                        $(e).closest('tr').removeClass(\n                                            'wingsDataTableCheckBox');\n                                    });\n                                col = null;\n                                array = null;\n                            } else {\n                                if ($(this).closest('tr').hasClass(\n                                    'wingsDataTableCheckBox')) {\n                                    $(this).closest('tr').removeClass(\n                                        'wingsDataTableCheckBox');\n                                }\n                            }\n                        });\n                } else if (opts.rowSelect == 'multiple') {\n                    $this.find('tbody').on('change', '.rowSelect', function (event) {\n                        if (event.stopPropagation) {\n                            event.stopPropagation();\n                        } else if (window.event) {\n                            window.event.cancelBubble = true;\n                        }\n                        if ($(this).is(':checked')) {\n                            $(this).closest('tr').addClass('wingsDataTableCheckBox');\n                        } else {\n                            $(this).closest('tr').removeClass('wingsDataTableCheckBox');\n                        }\n                    });\n                    $this.find('.dataTableCheckAll').click(allCheck);\n                }\n            } else {\n                // 如果checkbox变色联动开启，选中变色也默认开启\n                if (opts.rowSelect == 'radio') {\n                    // 单选按钮绑定change事件\n                    $(\n                        table.column($this.find('.rowSelect').eq(0).parent().index())\n                            .nodes()).each(\n                        function (i, e) {\n                            $(e).on('click', '.rowSelect', function (event) {\n                                if (event.stopPropagation) {\n                                    event.stopPropagation();\n                                } else if (window.event) {\n                                    window.event.cancelBubble = true;\n                                }\n                            });\n                            $(e).on(\n                                'change',\n                                '.rowSelect',\n                                function (event) {\n                                    if (event.stopPropagation) {\n                                        event.stopPropagation();\n                                    } else if (window.event) {\n                                        window.event.cancelBubble = true;\n                                    }\n                                    if ($(this).is(':checked')) {\n                                        $(e).closest('tr').addClass(\n                                            'wingsDataTableCheckBox');\n                                        var array = $(table.column(\n                                            $this.find('.rowSelect').eq(0).parent()\n                                                .index()).nodes());\n                                        array.splice(table.row($(this).closest('tr'))\n                                            .index(), 1);\n                                        $(array).each(\n                                            function (i, e) {\n                                                $(e).find(\".rowSelect\").prop(\n                                                    'checked', false);\n                                                $(e).closest('tr').removeClass(\n                                                    'wingsDataTableCheckBox');\n                                            });\n                                        array = null;\n                                    } else {\n                                        $(e).closest('tr').removeClass(\n                                            'wingsDataTableCheckBox');\n                                    }\n                                });\n                        });\n                } else if (opts.rowSelect == 'multiple') {\n                    $(\n                        table.column($this.find('.rowSelect').eq(0).parent().index())\n                            .nodes()).each(function (i, e) {\n                        $(e).on('click', '.rowSelect', function (event) {\n                            if (event.stopPropagation) {\n                                event.stopPropagation();\n                            } else if (window.event) {\n                                window.event.cancelBubble = true;\n                            }\n                        });\n                        // 复选框绑定change事件\n                        $(e).on('change', '.rowSelect', function (event) {\n                            if (event.stopPropagation) {\n                                event.stopPropagation();\n                            } else if (window.event) {\n                                window.event.cancelBubble = true;\n                            }\n                            if ($(this).is(':checked')) {\n                                $(this).closest('tr').addClass('wingsDataTableCheckBox');\n                            } else {\n                                $(this).closest('tr').removeClass('wingsDataTableCheckBox');\n\n                            }\n                        });\n                    });\n                    $this.find('.dataTableCheckAll').click(allCheck);\n                }\n            }\n            // 单选按钮绑定change事件\n            $this.find('tbody').on('change', '.wingsradio', function (event) {\n                if (event.stopPropagation) {\n                    event.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if ($(this).is(':checked')) {\n                    $(this).closest('tr').addClass('wingsDataTableCheckBox');\n                    // var array =\n                    // $(table.column($this.find('.rowSelect').eq(0).parent().index()).nodes());\n                    var col = $table.getColEl($(this).closest('td').index() + ':visIdx');\n                    var array = col.get$Obj();\n                    array.splice($(this).closest('tr').index(), 1);\n                    $(array).each(function (i, e) {\n                        $(e).find(\".wingsradio\").prop('checked', false);\n                        $(e).closest('tr').removeClass('wingsDataTableCheckBox');\n                        $(e).closest('tr').removeClass(\"selected\")\n                    });\n                    array = null;\n                } else {\n                    if ($(this).closest('tr').hasClass('wingsDataTableCheckBox')) {\n                        $(this).closest('tr').removeClass('wingsDataTableCheckBox');\n                        $(this).closest('tr').removeClass(\"selected\");\n                    }\n                }\n            });\n            $this.find('tbody').on('change', '.wingscheckbox', function (event) {\n                if (event.stopPropagation) {\n                    event.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if ($(this).is(':checked')) {\n                    $(this).closest('tr').addClass('wingsDataTableCheckBox');\n                    if (opts.selectColor) {\n                        $(this).closest('tr').addClass('selected');\n                    }\n                } else {\n                    //取消任意行checkbox选中状态取消全选\n                    $this.find('.dataTableCheckAll').prop('checked', false);\n                    $(this).closest('tr').removeClass('wingsDataTableCheckBox');\n                    if (opts.selectColor) {\n                        $(this).closest('tr').removeClass('selected');\n                    }\n                }\n            });\n            $this.find('.dataTableCheckAll').click(\n                function (e) {\n                    var $checkAll = $(this);\n                    $(\n                        table.column($(this).closest('th').index() + ':visIdx')\n                            .nodes()).each(function (i, e) {\n                        if ($checkAll.is(':checked')) {\n                            $(e).find('.wingscheckbox').prop('checked', true);\n                        } else {\n                            $(e).find('.wingscheckbox').prop('checked', false);\n                        }\n                        $(e).find('.wingscheckbox').change();\n                    });\n                    $checkAll = null;\n                });\n            // rowSelect列===============================================================================================================\n            $this.find(\"input\").keypress(function (e) {\n\n            });\n            if (opts.onAfterInitData != null) {\n                var tempFn = wings_getFunc(opts.onAfterInitData);\n                for (var b = 0; b < tempFn.length; b++) {\n                    var func = eval(tempFn[b]);\n                    if (typeof func == \"function\") {\n                        var rowEl = $table.getRowEl(index);\n                        var result = new func();\n//            rowEl.destroy();\n                        result = null;\n                    }\n                    func = null;\n                }\n                tempFn = null;\n            }\n\n        }\n        this.adjust = function () {\n            // table.columns.adjust().draw();\n        }\n\n        this.init = function (initopts) {\n            this.destroyTable();\n            var newOptions = $.extend({}, oldOptions, initopts);\n            return this.wingsDataTables(newOptions);\n        }\n        this.search = function (search, columnSelector) {\n            if (typeof (columnSelector) == 'undefined') {\n                table.search(search).draw();\n            } else {\n                table.columns(columnSelector).search(search).draw();\n            }\n        }\n        this.getSelectRows = function () {\n            var rows = this.getRowsData('.wingsDataTableCheckBox');\n            return rows;\n        }\n\n        // 属性\n        // var pageNum = 1;\n        // var totalPage = 0;\n\n        var wingsName = options.name;\n        this.gridData = {\n            sword: \"SwordGrid\",\n            name: wingsName,\n            beanname: null,\n            trs: []\n        };\n        var gridData = this.gridData;\n        gridData.getDataByCellWs = function (cellWs) {\n            if (cellWs && cellWs.index) {\n                var rowIndex = cellWs.index.dataRow;\n                var colName = cellWs.columnOpts.name;\n                return gridData.trs[rowIndex].tds[colName];\n            } else {\n                return null;\n            }\n        }\n        gridData.getTrsByCellWs = function (cellWs) {\n            if (cellWs && cellWs.index) {\n                var rowIndex = cellWs.index.dataRow;\n                return gridData.trs[rowIndex];\n            } else {\n                return null;\n            }\n        }\n        gridData._updateDataByCellWs = function (cellWs, value) {\n            if (cellWs && cellWs.index) {\n                var rowIndex = cellWs.index.dataRow;\n                var colName = cellWs.columnOpts.name;\n                var cellData = gridData.trs[rowIndex].tds[colName];\n                if (cellData) {\n                    cellData.originValue = cellData.value;\n                    cellData.value = value;\n                } else {\n                    gridData.trs[rowIndex].tds[colName] = {originValue: '', value: value};\n                }\n            }\n        }\n        // 表格合计\n        var gridDataSum = {};\n        //\n        // //new\n        // //初始化数据\n        // this.initData = function(data){\n        // drawDatas(data);\n        // drawPage(data);\n        // }\n        this.getAllGridData = function () {\n            return gridData;\n        }\n        this.getStatusGridData = function () {\n            var statusGridData = {\n                sword: \"SwordGrid\",\n                name: wingsName,\n                beanname: null,\n                trs: []\n            };\n            for (var i = 0; i < gridData.trs.length; i++) {\n                if (gridData.trs[i].status != null) {\n                    statusGridData.trs.push(gridData.trs[i]);\n                }\n            }\n            return statusGridData;\n        }\n        this.getAllNoDeleteGridData = function () {\n            var noDeleteGridData = {};\n            noDeleteGridData.sword = \"SwordGrid\";\n            noDeleteGridData.name = gridData.name;\n            noDeleteGridData.beanname = gridData.beanname;\n            noDeleteGridData.pageNum = gridData.pageNum;\n            noDeleteGridData.rows = gridData.rows;\n            noDeleteGridData.totalRows = gridData.totalRows;\n            noDeleteGridData.trs = [];\n            $(gridData.trs).each(function (i, e) {\n                if (e.status != 'delete') {\n                    noDeleteGridData.trs.push(e);\n                }\n            });\n            return noDeleteGridData;\n        }\n        this.getAllGridShowData = function (header) {\n\n            var gridShowData = $.extend(true, gridShowData, gridData);\n            if (header == undefined) {\n                header = opts.columns;\n            }\n            for (var i = 0; i < gridData.trs.length; i++) {\n                for (var j in gridData.trs[i].tds) {\n                    var flag = false;\n                    $(header).each(\n                        function (z, e) {\n                            if (j == e.name) {\n                                if (e.wingsType != 'hidden') {\n                                    flag = true;\n                                    if (e.wingsType == 'select') {\n                                        var caption = $table.getValByCode(\n                                            e.selectOption.dataName,\n                                            gridData.trs[i].tds[j].value);\n                                        gridShowData.trs[i].tds[j].value = caption;\n                                    } else if (e.wingsType == 'pulltree') {\n                                        var caption = $table.getValByCode(e.treeOption.name,\n                                            gridData.trs[i].tds[j].value);\n                                        gridShowData.trs[i].tds[j].value = caption;\n                                    }\n                                }\n                            }\n                        });\n                    if (!flag) {\n                        delete gridShowData.trs[i].tds[j];\n                    }\n                }\n            }\n            return gridShowData;\n        }\n        // this.addRow = function(){\n        // opts.columns\n        // $(this).append(\"<tr></tr>\");\n        // }\n        this.getCellEl = function (row_selector, col_selector, rowDom) {\n//      return new Cell(table, row_selector, col_selector, pagingObj, $table);\n//      if(typeof(row_selector) == \"object\"){\n//        rowDom = row_selector;\n//      }\n            //new s ============\n            return new Cell($(\"#\" + this[0].id)[0], rowDom, row_selector, col_selector, pagingObj, $table);\n            //new e ============\n        }\n        // 获取行对象\n        this.getRowEl = function (row_selector, rowDom) {\n            if (opts.fenye) {\n                return new Row($(\"#\" + this[0].id)[0], rowDom, row_selector, pagingObj, this\n                    .getCurPageGridData(), $table);\n            } else {\n                return new Row($(\"#\" + this[0].id)[0], rowDom, row_selector, null, null, $table);\n            }\n        }\n        this.getRowEls = function (row_selector) {\n            return new Rows(table, row_selector);\n        }\n        // 获取列对象\n        this.getColEl = function (col_selector) {\n            if (col_selector != null) {\n                var col = new Column(table, col_selector, $table);\n                col.caption = opts.columns[col.getIndex()].caption;\n                return col;\n            } else {\n                var columnEls = [];\n                $(opts.columns).each(function (i, e) {\n                    var col = new Column(table, i, $table);\n                    col.caption = e.caption;\n                    columnEls.push(col);\n                });\n                return columnEls;\n            }\n        }\n        // select\n        this.getValByCode = function (dataName, code) {\n            // 性能优化\n//      return $wings_getValByCode(dataName, code);\n            return getValByCode(dataName, code);\n        }\n        this.bind = function (obj, event, callback) {\n            var func = null;\n            if (typeof (callback) == \"function\") {\n                func = callback;\n            } else {\n                var funcN = wings_getFunc(callback);\n                if (funcN != null) {\n                    for (var b = 0; b < funcN.length; b++) {\n                        func = eval(funcN[b]);\n                    }\n                }\n            }\n            var objs = [];\n            if (obj instanceof Array) {\n                objs = objs.concat(obj);\n            } else {\n                objs.push(obj);\n            }\n            $(objs).each(\n                function (i, e) {\n                    if (event == 'wingsOnClick') {\n                        $(e).on(\n                            \"click\",\n                            function (event) {\n                                // if(event.target!=this){\n                                // return true;\n                                // }\n                                var row = $(this).closest('tr');\n                                var data = table.row(row).data();\n                                var node = table.row(row).nodes();\n                                var index = table.row(row).index();\n                                if (typeof func == \"function\") {\n                                    return new func(\n                                        data, node[0], index, this);\n                                }\n                            });\n                    } else if (event == \"wingsDbClick\") {\n\n                    } else if (event == \"wingsmouseover\") {\n                        $(e).on(\n                            \"mouseover\",\n                            function () {\n                                var row = $(this).closest('tr');\n                                var data = table.row(row).data();\n                                var node = table.row(row).nodes();\n                                var index = table.row(row).index();\n                                if (typeof func == \"function\") {\n                                    return new func(\n                                        data, node[0], index, this);\n                                }\n                            });\n                    } else if (event == \"wingsmouseout\") {\n                        $(e).on(\n                            \"mouseout\",\n                            function () {\n                                var row = $(this).closest('tr');\n                                var data = table.row(row).data();\n                                var node = table.row(row).nodes();\n                                var index = table.row(row).index();\n                                if (typeof func == \"function\") {\n                                    return new func(\n                                        data, node[0], index, this);\n                                }\n                            });\n                    } else if (event == \"wingsmouseenter\") {\n                        $(e).on(\n                            \"mouseenter\",\n                            function () {\n                                var row = $(this).closest('tr');\n                                var data = table.row(row).data();\n                                var node = table.row(row).nodes();\n                                var index = table.row(row).index();\n                                if (typeof func == \"function\") {\n                                    return new func(\n                                        data, node[0], index, this);\n                                }\n                            });\n                    } else {\n                        $(e).on(\n                            event,\n                            function () {\n                                var row = $(this).closest('tr');\n                                var data = table.row(row).data();\n                                var node = table.row(row).nodes();\n                                var index = table.row(row).index();\n                                if (typeof func == \"function\") {\n                                    return new func(\n                                        data, node[0], index, this);\n                                }\n                            });\n                    }\n                });\n        }\n        this.check = function (rowEl) {\n            var clickObj = rowEl.getObj();\n            if ($(clickObj).find(\".wingscheckbox\").length > 0) {\n                $(clickObj).find(\".rowSelect\").prop('checked', true);\n                $(clickObj).find(\".wingscheckbox\").prop('checked', true);\n            }\n            if ($(clickObj).find(\".wingsradio\").length > 0) {\n                $(clickObj).find(\".rowSelect\").prop('checked', true);\n                $(clickObj).find(\".wingsradio\").prop('checked', true);\n                if ($(clickObj).find(\".wingsradio\").length > 0) {\n                    var row = rowEl.index;\n                    table.column($(clickObj).find(\".wingsradio\").parent().attr('col'))\n                        .nodes().each(function (e, i) {\n                        if (i != row) {\n                            $(e).children().prop('checked', false);\n                        }\n                    });\n                }\n            }\n            clickObj = null;\n        }\n        this.unCheck = function (rowEl) {\n            var clickObj = rowEl.getObj();\n            if ($(clickObj).find(\".wingscheckbox\").length > 0) {\n                $(clickObj).find(\".rowSelect\").prop('checked', false);\n                $(clickObj).find(\".wingscheckbox\").prop('checked', false);\n            }\n            if ($(clickObj).find(\".wingsradio\").length > 0) {\n                $(clickObj).find(\".rowSelect\").prop('checked', false);\n                $(clickObj).find(\".wingsradio\").prop('checked', false);\n            }\n            clickObj = null;\n        }\n        this.rowColor = function (rowEl) {\n            var clickObj = rowEl.getObj();\n            $(clickObj).addClass('selected');\n            clickObj = null;\n        }\n        this.unRowColor = function (rowEl) {\n            var clickObj = rowEl.getObj();\n            $(clickObj).removeClass('selected');\n            clickObj = null\n        }\n        this.getPagingObj = function () {\n            return pagingObj;\n        }\n        this.getHj = function (name) {\n            if (name != null) {\n                return gridDataSum[name];\n            } else {\n                return gridDataSum;\n            }\n        }\n        this.doHj = function (colName, value, method, wingsValue) {\n            if (wingsValue != undefined && wingsValue != null) {\n                gridDataSum[colName] = wingsValue;\n            } else {\n                var numData = 0;\n                if (typeof (value) == \"string\") {\n                    if (!isNaN(parseFloat(value))) {\n                        numData = parseFloat(value);\n                    }\n                } else if (typeof (value) == \"number\") {\n                    numData = value;\n                }\n                if (gridDataSum[colName] != null) {\n                    if (method != null && method == \"-\") {\n                        gridDataSum[colName] -= numData;\n                    } else if (method == null || method == \"+\") {\n                        gridDataSum[colName] += numData;\n                    }\n                } else {\n                    if (method != null && method == \"-\") {\n                        gridDataSum[colName] = 0;\n                    } else if (method == null || method == \"+\") {\n                        gridDataSum[colName] = numData;\n                    }\n                }\n            }\n        }\n        // 清空数据\n        this.emptyData = function () {\n            gridData.trs = [];\n            this.initData(gridData);\n\n        }\n        this.setStyle = function (dom, styleObj) {\n            for (var i in styleObj) {\n                dom.style[i] = styleObj[i];\n            }\n        }\n\n        function updateCellshow(col, row, innerHTML) {\n            if ($table[0].rows[row].cells[col] != null) {\n                $table[0].rows[row].cells[col].innerHTML = innerHTML;\n            }\n        }\n\n        function reRowNum() {\n            var colIndex = 0;\n            $(opts.columns).each(function (i, e) {\n                if (e.visible == false) {\n                    return true;\n                }\n                if (e.wingsType == \"rowNum\") {\n                    return false;\n                } else {\n                    colIndex++;\n                }\n            })\n            var index = 1;\n            for (var i = 0; i < $table[0].rows.length; i++) {\n                innerHTML = index;\n                if (pagingObj != null) {\n                    innerHTML = (pagingObj.getPageNum() - 1) * pagingObj.getPageSize()\n                        + index\n                }\n                var thead = $($table[0].rows[i]).closest(\"thead\")[0];\n                if ($table[0].rows[i].id != options.name + '_hjtr'\n                    && (thead == null || thead.tagName != 'THEAD')) {\n                    updateCellshow(colIndex, i, innerHTML);\n                    index++;\n                }\n                thead = null;\n            }\n        }\n\n        var allShowHeaderObjs = [];\n        var allHeaderObjs = [];\n        var index = 0;\n        $(opts.columns).each(\n            function (i, e) {\n                var headerObj = {};\n                headerObj.name = e.name;\n                headerObj.caption = e.caption;\n                headerObj.index = i;\n                headerObj.type = e.wingsType;\n                if (e.visible == undefined || e.visible == true) {\n                    if (e.wingsType != \"radio\" && e.wingsType != \"checkbox\"\n                        && e.wingsType != \"userdefine\") {\n                        var showHeaderObj = {};\n                        showHeaderObj.name = headerObj.name;\n                        showHeaderObj.caption = headerObj.caption;\n                        showHeaderObj.type = headerObj.type;\n                        showHeaderObj.index = index++;\n                        allShowHeaderObjs.push(showHeaderObj);\n                    }\n                }\n                allHeaderObjs.push(headerObj);\n            });\n        this.getHeader = function (visible) {\n            if (visible == undefined || visible == true) {\n                return allShowHeaderObjs;\n            } else {\n                return allHeaderObjs;\n            }\n        }\n//    myAddEvent(window, 'resize', function() {\n//      table.draw();\n//    });\n        var header = {};\n\n        function createRow(data, target, where, childrenType) {\n\n            $tr = $('<tr style=\"height:27px\" id=\"' + options.name + '_hjtr\"></tr>');\n            if (childrenType == 'th') {\n                $(opts.columns).each(function (i, e) {\n                    if (e.type != 'hidden') {\n                        createHeader(e, $tr);\n                    }\n                })\n            } else {\n                if (data != null\n                    && (data.trs != null || data.trs != \"\" || data.trs.length > 0)) {\n                    $(opts.columns).each(\n                        function (i, e) {\n                            var $td = \"\";\n                            if (e.wingsType != 'hidden') {\n                                var showVal = data[e.data].value;\n                                if (e.format != null && e.hj == \"true\") {\n                                    showVal = sword_fmt.formatText(showVal, e.format, \"\",\n                                        \"\").value;\n                                    data[e.data].value = showVal;\n                                }\n                                if ((!e.hj || e.hj != \"true\") && (!e.hjLabel || e.hjLabel != \"true\")) {\n                                    data[e.data].value = '-';\n                                }\n                                $td = createCell(data[e.data], $tr, null);\n                                if (e.className != null) {\n                                    $td.addClass(e.className);\n                                }\n                                $td.attr(\"id\", $this.attr('id') + '_' + e.name + '_hj');\n                                $td.attr(\"format\", e.format);\n                            }\n                            $td = null;\n                        });\n                } else {\n                    var tempStr = \"没有数据\";\n                    if (\"undefined\" != typeof $wings_gird_noDataShow) {\n                        tempStr = $wings_gird_noDataShow;\n                    }\n                    $tr.append('<td valign=\"top\" colspan=\"' + Object.keys(header).length\n                        + '\" class=\"dataTables_empty\">' + tempStr + '</td>')\n                }\n            }\n            if (where == null) {\n                target.append($tr);\n            }\n            $tr = null;\n        }\n\n        function createHeader(data, target, where) {\n            var $th = $('<th class=\"sorting_disabled\"></th>');\n            if (opts.itemX != null) {\n                $th.css('width', opts.itemX);\n            }\n            if (data.x != null) {\n                $th.css('width', data.x);\n            }\n            $th.append(data.caption);\n            header[data.name] = $th;\n            target.append($th);\n            $th = null;\n        }\n\n        function createCell(data, target, where) {\n            $td = $('<td></td>');\n            if (data != null) {\n                $td.append(data.value);\n            }\n            if (data.style != null) {\n                if (data.style.width != null) {\n                    $td[0].style.width = data.style.width;\n                }\n                if (data.style.padding != null) {\n                    $td[0].style.padding = data.style.padding;\n                }\n            }\n            if (where == null) {\n                target.append($td);\n            }\n            return $td;\n        }\n\n        // 对外接口区 s================================================\n//    this.getShowCellOpts = function(){\n//        return showCellOpts;\n//    }\n        this.jcOpts = {};\n        this._itemSwitch = function (cellWs, cellOptions) {\n            var $cell = cellWs.get$Obj();\n            $tr = $cell.closest('tr');\n            var jcOptId = $tr.attr('row') + '_' + $cell.index();\n            this.jcOpts[jcOptId] = cellOptions;\n            $cell.attr('jcOptId', jcOptId);\n            if (cellOptions.wingsType) {\n                $cell.attr('wingsType', cellOptions.wingsType);\n            }\n            if (cellOptions.wingsType == 'pulltree' || cellOptions.wingsType == 'select') {\n                $cell.attr(\"dataName\", cellOptions.dataName);\n                $cell.attr(\"popDisplay\", cellOptions.popDisplay);\n//        cellWs.setValue(cellWs.getValue());\n                $cell.text(this.showCodeOrCaption(cellOptions.dataName, cellOptions.popDisplay, cellWs.getValue(), null));\n            }\n            $cell.attr('rule', null);\n            $cell.attr('zdyRule', null);\n            $cell.attr('required', null);\n        }\n        this.setMask = function (isShow) {\n//      $table.getPagingObj().getOptions().loding = isShow;\n            if (isShow) {\n                wingsPageLoading.show()\n            } else {\n                wingsPageLoading.hide()\n            }\n        }\n        this.getAllDataAfterProcess = function (showCols, needHj) {\n            var options = this.getOptions();\n            var allDataAfterProcess = {\n                name: options.name,\n                type: 'wingsGrid',\n                trs: []\n            }\n            var allShowData = this.getAllGridData();\n            var colOpts = options.columns;\n            $(allShowData.trs).each(function (i, tr) {\n                var tds = {};\n                var td = {};\n                $(colOpts).each(function (i1, e) {\n                    if (e.wingsType == 'hidden') {\n                        return true;\n                    }\n                    if (tr.tds[e.name]) {\n                        var realData = tr.tds[e.name];\n                        var showData = realData.value;\n                        //下拉转换\n                        if (e.wingsType == 'select') {\n                            showData = $table.getValByCode(e.selectOption.dataName, realData.value);\n                        } else if (e.wingsType == 'pulltree') {\n                            showData = $table.getValByCode(e.treeOption.name, realData.value);\n                        }\n                        //format转换\n                        if (e.format) {\n                            showData = sword_fmt.formatText(realData.value, e.format, \"\", \"\").value;\n                        }\n//            var tdobj = {};\n                        td[e.name] = {value: showData};\n//            td.push(tdobj);\n                        tds.tds = td;\n                    }\n                });\n                allDataAfterProcess.trs.push(tds);\n            });\n            //合计处理\n            if (needHj !== false) {\n                /* debugger; */\n                allDataAfterProcess.tdHj = {};\n                var tdhj = $table.getHj();\n                $(colOpts).each(function (i2, colopt) {\n                    if (tdhj[colopt.name] !== undefined) {\n                        if (colopt.format) {\n                            allDataAfterProcess.tdHj[colopt.name] = sword_fmt.formatText(tdhj[colopt.name], colopt.format, \"\", \"\").value;\n                        } else {\n                            allDataAfterProcess.tdHj[colopt.name] = tdhj[colopt.name];\n                        }\n                    }\n                });\n            }\n            return allDataAfterProcess;\n        }\n        this.validate = function (status, wsObj) {\n//      $.wingsValidate2.hideAll();\n            if (!opts.rowCheckValidator) {\n                return true;\n            }\n            var $validate_table = this;\n            var validate_flag = true;\n            if (wsObj && wsObj.objType && wsObj.objType === \"cell\") {\n                var $obj = wsObj.get$Obj();\n                var ruleArray = [];\n                if ($obj.attr(\"rule\")) {\n                    ruleArray.push($obj.attr(\"rule\"));\n                }\n                if ($obj.attr(\"zdyRule\")) {\n                    ruleArray.push($obj.attr(\"zdyRule\"));\n                }\n                if ($obj.attr(\"required\") && ($obj.attr(\"required\") == \"true\" || $obj.attr(\"required\") == \"required\")) {\n                    ruleArray.push(\"must\");\n                }\n                if (ruleArray.length <= 0) {\n                    return true;\n                }\n                var gValidObj = $.wingsValidate2.validObj($obj.attr(\"tid\"), $obj[0], wsObj.getValue(), ruleArray);\n                if (gValidObj.flag != 'true') {\n                    validate_flag = false;\n//            return false;\n                }\n            } else if (wsObj && wsObj.objType && wsObj.objType === \"row\") {\n                $(wsObj.getElement()).each(function (i, e) {\n                    var $obj = e.get$Obj();\n                    var ruleArray = [];\n                    if ($obj.attr(\"rule\")) {\n                        ruleArray.push($obj.attr(\"rule\"));\n                    }\n                    if ($obj.attr(\"zdyRule\")) {\n                        ruleArray.push($obj.attr(\"zdyRule\"));\n                    }\n                    if ($obj.attr(\"required\") && ($obj.attr(\"required\") == \"true\" || $obj.attr(\"required\") == \"required\")) {\n                        ruleArray.push(\"must\");\n                    }\n                    if (ruleArray.length <= 0) {\n                        return true;\n                    }\n                    var gValidObj = $.wingsValidate2.validObj($obj.attr(\"tid\"), e.getObj(), e.getValue(), ruleArray);\n                    if (gValidObj.flag != 'true') {\n                        validate_flag = false;\n//            return false;\n                    }\n                });\n            } else {\n                var validate_tds = $(this).find(\"tbody>tr>td\");\n                $(validate_tds).each(function (i, e) {\n                    if (!$(e).attr(\"col\") || !$(e).closest(\"tr\").attr(\"row\")) {\n                        return true;\n                    }\n                    var col = $(e).attr(\"col\");\n                    var row = $(e).closest(\"tr\").index();\n                    var $cell = $validate_table.getCellEl(row, col);\n                    var $obj = $cell.get$Obj();\n                    var ruleArray = [];\n                    if ($obj.attr(\"rule\")) {\n                        ruleArray.push($obj.attr(\"rule\"));\n                    }\n                    if ($obj.attr(\"zdyRule\")) {\n                        ruleArray.push($obj.attr(\"zdyRule\"));\n                    }\n                    if ($obj.attr(\"required\") && ($obj.attr(\"required\") == \"true\" || $obj.attr(\"required\") == \"required\")) {\n                        ruleArray.push(\"must\");\n                    }\n                    if (ruleArray.length <= 0) {\n                        return true;\n                    }\n                    var cellV = \"\"\n                    if (!$cell.getValue() && $cell.getValue() != 0) {\n                        cellV = \"\";\n                    } else {\n                        cellV = $cell.getValue();\n                    }\n                    var gValidObj = $.wingsValidate2.validObj($obj.attr(\"tid\"), $cell.getObj(), cellV, ruleArray);\n                    if (gValidObj.flag != 'true') {\n                        validate_flag = false;\n//            return false;\n                    }\n                });\n            }\n            return validate_flag;\n        }\n        this.setCellRule = function (cellWS, ruleStr) {\n            var $cell = cellWS.get$Obj();\n            if ($cell) {\n                $cell.attr(\"rule\", ruleStr);\n            }\n            if (ruleStr.indexOf('must') != -1) {\n                if (!opts.fzbtid) {\n                    var th = this.getHeaderEl(cellWS.name).getObj()\n                    if (th.innerHTML.indexOf(\"<span class=\\\"red\\\">*<\\/span>\") == -1) {\n                        th.innerHTML = \"<span class='red'>*</span>\" + th.innerHTML;\n                    }\n                }\n            }\n        }\n        this.buildY = function (px) {\n            buildY(px);\n        }\n        this.getTargetPageGridData = function (pageNum) {\n            var targetPageData = $table.getPagingObj().loadPage(pageNum);\n            var resultData = {\n                sword: \"SwordGrid\",\n                name: wingsName,\n                beanname: null,\n                trs: []\n            };\n            resultData.trs = targetPageData.data.trs;\n            return resultData;\n        }\n        this.loadPage = function (pageNum) {\n            this.getPagingObj().paging(pageNum);\n        }\n        this.commit = function (rowEl) {\n            var delArrary = [];\n            if (rowEl != null) {\n                if (rowEl instanceof Array) {\n                    delArrary = rowEl;\n                } else {\n                    delArrary.push(rowEl);\n                }\n                $(delArrary).each(function (i, e) {\n                    var rowindex = e.getIndex(true);\n                    $(gridData.trs).each(function (i, e) {\n                        if (rowEl != null && rowindex == i) {\n                            e.status = null;\n                        }\n                    });\n                });\n            } else {\n                $(gridData.trs).each(function (i, e) {\n                    e.status = null;\n                });\n            }\n        }\n        this.updateCell = function (cellW, dataValue, showValue) {\n            var cellData = gridData.getDataByCellWs(cellW);\n            var rowData = gridData.getTrsByCellWs(cellW);\n//      var showCellData = innerShowData.getDataByCellWs(cellW);\n            if (rowData.status != 'insert') {\n                rowData.status = 'update';\n            }\n            var colOpts = cellW.columnOpts;\n            var colName = colOpts.name;\n            if (cellData) {\n                if (cellData.value !== dataValue) {\n                    gridData._updateDataByCellWs(cellW, dataValue);\n//          showCellData.originValue  = showCellData.value;\n                    // 合计处理\n                    if (opts.showHJ && colOpts.hj) {\n                        if (cellData.originValue) {\n                            $table.doHj(colName, cellData.originValue, \"-\");\n                            $table.doHj(colName, dataValue);\n                        } else {\n                            $table.doHj(colName, dataValue);\n                        }\n                        var showHjVal = $table.getHj(colName);\n                        var $tdHj = $(\"#\" + $this.attr('id') + '_' + colName + '_hj');\n                        if ($tdHj.attr(\"format\") != null) {\n                            showHjVal = sword_fmt.formatText($table.getHj(colName), $tdHj\n                                .attr(\"format\"), \"\", \"\").value;\n                        }\n                        $tdHj.html(showHjVal);\n                    }\n                }\n            } else {\n                gridData._updateDataByCellWs(cellW, dataValue);\n                // 合计处理\n                if (opts.showHJ && colOpts.hj) {\n                    if (cellData && cellData.originValue) {\n                        $table.doHj(colName, cellData.originValue, \"-\");\n                        $table.doHj(colName, dataValue);\n                    } else {\n                        $table.doHj(colName, dataValue);\n                    }\n                    var showHjVal = $table.getHj(colName);\n                    var $tdHj = $(\"#\" + $this.attr('id') + '_' + colName + '_hj');\n                    if ($tdHj.attr(\"format\") != null) {\n                        showHjVal = sword_fmt.formatText($table.getHj(colName), $tdHj\n                            .attr(\"format\"), \"\", \"\").value;\n                    }\n                    $tdHj.html(showHjVal);\n                }\n//        showCellData.originValue  = \"\";\n            }\n            if (!opts.ptid) {\n                refreshShowData();\n            }\n//      showCellData.value = dataValue;\n            var $cellDom = cellW.get$Obj();\n            if (showValue != null) {\n                $cellDom.html(showValue);\n                $cellDom.attr('title', showValue);\n            } else {\n                $cellDom.html(gridData.getDataByCellWs(cellW).value);\n                $cellDom.attr('title', gridData.getDataByCellWs(cellW).value);\n            }\n\n//\n//      var cell = cellW.get$Obj();\n//      var index = cell.closest('tr').attr('row');\n//      var col = cell.attr('col');\n//      var colName = table.column(cell).dataSrc();\n//      var columns = opts.columns.filter(function(item, i, array) {\n//        if (item.name == colName) { return true; }\n//      });\n//      if (gridData.trs[index].tds[colName] != null) {\n//        // if (dataValue != null) {\n//        if (gridData.trs[index].tds[colName].value != dataValue) {\n//          gridData.trs[index].tds[colName].originValue = gridData.trs[index].tds[colName].value;\n//          gridData.trs[index].tds[colName].value = dataValue;\n//          if (gridData.trs[index].status != 'insert') {\n//            gridData.trs[index].status = 'update';\n//          }\n//          // 合计处理\n//          if (opts.showHJ != null && opts.showHJ) {\n//            if (columns[0].hj != null && columns[0].hj) {\n//              if (gridData.trs[index].tds[colName] != null\n//                      && gridData.trs[index].tds[colName].originValue != null) {\n//                $table.doHj(colName,\n//                        gridData.trs[index].tds[colName].originValue, \"-\");\n//                $table.doHj(colName, dataValue);\n//              } else {\n//                $table.doHj(colName, dataValue);\n//              }\n//              var showHjVal = $table.getHj(colName);\n//              var $tdHj = $(\"#\" + $this.attr('id') + '_' + colName + '_hj');\n//              if ($tdHj.attr(\"format\") != null) {\n//                showHjVal = sword_fmt.formatText($table.getHj(colName), $tdHj\n//                        .attr(\"format\"), \"\", \"\").value;\n//              }\n//              $tdHj.html(showHjVal);\n//              $tdHj = null;\n//            }\n//          }\n//        }\n//        if (showValue != null) {\n//          cell.html(showValue);\n//        } else {\n//          cell.html(gridData.trs[index].tds[colName].value);\n//        }\n//      } else {\n//        if (\"\" != dataValue) {\n//          gridData.trs[index].tds[colName] = {};\n//          gridData.trs[index].tds[colName].originValue = \"\";\n//          gridData.trs[index].tds[colName].value = dataValue;\n//          if (gridData.trs[index].status != 'insert') {\n//            if(gridData.trs[index]!=null&&gridData.trs[index]!=\"\"){\n//              gridData.trs[index].status = 'update';\n//            }\n//          }\n//          // 合计处理\n//          if (opts.showHJ != null && opts.showHJ) {\n//            if (columns[0].hj != null && columns[0].hj) {\n//              if (gridData.trs[index].tds[colName] != null\n//                      && gridData.trs[index].tds[colName].originValue != null) {\n//                $table.doHj(colName,\n//                        gridData.trs[index].tds[colName].originValue, \"-\");\n//                $table.doHj(colName, dataValue);\n//              } else {\n//                $table.doHj(colName, dataValue);\n//              }\n//              var showHjVal = $table.getHj(colName);\n//              var $tdHj = $(\"#\" + $this.attr('id') + '_' + colName + '_hj');\n//              if ($tdHj.attr(\"format\") != null) {\n//                showHjVal = sword_fmt.formatText($table.getHj(colName), $tdHj\n//                        .attr(\"format\"), \"\", \"\").value;\n//              }\n//              $tdHj.html(showHjVal);\n//              $tdHj = null;\n//            }\n//          }\n//        }else{\n//          gridData.trs[index].tds[colName] = {};\n//          gridData.trs[index].tds[colName].value = dataValue;\n//        }\n//        if (showValue != null) {\n//          cell.html(showValue);\n//        } else {\n//          cell.html(gridData.trs[index].tds[colName].value);\n//        }\n//      }\n//      cell = null;\n//      columns = null;\n        }\n        this.deleting = function (rowEl) {\n            $.wingsValidate2.hideAll();\n            var delArrary = [];\n            if (rowEl instanceof Array) {\n                delArrary = rowEl;\n            } else {\n                delArrary.push(rowEl);\n            }\n            // 选择列的序号与缓存中当页列的序号是否相当\n            var delInsertData = [];\n            $(delArrary).each(function (i, e) {\n                var rowIndex = e.get$Obj().attr('row');\n                var tr = gridData.trs[rowIndex];\n                if (tr.status != 'insert') {\n                    tr.status = 'delete';\n                } else {\n                    delInsertData.push(tr);\n                }\n                if (opts.showHJ) {\n                    $(opts.columns).each(function (i1, e1) {\n                        if (e1.hj != null && e1.hj) {\n                            var hjvalue = tr.tds[e1.data] != null ? tr.tds[e1.data].value : \"\";\n                            $table.doHj(e1.data, hjvalue, \"-\");\n                        }\n                    });\n                }\n            });\n            var tempGridData = {\n                trs: []\n            };\n            $(gridData.trs).each(function (i, e) {\n                var flag = true;\n                $(delInsertData).each(function (i1, e1) {\n                    if (e == e1) {\n                        flag = false;\n                    }\n                });\n                if (flag) {\n                    tempGridData.trs.push(e);\n                }\n            });\n            gridData.trs = tempGridData.trs;\n            this.deleteRow(delArrary);\n            if (opts.showHJ) {\n                var sumRow = [{}];\n                $(opts.columns).each(function (i1, e1) {\n                    var obj = {\n                        \"value\": \"\",\n                        \"style\": {}\n                    };\n                    if (e1.hj != null && e1.hj) {\n                        obj.value = $table.getHj(e1.data);\n                    }\n                    var header = $table.getHeaderEl(e1.data);\n                    if (header.style != null) {\n                        obj.style = header.style;\n                    }\n                    sumRow[0][e1.data] = obj;\n//          header.destroy();\n                    header = null;\n                });\n                // createRow(sumRow[0], $($this.find('tbody')));\n                // this.addRows(sumRow);\n                sumRow = null;\n            }\n            reRowNum();\n            if (!opts.ptid) {\n                refreshShowData();\n                var showData = this.getCurPageShowData();\n                this.drawData(showData);\n            }\n            delArrary = null;\n            delInsertData = null;\n            tempGridData = null;\n        }\n        this.deleteRow = function (rowEl) {\n            var delrows = [];\n            $(rowEl).each(function (i, e) {\n                delrows.push(e.getIndex());\n            });\n            table.rows(delrows).remove().draw(false);\n        }\n        this.getOptions = function () {\n            return opts;\n        }\n        this.setOptions = function (options) {\n            opts = options;\n        }\n        this.getHeaderEl = function (name) {\n            return new Header(this, name)\n        }\n        this.showCodeOrCaption = function (dataName, popDisplay, codes, data) {\n            if (codes === \"\" || codes == null) {\n                return \"\";\n            }\n            if (dataName == null && data == null) {\n                return codes;\n            }\n            if (popDisplay == null) {\n                popDisplay = \"{caption}\";\n            }\n            var code = codes.split(\",\");\n            var showData = \"\";\n            $(code).each(\n                function (i, e) {\n                    var caption = null;\n                    if (dataName != null) {\n                        caption = $table.getValByCode(dataName, e);\n                    } else {\n                        $(data).each(function (i, e1) {\n                            if (e1.code == e) {\n                                caption = e1.caption;\n                                return false;\n                            }\n                        });\n                    }\n                    showData += popDisplay.replace(/\\{code\\}/g, e).replace(\n                            /\\{caption\\}/g, caption)\n                        + \",\";\n                })\n            return showData.substring(0, showData.length - 1);\n        }\n        this.getRightMenu = function () {\n            return this.rightMenu;\n        }\n        this.setRightMenu = function (rightMenuObj) {\n            this.rightMenu = rightMenuObj;\n        }\n        this.showConsole = function () {\n            $(\"#\" + options.name + \"_wingsConsole\").show();\n        }\n        this.hideConsole = function () {\n            $(\"#\" + options.name + \"_wingsConsole\").hide();\n        }\n        if (opts.showConsole) {\n            $(\"#\" + options.name + \"_wingsConsole\").show();\n        } else {\n            $(\"#\" + options.name + \"_wingsConsole\").hide();\n        }\n        this.readonly = function () {\n            opts.columns.forEach(function (item, i, array) {\n                item.disable = \"true\";\n            });\n            $(this).find(\"tbody>tr>td\").attr(\"disable\", \"true\");\n            $(this).find(\"tbody>tr>td\").removeClass(\"NoEdit\");\n            $(this).find(\"tbody>tr>td\").addClass(\"NoEdit\");\n        }\n        this.editable = function () {\n            opts.columns.forEach(function (item, i, array) {\n                item.disable = \"false\";\n            });\n            $(this).find(\"tbody>tr>td\").attr(\"disable\", \"false\");\n            $(this).find(\"tbody>tr>td\").removeClass(\"NoEdit\");\n        }\n        this.destroy = function () {\n            if (pagingObj != null) {\n                pagingObj.destroy();\n                pagingObj = null;\n            }\n            var event = {\n                click: 1,\n                dblclick: 1,\n                mouseover: 1,\n                mouseout: 1,\n                mouseenter: 1,\n                contextmenu: 1,\n                copy: 1\n\n            }\n            $(this).find(\"*\").each(function (i, e) {\n                $(e).off(event);\n                $(e).remove();\n            })\n        }\n        this.setCellFocus = function (rowIndex, colName) {\n            var cellws = this.getCellEl(rowIndex, colName);\n            cellws.getObj().click();\n//      cellws.destroy();\n        }\n        this.getAllShowData = function () {\n            return innerShowData;\n        }\n        this.getCurPageShowData = function () {\n            var curPageShowData = $.extend(true, curPageShowData, innerShowData);\n            curPageShowData.trs = [];\n            $(innerShowData.trs).each(function (i, e) {\n                if (pagingObj && e.pageNum == pagingObj.getPageNum()) {\n                    curPageShowData.trs.push(e);\n                } else if (!pagingObj) {\n                    curPageShowData.trs.push(e);\n                }\n            })\n            return curPageShowData;\n        }\n        this.getCachePageData = function () {\n            return cachePageData;\n        }\n        // 对外接口区 e================================================\n        // 对内底层功能区 s ================================================\n        var innerShowData = {trs: []};\n        innerShowData.getDataByCellWs = function (cellWs) {\n            var rowIndex = cellWs.index.row;\n            var colName = cellWs.columnOpts.name;\n            return innerShowData.trs[rowIndex].tds[colName];\n        }\n\n        function getDataByDataName(dataName) {\n            var data = null;\n            if ($pc._initData.data) {\n                $.each($pc._initData.data, function (i, a) {\n                    if (a.sword == \"SwordSelect\") {\n                        if (a.dataName == dataName) {\n                            data = a;\n                        }\n                    } else if (a.sword == \"SwordTree\") {\n                        if (a.name == dataName) {\n                            data = a;\n                        }\n                    }\n                })\n            }\n            ;\n            return data;\n        }\n\n        var cachePageData = {data: []};\n\n        function cacheDataByDataName(dataName) {\n            var itemObj = getDataByDataName(dataName);\n            var hasFlag = false;\n            $(cachePageData.data).each(function (i, e) {\n                if ((e.sword == 'SwordSelect' && e.dataName == dataName) || (e.sword == 'SwordTree' && e.name == dataName)) {\n                    e.data = concatReduce(e.data, itemObj.data);\n                    hasFlag = true;\n                    return false;\n                }\n            });\n            if (!hasFlag) {\n                if (itemObj) {\n                    cachePageData.data.push(itemObj);\n                }\n            }\n        }\n\n        function concatReduce(oldArray, newArray) {\n            var concatArray = oldArray.concat(newArray);\n\n            //ie8下不支持reduce方法，复写此方法\n            var nonrptArray = [];\n            try {\n                var nonrptArray = concatArray.reduce(function (result, next) {\n                    var flag = false;\n                    $(result).each(function (i, e) {\n                        if (isObjectValueEqual(e, next)) {\n                            flag = true;\n                        }\n                    });\n                    if (!flag) {\n                        result.push(next);\n                    }\n                    return result;\n                }, []);\n            } catch (e) {\n                var map = \"@!@\", nonrptArray = [];\n                for (var i = 0; i < concatArray.length; i++) {\n                    var tempE = \"@!@\" + concatArray[i] + \"@!@\";\n                    if (map.indexOf(concatArray[i]) == -1) {\n                        nonrptArray.push[concatArray[i]];\n                        map += concatArray[i] + \"@!@\"\n                    }\n                }\n            }\n            /*var nonrptArray = concatArray.reduce(function(result,next){\n        var flag = false;\n        $(result).each(function(i,e){\n          if(isObjectValueEqual(e,next)){\n            flag = true;\n          }\n        });\n        if(!flag){\n          result.push(next);\n        }\n        return result;\n      },[]);*/\n            return nonrptArray;\n        }\n\n        function getValByCode(d, f) {\n            var g = [];\n            if (f.split(\",\").length > 1) {\n                g = f.split(\",\")\n            }\n            var h = '';\n            if (cachePageData) {\n                if (cachePageData.data) {\n                    $.each(cachePageData.data, function (i, a) {\n                        if (a.sword == \"SwordSelect\") {\n                            if (a.dataName == d) {\n                                $(a.data).each(function (i, e) {\n                                    if (e.code == f) {\n                                        //去掉\"&nbsp;\"\n                                        h = _wingsSelformatCaption(e.caption)\n                                    }\n                                })\n                            }\n                        } else if (a.sword == \"SwordTree\") {\n                            if (a.name == d) {\n                                var c = [];\n                                $(a.data).each(function (i, e) {\n                                    swordDataDG(e, c)\n                                });\n                                $(c).each(function (i, e) {\n                                    if (g.length <= 0) {\n                                        if (e.code == f) {\n                                            h = e.caption\n                                        }\n                                    } else {\n                                        $(g).each(function (a, b) {\n                                            if (e.code == b) {\n                                                h += e.caption + \",\"\n                                            }\n                                        })\n                                    }\n                                });\n                                if (g.length > 0) {\n                                    h = h.substring(0, h.length - 1)\n                                }\n                            }\n                        }\n                    })\n                }\n            }\n            return h\n        }\n\n        function refreshShowData() {\n            var wingsGrid = $.wingsWidget(options.name);\n            var gridData = wingsGrid.getAllGridData();\n            pageNum = 1;\n            innerShowData.trs = [];\n            $(gridData.trs).each(function (i, e) {\n                if (e.status != 'delete') {\n                    var showData = {\n                        pageNum: pageNum,\n                        dataIndex: i,\n                        tds: e.tds\n                    }\n                    innerShowData.trs.push(showData);\n                    if (pagingObj && innerShowData.trs.length % pagingObj.getPageSize() == 0) {\n                        pageNum++;\n                    }\n                }\n            });\n            if (pagingObj) {\n                var allShowData = wingsGrid.getAllShowData();\n                pagingObj.setCache(allShowData);\n                if (!opts.ptid) {\n                    pagingObj.setTotalRows(allShowData.trs.length)\n                }\n                pagingObj.refreshInfo();\n            }\n        }\n\n        function cellClick(e) {\n            $(\".ie9bugClass\").scroll(function () {\n                $(document.activeElement).blur();\n            });\n            var $cell = $(this);\n            var wingsType = $cell.attr(\"wingsType\");\n            var column = opts.columns[$(this).attr('col')];\n            var cellws = $.wingsWidget(options.name).getCellEl($cell.closest('tr').index(), column.name);\n            var cellobj = gridData.getDataByCellWs(cellws);\n            if ($(this).attr(\"disable\") != \"false\"\n                && (column.disable == \"true\" || $(this).attr(\"disable\") == \"true\" || (cellobj && cellobj.disable == 'true'))) {\n                return true;\n            }\n            if (wingsType && wingsType.toLowerCase() == 'select') {\n                var cellOpts = options.columns[$(this).attr('col')].selectOption;\n                if (!cellOpts) {\n                    cellOpts = {\n                        name: options.columns[$(this).attr('col')].data,\n                        selfObj: null,\n                        type: \"select\",\n                        dataName: null,\n                        inputClass: null,\n                        css: null,\n                        defValue: null,\n                        required: null,\n                        dataWidth: null,\n                        dataHeight: null,\n                        noSearch: null,\n                        onSelect: null,\n                        onChangeFn: null,\n                        onBlur: null,\n                        onBeforeClick: null,\n                        dataFilter: null,\n                        multiple: null,\n                        handInput: null,\n                        disable: null,\n                        allowClear: null,\n                        placeholder: null,\n                        popDisplay: '{code}|{caption}',\n                        submitcontent: null,\n                        inputDisplay: '{code}|{caption}'\n                    };\n                }\n                if ($cell.attr('jcOptId')) {\n                    var jcoptId = $cell.attr('jcOptId');\n                    cellOpts = $.extend(true, {}, cellOpts, $table.jcOpts[jcoptId]);\n                    setSelectDatas(cellOpts);\n                }\n                var gridRowIndex = $(this).closest(\"tr\").attr(\"row\");\n                var wingsGrid = $.wingsWidget(options.name);\n                var code = null;\n                if (wingsGrid.getAllGridData().trs[gridRowIndex].tds[options.columns[$(\n                    this).attr('col')].name] != null) {\n                    code = wingsGrid.getAllGridData().trs[gridRowIndex].tds[options.columns[$(\n                        this).attr('col')].name].value;\n                }\n                var column = opts.columns[$(this).attr('col')];\n                if ($(this).attr(\"disable\") != \"false\"\n                    && (column.disable == \"true\" || $(this)\n                        .attr(\"disable\") == \"true\")) {\n                    return true;\n                }\n                if (e.stopPropagation) {\n                    e.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if (e.currentTarget.tagName != \"TD\") {\n                    return false;\n                }\n                if (e.target == this) {\n                    var selectid = options.name + \"_\" + column.name\n                        + \"_\" + gridRowIndex;\n                    $(this).css('padding', \"0px 0px 0px 0px\");\n                    $(this).html(\n                        '<div id=\"' + selectid\n                        + '\" onSelectFn=\"'\n                        + cellOpts.onSelect\n                        + '\" ></div>');\n\n                    // 选中后隐藏下拉框方法\n                    var selectOption1 = {};\n                    selectOption1 = $.extend({}, selectOption1,\n                        cellOpts);\n                    var data = JSON.stringify(cellOpts.data);\n                    selectOption1.onDtHide = 'onDtSelect(' + selectid\n                        + ')'\n                    if ($(this).attr(\"disable\") == \"false\") {\n                        selectOption1.disable = false;\n                    }\n                    var row = $(this).closest('tr');\n                    var rowWs = $table.getRowEl(row[0]);\n                    var data = rowWs;\n                    var node = rowWs.getObj();\n                    selectOption1.dataFilter = null;\n                    var selector = initWingsSelector(selectid,\n                        selectOption1);\n                    cacheDataByDataName(selectOption1.dataName)\n                    //dataFilter方法设置过滤方法\n                    if (cellOpts.dataFilter != null) {\n                        if (!selectOption1.data) {\n                            setSelectDatas(selectOption1);\n                        } else {\n                            selectOption1.dtData = selectOption1.data;\n                        }\n                        //执行前方法\n                        var onDataFilter = wings_getFunc(cellOpts.dataFilter);\n                        var result = null;\n                        for (var b = 0; b < onDataFilter.length; b++) {\n                            var func = eval(onDataFilter[b]);\n                            if (typeof func == \"function\") {\n                                result = new func(selectOption1.dtData, rowWs);\n                            }\n                            ;\n                        }\n                        ;\n                        selector.initData({data: result})\n                    }\n                    if ($(\"#\" + selectid).hasClass(\"wdl\")) {\n                        $(\"#\" + selectid).removeClass(\"wdl\");\n                    }\n//                  if (opts.rowCheckValidator) {\n//                    var form = $(this).closest('form');\n//                    $.removeData(form, \"validator\");\n//                    $(form).wingsValidate();\n//                    //分页部分select不在这里校验\n//                    $(form).validate().settings.ignore = \":hidden,select[id*='pagingBar']\";\n//                    form = null;\n//                  }\n                    // 追加 onBeforeClick();\n                    if (selectOption1.onBeforeClick != null) {\n                        // alert(el.params.data.id + '=' +\n                        // el.params.data.text );\n                        // 执行前方法\n                        var onBeforeClick = wings_getFunc(selectOption1.onBeforeClick);\n                        for (var b = 0; b < onBeforeClick.length; b++) {\n                            var func = eval(onBeforeClick[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data, node, this, selector);// TODO\n                            }\n                            ;\n                        }\n                        ;\n                        onBeforeClick = null;\n                        row = null;\n//                    rowWs.destroy();\n                        data = null;\n                        node = null;\n                    }\n                    ;\n                    $(this).find(\"span.select2-selection--single\")\n                        .css(\"width\", \"100%\");\n                    $(this).find(\"span.select2-selection--single\")\n                        .css(\"height\", $(this).css(\"height\"));\n                    if (code != null) {\n                        selector.setValue(code);\n                    }\n                    selector.show(e);\n                    selectOption1 = null;\n                    selector = null;\n                }\n                wingsGrid = null;\n            } else if (wingsType && wingsType.toLowerCase() == \"pulltree\") {\n                var treeId = options.name + \"_\" + options.columns[$(this).attr('col')].name + \"_\" + $cell.closest('tr').attr('row');\n                var treeOption = options.columns[$(this).attr('col')].treeOption;\n                if (!treeOption) {\n                    var treeOption = {\n                        name: opts.columns[$(this).attr('col')].data,\n                        selfObj: null,\n                        type: \"pulltree\",\n                        treeType: '1',\n                        defValue: null,\n                        onNodeClick: null,\n                        expand: null,\n                        isJgxzs: null,\n                        dataWidth: null,\n                        dataHeight: null,\n                        lctrl: null,\n                        p_name: opts.name,\n                        onLtidBefore: null,\n                        onCheckBefore: null,\n                        height: null,\n                        popDisplay: '{code}|{caption}',\n                        itemWidth: null,\n                        dataName: null\n                    };\n                }\n                if ($cell.attr('jcOptId')) {\n                    var jcoptId = $cell.attr('jcOptId');\n                    treeOption = $.extend(true, {}, treeOption, $table.jcOpts[jcoptId]);\n                    treeOption.name = treeOption.dataName;\n                }\n                var gridRowIndex = $(this).closest(\"tr\").attr(\"row\");\n                var wingsGrid = $.wingsWidget(options.name);\n                var code = \"\";\n                if (wingsGrid.getAllGridData().trs[gridRowIndex].tds[options.columns[$(\n                    this).attr('col')].name] != null) {\n                    code = wingsGrid.getAllGridData().trs[gridRowIndex].tds[options.columns[$(\n                        this).attr('col')].name].value;\n                }\n                if (e.stopPropagation) {\n                    e.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if (e.currentTarget.tagName != \"TD\") {\n                    return false;\n                }\n                if (e.target == this) {\n                    if (!$(this).children('#' + treeId).length > 0) {\n                        $(this).css('padding', \"0px 0px 0px 0px\");\n                        $(this)\n                            .html(\n                                '<input id=\"'\n                                + treeId\n                                + '\" type=\"text\" onCheckBefore=\"'\n                                + treeOption.onCheckBefore\n                                + '\"   class=\"ztree hide\" ></input>');\n                    }\n\n                    // 选中后隐藏下拉框方法\n                    var treeOption1 = {};\n                    treeOption1 = $.extend({}, treeOption1,\n                        treeOption);\n                    treeOption1.onHideBefore = 'onDtTreeHide(\"'\n                        + treeId + '\",\"' + treeOption.onHideBefore + '\")';\n                    treeOption1.dataFilter = null;\n                    var rowWs = wingsGrid.getRowEl($(this).closest(\"tr\").index());\n                    if (treeOption1.onCheckBeforeParam) {\n                        treeOption1.onCheckBeforeParam.push(rowWs);\n                    } else {\n                        treeOption1.onCheckBeforeParam = [rowWs];\n                    }\n                    var tree = initWingsPullTree(treeId, treeOption1);\n                    if (treeOption.dataFilter) {\n                        tree.setDataFilter(treeOption.dataFilter, rowWs)\n                    }\n                    // 处理下拉菜单显示位置\n                    var pattern = /\\d+/g;\n                    var s = $(this).css(\"height\");\n                    $(this).find(\"div.input-group\").css(\"position\",\n                        \"absolute\");\n                    $(this).find(\"span.wtreeSpan\").css(\"width\",\n                        $(this).css(\"width\"));\n                    $(this).find(\"span.wtreeSpan\").css(\"height\",\n                        $(this).css(\"height\"));\n                    $(this).find(\"span.wtreeSpan\").css(\"line-height\",\n                        $(this).css(\"height\"));\n                    $(this).find(\"span.wtreeSpan\").css(\"top\",\n                        \"-\" + (s.match(pattern) / 2) + \"px\");\n                    $(this).find(\"div.wtreeDiv\").css(\"top\",\n                        (s.match(pattern) / 2) + \"px\");\n                    $(this).find(\"div.wtreeDiv\").css(\"width\",\n                        $(this).css(\"width\"));\n\n                    var itemWidth = $(this).css(\"width\");\n                    if (treeOption.itemWidth != null) {\n                        itemWidth = treeOption.itemWidth;\n                    }\n                    // $(this).find(\"div.wtreeDiv\").css(\"min-width\",\n                    // itemWidth);\n                    // $(this).find(\"div.col-xs-12\").css(\"width\",\n                    // $(this).css(\"width\"));\n\n                    // var cellyh = wingsGrid.getCellEl($(this).parent().attr(\"row\"),);\n                    treeInitFlag = false;\n                    tree.setValue(code, false, false);//\n                    treeInitFlag = true;\n                    tree.showTree(e, {width: itemWidth});// lei\n                    // cellyh.destroy();\n                    treeOption1 = null;\n                    tree = null;\n                }\n                wingsGrid = null;\n            } else if (wingsType && wingsType.toLowerCase() == 'wingsdate') {\n                var dateOption = options.columns[$(this).attr('col')].dateOption;\n                if (!dateOption) {\n                    dateOption = {\n                        name: opts.columns[$(this).attr('col')].data,\n                        selfObj: null,\n                        type: \"wingsDate\",\n                        format: \"\",\n                        inputClass: null,\n                        css: null,\n                        defValue: null,\n                        required: null,\n                        zdyRule: null,\n                        disable: null,\n                        readonly: null,\n                        startDate: null,\n                        endDate: null,\n                        onShowFn: null,\n                        onHideFn: null,\n                        onDateChange: null\n                    }\n                }\n                if ($cell.attr('jcOptId')) {\n                    var jcoptId = $cell.attr('jcOptId');\n                    dateOption = $.extend(true, {}, dateOption, $table.jcOpts[jcoptId]);\n                }\n                var trindex = $(this).closest(\"tr\").attr('row');\n                var trWs = $table.getRowEl(trindex);\n                if (e.stopPropagation) {\n                    e.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if (e.currentTarget.tagName != \"TD\") {\n                    return false;\n                }\n                var value = $(this).text();\n                if (e.target == this) {\n                    var dateId = options.name + \"_\" + column.name\n                        + \"_\" + $(this).closest(\"tr\").attr('row');\n                    if (!$(this).children('#' + dateId).length > 0) {\n                        $(this).css('padding', \"0px 0px 0px 0px\");\n                        $(this)\n                            .html(\n                                '<div id=\"'\n                                + dateId\n                                + 'div\" class=\"input-group date\"><input id=\"'\n                                + dateId\n                                + '\" class=\"form-control \" size=\"16\" type=\"text\" class=\"wingsInput\" ><span class=\"input-group-addon\"><span class=\"glyphicon glyphicon-calendar\"></span></span></div>');\n                    }\n                    dateOption.selfObj = $('#' + dateId);\n                    dateOption.inputId = dateId;\n                    dateOption.onHideFn = 'onDtDateChange(\"' + dateId + '\")';\n                    //grid重写onDateChange事件\n                    if (dateOption.onDateChange) {\n                        var onDateChange = dateOption.onDateChange\n                        dateOption.selfObj.change(function (el) {\n                            if (dateOption.isOnChageEnable === \"false\") {\n                                return;\n                            }\n                            ;\n//              var tableName = $(el.target).closest(\"div[wings='WingsGrid']\").attr(\"name\");\n//              var colIndex = $(el.target).closest(\"tr\").attr(\"col\");\n//              var rowEl = $.wingsWidget(tableName).getRowEl(colIndex);\n                            //执行前方法\n                            var onDateChange = wings_getFunc(dateOption.onDateChange);\n                            for (var b = 0; b < onDateChange.length; b++) {\n                                var func = eval(onDateChange[b]);\n                                if (typeof func == \"function\") {\n                                    var result2 = new func(el.target.value, el.target, trWs);\n                                }\n                                ;\n                            }\n                            ;\n                        });\n                    }\n                    ;\n                    var dateOptionCopy = {};\n                    $.extend(true, dateOptionCopy, dateOption);\n                    dateOptionCopy.onDateChange = null;\n                    var date = initWingsDate(dateId + \"div\",\n                        dateOptionCopy);\n                    date.setValue(value);\n                    $(\"#\" + dateId).focus();\n                }\n            } else if (wingsType && wingsType.toLowerCase() == \"text\"\n                || wingsType && wingsType.toLowerCase() == \"password\") {\n                var rowIndex = $(this).closest(\"tr\").attr(\"row\");\n//      var cellW = $table.getCellEl($(this));\n                var col = table.column($(this)).index();\n                var colName = table.column($(this)).dataSrc();\n                var cols = opts.columns[col];\n                var rules = cols.rule;\n                if ($(this).attr(\"rule\")) {\n                    rules = $(this).attr(\"rule\");\n                }\n                if (e.stopPropagation) {\n                    e.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                if (e.target != this) {\n                    return true;\n                }\n\n                //lei追加 适配 number类型\n                var text_type = 'text';\n                if (cols.s_type == 'number') {\n                    text_type = 'tel';\n                }\n\n                var input = $(\"<input name='\"\n                    + cols.data\n                    + '_'\n                    + rowIndex\n                    + '_'\n                    + col\n                    + \"' type='\" + text_type + \"' class='wingsDTAText' row='\"\n                    + rowIndex + \"' col='\" + col\n                    + \"'>\");\n                if (opts.columns[col].wingsType == \"password\") {\n                    input = $(\"<input name='\"\n                        + cols.data\n                        + '_'\n                        + rowIndex\n                        + '_'\n                        + col\n                        + \"' type='password' class='wingsDTAText' row='\"\n                        + rowIndex + \"' col='\" + col\n                        + \"'>\");\n                }\n                if (cols.maxlength != null) {\n                    input.attr('maxlength', cols.maxlength);\n                }\n                if (cols.required != null) {\n                    input.attr('required', cols.required);\n                }\n                if (rules != null) {\n                    input.attr('rule', rules);\n                }\n                if (cols.maxnb != null) {\n                    input.attr('maxnb', cols.maxnb);\n                }\n                if (cols.minnb != null) {\n                    input.attr('minnb', cols.minnb);\n                }\n                if (cols.equalTo != null) {\n                    input.attr('equalTo', cols.equalTo);\n                }\n                if (cols.rangelength != null) {\n                    input.attr('rangelength', cols.rangelength);\n                }\n//        $(this).css('padding', \"0px 0px 0px 0px\");\n                $(this).html(input);\n                var $inputObj = $(this).find(\n                    \"input[name='\" + cols.data + '_'\n                    + rowIndex + '_' + col\n                    + \"']\");\n                $inputObj.css(\"width\", \"100%\");\n                $inputObj.css(\"height\", $(this).css(\"height\"));\n                var cellwval = \"\";\n                var curindex = 0;\n                $tr = $(this).closest('tr');\n                if (gridData.trs[$tr.attr('row')].tds[colName] != null) {\n                    cellwval = gridData.trs[$tr.attr('row')].tds[colName].value;\n                }\n                $inputObj.focus().val(cellwval);\n                $inputObj.select();\n                //      $(this).find(\"input[name='\" + cols.data + '_'+ cellW.getIndex().row + '_' + col+ \"']\").val(cellwval);\n                //      if (opts.rowCheckValidator) {\n                //        var form = $(this).find('input')[0].form;\n                //        $.removeData(form, \"validator\");\n                //        $(form).wingsValidate();\n                //        //分页部分select不在这里校验\n                //        $(form).validate().settings.ignore = \":hidden,select[id*='pagingBar']\";\n                //        form = null;\n                //      }\n                cols = null;\n                input = null;\n                $inputObj = null;\n                $tr = null;\n            }\n        }\n\n        function qtSort(wcldata, data) {\n            var sortName = data.sortName;\n            var sortType = data.sortType;\n            wcldata.trs.sort(function (a, b) {\n                var avalue = parseFloat(a.tds[sortName].value || 0);\n                /* 前端中文排序处理 add chen 20220110 */\n                if (isNaN(avalue)) {\n                    var c = b.tds[sortName].value.localeCompare(a.tds[sortName].value, 'zh-CN');\n                    if (c < 0) {\n                        return sortType == 'down' ? 1 : -1;\n                    }\n                    if (c > 0) {\n                        return sortType == 'down' ? -1 : 1;\n                    } else {\n                        return 0;\n                    }\n                }\n\n                var bvalue = parseFloat(b.tds[sortName].value || 0);\n                if (avalue < bvalue) {\n                    return sortType == 'down' ? 1 : -1;\n                }\n                if (avalue > bvalue) {\n                    return sortType == 'down' ? -1 : 1;\n                } else {\n                    return 0;\n                }\n            });\n        }\n\n        function setSelectDatas(option) {\n            if ($pc._initData.data) {\n                $.each($pc._initData.data, function (i, a) {\n                    if (a.sword == \"SwordSelect\") {\n                        if (a.dataName == option.dataName) {\n                            option.dtData = a.data;\n                        }\n                    }\n                })\n            }\n            ;\n        }\n\n        function setDefaultValue(data) {\n            var dataTrs = data.trs;\n            for (var j = 0; j < dataTrs.length; j++) {\n                var tds = dataTrs[j].tds;\n                $(opts.columns).each(function (i, e) {\n                    if (e.name && !tds.hasOwnProperty(e.name)) {\n                        if (e.defaultValue) {\n                            tds[e.name] = {value: e.defaultValue};\n                        }\n                    }\n                });\n            }\n        }\n\n        // 全选按钮操作\n        function allCheck(event) {\n            var $checkAll = $(this);\n            $(table.column($(this).closest('th').index() + ':visIdx').nodes()).each(\n                function (i, e) {\n                    if ($checkAll.is(':checked')) {\n                        $(e).find('.rowSelect').prop('checked', true);\n                        $(e).find('.wingscheckbox').prop('checked', true);\n                    } else {\n                        $(e).find('.rowSelect').prop('checked', false);\n                        $(e).find('.wingscheckbox').prop('checked', false);\n                    }\n                    $(e).find('.rowSelect').change();\n                    $(e).find('.wingscheckbox').change();\n                });\n            $checkAll = null;\n            var wingsOnClick = wings_getFunc($(this).attr('wingsallcheckonclick'));\n            if (wingsOnClick) {\n                for (var b = 0; b < wingsOnClick.length; b++) {\n                    var func = eval(wingsOnClick[b]);\n                    if (typeof func == \"function\") {\n                        var result = new func(this, event);\n                        result = null;\n                    }\n                    func = null;\n                }\n            }\n            wingsOnClick = null;\n        }\n\n        // 改变表格高度\n        function buildY(px) {\n            $(table.table().node()).parent().css({\n                overflowY: 'auto'\n            });\n            $(table.table().node()).parent().css({\n                height: px\n            });\n            if ($(table.table().node()).parent()[0].clientWidth < $(table.table().node()).parent()[0].offsetWidth - 2) {\n                $(table.table().node()).addClass(\"fixedHead\");\n            } else {\n                $(table.table().node()).addClass(\"fixedHeadNoScroll\");\n            }\n        }\n\n        function reSetRowIndex() {\n            var wingsGrid = $.wingsWidget(options.name);\n            var trs = $this.find(\"tbody>tr\");\n            if (opts.ptid) {\n                var trIndex = 0;\n                $(gridData.trs).each(function (i, e) {\n                    if (pagingObj != null) {\n                        if (e.pageNum == pagingObj.getPageNum()) {\n                            if (e.status != 'delete') {\n                                $(trs[trIndex]).attr('row', i);\n                                trIndex++;\n                            }\n                            // curPageIndex++;\n                        }\n                    } else {\n                        if (e.status != 'delete') {\n                            $(trs[trIndex]).attr(\"row\", i);\n                            trIndex++;\n                        }\n                    }\n                    if (trIndex == trs.length) {\n                        return false;\n                    }\n                });\n            } else {\n                var curShowData = wingsGrid.getCurPageShowData();\n                $(curShowData.trs).each(function (i, e) {\n                    $(trs[i]).attr('row', e.dataIndex);\n                });\n            }\n        }\n\n        function dragWidth() {\n            //拖拽新===========================================================================\n//      var dragtable = $(\"<div style='display:none;position:absolute'><table id='dragtable' class='table-bordered' ><thead></thead></table></div>\");\n//      $(\"body\").append(dragtable);\n//      if (opts.dragWidth||opts.dragCol) {\n//        var mousedown = false;\n//        var dragColMouseDown = false;\n//        var $ths = $(table.table().node()).parent().find('th');\n//        if(opts.fixedHead){\n//          $ths = $(\"#\"+table.table().node().id+\"_fixedHead\").find('th');\n//        }\n//        var targetObj = null;\n//        var dragTargetIndex = null;\n//        $ths.mousedown(function(event) {\n//          if(event.offsetX>this.offsetWidth-10){\n//            if (opts.dragWidth) {\n//              targetObj = this;\n//              mousedown = true;\n//            }\n//          }\n//          else{\n//            if(opts.dragCol&&!mousedown){\n//              var th = $(this.outerHTML);\n//              dragtable.find(\"thead\").empty().append(th);\n//              dragtable.show();\n//              dragtable[0].style.left = event.clientX+5+\"px\";\n//              dragtable[0].style.top = event.clientY+5+\"px\";\n//              dragColMouseDown = true;\n//              dragTargetIndex = $(this).index();\n//            }\n//          }\n//          targetDataObj = $(\"#\"+table.table().node().id)[0].rows[1].cells[$(this).index()];\n//        });\n//        $ths.mouseup(function(event) {\n//          if(opts.dragCol&&!mousedown){\n//            dragColMouseDown = false;\n//            dragtable.hide();\n//            dragColOrder($this,oldOptions,dragTargetIndex,$(this).index());\n//          }\n//          if (opts.dragWidth) {\n//            mousedown = false;\n//          }\n//\n//        });\n//        $ths.mouseenter(function(event) {\n//          if(!mousedown){\n//            if (event.offsetX > this.offsetWidth - 10) {\n//              this.style.cursor = 'w-resize';\n//            } else {\n//              this.style.cursor = 'default';\n//            }\n//          }\n//        });\n//        var oldX = 0;\n//        $ths.mousemove(function(event) {\n//          if(mousedown){\n//            var nextObj = getNextElement(targetObj);\n//            var nextDataObj = getNextElement(targetDataObj);\n////            var nextObj = targetObj.nextElementSibling;\n////            var nextDataObj = targetDataObj.nextElementSibling;\n//            if(nextObj==null){\n//              return;\n//            }\n//            var width = 0;\n//            var tableWidth = $(this).closest(\"table\")[0].offsetWidth;\n//            if(targetObj.style.width.indexOf('%')!=-1){\n//                /* debugger; */\n//              width = tableWidth* parseFloat((parseFloat(targetObj.style.width.replace('%',''))/100).toFixed(2));\n//            }else{\n//              width = parseFloat(targetObj.style.width.replace('px','')).toFixed(2);\n////              widthData = targetObj.offsetWidth;\n//            }\n//            var jswidth = 0;\n//            if(nextObj.style.width.indexOf('%')!=-1){\n//              jswidth = tableWidth* parseFloat((parseFloat(nextObj.style.width.replace('%',''))/100).toFixed(2));\n//            }else{\n//              jswidth = parseFloat(nextObj.style.width.replace('px','')).toFixed(2);\n////              jswidthData = nextObj.offsetWidth;\n//            }\n////            var widthData = parseFloat(targetDataObj.style.width.replace('px','')).toFixed(2);\n////            var jswidthData = parseFloat(nextDataObj.style.width.replace('px','')).toFixed(2);\n//            //列宽只能是px\n//            if(event.clientX>oldX){\n//              ++width;\n//              --jswidth;\n////              ++widthData;\n////              --jswidthData;\n//            }else if(event.clientX<oldX){\n//              --width;\n//              ++jswidth;\n////              --widthData;\n////              ++jswidthData;\n//            }\n//            targetObj.style.width = width+\"px\";\n//            nextObj.style.width = jswidth+\"px\";\n////            targetDataObj.style.width = widthData+1+\"px\";\n////            nextDataObj.style.width = jswidthData+1+\"px\";\n//            oldX = event.clientX;\n//          }\n//          else if(dragColMouseDown){\n//            dragtable[0].style.left = event.clientX+5+\"px\";\n//            dragtable[0].style.top = event.clientY+5+\"px\";\n//          }\n//          else{\n//            if (event.offsetX < this.offsetWidth - 10) {\n//              this.style.cursor = 'default';\n//            }\n//          }\n//        });\n//        $ths.parent().mouseleave(function(event){\n//          if(opts.dragCol&&!mousedown){\n//            dragColMouseDown = false;\n//            dragtable.hide();\n//          }\n//          if(mousedown){\n//            mousedown = false;\n//          }\n//          this.style.cursor = 'default';\n//        });\n//      }\n            //拖拽新===========================================================================\n\n\n            if (opts.dragWidth) {\n                if (opts.fixedHead) {\n\n                } else {\n                    var wingsTD;\n                    var $ths = $(table.table().node()).parent().find('th');\n                    var dragTable = $(table.table().node())[0];\n                    $ths.mousedown(function (event) {\n                        if (this.style.cursor == 'w-resize') {\n                            dragFlag = false;\n                        }\n                        // 记录单元格\n                        wingsTD = this;\n                        if (event.offsetX > wingsTD.offsetWidth - 10) {\n                            wingsTD.mouseDown = true;\n                            wingsTD.oldX = event.clientX;\n                            wingsTD.oldWidth = wingsTD.offsetWidth;\n                        }\n                        // 记录Table宽度\n                    })\n\n                    $ths.mouseover(function (event) {\n                        if (event.offsetX > this.offsetWidth - 10) {\n                            this.style.cursor = 'w-resize';\n                        } else {\n                            this.style.cursor = 'default';\n                        }\n                    });\n                    $ths.mouseup(function (event) {\n                        if (wingsTD == undefined) {\n                            wingsTD = this;\n                        }\n                        wingsTD.mouseDown = false;\n                        wingsTD.style.cursor = 'default';\n                    });\n\n                    $ths.mousemove(function (event) {\n                        if (wingsTD == null || !wingsTD.mouseDown) {\n                            return;\n                        }\n                        // 更改鼠标样式\n                        if (event.clientX > this.offsetWidth - 10) {\n                            this.style.cursor = 'w-resize';\n                        } else {\n                            this.style.cursor = 'default';\n                        }\n                        // 取出暂存的Table Cell\n                        if (wingsTD == undefined) {\n                            wingsTD = this;\n                        }\n                        var $this = $(wingsTD);\n                        // 调整宽度\n                        if (wingsTD.mouseDown != null && wingsTD.mouseDown == true) {\n                            wingsTD.style.cursor = 'default';\n                            if (wingsTD.oldWidth + (event.clientX - wingsTD.oldX) > 0) {\n                                wingsTD.width = wingsTD.oldWidth\n                                    + (event.clientX - wingsTD.oldX);\n                            } else {\n                                return;\n                            }\n                            var tbWidth = parseFloat($(\n                                wingsTD.parentNode.parentNode.parentNode).width());\n                            var tTDWidth = parseFloat(wingsTD.width);\n                            var bfbWidth = (tTDWidth / tbWidth).toFixed(2) * 100 + '%';\n                            // 调整列宽\n                            wingsTD.style.width = wingsTD.width;\n                            wingsTD.style.cursor = 'w-resize';\n                            $this.width(bfbWidth);\n                            // 调整该列中的每个Cell\n                            /*\n               * var table = wingsTD; while (table.tagName != 'TABLE'){ table =\n               * table.parentElement; } for (j = 0; j < dragTable.rows.length;\n               * j++) { //如果百分比进行百分比换算\n               * dragTable.rows[j].cells[wingsTD.cellIndex].style.width =\n               * bfbWidth tTD.width; }\n               */\n                        }\n                    })\n                }\n            }\n        }\n\n        function dragColOrder(table, oldOptions, oldIndex, newIndex) {\n            if (oldIndex == newIndex) {\n                return;\n            }\n//      var oldRows = [];\n//      for(var i = 0;i<table.rows.length;i++){\n//        var td = table.rows[i].cells[oldIndex];\n//        oldRows.push(td);\n//      }\n//      var newRows = [];\n//      for(var j=0;j<table.rows.length;j++){\n//        var newCols = [];\n//        for(var k=0;k<table.rows[j].cells.length;k++){\n//          if(k != oldIndex){\n//            newCols.push(table.rows[j].cells[k]);\n//          }\n//          if(k == newIndex){\n//            newCols.push(oldRows[j]);\n//          }\n//        }\n//        newRows.push(newCols);\n//      }\n            var columns = oldOptions.columns;\n            var showindex = 0;\n            var tempColOpts = null;\n            var newColName = null;\n            $(columns).each(function (i, e) {\n                if (e.type != \"hidden\") {\n                    if (showindex == oldIndex) {\n                        tempColOpts = e;\n                        columns[i] = null;\n                    }\n                    showindex++;\n                }\n            });\n            showindex = 0;\n            $(columns).each(function (i, e) {\n                if (e != null && e.type != \"hidden\") {\n                    if (showindex == newIndex) {\n                        newColName = e.name;\n                        if (oldIndex > newIndex) {\n                            columns.splice(i, 0, tempColOpts);\n                        } else {\n                            columns.splice(i + 1, 0, tempColOpts);\n                        }\n                    }\n                    showindex++;\n                } else if (e == null) {\n                    showindex++;\n                }\n            });\n            $(columns).each(function (i, e) {\n                if (e == null) {\n                    columns.splice(i, 1);\n                }\n            });\n            oldOptions.columns = columns;\n            $.wingsWidget(oldOptions.name).init();\n            $.wingsWidget(oldOptions.name).initData(oldData);\n//      for(var j=0;j<table.rows.length;j++){\n//        for(var k=0;k<table.rows[j].cells.length;k++){\n//          table.rows[j].cells[k] = newRows[j][k];\n//        }\n//      }\n\n        }\n\n        // 循环查找下个文本框\n        function searchEditTd(input, callback) {\n            var $td = $(input).closest('td');\n            var $tr = $td.closest(\"tr\");\n            if ($td.index() == $tr.children(\"td\").length - 1) {\n                if ($tr.next().length <= 0) {\n                    return;\n                } else {\n                    var $nextTr = $tr.next();\n                    $td = $nextTr.children(\"td\").eq(0);\n                }\n            }\n            if ($td.attr(\"col\") == null) {\n                return;\n            }\n            var $nextTd = $td.next();\n            var nextTdOpts = opts.columns[$nextTd.attr(\"col\")];\n            if (nextTdOpts.wingsType == null || nextTdOpts.wingsType != \"text\"\n                && nextTdOpts.wingsType != \"password\"\n                || nextTdOpts.disable == \"true\") {\n                arguments.callee($nextTd, callback);\n            } else {\n                callback.call(this, $nextTd, input);\n            }\n            $td = null;\n            $tr = null;\n            $nextTr = null;\n            nextTdOpts = null;\n        }\n\n        function createConsole() {\n            if (opts.consoles != null) {\n                var $console = $(\"<div id='\"\n                    + options.name\n                    + \"_wingsConsole' class='btn-toolbar btn-group btn-group-xs wingsToolbar' style='position:;width:100%;height:20px;top:0px;background-color:#f7f7f7;'></div>\");\n                $(opts.consoles)\n                    .each(\n                        function (i, e) {\n                            if (e.wingsType != null) {\n                                var $button = $('<div  type=\"button\" style=\"height:20px;padding:2px 10px 1px 25px;margin:0px 2px;line-height:inherit;\">'\n                                    + e.caption + '</div>')\n                                if (e.wingsType == \"insert\") {\n                                    $button.attr(\"class\", \"add\");\n                                    if (e.where != null) {\n                                        switch (e.where) {\n                                            case \"before\":\n                                                $button\n                                                    .click(function () {\n                                                        var wingsGrid = $\n                                                            .wingsWidget(options.name);\n                                                        wingsGrid.insertRow(null, null,\n                                                            null, null, \"before\");\n                                                        wingsGrid = null;\n                                                    });\n                                                break;\n                                            case \"after\":\n                                                $button\n                                                    .click(function () {\n                                                        var wingsGrid = $\n                                                            .wingsWidget(options.name);\n                                                        wingsGrid.insertRow(null, null,\n                                                            null, null, \"after\");\n                                                        wingsGrid = null;\n                                                    });\n                                                break;\n                                            case \"end\":\n                                                $button\n                                                    .click(function () {\n                                                        var wingsGrid = $\n                                                            .wingsWidget(options.name);\n                                                        wingsGrid.insertRow(null, null,\n                                                            null, null, \"end\");\n                                                        wingsGrid = null;\n                                                    });\n                                                break;\n                                            default:\n                                                $button\n                                                    .click(function () {\n                                                        var wingsGrid = $\n                                                            .wingsWidget(options.name);\n                                                        wingsGrid.insertRow(null, null,\n                                                            null, null, \"before\");\n                                                        wingsGrid = null;\n                                                    });\n                                                break;\n                                        }\n                                    }\n                                } else if (e.wingsType == \"delete\") {\n                                    $button.attr(\"class\", \"delete\");\n                                    $button.on(\"click\", function () {\n                                        var wingsGrid = $.wingsWidget(options.name);\n                                        var checkName = null;\n                                        if (e.check != null) {\n                                            checkName = e.check;\n                                        }\n                                        var checkRow = wingsGrid\n                                            .getCheckedRow(checkName);\n                                        var selectRow = wingsGrid.getSelectedRow();\n\n                                        var delRows = {};\n                                        if (selectRow != null && selectRow.length > 0) {\n                                            delRows = selectRow;\n                                        }\n                                        if (checkRow != null && checkRow.length > 0) {\n                                            delRows = checkRow;\n                                        }\n                                        if (delRows.length <= 0) {\n                                            alert(\"请选择一列删除\");\n                                        } else {\n                                            if (e.delConfirm != null\n                                                && e.delConfirm != \"false\"\n                                                && confirm(e.delConfirm)\n                                                || e.delConfirm == null\n                                                || e.delConfirm == \"false\") {\n                                                wingsGrid.deleting(delRows);\n                                            }\n                                        }\n                                        wingsGrid = null;\n                                        checkRow = null\n                                    });\n                                } else if (e.wingsType == \"button\") {\n                                    $button.attr(\"class\", \"edit\");\n                                    $button.on(\"click\", function () {\n                                        var onclick = wings_getFunc(e.onclick);\n                                        if (onclick) {\n                                            for (var b = 0; b < onclick.length; b++) {\n                                                var func = eval(onclick[b]);\n                                                if (typeof func == \"function\") {\n                                                    var result = new func();\n                                                }\n                                            }\n                                        }\n                                    });\n                                }\n                                $console.append($button);\n                            }\n                            $button = null;\n                        });\n                $(\"#\" + $this[0].id + \"_wrapper\").before($console);\n                $console = null;\n            }\n        }\n\n        function createRightMenu(gridWs) {\n            var rightMenuObj = null;\n            var $rightMenu = $(\"<div id='\" + $this[0].id + \"_rightMenu'></div>\");\n            $(\"body\").append($rightMenu);\n            // var value = cellWs.getValue();\n            // cellWs.getObj().id = opts.name+\"_copyCellId\";\n            if (opts.rightMenu != null) {\n                if (opts.tableCopy != null && opts.tableCopy) {\n                    var userData = JSON.parse(opts.rightMenu.dataStr).data;\n                    var dataStr = {\n                        \"data\": [{\n                            \"code\": \"copy\",\n                            \"caption\": \"复制\",\n                            \"pcode\": null\n                        }]\n                    };\n                    // {\"code\" : \"copyRow\",\"caption\" : \"复制整行\", \"pcode\" : null}\n                    // {\"code\" : \"paste\",\"caption\" : \"粘贴\", \"pcode\" : null},\n                    dataStr.data = dataStr.data.concat(userData);\n                    opts.rightMenu.dataStr = JSON.stringify(dataStr);\n                }\n                opts.rightMenu.userSelect = opts.rightMenu.onSelect;\n                // opts.rightMenu.onSelect =\n                // \"rightMenuOnSelect('\"+opts.name+\"','\"+value+\"')\";\n                rightMenuObj = $rightMenu.wingsMenu(opts.rightMenu);\n            } else if (opts.tableCopy != null && opts.tableCopy) {\n                var dataStr = {\n                    \"data\": [{\n                        \"code\": \"copy\",\n                        \"caption\": \"复制\",\n                        \"pcode\": null\n                    }]\n                };\n                //,{\"code\" : \"paste\",\"caption\" : \"粘贴\", \"pcode\" : null}\n                // {\"code\" : \"copyRow\",\"caption\" : \"复制整行\", \"pcode\" : null}\n\n                var g = {\n                    name: $this[0].id + \"rightMenu_Name\",\n                    type: \"rightMenu\",\n                    isRightMenu: \"true\",\n                    dataStr: JSON.stringify(dataStr)\n                };\n                // onSelect: \"rightMenuOnSelect('\"+opts.name+\"','\"+value+\"')\",\n                rightMenuObj = $rightMenu.wingsMenu(g);\n            }\n            if (rightMenuObj != null) {\n                gridWs.rightMenu = rightMenuObj;\n            }\n        }\n\n        function conversionTrs(trs) {\n            // 参数赋值\n            var data = [];\n            for (var j = 0; j < trs.length; j++) {\n                var row = {};\n                for (col in opts.columns) {\n                    var colData = opts.columns[col].data;\n                    var tds = trs[j].tds;\n                    if (!tds.hasOwnProperty(colData)) {\n                        if (colData != null) {\n                            row[colData] = \"\";\n                        }\n                    } else {\n                        row[colData] = tds[colData].value;\n                    }\n                }\n                if (trs[j].status != 'delete') {\n                    data.push(row);\n                }\n                row = null;\n            }\n            return data;\n        }\n\n        function typeConversion(options) {\n            for (i in options) {\n                if (options[i] == \"\") {\n                    options[i] = undefined;\n                }\n                if (options[i] == null) {\n                    delete options[i];\n                } else if ($.trim(options[i]) == \"true\") {\n                    options[i] = true;\n                } else if ($.trim(options[i]) == \"false\") {\n                    options[i] = false;\n                } else if (typeof (options[i]) == \"string\") {\n                    if (options[i].match(/^\\d+$/) != null) {\n                        options[i] = parseInt(options[i]);\n                    } else if (options[i].substring(0, 1) == \"{\"\n                        || options[i].substring(0, 1) == \"[\") {\n                        options[i] = eval(options[i]);\n                        // for(var j = 0;i<options[i].length;j++){\n                        // var item = options[i][j];\n                        // }\n                    }\n                }\n            }\n        }\n\n        function showHeader(boolean) {\n            if (boolean) {\n                $table.find(\"thead\").show();\n            } else {\n                $table.find(\"thead\").hide();\n            }\n        }\n\n//    var multipleIndexs = new Array();\n//    function clickFunc(e) {\n//      if (e.originalEvent.detail == 2) { return true; }\n//      var clickObj = this;\n//      var trIndex = $(clickObj).index();\n//      if (opts.checkColor || opts.checkMoudle) {\n//        if (e.target.className == 'wingscheckbox'\n//                || e.target.className == 'wingsradio') { return; }\n//        if($(clickObj).find(\".wingscheckbox\").length>0){\n//          if (!$(clickObj).find(\".wingscheckbox\").prop('checked')) {\n//            $(clickObj).find(\".rowSelect\").prop('checked', true);\n//            $(clickObj).find(\".wingscheckbox\").prop('checked', true);\n////            if($.inArray(trIndex,multipleIndexs)<0){\n////              multipleIndexs.push(trIndex);\n////            }\n//          } else {\n//            $(clickObj).find(\".rowSelect\").prop('checked', false);\n//            $(clickObj).find(\".wingscheckbox\").prop('checked', false);\n////            multipleIndexs.each(function(i,e){\n////              if(multipleIndexs[i]==trIndex){\n////                multipleIndexs.splice(i,1);\n////              }\n////            })\n//          }\n//        }\n//        if($(clickObj).find(\".wingsradio\").length>0){\n//          if (!$(clickObj).find(\".wingsradio\").prop('checked')) {\n//            $(clickObj).find(\".rowSelect\").prop('checked', true);\n//            $(clickObj).find(\".wingsradio\").prop('checked', true);\n//            if ($(clickObj).find(\".wingsradio\").length > 0) {\n//              var row = $(clickObj).index();\n//              table.column($(clickObj).find(\".wingsradio\").parent().attr(\n//              'col')).nodes().each(function(e, i) {\n//                if (i != row) {\n//                  $(e).children().prop('checked', false);\n//                }\n//              });\n//            }\n//\n//          } else {\n//            $(clickObj).find(\".rowSelect\").prop('checked', false);\n//            $(clickObj).find(\".wingsradio\").prop('checked', false);\n//          }\n//        }\n//      }\n//      if (opts.selectColor) {\n//        if (opts.rowSelect == 'radio' || opts.rowSelect == 'noselect') {\n//          if ($(clickObj).hasClass('selected')) {\n//            $(clickObj).removeClass('selected');\n//          } else {\n//            $(table.rows().nodes()).each(function(i, e) {\n//              $(e).removeClass('selected');\n//            });\n//            $(clickObj).addClass('selected');\n//          }\n//        } else if (opts.rowSelect == 'multiple') {\n//          $(clickObj).toggleClass('selected');\n////          if($(clickObj).hasClass(\"selected\")){\n////            if($.inArray(trIndex,multipleIndexs)<0){\n////              multipleIndexs.push(trIndex);\n////            }\n////          }else{\n////            multipleIndexs.each(function(i,e){\n////              if(multipleIndexs[i]==trIndex){\n////                multipleIndexs.splice(i,1);\n////              }\n////            })\n////          }\n//        }\n//      }\n////      if(e.shiftKey){\n////        multipleIndexs.sort();\n////        var mullength = multipleIndexs.length;\n////        if(mullength>1){\n////          var iMin =  Math.min(multipleIndexs[mullength-2],multipleIndexs[mullength-1])\n////          var iMax =  Math.max(multipleIndexs[mullength-2],multipleIndexs[mullength-1])\n////          for(i=iMin+1;i<=iMax-1;i++){\n////            var rowEl = $table.getRowEl(i);\n////            $table.check(rowEl);\n////          }\n////        }\n////      }\n//      if($(clickObj).attr('wingsOnclick')!=null){\n//        var row = $(clickObj).closest('tr');\n//        var rowEl = $table.getRowEl(row);\n//        var cellEl = $table.getCellEl(event.currentTarget);\n//        var cellData = cellEl.getValue();\n//        var data = rowEl.getValue();\n//        var node = table.row(row).nodes();\n//        var index = table.row(row).index();\n//        var wingsOnClick = wings_getFunc($(clickObj).attr('wingsOnclick'));\n//        if (wingsOnClick) {\n//          for (var b = 0; b < wingsOnClick.length; b++) {\n//            var func = eval(wingsOnClick[b]);\n//            if (typeof func == \"function\") {\n//              var result = new func(data, node[0], index, clickObj,\n//                      cellData, cellEl);\n//              result = null;\n//            }\n//            func = null;\n//          }\n//        }\n//        wingsOnClick = null;\n//        node = null;\n//        data = null;\n//        cellData = null;\n////        cellEl.destroy();\n////        rowEl.destroy();\n//        row = null;\n//      }\n//      clickObj = null;\n//    }\n        function trClickFunc(tr, e) {\n            var clickObj = tr;\n            if (opts.checkColor || opts.checkMoudle) {\n                if (e.target.className == 'wingscheckbox'\n                    || e.target.className == 'wingsradio') {\n                    return;\n                }\n                if (!$(clickObj).find(\".wingscheckbox\").prop('checked')) {\n                    $(clickObj).find(\".rowSelect\").prop('checked', true);\n                    $(clickObj).find(\".wingscheckbox\").prop('checked', true);\n                } else {\n                    $(clickObj).find(\".rowSelect\").prop('checked', false);\n                    $(clickObj).find(\".wingscheckbox\").prop('checked', false);\n                }\n                if (!$(clickObj).find(\".wingsradio\").prop('checked')) {\n                    $(clickObj).find(\".rowSelect\").prop('checked', true);\n                    $(clickObj).find(\".wingsradio\").prop('checked', true);\n                    if ($(clickObj).find(\".wingsradio\").length > 0) {\n                        var row = $(clickObj).index();\n                        table\n                            .column(\n                                $(clickObj).find(\".wingsradio\").parent().attr(\n                                    'col')).nodes().each(function (e, i) {\n                            if (i != row) {\n                                $(e).children().prop('checked', false);\n                            }\n                        });\n                    }\n\n                } else {\n                    $(clickObj).find(\".rowSelect\").prop('checked', false);\n                    $(clickObj).find(\".wingsradio\").prop('checked', false);\n                }\n            }\n            if (opts.selectColor) {\n                if (opts.rowSelect == 'radio' || opts.rowSelect == 'noselect') {\n                    if ($(clickObj).hasClass('selected')) {\n                        $(clickObj).removeClass('selected');\n                    } else {\n                        $(table.rows().nodes()).each(function (i, e) {\n                            $(e).removeClass('selected');\n                        });\n                        $(clickObj).addClass('selected');\n                    }\n                } else if (opts.rowSelect == 'multiple') {\n                    $(clickObj).toggleClass('selected');\n                }\n            }\n            clickObj = null;\n        }\n\n        // 底层功能区e ================================================\n        //对内属性s====================================================\n        var showCellOpts = {trs: []};\n        //对内属性e====================================================\n\n        dragWidth();\n        // wings对象s ==================================================\n        // 表头对象\n        var Header = function (tableWs, columnName) {\n            var self = this;\n            self.header = {\n                style: \"\"\n            };\n            var $thead = $(tableWs).find('thead');\n            var tableOptions = tableWs.getOptions();\n            if (tableOptions.fixedHead != null && tableOptions.fixedHead) {\n                $thead = $(\"#\" + $(tableWs).attr(\"id\") + \"_fixedHead>thead\");\n            }\n            var thIndex = 0;\n            tableOptions.columns.forEach(function (item, index, obj) {\n                if (item.visible == null || item.visible) {\n                    if (item.name == columnName) {\n                        self.header = $thead.find('th')[thIndex];\n                    }\n                    thIndex++;\n                }\n            });\n\n            self.style = header.style;\n            $thead = null;\n            tableOptions = null;\n        }\n        Header.prototype.getObj = function () {\n            return this.header;\n        }\n        Header.prototype.get$Obj = function () {\n            return $(this.header);\n        }\n        Header.prototype.destroy = function () {\n            for (var i in this) {\n                this[i] = null;\n            }\n        }\n        // 单元格数据对象\n//    var Cell = function(tableDt, row_selector, col_selector, pagingObj,\n//            wingsGrid) {\n//      // 属性\n//      this.tableDt = tableDt;\n//      this.row_selector = row_selector;\n//      this.col_selector = col_selector;\n//      this.pagingObj = pagingObj;\n//      this.wingsGrid = wingsGrid;\n//      this.index = {\n//        row: row_selector,\n//        column: -1,\n//        columnVisible: -1\n//      };\n//      if (typeof (col_selector) == \"string\") {\n//        col_selector = col_selector + \":name\";\n//      }\n//      this.cellDt = tableDt.cell(row_selector, col_selector);\n//      this.settings = null;\n//      if (this.cellDt.index() != null) {\n//        this.settings = tableDt.settings()[0].aoColumns[this.cellDt.index().column];\n//        this.name = this.settings.data;\n//      }\n//      this.isNull = this.cellDt.length <= 0 ? true : false;\n//      this.objType = 'cell';\n//      return this;\n//    }\n//    Cell.prototype.getIndex = function() {\n//      if (this.cellDt.length <= 0) {\n//        return index;\n//      }\n//      index = this.cellDt.index();\n//      if (this.pagingObj != null) {\n//        index.row = (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize()\n//                + index.row;\n//      }\n//      return index;\n//    }\n//    // 获取单元格原生对象\n//    Cell.prototype.getObj = function() {\n//      return this.cellDt.node();\n//    }\n//    // 获得单元格jquery对象\n//    Cell.prototype.get$Obj = function() {\n//      return $(this.getObj());\n//    }\n//    // 获取单元格对象值\n//    Cell.prototype.getValue = function() {\n//      var rowIndex = this.getIndex().row;\n//      var gridData = this.wingsGrid.getAllGridData();\n//      var row = null;\n//      if (this.pagingObj != null) {\n//        row = gridData.trs[rowIndex];\n//      } else {\n//        rows = gridData.trs.filter(function(e, i, array) {\n//          if (i == rowIndex) { return true; }\n//        });\n//        if (rows.length > 0) {\n//          row = rows[0];\n//        }\n//      }\n//      var name = this.name;\n//      var cellVal = null;\n//      if (row != null && row.tds[name] != null) {\n//        cellVal = row.tds[name].value;\n//      } else {\n//        cellVal = \"\";\n//      }\n//      return cellVal;\n//    };\n//    Cell.prototype.setValue = function(val) {\n//      var rowIndex = this.getIndex().row;\n//      var gridData = this.wingsGrid.getAllNoDeleteGridData();\n//      var row = null;\n//      if (this.pagingObj != null) {\n//        // row = gridData.trs[rowIndex];\n//        var startPageIndex = 0;\n//        var pageObj = this.pagingObj;\n//        rows = gridData.trs.filter(function(e, i, array) {\n//          var flag = false;\n//          if (pageObj.getPageNum() == e.pageNum) {\n//            if ((pageObj.getPageNum() - 1) * pageObj.getPageSize()\n//                    + startPageIndex == rowIndex) {\n//              flag = true;\n//            }\n//            startPageIndex++;\n//            if (flag) {\n//              return true;\n//            }\n//          }\n//        });\n//        if (rows.length > 0) {\n//          row = rows[0];\n//        }\n//      } else {\n//        rows = gridData.trs.filter(function(e, i, array) {\n//          if (i == rowIndex) {\n//            return true;\n//          }\n//        });\n//        if (rows.length > 0) {\n//          row = rows[0];\n//        }\n//      }\n//      var name = this.name;\n//      var dataName = this.get$Obj().attr(\"dataName\");\n//      var popdisplay = this.get$Obj().attr(\"popdisplay\");\n//      var data = null;\n//      if(this.wingsGrid.getOptions().columns[this.getIndex().column]!=null){\n//        var selectOption = this.wingsGrid.getOptions().columns[this.getIndex().column].selectOption;\n//        if(selectOption!=null){\n//          data = selectOption.data;\n//        }\n//        var treeOption = this.wingsGrid.getOptions().columns[this.getIndex().column].treeOption;\n//        if(treeOption!=null){\n//          data = treeOption.data;\n//        }\n//        selectOption = null;\n//        treeOption = null;\n//      }\n//      var showVal = this.wingsGrid.showCodeOrCaption(dataName, popdisplay, val, data);\n//      this.get$Obj().html(showVal);\n//      if (row.status != 'insert') {\n//        row.status = \"update\";\n//      }\n//      if (row.tds[name] != null) {\n//        row.tds[name].originValue = row.tds[name].value;\n//        row.tds[name].value = val;\n//      } else {\n//        row.tds[name] = {};\n//        row.tds[name].originValue = \"\";\n//        row.tds[name].value = val;\n//      }\n//    }\n//    Cell.prototype.disable = function() {\n//      this.get$Obj().attr(\"disable\", \"true\");\n//    }\n//    Cell.prototype.enable = function() {\n//      this.get$Obj().attr(\"disable\", \"false\");\n//    }\n//    Cell.prototype.destroy = function(){\n//      for(var i in this){\n//        this[i] = null;\n//      }\n//    }\n//    var Row = function(tableDt, row_selector, pagingObj, curPageGridData,\n//            wingsGrid) {\n//      // 属性\n//      this.tableDt = tableDt;\n//      this.row_selector = row_selector;\n//      this.pagingObj = pagingObj;\n//      this.wingsGrid = wingsGrid;\n//      this.rowDt = tableDt.row(row_selector);\n//      this.isNull = this.rowDt.length <= 0 ? true : false;\n//      this.objType = 'row';\n//      return this;\n//    }\n//    Row.prototype.getObj = function() {\n//      return this.rowDt.nodes()[0];\n//    }\n//    Row.prototype.get$Obj = function() {\n//      return $(this.getObj());\n//    }\n//    Row.prototype.getIndex = function(curPage) {\n//      if (this.pagingObj != null && curPage) {\n//        return (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize()\n//                + this.rowDt.index();\n//      } else {\n//        return this.rowDt.index();\n//      }\n//    }\n//    Row.prototype.getValue = function(colName) {\n//      var curPageGridData = this.wingsGrid.getCurPageGridData();\n//      if (this.pagingObj != null) {\n//        var tds = {};\n//        // 性能优化\n//        var index = this.getIndex();\n//        $(curPageGridData.trs).each(function(i, e) {\n//          if (i == index) {\n//            if (colName != null) {\n//              tds = e.tds[colName].value;\n//            } else {\n//              tds = e.tds;\n//            }\n//          }\n//        });\n//        tds.getValue = function(name) {\n//          return tds[name].value;\n//        }\n//        return tds;\n//      } else {\n//        var unPageDatas = {};\n//        var data = this.rowDt.data()\n//        for ( var e in data) {\n//          var pro = {};\n//          pro.value = data[e];\n//          // 兼容老版本\n//          pro.toString = function() {\n//            return pro.value;\n//          }\n//          unPageDatas[e] = pro;\n//        }\n//        unPageDatas.getValue = function(name) {\n//          if(unPageDatas[name]!=null){\n//            return unPageDatas[name].value;\n//          }else{\n//            return null;\n//          }\n//        }\n//        if (colName != null) {\n//          return unPageDatas[colName];\n//        } else {\n//          return unPageDatas;\n//        }\n//      }\n//    };\n//    Row.prototype.getElement = function(col_selector) {\n//      if (col_selector != null) {\n//        return new Cell(this.tableDt, this.getIndex(), col_selector, this.pagingObj,\n//                this.wingsGrid);\n//      } else {\n//        var CellEls = [];\n//        for ( var i in this.rowDt.data()) {\n//          CellEls.push(new Cell(this.tableDt, this.row_selector, i, this.pagingObj,\n//                  this.wingsGrid));\n//        }\n//        return CellEls;\n//      }\n//    }\n//    Row.prototype.getCell = function(col_selector) {\n//      var cell = new Cell(this.tableDt, this.row_selector, col_selector, this.pagingObj,\n//              this.wingsGrid);\n//      return cell.getObj();\n//    }\n//    Row.prototype.destroy = function(){\n//      for(var i in this){\n//        this[i] = null;\n//      }\n//    }\n        //new s=======================\n        var Cell = function (table, cellDom, row_selector, col_selector, pagingObj,\n                             wingsGrid) {\n            var self = this;\n            if (wingsGrid == null) {\n                /* debugger; */\n            }\n            var options = wingsGrid.getOptions();\n            var $columns = $(options.columns);\n            self.wingsGrid = wingsGrid;\n            self.pagingObj = pagingObj;\n            self.objType = \"cell\";\n            if (cellDom != null && row_selector != null && col_selector != null) {\n                self.node = cellDom;\n                self.index = {\n                    row: row_selector,\n                    column: col_selector,\n                    columnVisible: -1\n                };\n                if (isNaN(parseInt(col_selector))) {\n                    $columns.each(function (i, e) {\n                        if (e.data == col_selector) {\n                            self.columnOpts = e;\n                            self.index.column = i;\n                            self.name = e.data;\n                            if (e.visible != null && !e.visible) {\n                                self.index.columnVisible = -1;\n                            }\n                            return false;\n                        }\n                        if (e.visible == null || e.visible) {\n                            self.index.columnVisible++;\n                        }\n                    });\n                } else {\n                    self.index.column = parseInt(col_selector);\n                    $columns.each(function (i, e) {\n                        if (i == col_selector) {\n                            self.columnOpts = e;\n                            self.name = e.data;\n                            if (e.visible != null && !e.visible) {\n                                self.index.columnVisible = -1;\n                            }\n                            return false;\n                        }\n                        if (e.visible == null || e.visible) {\n                            self.index.columnVisible++;\n                        }\n                    });\n                }\n            } else {\n                var tbody = $(wingsGrid).find(\"tbody\")[0];\n                if (row_selector != null && col_selector != null && tbody != null) {\n                    self.index = {\n                        row: parseInt(row_selector),\n                        rowVisible: parseInt(row_selector),\n                        column: 0,\n                        columnVisible: 0\n                    }\n                    if (isNaN(parseInt(col_selector))) {\n                        $columns.each(function (i, e) {\n                            if (e.data == col_selector) {\n                                self.columnOpts = e;\n                                self.index.column = i;\n                                self.name = e.data;\n                                if (e.visible != null && !e.visible) {\n                                    self.index.columnVisible = -1;\n                                }\n                                return false;\n                            }\n                            if (e.visible == null || e.visible) {\n                                self.index.columnVisible++;\n                            }\n                        });\n                    } else {\n                        self.index.column = parseInt(col_selector);\n                        $columns.each(function (i, e) {\n                            if (i == col_selector) {\n                                self.columnOpts = e;\n                                self.name = e.data;\n                                if (e.visible != null && !e.visible) {\n                                    self.index.columnVisible = -1;\n                                }\n                                return false;\n                            }\n                            if (e.visible == null || e.visible) {\n                                self.index.columnVisible++;\n                            }\n                        });\n                    }\n                    if (self.index.rowVisible != -1 && self.index.columnVisible != -1) {\n                        self.node = tbody.rows[self.index.rowVisible].cells[self.index.columnVisible];\n                    }\n                } else {\n//          alert(\"参数为空\");\n                    return null;\n                }\n            }\n            var gridData = wingsGrid.getAllGridData();\n            if (self.index) {\n                var dataIndex = 0;\n                $(gridData.trs).each(function (i, e) {\n                    if (pagingObj) {\n                        if (pagingObj.getPageNum() == e.pageNum) {\n                            if (e.status != 'delete') {\n                                if (dataIndex == row_selector) {\n                                    self.index.dataRow = i;\n                                }\n                                dataIndex++;\n                            }\n                        }\n                    } else {\n                        if (e.status != 'delete') {\n                            if (dataIndex == row_selector) {\n                                self.index.dataRow = i;\n                            }\n                            dataIndex++;\n                        }\n                    }\n                });\n            }\n\n//      if(self.node){\n//        self.position = {\n//          dataRow: $(self.node).closest('tr').attr('row'),\n//          row: $(self.node).closest('tr').index(),\n//          col: $(self.node).attr('col')\n//        }\n//        var curPageIndex = 0;\n//        self.cellObj = gridData.getDataByCellWs(self);\n//      }\n            return self;\n        }\n        Cell.prototype.getDisable = function () {\n            return this.columnOpts ? this.columnOpts.disable : 'false';\n        }\n        Cell.prototype.getIndex = function () {\n            if (this.pagingObj != null) {\n                index.row = (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize()\n                    + this.index.row;\n            }\n            return this.index;\n        }\n        // 获取单元格原生对象\n        Cell.prototype.getObj = function () {\n            return this.node;\n        }\n        // 获得单元格jquery对象\n        Cell.prototype.get$Obj = function () {\n            return $(this.node);\n        }\n        // 获取单元格对象值\n        Cell.prototype.getValue = function () {\n            var self = this;\n//      var rowIndex = this.get$Obj().closest('tr').attr('row');\n            var gridData = this.wingsGrid.getAllGridData();\n            var curPageIndex = 0;\n            var cellVal = null;\n            $(gridData.trs).each(function (i, e) {\n                if (e.status == 'delete') {\n                    return true;\n                }\n                if (self.pagingObj != null) {\n                    curPageNum = self.pagingObj.getPageNum();\n                    if (curPageNum == e.pageNum) {\n                        if (self.index.row == curPageIndex) {\n                            if (e.tds[self.name]) {\n                                cellVal = e.tds[self.name].value;\n                                return false;\n                            }\n                        }\n                        curPageIndex++;\n                    }\n                } else {\n                    if (self.index.row == curPageIndex) {\n                        if (e.tds[self.name]) {\n                            cellVal = e.tds[self.name].value;\n                            return false;\n                        }\n                    }\n                    curPageIndex++;\n                }\n            });\n            return cellVal;\n//      var row = null;\n//      if (this.pagingObj != null) {\n//        row = gridData.trs[rowIndex];\n//      } else {\n//        rows = gridData.trs.filter(function(e, i, array) {\n//          if (i == rowIndex) { return true; }\n//        });\n//        if (rows.length > 0) {\n//          row = rows[0];\n//        }\n//      }\n//      var cellVal = null;\n//      if (row != null && row.tds[this.name] != null) {\n//        cellVal = row.tds[this.name].value;\n//      } else {\n//        cellVal = \"\";\n//      }\n//      return cellVal;\n        };\n        Cell.prototype.setValue = function (val) {\n            var rowIndex = this.getIndex().row;\n            var gridData = this.wingsGrid.getAllNoDeleteGridData();\n            var row = null;\n            if (this.pagingObj != null) {\n                // row = gridData.trs[rowIndex];\n                var startPageIndex = 0;\n                var pageObj = this.pagingObj;\n                rows = gridData.trs.filter(function (e, i, array) {\n                    var flag = false;\n                    if (pageObj.getPageNum() == e.pageNum) {\n                        if ((pageObj.getPageNum() - 1) * pageObj.getPageSize()\n                            + startPageIndex == rowIndex) {\n                            flag = true;\n                        }\n                        startPageIndex++;\n                        if (flag) {\n                            return true;\n                        }\n                    }\n                });\n                if (rows.length > 0) {\n                    row = rows[0];\n                }\n            } else {\n                rows = gridData.trs.filter(function (e, i, array) {\n                    if (i == rowIndex) {\n                        return true;\n                    }\n                });\n                if (rows.length > 0) {\n                    row = rows[0];\n                }\n            }\n            var name = this.name;\n            var dataName = this.get$Obj().attr(\"dataName\");\n            var popdisplay = this.get$Obj().attr(\"popdisplay\");\n            var data = null;\n            if (this.wingsGrid.getOptions().columns[this.getIndex().column] != null) {\n                var selectOption = this.wingsGrid.getOptions().columns[this.getIndex().column].selectOption;\n                if (selectOption != null) {\n                    data = selectOption.data;\n                }\n                var treeOption = this.wingsGrid.getOptions().columns[this.getIndex().column].treeOption;\n                if (treeOption != null) {\n                    data = treeOption.data;\n                }\n                selectOption = null;\n                treeOption = null;\n            }\n            var showVal = this.wingsGrid.showCodeOrCaption(dataName, popdisplay, val, data);\n            this.get$Obj().html(showVal);\n            if (row.status != 'insert') {\n                row.status = \"update\";\n            }\n            if (row.tds[name] != null) {\n                row.tds[name].originValue = row.tds[name].value;\n                row.tds[name].value = val;\n            } else {\n                row.tds[name] = {};\n                row.tds[name].originValue = \"\";\n                row.tds[name].value = val;\n            }\n        }\n        Cell.prototype.disable = function () {\n            this.get$Obj().attr(\"disable\", \"true\");\n            this.get$Obj().removeClass(\"NoEdit\");\n            this.get$Obj().addClass(\"NoEdit\");\n            if (this.cellObj) {\n                this.cellObj.disable = 'true';\n            }\n\n        }\n        Cell.prototype.enable = function () {\n            this.get$Obj().attr(\"disable\", \"false\");\n            if (this.get$Obj().hasClass(\"NoEdit\")) {\n                this.get$Obj().removeClass(\"NoEdit\");\n            }\n            if (this.cellObj) {\n                this.cellObj.disable = 'false';\n            }\n        }\n        Cell.prototype.destroy = function () {\n            for (var i in this) {\n                this[i] = null;\n            }\n        }\n        var Row = function (table, rowDom, row_selector, pagingObj, curPageGridData,\n                            wingsGrid) {\n            if (isNaN(parseInt(row_selector))) {\n                if (row_selector.tagName != null && row_selector.tagName == \"TD\") {\n                    row_selector = $(row_selector).closest(\"tr\").index();\n                } else {\n                    row_selector = $(row_selector).index();\n                }\n            }\n            // 属性\n            var self = this;\n            self.pagingObj = pagingObj;\n            self.wingsGrid = wingsGrid;\n            self.objType = 'row';\n            if (rowDom != null && row_selector != null) {\n                self.node = rowDom;\n                self.index = row_selector;\n                self.rowDom = rowDom;\n            } else {\n                var tbody = $(table).find(\"tbody\")[0];\n                if (row_selector != null && tbody != null) {\n                    self.node = tbody.rows[row_selector];\n                    self.index = row_selector;\n                    self.isNull = self.node == null ? true : false;\n                } else {\n                    alert(\"参数错误\");\n                    return null;\n                }\n            }\n            return self;\n        }\n        Row.prototype.getIndex = function (curPage) {\n            if (this.pagingObj != null && curPage) {\n                return (this.pagingObj.getPageNum() - 1) * this.pagingObj.getPageSize()\n                    + this.index;\n            } else {\n                return this.index;\n            }\n        }\n        Row.prototype.getObj = function () {\n            return this.node;\n        }\n        Row.prototype.get$Obj = function (selector) {\n            var $tr = $(this.node);\n            if (selector) {\n                return $tr.find(selector);\n            }\n            return $tr\n        }\n        Row.prototype.getValue = function (colName) {\n\n            var self = this;\n            var gridData = this.wingsGrid.getAllGridData();\n            if (this.wingsGrid.getOptions().fenye && !this.wingsGrid.getOptions().ptid) {\n                gridData = this.wingsGrid.getAllShowData();\n            }\n            var curPageIndex = 0;\n            var tds = \"\";\n            $(gridData.trs).each(function (i, e) {\n                if (e.status == 'delete') {\n                    return true;\n                }\n                if (self.pagingObj != null) {\n                    var curPageNum = self.pagingObj.getPageNum();\n                    if (curPageNum == e.pageNum) {\n                        if (self.index == curPageIndex) {\n                            if (!colName) {\n                                tds = e.tds;\n                                return false;\n                            } else if (e.tds[colName]) {\n                                tds = e.tds[colName].value;\n                                return false;\n                            }\n                        }\n                        curPageIndex++;\n                    }\n                } else {\n                    if (self.index == curPageIndex) {\n                        if (!colName) {\n                            tds = e.tds;\n                            return false;\n                        } else if (e.tds[colName]) {\n                            tds = e.tds[colName].value;\n                            return false;\n                        }\n                    }\n                    curPageIndex++;\n                }\n            });\n            tds.getValue = function (colName) {\n                if (tds[colName] != null) {\n                    return tds[colName].value;\n                }\n            }\n            return tds;\n//      var curPageNoDeleteGridData = this.wingsGrid.getCurPageNoDeleteGridData();\n////      if (this.pagingObj != null) {\n//      var tds = \"\";\n//      // 性能优化\n//      var index = this.getIndex();\n//      $(curPageNoDeleteGridData.trs).each(function(i, e) {\n//        if (i == index) {\n//          if (colName != null) {\n//            if(e.tds[colName]){\n//              tds = e.tds[colName].value;\n//            }\n//          } else {\n//            tds = e.tds;\n//          }\n//        }\n//      });\n//      tds.getValue = function(name) {\n//        if(tds[name]!=null){\n//          return tds[name].value;\n//        }\n//      }\n//      return tds;\n        };\n        Row.prototype.getElement = function (col_selector) {\n            var $columns = $(this.wingsGrid.getOptions().columns);\n            var colIndex = col_selector;\n            if (isNaN(parseInt(col_selector))) {\n                colIndex = 0;\n                $columns.each(function (i, e) {\n                    if (e.data == col_selector) {\n                        if (e.visible != null && !e.visible) {\n                            colIndex = -1;\n                        }\n                        return false;\n                    }\n                    if (e.visible == null || e.visible) {\n                        colIndex++;\n                    }\n                });\n            }\n            var cellDom = null;\n            if (this.rowDom != null) {\n                cellDom = this.node.children[colIndex];\n            }\n//      var realIndex = this.get$Obj().attr(\"row\");\n            var realIndex = this.get$Obj().index();\n            if (col_selector != null) {\n                return new Cell($(\"#\" + this.wingsGrid[0].id)[0], cellDom, realIndex, col_selector, this.pagingObj,\n                    this.wingsGrid);\n            } else {\n                var CellEls = [];\n                var columns = this.wingsGrid.getOptions().columns;\n                for (var i = 0; i < columns.length; i++) {\n                    CellEls.push(new Cell($(\"#\" + this.wingsGrid[0].id)[0], null, realIndex, i, this.pagingObj,\n                        this.wingsGrid));\n                }\n                return CellEls;\n            }\n        }\n        Row.prototype.getCell = function (col_selector) {\n            if (col_selector != null) {\n                var cell = this.getElement(col_selector);\n                return cell.getObj();\n            }\n        }\n        Row.prototype.destroy = function () {\n            for (var i in this) {\n                this[i] = null;\n            }\n        }\n        //new e=======================\n        var Rows = function (tableDt, row_selector) {\n            this.tableDt = tableDt;\n            this.row_selector = row_selector;\n            this.rowDt = tableDt.rows(row_selector);\n            // 属性\n            this.isNull = rowDt.length <= 0 ? true : false;\n            this.objType = 'rows';\n            return this;\n        }\n        // 获取行原生对象\n        Rows.prototype.getObjs = function () {\n            return this.rowDt.nodes();\n        }\n        // 获取行jquery对象\n        Rows.prototype.get$Objs = function () {\n            var $objs = [];\n            var objs = this.getObjs();\n            $(objs).each(function (i, e) {\n                $objs.push($(e));\n            });\n            return $objs;\n        }\n        // 获取行位置\n        Rows.prototype.getIndexes = function () {\n            return this.rowDt.indexes();\n        }\n        // 获取行对象值，参数：列名（不填返回整行数组）\n        Rows.prototype.getValues = function (colName) {\n            if (colName != null) {\n                var data = [];\n\n                $(this.rowDt.data()).each(function (i, e) {\n                    var obj = {};\n                    obj[colName] = e[colName];\n                    data.push(obj);\n                });\n                return data;\n            } else {\n                return this.rowDt.data();\n            }\n        };\n        Rows.prototype.destroy = function () {\n            for (var i in this) {\n                this[i] = null;\n            }\n        }\n        // 列数据对象\n        var Column = function (tableDt, col_selector, wingsGrid) {\n            // 属性\n            this.tableDt = tableDt;\n            this.col_selector = col_selector;\n            this.wingsGrid = wingsGrid;\n            this.columnDt = tableDt.column(col_selector);\n            this.isNull = this.columnDt.length <= 0 ? true : false;\n            this.objType = 'column';\n            this.settings = tableDt.settings()[0].aoColumns[this.columnDt.index()];\n            this.name = this.settings.data;\n            this.caption = this.settings.title;\n            return this;\n        }\n        // 获取选列位置\n        Column.prototype.getIndex = function () {\n            return this.columnDt.index();\n        }\n        // 获取列的可见位置\n        Column.prototype.getShowIndex = function () {\n            return this.columnDt.index('visible');\n        }\n        // 获取列原生对象,参数：行号（无参返回存放原生对象数组）\n        Column.prototype.getObj = function (rowNum) {\n            if (rowNum != null) {\n                return this.columnDt.nodes()[rowNum];\n            } else {\n                return this.columnDt.nodes();\n            }\n        }\n        // 获取列jquery对象,参数：行号（无参返回存放jquery对象数组）\n        Column.prototype.get$Obj = function (rowNum) {\n            if (rowNum != null) {\n                return $(this.getObj(rowNum));\n            } else {\n                var $columns = [];\n                var objs = this.getObj();\n                $(objs).each(function (i, e) {\n                    var $obj = $(e);\n                    $columns.push($obj);\n                });\n                return $columns;\n            }\n        }\n        // 获取行对象值，参数：行号（不填返回整列数组）\n        Column.prototype.getValue = function (rowNum) {\n            if (rowNum != null) {\n                return this.columnDt.data()[rowNum];\n            } else {\n                return this.columnDt.data();\n            }\n        }\n        // 获取单元格对象\n        Column.prototype.getElement = function (rowNum) {\n            if (rowNum) {\n                return new Cell(this.tableDt, null, rowNum, this.col_selector, null, this.wingsGrid);\n            } else {\n                var cells = [];\n                var trsize = this.wingsGrid.find(\"tbody>tr[row]\").length;\n                for (var trsizei = 0; trsizei < trsize; trsizei++) {\n                    cells.push(new Cell(this.tableDt, null, trsizei, this.col_selector, null, this.wingsGrid));\n                }\n                return cells;\n            }\n        }\n        Column.prototype.destroy = function () {\n            for (var i in this) {\n                this[i] = null;\n            }\n        }\n        return this;\n        // 添加列\n        // this.addColumn = function(array,index){\n        // var cols = [];\n        // var columns = opts.columns;\n        // $(columns).each(function(i,e){\n        // if(index==i){\n        // cols.push(array);\n        // }\n        // cols.push(e);\n        // });\n        // // table.Columns.Add(title, typeof(string));\n        // }\n        // 绑定事件\n        function bodyBind() {\n            $this.on('click', 'tr', function (e) {\n                if (e.originalEvent.detail == 2) {\n                    return true;\n                }\n                var clickObj = this;\n                trClickFunc(clickObj, e);\n                clickObj = null;\n            });\n            var timer = null;\n            // 给tbody标签中含有wingsOnclick的标签绑定click事件\n            $this.find('tbody').on(\"click\", \"[wingsOnclick]\", function (event) {\n                if (event.originalEvent.detail == 2) {\n                    return true;\n                }\n                if (event.stopPropagation) {\n                    event.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                var clickObj = this;\n                if (event.currentTarget.tagName == \"TD\") {\n                    var row = $(clickObj).closest('tr');\n//          trClickFunc(row,event);\n                    var rowEl = $table.getRowEl(row);\n                    var cellEl = $table.getCellEl($(event.target).closest('tr').index(), $(event.target).closest('td').attr(\"col\"));\n                    var cellData = cellEl.getValue();\n                    var data = rowEl.getValue();\n                    var node = table.row(row).nodes();\n                    var index = table.row(row).index();\n                    var wingsOnClick = wings_getFunc($(clickObj).attr(\n                        'wingsOnclick'));\n                    if (wingsOnClick) {\n                        for (var b = 0; b < wingsOnClick.length; b++) {\n                            var func = eval(wingsOnClick[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data, node[0], index, clickObj,\n                                    cellData, cellEl);\n                            }\n                        }\n                    }\n                } else {\n                    trClickFunc(clickObj, event);\n                    var row = $(clickObj).closest('tr');\n                    var rowEl = $table.getRowEl(row);\n//          var cellEl = $table.getCellEl($(event.target).closest(\"tr\").index(),$(event.target).closest(\"td\").attr(\"col\"));\n//          var cellData = cellEl.getValue();\n                    var data = rowEl.getValue();\n                    var node = table.row(row).nodes();\n                    var index = table.row(row).index();\n                    var wingsOnClick = wings_getFunc($(clickObj).attr('wingsOnclick'));\n                    if (wingsOnClick) {\n                        for (var b = 0; b < wingsOnClick.length; b++) {\n                            var func = eval(wingsOnClick[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data, node[0], index, clickObj);\n                                result = null;\n                            }\n                            func = null;\n                        }\n                    }\n                    wingsOnClick = null;\n                    node = null;\n                    data = null;\n                    cellData = null;\n//        cellEl.destroy();\n//        rowEl.destroy();\n                    row = null;\n                }\n            });\n            $this.find('tbody').on(\"dblclick\", \"[wingsOnDbClick]\", function (event) {\n                var row = $(this).closest('tr');\n                var rowEl = $table.getRowEl(row);\n                var data = rowEl.getValue();\n                var node = table.row(row).nodes();\n                var index = table.row(row).index();\n                var Cell = $table.getCellEl(index, $(event.target).closest('td[wingsgridtype]').attr('col'));\n                var wingsOnDbClick = wings_getFunc($(this).attr('wingsOnDbClick'));\n                if (wingsOnDbClick) {\n                    for (var b = 0; b < wingsOnDbClick.length; b++) {\n                        var func = eval(wingsOnDbClick[b]);\n                        if (typeof func == \"function\") {\n                            var result = new func(data, node[0], index, Cell);\n                            result = null;\n                        }\n                        func = null;\n                    }\n                }\n                wingsOnDbClick = null;\n                node = null;\n                data = null;\n//        rowEl.destroy();\n                row = null;\n                return false;\n            });\n            $this.find('tbody').on(\"mouseover\", \"[wingsmouseover]\", function (event) {\n                if (event.stopPropagation) {\n                    event.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                var row = $(this).closest('tr');\n                var rowEl = $table.getRowEl(row);\n                var data = rowEl.getValue();\n                var node = table.row(row).nodes();\n                var index = table.row(row).index();\n                var wingsOnClick = wings_getFunc($(this).attr('wingsmouseover'));\n                if (wingsOnClick) {\n                    for (var b = 0; b < wingsOnClick.length; b++) {\n                        var func = eval(wingsOnClick[b]);\n                        if (typeof func == \"function\") {\n                            var result = new func(data, node[0], index, this);\n                            result = null;\n                        }\n                        func = null;\n                    }\n                }\n                wingsOnClick = null;\n                node = null;\n                data = null;\n//        rowEl.destroy();\n                row = null;\n                return false;\n            });\n            $this.find('tbody').on(\"mouseout\", \"[wingsmouseout]\", function (event) {\n                if (event.stopPropagation) {\n                    event.stopPropagation();\n                } else if (window.event) {\n                    window.event.cancelBubble = true;\n                }\n                var row = $(this).closest('tr');\n                var rowEl = $table.getRowEl(row);\n                var data = rowEl.getValue();\n                var node = table.row(row).nodes();\n                var index = table.row(row).index();\n                var wingsOnClick = wings_getFunc($(this).attr('wingsmouseout'));\n                if (wingsOnClick) {\n                    for (var b = 0; b < wingsOnClick.length; b++) {\n                        var func = eval(wingsOnClick[b]);\n                        if (typeof func == \"function\") {\n                            var result = new func(data, node[0], index, this);\n                        }\n                    }\n                }\n                wingsOnClick = null;\n                node = null;\n                data = null;\n//        rowEl.destroy();\n                row = null;\n                return false;\n            });\n            $this.find('tbody').on(\n                \"mouseenter\",\n                \"[wingsmouseenter]\",\n                function (event) {\n                    if (event.stopPropagation) {\n                        event.stopPropagation();\n                    } else if (window.event) {\n                        window.event.cancelBubble = true;\n                    }\n                    var row = $(this).closest('tr');\n                    var rowEl = $table.getRowEl(row);\n                    var data = rowEl.getValue();\n                    var node = table.row(row).nodes();\n                    var index = table.row(row).index();\n                    var wingsOnClick = wings_getFunc($(this)\n                        .attr('wingsmouseenter'));\n                    if (wingsOnClick) {\n                        for (var b = 0; b < wingsOnClick.length; b++) {\n                            var func = eval(wingsOnClick[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data, node[0], index, this);\n                            }\n                        }\n                    }\n                    wingsOnClick = null;\n                    node = null;\n                    data = null;\n//                rowEl.destroy();\n                    row = null;\n                    return false;\n                });\n            if (opts.rightMenu != null || opts.onRowRightClick != null\n                || opts.tableCopy) {\n                $this.find('tbody').on(\n                    \"contextmenu\",\n                    \"td\",\n                    function (event) {\n                        if (event.stopPropagation) {\n                            event.stopPropagation();\n                        } else if (window.event) {\n                            window.event.cancelBubble = true;\n                        }\n                        var row = $(this).closest('tr');\n                        var rowEl = $table.getRowEl(row);\n                        var cellEl = $table.getCellEl(row.index(), parseInt($(this)\n                            .attr(\"col\")));\n                        // 内置事件\n                        var rightMenuObj = $table.getRightMenu();\n                        if ($(this).attr(\"rightMenu\") == \"true\") {\n                            rightMenuObj.show({\n                                left: event.clientX - 10,\n                                top: event.clientY - 10\n                            });\n\n                            rightMenuObj.setOnSelectFn(\"rightMenuOnSelect('\"\n                                + opts.name + \"','\" + cellEl.getValue() + \"')\");\n                            // createRightMenu(cellEl,event);\n                        }\n                        if ($(this).attr('wingsonrightclick') != null\n                            && $(this).attr('wingsonrightclick') != \"null\") {\n                            var wingsOnClick = wings_getFunc($(this).attr(\n                                'wingsonrightclick'));\n                            if (wingsOnClick) {\n                                for (var b = 0; b < wingsOnClick.length; b++) {\n                                    var func = eval(wingsOnClick[b]);\n                                    if (typeof func == \"function\") {\n                                        var result = new func(cellEl, rowEl, event);\n                                    }\n                                }\n                            }\n                        }\n                        return false;\n                    });\n                if (opts.tableCopy) {\n                    $this.find('tbody').on(\"copy\", \"td\", function (event) {\n\n                    });\n                }\n            }\n        }\n\n        function headBind(fixedHeadTableId) {\n            var headTable = $this;\n            if (fixedHeadTableId != null) {\n                headTable = $(\"#\" + fixedHeadTableId);\n            }\n            headTable.find(\"th\").attr(\"ondragstart\", \"return false;\");\n//      headTable.ondragstart=function(e){return false;};\n            headTable.on('click', 'th', function (e) {\n                if (!dragFlag) {\n                    dragFlag = true;\n                    return;\n                }\n                var $sort = $(this);\n                if ($sort.find('[sort]').length == 0) {\n                    return;\n                }\n                var sorterOpts = {};\n                var pagingObj = $table.getPagingObj();\n                var gridData = $table.getAllGridData();\n                if (null != pagingObj) {\n                    sorterOpts.pageNum = pagingObj.getPageNum();\n                    sorterOpts.pageSize = pagingObj.getPageSize();\n                    sorterOpts.totalRows = pagingObj.getTotalRows();\n                } else {\n                    sorterOpts.pageNum = 1;\n                    sorterOpts.pageSize = gridData.trs.length;\n                    sorterOpts.totalRows = gridData.trs.length;\n                }\n                var showIndex = 0;\n                $(opts.columns).each(function (i, e1) {\n                    if (e1.wingsType != \"hidden\") {\n                        if (showIndex == $sort.index()) {\n                            sorterOpts.sortFlag = \"true\";\n                            sorterOpts.sortName = e1.name;\n                            return false;\n                        }\n                        showIndex++;\n                    }\n                });\n\n                //复杂表头排序获取列名处理1.0\n                if (opts.fzbtid != null) {\n                    sorterOpts.sortFlag = \"true\";\n                    sorterOpts.sortName = $sort[0].attributes.colname.value;\n                }\n\n                var data = {\n                    \"ctrl\": opts.ptid,\n                    \"pageNum\": 1,\n                    \"rows\": sorterOpts.pageSize,\n                    'totalRows': sorterOpts.totalRows,\n                    'sortFlag': sorterOpts.sortFlag,\n                    'sortName': sorterOpts.sortName,\n                    'sortType': sorterOpts.sortType\n                };\n                if ($sort.find('[sort]').attr('sort') == \"up\") {\n                    //复杂表头排序获取列名处理1.0\n                    var sortParent = opts.fzbtid != null ? $sort.parent().parent() : $sort.parent();\n                    sortParent.find('[sort]').each(function (i, e) {\n                        e.innerHTML = \"\";\n                        $(e).removeClass();\n                        if (opts.wingsOrdering == \"style1\") {\n                            $(e).addClass('wingsGridSort1');\n                        } else {\n                            $(e).addClass('wingsGridSort');\n                        }\n                    });\n                    if (opts.wingsOrdering != \"style1\") {\n                        $sort.find('[sort]').html(\"↓\");\n                    }\n                    $sort.find('[sort]').attr('sort', 'down');\n                    $sort.find('[sort]').removeClass();\n                    if (opts.wingsOrdering == \"style1\") {\n                        $sort.find('[sort]').addClass('wingsGridSort1_down');\n                    }\n                } else if ($sort.find('[sort]').attr('sort') == \"down\") {\n                    //复杂表头排序获取列名处理1.0\n                    var sortParent = opts.fzbtid != null ? $sort.parent().parent() : $sort.parent();\n                    sortParent.find('[sort]').each(function (i, e) {\n                        e.innerHTML = \"\";\n                        $(e).removeClass();\n                        if (opts.wingsOrdering == \"style1\") {\n                            $(e).addClass('wingsGridSort1');\n                        } else {\n                            $(e).addClass('wingsGridSort');\n                        }\n                    });\n                    if (opts.wingsOrdering != \"style1\") {\n                        $sort.find('[sort]').html(\"↑\");\n                    }\n                    $sort.find('[sort]').attr('sort', 'up');\n                    $sort.find('[sort]').removeClass();\n                    if (opts.wingsOrdering == \"style1\") {\n                        $sort.find('[sort]').addClass('wingsGridSort1_up');\n                    }\n                }\n                var sortType = $sort.find('[sort]').attr('sort');\n                var sortTypeOpts = {\n                    \"sortType\": sortType,\n                    \"sortName\": sorterOpts.sortName,\n                    \"sortFlag\": sorterOpts.sortFlag\n                };\n                $table.addAjaxParam(sortTypeOpts);\n                var param = $table.getAjaxParam();\n                for (var i in param) {\n                    data[i] = param[i];\n                }\n                if (opts.mask) {\n                    $table.setMask(true);\n                }\n                if (opts.onSortBefore) {\n                    var onSortBefore = wings_getFunc(opts.onSortBefore);\n                    if (onSortBefore) {\n                        for (var b = 0; b < onSortBefore.length; b++) {\n                            var func = eval(onSortBefore[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data);\n                                result = null;\n                            }\n                            func = null;\n                        }\n                    }\n                    onSortBefore = null;\n                }\n                if (opts.ptid) {\n                    var postData = JSON.stringify(data);\n                    $.ajax({\n                        url: AddBizCode2URL(opts.ptid),\n                        method: \"POST\",\n                        async: true,\n                        data: {\n                            \"postData\": postData\n                        },\n                        dataType: 'json',\n                        wingsSubmitAjax: true,\n                        success: function (data) {\n                            var columns = data.data.filter(function (item, i, array) {\n                                if (item.name == $table.getOptions().name) {\n                                    return true;\n                                }\n                            });\n                            if (columns.length <= 0) {\n                                alert(\"排序方法返回的table数据key应为：\" + $table.getOptions().name);\n                            } else {\n                                opts.pageLength = columns[0].rows;\n                                $table.initData(columns[0]);\n                            }\n                            columns = null;\n                            if (opts.mask) {\n                                $table.setMask(false);\n                            }\n                            if (opts.onSortAfter) {\n                                var onSortAfter = wings_getFunc(opts.onSortAfter);\n                                if (onSortAfter) {\n                                    for (var b = 0; b < onSortAfter.length; b++) {\n                                        var func = eval(onSortAfter[b]);\n                                        if (typeof func == \"function\") {\n                                            var result = new func();\n                                            result = null;\n                                        }\n                                        func = null;\n                                    }\n                                }\n                                onSortAfter = null;\n                            }\n                        },\n                        error: function (e, info) {\n                            alert(info);\n                        }\n                    });\n                } else {\n                    var wcldata = $table.getAllGridData();\n                    qtSort(wcldata, data);\n                    $table.initData(wcldata);\n                }\n                pagingObj = null;\n                gridData = null;\n                sorterOpts = null;\n                data = null;\n                sortTypeOpts = null;\n                param = null;\n            });\n//      headTable.find('input[wingsallcheckonclick]').on('click', function(e) {\n//        if (event.stopPropagation) {\n//          event.stopPropagation();\n//        } else if (window.event) {\n//          window.event.cancelBubble = true;\n//        }\n//      });\n//      headTable = null;\n        }\n    };\n    // 默认设置\n    $.fn.wingsDataTables.defaults = {\n        // pageLength:10,//默认每页条数\n        lengthMenu: [[5, 10, 25, 30, 50], [5, 10, 25, 30, 50]],// 默认表格支持的每页条数列表\n        pagingType: 'simple_numbers',\n        pageSizeInfo: true,\n        pageInfo: false,\n        runTo: false,\n        paging: false,// 默认分页\n        processing: true,// 加载loading\n        serverSide: false,// 默认服务端模式\n        searching: false,\n        info: false,// 左下角当前页号及总页数信息\n        ordering: false,\n        lineColumnTitle: '序号',\n        lineNumber: false,// 显示序号开关\n        rowSelect: 'noselect',\n        selectColor: false,// 选中变色\n        // selectColumn:false,\n        autoWidth: false,// 自动表头列宽\n        scrollX: false,\n        // scrollCollapse:true,//表格高度随数据多少变化\n        scrollX1: \"100%\",\n        dom: '<<t><\"row\"i<\"rowright\"pl>>>',\n        hideMenu: false,// 隐藏列\n        hideMenu_exclude: [0],// 隐藏列时不包含的列\n        hideMenu_unhide: [1],// 隐藏列时不隐藏的列\n        isAjax: false,\n        border: false,// 边框\n        // contentLen:20,\n        striped: true,\n        defaultAlignment: 'left', // 对齐方式 middle,right\n        showHeader: true,// 显示表头\n        nowrap: true,// 数据不换行\n        checkColor: false,\n        // itemX:'200px',\n        fenye: false,\n        lazy: false,\n        ajaxParam: {},\n        // dataX:'100%',\n        // dataY:'300px',\n        // fixedHead:true,\n        // fzbtid:'fzbtid',\n        fixedColWidth: false,// 固定列宽\n        wordBreak: false,\n        debug: false,\n        pageFontSize: '11px',\n        togglecell: true,\n        showConsole: true,\n        // 国际化\n        language: {\n            \"sLoadingRecords\": \"数据加载中...\",\n            \"processing\": \"数据加载中...\",\n            \"sInfo\": \"显示第 _START_ 到 _END_ 条结果，共 _TOTAL_ 条\",\n            \"lengthMenu\": \"每页显示 _MENU_ 条记录\",\n            \"zeroRecords\": \"没有查询到数据\",\n            \"info\": \"当前第 _PAGE_ 页，总共 _PAGES_ 页\",\n            \"infoEmpty\": \"\",\n            \"infoFiltered\": \"(在全部的 _MAX_ 条记录当中)\",\n            \"sSearch\": \"查询:\",\n            \"sEmptyTable\": \"undefined\" != typeof $wings_gird_noDataShow ? $wings_gird_noDataShow : \"没有数据\",\n            \"paginate\": {\n                \"sFirst\": \"首页\",\n                \"sLast\": \"尾页\",\n                \"sPrevious\": \"上一页\",\n                \"sNext\": \"下一页\"\n            }\n        }\n    };\n    // 对Date的扩展，将 Date 转化为指定格式的String\n    // 月(M)、日(d)、小时(h)、分(m)、秒(s)、季度(q) 可以用 1-2 个占位符，\n    // 年(y)可以用 1-4 个占位符，毫秒(S)只能用 1 个占位符(是 1-3 位的数字)\n    // 例子：\n    // (new Date()).Format(\"yyyy-MM-dd hh:mm:ss.S\") ==> 2006-07-02 08:09:04.423\n    // (new Date()).Format(\"yyyy-M-d h:m:s.S\") ==> 2006-7-2 8:9:4.18\n    Date.prototype.Format = function (fmt) { // author: meizz\n        var o = {\n            \"m+\": this.getMonth() + 1, // 月份\n            \"d+\": this.getDate(), // 日\n            \"h+\": this.getHours(), // 小时\n            \"i+\": this.getMinutes(), // 分\n            \"s+\": this.getSeconds(), // 秒\n            \"q+\": Math.floor((this.getMonth() + 3) / 3), // 季度\n            \"S\": this.getMilliseconds()\n            // 毫秒\n        };\n        if (/(y+)/.test(fmt)) {\n            fmt = fmt.replace(RegExp.$1, (this.getFullYear() + \"\")\n                .substr(4 - RegExp.$1.length));\n        }\n        for (var k in o) {\n            if (new RegExp(\"(\" + k + \")\").test(fmt)) {\n                fmt = fmt.replace(RegExp.$1, (RegExp.$1.length == 1) ? (o[k])\n                    : ((\"00\" + o[k]).substr((\"\" + o[k]).length)));\n            }\n        }\n        return fmt;\n    }\n\n    function createColumns(options, table) {\n        if (options == null) {\n            return false;\n        }\n        // 序号\n        if (options.lineNumber) {\n            options.columns.unshift({\n                caption: options.lineColumnTitle,\n                x: '40px',\n                name: \"lineNumber\",\n                data: \"lineNumber\",\n                orderable: false,\n                searchable: false,\n                render: function (data, display, cell, rowset) {\n                    var pageIndex = 0;\n                    if (table.getPagingObj() != null) {\n                        pageIndex = (table.getPagingObj().getPageNum() - 1)\n                            * table.getPagingObj().getPageSize();\n                    }\n                    return pageIndex + rowset.row + 1;\n                }\n            });\n        }\n        // checkbox\n        if (options.rowSelect != \"noselect\") {\n            options.columns\n                .unshift({\n                    caption: \"<input type='checkbox' name='checklist' class='dataTableCheckAll' />\",\n                    x: '40px',\n                    name: \"rowSelect\",\n                    data: \"rowSelect\",\n                    orderable: false,\n                    searchable: false,\n                    render: function (data, display, cell, rowset) {\n                        return \"<input type='checkbox' class='rowSelect' name='check' id='dataTableCheck_\"\n                            + rowset.row + \"' />\";\n                    }\n                });\n            // 单选没有全选框\n            if (options.rowSelect != 'multiple') {\n                options.columns[0].caption = '单选';\n            }\n        }\n        var cols = [];\n        var selectIds = [];\n        var consoles = [];\n        for (var i = 0; i < options.columns.length; i++) {\n            var column = options.columns[i];\n            if (column.console != null) {\n                var wingsConsole = {};\n                wingsConsole.wingsType = column.console;\n                wingsConsole.caption = column.caption;\n                wingsConsole.check = column.check;\n                if (column.console == \"insert\") {\n                    wingsConsole.where = column.where;\n                } else if (column.console == \"delete\") {\n                    // if(column.popMes!=null){\n                    // wingsConsole.popMes = column.popMes;\n                    // }\n                    wingsConsole.delConfirm = column.delConfirm;\n                } else if (column.console == 'button') {\n                    wingsConsole.onclick = column.onclick;\n                }\n                consoles.push(wingsConsole);\n                wingsConsole = null;\n                continue;\n            }\n            if (column.type == \"rightMenu\") {\n                options.rightMenu = column.rightMenuOption;\n                continue;\n            }\n            var col = {};\n            col.name = column.name;\n            col.title = column.caption;\n            col.caption = column.caption;\n            col.wingsType = column.type;\n            col.disable = column.disable;\n            col.data = column.name == \"null\" ? null : column.name;\n            col.hjLabel = column.hjLabel;\n\n            //lei\n            col.s_type = column.s_type;\n            if (column.contentLen != null) {\n                col.contentLen = column.contentLen;\n            }\n            // 全局对齐方式\n            if (options.defaultAlignment == 'left') {\n                col.className = 'wingsDtTdLeft'\n            } else if (options.defaultAlignment == 'middle') {\n                col.className = 'wingsDtTdMiddle'\n            } else if (options.defaultAlignment == 'right') {\n                col.className = 'wingsDtTdRight'\n            }\n            if (column.contentType == \"number\") {\n                col.className = 'wingsDtTdRight';\n            }\n            // 对齐方式\n            if (column.format != null && column.format.indexOf(\"number\") > 0) {\n                col.className = 'wingsDtTdRight';\n            }\n            if (column.alignment == 'left') {\n                col.className = 'wingsDtTdLeft'\n            } else if (column.alignment == 'middle') {\n                col.className = 'wingsDtTdMiddle'\n            } else if (column.alignment == 'right') {\n                col.className = 'wingsDtTdRight'\n            }\n            if (options.wordBreak != null && options.wordBreak) {\n                options.nowrap = false;\n            } else if (options.wordBreak != null && !options.wordBreak) {\n                options.nowrap = true;\n            }\n            if (options.nowrap) {\n                if (col.className != null) {\n                    col.className += ' nowrap';\n                } else {\n                    col.className = 'nowrap';\n                }\n            }\n            if (column.defaultValue != null) {\n                col.defaultValue = column.defaultValue;\n            }\n            if (column.notitle != null) {\n                col.notitle = column.notitle;\n            }\n            if (column.wingsValue != null) {\n                col.wingsValue = column.wingsValue;\n            }\n            if (options.itemX != null) {\n                col.width = options.itemX;\n            }\n            if (column.x != null) {\n                col.width = column.x;\n            }\n            if (column.format != null) {\n                col.format = column.format;\n            }\n            if (column.isShowCaption != null) {\n                col.isShowCaption = column.isShowCaption;\n            }\n            if (column.onBeforeCreateCell != null) {\n                col.onBeforeCreateCell = column.onBeforeCreateCell;\n                col.render = function (data, display, row, rowset) {\n                    var renderObj = {};\n                    renderObj.data = data;\n                    renderObj.row = row;\n                    renderObj.rowset = rowset;\n                    if (options.columns[rowset.col].onBeforeCreateCell != null) {\n                        var tempFn = wings_getFunc(options.columns[rowset.col].onBeforeCreateCell);\n                        for (var b = 0; b < tempFn.length; b++) {\n                            var func = eval(tempFn[b]);\n                            if (typeof func == \"function\") {\n                                var result = new func(data, row, rowset);\n                                result = null;\n                            }\n                            func = null;\n                        }\n                        tempFn = null;\n                    }\n                    return renderObj.data;\n                }\n            }\n            if (column.type == \"hidden\") {\n                col.wingsType = \"hidden\";\n                col.visible = false;\n            } else if (column.type == \"a\") {\n                col.render = function (data, display, row, rowset) {\n                    if (column.onBeforeCreateCell != null) {\n                        if (options.columns[rowset.col].onBeforeCreateCell != null) {\n                            var tempFn = wings_getFunc(options.columns[rowset.col].onBeforeCreateCell);\n                            for (var b = 0; b < tempFn.length; b++) {\n                                var func = eval(tempFn[b]);\n                                if (typeof func == \"function\") {\n                                    var result = new func(data, row, rowset);\n                                    result = null;\n                                }\n                                func = null;\n                            }\n                            tempFn = null\n                        }\n                    }\n                    var title = '';\n                    if (options.columns[rowset.col].data != null) {\n                        if (data == null || data == '') {\n                            if (options.columns[rowset.col].isShowCaption == \"true\") {\n                                title = options.columns[rowset.col].title;\n                            } else if (options.columns[rowset.col].value) {\n                                title = value;\n                            } else {\n                                title = '';\n                            }\n                        } else {\n                            title = data;\n                        }\n                    }\n                    // if(options.columns[rowset.col].isShowCaption==\"true\"){\n                    // title = options.columns[rowset.col].title;\n                    // }else\n                    // if(options.columns[rowset.col].isShowCaption==\"false\"){\n                    // title = \"\";\n                    // }\n                    var a = \"<a class='wingsDTA' row='\" + rowset.row + \"' col='\"\n                        + rowset.col + \"'>\" + title + \"</a>\";\n                    if (options.columns[rowset.col].childonclick != null) {\n                        a = \"<a class='wingsDTA' row='\" + rowset.row + \"' col='\"\n                            + rowset.col + \"'wingsOnclick='\"\n                            + options.columns[rowset.col].childonclick + \"' >\" + title\n                            + \"</a>\";\n                    }\n                    if (options.columns[rowset.col].disable == \"true\") {\n                        a = title;\n                    }\n                    return a;\n                }\n            } else if (column.type == \"wingsDate\") {\n                col.render = function (data, display, row, rowset) {\n                    if (column.onBeforeCreateCell != null) {\n                        if (options.columns[rowset.col].onBeforeCreateCell != null) {\n                            var tempFn = wings_getFunc(options.columns[rowset.col].onBeforeCreateCell);\n                            for (var b = 0; b < tempFn.length; b++) {\n                                var func = eval(tempFn[b]);\n                                if (typeof func == \"function\") {\n                                    var result = new func(data, row, rowset);\n                                }\n                            }\n                        }\n                    }\n                    var date = '';\n                    if (data != null && data != '' && data != 'null') {\n                        if (data.indexOf('.') > -1) {\n                            data = data.substring(0, data.indexOf('.'));\n                        }\n                        date = replaceAll(data, '-', '/');\n                        date = new Date(date);// ie8不兼容\n                        var showDate = null;\n                        if (options.columns[rowset.col].format != null) {\n                            showDate = date.Format(options.columns[rowset.col].format);\n                        } else {\n                            showDate = date.Format(\"yyyy-mm-dd\");\n                        }\n                    } else {\n                        showDate = '';\n                    }\n                    return showDate;\n                }\n            } else if (column.type == \"select\") {\n                col.selectOption = column.selectOption;\n            } else if (column.type == \"pulltree\") {\n                col.treeOption = column.treeOption;\n            } else if (column.type == \"text\") {\n                col.wingsType = \"text\"\n            } else if (column.type == \"password\") {\n                col.wingsType = \"password\"\n            } else if (column.type == \"userdefine\" && column.html != \"\") {\n                col.html = column.html;\n                col.render = function (data, display, cell, rowset) {\n                    if (column.onBeforeCreateCell != null) {\n                        if (options.columns[rowset.col].onBeforeCreateCell != null) {\n                            var tempFn = wings_getFunc(options.columns[rowset.col].onBeforeCreateCell);\n                            for (var b = 0; b < tempFn.length; b++) {\n                                var func = eval(tempFn[b]);\n                                if (typeof func == \"function\") {\n                                    var result = new func(data, row, rowset);\n                                }\n                            }\n                        }\n                    }\n                    var html = options.columns[rowset.col].html;\n                    html = replaceAll(html, \"#WingsDtColdata#\", data);\n                    return html;\n                }\n            } else if (column.type == \"rowNum\") {\n                col.render = function (data, display, cell, rowset) {\n                    var pageIndex = 0;\n                    if (table.getPagingObj() != null) {\n                        pageIndex = (table.getPagingObj().getPageNum() - 1)\n                            * table.getPagingObj().getPageSize();\n                    }\n                    return pageIndex + rowset.row + 1;\n                }\n            } else if (column.type == \"checkbox\") {\n                options.rowSelect = \"multiple\";\n                col.render = function (data, display, cell, rowset) {\n                    var name = \"checkbox\";\n                    if (options.columns[rowset.col].name != null) {\n                        name = options.columns[rowset.col].name;\n                    }\n                    var ckInput = \"<input type='checkbox' class='wingscheckbox' name='\"\n                        + name + \"' id='dataTableCheck_\" + rowset.row + \"' />\";\n                    if (options.columns[rowset.col].onclick != null) {\n                        ckInput = \"<input type='checkbox' class='wingscheckbox' name='\"\n                            + name + \"' id='dataTableCheck_\" + rowset.row\n                            + \"' wingsCheckBoxClick='\"\n                            + options.columns[rowset.col].onclick + \"' />\"\n                    }\n                    var $ckInput = $(ckInput);\n                    if (data == \"1\") {\n                        $ckInput.attr(\"checked\", \"checked\");\n                        if (options.selectColor) {\n                            $ckInput.closest('tr').addClass('selected');\n                        }\n                    }\n                    return $ckInput.prop(\"outerHTML\");\n                }\n                if (column.allChk != 'false') {\n                    col.title = \"<input type='checkbox' name='checklist' class='dataTableCheckAll' />\";\n                    if (column.allCheckOnclick != null) {\n                        col.title = \"<input type='checkbox' name='checklist' class='dataTableCheckAll' wingsAllCheckOnclick='\"\n                            + column.allCheckOnclick + \"' />\";\n                    }\n                } else {\n                    col.title = column.caption;\n                }\n            } else if (column.type == \"radio\") {\n                options.rowSelect = \"radio\";\n                col.render = function (data, display, cell, rowset) {\n                    var name = \"radio\";\n                    if (options.columns[rowset.col].name != null) {\n                        name = options.columns[rowset.col].name;\n                    }\n                    var ckInput = \"<input type='checkbox' class='wingsradio' name='\"\n                        + name + \"' id='dataTableCheck_\" + rowset.row + \"' />\";\n                    if (options.columns[rowset.col].onclick != null) {\n                        ckInput = \"<input type='checkbox' class='wingsradio' name='\" + name\n                            + \"' id='dataTableCheck_\" + rowset.row\n    