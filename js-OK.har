            "text": "/**\n * 判断判空是否为空,true 为空，false不为空\n * @param value value\n * @returns {Boolean}\n */\nfunction checkValIsNull(value) {\n    if (typeof (value) == undefined || value == \"undefined\" || value == undefined) {\n        return true;\n    }\n    if (value == null || value == \"\" || value == \"null\") {\n        return true;\n    }\n    if (value == {} || value == [] || value == \"{}\" || value == \"[]\" || value == \"[{}]\") {\n        return true;\n    }\n    return false;\n}\n\n/**\n * 获取亿位数\n * @param yNum\n * @returns {Number}\n */\nfunction getIntYi(yNum) {\n    var yi = 0;\n    var len = getNumLenNoDecimal(yNum);\n    if (len == 9 && yNum < 0) {\n        return 0;\n    }\n    if (len > 8) {\n        yi = getNumStr(yNum).substring(0, len - 8);\n    }\n    return yi;\n}\n\n/**\n * 获取万位数\n * @param wNum\n * @returns\n */\nfunction getIntWan(wNum) {\n    var wan = 0;\n    var len = getNumLenNoDecimal(wNum);\n    if (len == 9 && wNum < 0) {\n        wan = numjqz(getNumStr(wNum).substring(len - 9, len - 4));\n        return wan;\n    }\n    if (len > 4) {\n        wan = numjqz(getNumStr(wNum).substring(len - 8, len - 4));\n    }\n    return wan;\n}\n\n/**\n * 获取千位数\n * @param tNum\n * @returns\n */\nfunction getIntThousand(tNum) {\n    var qi = 0;\n    var len = getNumLenNoDecimal(tNum);\n    if (len > 0) {\n        qi = numjqz(getNumStr(tNum).substring(len - 4, len));\n    }\n    return qi;\n}\n\n/**\n * 获取整型数字长度（去除小数点后的长度）\n * @param num\n * @returns {Number}\n */\nfunction getNumLenNoDecimal(num) {\n    var numStr = getNumStr(num);\n    var intLen = 0;\n    if (\"-1\" == numStr.indexOf(\".\")) {\n        intLen = numStr.length;\n    } else {\n        intLen = numStr.lastIndexOf(\".\");\n    }\n    return intLen;\n\n}\n\n/**\n * 获取一个数字字符串\n * @param num\n * @returns {String}\n */\nfunction getNumStr(num) {\n    return num + \"\";\n}\n\n\n/**\n * 数字去零\n * @param num\n * @returns {String}\n */\nfunction numjqz(num) {\n    var str = num;\n    var j = 0;\n    if (str.substring(0, 1) == \"0\") {\n        for (var i = 1; i < str.length; i++) {\n            var n = str.substring(i, i + 1);\n            if (n != \"0\") {\n                j = i;\n                break;\n            }\n        }\n        if (j < str.length) {\n            str = str.substring(j, str.length);\n        } else {\n            str = \"\";\n        }\n    }\n    if (str.substring(0, 1) == \".\") {\n        str = \"0\" + str;\n    }\n    return str;\n}\n\n/**\n * 返回一个保留n位的亿数\n * @param num\n * @param fixNum\n * @returns\n */\nfunction num2YiFiexd(num, fixNum) {\n    var newNum = Number(num);\n    return (newNum / 100000000).toFixed(fixNum);\n};\n\n\n/**\n * 返回一个万数\n * @param num\n * @returns\n */\nfunction num2WanFixed(num, num2) {\n    if (checkValIsNull(num) || num == 0 || num == \"0\") {\n        return 0;\n    }\n    var newNum = Number(num);\n    return (newNum / 10000).toFixed(num2);\n};\n\n/**\n * 返回一个万数\n * @param num\n * @returns\n */\nfunction num2Wan(num) {\n    if (checkValIsNull(num)) {\n        return 0;\n    }\n    var newNum = Number(num);\n    return (newNum / 10000).toFixed(2);\n};\n\n\n/**\n * 数组转万元\n * @param numArr\n * @returns {Array}\n */\nfunction arrayToWan(numArr) {\n    var wanArr = [];\n    for (var i = 0; i < numArr.length; i++) {\n        var num = numArr[i];\n        wanArr.push(num2Wan(num));\n    }\n    return wanArr;\n}\n\n/**\n * 数组转亿元\n * @param numArr\n * @returns {Array}\n */\nfunction arrayToYi(numArr) {\n    var wanArr = [];\n    for (var i = 0; i < numArr.length; i++) {\n        var num = numArr[i];\n        wanArr.push(num2Yi(num));\n    }\n    return wanArr;\n}\n\n/**\n * 返回一个亿数\n * @param num\n * @returns\n */\nfunction num2Yi(num) {\n    var newNum = Number(num);\n    return (newNum / 100000000).toFixed(2);\n\n};\n\n/**\n * 按千分位格式化数字\n * @param number\n * @param options\n * @return {string}\n */\nfunction formatNumberWithQFW(number, options) {\n    options = $.extend({\n        split_length: SPLIT_CONSTANTS.QFW.SPLIT_LENGTH\n    }, options);\n    return formatNumber(number, options);\n}\n\nfunction formatNumberWithQFWFloat(number) {\n    var value = formatNumberWithQFW(number, {contain_decimal: true});\n    return value;\n}\n\n/**\n * 拆分数字常量定义\n * @type {{QFW: {ZH_UNIT: string[], SPLIT_LENGTH: number}, DEFAULT_RESERVE_PRECISION: number, WFW: {ZH_UNIT: string[], SPLIT_LENGTH: number}}}\n */\nvar SPLIT_CONSTANTS = {\n    /**\n     * 千分位\n     * @property SPLIT_LENGTH 拆分长度：3\n     * @property ZH_UNIT 中文单位\n     */\n    QFW: {SPLIT_LENGTH: 3, ZH_UNIT: [\"元\"]},\n    /**\n     * 万分位\n     * @property SPLIT_LENGTH 拆分长度：4\n     * @property ZH_UNIT 中文单位\n     */\n    WFW: {SPLIT_LENGTH: 4, ZH_UNIT: [\"元\", \"万\", \"亿\", \"万亿\"]},\n    /**\n     * 默认小数保留精度\n     */\n    DEFAULT_RESERVE_PRECISION: 2\n};\n\n/**\n * 检查number是否是数值或可转换为数值\n * @param number\n */\nfunction checkNumeric(number) {\n    if (!number || isNaN(number)) {\n        return number;\n    }\n}\n\n/**\n * 拆分数值，以字符串形式保留原值，不清除最高位“0”\n * @param number 数值\n * @param dimension 整数部分拆分维度：3-千分位（默认）；4-万分位\n * @param precision 小数部分保留精度：2（默认）\n * @return {Object} {negative: true|false, integer_part: [由低位至高位存放], decimal_part: \"按精度格式化后的小数串\"}\n * @example\n *  splitNumber(-10100092.38) -> {negative: true, integer_part: [\"092\", \"100\", \"10\"], decimal_part: \"38\"}\n *  splitNumber(3000000027.279, 3, 2) -> {negative: false, integer_part: [\"027\", \"000\", \"000\", \"3\"], decimal_part: \"28\"}\n */\nfunction splitNumber(number, dimension, precision) {\n    checkNumeric(number);\n    dimension = dimension || SPLIT_CONSTANTS.QFW.SPLIT_LENGTH;\n    precision = precision || SPLIT_CONSTANTS.DEFAULT_RESERVE_PRECISION;\n    var splitted = {negative: Number(number) < 0};\n    splitted.integer_part = splitIntegerPart(number, dimension);\n    splitted.decimal_part = splitDecimalPart(number, precision);\n    return splitted;\n}\n\n/**\n * 拆分整数部分\n * @param number 数值\n * @param dimension 拆分维度：3-千分位（默认）；4-万分位\n * @return {Array} 由低位至高位存放\n */\nfunction splitIntegerPart(number, dimension) {\n    checkNumeric(number);\n    var splitted = [];\n    dimension = dimension || SPLIT_CONSTANTS.QFW.SPLIT_LENGTH;\n    var src = Math.floor(Math.abs(Number(number))) + \"\";\n    while (src.length >= dimension) {\n        var tmp = src.substr(-dimension);\n        splitted.push(tmp);\n        src = src.substr(0, src.length - dimension);\n    }\n    if (src.length > 0) {\n        splitted.push(src);\n    }\n    return splitted;\n}\n\n/**\n * 拆分小数部分\n * @param number 数值\n * @param precision 保留精度：2（默认）\n * @return {string}\n */\nfunction splitDecimalPart(number, precision) {\n    checkNumeric(number);\n    precision = precision || SPLIT_CONSTANTS.DEFAULT_RESERVE_PRECISION;\n    var src = Number(number).toFixed(precision);\n    return src.substr(-precision);\n}\n\n\n/**\n * 格式化数字\n * @param number\n * @param options\n * @return {string}\n */\nfunction formatNumber(number, options) {\n    this.default_options = {\n        split_length: SPLIT_CONSTANTS.QFW.SPLIT_LENGTH,\n        separator: \",\",\n        negative_symbol: \"-\",\n        contain_decimal: false,\n        use_unit: false\n    };\n\n    options = $.extend(this.default_options, options || {});\n    if (options.split_length !== SPLIT_CONSTANTS.QFW.SPLIT_LENGTH && options.split_length !== SPLIT_CONSTANTS.WFW.SPLIT_LENGTH) {\n        throw new Error(\"金额类数字必须按照3位或4位进行拆分显示！\");\n    }\n\n    var splitted = splitNumber(number, options.split_length);\n\n    var format = splitted.integer_part.reverse().join(options.separator);\n    if (options.use_unit) {\n        switch (options.split_length) {\n            case SPLIT_CONSTANTS.QFW.SPLIT_LENGTH: {\n                format += SPLIT_CONSTANTS.QFW.ZH_UNIT[0];\n                break;\n            }\n            case SPLIT_CONSTANTS.WFW.SPLIT_LENGTH: {\n                format = \"\";\n                for (var i = splitted.integer_part.reverse().length - 1; i >= 0; i--) {\n                    format += Number(splitted.integer_part[i]) + (SPLIT_CONSTANTS.WFW.ZH_UNIT[i] || \"\");\n                }\n            }\n        }\n    }\n    if (options.contain_decimal) {\n        format += \".\" + splitted.decimal_part;\n    }\n    if (splitted.negative) {\n        format = options.negative_symbol + format;\n    }\n\n    return format;\n}\n\n\n/**\n * 计算占比\n * @param num\n * @param total\n * @returns {String}\n */\nfunction toPercent(num, total) {\n    if (total == 0 || total == \"0\") {\n        return \"0%\";\n    }\n    return Math.round(Number(num) / Number(total) * 10000) / 100.00 + \"%\";// 小数点后两位百分比\n\n}\n\n/**\n * 计算占比total为0时，显示100%\n * @param num\n * @param total\n * @returns {String}\n */\nfunction toPercent2(num, total) {\n    if (num == 0 || num == \"0\") {\n        return \"0%\";\n    }\n    if (total == 0 || total == \"0\") {\n        return \"100%\";\n    }\n    return Math.round(Number(num) / Number(total) * 10000) / 100.00 + \"%\";// 小数点后两位百分比\n}\n\n/**\n * 计算占比total为0时，显示100\n * @param num\n * @param total\n * @returns {String}\n */\nfunction toPercent3(num, total) {\n    if (num == 0 || num == \"0\") {\n        return 0;\n    }\n\n    if (total == 0 || total == \"0\") {\n        return 100;\n    }\n    return Math.round(Number(num) / Number(total) * 10000) / 100.00;// 小数点后两位百分比\n\n}\n\n/**\n * obj转百分比（四舍五入）\n * @param obj\n * @param precision 精度（保留几位小数，默认为2）\n * @returns {*}\n */\nfunction obj2percent(obj, precision) {\n    if (obj) {\n        try {\n            if (isNaN(obj)) {\n                return \"-\";\n            }\n            var num = Number(obj);\n            if (checkValIsNull(precision)) {\n                precision = 2;\n            }\n            var temp = (num * 100).toFixed(precision);\n            return temp + \"%\";\n        } catch (e) {\n            return \"-\";\n        }\n    } else {\n        return \"-\";\n    }\n}\n\n\n/**\n * 除法\n * @param divided 除数\n * @param dividend 被除数\n */\nfunction divide(divided, dividend) {\n    if (divided == 0 || divided == \"0\") {\n        return 0;\n    }\n    if (dividend == 0 || dividend == \"0\") {\n        return \"-\";\n    }\n    return Number(divided) / Number(dividend);\n}\n\n/**\n * 返回一个保留n位的万数\n * @param num\n * @param fixNum\n * @returns\n */\nfunction num2WanFiexd(num, fixNum) {\n    if (checkValIsNull(num) || num == 0 || num == \"0\") {\n        return 0;\n    }\n    var newNum = Number(num);\n    return (newNum / 10000).toFixed(fixNum);\n};\n\n/**\n * 返回整数\n * @param num\n * @param fixNum\n * @returns\n */\nfunction num2Int(num) {\n    if (checkValIsNull(num) || num == 0 || num == \"0\") {\n        return 0;\n    }\n    var newNum = Number(num);\n    return parseInt(newNum);\n};\n\n//阿拉伯数字转中文数字\nfunction NoToChinese(num) {\n    if (!/^\\d*(\\.\\d*)?$/.test(num)) {\n        alert(\"Number is wrong!\");\n        return \"Number is wrong!\";\n    }\n    var AA = new Array(\"零\", \"一\", \"二\", \"三\", \"四\", \"五\", \"六\", \"七\", \"八\", \"九\");\n    var BB = new Array(\"\", \"十\", \"百\", \"千\", \"万\", \"亿\", \"点\", \"\");\n    var a = (\"\" + num).replace(/(^0*)/g, \"\").split(\".\"),\n        k = 0,\n        re = \"\";\n    for (var i = a[0].length - 1; i >= 0; i--) {\n        switch (k) {\n            case 0:\n                re = BB[7] + re;\n                break;\n            case 4:\n                if (!new RegExp(\"0{4}\\\\d{\" + (a[0].length - i - 1) + \"}$\").test(a[0]))\n                    re = BB[4] + re;\n                break;\n            case 8:\n                re = BB[5] + re;\n                BB[7] = BB[5];\n                k = 0;\n                break;\n        }\n        if (k % 4 == 2 && a[0].charAt(i + 2) != 0 && a[0].charAt(i + 1) == 0) re = AA[0] + re;\n        if (a[0].charAt(i) != 0) re = AA[a[0].charAt(i)] + BB[k % 4] + re;\n        k++;\n    }\n    if (a.length > 1) //加上小数部分(如果有小数部分)\n    {\n        re += BB[6];\n        for (var i = 0; i < a[1].length; i++) re += AA[a[1].charAt(i)];\n    }\n    return re;\n};\n\n\n/*人民币大写中文金额*/\nfunction NumToChineseDX(currencyDigits) {\n// Constants:\n    currencyDigits = ($type(currencyDigits) == \"string\") ? currencyDigits / 1 : currencyDigits;\n    var MAXIMUM_NUMBER = 99999999999.99;\n// Predefine the radix characters and currency symbols for output:\n    var CN_ZERO = \"零\";\n    var CN_ONE = \"壹\";\n    var CN_TWO = \"贰\";\n    var CN_THREE = \"叁\";\n    var CN_FOUR = \"肆\";\n    var CN_FIVE = \"伍\";\n    var CN_SIX = \"陆\";\n    var CN_SEVEN = \"柒\";\n    var CN_EIGHT = \"捌\";\n    var CN_NINE = \"玖\";\n    var CN_TEN = \"拾\";\n    var CN_HUNDRED = \"佰\";\n    var CN_THOUSAND = \"仟\";\n    var CN_TEN_THOUSAND = \"万\";\n    var CN_HUNDRED_MILLION = \"亿\";\n    var CN_SYMBOL = \"\";\n    var CN_DOLLAR = \"元\";\n    var CN_TEN_CENT = \"角\";\n    var CN_CENT = \"分\";\n    var CN_INTEGER = \"整\";\n\n// Variables:\n    var integral; // Represent integral part of digit number.\n    var decimal; // Represent decimal part of digit number.\n    var outputCharacters; // The output result.\n    var parts;\n    var digits, radices, bigRadices, decimals;\n    var zeroCount;\n    var i, p, d;\n    var quotient, modulus;\n\n// Validate input string:\n    currencyDigits = currencyDigits.toString();\n    if (currencyDigits == \"\") {\n//  alert(\"输入为空\");\n        return currencyDigits;\n    }\n    if (currencyDigits.match(/[^,.\\d]/) != null) {\n        alert(\"输入字符中有不合法字符，请输入数字。\");\n        return currencyDigits;\n    }\n    if ((currencyDigits).match(/^((\\d{1,3}(,\\d{3})*(.((\\d{3},)*\\d{1,3}))?)|(\\d+(.\\d+)?))$/) == null) {\n        alert(\"输入的格式不合法。\");\n        return currencyDigits;\n    }\n\n// Normalize the format of input digits:\n    currencyDigits = currencyDigits.replace(/,/g, \"\"); // Remove comma delimiters.\n    currencyDigits = currencyDigits.replace(/^0+/, \"\"); // Trim zeros at the beginning.\n// Assert the number is not greater than the maximum number.\n    if (Number(currencyDigits) > MAXIMUM_NUMBER) {\n        alert(\"您输入的超过了最大值：\" + MAXIMUM_NUMBER);\n        return currencyDigits;\n    }\n\n// Process the coversion from currency digits to characters:\n// Separate integral and decimal parts before processing coversion:\n    parts = currencyDigits.split(\".\");\n    if (parts.length > 1) {\n        integral = parts[0];\n        decimal = parts[1];\n        // Cut down redundant decimal digits that are after the second.\n        decimal = decimal.substr(0, 2);\n    } else {\n        integral = parts[0];\n        decimal = \"\";\n    }\n// Prepare the characters corresponding to the digits:\n    digits = new Array(CN_ZERO, CN_ONE, CN_TWO, CN_THREE, CN_FOUR, CN_FIVE, CN_SIX, CN_SEVEN, CN_EIGHT, CN_NINE);\n    radices = new Array(\"\", CN_TEN, CN_HUNDRED, CN_THOUSAND);\n    bigRadices = new Array(\"\", CN_TEN_THOUSAND, CN_HUNDRED_MILLION);\n    decimals = new Array(CN_TEN_CENT, CN_CENT);\n// Start processing:\n    outputCharacters = \"\";\n// Process integral part if it is larger than 0:\n    if (Number(integral) > 0) {\n        zeroCount = 0;\n        for (i = 0; i < integral.length; i++) {\n            p = integral.length - i - 1;\n            d = integral.substr(i, 1);\n            quotient = p / 4;\n            modulus = p % 4;\n            if (d == \"0\") {\n                zeroCount++;\n            } else {\n                if (zeroCount > 0) {\n                    outputCharacters += digits[0];\n                }\n                zeroCount = 0;\n                outputCharacters += digits[Number(d)] + radices[modulus];\n            }\n            if (modulus == 0 && zeroCount < 4) {\n                outputCharacters += bigRadices[quotient];\n            }\n        }\n        outputCharacters += CN_DOLLAR;\n    }\n// Process decimal part if there is:\n    if (decimal != \"\" && decimal != \"00\") {\n        for (i = 0; i < decimal.length; i++) {\n            d = decimal.substr(i, 1);\n            if (d != \"0\") {\n                outputCharacters += digits[Number(d)] + decimals[i];\n            } else {\n                outputCharacters += digits[Number(d)];\n            }\n        }\n    } else {\n        decimal = \"\";\n    }\n// Confirm and return the final output string:\n    if (outputCharacters == \"\") {\n        outputCharacters = CN_ZERO + CN_DOLLAR;\n    }\n    if (decimal == \"\") {\n        outputCharacters += CN_INTEGER;\n    }\n    outputCharacters = CN_SYMBOL + outputCharacters;\n    return outputCharacters;\n}\n\nfunction B0(num) {\n    return Number(num) < 10 ? \"0\" + Number(num) : num;\n}"
          },
