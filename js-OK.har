            "text": "/**\n * select2封装成jquery 插件\n */\n(function($) {\n\t$.fn.wingsSelector = function(options) {\n\t\t\n\t\tvar $this = $(this);\n\t\t\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsSelector.defaults, options);\n\t\t\n\t\t$this.getValue = function(){\n\t\t\tvar temp = $this.val();\n\t\t\tif(!temp){\n\t\t\t\ttemp = '';\n\t\t\t}\n\t\t\treturn temp;\n\t\t};\n\t\tfunction _wingsSelect_getValie(){\n\t\t}\n\t\t\n\t\t$this.setValue = function(newValue){\n\t\t\t_wingsSelect_setValie(newValue);\n\t\t}\n\t\tfunction _wingsSelect_setValie(newValue){\n\t\t\treturn $this.val(newValue).trigger(\"change\");\n\t\t}\n\t\t\n\t\t\n\t\t$this.getSelectedObj = function(){\n\t\t\treturn $this.select2(\"data\");\n\t\t}\n\t\t\n\n\t\t//设置不可用\n\t\t$this.setDisable = function(){\n\t        $this.prop(\"disabled\", true); \n\t\t\t$this.select2();\n\t\t}\n\t\t//设置可用\n\t\t$this.setEnable = function(){\n\t\t\t$this.prop(\"disabled\", false);//可用\n\t\t}\n\n\t\t\n\t\t// 设置数据方法\n\t\t$this.css('width',opts.width);\n\t\t\n\t\t$this.initData = function(opt,parem){\n\t\t\tvar outData = opts.data;\n\t\t\t//设置加载数据\n\t\t\tif(opt){\n\t\t\t\toutData = opt.data;\n\t\t\t\topts.data = outData;\n\t\t\t}\n\t\t\tif(parem && parem.delay ===\"true\"\n\t\t\t\t&& opts.delay === \"true\"){\n\t\t\t\t//应对初始化时的懒加载\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t\n\t\t\tvar placeholder = opts.placeholder;\n\t\t\tvar dataObj = {\n\t\t\t\tdata:[],  \n\t\t\t\tplaceholder:placeholder, //-- 请选择 --\n  \t\t\t\tallowClear:opts.allowClear == \"true\"?true:false\n\t\t\t};\n\t\t\t\n\t\t\tif(opts.noSearch == \"true\"){\n\t\t\t\tdataObj.minimumResultsForSearch = -1;\n\t\t\t}\n\n\t\t\t\n\t\t\tif(outData!=null){\n\t\t\t\tfor(var i=0;i<outData.length;i++){\n\t\t\t\t\tvar tempObj = outData[i];\n\t\t\t\t\tvar text = tempObj.caption;\n\t\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\t\ttext = tempObj.code + '|' +tempObj.caption;\n\t\t\t\t\t}else if(opts.popDisplay == \"{caption}\"){\n\t\t\t\t\t\ttext = tempObj.caption;\n\t\t\t\t\t}else if(opts.popDisplay == \"{code}\"){\n\t\t\t\t\t\ttext = tempObj.code; \n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tvar temp_id = tempObj.code;\n\t\t\t\t\tif(opts.submitcontent == \"{code}|{caption}\"){\n\t\t\t\t\t\ttemp_id = tempObj.code + '|' +tempObj.caption;\n\t\t\t\t\t}else if(opts.submitcontent == \"{caption}\"){\n\t\t\t\t\t\ttemp_id = tempObj.caption;\n\t\t\t\t\t}else if(opts.submitcontent == \"{code}\"){\n\t\t\t\t\t\ttemp_id = tempObj.code;\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\t//追加属性\n\t\t\t\t\ttempObj[\"id\"] = temp_id;\n\t\t\t\t\ttempObj[\"text\"] = text;\n\t\t\t\t\tdataObj.data.push(tempObj);\n\t\t\t\t\t\n\t\t\t\t}\n\t\t\t}\n\n    \t\tvar $options = $this.children();\n    \t\t$options.each(function () {\n      \t\t\tvar $option = $(this);\n      \t\t\t$option.remove();\n      \t\t\t$option = null;\n    \t\t});\n    \t\t$options  = null;\n\n\t\t\t$this.select2(dataObj);//性能问题\n\t\t\t$this.setValue('');\n\n\t\t\t$.each(dataObj,function(k,v){\n\t\t\t\tif(v&&v.length){\n\t\t\t\t\t$.each(dataObj,function(j,o){\n\t\t\t\t\t\to = null;\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\tdataObj = null;\n\t\t\toutData = null;\n\t\t\t\n\t\t};\n\t\tif(options.delay !== \"true\"){\n\t\t\t$this.initData(opts);\n\t\t}\n\t\t\n\t\t$this.setEnable = function(){\n\t\t\t$this.prop(\"disabled\", false);//可用\n\t\t}\n\t\t\n\t\t//ajax配置\n\t\tif(opts.url!=null){\n\t\t\tif(opts.value!=null){\n\t\t\t\topts.ajax = null;\n\t\t\t\t$.ajax({\n\t\t\t\t\turl:opts.url,\n\t\t\t\t\tdata : opts.params,\n\t\t\t\t\ttype:\"POST\",\n\t\t\t\t\tdataType:'json',\n\t\t\t\t\tasync:false,\n\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\topts.data = data;\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}else{\n\t\t\t\topts.ajax = {\n\t\t\t\t\turl : opts.url,\n\t\t\t\t\ttype : 'POST',\n\t\t\t\t\tdataType : 'json',\n\t\t\t\t\tdata : function(params) {\n\t\t\t\t\t\tif (opts.params != null) {\n\t\t\t\t\t\t\tparams = $.extend(params, opts.params);\n\t\t\t\t\t\t}\n\t\t\t\t\t\treturn params;\n\t\t\t\t\t},\n\t\t\t\t\tprocessResults : function(data) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tresults : data\n\t\t\t\t\t\t};\n\t\t\t\t\t},\n\t\t\t\t\tcache : true\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t\tif(opts.value!=null){\n\t\t\t$this.val(opts.value).trigger(\"change\");\n\t\t}else{\n\t\t\t$this.val(null).trigger(\"change\");\n\t\t}\n\t\t\n//\t\tif(opts.noSearch == \"true\"){\n//\t\t\t//去掉搜索框\n//\t\t\t$this.select2({\n//\t\t        minimumResultsForSearch: -1\n//\t\t    });\n//\t\t}\n\n\t\t//onSelect 事件\n\t\t$this.on(\"select2:select\", function (el) {\n\t\t\tif(opts.onSelect!=null){\n\t\t\t\t//alert(el.params.data.id + '=' + el.params.data.text );\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onSelect = wings_getFunc(opts.onSelect);\n\t\t\t\tfor (var b = 0; b < onSelect.length; b++) {\n\t\t\t        var  func = eval(onSelect[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t            \t\tvar result = new func(el.params.data.id,el.params.data.text,opts.data);\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t};\n\t\t});\n\t\t//应对 allowClear 事件\n\t\t$this.on(\"select2:unselect\", function (el) {\n\t\t\tif(opts.onSelect!=null){\n\t\t\t\t//alert(el.params.data.id + '=' + el.params.data.text );\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onSelect = wings_getFunc(opts.onSelect);\n\t\t\t\tfor (var b = 0; b < onSelect.length; b++) {\n\t\t\t        var  func = eval(onSelect[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t            \t\tvar result = new func(null,null);\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t};\n\t\t});\n\t\t\n\t\t$this.getText = function(){\n\t\t\tvar text = [];\n\t\t\tfor(var i=0;i<$this[0].length;i++){\n\t\t\t\tvar option = $($this[0][i]);\n\t\t\t\tif(option[0].selected){\n\t\t\t\t\ttext.push(option[0].text);\n\t\t\t\t\tif(!$this[0].multiple){\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif($this[0].multiple){\n\t\t\t\treturn text;\n\t\t\t}else if(text.length>0){\n\t\t\t\treturn text[0];\n\t\t\t}else{\n\t\t\t\treturn null;\n\t\t\t}\n\t\t}\n\t\t\n//\t\t$this.on(\"change\", function (el) {\n//\t\t\t//入侵式写法\n//\t\t\tvar text = $this.getText();\n//\t\t\tif(opts.inputDisplay == \"{code}|{caption}\"){\n//\t\t\t\tif(text && text.indexOf('|')!=-1){\n//\t\t\t\t\ttext = text.substr(text.indexOf('|')+1,text.length);\n//\t\t\t\t};\n//\t\t\t\ttext = $this.val() + '|' + text;\n//\t\t\t}else if(opts.inputDisplay == \"{caption}\"){\n//\t\t\t\tif(text && text.indexOf('|')!=-1){\n//\t\t\t\t\ttext = text.substr(text.indexOf('|')+1,text.length);\n//\t\t\t\t};\n//\t\t\t}else if(opts.inputDisplay == \"{code}\"){\n//\t\t\t\ttext = $this.val();\n//\t\t\t}\n//\t\t\t//关键\n//\t\t\t$('#select2-'+opts.objId+'-container').html(text);\n//\t\t\t$('#select2-'+opts.objId+'-container').attr(\"title\",text);\n//\t\t});\n\t\t\t\n\t\t\n\t\t\n\t\t//获取选中值\n\t\t$this.getSelections = function(){\n\t\t\tvar data = [];\n\t\t\tfor(var i=0;i<$this[0].length;i++){\n\t\t\t\tvar option = $($this[0][i]);\n\t\t\t\tif(option[0].selected){\n\t\t\t\t\tdata.push({id:option[0].value,text:option[0].text});\n\t\t\t\t\tif(!$this[0].multiple){\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif($this[0].multiple){\n\t\t\t\treturn data;\n\t\t\t}else if(data.length>0){\n\t\t\t\tif(opts.relid != null && opts.relurl !=null){\n\t\t\t\t$.ajax({\n\t\t\t\t\turl:opts.relurl,\n\t\t\t\t\tdata : data[0],\n\t\t\t\t\ttype:\"POST\",\n\t\t\t\t\tdataType:'json',\n\t\t\t\t\tasync:false,\n\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t$(\"#\"+opts.relid).data=data;\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\t\t\t\treturn data[0];\n\t\t\t}else{\n\t\t\t\treturn null;\n\t\t\t}\n\t\t}\n\t\tif(opts.disable == \"true\" ){\n\t\t\t$this.setDisable();\n\t\t}\n\t\t\n\t \t//设置toolbar每页数量\n\t\t$this.destroy = function(){\n\t\t\tif($this.data('select2')){\n\t\t\t\t$this.data('select2').destroy();\n\t\t\t}\n\t\t\t\n    \t\tvar $options = $this.children();\n    \t\t$options.each(function () {\n      \t\t\tvar $option = $(this);\n      \t\t\t$option.remove();\n      \t\t\t$option = null;\n    \t\t});\n    \t\t$options  = null;\n    \t\t\n\t\t\t$.each(opts,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$.each($this,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$this.remove();\n\t\t\t$this = null;\n\t\t};\n\t\t\n\t\treturn $this;\n\t};\n\t\n\t\n\t\n\t// 默认设置\n\t$.fn.wingsSelector.defaults = {\n\t\turl : null,\n\t\tvalue : null,\n\t\twidth:'100%',\n\t\tdata : null,\n\t\tparams : null,\n\t\tmultiple:false,\n\t\tplaceholder: \"请选择\",\n\t\t//tokenSeparators: [',', ' '],\n\t\tonSelect:null,\n\t\trelid:null,\n\t\trelurl:null,\n\t\tdataName:null,\n\t\tplaceholder:'',\n  \t\tallowClear:\"false\"\n\t};\n})(window.jQuery);"
          },
