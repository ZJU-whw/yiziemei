            "text": "/**\n * fileupload封装成jquery 插件\n */\n(function($) {\n\t$.fn.wingsFileUpload = function(options) {\n\t\t\n\t\tvar IEVersion = function(){//只支持ie9以及以下\n\t\t    var v = 3, div = document.createElement('div'), all = div.getElementsByTagName('i');\n\t\t    while (\n\t\t        div.innerHTML = '<!--[if gt IE ' + (++v) + ']><i></i><![endif]-->',\n\t\t        all[0]\n\t\t    );\n\t\t    return v > 4 ? v : false ;\n\t\t};\n\t\t\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsFileUpload.defaults, options);\n\t\t// 设置数据方法\n\t\tvar $this = $(this);\n\t\tvar flag = true;\n\t\tif($this.length == 0) return;\n\t\tvar id = 'wingsfileupload_'\n\t\tif($this.attr('id')){\n\t\t\tid = id+$this.attr('id');\n\t\t}else{\n\t\t\tid = id+$wings_getRandomUUID();;\n\t\t}\n\t\tvar fileInput = $('<input type=\"file\" name=\"files\" >');\n\t\tif(($this[0].tagName == \"input\" || $this[0].tagName == \"INPUT\") && $this.attr(\"type\") == \"file\"){\n\t\t\tfileInput = $this;\n\t\t\tvar button = $(\"<a href='javascript:;' class='wingsfileupload'></a>\").attr('id',id);\n\t\t\tvar buttonName = \"上传文件\";\n\t\t\tif(opts.buttonName){\n\t\t\t\tbuttonName = opts.buttonName;\n\t\t\t}\n\t\t\tif(opts.buttonWidth){\n\t\t\t\tfileInput.width(opts.buttonWidth);\n\t\t\t}\n\t\t\tbutton.prepend(buttonName);\n\t\t\tfileInput.wrap(button);\n\t\t}else{\n\t\t\t$this.after(fileInput);\n\t\t\tvar selectFile = function(){\n\t\t\t\tfileInput.click();\n\t\t\t}\n\t\t\t//选文件前事件\n\t\t\t$this.click(function() {\n\t\t\t\tif(opts.onBeforeShowDialog){\n\t\t\t\t\tvar flag = opts.onBeforeShowDialog.call(this,opts);\t\t\t\t\n\t\t\t\t}\n\t\t\t\tif(flag){\n\t\t\t\t\tif(opts.onBeforeSelectFile){\n\t\t\t\t\t\topts.onBeforeSelectFile(selectFile);\n\t\t\t\t\t}else{\n\t\t\t\t\t\tselectFile();\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t});\n\t\t\tfileInput.hide();\n\t\t}\n\t\tif(opts.multiple){\n\t\t\tfileInput.attr('multiple','multiple');\n\t\t}\n\t\tvar ctrl = $.getUrlParam(opts.url, 'ctrl');\n\t\tvar tid = $.getUrlParam(opts.url, 'tid');\n\t\tvar postData = {\n\t\t\ttid : tid,\n\t\t\tctrl : ctrl,\n\t\t\tdata:[]\n\t\t};\n\t\tvar dialog;\n\t\tvar panel=$('<div></div>');\n\t\tvar progress= $('<div style=\"display:none;\" class=\"progress\"><div class=\"progress-bar\" role=\"progressbar\" aria-valuenow=\"60\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"width: 0%;\"></div>');\n\t\t//if(opts.simple){\n\t\t\t//简单上传 选文件后显示进度\n\t\t\tpanel.append(progress);\n\t\t\tprogress.show();\n\t\t//}\n\t\t\n\t\t/**\n\t\t * 重置进度条\n\t\t */\n\t\tvar resetProgress = function(){\n\t\t\t$(progress).find('.progress-bar').css('width','0%');\n\t\t    $(progress).find('.progress-bar').html(\"上传进度 0%\");\n\t\t\t//progress.hide();\n\t\t}\n\t\tvar bandSelect = function(){\n\t\t\tflag = false;\n\t\t}\n\t\tvar showDialog = function(data){\n\t\t\tpostData = {\n\t\t\t\ttid : tid,\n\t\t\t\tctrl : ctrl,\n\t\t\t\tdata:[]\n\t\t\t};\n\t\t\t//拼装参数\n\t\t\tif (opts.data) {\n\t\t\t\tif(typeof(opts.data)=='function'){\n\t\t\t\t\topts.data = opts.data();\n\t\t\t\t}\n\t\t\t\tvar datas = new Array();\n\t\t\t\tfor ( var k in opts.data) {\n\t\t\t\t\tif (opts.data[k] !== 'ctrl' && opts.data[k] !== 'tid') {\n\t\t\t\t\t\tvar pData = {\n\t\t\t\t\t\t\tname : k,\n\t\t\t\t\t\t\tvalue : opts.data[k],\n\t\t\t\t\t\t\tsword : 'attr'\n\t\t\t\t\t\t};\n\t\t\t\t\t\tpostData.data.push(pData);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(opts.onBeforeSubmit){\n\t\t\t\topts.onBeforeSubmit(postData);\n\t\t\t}\n\t\t\tdata.formData = {\n\t\t\t\tpostData : JSON.stringify(postData)\n\t\t\t};\n\t\t\tvar buttons=[];\n\t\t\tvar ieVersion = IEVersion();\n\t\t\tif(ieVersion != false && ieVersion <= 9){\n\t\t\t\t//is ie8\n\t\t\t\t$(progress).find('.progress-bar').css('width','100%');\n\t\t\t\t$(progress).find('.progress-bar').html(\"文件上传中 ... \");\n\t\t\t\tdialog = window.BootstrapDialog.show({\n\t\t\t\t\ttitle:'文件上传',\n\t\t\t\t\tdraggable: true,\n\t\t\t\t\tmessage:panel,\n\t\t\t\t\tbuttons:buttons,\n\t\t\t\t\tclosable:false,\n\t\t\t\t\tonshown: function(dialog){\n\t\t\t\t\t\tvar $modalDialog = dialog.getModalDialog();\n\t\t\t\t\t\t$modalDialog.css({\n\t\t\t\t\t\t\t\"position\" : \"absolute\",\n\t\t\t\t\t\t\t\"left\" : \"50%\",\n\t\t\t\t\t\t\t\"margin-left\" : -(500 / 2)\n\t\t\t\t\t\t});\n\t\t\t\t\t\tdata.submit();\n\t\t\t\t\t},\n\t\t\t\t\tonhidden: function(dialog){\n\t\t\t\t\t\tresetProgress();\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\tdialog.getModalDialog().css('width','500px');\n\t\t\t}else{\n\t\t\t\tdialog = window.BootstrapDialog.show({\n\t\t\t\t\ttitle:'文件上传',\n\t\t\t\t\tdraggable: true,\n\t\t\t\t\tmessage:panel,\n\t\t\t\t\tbuttons:buttons,\n\t\t\t\t\tclosable:false,\n\t\t\t\t\tonshown: function(dialog){\n\t\t\t\t\t\tdata.submit();\n\t\t\t\t\t},\n\t\t\t\t\tonhidden: function(dialog){\n\t\t\t\t\t\tresetProgress();\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t\t$this.domFileData = \"\";\n\t\tvar addDom = function (data){\n\t\t\tif(data&&(data.files)&&(data.files.length>0)){\n\t\t\t\tfor(var i=0;i<data.files.length;i++){\n\t\t\t\t\tif($this.domFileData == \"\"){\n\t\t\t\t\t\t$this.domFileData = data;\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$this.domFileData.files.push(data.files[i]);\n\t\t\t\t\t}\t\n\t\t\t\t\tvar span = $('<span>');\n\t\t\t\t\tvar title = data.files[0].name\n\t\t\t\t\tvar a = $('<a class=\"wingsdownloadlink\">'+title+'</a>');\n\t\t\t\t\tspan.append(a);\n\t\t\t\t\ta = $('<a class=\"wingsdeletelink\" href=\"javascript:void(0)\">×</a>');\n\t\t\t\t\tvar tempData = data.files[i];\n\t\t\t\t\ta.on('click', function(e){\n\t\t\t\t\t\tif(opts.onDeleteBefore){\n\t\t\t\t\t\t\tif(opts.onDeleteBefore(tempData, span) == false){\n\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tvar index = $this.domFileData.files.indexOf(tempData);\n\t\t\t\t\t\tif(index > -1){\n\t\t\t\t\t\t\t$this.domFileData.files.splice(index, 1);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tspan.remove();\t\n\t\t\t\t\t})\n\t\t\t\t\tspan.append(a);\n\t\t\t\t\tif(span){\n\t\t\t\t\t\t$('#'+id).before(span);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t$this.domFileSubmit = function(){\n\t\t\t$this.domFileData.submit();\n\t\t}\n\t\t$this.init = function(fileList){\n\t\t\t\t$(fileList).each(function(index, obj) {\n\t\t\t\t\tvar span;\n\t\t\t\t\tif(opts.downloadTitleKey && opts.downloadUrlKey){\n\t\t\t\t\t\tvar span = $('<span>');\n\t\t\t\t\t\tvar downloadUrl = obj[opts.downloadUrlKey];\n\t\t\t\t\t\tvar title = obj[opts.downloadTitleKey];\n\t\t\t\t\t\tvar a = $('<a class=\"wingsdownloadlink\" href=\"'+downloadUrl+'\">'+title+'</a>');\n\t\t\t\t\t\tspan.append(a);\n\t\t\t\t\t}\n\t\t\t\t\tif(opts.deleteUrlKey){\n\t\t\t\t\t\tif(!span) span = $('<span>');\n\t\t\t\t\t\tvar deleteUrl = obj[opts.deleteUrlKey];\n\t\t\t\t\t\tvar a = $('<a class=\"wingsdeletelink\" deleteUrl='+deleteUrl+' href=\"javascript:void(0)\">×</a>');\n\t\t\t\t\t\ta.on('click', function(e){\n\t\t\t\t\t\t\tvar theData = {};\n\t\t\t\t\t\t\tif(opts.onDeleteBefore){\n\t\t\t\t\t\t\t\tif(opts.onDeleteBefore(theData, span) == false){\n\t\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\t\turl:$(this).attr('deleteUrl'),\n\t\t\t\t\t\t\t\tdata:theData,\n\t\t\t\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t\t\t\tspan.remove();\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t})\n\t\t\t\t\t\tspan.append(a);\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tif(span){\n\t\t\t\t\t\tif(obj.itemParam){\n\t\t\t\t\t\t\tspan.itemParam = JSON.parse(obj.itemParam);\n\t\t\t\t\t\t}\n\t\t\t\t\t\t$('#'+id).before(span);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t}\n\t\t//console.log($('#'+id),fileInput,$(fileInput));\n//\t\t// 初始化插件\n\t\t$(fileInput).fileupload({\n\t\t\tdataType : 'json',\n\t\t\tautoUpload : false,\n\t\t\tmessages:opts.messages,\n\t\t\tsingleFileUploads:false,\n\t\t\tformData : {\n\t\t\t\tpostData : JSON.stringify(postData)\n\t\t\t},\n\t\t\tacceptFileTypes:opts.acceptFileTypes,\n\t\t\tmaxFileSize:opts.maxFileSize,\n\t\t\turl : opts.url,\n\t\t\tdone : function(e, data) {\n\t\t\t\tif(opts.done){\n\t\t\t\t\topts.done(e, data);\n\t\t\t\t}\n\t\t\t},\n\t\t\tsuccess : function(result, textStatus, jqXHR) {\n\t\t\t\tvar res = null;\n\t\t\t\tif(result && result.data && result.data.length && result.data.length > 0){\n\t\t\t\t\tres = {};\n\t\t\t\t\tvar len = result.data.length;\n\t\t\t\t\tfor(var l=0; l<len; l++){\n\t\t\t\t\t\tres[result.data[l].name] = result.data[l].value;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(!res){\n\t\t\t\t\tres = result;\n\t\t\t\t}\n\t\t\t\tif(res && res.succ){\n\t\t\t\t\tif(opts.autoLoad){\n\t\t\t\t\t\tvar span;\n\t\t\t\t\t\tif(opts.downloadTitleKey && opts.downloadUrlKey){\n\t\t\t\t\t\t\tvar span = $('<span>');\n\t\t\t\t\t\t\tvar downloadUrl = res[opts.downloadUrlKey];\n\t\t\t\t\t\t\tvar title = res[opts.downloadTitleKey];\n\t\t\t\t\t\t\tvar a = $('<a class=\"wingsdownloadlink\" downloadUrl='+downloadUrl+' href=\"'+downloadUrl+'\">'+title+'</a>');\n\t\t\t\t\t\t\tspan.append(a);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(opts.deleteUrlKey){\n\t\t\t\t\t\t\tif(!span) span = $('<span>');\n\t\t\t\t\t\t\tvar deleteUrl = res[opts.deleteUrlKey];\n\t\t\t\t\t\t\tvar a = $('<a class=\"wingsdeletelink\" deleteUrl='+deleteUrl+' href=\"javascript:void(0)\">×</a>');\n\t\t\t\t\t\t\ta.on('click', function(e){\n\t\t\t\t\t\t\t\tvar theData = {};\n\t\t\t\t\t\t\t\tif(opts.onDeleteBefore){\n\t\t\t\t\t\t\t\t\tif(opts.onDeleteBefore(theData, span) == false){\n\t\t\t\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\t\t\turl:$(this).attr('deleteUrl'),\n\t\t\t\t\t\t\t\t\tdata:theData,\n\t\t\t\t\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t\t\t\t\tspan.remove();\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t})\n\t\t\t\t\t\t\tspan.append(a);\n\t\t\t\t\t\t}\n\t\t\t\t\t\t\n\t\t\t\t\t\tif(span){\n\t\t\t\t\t\t\tif(res.itemParam){\n\t\t\t\t\t\t\t\tspan.itemParam = JSON.parse(res.itemParam);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t$('#'+id).before(span);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif(opts.success){\n\t\t\t\t\t\topts.success(res);\n\t\t\t\t\t}\n\t\t\t\t}else{\n\t\t\t\t\tif(opts.error){\n\t\t\t\t\t\topts.error(res);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t\terror : function(jqXHR, textStatus, errorThrown) {\n\t\t\t\t//console.log('err',textStatus,errorThrown);\n\t\t\t\t//alert('上传失败');\n\t\t\t\t//console.log('err',jqXHR,textStatus,errorThrown);\n\t\t\t\tif(opts.error){\n\t\t\t\t\topts.error(null, jqXHR, textStatus, errorThrown);\n\t\t\t\t}\n\t\t\t\tif(dialog && dialog.close)dialog.close();\n\t\t\t},\n\t\t\tadd:function(e,data){\n\t\t\t\t//console.log('add',data);\n\t\t\t\tif(opts.add){\n\t\t\t\t\topts.add(e,data);\n\t\t\t\t}\n\t\t\t\tif(opts.autoLoad){\n\t\t\t\t\tshowDialog(data);\n\t\t\t\t}else{\n\t\t\t\t\taddDom(data);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t},\n\t\t\tcomplete:function(result, textStatus, jqXHR){\n\t\t\t\t//console.log('complete');\n\t\t\t\tif(dialog && dialog.close) dialog.close();\n\t\t\t},\n\t\t\tdrop:function(e,data){\n\t\t\t\t//console.log('drop',data);\n\t\t\t},\n\t\t\tchange: function (e, data) {\n\t\t\t\t//console.log('change',data);\n\t\t\t},\n\t\t\tprocessalways:function (e, data) {\n\t\t\t\t//console.log('processalways',data);\n\t\t\t\t//on before upload\n\t\t\t\tif(opts.onBeforeUpload){\n\t\t\t\t\topts.onBeforeUpload(file,submitFile);\n\t\t\t\t}\n\t\t    },\n\t\t    progressall: function (e, data) {\n\t\t\t\tif(data.loaded == 1 &&  data.total == 1){\n\t\t\t\t\t//$(progress).find('.progress-bar').css('width','100%');\n\t\t        \t//$(progress).find('.progress-bar').html(\"文件上传中 ... \");\n\t\t\t\t}else{\n\t\t\t\t\tvar p = parseInt(data.loaded / data.total * 100, 10);\n\t\t\t\t\t$(progress).find('.progress-bar').css('width',p + '%');\n\t\t\t\t\t$(progress).find('.progress-bar').html(p+\"%\");\n\t\t\t\t}\n\t\t    }\n\t\t});\n\t\treturn $this;\n\t};\n\t// 默认设置\n\t$.fn.wingsFileUpload.defaults = {\n\t\turl : null,//url\n\t\tdata : [],//参数\n\t\tsuccess:null,//成功回调\n\t\terror:null,//提交异常回调\n\t\tdone:null,//选中文件后回调\n\t\ttemplate:null,//文件名比对，不同有提醒\n\t\tsimple:true,//简单上传没有输入信息，false含输入框\n\t\tonBeforeUpload:null,\n\t\tmultiple:false,//一次选择多个文件\n\t\tonBeforeSelectFile:null,\n\t\tacceptFileTypes: /(\\.|\\/)(gif|jpe?g|png|bmp|mp3|mp4|zip|7z|rar|doc|docx|xls|xlsx|ppt|pptx|pdf|txt|tar|ogg|wma|wmv|mov|rm|wav|webm)$/i,\n\t    maxFileSize: 20480000, // 10 MB\n\t\tmessages: {\n            acceptFileTypes: '文件类型不正确！',\n            maxFileSize: '文件过大(文件大小不能超过10M)！',\n            minFileSize: '文件过小！'\n        },\n        downloadTitleKey: null, //上传后显示的下载链接标题属性名\n        downloadUrlKey: null, //下载链接\n        downloadUrlKey: null, //删除链接\n        downloadCtrl: null, //下载链接\n        deleteCtrl: null,\n        autoLoad:true\n\t};\n})(window.jQuery);"
