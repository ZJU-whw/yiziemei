            "compression": 12096,
            "text": "var prefix = \"http://\";\nvar host = window.location.host;\nvar djxh = \"\";\nvar nsrsbh = \"\";\nvar nsrmc = \"\";\nvar shxydm = \"\";\nvar sjlybz = \"\";\nvar dsjid = \"\";\nvar swzj = \"\";\n\n// added by DengLY at 2019-03-28\n// 纳税人基本信息\nvar nsrBasicInfo = {};\n\n////当前选中一级功能\nvar checked_menu1 = \"\";\n////当前选中二级功能\nvar checked_menu2 = \"\";\n\nvar datasourcename = \"\";\nvar datasourcetype = \"\";\nvar exportFlag = \"N\";\n/**\n * 所有菜单项，以ccm每3位判断层级\n * @type {null}\n */\nvar menuItems = null;\nvar appId = \"\";\nvar ckqybz = \"\";\nvar urlData = {};\nvar zgswjDm = \"\";\nvar zgswskfjDm = \"\";\nvar wbxtBz = \"N\";\n//系统相关信息\nvar systemInfo = \"\";\nvar toMenuCode = null;\nvar toSubMenuCode = null;\n\n//外部系统跳转相关 add by yl 260313 -----start\nvar JRXTBM = \"\";//外部系统接入码\nvar YJTABCODE = \"\";//外部系统如果接入一级tab页时传入\n//外部系统跳转相关 add by yl 260313 -----end\n\nfunction initSuccess(res) {\n    // showLoadWaiting();\n    djxh = res.getAttr(\"djxh\");\n    sjlybz = res.getAttr(\"sjlybz\");\n    nsrsbh = res.getAttr(\"nsrsbh\");\n    nsrmc = res.getAttr(\"nsrmc\");\n    shxydm = res.getAttr(\"shxydm\");\n    zgswjDm = res.getAttr(\"zgswjDm\");\n    zgswskfjDm = res.getAttr(\"zgswskfjDm\");\n    var zgswjg = res.getAttr(\"zgswskfjmc\");\n    var nsrzt = res.getAttr(\"nsrztmc\");\n    swzj = res.getAttr(\"swzj\");\n    dsjid = res.getAttr(\"dsjid\");\n    //20200927新增appId\n    appId = res.getAttr(\"appId\");\n    ckqybz = res.getAttr(\"ckqybz\");\n    systemInfo = res.getAttr(\"systemInfo\");\n    //外部系统跳转相关 add by yl 260313 -----start\n    JRXTBM = res.getAttr(\"jrxtbm\");\n    YJTABCODE = res.getAttr(\"yjtabcode\");\n    //集成一级tab页时，即展示所有符合的二级tab页，把一级tab页选择，进行隐藏\n    if (!isNull(YJTABCODE) && !isNull(JRXTBM)) {\n        $('#myTab').hide();\n        $('#nsrxxList_content_box').hide();\n    }\n    //外部系统跳转相关 add by yl 260313 -----end\n    $('#nsrmc').html(nsrmc);\n    if (isNull(shxydm)) {\n        $('#shxydm').html(nsrsbh);\n    } else {\n        $('#shxydm').html(shxydm);\n    }\n    if (nsrzt == \"正常\") {\n        $('#nsrztmc').addClass(\"nsrzt_zc\")\n    } else if (nsrzt.startsWith(\"非正常\")) {\n        $('#nsrztmc').addClass(\"nsrzt_fzc\")\n    } else if (nsrzt == \"核销\") {\n        $('#nsrztmc').addClass(\"nsrzt_hx\")\n    }\n    $('#nsrztmc').html(nsrzt);\n    $('#zgswskfjmc').html(zgswjg);\n    //getMenu();\n    getNsrxxByDjxhAndSjlybz(djxh, sjlybz);\n}\n\nfunction getNsrxxByDjxhAndSjlybz(djxhParam, sjlybzParam) {\n    var sub = new WingsSubmit();\n    sub.setCtrl(\"DhcxCtrl_queryNsrxxByDjxh\");\n    sub.pushData(\"djxh\", djxhParam);\n    sub.pushData(\"sjlybz\", sjlybzParam);\n    sub.setFunction(\"onSuccess\", \"setNsrxx()\");\n    sub.setFunction(\"onError\", \"WingsSubmit_onError()\");\n    sub.setFunction(\"onException\", \"WingsSubmit_onError()\");\n    sub.submit();\n}\n\nfunction setNsrxx(res) {\n    var nsrxxMap = res.getAttr(\"nsrxxMap\");\n    var nsrxxMapJson = jQuery.parseJSON(nsrxxMap);\n    //设置纳税人主页上方信息\n    //--\n    var ckqybz = nsrxxMapJson.ckqybz;\n    var cpyqybz = nsrxxMapJson.cpyqybz;\n    //01成品油生产企业02成品油经销企业\n    if (\"01\" == cpyqybz) {\n        $('#nsrmc').html(nsrmc + \"（成品油生产企业）\");\n        //kkjypzl\n        $('#kjjypzl').html(\"可开具油品种类：\" + nsrxxMapJson.kkjypzl);\n    } else if (\"02\" == cpyqybz) {\n        $('#nsrmc').html(nsrmc + \"（成品油经销企业）\");\n        //\n        $('#kjjypzl').html(\"可开具油品种类：\" + nsrxxMapJson.kkjypzl);\n    }\n    var systemInfoJson = jQuery.parseJSON(systemInfo.replace(/\\'/g, \"\\\"\"));\n    var zjjcjbz = \"\";\n    if (systemInfoJson.zjjcjbz) {\n        zjjcjbz = systemInfoJson.zjjcjbz;\n    }\n    ;\n    var ldtsqybz = nsrxxMapJson.ldtsqybz;\n    var sfdqdehd = nsrxxMapJson.sfdqdehd;\n    var ptbsqybz = nsrxxMapJson.ptbsqybz;\n    var qybzJson = {\n        \"ckqybz\": ckqybz,\n        \"cpyqybz\": cpyqybz,\n        \"zjjcjbz\": zjjcjbz,\n        \"ldtsqybz\": ldtsqybz,\n        \"sfdqdehd\": sfdqdehd,\n        \"ptbsqybz\": ptbsqybz\n    };\n    var qybz = JSON.stringify(qybzJson);\n    getMenu(qybz);\n}\n\n\nfunction getMenu(qybz) {\n    var systemInfoJson = jQuery.parseJSON(systemInfo.replace(/\\'/g, \"\\\"\"));\n    var source;\n    if (systemInfoJson.source) {\n        source = systemInfoJson.source;\n    }\n    if (systemInfoJson.toMenuCode) {\n        toMenuCode = systemInfoJson.toMenuCode;\n    }\n    if (systemInfoJson.toSubMenuCode) {\n        toSubMenuCode = systemInfoJson.toSubMenuCode;\n    }\n    var sub = new WingsSubmit();\n    sub.setCtrl(\"DhcxCtrl_getMenu\");\n    sub.pushData(\"appId\", appId);\n    sub.pushData(\"ckqybz\", ckqybz);\n    sub.pushData(\"qybz\", qybz);\n    sub.pushData(\"source\", source);\n    sub.setFunction(\"onSuccess\", \"setMenu()\");\n    sub.setFunction(\"onError\", \"WingsSubmit_onError()\");\n    sub.setFunction(\"onException\", \"WingsSubmit_onError()\");\n    sub.submit();\n}\n\nfunction setMenu(res) {\n    var menulv1list = res.getAttr(\"menulv1list\");\n    var resMenuItems = jQuery.parseJSON(menulv1list);\n    if (!resMenuItems) return;\n    var toMenuIndex = 0;\n    var menuCodeSeq = 0;\n    //临时处理，出口退税外部系统所有一户式页面，把异地信息部分隐藏不展示tab add by yl 260318 start\n    if (!isNull(JRXTBM) && JRXTBM == \"WBXT-CKTS\") {\n        var filterMenuItems = [];\n        $.each(resMenuItems, function (i, map) {\n            if (map.menuCode.indexOf(\"dhcx012\") == -1) {\n                filterMenuItems.push(map);\n            }\n        })\n        menuItems = filterMenuItems;\n    } else {\n        menuItems = resMenuItems;\n    }\n    //临时处理，出口退税外部系统所有一户式页面，把异地信息部分隐藏不展示tab add by yl 260318 end\n    if (!menuItems) return;\n    $.each(menuItems, function (i, map) {\n        if (map.level !== 1) {\n            return;\n        }\n        //临时处理，外部系统集成页面只是集成一级tab下所有二级tab,通过一级tab码，过滤其tab add by yl 260313 start\n        if (!isNull(YJTABCODE) && !isNull(JRXTBM)) {\n            if (map.menuCode != YJTABCODE) {\n                return;\n            }\n        }\n        //临时处理，外部系统集成页面只是集成一级tab下所有二级tab,通过一级tab码，过滤其tab  add by yl 260313 end\n\n        if (map.menuCode == toMenuCode) {\n            toMenuIndex = menuCodeSeq;\n        }\n        menuCodeSeq++;\n        $(\"#myTab\").append(\n            \"<li><a href='#' onclick='doClickMenuItemLevel1(this);' data-toggle='tab' gndm=\"\n            + map.menuCode\n            + \" ccm=\"\n            + map.levelCode\n            + \">\"\n            + map.menuShortName\n            + \"</a></li>\");\n    });\n    var _length = $(\"#myTab\").children().length;\n    if (_length > 0) {\n        var _width = 120 * _length + \"px\";\n        //alert(_width);\n        $(\"#myTab li:eq(\" + toMenuIndex + \")\").addClass(\"active\");\n        doClickMenuItemLevel1($(\"#myTab li:eq(\" + toMenuIndex + \")>a\"));\n        $(\"#myTab\").width(_width);\n    }\n}\n\n/**\n * 点击一级菜单项\n * @param menuItemLevel1 一级菜单项\n */\nfunction doClickMenuItemLevel1(menuItemLevel1) {\n    if (!menuItems || !menuItemLevel1) return;\n\n    var thisObj = $(menuItemLevel1);\n    var nodeId = thisObj.attr(\"gndm\");\n    var ccm = thisObj.attr(\"ccm\");\n\n    //判断是否点击同一个一级菜单，是不重新加载，不是重新加载并将新点击的已经菜单存入checked_menu1\n    if (checked_menu1 == nodeId) {\n        return;\n    }\n    checked_menu1 = nodeId;\n\n    clearPageIframe();\n\n    /**\n     * 根据所选一级菜单项重置二级菜单项\n     * @param parentCcm 一级菜单项ccm\n     */\n    function resetMenuItemsLevel2(parentCcm) {\n        var menuLevel2 = $(\"#gnxxul\");\n        menuLevel2.find(\"li\").remove();\n        var toSubMenuIndex = 0;\n        var subMenuCodeSeq = 0;\n        $.each(menuItems, function (i, map) {\n            if (map.level === 1 || map.levelCode.substr(0, 3) !== parentCcm) {\n                return;\n            }\n            var treenode = {\n                \"gndm\": map.menuCode,\n                \"ccm\": map.levelCode,\n                \"cdlx\": map.menuType,\n                \"gnjc\": map.menuShortName,\n                \"gnurl\": map.menuUrl,\n                \"wbxtbm\": map.externalSystemCode,//外部系统编码\n                \"mygnxh\": subMenuCodeSeq\n            };\n\n            if (map.menuCode == toSubMenuCode) {\n                toSubMenuIndex = subMenuCodeSeq;\n            }\n            subMenuCodeSeq++;\n            var treenodestr = JSON.stringify(treenode);\n            menuLevel2.append(\"<li onclick='doClickMenuItemLevel2(this);' treenode=\" + treenodestr + \">\" + map.menuShortName + \"</li>\");\n        });\n\n        if (menuLevel2.children().length > 0) {\n            menuLevel2.find(\"li:eq(\" + toSubMenuIndex + \")\").addClass(\"cssxhx\");\n            doClickMenuItemLevel2(menuLevel2.children()[toSubMenuIndex]);\n        }\n        toMenuCode = null;\n        toSubMenuCode = null;\n    }\n\n    resetMenuItemsLevel2(ccm);\n}\n\n\n/**\n * 点击二级菜单项\n * @param menuItemLevel2 二级菜单项\n */\nfunction doClickMenuItemLevel2(menuItemLevel2) {\n    if (!menuItems || !menuItemLevel2) return;\n    var thisObj = $(menuItemLevel2);\n    thisObj.closest(\"ul\").find(\"li\").removeClass(\"active\");\n    thisObj.addClass(\"active\");\n    var treenode = thisObj.attr(\"treenode\");\n    var node = jQuery.parseJSON(treenode);\n    //如果点击的是相同的二级功能代码不刷新\n    if (checked_menu2 == node.gndm) {\n        return;\n    }\n    checked_menu2 = node.gndm;\n\n    clearPageIframe();\n\n    $(\"#gntitle\").text(node.gnjc);\n    var menuCode = node.gndm;\n    $(\"#gnxxul li\").removeClass(\"cssxhx\");\n    $(\"#gnxxul li:eq(\" + node.mygnxh + \")\").addClass(\"cssxhx\");\n    var page = node.gnurl;\n//    var url;\n//    //v0.1版本简略实现：如果page是http开头，则是嵌入其他页面\n//    if (page.toLowerCase().startsWith(\"http\")) {\n//        url = page + djxh;\n//    } else {\n//        //var allparams = node.allparams;\n//        var baseurl = \"/sword?ctrl=DhcxCtrl_loadPage\";\n//        // var params = \"&page=\" + page + \"&djxh=\" + djxh + \"&gndm=\" + gndm +\"&nsrsbh=\" + nsrsbh+\"&nsrmc=\" + nsrmc +\"&shxydm=\" + shxydm\n//        //     + \"&datasourcename=\" + datasourcename + \"&datasourcetype=\"\n//        //     + datasourcetype + \"&sqlkey=\" + sqlkey + \"&allparams=\" + allparams\n//        //     + \"&sjlybz=\" + sjlybz + \"&dsjid=\" + dsjid;\n//        var paramsArray = [\"djxh\", \"dsjid\", \"menuCode\", \"page\", \"sjlybz\", \"nsrsbh\", \"shxydm\", \"nsrmc\", \"appId\"];\n//        var valuesArray = [djxh, dsjid, menuCode, page, sjlybz, nsrsbh, shxydm, nsrmc, appId];\n//        var params = createUrlParamsStrByParamsAndVaule(paramsArray, valuesArray);\n//        url = prefix + host + baseurl + params;\n//    }\n    //v0.2版本实现：如果外部系统为空，则是本系统，否则则是外部系统调用\n    var wbxtbmlx = node.wbxtbm;\n    if (isNull(wbxtbmlx)) {\n        wbxtBz = \"N\";\n        var baseurl = \"/sword?ctrl=DhcxCtrl_loadPage\";\n        var paramsArray = [\"djxh\", \"dsjid\", \"menuCode\", \"page\", \"sjlybz\", \"nsrsbh\", \"shxydm\", \"nsrmc\", \"appId\", \"systemInfo\", \"zgswjDm\", \"zgswskfjDm\",\"jrxtbm\"];//add by by yl 250407地址栏信息中增加参数 jrxtbm 用于地址栏中传入外部门系统接入时系统编码\n        var valuesArray = [djxh, dsjid, menuCode, page, sjlybz, nsrsbh, shxydm, nsrmc, appId, systemInfo, zgswjDm, zgswskfjDm,JRXTBM];\n        var params = createUrlParamsStrByParamsAndVaule(paramsArray, valuesArray);\n        var url = encodeURI(prefix + host + baseurl + params);\n        loadPageIframe(url);\n    } else {\n        //清除时间显示\n        var updateDataTime = $(\"#updateDataTime\");\n        updateDataTime.empty();\n        updateDataTime.css({\"top\": \"10px\", \"position\": \"absolute\", \"left\": \"\"});\n\n        wbxtBz = \"Y\";\n        var wbxtbmArr = wbxtbmlx.split(\"@\");\n        //获取外部系统编码\n        var wbxtbm = wbxtbmArr[0];\n        var wbxtlx = wbxtbmArr[1];\n        var swjgDm = isNull(zgswskfjDm) ? zgswjDm : zgswskfjDm;\n        var systemInfoJson = jQuery.parseJSON(systemInfo.replace(/\\'/g, \"\\\"\"));\n        var tygzpt = systemInfoJson.tygzpt;\n        var nsrxxInfo = {\n            \"djxh\": djxh,\n            \"nsrsbh\": nsrsbh,\n            \"nsrmc\": nsrmc\n        };\n        var data = getUrlData(nsrxxInfo, systemInfo);\n        getWbxtUrlByWbxylx(wbxtlx, wbxtbm, swjgDm, tygzpt, data, \"0\");\n    }\n    // loadPageIframe(url);\n    // hideLoadWaiting();\n\n    //v0.3版本实现：\n//    var wbxtbm = node.wbxtbm;\n//    var swjgTemp1 = isNull(zgswskfjDm) ? zgswjDm:zgswskfjDm;\n//    var swjgTemp2 = swjgTemp1.substring(0,5);\n//    var arr=[\"12102\",\"13302\",\"13502\",\"13702\",\"14403\"];\n//    var wbxtswjgDm;\n//    if(arr.includes(swjgTemp2)){\n//         wbxtswjgDm = swjgTemp2 +\"000000\";\n//    }else{\n//         wbxtswjgDm = swjgTemp1.substring(0,3) +\"00000000\";\n//    }\n//    if(!isNull(wbxtbm)){\n//        var wbxtbmArr = wbxtbm.split(\"@\");\n//        wbxtbm = wbxtbmArr[0];\n//        if(\"0\"==wbxtbmArr[1]){\n//        wbxtswjgDm = \"00000000000\";\n//        }\n//\n//    }\n//\n//\n//    var baseurl = \"/sword?ctrl=DhcxCtrl_loadPage\";\n//    var menuInfoJson={\n//            \"wbxtbm\":wbxtbm,\n//            \"wbxtswjgDm\":wbxtswjgDm\n//    };\n//    var menuInfo =JSON.stringify(menuInfoJson);\n//\n//    var paramsArray = [\"djxh\", \"dsjid\", \"menuCode\", \"page\", \"sjlybz\", \"nsrsbh\", \"shxydm\", \"nsrmc\", \"appId\",\"systemInfo\",\"menuInfo\"];\n//    var valuesArray = [djxh, dsjid, menuCode, page, sjlybz, nsrsbh, shxydm, nsrmc, appId,sb,menuInfo];\n//    var params = createUrlParamsStrByParamsAndVaule(paramsArray, valuesArray);\n//    url = prefix + host + baseurl + params;\n//    loadPageIframe(url);\n}\n\n\nfunction createUrlParamsStrByParamsAndVaule(paramsArray, valuesArray) {\n    var paramsStr = \"\";\n    for (var i = 0, len = paramsArray.length; i < len; i++) {\n        paramsStr += \"&\" + paramsArray[i] + \"=\" + valuesArray[i];\n    }\n    return EncryptUtils.encryptStr(paramsStr);\n}\n\n\nfunction WingsSubmit_onError(res) {\n    // hideLoadWaiting();\n\n    var debugObj = {};\n    try {\n        debugObj.exceptionMes = res.exceptionMes;\n        debugObj.debugMes = res.debugMes;\n        WingsDialog.alertDebugMsg(debugObj);\n    } catch (e) {\n    }\n}\n\nfunction loadWbxtPageIframe(srcUrl) {\n    $(\"#pageiframe\").attr(\"src\", srcUrl);\n}\n\nfunction loadPageIframe(srcUrl) {\n    $(\"#pageiframe\").attr(\"src\", srcUrl);\n}\n\nfunction clearPageIframe() {\n    loadPageIframe(\"about:blank\");\n}\n\nfunction xtcsControl(res) {\n    var cspzData = res.getAttr(\"cspz\");\n    var cspz_json = jQuery.parseJSON(cspzData);\n    $.each(cspz_json, function (k, data) {\n        var csbm = data.CSM;\n        var csz = data.CSZ;\n        if (csbm === \"ENABLE_EXPORT\") {\n            exportFlag = csz;\n            return false;\n        }\n    })\n}\n\n/**\n * 提供给二级功能获取纳税人基本信息\n */\nfunction getNsrBasicInfo4Iframe() {\n    return nsrBasicInfo;\n}\n\nfunction isNull(value) {\n    if (typeof value == undefined || value == null || value == \"\" || value == \"[]\" || value == \"[{}]\" || value == \"null\" || value == \"{}\") {\n        return true;\n    }\n    return false;\n}\n\n/**\n * 组装form数据\n * @param name\n * @param paramsData\n * @returns {createFormData.formdata}\n */\nfunction createFormDataForName(paramsData) {\n    //設置分页请求参数\n    var ajaData = {};\n    if (checkNull(paramsData)) {\n        $.each(paramsData, function (key, value) {\n            ajaData[key] = value;\n        });\n    }\n    var data = new createFormData('dataForm');\n    data.setMapData(ajaData);\n    return data.getFormData();\n}\n\n\nfunction gyQysdsException(res) {\n    try {\n        offMenban();\n        var debugObj = {};\n        debugObj.exceptionMes = res.exceptionMes;\n        debugObj.debugMes = res.debugMes.substring(0, res.debugMes.indexOf(\"异常堆栈信息\"));\n\n        WingsDialog.show({\n            size: WingsDialog.SIZE_WIDE,\n            title: \"信息提示\",\n            buttons: [{\n                label: \"关闭\",\n                cssClass: \"btn-default\",\n                hotkey: 65,\n                action: function (dialog) {\n                    dialog.close();\n                }\n            }],\n            message: \"<div style='word-break:break-all;overflow-y: auto'>\" + debugObj.debugMes + \"</div>\"\n        });\n    } catch (e) {\n    }\n};\n\n/**\n * 设置润乾包表部分高度\n */\nfunction setRaqreportHeight() {\n    if ($('div[name=\"yhscxForm\"]').length > 0) {\n        var fromHeight = $('div[name=\"yhscxForm\"]')[0].clientHeight;\n        var winHeight = $(window).height();\n        var raqHeight = $('table[id=\"report1\"]')[0].clientHeight;\n\n        $('#testHtml').css('height', (winHeight - fromHeight - 36) + 'px');\n        if (raqHeight > winHeight) {\n            $('#testHtml').css('overflow-y', 'auto');\n        }\n    }\n\n    //润乾报表数据区域增加水印，仅对一户式查询使用\n    $('td[class^=\"report\"]').css('background-color', 'transparent');\n}\n\n/**\n * 外部系统调用自适应高度\n */\nfunction setWbxtWindowHeight() {\n    var iframFather = $('#pageiframe');\n    if ('Y' == wbxtBz) {\n        var minheight = parent.window.innerHeight - 410;\n        $(iframFather.parent()).css({'height': minheight + 'px', 'overflow-y': 'auto'});\n        iframFather.attr('scrolling', 'yes');\n    } else {\n        $(iframFather.parent()).css({'height': 'auto', 'overflow-y': ''});\n        iframFather.attr('scrolling', 'auto');\n    }\n}"
          },
