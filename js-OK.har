            "compression": 2082,
            "text": "var $cache = {\n\tisReady : false,\n\tstorage: locache,\n\tget : function(key){\n\t\treturn this.storage.get(key);\n\t},\n\tset : function(key, value){\n\t\tthis.storage.set(key, value);\n\t},\n\tbatchGet : function(keys){\n\t\treturn this.storage.getMany(keys)\n\t},\n\tbatchSet : function(keyValObjs){\n\t\tthis.storage.setMany(keyValObjs);\n\t},\n\tremove : function(key){\n\t\t\n\t},\n\tgetTableData : function (tableName) {\n\t\tif(this.storage){\n\t\t\tvar tableVerKey = tableName + \"_version\";\n\t\t\tvar version = this.get(tableVerKey);\n\t\t\tvar data = this.get(tableName);\n\t\t\tif(version){\n\t\t\t\tvar res = this.requestSyncCacheTableVersion(tableName);\n\t\t\t\tif(res){\n\t\t\t\t\tvar resVersion = res.version;\n\t\t\t\t\tif(version < resVersion){\n\t\t\t\t\t\tres = this.requestSyncCacheData(tableName);\n\t\t\t\t\t\tif(res){\n\t\t\t\t\t\t\tvar resVersion = res.version;\n\t\t\t\t\t\t\tvar resData = res[tableName];\n\t\t\t\t\t\t\tthis.set(tableVerKey, resVersion);\n\t\t\t\t\t\t\tthis.set(tableName, resData);\n\t\t\t\t\t\t\tdata = resData;\n\t\t\t\t\t\t}\n\t\t\t\t\t}else{\n\t\t\t\t\t\tdata = this.get(tableName);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}else{\n\t\t\t\tvar res = this.requestSyncCacheData(tableName);\n\t\t\t\tif(res){\n\t\t\t\t\tvar resVersion = res.version;\n\t\t\t\t\tvar resData = res[tableName];\n\t\t\t\t\tthis.set(tableVerKey, resVersion);\n\t\t\t\t\tthis.set(tableName, resData);\n\t\t\t\t\tdata = resData;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn data;\n\t},\n\t\n\trequestSyncCacheTableVersion : function (tableName) {\n\t\tvar resJSON = $.ajax({\n\t\t\turl:\"/ajax.sword?FromSwordLoading=true&ctrl=WingsCacheCtrl_getCacheTableVersion\",\n\t\t\ttype:'POST',\n\t\t\tdataType:'json',\n\t\t\tdata:{\"tableName\" : tableName},\n\t\t\tasync : false,\n\t\t\tsuccess:function(data){\n\t\t\t\tconsole.log(data);\n\t\t\t},\n\t\t\terror:function(data){\n\t\t\t\tconsole.log(data);\n\t\t\t}\n\t\t}).responseJSON;\n\t\treturn resJSON;\n\t\t\n\t},\n\trequestCacheTableVersion : function (tableName) {\n\t\t$.ajax({\n\t\t\turl:\"/ajax.sword?FromSwordLoading=true&ctrl=WingsCacheCtrl_getCacheTableVersion\",\n\t\t\ttype:'POST',\n\t\t\tdataType:'json',\n\t\t\tdata:{\"tableName\" : tableName},\n\t\t\tsuccess:function(data){\n\t\t\t\t//console.log(data);\n\t\t\t},\n\t\t\terror:function(data){\n\t\t\t\t//console.log(data);\n\t\t\t}\n\t\t});\n\t},\n\trequestCacheData : function (tableName) {\n\t\t$.ajax({\n\t\t\turl : \"ajax.sword?FromSwordLoading=true&ctrl=WingsCacheCtrl_getCacheData\",\n\t\t\ttype:'POST',\n\t\t\tdataType:'json',\n\t\t\tdata : {\"tableName\" : tableName},\n\t\t\tsuccess:function(data){\n\t\t\t\t//console.log(data);\n\t\t\t},\n\t\t\terror:function(data){\n\t\t\t\t//console.log(data);\n\t\t\t}\n\t\t})\n\t},\n\trequestSyncCacheData : function (tableName) {\n\t\tvar dt = $.ajax({\n\t\t\turl : \"ajax.sword?FromSwordLoading=true&ctrl=WingsCacheCtrl_getCacheData\",\n\t\t\ttype:'POST',\n\t\t\tdataType:'json',\n\t\t\tdata : {\"tableName\" : tableName},\n\t\t\tasync : false,\n\t\t\tsuccess:function(data){\n\t\t\t\tconsole.log(data);\n\t\t\t},\n\t\t\terror:function(data){\n\t\t\t\tconsole.log(data);\t\t\t\t\n\t\t\t}\n\t\t}).responseJSON; \n\t\treturn dt;\n\t}\n};"
