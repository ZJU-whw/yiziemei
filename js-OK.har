            "compression": 14294,
            "text": "/**\n * jquery.validate封装成jquery 插件\n */\nfunction Map() {\n    this.container = new Object()\n};\nMap.prototype.put = function (a, b) {\n    this.container[a] = b\n};\nMap.prototype.get = function (a) {\n    return this.container[a]\n};\nMap.prototype.remove = function (a) {\n    delete this.container[a]\n};\nMap.prototype.size = function () {\n    var a = 0;\n    for (var i in this.container) {\n        if (this.container.hasOwnProperty(i)) {\n            a++\n        }\n    }\n    return a\n};\nString.prototype.startWith=function(str){     \n\t  var reg=new RegExp(\"^\"+str);     \n\t  return reg.test(this);        \n\t}  \nString.prototype.endWith=function(str){     \n  var reg=new RegExp(str+\"$\");     \n  return reg.test(this);        \n}\nvar msg = '错误信息'; //校验错误信息\nvar validate_map = new Map();\nvalidate_map.put(\"regexp\",\"validate_regexp\");\nvalidate_map.put(\"number\",\"validate_number\");\nvalidate_map.put(\"numberInt\",\"validate_numberInt\");\nvalidate_map.put(\"numberFloat\",\"validate_numberFloat\");\nvalidate_map.put(\"numberScience\",\"validate_numberScience\");\nvalidate_map.put(\"english\",\"validate_english\");\nvalidate_map.put(\"chinese\",\"validate_chinese\");\nvalidate_map.put(\"character\",\"validate_character\");\nvalidate_map.put(\"numbercharacter\",\"validate_numberOrCharacter\");\nvalidate_map.put(\"qq\",\"validate_qq\");\nvalidate_map.put(\"telephone\",\"validate_phone\");\nvalidate_map.put(\"email\",\"validate_Email\");\nvalidate_map.put(\"cellphone\",\"validate_cellPhone\");\nvalidate_map.put(\"idcard\",\"validate_IDCard\");\nvalidate_map.put(\"postal\",\"validate_postal\");\nvalidate_map.put(\"currency\",\"validate_currency\");\nvalidate_map.put(\"url\",\"validate_url\");\nvalidate_map.put(\"date\",\"validate_date\");\nvalidate_map.put(\"contrast\",\"validate_contrast\");\nvalidate_map.put(\"length\",\"validate_length\");\nvalidate_map.put(\"must\",\"validate_must\");\nvalidate_map.put(\"moreRule\",\"validate_moreRule\");\n\nif($.validator){\n    //正则类\n\t$.validator.addMethod(\"regexp\", function(value, element, regstr) {\n\t\tvar result = validate_regexp(value,regstr);\n\t\treturn (this.optional(element) || result);\n\t}, \"格式错误\");\n\t//数字类\n\t$.validator.addMethod(\"number\", function(value, element) {\n\t\tif($(element)&&(($(element).nodeName==\"input\")||($(element).nodeName==\"textarea\"))&&($(element).attr(\"foramt\"))){\n\t\t\t\n\t\t}\n \t\tvar result = validate_number(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"格式错误\");\n\t//数字类-整型\n\t$.validator.addMethod(\"numberInt\", function(value, element) {\n\t\tvar result = validate_numberInt(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"格式错误\");\n\t//数字类-浮点型\n\t$.validator.addMethod(\"numberFloat\", function(value, element) {\n\t\tvar result = validate_numberFloat(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"格式错误\");\n\t//数字类-科学计数法\n\t$.validator.addMethod(\"numberScience\", function(value, element) {\n\t\tvar result = validate_numberScience(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"格式错误\");\n\t//字符类-英文\n\t$.validator.addMethod(\"english\", function(value, element) {\n\t\tvar result = validate_english(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效英文字符\");\n\t//字符类-中文\n\t$.validator.addMethod(\"chinese\", function(value, element) {\n\t\tvar result = validate_chinese(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效中文字符\");\n\t//字符类\n\t$.validator.addMethod(\"character\", function(value, element) {\n\t\tvar result = validate_character(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效中英文字符\");\n\t//数字汉字加英文字母类\n\t$.validator.addMethod(\"numbercharacter\", function(value, element) {\n\t\tvar result = validate_numberOrCharacter(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效中英文字符或数字\");\n\t//qq类\n\t$.validator.addMethod(\"qq\", function(value, element) {\n\t\tvar result = validate_qq(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效qq号码\");\n\t//固定电话\n\t$.validator.addMethod(\"telephone\", function(value, element) {\n\t\tvar result = validate_phone(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效电话号码\");\n\t//邮箱\n\t$.validator.addMethod(\"email\", function(value, element) {\n\t\tvar result = validate_Email(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效email地址\");\n\t//手机号码\n\t$.validator.addMethod(\"cellphone\", function(value, element) {\n\t\tvar result = validate_cellPhone(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效手机号码\");\n\t//身份证号\n\t$.validator.addMethod(\"idcard\", function(value, element) {\n\t\tvar result = validate_IDCard(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效身份证号\");\n\t//邮政编码\n\t$.validator.addMethod(\"postal\", function(value, element) {\n\t\tvar result = validate_postal(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效邮政编码\");\n\t//货币格式\n\t$.validator.addMethod(\"currency\", function(value, element) {\n\t\tvar result = validate_currency(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入有效货币格式，以“$”开头\");\n\t//url连接\n\t$.validator.addMethod(\"url\", function(value, element) {\n\t\tvar result = validate_url(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的url地址 例如: http://www.163.com\");\n\t//日期类\n\t$.validator.addMethod(\"date\", function(value, element) {\n\t\tvar result = validate_date(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的日期 默认为yyyy-MM-dd\");\n\t//比较类 arg格式{>1;<4}或者{>1}\n\t$.validator.addMethod(\"contrast\", function(value, element,arg) {\n\t\tvar result = validate_contrast(value,arg);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的格式\");\n\t//字符串长度范围比较 使用样例：{1;4}\n\t$.validator.addMethod(\"length\",function(value,element,arg){\n\t\tvar result = validate_length(value,arg);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的格式\");\n\t//必录项目\n\t$.validator.addMethod(\"must\", function(value, element) {\n\t\tvar result = validate_must(value);\n\t\treturn (this.optional(element) || result);\n\t}, \"该项不能为空\");\n\t//多个校验项目共存\n\t$.validator.addMethod(\"moreRule\",function(value,element,arg){\n\t\tvar result = validate_moreRule(value,arg);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的格式\");\n\t//精度校验\n\t$.validator.addMethod(\"degree\",function(value,element,arg){\n\t\tvar result = validate_degree(value,arg);\n\t\treturn (this.optional(element) || result);\n\t}, \"请输入正确的格式\");\n\t\n\t$.validator.setDefaults({\n\t\terrorElement: \"em\",\n\t\terrorPlacement: function ( error, element ) {\n\t\t\telement.after(error);\n\t\t\tvar id = error.attr(\"id\");\n            $(\"#\"+id).addClass(\"e\");\n\t\t},\n\t\thighlight: function ( element, errorClass, validClass ) {\n\t\t\t$( element ).parents( \".col-sm-10\" ).addClass( \"has-error\" ).removeClass( \"has-success\" );\n\t\t},\n\t\tunhighlight: function (element, errorClass, validClass) {\n\t\t\t$( element ).parents( \".col-sm-10\" ).addClass( \"has-success\" ).removeClass( \"has-error\" );\n\t\t}\n\t});\n\t$.extend($.validator.messages, {\n\t\tnumber: \"请输入有效的数字\",\n\t\tnumberInt:\"请输入有效整数\",\n\t\tnumberFloat : \"请输入有效浮点数\",\n\t\tnumberScience:\"请输入有效数字\",\n\t\trequired:\"不能为空\"\n\t});\n};\n(function($) {\n\t$.fn.wingsValidate = function(options) {\n\t\tvar opts = $.extend({}, $.fn.wingsValidate.defaults, options);\n\t\tvar rules = \"\";\n\t\tvar datascore = \"\";\n\t\tvar msgscore = \"\";\n\t\tvar _tempFn =  function(i, obj) {\n\t\t\t\t\tvar data = \"\";\n\t\t\t\t\tvar msg = \"\";\n\t\t\t\t\tvar rule = $(obj).attr(\"rule\");\n \t\t\t\t\tvar zdyyz = $(obj).attr(\"zdyRule\");\n\t\t\t\t\tvar caption = $(obj).attr(\"caption\");\n\t\t\t\t\tvar name = $(obj).attr(\"name\");\n\t\t\t\t\tvar minnb = $(obj).attr(\"minnb\");\n\t\t\t\t\tvar maxnb = $(obj).attr(\"maxnb\");\n\t\t\t\t\tif (caption == undefined) {\n\t\t\t\t\t\tcaption = \"\";\n\t\t\t\t\t}\n\t\t\t\t\tif(zdyyz != undefined){\n\t\t\t\t\t\tdata +=  zdyyz+': true ,';\n\t\t\t\t\t}\n\t\t\t\t\tif (minnb != undefined) {\n\t\t\t\t\t\tdata += ' minlength: ' + minnb + ',';\n\t\t\t\t\t\tmsg += 'minlength: \"至少输入' + minnb + '个字符\" ,'\n\t\t\t\t\t}\n\t\t\t\t\tif (maxnb != undefined) {\n\t\t\t\t\t\tdata += ' maxlength: ' + maxnb + ' ,';\n\t\t\t\t\t\tmsg += ' maxlength: \"最多输入' + maxnb + '个字符\",'\n\t\t\t\t\t}\n\t\t\t\t\tif(rule){\n\t\t\t\t\t\tvar rules = $(obj).attr(\"rule\").split(\"_\");\n\t\t\t\t\t\tfor(var rule=0;rule<rules.length;rule++){\n\t\t\t\t\t\t\tif (rules[rule] == \"email\") {\n\t\t\t\t\t\t\t\tdata += ' email: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"number\") {\n\t\t\t\t\t\t\t\tdata += ' number: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"numberInt\") {\n\t\t\t\t\t\t\t\tdata += ' numberInt: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"numberFloat\") {\n\t\t\t\t\t\t\t\tdata += ' numberFloat: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"numberScience\") {\n\t\t\t\t\t\t\t\tdata += ' numberScience: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"english\") {\n\t\t\t\t\t\t\t\tdata += ' english: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"chinese\") {\n\t\t\t\t\t\t\t\tdata += ' chinese: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"character\") {\n\t\t\t\t\t\t\t\tdata += ' character: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"numbercharacter\") {\n\t\t\t\t\t\t\t\tdata += ' numbercharacter: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"qq\") {\n\t\t\t\t\t\t\t\tdata += ' qq: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"telephone\") {\n\t\t\t\t\t\t\t\tdata += ' telephone: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"email\") {\n\t\t\t\t\t\t\t\tdata += ' email: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"cellphone\") {\n\t\t\t\t\t\t\t\tdata += ' cellphone: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"idcard\") {\n\t\t\t\t\t\t\t\tdata += ' idcard: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"postal\") {\n\t\t\t\t\t\t\t\tdata += ' postal: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"currency\") {\n\t\t\t\t\t\t\t\tdata += ' currency: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"url\") {\n\t\t\t\t\t\t\t\tdata += ' url: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"date\") {\n\t\t\t\t\t\t\t\tdata += ' date: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule].indexOf(\"contrast\") != -1) {\n\t\t\t\t\t\t\t\tdata += \"contrast:'\" + rules[rule].replace(\";\",\":\").split(\":\")[1] +\"',\";\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule].indexOf(\"number(\") != -1) {\n\t\t\t\t\t\t\t\tvar tempRule = rules[rule].split(\"(\")[1].split(\",\");\n\t\t\t\t\t\t\t\tif(tempRule.length == 2){\n\t\t\t\t\t\t\t\t\tvar lengthRule =tempRule[0];\n\t\t\t\t\t\t\t\t\tvar degreeRule = tempRule[1].replace(\")\",\"\");\n\t\t\t\t\t\t\t\t\tdata += \"length:'\" + 0 + \",\" + lengthRule + \"',\";\n\t\t\t\t\t\t\t\t\tdata += \"degree:'\" + 0 + \",\" + degreeRule + \"',\";\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tif(tempRule.length == 1){\n\t\t\t\t\t\t\t\t\tvar lengthRule =tempRule[0].replace(\")\",\"\");\n\t\t\t\t\t\t\t\t\tdata += \"length:'\" + 0 + \",\" + lengthRule + \"',\";\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\tdata += \" number: true,\"\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif (rules[rule] == \"must\") {\n\t\t\t\t\t\t\t\t$(obj).attr(\"required\",\"true\")\n\t\t\t\t\t\t\t\tdata += 'must: true ,';\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tif (data != \"\") {\n\t\t\t\t\t\tdata = data.substring(0, data.length - 1);\n\t\t\t\t\t\tdatascore += name + ': {' + data + '},';\n\t\t\t\t\t}\n\t\t\t\t\tif (data != \"\") {\n\t\t\t\t\t\tmsg = msg.substring(0, msg.length - 1);\n\t\t\t\t\t\tmsgscore += name + ': {' + msg + '},';\n\t\t\t\t\t}\n\n\t\t\t\t};\n\t\t$(this).find(\"input,textarea,div\").each(function(i, obj){\n\t\t\t_tempFn(i, obj); \n\t\t} );\n\n\t\tvar newdata = datascore.substring(0, datascore.length - 1);\n\t\tvar newdmsg = msgscore.substring(0, msgscore.length - 1);\n\t\trules = '{rules:{' + newdata + '} ,messages: {' + newdmsg + '}}';\n\t\tvar obj1 = eval('(' + rules + ')');\n\t\tif (opts.errorPlacement) {\n\t\t\tobj1.errorPlacement = opts.errorPlacement;\n\t\t}\n\t\tif (opts.wingsErrorPlacement) {\n\t\t\tobj1.wingsErrorPlacement = opts.wingsErrorPlacement;\n\t\t}\n\t\tobj1.onfocusout =opts.onfocusout;\n\t\tvar valiObj = $(this).validate(obj1);\n\t\t\n\t\treturn valiObj;\n\t};\n\t$.fn.wingsValid = function() {\n\t\treturn $(this).valid();\n\n\t}\n\t$.fn.wingsValidate.defaults = {\n\t\t onfocusout: function(element){\n\t\t\t $(element).valid();\n\t\t },\n\t\t errorPlacement:function(error, element){\n\t\t\telement.after(error)\n\t\t\tvar errobj = $(\"#\"+error.attr(\"id\"))\n\t\t\tif(errobj){\n\t\t\t    errobj.addClass(\"e\");\n\t\t\t}\n\t\t },\n\t\t wingsErrorPlacement:function(error, element){\n\t\t\tvar errobj = $(\"#\"+error.attr(\"id\"))\n\t\t\tif(errobj){\n\t\t\t    errobj.addClass(\"e\");\n\t\t\t    errobj.click(function(){\n\t\t\t    \terrobj.hide();\n\t\t\t    })\n\t\t\t    //处理位置\n\t\t\t    var height = errobj.css(\"height\");\n\t\t\t    errobj.append(\"<div class ='erroe_wings_sj' style='top:\"+height+\";'></div>\")\n\t\t\t    errobj.css(\"top\",\"-\" + height);\n\t\t\t    var inputOffset = element.offset();\n\t\t        if(error.css(\"display\")===\"none\"){\n\t\t            error.show();\n\t\t        }\n\n\t\t\t    error.offset({top:inputOffset.top-25,left:inputOffset.left});\n\t\t\t}\n\t\t }\n\t\t           \n\t\t \n\t}\n})(window.jQuery);\n\n//校验方法集合开始\n//正则校验\nfunction validate_regexp(value,regStr){\n\tvar reg = new RegExp(regStr);\n\treturn reg.test(value);\n}\n//数字校验\nfunction validate_number(value){\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif((value.startWith(\",\"))||(value.endWith(\",\"))){\n\t\treturn false;\n\t}\n\tvar realValue = formatNumber(value);\n\tvar reg_One=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\tvar reg_Second = new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\tvar reg_Three = new RegExp(\"^(-?\\\\d+)(\\\\.\\\\d+)$\");\n\treturn (reg_One.test(realValue)) || (reg_Second.test(realValue)) ||(reg_Three.test(realValue));\n}\n//数字整型校验\nfunction validate_numberInt(value){\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif((value.startWith(\",\"))||(value.endWith(\",\"))){\n\t\treturn false;\n\t}\n\tvar realValue = formatNumber(value);\n\tvar reg=new RegExp(\"^([0]|(-?)[1-9])[0-9]{0,}$\");\n\treturn reg.test(value);\n}\n//数字浮点校验\nfunction validate_numberFloat(value){\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif((value.startWith(\",\"))||(value.endWith(\",\"))){\n\t\treturn false;\n\t}\n\tvar realValue = formatNumber(value);\n\tvar reg=new RegExp(\"^(-?\\\\d+)(\\\\.\\\\d+)$\");\n\treturn reg.test(value);\n}\n//数字科学计数校验\nfunction validate_numberScience(value){\n\tvar reg=new RegExp(\"^((\\\\d+.?\\\\d+)[Ee]{1}(-?\\\\d+))$\");\n\treturn reg.test(value);\n}\n//英文校验\nfunction validate_english(value){\n\tvar reg=new RegExp(\"^[A-Za-z]+$\");\n\treturn reg.test(value);\n}\n//中文校验\nfunction validate_chinese(value){\n\tvar reg=new RegExp(\"^[\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//中英文校验\nfunction validate_character(value){\n\tvar reg=new RegExp(\"^[A-Za-z\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//数字加中英文\nfunction validate_numberOrCharacter(value){\n\tvar reg=new RegExp(\"^[0-9A-Za-z\\u4e00-\\u9fa5]+$\");\n\treturn reg.test(value);\n}\n//qq\nfunction validate_qq(value){\n\tvar reg=new RegExp(\"[1-9][0-9]{4,9}$\");\n\treturn reg.test(value);\n}\n//固定电话\nfunction validate_phone(value){\n\tvar reg=new RegExp(\"^\\\\d{3}-\\\\d{8}|\\\\d{4}-\\\\d{7}$\");\n\treturn reg.test(value);\n}\n//邮箱\nfunction validate_Email(value){\n\tvar reg=new RegExp(\"^\\\\w+([-+.]\\\\w+)*@\\\\w+([-.]\\\\w+)*.\\\\w+([-.]\\\\w+)*$\");\n\treturn reg.test(value);\n}\n//手机号码\nfunction validate_cellPhone(value){\n\tvar reg=new RegExp(\"^1[3|4|5|7|8][0-9]\\\\d{8}$\");\n\treturn reg.test(value);\n}\n//身份证号\nfunction validate_IDCard(value){\n\tvar reg=new RegExp(\"^(\\\\d{15}$|^\\\\d{17}(\\\\d|X|x))$\");\n\treturn reg.test(value);\n}\n//邮政编码\nfunction validate_postal(value){\n\tvar reg=new RegExp(\"^[0-9]{6}$\");\n\treturn reg.test(value);\n}\n//货币格式\nfunction validate_currency(value){\n\tvar reg=new RegExp(\"^\\\\$[0-9]{1,}$\");\n\treturn reg.test(value);\n}\n//url链接\nfunction validate_url(value){\n\tvar reg=new RegExp(\"^http://([\\\\w-]+\\\\.)+[\\\\w-]+(/[\\\\w-./?%&=]*)?$\");\n\treturn reg.test(value);\n}\n//日期\nfunction validate_date(value){\n\tvar reg=new RegExp(\"[0-9]{4}-([0][1-9]|[1][0-2])-([0][1-9]|[1|2][0-9]|[3][0|1])$\");\n\treturn reg.test(value);\n}\n//比较\nfunction validate_contrast(value,arg){\n\tvar result = false;\n\tif(value.indexOf(\",,\") != -1){\n\t\treturn false;\n\t}\n\tif((value.startWith(\",\"))||(value.endWith(\",\"))){\n\t\treturn false;\n\t}\n\tvar realValue = formatNumber(value);\n\tif(validate_number(realValue)){\n\t\tvar ant = realValue+arg;\n\t\tif(eval(ant)){\n\t\t\tresult = true\n\t\t}\n\t}\n\treturn result;\n}\n//长度 \nfunction validate_length(value,arg){\n\tif(!value){\n\t\tvalue = \"\";\n\t}\n\tif(!arg){\n\t\targ = \"\";\n\t}\n\tvar intValue = value.split(\".\")[0]\n\tvar realValue = formatNumber(intValue);\n\tvar result = false;\n\tvar arr = arg.split(\",\");\n\tvar minLength = parseInt(arr[0]);\n\tvar maxLength = parseInt(arr[1]);\n\tif(realValue < 0){\n\t\tminLength = eval(minLength + 1);\n\t\tmaxLength = eval(maxLength + 1);\n\t}\n\tif(arr.length == 1){\n\t\tif(realValue.length >= minLength){\n\t\t\tresult = true;\n\t\t}\n\t}else if(arr.length == 2){\n\t\tif((realValue.length >= minLength)&&(realValue.length <= maxLength)){\n\t\t\tresult = true;\n\t\t}\n\t}\n\treturn result;\n}\n//精度 \nfunction validate_degree(value,arg){\n\tif(!value){\n\t\tvalue = \".\";\n\t}\n\tif(!arg){\n\t\targ = \"\";\n\t}\n\tif(value.indexOf(\".\") == -1){\n\t\tvalue = value + \".\";\n\t}\n\tvar result = false;\n\tvar realValue = value.split(\".\")[1];\n\tvar arr = arg.split(\",\");\n\tif(arr.length == 1){\n\t\tif(realValue.length >= arr[0]){\n\t\t\tresult = true;\n\t\t}\n\t}else if(arr.length == 2){\n\t\tif((realValue.length >= arr[0])&&(realValue.length <= arr[1])){\n\t\t\tresult = true;\n\t\t}\n\t}\n\treturn result;\n}\n//必填项\nfunction validate_must(value){\n\tvar result = false;\n\tif(value != \"\"){\n\t\tresult = true;\n\t}\n\treturn result;\n}\n//多个校验\nfunction validate_moreRule(value,arg){\n\tif(!value){\n\t\tvalue = \"\";\n\t}\n\tif(!arg){\n\t\targ = \"\";\n\t}\n\tvar result = false;\n\tvar rule_Arr = arg.split(\"_\");\n\tif(rule_Arr.length > 0 ){\n\t\tfor(var i=0;i<rule_Arr.length;i++){\n\t\t\tcur_validate = rule_Arr[i];\n\t\t\tvar reg = new RegExp(\"[`~!@#$^&*()=|{}':;',\\\\[\\\\].<>/?~！@#￥……&*（）——|{}【】‘；：”“'。，、？]\"); \n\t\t\tif(reg.test(cur_validate)){\n\t\t\t\tif(cur_validate.indexOf(\"contrast\") != -1){\n\t\t\t\t\tresult = validate_contrast(value,cur_validate);\n\t\t\t\t\tif(!result){\n\t\t\t\t\t\treturn result;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}else{\n\t\t\t\tif(cur_validate.indexOf(\"regexp\") != -1){\n\t\t\t\t\tresult = validate_regexp(value,cur_validate);\n\t\t\t\t\tif(!result){\n\t\t\t\t\t\treturn result;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(cur_validate.indexOf(\"length\") != -1){\n\t\t\t\t\tresult = validate_length(value,cur_validate);\n\t\t\t\t\tif(!result){\n\t\t\t\t\t\treturn result;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif(validate_map.get(cur_validate)){\n\t\t\t\t\tresult = eval(validate_map.get(cur_validate) + \"(\" + value + \")\");\n\t\t\t\t\tif(!result){\n\t\t\t\t\t\treturn result;\n\t\t\t\t\t}\n\t\t\t\t}\t\t\t\n\t\t\t}\n\t\t}