opts.cache.data.trs, halfPageCacheDatas.data[0].trs);\n\t\t\t\t\t\t\t\topts.ajax.success(halfPageCacheDatas,halfData);\n\t\t\t\t\t\t\t\topts.loding&&wingsPageLoading.hide();\n\t\t\t\t\t\t\t\tpaging.refreshInfo();\n\t\t\t\t\t\t\t\t\n\t\t\t\t        }\n\t\t\t\t    }\n\t\t\t\t}\n\t\t\t}\n\t\t\t// ============== 适配  jsCtrlMode======================================== \n\t\t\telse{\n\t\t\t\t\n\t\t\t\t$.ajax({\n\t//\t\t\t\turl:opts.ajax.url,\n\t\t\t\t\turl:tempUrl,\n\t\t\t\t\tmethod:opts.ajax.method,\n\t\t\t\t\tasync:opts.ajax.async,\n\t\t\t\t\tdata:{\"postData\":postData},\n\t\t\t\t\tdataType:'json',\n\t\t\t\t\twingsSubmitAjax:true,\n\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t\n\t\t\t\t\t  var resData = null;\n\t          var columns =  data.data.filter(function(item,i,array){\n\t            if(item.name == opts.gridName){\n\t              return true;\n\t            }\n\t          });\n\t          if(columns.length<=0){\n\t            alert(\"排序方法返回的table数据key应为333：\"+opts.gridName);\n\t          }else{\n\t            resData = columns[0];\n\t          }\n\t\t\t\t\t\tif(data!=null&&resData.totalRows!=null){\n\t\t\t\t\t\t\tpaging.setTotalRows(resData.totalRows)\n\t\t\t\t\t\t}\n\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t});\n\t\t\t\t\t\tvar halfPageCacheDatas = {data:[{trs:[]}]}; \n\t\t\t\t\t\tvar noInsertIndex = 0;\n\t\t\t\t\t\tvar halfData = [];\n\t\t\t\t\t\t$(opts.cache.data.trs).each(function(i,e){\n\t\t\t\t\t\t\tif(e.pageNum == opts.pageNum){\n\t\t\t\t\t\t\t\tif(e.status!='insert'){\n\t\t\t\t\t\t\t\t\tnoInsertIndex++;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\thalfPageCacheDatas.data[0].trs.push(e);\n\t\t\t\t\t\t\t\thalfData.push(e);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t\t$(opts.cache.data.trs).each(function(i,e){\n\t\t\t\t\t\t\tif(e.pageNum==paging.getPageNum()){\n\t\t\t\t\t\t\t\tvar index = opts.cache.data.trs.indexOf(e);\n\t\t\t\t\t\t\t\topts.cache.data.trs.splice(index,1);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t\tfor(var dataI=noInsertIndex;dataI<resData.trs.length;dataI++){\n\t\t\t\t\t\t\thalfPageCacheDatas.data[0].trs.push(resData.trs[dataI]);\n\t\t\t\t\t\t}\n\t\t\t\t\t\t//往缓存里写数据\n\t\t\t\t\t\t$.merge(opts.cache.data.trs, halfPageCacheDatas.data[0].trs);\n\t\t\t\t\t\topts.ajax.success(halfPageCacheDatas,halfData);\n\t\t\t\t\t\topts.loding&&wingsPageLoading.hide();\n\t\t\t\t\t\tpaging.refreshInfo();\n\t\t\t\t\t},\n\t\t\t\t\terror:function(e,info){\n\t\t\t\t\t\talert(info);\n\t\t\t\t\t\topts.loding&&wingsPageLoading.hide();\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\n\t\t\t}\n\t\t}\n\t\tthis.changeSize = function(){\n\t\t\tvar param = opts.ajax.param;\n\t\t\tvar data ={\"ctrl\":opts.ajax.url,\"pageNum\":parseInt(opts.pageNum),\"rows\":opts.pageSize};\n\t\t\tfor(var i in param){\n\t\t\t\tdata[i] = param[i];\n\t\t\t}\n\t\t\tvar postData = JSON.stringify(data);\n\t\t\t\n\t\t\t//为追加token值 【lei】\n\t\t\tvar tempUrl = opts.ajax.url;\t\n\t\t\tif(tempUrl){\n\t\t\t\tif(tempUrl.indexOf('?')==-1){\n\t\t\t\t\ttempUrl += '?1=1';\n\t\t\t\t}\n\t\t\t\t//如果有值，才设置\n\t\t\t\tif (\"undefined\" != typeof $wings_url_tokenName_store && \"undefined\" != typeof store ){\n\t\t\t\t\t//从store中获得值，设置安全用的 token\n\t\t\t\t\tvar urlValue =  store.get($wings_url_tokenName_store);\n\t\t\t\t\tif(urlValue && urlValue != ''){\n\t\t\t\t\t\ttempUrl += \"&\"+ $wings_url_tokenName_store + \"=\" + urlValue;\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t}\n\t\t\t// ============== 适配  jsCtrlMode======================================== \n\t\t\tif (\"undefined\" != typeof $wings_param_isSwordAction && $wings_param_isSwordAction == 'jsCtrlModel') {\n\t\t\t\t//纯jsCtrl模式,默认走最下方逻辑\n\t\t\t\t\n\t\t\t\t//处理参数\n\t\t\t\tvar jsData = data;\n\t\t\t\t\n\t\t\t\t//jsCtrlMode   \n\t\t\t\t//追加js名称map，防止重复引用js\n\t\t\t\tvar jsUrl = tempUrl; ///demoCtrl/leiCtrl.js?method=leiText001\n\t\t\t\t//1.解析路径\n\t\t\t\tvar arr = jsUrl.split(\"?\");\n\t\t\t\tif(!arr || arr.length < 2){\n\t\t\t\t\tWingsDialog.alert(\"提示\",'没有找到js或ctrl方法');\n\t\t\t\t\treturn;\n\t\t\t\t};\n\t\t\t\tvar jsFile = arr[0];\n\t\t\t\tvar ctrlFn =  arr[1].replace('method=','');\n\t\t\t\tif(jsFile == '' || ctrlFn == ''){\n\t\t\t\t\tWingsDialog.alert(\"提示\",'没有找到js或ctrl方法');\n\t\t\t\t\treturn;\n\t\t\t\t};\n\t\t\t\t//alert( jsFile+ \"  \" + ctrlFn);\n\t\t\t\t//2.加载  \n\t\t\t\tif(jsCtrlMap.get(jsFile) == \"true\"){\n\t\t\t\t\t//已存在\n\t\t            //执行后续方法\n\t\t            var req = new WingsReqData(jsData);\n\t\t            var res;\n\t\t            var ctrlFunc = eval(ctrlFn);\n\t\t\t\t\tif (typeof ctrlFunc == \"function\") {\n\t\t\t\t\t\tres = ctrlFunc(req);\n\t\t\t\t\t}\n\t\t            \n\t\t//\t\t\t\t\t\t// 成功\n\t\t\t\t\t var allData = res;\n\t\t\t\t\t  var resData = null;\n\t          var columns =  allData.data.filter(function(item,i,array){\n\t            if(item.name == opts.gridName){\n\t              return true;\n\t            }\n\t          });\n\t          if(columns.length<=0){\n\t            alert(\"排序方法返回的table数据key应为：\"+opts.gridName);\n\t          }else{\n\t            resData = columns[0];\n\t          }\n\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//往缓存里写数据\n\t\t\t\t\t\t$.merge(opts.cache.data.trs, resData.trs);\n\t\t\t\t\t\topts.changeSizeCallback(allData);\n\t\t\t\t\t\topts.pagingCallback();\n\t\t\t\t\t\t\t\t\n\t\t\t\t    \n\t\t\t\t    \n\t\t\t\t}else{\n\t\t\t\t\tvar firstUrl = '';\n\t\t\t\t\tif (\"undefined\" != typeof cdnurl ){\n\t\t\t\t\t\tfirstUrl = cdnurl;\n\t\t\t\t\t};\n\t\t\t\t\t//追加js文件\n\t\t    \t\tvar loadScript=document.createElement('script');\n\t\t    \t\tloadScript.setAttribute(\"type\",\"text/javascript\");\n\t\t    \t\tloadScript.setAttribute('src',firstUrl  + jsFile);\n\t\t    \t\tdocument.head.appendChild(loadScript); //TODO ie11 可能有问题\n\t\t    \t\t//记录已追加\n\t\t\t\t\tjsCtrlMap.put(jsFile,\"true\");\n\t\t\t\t\t\n\t\t\t\t\t//文件加载后执行方法\n\t\t\t\t    if(navigator.userAgent.indexOf(\"IE\") >=0){\n\t\t\t\t        //IE下的事件\n\t\t\t\t        loadScript.onreadystatechange=function(){\n\t\t\t\t            if(loadScript && (loadScript.readyState == \"loaded\" || loadScript.readyState == \"complete\")){\n\t\t\t\t                //表示加载成功\n\t\t\t\t                loadScript.onreadystatechange=null;\n\t\t\t\t                //执行后续方法\n\t\t\t\t                var req = new WingsReqData(jsData);\n\t\t\t\t                var ctrlFunc = eval(ctrlFn);\n\t\t\t\t\t\t\t\tif (typeof ctrlFunc == \"function\") {\n\t\t\t\t\t\t\t\t\tvar res = ctrlFunc(req);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t                \n\t\t//\t\t\t\t\t\t// 成功\n\t\t\t\t\t var allData = res;\n\t\t\t\t\t  var resData = null;\n\t          var columns =  allData.data.filter(function(item,i,array){\n\t            if(item.name == opts.gridName){\n\t              return true;\n\t            }\n\t          });\n\t          if(columns.length<=0){\n\t            alert(\"排序方法返回的table数据key应为：\"+opts.gridName);\n\t          }else{\n\t            resData = columns[0];\n\t          }\n\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//往缓存里写数据\n\t\t\t\t\t\t$.merge(opts.cache.data.trs, resData.trs);\n\t\t\t\t\t\topts.changeSizeCallback(allData);\n\t\t\t\t\t\topts.pagingCallback();\n\t\t\t\t\t\t\t\t\n\t\t\t\t                \n\t\t\t\t            }\n\t\t\t\t        }\n\t\t\t\t    }\n\t\t\t\t    else{\n\t\t\t\t        loadScript.onload=function(){\n\t\t\t\t            loadScript.onload=null;\n\t\t\t                //执行后续方法\n\t\t\t                var req = new WingsReqData(jsData);\n\t\t\t                var ctrlFunc = eval(ctrlFn);\n\t\t\t\t\t\t\tif (typeof ctrlFunc == \"function\") {\n\t\t\t\t\t\t\t\tvar res = ctrlFunc(req);\n\t\t\t\t\t\t\t}\n\t\t\t                // 成功\n\t\t\t\t\t var allData = res;\n\t\t\t\t\t  var resData = null;\n\t          var columns =  allData.data.filter(function(item,i,array){\n\t            if(item.name == opts.gridName){\n\t              return true;\n\t            }\n\t          });\n\t          if(columns.length<=0){\n\t            alert(\"排序方法返回的table数据key应为：\"+opts.gridName);\n\t          }else{\n\t            resData = columns[0];\n\t          }\n\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//往缓存里写数据\n\t\t\t\t\t\t$.merge(opts.cache.data.trs, resData.trs);\n\t\t\t\t\t\topts.changeSizeCallback(allData);\n\t\t\t\t\t\topts.pagingCallback();\n\t\t\t\t\t\t\t\t\n\t\t\t\t        }\n\t\t\t\t    }\n\t\t\t\t}\n\t\t\t}\n\t\t\t// ============== 适配  jsCtrlMode======================================== \n\t\t\telse{\n\t\t\t\t\n\t\t\t\t$.ajax({\n\t\t\t\t\turl:tempUrl,\n\t\t\t\t\tmethod:opts.ajax.method,\n\t\t\t\t\tasync:opts.ajax.async,\n\t\t\t\t\tdata:{\"postData\":postData},\n\t\t\t\t\tdataType:'json',\n\t\t\t\t\twingsSubmitAjax:true,\n\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t  var resData = null;\n\t          var columns =  data.data.filter(function(item,i,array){\n\t            if(item.name == opts.gridName){\n\t              return true;\n\t            }\n\t          });\n\t          if(columns.length<=0){\n\t            alert(\"排序方法返回的table数据key应为：\"+opts.gridName);\n\t          }else{\n\t            resData = columns[0];\n\t          }\n\t\t\t\t\t\t//分页后台返回数据加页标签\n\t\t\t\t\t\t$(resData.trs).each(function(i,e){\n\t\t\t\t\t\t\te.pageNum = opts.pageNum;\n\t\t\t\t\t\t\te.index = (opts.pageNum-1)*opts.pageSize+i+1;\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//往缓存里写数据\n\t\t\t\t\t\t$.merge(opts.cache.data.trs, resData.trs);\n\t\t\t\t\t\topts.changeSizeCallback(data);\n\t\t\t\t\t\topts.pagingCallback();\n\t\t\t\t\t},\n\t\t\t\t\terror:function(e,info){\n\t\t\t\t\t\talert(info);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t\n\t\t\t}\n\t\t\t\n\t\t\t\n\t\t}\n\t\tthis.setTotalRows = function(totalRows){\n\t\t\topts.totalRows = totalRows;\n\t\t\tif(totalRows!=0){\n\t\t\t\tvar ttp = 0;\n\t\t\t\tif ((totalRows % opts.pageSize) == 0) { \n\t\t\t\t\tttp = totalRows / opts.pageSize; \n\t\t\t\t} else { \n\t\t\t\t\tttp = Math.floor(totalRows / opts.pageSize) + 1; \n\t\t\t\t}\n\t\t\t\topts.totalPages = ttp;\n\t\t\t}\n\t\t}\n\t\tthis.setPageSize = function(pagSize){\n\t\t\topts.pageSize = pagSize;\n\t\t}\n\t\tthis.setPageNum = function(pageNum){\n\t\t\topts.pageNum = pageNum;\n\t\t}\n\t\tthis.getTotalRows = function(){\n\t\t\treturn  opts.totalRows;\n\t\t}\n\t\tthis.getTotalPages = function(){\n\t\t\treturn  opts.totalPages;\n\t\t}\n\t\tthis.getPageNum = function(){\n\t\t\treturn  opts.pageNum;\n\t\t}\n\t\tthis.getPageSize = function(){\n\t\t\treturn  opts.pageSize;\n\t\t}\n\t\tthis.setCache = function(cache){\n//\t\t\t$.extend(true,opts.cache.data,cache); \n\t\t\topts.cache.data = cache;\n\t\t}\n\t\tthis.getCache = function(index){\n\t\t\tif(index==null){\n\t\t\t\treturn opts.cache.data;\n\t\t\t}else{\n\t\t\t\tvar curNum = 0;\n\t\t\t\tvar obj = null;\n\t\t\t\tif(opts.cache.data!=null){\n\t\t\t\t\t$(opts.cache.data.trs).each(function(i,e){\n\t\t\t\t\t\tif(e.pageNum==paging.getPageNum()){\n\t\t\t\t\t\t\tif(curNum == index){\n\t\t\t\t\t\t\t\tobj = e;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tcurNum = curNum+1;\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\treturn obj;\n\t\t\t}\n\t\t}\n\t\tthis.refreshInfo =function(){\n\t\t\tpaging.setTotalRows(opts.totalRows);\n\t\t\tvar $last = $(\"#\"+$paging.prop('id')).find('a.previous');\n\t\t\tvar $next = $(\"#\"+$paging.prop('id')).find('a.next');\n\t\t\tvar $home = $(\"#\"+$paging.prop('id')).find('a.home');\n\t\t\tvar $end = $(\"#\"+$paging.prop('id')).find('a.end');\n\t\t\t$(\"#\"+paging.attr('id')+'_info_totalrows').text(opts.totalRows);\n\t\t\t$(\"#\"+paging.attr('id')+'_info_pageSize_input').val(this.getPageSize());\n\t\t\t$(\"#\"+paging.attr('id')+'_info_pageSize').children().each(function(i,item){\n        if(Number(item.innerHTML) >= Number(opts.pageSize)){\n          item.selected = true;\n          return false;\n        }else{\n          item.selected = false;\n        }\n      });\n\t\t\t$(\"#\"+paging.attr('id')+'_info_pagenum').text(opts.pageNum);\n\t\t\t$(\"#\"+paging.attr('id')+'_info_totalpage').text(opts.totalPages);\n\t\t\t$(\"#\"+paging.attr('id')+'_info_startNum').text((opts.pageNum-1)*opts.pageSize+1);\n\t\t\t$(\"#\"+paging.attr('id')+'_info_endNum').text(opts.pageNum*opts.pageSize);\n\t\t\tcreatePageDetail();\n\t\t\tif(opts.pageNum==1){\n\t\t\t\t$last.attr(\"disabled\",true);\n\t\t\t\t$last.addClass(\"disabled\");\n\t\t\t\t$home.attr(\"disabled\",true);\n\t\t\t\t$home.addClass(\"disabled\");\n\t\t\t}else{\n\t\t\t\t$last.attr(\"disabled\",false);\n\t\t\t\t$last.removeClass(\"disabled\");\n\t\t\t\t$home.attr(\"disabled\",false);\n\t\t\t\t$home.removeClass(\"disabled\");\n\t\t\t}\n\t\t\tif(opts.pageNum>=opts.totalPages){\n\t\t\t\topts.pageNum = opts.totalPages;\n\t\t\t\t$next.attr(\"disabled\",true);\n\t\t\t\t$next.addClass(\"disabled\");\n\t\t\t\t$end.attr(\"disabled\",true);\n\t\t\t\t$end.addClass(\"disabled\");\n\t\t\t}else{\n\t\t\t\t$next.attr(\"disabled\",false);\n\t\t\t\t$next.removeClass(\"disabled\");\n\t\t\t\t$end.attr(\"disabled\",false);\n\t\t\t\t$end.removeClass(\"disabled\");\n\t\t\t}\n\t\t}\n\t\tthis.setOptions = function(opts1){\n\t\t\topts = $.extend({},opts,opts1);\n\t\t}\n\t\tthis.getOptions = function(){\n\t\t\treturn opts;\n\t\t}\n\t\tthis.destroy = function(){\n\t\t  var event = {\n\t\t    blur:1,\n\t\t    change:1,\n\t\t    keydown:1\n\t\t  };\n\t\t  $(\"#\"+paging.attr('id')+'_form').find(\"*\").each(function(i,e){\n\t\t    $(e).off(event);\n\t\t    $(e).remove();\n\t\t  });\n\t\t  for(var i in this){\n\t\t    this[i] = null;\n\t\t  }\n\t\t}\n\t\tthis.getAfterPagingNum = function(index){\n\t\t\treturn getAfterPagingNum(index);\n\t\t};\n\t\tthis.refreshInfo();\n\t\treturn this;\n\t\tfunction createPaging(){\n\t\t\tvar $pagingForm = $('<form id=\"'+paging.attr('id')+'_form\" ></form>')\n//\t\t\tvar $infoDiv = $('<div class=\"dataTables_info\">每页<span><a id=\"'+paging.attr('id')+'_info_pagesize\">0</a></span>条，共 <span id=\"'+paging.attr('id')+'_info_totalrows\">0</span>条</div>');\n\t\t\tvar $infoDiv = $('<div class=\"dataTables_info\">显示第 <span id=\"'+paging.attr('id')+'_info_startNum\">0</span> 到 <span id=\"'+paging.attr('id')+'_info_endNum\">0</span> 条结果，共 <span class=\"wingsGrid_info_totalrows\" id=\"'+paging.attr('id')+'_info_totalrows\">0</span>条</div>')\n\t\t\tvar $pagingDiv = $('<div class=\"dataTables_paginate\" style=\"float:right;\"></div>');\n\t\t\tvar $homeA = $('<a class=\"paginate_button home disabled\">首页</a>');\n\t\t\tvar $lastPageA = $('<a class=\"paginate_button previous disabled\">上一页</a>');\n\t\t\tvar $pageDetail = $('<span id=\"'+paging.attr('id')+'_info_pageDetail\"></span>');\n\t\t\tvar $nextPageA = $('<a class=\"paginate_button next\">下一页</a>');\n\t\t\tvar $endA = $('<a class=\"paginate_button end\">末页</a>');\n\t\t\tvar $pageinfoDiv = $('<div class=\"dataTables_info\">当前第<span id=\"'+paging.attr('id')+'_info_pagenum\">0</span>页,总共<span id=\"'+paging.attr('id')+'_info_totalpage\">0</span>页</span></div>');\n\t\t\tvar $pageSizeInfo = $('<span class=\"dataTables_length\">每页显示  <label id=\"'+paging.attr('id')+'_info_pageSize_label\"><select id=\"'+paging.attr('id')+'_info_pageSize\"></select></label>条记录</span>')\n\t\t\tvar $runToPage = $('<span class=\"dataTables_length\">跳转至<label><input name=\"'+paging.attr('id')+'_info_runtopage\" type=\"text\" id=\"'+paging.attr('id')+'_info_runtopage\" rule=\"numberInt\" required=\"true\" size=\"3\" /></label>页</span>')\n\t\t\tif(opts.pageType.indexOf(\"full\")!=-1){\n\t\t\t\t$pagingDiv.append($homeA);\n\t\t\t\t$homeA.on('click',function(e){\n\t        if(!$(this).attr('disabled')){\n\t          paging.paging(1);\n\t        }