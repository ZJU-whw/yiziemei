          "content": {
            "size": 8657,
            "mimeType": "text/javascript",
            "compression": 6054,
            "text": "var _data;\n//打开方式 0：iframeq嵌入；1：addTabelLocal\nvar _dkfs;\n\nfunction getWbxtUrlByWbxylx(wbxtlx, wbxtbm, swjgDm, tygzpt, data, dkfs) {\n    _data = data;\n    _dkfs = isNull(dkfs) ? \"0\" : dkfs;\n    //默认为省局\n    var tygzptTemp = isNull(tygzpt) ? \"1\" : tygzpt;\n    switch (wbxtlx) {\n        case \"0\":\n            getWbxtUrl(wbxtbm, \"00000000000\");\n            break;\n        case \"1\":\n            var wbxtswjgDm = getWbxtswjgDmBySwjgDm(swjgDm);\n            getWbxtUrl(wbxtbm, wbxtswjgDm);\n            break;\n        case \"2\":\n            var wbxtswjgDm = (\"0\" == tygzptTemp) ? \"00000000000\" : getWbxtswjgDmBySwjgDm(swjgDm);\n            if (\"0\" == tygzptTemp) {\n                //总局统一工作平台\n                getWbxtUrl(wbxtbm, \"00000000000\");\n            } else {\n                //省局统一平台会被总参三单点登录拦截，需要特殊处理\n                var wbxtswjgDm = getWbxtswjgDmBySwjgDm(swjgDm);\n                getWbxtUrl2(wbxtbm, wbxtswjgDm);\n            }\n            break;\n        default:\n            getWbxtUrl(wbxtbm, \"00000000000\");\n    }\n}\n\nfunction getWbxtswjgDmBySwjgDm(swjgDm) {\n    //var swjgTemp1 = isNull(zgswskfjDm) ? zgswjDm : zgswskfjDm;\n    var swjgTemp = swjgDm.substring(0, 5);\n    var arr = [\"12102\", \"13302\", \"13502\", \"13702\", \"14403\"];\n    var wbxtswjgDm;\n    if (arr.includes(swjgTemp)) {\n        wbxtswjgDm = swjgTemp + \"000000\";\n    } else {\n        wbxtswjgDm = swjgDm.substring(0, 3) + \"00000000\";\n    }\n    return wbxtswjgDm;\n}\n\n\n//查询外部系统功能地址\n\nfunction getWbxtUrl(wbxtbm, wbxtswjgDm) {\n    _data.wbxtswjgDm = wbxtswjgDm;\n    var sub = new WingsSubmit();\n    sub.setCtrl(\"DhcxCtrl_queryWbxtUrlByMenuCode\");\n    sub.pushData(\"wbxtbm\", wbxtbm);\n    sub.pushData(\"swjgDm\", wbxtswjgDm);\n    sub.setFunction(\"onSuccess\", \"setWbxtUrl()\");\n    sub.setFunction(\"onError\", \"loadErrorPageIframe()\");\n    sub.setFunction(\"onException\", \"loadErrorPageIframe()\");\n    sub.submit();\n}\n\nfunction setWbxtUrl(res) {\n    var temp = res.getAttr(\"wbxtUrl\");\n    var wbxtUrl = jQuery.parseJSON(temp);\n    if (isNull(wbxtUrl)) {\n        if (\"0\" == _dkfs) {\n            loadErrorPageIframe();\n        } else {\n            WingsDialog.alertWrong(\"未能正确获取纳税人所在地区页面链接信息，请联系运维人员解决。\");\n        }\n    } else {\n        var external_system_code = wbxtUrl.externalSystemCode;\n        var sub_app_address = wbxtUrl.subAppAddress;\n        var sub_app_url = wbxtUrl.subAppUrl;\n        var external_system_name = wbxtUrl.externalSystemName;\n        var urlData = {\n            \"id\": \"YPTJK_YHS\",//固定\n            \"rUUid\": _data.djxh,//随机\n            \"zndm\": _data.zndm,\n            \"gndm\": _data.gndm,\n            \"gwssswjg\": _data.gwssswjg,\n            \"gwxh\": _data.gwxh,\n            \"gt3zyydm\": _data.gt3zyydm,\n            \"gt3ywfldm\": _data.gt3ywfldm,\n            \"gbiSage\": \"CUR\",//固定\n            \"djxh\": _data.djxh,\n            \"ywdm\": external_system_code,\n            \"tjrqq\": _data.tjrqq,//统计日期起\n            \"tjrqz\": _data.tjrqz,//统计日期止\n            \"nsrsbh\": _data.nsrsbh,\n            \"nsrmc\": _data.nsrmc,\n            \"ssjswjgDm\": _data.wbxtswjgDm\n        }\n        var sau = replaceUrlParams(sub_app_url, urlData);\n        var url = sub_app_address + sau;\n        if (\"0\" == _dkfs) {\n            $(\"#pageiframe\").attr(\"src\", url);\n        } else {\n            addTabItemLocal2(url, \"\", external_system_name, \"dhcx\" + new Date());\n        }\n    }\n}\n\n//查询外部系统功能地址2\nfunction getWbxtUrl2(wbxtbm, wbxtswjgDm) {\n    var sub = new WingsSubmit();\n    sub.setCtrl(\"DhcxCtrl_queryWbxtUrlByMenuCode\");\n    sub.pushData(\"wbxtbm\", wbxtbm);\n    sub.pushData(\"swjgDm\", wbxtswjgDm);\n    sub.setFunction(\"onSuccess\", \"setWbxtUrl2()\");\n    sub.setFunction(\"onError\", \"WingsSubmit_onError()\");\n    sub.setFunction(\"onException\", \"WingsSubmit_onError()\");\n    sub.submit();\n}\n\n//经过统一工作平台处理\nfunction setWbxtUrl2(res) {\n    var temp = res.getAttr(\"wbxtUrl\");\n    var wbxtUrl = jQuery.parseJSON(temp);\n    if (isNull(wbxtUrl)) {\n        if (\"0\" == _dkfs) {\n            loadErrorPageIframe();\n        } else {\n            WingsDialog.alertWrong(\"未能正确获取纳税人所在地区页面链接信息，请联系运维人员解决。\");\n        }\n\n    } else {\n        var sub_app_address = wbxtUrl.subAppAddress;\n        var sub_app_url = wbxtUrl.subAppUrl;\n        // 增加统一工作平台门户\n        var tygzpt_address = wbxtUrl.tygzptAddress;\n        var external_system_name = wbxtUrl.externalSystemName;\n        var data = {\n            \"djxh\": _data.djxh,\n            \"nsrsbh\": _data.nsrsbh,\n            \"nsrmc\": _data.nsrmc\n        }\n        var id = \"DHCX_WBXT\" + new Date();\n        //路径\n        var urlTemp = replaceUrlParams(sub_app_url, data);\n        //域名+路径\n        var hostUrl = sub_app_address + urlTemp;\n        var url = window.btoa(encodeURI(hostUrl));\n        var ywUrl = tygzpt_address + \"/sword?ctrl=MH001LoginCtrl_requestMhmrsy&requestYwUrl=\" + url;\n\n        if (\"0\" == _dkfs) {\n            $(\"#pageiframe\").attr(\"src\", ywUrl);\n        } else {\n            addTabItemLocal2(ywUrl, \"\", external_system_name, id + new Date());\n        }\n\n    }\n}\n\n//外部系统对接参数替换\nfunction replaceUrlParams(str, data) {\n    var computed = str.replace(/\\{\\{(\\w+)\\}\\}/g, function (match, key) {\n        return data[key];\n    })\n    return computed;\n}\n\n\nfunction loadErrorPageIframe() {\n    $(\"#pageiframe\").attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx000/urlError.jsp\");\n}\n\n// 以添加表头形式打开\nfunction addTabItemLocal2(url, params, title, idStr) {\n    var iWidth = window.screen.availWidth - 10;\n    var iHeight = window.screen.availHeight - 30;\n    var iTop = 0;\n    var iLeft = 0;\n    var baseurl = url;\n    var PageUrl = baseurl + params;\n    if (window.top == window.self) {\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=0, left=0, toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n        return;\n    }\n    try {\n        top.addTabItem({\n            id: idStr,/*唯一标识码*/\n            title: title,\n            tabContentType: 'iframe',\n            src: PageUrl,\n            isCloseBtn: 'true',\n            tabItemWidth: 150,\n            isShowMenuItem: [\"false\", \"true\", \"true\", \"true\"],\n            tempData: title\n        });\n    } catch (e) {\n        e.message;\n        var openUrl = \"\";\n        try {\n            window.open(PageUrl, idStr, 'fullscreen=1,top=' + iTop + ', left=' + iLeft + ', toolbar=no, menubar=no, scrollbars=yes, resizable=yes, location=no, status=no,width=' + iWidth + ',height=' + iHeight);\n        } catch (e) {\n            window.open(PageUrl);\n        }\n    }\n}\n\nfunction getUrlData(nsrxxInfo, systemInfo) {\n    var date1 = new Date();\n    date1.setMonth(date1.getMonth() - 11);\n    var year1 = date1.getFullYear();\n    var month1 = date1.getMonth() + 1;\n    month1 = month1 < 10 ? \"0\" + month1 : month1;\n    var tjrqq = year1 + \"\" + month1 + \"\" + \"01\";\n\n    var currentDate = new Date();\n    var year = currentDate.getFullYear();\n    var month = currentDate.getMonth() + 1;\n    var day = currentDate.getDate();\n    month = month < 10 ? \"0\" + month : month;\n    day = day < 10 ? \"0\" + day : day;\n    var tjrqz = year + \"\" + month + \"\" + day;\n\n    var systemInfoJson = jQuery.parseJSON(systemInfo.replace(/\\'/g, \"\\\"\"));\n\n    var zndm = systemInfoJson.zndm;\n    var gndm = systemInfoJson.gndm;\n    var gwssswjg\n    if (systemInfo.gwssswjg) {\n        gwssswjg = systemInfoJson.gwssswjg;\n    } else {\n        gwssswjg = systemInfoJson.myswjgDm;\n    }\n    var gwxh = systemInfoJson.gwxh;\n    var gt3zyydm = systemInfoJson.gt3zyydm;\n    var gt3ywfldm = systemInfoJson.gt3ywfldm;\n    var urlData = {\n        \"id\": \"YPTJK_YHS\",//固定\n        \"rUUid\": nsrxxInfo.djxh,//随机\n        \"zndm\": zndm,\n        \"gndm\": gndm,\n        \"gwssswjg\": gwssswjg,\n        \"gwxh\": gwxh,\n        \"gt3zyydm\": gt3zyydm,\n        \"gt3ywfldm\": gt3ywfldm,\n        \"gbiSage\": \"CUR\",//固定\n        \"djxh\": nsrxxInfo.djxh,\n        //  \"ywdm\": external_system_code,\n        \"tjrqq\": tjrqq,//统计日期起\n        \"tjrqz\": tjrqz,//统计日期止\n        \"nsrsbh\": nsrxxInfo.nsrsbh,\n        \"nsrmc\": nsrxxInfo.nsrmc\n    }\n    return urlData;\n}\n\nfunction isNull(value) {\n    if (typeof value == undefined || value == null || value == \"\" || value == \"[]\" || value == \"[{}]\" || value == \"null\" || value == \"{}\") {\n        return true;\n    }\n    return false;\n}"
          },
