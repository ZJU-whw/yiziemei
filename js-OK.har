            "mimeType": "text/javascript",
            "compression": -1,
            "text": "\"use strict\";\n\n//form悬浮框\nfunction InfoMouseOver(_this) {\n    var type = $(_this).attr(\"type\");\n    var name = $(_this).attr(\"name\");\n    var htmlItem = \"\";\n    if (type == \"text\" || type == \"select\") {\n        htmlItem = $(\"input[name='\" + name + \"']\").val();\n    }\n    if (type == \"textarea\") {\n        htmlItem = $(\"textarea[name='\" + name + \"']\").val();\n    }\n    if (type == \"wingsDate\") {\n        htmlItem = $(\"div[name='\" + name + \"']\").find('input').val();\n    }\n    if (type == \"pulltree\") {\n        htmlItem = $(\"div[name='\" + name + \"']\").find('.wtreeSpan').html();\n    }\n    if (htmlItem) {\n        var html = '<div class=\"infoBox\" style=\"\">' + htmlItem + '</div>';\n        $(_this).parent(\"td\").css(\"position\", \"relative\");\n        $(_this).parent('td').append(html);\n    }\n}\nfunction InfoMouseLeave(_this) {\n    $(_this).parent('td').find('.infoBox').remove();\n}"
          },
