          "content": {
            "size": 888,
            "mimeType": "text/javascript",
            "compression": -1,
            "text": "\"use strict\";\n\n/**\n * @Description:\n * @CreateAuthor: Mr_MN\n * @Date: 2020/7/6 10:45\n * @LastEditTime: 2020/7/6 10:45\n * @LastEditors: Administrator\n * @Version: 1\n */\n\n$(function () {\n    $(\".side_bar_switch\").click(function () {\n        var sideBar = $(\".side_bar\");\n        if (sideBar.width() == 0) {\n            sideBar.animate({ width: \"300px\" });\n            $(this).animate({ left: \"300px\" });\n            $(this).css({ background: 'url(./public/images/shouqi.png)' });\n            $(\".side_bar_content\").css({ display: \"block\", width: \"100%\", height: \"100%\" });\n        } else {\n            sideBar.animate({ width: \"0px\" });\n            $(this).animate({ left: \"0px\", background: 'url(./public/images/zhankai.png)' });\n            $(this).css({ background: 'url(./public/images/zhankai.png)' });\n            $(\".side_bar_content\").css({ display: \"none\" });\n        }\n    });\n});"
          },
