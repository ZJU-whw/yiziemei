            "text": "(function ($) {\n    /*字符串方法扩展*/\n    String.prototype.startWith = function (str) {\n        var reg = new RegExp(\"^\" + str);\n        return reg.test(this);\n    }\n\n    String.prototype.endWith = function (str) {\n        var reg = new RegExp(str + \"$\");\n        return reg.test(this);\n    }\n    String.prototype.toInt = function (base) {\n        return parseInt(this, base || 10);\n    }\n    String.prototype.toFloat = function () {\n        return parseFloat(this);\n    }\n    String.prototype.substitute = function (object, regexp) {\n        return this.replace(regexp || (/\\\\?\\{([^{}]+)\\}/g), function (match, name) {\n            if (match.charAt(0) == '\\\\') return match.slice(1);\n            return (object[name] != undefined) ? object[name] : '';\n        });\n    }\n    String.prototype.replaceAll || (String.prototype.replaceAll = function (s1, s2) {\n        return this.split(s1).join(s2)\n    });\n    String.format = function (src) {\n        if (arguments.length == 0) return null;\n        var args = Array.prototype.slice.call(arguments, 1);\n        return src.replace(/\\{(\\d+)\\}/g, function (m, i) {\n            return args[i];\n        });\n    };\n    /*补充缺少的方法*/\n    var sword_getFunc = wings_getFunc;\n    /*全局格式化对象\n    if (a) {\n        if (a.func) {var b = sword_getFunc(a.func)[0];a.func = b}\n        if (this[a.type]) {\n            $.extend(a, this[a.type].apply(document, [a]));\n            if (a.func) {a.func.apply(document, [a])}\n        }return a\n    } else {return {value: \"\", style: \"\"}\n    }\n    var sword_fmt =\n        percent\n        money\n        percent\n        money_chi\n    *\n    * */\n    /*格式化扩展*/\n\n    var removeDecimalZero = function (num) {\n        /* if(Helper.isRemoveDecimalZero != true){\n             return num;\n         }*/\n        if (typeof num == 'undefined') {\n            return 0;\n        }\n        var regexp = /(?:\\.0*|(\\.\\d+?)0+)$/;\n        // num = (num+\"\").replace(/(\\.\\d*?)0*$/, '$1').replace(/(\\d+?)\\.$/, '$1');\n        num = (num + \"\").replace(regexp, '$1');\n        return num;\n    }\n\n    sword_fmt.builderText = function (a) {\n        if (a) {\n            if (a.func) {\n                var b = sword_getFunc(a.func)[0];\n                a.func = b\n            }\n            if (this[a.type]) {\n                if (a.func) {\n                    a.func.apply(document, [a])\n                }\n                $.extend(a, this[a.type].apply(document, [a]));\n            }\n            return a\n        } else {\n            return {\n                value: \"\", style: \"\"\n            }\n        }\n    }\n    sword_fmt.numberZdy = function (a) {\n        var c = a.value;\n        if (!$chk(a.format)) {\n            return a;\n        }\n        if (!$chk(c)) {\n            c = 0\n        }\n        var b = (c / 1).numberFormat(a.format);\n        b == Number.prototype.NaNstring ? a.value = (0 / 1).numberFormat(a.format) : a.value = b;\n        //a.value = removeDecimalZero(a.value);\n        return a\n    };\n\n    sword_fmt.percentZdy = function (d) {\n        var c = d.value + \"\";\n        var b = c.split(\".\");\n        if (b.length > 1) {\n            c = \"\";\n            if (b[0].substring(0, 1) != \"0\") {\n                c += b[0]\n            }\n            if (b[1].length > 2) {\n                c += b[1].substring(0, 2);\n                c = c.toInt() + \".\" + b[1].substring(2)\n            } else {\n                if (b[1].length == 2) {\n                    c = (c + b[1].substring(0, 2)).toInt()\n                } else {\n                    c = (c + (b[1] + \"0\")).toInt()\n                }\n            }\n        } else {\n            c += (c.toInt() == 0) ? \"\" : \"00\"\n        }\n        d.value = c + \"%\";\n        return d\n    };\n\n    sword_fmt.bfhZdy = function (d) {\n        var c = d.value + \"\";\n        d.value = c + \"%\";\n        return d\n    };\n    /** 保留两位小数*/\n    sword_fmt.formatNumberwith2 = function (num) {\n        if (!$chk(num)) {\n            return 0;\n        }\n        var newNum = Number(num.value);\n        num.value = newNum.toFixed(2);\n        return num;\n    };\n\n    sword_fmt.bfbFormat = function (d) {\n        var c = d.value\n        var e = (Number(c) * 100).toFixed(2);\n        d.value = e + \"%\";\n        return d\n    };\n\n    sword_fmt.bfbFormatNoUnit = function (d) {\n        var c = d.value\n        var e = (Number(c) * 100).toFixed(2);\n        d.value = e + \"\";\n        return d\n    };\n    sword_fmt.num2Wan = function (d) {\n        var c = d.value\n        c = CommonFormat.number.num2Wan(c);\n        d.value = c;\n        return sword_fmt.numberZdy(d);\n    };\n    sword_fmt.num2WanUnit = function (d) {\n        var d = sword_fmt.num2Wan(d);\n        d.value = d.value + \"万元\";\n        return d;\n    };\n    sword_fmt.num2Yi = function (d) {\n        var c = d.value\n        c = CommonFormat.number.num2Yi(c);\n        d.value = c;\n        return sword_fmt.numberZdy(d);\n    };\n    sword_fmt.num2YiUnit = function (d) {\n        var d = sword_fmt.num2Yi(d);\n        d.value = d.value + \"亿元\";\n        return d;\n    };\n    if (window.showModalDialog == undefined) {\n        window.showModalDialog = function (url, mixedVar, features) {\n            if (window.hasOpenWindow) {\n                window.myNewWindow.focus();\n                return;\n            }\n            window.hasOpenWindow = true;\n            if (mixedVar) var mixedVar = mixedVar;\n            if (features) var features = features.replace(/(dialog)|(px)/ig, \"\").replace(/;/g, ',').replace(/\\:/g, \"=\");\n            var left = (window.screen.width - parseInt(features.match(/width[\\s]*=[\\s]*([\\d]+)/i)[1])) / 2;\n            var top = (window.screen.height - parseInt(features.match(/height[\\s]*=[\\s]*([\\d]+)/i)[1])) / 2;\n            url = url + \"&temp=\" + Math.random();\n            window.myNewWindow = window.open(url, \"_blank\", features);\n        }\n    }\n    window.Helper = {};\n    /* 获得视口的大小（区别与文档）  */\n    window.Helper.getViewPort = function () {\n        if (document.compatMode == \"BackCompat\") {   //浏览器嗅探，混杂模式\n            return {\n                width: document.body.clientWidth, height: document.body.clientHeight\n            };\n        } else {\n            return {\n                width: document.documentElement.clientWidth, height: document.documentElement.clientHeight\n            };\n        }\n    }\n\n    /* 获得文档的大小（区别与视口）,与上面获取视口大小的方法如出一辙  */\n    window.Helper.getDocumentPort = function () {\n        if (document.compatMode == \"BackCompat\") {\n            return {\n                width: document.body.scrollWidth, height: document.body.scrollHeight\n            };\n        } else {\n            return {\n                width: Math.max(document.documentElement.scrollWidth, document.documentElement.clientWidth),\n                height: Math.max(document.documentElement.scrollHeight, document.documentElement.clientHeight)\n            }\n        }\n    }\n\n    window.callParentResizeIframe = function () {\n        try {\n            if (parent && parent.resizeIframe) {\n                parent.resizeIframe();\n            }\n        } catch (e) {\n        }\n\n    }\n    \"use strict\";\n    /*日志工具 */\n    var consoleExt = window.consoleExt = {\n        log: function (a, b, c, d) {\n            try {\n                b = b || ' ';\n                c = c || ' ';\n                d = d || ' ';\n                var t = new Date();\n                var debug = window.debugMode || false;\n                if (window.console && window.console.log && debug) {\n                    console.log(t.toLocaleTimeString(), t.getMilliseconds(), a, b, c, d)\n                }\n                return b\n            } catch (e) {\n            }\n        }\n    };\n\n    var prevViewClient = {};\n    window.drawPage = function drawPage() {\n        //consoleExt.log(\"draw\",window.Helper.getViewPort().width,window.Helper.getViewPort().height,window.document.body.clientWidth,window.document.body.clientHeight);\n        if (window.document.body.clientWidth < 100 || window.document.body.clientHeight < 100) {\n            prevViewClient.clientWidth = window.document.body.clientWidth;\n            prevViewClient.clientHeight = window.document.body.clientHeight;\n            setTimeout(drawPage, 500);\n            return;\n        }\n        if (window.document.body.clientWidth > prevViewClient.clientWidth || window.document.body.clientHeight > prevViewClient.clientHeight) {\n            /*var currPanelIframe = $(\".tab-panel#\" + currentTab+\" iframe\");\n            $(currPanelIframe).resize();*/\n            consoleExt.log(\"window to resize\");\n            prevViewClient.clientWidth = window.document.body.clientWidth;\n            prevViewClient.clientHeight = window.document.body.clientHeight;\n            if (typeof zdyPageResize != 'undefined' && $.isFunction(zdyPageResize)) {\n                zdyPageResize();\n            }\n            setTimeout(drawPage, 500);\n        } else {\n            setTimeout(drawPage, 500);\n        }\n    }\n})(window.jQuery);\n\nvar inResize = false;\n\n//重置页面\nfunction zdyPageResize() {\n    if (inResize == false) {\n        $(window).resize();\n    }\n}\n\n//初始页面重置方法\nfunction initPageResize() {\n    setTimeout(drawPage, 1000);\n}\n\n\n/*********** grid自定义冻结列处理 - start ************/\n\nvar _zdyGridFixedColumn = {\n    tableFixedColObj: null, gridFixedTempData: {}, //跳转指定页面事件绑定\n    runToPageFun: function (gridName) {\n        //跳转指定页面事件绑定\n        $(\"#\" + gridName + '_pagingBar_info_runtopage').on(\"blur\", function () {\n            _zdyGridFixedColumn.createFixedColsStyle(gridName);\n        }).on(\"keydown\", function (e) {\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                return false;\n            }\n        }).on(\"keydown\", function (e) {\n            if (!e) {\n                e = window.event;\n            }\n            var key = window.event ? e.keyCode : e.which;\n            if (key.toString() == \"13\") {\n                $(this).blur();\n            }\n        });\n    }, //切换每页显示条数\n    changePageSize: function (gridName) {\n        $(\"#\" + gridName + \"_pagingBar_info_pageSize\").on(\"change\", function () {\n            _zdyGridFixedColumn.createFixedColsStyle(gridName);\n        });\n    }, /**\n     * 绑定点击事件\n     * @param gridName\n     * @param selectorId\n     */\n    bindClick: function (gridName, selectorId) {\n        $(selectorId).each(function () {\n            $(this).bind(\"click\", function () {\n                var clickSj = $(this).context.className;//点击事件名称\n\n                if ((clickSj.indexOf('previous') > -1 && _zdyGridFixedColumn.gridFixedTempData[gridName].f) || (clickSj.indexOf('next') > -1 && _zdyGridFixedColumn.gridFixedTempData[gridName].l)) {\n\n                } else {\n                    _zdyGridFixedColumn.createFixedColsStyle(gridName);\n                }\n            });\n        });\n    }, /**\n     * 构建固定列处理\n     * @param gridName\n     */\n    createFixedColsStyle: function (gridName) {\n        var id = $('div[name=\"' + gridName + '\"] div.wingsgrid_div').attr('id');\n        var fixedColId = id.split('fixed')[0] + 'fixedCol';\n        var fixedHead_Div = id.split('fixed')[0] + 'fixedHead_Div';\n        var headHeight = $('table[id^=\"' + gridName + '_wingsGrid\"] thead th')[0].getBoundingClientRect().height - 2;\n\n        var fixedH = $('div[name=\"' + gridName + '\"] div.wingsgrid_div[id^=\"' + fixedColId + '\"] th');\n        fixedH.css({'height': headHeight + 'px', 'font-size': '16px'});\n        fixedH.addClass('zdyFixedHeadTh');\n        $('div[name=\"' + gridName + '\"] div.wingsgrid_div[id=\"' + fixedHead_Div + '\"] thead').remove();\n        var fixedColEl = $('div[name=\"' + gridName + '\"] div.wingsgrid_div[id^=\"' + fixedColId + '\"]');\n\n        //处理固定列宽、高度、左边距，点击排序时保持左侧固定列不动\n        var leftNew = 0;\n        for (var i = 0; i < fixedColEl.length; i++) {\n            var oldw = $(\"#\" + id.split('_fixed')[0] + ' thead th')[i].getBoundingClientRect();\n            var l = oldw.left;\n            l = Number(l) - 20;\n            if (l >= 0) {\n                $(fixedColEl[i]).css('left', (l - 1) + 'px');\n            } else {\n                leftNew = i > 0 ? fixedColEl[i - 1].getBoundingClientRect().width + leftNew : 1;\n                $(fixedColEl[i]).css('left', (leftNew - 1) + 'px');\n            }\n            $(fixedColEl[i]).css('width', oldw.width + 'px');\n            $(fixedColEl[i]).find(' thead th').css('width', oldw.width + 'px');\n\n            $(fixedColEl[i]).find(' table').css('width', 'auto');\n        }\n\n        $(\"#\" + id.split('_fixed')[0]).parent().unbind('scroll');\n        var tH = $('div[name=\"' + gridName + '\"] div.wingsgrid_div table')[0].getBoundingClientRect().height;\n        $('div[name=\"' + gridName + '\"] div.wingsgrid_div').css('height', tH + 'px');\n\n        //上一页置灰判断、下一页置灰判断\n        _zdyGridFixedColumn.gridFixedTempData[gridName] = {\n            f: !$(\"#\" + gridName + '_pagingBar a.paginate_button.next').attr('disabled'), l: !$(\"#\" + gridName + '_pagingBar a.paginate_button.previous').attr('disabled')\n        };\n\n        //固定列数据点击事件处理\n        var wingsA = $('div[name=\"' + gridName + '\"] div.wingsgrid_div tbody td a');\n        for (var i = 0; i < wingsA.length; i++) {\n            var fName = $(wingsA[i]).attr('wingsonclick');\n            var row = $(wingsA[i]).attr(\"row\");\n            var col = $(wingsA[i]).attr(\"col\");\n            //$(wingsA[i]).removeAttr('wingsonclick');\n            $(wingsA[i]).attr(\"Onclick\", \"_zdyFixedOnClick('\" + gridName + \"','\" + row + \"','\" + col + \"','\" + fName + \"')\");\n        }\n\n        //固定列表头数据点击事件处理\n        /*var fixedHeadTh = $('div[name=