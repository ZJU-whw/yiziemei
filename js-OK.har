          "content": {
            "size": 9023,
            "mimeType": "text/javascript",
            "compression": 7198,
            "text": "(function($){\n\t//wingsRadio\n\t$.fn.wingsRadio= function(options){\n\t\t// 参数赋值\n\t\tvar opt = $.extend({}, $.fn.wingsRadio.defaults, options);\n\t\tvar $radioObj = $(this);\n\t\t\n\t\t// onClickBefore onClickAfter\n\t\t\n\t\tvar isDisable = '';\n\t\tif(opt.disable == true){\n\t\t\tisDisable = 'disabled'\n\t\t};\n\t\t//初始化页面\n\t\topt.radio_name = \"radio_\"+ opt.name + \"_\" + Math.floor(Math.random()*100);\n\t\t$radioObj.attr(\"id\",opt.radio_name);\n\t\tfor(var i= opt.radioDate.length -1 ; i >= 0 ;i--){\n\t\t\t$(\"#\"+opt.radio_name).after('<label wingsType=\"radio\" class=\"'+opt.radio_name+'\" title=\"'+opt.radioDate[i].caption+'\" ><input  name=\"'+opt.radio_name+'\" type=\"radio\" '\n\t\t\t\t  + 'value=\"'+opt.radioDate[i].code+'\" '+isDisable+' caption =\"'+opt.radioDate[i].caption+'\" />'\n\t\t\t\t  + opt.radioDate[i].caption+'</label>');\n\t\t};\n\t\t$radioObj.setRule = function(rules){\n\t\t\topt.rules = rules;\n\t\t};\n\t\t//公共校验方法(传递必要参数即可)\n\t\t$radioObj.validObj = function(){\n  \t\t\t//调用校验规则\n\t\t\tif(opt.isNewValidate == \"true\" && opt.rules && opt.rules.length > 0){\n\t\t\t\treturn $.wingsValidate2.validObj(opt.v_id, $radioObj ,$radioObj.getValue() ,opt.rules);\n\t\t\t}\n\t\t}\n\t\t\n\t    //设置值\n\t\t$radioObj.setValue = function(value){\n\t\t\tif(value == ''){\n\t\t\t\t$(':radio[name=\"'+opt.radio_name+'\"]').prop(\"checked\",'');\n\t\t\t}else{\n\t\t\t\t$(':radio[name=\"'+opt.radio_name+'\"][value=\"'+value+'\"]').prop(\"checked\",'checked');\n\t\t\t}\n  \t\t};\n  \t\t//获取值\n  \t\t$radioObj.getValue = function(){\n  \t\t\tvar val = $(':radio[name=\"'+opt.radio_name+'\"]:checked').val();\n  \t\t\tif(!val){\n  \t\t\t\tval = '';\n  \t\t\t}\n  \t\t\treturn val;\n  \t\t};\n  \t\t\n  \t\t//获取值\n  \t\t$radioObj.getShowValue = function(){\n  \t\t\tvar val = $(':radio[name=\"'+opt.radio_name+'\"]:checked').attr('caption');\n  \t\t\tif(!val){\n  \t\t\t\tval = '';\n  \t\t\t}\n  \t\t\treturn val;\n  \t\t};\n  \t\t\n  \t\t//设置on事件\n\t\t$radioObj.setOnClick= function(){\n\t\t\t// onClickBefore onClickAfter\n\t\t\t$(\"#\"+opt.radio_name).parent().find(':radio[name=\"'+opt.radio_name+'\"]').each(function(k,radioTemp){\n\t  \t\t\t$(radioTemp).unbind(\"click\");\n\t\t\t\t$(radioTemp).bind(\"click\",function(){\n\t  \t\t\t\tvar code = $(radioTemp).attr('value');\n\t  \t\t\t\tvar caption = $(radioTemp).attr('caption');\n\t  \t\t\t\t//执行前方法\n\t  \t\t\t\tif(opt.onClickBefore ){\n\t  \t\t\t\t\tvar onBeforeFn = wings_getFunc(opt.onClickBefore);\n\t\t\t\t\t\tfor (var b = 0; b < onBeforeFn.length; b++) {\n\t\t\t\t            var  func = eval(onBeforeFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(code,caption,$(radioTemp).get(0));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t};\n\t  \t\t\t\t//执行前方法\n\t  \t\t\t\tif(opt.onClickAfter ){\n\t  \t\t\t\t\tvar onAfterFn = wings_getFunc(opt.onClickAfter);\n\t\t\t\t\t\tfor (var b = 0; b < onAfterFn.length; b++) {\n\t\t\t\t            var  func = eval(onAfterFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(code,caption,$(radioTemp).get(0));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t};\n\t\t  \t\t\t//追加校验事件\n\t\t  \t\t\t$radioObj.validObj();\n\t\t\t\t\t\n\t\t\t\t});\n\t\t  \t});\n\t  \t};\n\t\t$radioObj.setOnClick();\n  \t\t\n\t    //初始化\n\t\t$radioObj.initData = function(initData){\n\t\t\tif(initData && initData.data){\n\t\t\t\t//清空原来的\n\t\t\t\t$('.'+opt.radio_name).remove();\n\t\t\t\t//初始化页面\n\t\t\t\tfor(var i= 0;i<initData.data.length;i++){\n\t\t\t\t\t$(\"#\"+opt.radio_name).after('<label wingsType=\"radio\" class=\"'+opt.radio_name+'\" title=\"'+initData.data[i].caption+'\" ><input name=\"'+opt.radio_name+'\" type=\"radio\" '\n\t\t\t\t\t\t  + 'value=\"'+initData.data[i].code+'\" '+isDisable+' caption =\"'+initData.data[i].caption+'\" />'\n\t\t\t\t\t\t  + initData.data[i].caption+'</label>');\n\t\t\t\t};\n\t\t\t\t\n  \t\t\t\t//追加属性\n  \t\t\t\tif(opt.defValue){\n  \t\t\t\t\tthis.setValue(opt.defValue);\n  \t\t\t\t};\n  \t\t\t\tthis.setOnClick();\n\t\t\t};\n\t\t\tif(opt.disable == \"true\"){\n\t  \t\t\t$(':radio[name=\"'+opt.radio_name+'\"]').each(function(i,obj){    \n\t\t\t\t\t$(obj).attr(\"disabled\", true);\n\t\t\t\t});\n\t\t\t}\n  \t\t};\n  \t\t//设置不可用\n  \t\t$radioObj.setDisable = function(){\n  \t\t\t$(':radio[name=\"'+opt.radio_name+'\"]').each(function(i,obj){    \n\t\t\t\t$(obj).attr(\"disabled\", true);\n\t\t\t});\n  \t\t}\n  \t\t//设置可用\n  \t\t$radioObj.setEnable = function(){\n  \t\t\t$(':radio[name=\"'+opt.radio_name+'\"]').each(function(i,obj){    \n\t\t\t\t$(obj).attr(\"disabled\", null);\n\t\t\t});\n  \t\t}\n  \t\t\n\t\t\n\t\treturn $radioObj;\n\t};\n\t\n\t\n\t$.fn.wingsRadio.defaults = {\n\t\t\tradioDate :[]\n\t\t};\n\t\n\t\n\t//wingsRadio\n\t$.fn.wingsCheckBox = function(options){\n\t\t// 参数赋值\n\t\tvar opt = $.extend({}, $.fn.wingsCheckBox.defaults, options);\n\t\tvar $checkBoxObj = $(this);\n\t\t\n\t\tvar isDisable = '';\n\t\tif(opt.disable == true){\n\t\t\tisDisable = 'disabled'\n\t\t};\n\t\t//初始化页面\n\t\topt.checkBox_name  = \"checkBox_\"+ opt.name + \"_\" + Math.floor(Math.random()*100);\n\t\t\n\t\t$checkBoxObj.attr(\"id\",opt.checkBox_name);\n\t\tfor(var i= opt.checkBoxDate.length -1 ; i >= 0 ;i--){\n\t\t\t$('#'+opt.checkBox_name).after('<label wingsType=\"checkbox\" class=\"'+opt.checkBox_name+'\" title=\"'+opt.checkBoxDate[i].caption+'\" ><input name=\"'+opt.checkBox_name+'\" type=\"checkbox\" '\n\t\t\t\t  + 'value=\"'+opt.checkBoxDate[i].code+'\" '+isDisable+' caption =\"'+opt.checkBoxDate[i].caption+'\" />'\n\t\t\t\t  + opt.checkBoxDate[i].caption+'</label>');\n\t\t};\n\t\t\n\t\t$checkBoxObj.setRule = function(rules){\n\t\t\topt.rules = rules;\n\t\t};\n\t\t//公共校验方法(传递必要参数即可)\n\t\t$checkBoxObj.validObj = function(){\n  \t\t\t//调用校验规则\n\t\t\tif(opt.isNewValidate == \"true\" && opt.rules && opt.rules.length > 0){\n\t\t\t\treturn $.wingsValidate2.validObj(opt.v_id, $checkBoxObj ,$checkBoxObj.getValue() ,opt.rules);\n\t\t\t}\n\t\t}\n\t\t\n\t    //设置值\n\t\t$checkBoxObj.setValue = function(value){\n\t\t\tvar val = value.split(',');\n\t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]').prop(\"checked\",false);\n\t\t\tfor(var i= 0;i<val.length;i++){\n\t\t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"][value=\"'+val[i]+'\"]').prop(\"checked\",true);\n\t\t\t};\n  \t\t};\n  \t\t//获取值\n  \t\t$checkBoxObj.getValue = function(){\n\t\t\tvar val = '';\n  \t\t\tvar chk_value =[];    \n\t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]:checked').each(function(){    \n\t\t\t\tchk_value.push($(this).val());   \n\t\t\t\tval += ',' + $(this).val();\n\t\t\t});\n\t\t\tif(val!=''){\n\t\t\t\tval = val.substring(1,val.length);\n\t\t\t}\n  \t\t\treturn val;\n  \t\t};\n  \t\t//获取值\n  \t\t$checkBoxObj.getShowValue = function(){\n\t\t\tvar val = '';\n\t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]:checked').each(function(){    \n\t\t\t\tval += ',' + $(this).attr('caption');\n\t\t\t});\n\t\t\tif(val!=''){\n\t\t\t\tval = val.substring(1,val.length);\n\t\t\t}\n  \t\t\treturn val;\n  \t\t};\n  \t\t\n  \t\t\n\t    //初始化\n\t\t$checkBoxObj.initData = function(initData){\n\t\t\tif(initData && initData.data){\n\t\t\t\t//清空原来的\n\t\t\t\t$('.'+opt.checkBox_name).remove();\n\t\t\t\t//初始化页面\n\t\t\t\tfor(var i= 0;i<initData.data.length;i++){\n\t\t\t\t\t$('#'+opt.checkBox_name).after('<label wingsType=\"checkbox\" class=\"'+opt.checkBox_name+'\" title=\"'+initData.data[i].caption+'\"><input name=\"'+opt.checkBox_name+'\" type=\"checkbox\" '\n\t\t\t\t\t\t  + 'value=\"'+initData.data[i].code+'\" '+isDisable+' caption =\"'+initData.data[i].caption+'\" />'\n\t\t\t\t\t\t  + initData.data[i].caption+'</label>');\n\t\t\t\t};\n\t\t\t\t\n  \t\t\t\t//追加属性\n  \t\t\t\tif(opt.defValue){\n  \t\t\t\t\tthis.setValue(opt.defValue);\n  \t\t\t\t};\n  \t\t\t\tthis.setOnClick();\n\t\t\t};\n\t\t\tif(opt.disable == \"true\"){\n\t  \t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]').each(function(i,obj){    \n\t\t\t\t\t$(obj).attr(\"disabled\", true);\n\t\t\t\t});\n\t\t\t}\n  \t\t};\n  \t\t\n  \t\t//设置on事件\n\t\t$checkBoxObj.setOnClick= function(){\n\t\t\t// onClickBefore onClickAfter\n\t\t\t$('#'+opt.checkBox_name).parent().find(':checkBox[name=\"'+opt.checkBox_name+'\"]').each(function(k,checkBoxTemp){\n\t\t\t\t$(checkBoxTemp).unbind(\"click\");\n\t  \t\t\t$(checkBoxTemp).bind(\"click\",function(){\n\t  \t\t\t\tvar code = $(checkBoxTemp).attr('value');\n\t  \t\t\t\tvar caption = $(checkBoxTemp).attr('caption');\n\t  \t\t\t\t//执行前方法\n\t  \t\t\t\tif(opt.onClickBefore ){\n\t  \t\t\t\t\tvar onBeforeFn = wings_getFunc(opt.onClickBefore);\n\t\t\t\t\t\tfor (var b = 0; b < onBeforeFn.length; b++) {\n\t\t\t\t            var  func = eval(onBeforeFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(code,caption,$(checkBoxTemp).get(0));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t};\n\t  \t\t\t\t//执行前方法\n\t  \t\t\t\tif(opt.onClickAfter ){\n\t  \t\t\t\t\tvar onAfterFn = wings_getFunc(opt.onClickAfter);\n\t\t\t\t\t\tfor (var b = 0; b < onAfterFn.length; b++) {\n\t\t\t\t            var  func = eval(onAfterFn[b]);\n\t\t\t\t\t       \tif (typeof func == \"function\") {\n\t\t\t\t            \tvar result = new func(code,caption,$(checkBoxTemp).get(0));\n\t\t\t\t\t       \t}\n\t\t\t\t\t    }\n\t\t\t\t\t};\n\t\t  \t\t\t//追加校验事件\n\t\t  \t\t\t$checkBoxObj.validObj();\n\t\t\t\t\t\n\t\t\t\t});\n\t\t  \t});\n  \t\t};\n  \t\t\n  \t\t$checkBoxObj.setOnClick();\n\t\t\n  \t\t//设置不可用\n  \t\t$checkBoxObj.setDisable = function(){\n  \t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]').each(function(i,obj){    \n\t\t\t\t$(obj).attr(\"disabled\", true);\n\t\t\t});\n  \t\t}\n  \t\t//设置可用\n  \t\t$checkBoxObj.setEnable = function(){\n  \t\t\t$(':checkBox[name=\"'+opt.checkBox_name+'\"]').each(function(i,obj){    \n\t\t\t\t$(obj).attr(\"disabled\", null);\n\t\t\t});\n  \t\t}\n\t\treturn $checkBoxObj;\n\t};\n\t\n\t\n\t$.fn.wingsCheckBox.defau