            "text": "!(function ($, w) {\n    //默认参数值\n    var wingsPageLoading_defaults = {\n        lines: 12\n    };\n    w.wingsPageLoading = {\n        opt: $.extend({}, wingsPageLoading_defaults, {}), setOption: function (a) {\n            this.opt = $.extend({}, wingsPageLoading_defaults, a)\n        }, show: function () {\n            var a = '<div class=\"modal-backdrop fade in wingsPageLoading \" style=\"background-color:#73848c;\" >' + ' <div class=\"wingsPageLoadingDiv\" ' + ' style=\"color:red;position: absolute;width:400px;height:200px;left:50%;top:50%; margin-left:-200px;margin-top:-100px\"> ' + ' <div  style=\"width: 60px;height: 60px;position: relative;top: 40%;left: 40%;background-size: 100% 100%;background-image: url(/rwglxt/common/img/pageloading.gif);\"></div>' + '</div> ' + '</div>';\n            /*class = \"wings_loading_img2\"*/\n            $(document.body).append(a)\n        }, hide: function () {\n            $(\".modal-backdrop.wingsPageLoading\").remove()\n        }\n    };\n\n    $.getMultiScripts = function (arr, path) {\n        var _arr = $.map(arr, function (scr) {\n            return $.getScript((path || \"\") + scr);\n        });\n\n        _arr.push($.Deferred(function (deferred) {\n            $(deferred.resolve);\n        }));\n\n        return $.when.apply($, _arr);\n    };\n\n\n    /*var script_arr = [\n        'myscript1.js',\n        'myscript2.js',\n        'myscript3.js'\n    ];\n    $.getMultiScripts(script_arr, '/mypath/').done(function() {\n        // all scripts loaded\n    });*/\n\n\n    /*try {\n        $.get(\"ajax.sword?ctrl=StyleCtrl_loadWingsStyle\", function (resData) {\n            var style = resData.style;\n            if ($chk(style) && style && style != \"null\" && style != \"\") {\n                var styleArray = JSON.parse(style);\n                for (var j = 0; j < styleArray.length; j++) {\n                    var styleItem = styleArray[j];\n                    if ($chk(styleItem)) {\n               