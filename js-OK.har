          "content": {
            "size": 36496,
            "mimeType": "text/javascript",
            "compression": 27559,
            "text": "let paramsData;\nlet qylxDm = \"\";\nvar path;\nvar jumpAiReportParam = \"\";//跳转ai智能报告参数\n\nfunction initSuccess(res) {\n    //setYearMonth(\"cxtjForm\", solveDate(12));\n    var timeMap = solveDate(12);\n    var date = new Date();\n    var dhcxPageObj = res.getAttr(\"dhcxPageObj\");\n    paramsData = jQuery.parseJSON(dhcxPageObj);\n    /*    paramsData.tjnfq = getNday(0,0,0).substr(0,4) + \"01\";\n        paramsData.tjnfz = getNday(0,0,-1).replaceAll(\"-\",\"\").substr(0,6);\n        paramsData.tjnf5q = getNday(-1,0,0).substr(0,4) + \"01\";\n        paramsData.tjnf5z = getNday(-1,0,-1).replaceAll(\"-\",\"\").substr(0,6);\n        paramsData.tjnf4q = getNday(-2,0,0).substr(0,4) + \"01\";\n        paramsData.tjnf4z = getNday(-2,0,-1).replaceAll(\"-\",\"\").substr(0,6);\n        paramsData.tjnf3q = getNday(-3,0,0).substr(0,4) + \"01\";\n        paramsData.tjnf3z = getNday(-3,0,-1).replaceAll(\"-\",\"\").substr(0,6);\n        paramsData.tjnf2q = getNday(-4,0,0).substr(0,4) + \"01\";\n        paramsData.tjnf2z = getNday(-4,0,-1).replaceAll(\"-\",\"\").substr(0,6);\n        paramsData.tjnf1q = getNday(-5,0,0).substr(0,4) + \"01\";\n        paramsData.tjnf1z = getNday(-5,0,-1).replaceAll(\"-\",\"\").substr(0,6);*/\n    /*临时修改日期为当前月份上一个月*/\n    paramsData.tjnfq = getNday(0, 0, 0).substr(0, 4) + \"01\";\n    paramsData.tjnfz = getNday(0, -1, 0).replaceAll(\"-\", \"\").substr(0, 6);\n    paramsData.tjrqq = getNday(0, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjrqz = getNday(0, 0, -1).replaceAll(\"-\", \"\");\n    paramsData.tjnf5q = getNday(-1, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjnf5z = getNday(-1, 0, -1).replaceAll(\"-\", \"\");\n    paramsData.tjnf4q = getNday(-2, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjnf4z = getNday(-2, 0, -1).replaceAll(\"-\", \"\");\n    paramsData.tjnf3q = getNday(-3, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjnf3z = getNday(-3, 0, -1).replaceAll(\"-\", \"\");\n    paramsData.tjnf2q = getNday(-4, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjnf2z = getNday(-4, 0, -1).replaceAll(\"-\", \"\");\n    paramsData.tjnf1q = getNday(-5, 0, 0).substr(0, 4) + \"01\" + \"01\";\n    paramsData.tjnf1z = getNday(-5, 0, -1).replaceAll(\"-\", \"\");\n\n\n    // paramsData.tjnyq = timeMap.tjnyq.substr(0, 6);\n    // paramsData.tjnyz = timeMap.tjnyz.substr(0, 6);\n    paramsData.tjnyq = paramsData.tjnfq;\n    paramsData.tjnyz = paramsData.tjnfz;\n    paramsData.result = [{'type': 'form', 'name': 'cktsgyxxForm'}, {\n        'type': 'map',\n        'name': 'bnckexxMap'\n    }, {'type': 'list', 'name': 'fiveyearckxxList'}, /*出口国主要信息*/\n        // {'type': 'grid', 'name': 'ckgzyxxGrid'},\n        {'type': 'list', 'name': 'spdmjzb'}, {'type': 'grid', 'name': 'cktsbabgxxGrid'}];\n    _zdySubmit._zdySubmitData(_zdySubmit.createFormDataForName(paramsData, \"cxtjForm\"), \"getQueryData\", \"查询\", \"selectSuccess\");\n    queryCkqyznfxfx();\n}\n\n//日期选择后执行的查询方法\nfunction querycktsglsd(qztype) {\n    if (!CheckDate('cxtjForm', 'tjnyq', 'tjnyz', qztype)) {\n        paramsData.result = [{'type': 'map', 'name': 'jynckze'}, // {'type': 'map', 'name': 'cktsxxgl'},\n            {'type': 'list', 'name': 'spdmjzb'}, {'type': 'grid', 'name': 'ckspxxGrid'}];\n        _zdySubmit._zdySubmitData(_zdySubmit.createFormDataForName(paramsData, \"cxtjForm\"), \"getQueryData\", \"查询\", \"selectSuccess\");\n    }\n}\n\n//设置默认月份\nfunction setYearMonth(form, settime) {\n    var form = $.wingsWidget(form);\n    form.setValue(\"tjnyq\", settime.tjnyq);\n    form.setValue(\"tjnyz\", settime.tjnyz);\n}\n\nfunction selectSuccess(res) {\n    let zztData = [];\n    let sbtseData = [];\n    let zzttbData = [];\n    let sbtsetbData = [];\n    let bztData = [];\n    let xData = [];\n\n    res.data.forEach(item => {\n        if (item.name == \"cktsgyxxForm\") {\n            qylxDm = !checkNull(item.data.cktsqylxDm) ? \"\" : item.data.cktsqylxDm.value;\n            getYcqkData();\n\n        }\n        if (item.name == \"bnckexxMap\") {\n            let itemData = jQuery.parseJSON(item.value);\n            /*document.querySelector(\"#jyntsze\").innerText = !!itemData.jyntse ? itemData.jyntse : \"0\";\n            document.querySelector(\"#jynckze\").innerText = !!itemData.jyncke ? itemData.jyncke : \"0\";*/\n            // $(\".bndate\").attr(\"title\", \"本年指申报日期：\" + getNday(0, 0, 0).substr(0, 4) + \"-01-01\" + \"至\" + getNday(0, 0, -1) +\"\\n出口销售额包含免退税、免抵退税、代办退税申报的销售额\")\n            // $(\".bndate1\").attr(\"title\", \"本年指申报日期：\" + getNday(0, 0, 0).substr(0, 4) + \"-01-01\" + \"至\" + getNday(0, 0, -1)+ \"\\n退税额包含免退税、免抵退税、代办退税以及周边业务申报的退税额\")\n            $(\".bndate\").attr(\"title\", \"本年指申报日期：\" + getNday(0, 0, 0).substr(0, 4) + \"-01\" + \"-01\" + \"至\" + getNday(0, 0, -1) + \"\\n出口销售额包含免退税、免抵退税、代办退税申报的销售额\")\n            $(\".bndate1\").attr(\"title\", \"本年指申报日期：\" + getNday(0, 0, 0).substr(0, 4) + \"-01\" + \"-01\" + \"至\" + getNday(0, 0, -1) + \"\\n退税额包含免退税、免抵退税、代办退税以及周边业务申报的退（免）税额\")\n            document.querySelector(\"#jynckze\").innerText = !!itemData.ckze ? num2WanFixed(itemData.ckze, 2) : \"0\";\n            document.querySelector(\"#jyntsze\").innerText = !!itemData.sbtse || !!itemData.mdse ? num2WanFixed(Number(itemData.sbtse) + Number(itemData.mdse), 2) : \"0\";\n\n            /*            if (\"1\" == qylxDm || \"2\" == qylxDm) {\n                            $(\"#mdseDiv\").css('display', '');\n                            document.querySelector(\"#bnmdse\").innerText = !!itemData.mdse ? num2WanFixed(itemData.mdse, 2) : \"0\";\n                        }*/\n\n\n        }\n        if (item.name == \"fiveyearckxxList\") {\n            let itemData = jQuery.parseJSON(item.value);\n            xData = getXData(getNday(0, 0, 0).substr(0, 4), 5);\n            let data = insertZeroforData(itemData, xData);\n            $.each(data, function (i, map) {\n                zztData.push(map.ckze);\n                sbtseData.push(map.sbtse);\n                zzttbData.push(map.ckzetb);\n                sbtsetbData.push(map.sbtsetb);\n            });\n        }\n        if (item.name == \"spdmjzb\") {\n            let itemData = jQuery.parseJSON(item.value);\n            var otherData = 0;\n            for (let i = 1; i < itemData.length; i++) {\n                for (let j = i + 1; j < itemData.length; j++) {\n                    if (itemData[i].spzlmc == itemData[j].spzlmc) {\n                        itemData[i].ckze = Number(itemData[i].ckze) + Number(itemData[j].ckze);\n                        itemData.splice(j, 1);\n                        j--;\n                    }\n                }\n            }\n\n            if (!gyUtils.isNull(itemData) && itemData.length == 11) {\n                $.each(itemData, function (i, val) {\n                    if (val.spzlmc != '总额') {\n                        otherData += Number(val.ckze);\n                        bztData.push({'value': num2WanFiexd(val.ckze, 2), 'name': val.spzlmc, 'dm': val.spzlDm})\n                    }\n                })\n                otherData = Number(itemData[0].ckze) - Number(otherData);\n                if (otherData != 0) {\n                    bztData.push({'value': num2WanFiexd(otherData, 2), 'name': '其他'})\n                }\n            } else {\n                $.each(itemData, function (i, val) {\n                    if (val.spzlmc != '总额') {\n                        bztData.push({'value': num2WanFiexd(val.ckze, 2), 'name': val.spzlmc, 'dm': val.spzlDm})\n                    }\n                })\n            }\n        }\n    });\n    setZzEchartsData(xData, zztData, sbtseData, zzttbData, sbtsetbData);\n    if (!$chk(bztData) || bztData.length === 0) {\n        bztData.push({'value': 0, 'name': '无数据', 'dm': ''})\n    }\n    setBzEchartsData(bztData);\n    //重置同类企业比较情况\n    resetQybjqk();\n    //查询同类企业比较情况\n    queryQybjqk();\n    offMenban();\n\n}\n\nvar chartsMap = {};\nwindow.onresize = function () {\n    for (var key in chartsMap) {\n        if (chartsMap[key]) {\n            chartsMap[key].resize();\n        }\n    }\n};\n\nfunction getXData(sj, num) {\n    var dataArr = [];\n    var tjsj = parseInt(sj);\n    for (var i = 0; i < num; i++) {\n        dataArr.push(tjsj);\n        tjsj--;\n    }\n    return dataArr;\n}\n\nfunction insertZeroforData(data, xData) {\n    let mapArray = [];\n    var xdata = [];\n    $.each(data, function (i, map) {\n        xdata[i] = parseInt(map['tjnf']);\n    });\n    $.each(xData, function (i, item) {\n        if (!xdata.includes(item)) {\n            let map = {\n                'tjnf': item, 'ckze': 0, 'sbtse': 0, 'ckzetb': 0.00, 'sbtsetb': 0.00\n            };\n            mapArray.push(map);\n        } else {\n\n            for (var x = 0; x < 5; x++) {\n                if (checkNull(data[x]) && item == data[x].tjnf) {\n                    var tqdata = checkNull(data[x + 1]) && (Number(data[x + 1].tjnf) == (Number(data[x].tjnf) - 1)) ? data[x + 1] : {\n                        'tjnf': (Number(data[x].tjnf) - 1), 'ckze': 0, 'sbtse': 0, 'ckzetb': 0.00, 'sbtsetb': 0.00\n                    };\n                    mapArray.push({\n                        tjnf: data[x].tjnf,\n                        ckze: num2WanFiexd(Number(data[x].ckze), 2),\n                        sbtse: num2WanFiexd(Number(data[x].sbtse), 2),\n                        ckzetb: toPercent3((Number(data[x].ckze) - Number(tqdata.ckze)), Number(tqdata.ckze)),\n                        sbtsetb: toPercent3((Number(data[x].sbtse) - Number(tqdata.sbtse)), Number(tqdata.sbtse))\n                    });\n                }\n            }\n        }\n    });\n    return mapArray;\n}\n\nfunction setBzEchartsData(data) {\n    var objEchart = echarts.init(document.getElementById(\"bztEchartsDiv\"));\n    objEchart.clear();\n    let option = {\n        title: {\n            text: '本年主要出口商品及占比', subtext: '', left: 'center',\n        },\n        color: ['#6f9ceb', '#fc9a00', '#b39edb', '#A5D6A7', '#90CAF9', '#FFE183', '#CF93D9', '#C4E1A6', '#81D5FB', '#FFAB91', '#F48FB1', '#DDE774'],\n        tooltip: {\n            trigger: 'item', // formatter: '{a} <br/>{b}:<br/> {c} 元({d}%)',\n            formatter: function (params) {\n                if (!gyUtils.isNull(params.data)) {\n                    if (params.data.name == '其他') {\n                        return '<div style=\"text-align: center\">' + params.data.name + \"(人民币出口额前十之外的商品集合)</div>\" + \"出口额：\" + formatNumberWithQFWFloat(params.data.value) + \"万元(\" + formatNumberWithQFWFloat(params.percent) + \"%)\";\n                    } else {\n                        return '<div style=\"text-align: center\">' + params.data.name + \"</div>\" + \"代码：\" + params.data.dm + \"<br/>出口额：\" + formatNumberWithQFWFloat(params.data.value) + \"万元(\" + formatNumberWithQFWFloat(params.percent) + \"%)\";\n                    }\n                }\n            }, confine: true, position: 'inside', extraCssText: 'white-space: normal; word-break: break-all;'\n        },\n        legend: {\n            center: 'left', bottom: 'bottom', formatter: function (params) {\n                return (checkNull(params) && params.length > 8) ? params.substr(0, 8) + \"...\" : params;\n            },\n        },\n        series: [{\n            name: '出口额',\n            avoidLabelOverlap: true,\n            minAngle: 25,\n            type: 'pie',\n            radius: '55%',\n            center: ['50%', '50%'],\n            data: data,\n            emphasis: {\n                itemStyle: {\n                    shadowBlur: 10, shadowOffsetX: 0, shadowColor: 'rgba(0, 0, 0, 0.5)'\n                }\n            },\n            label: {\n                formatter: function (params) {\n                    if (!gyUtils.isNull(params.data)) {\n                        if (params.data.name == '其他') {\n                            return params.data.name + '\\n' + formatNumberWithQFWFloat(params.percent) + \"%\";\n                        } else {\n                            return params.data.name.length > 15 ? params.data.name.substr(0, 15) + \"...\" : params.data.name + \"\\n\" + formatNumberWithQFWFloat(params.percent) + \"%\";\n                        }\n                    }\n                }, show: true,\n            },\n        }]\n    };\n    objEchart.setOption(option);\n    chartsMap[\"objEchart\"] = objEchart;\n}\n\n\n//柱状图\nfunction setZzEchartsData(xdata, y1data, y2data, y3data, y4data) {\n    var zztEchart = echarts.init(document.getElementById(\"zztEchartsDiv\"));\n    zztEchart.clear();\n    option = {\n        color: ['#4297F6', '#00A26E', '#B39EDB', '#FFA42F'], tooltip: {\n            trigger: 'axis', axisPointer: {            // 坐标轴指示器，坐标轴触发有效\n                type: 'shadow'        // 默认为直线，可选为：'line' | 'shadow'\n            }, formatter: function (params) {\n                if ($chk(params) && params.length > 0) {\n                    var html = \"\";\n                    html += params[0].name + \"年1月1日-\" + ((Number(paramsData.tjrqz.substr(4, 2)) >= 10) ? paramsData.tjrqz.substr(4, 2) : paramsData.tjrqz.substr(5, 1)) + \"月\" + paramsData.tjrqz.substr(6, 2) + \"日</br>\"\n                    $.each(params, function (i, val) {\n                        if (val.seriesType == 'bar') {\n                            html += val.seriesName + \"：\" + formatNumberWithQFWFloat(val.value) + \"万元</br>\";\n                        } else {\n                            html += val.seriesName + \"：\" + formatNumberWithQFWFloat(val.value) + \"%</br>\";\n                        }\n                    })\n                    return html;\n                }\n            },\n        }, legend: {\n            top: '3%', show: true,\n        }, grid: {\n            left: '5%', right: '5%', bottom: '5%', top: '20%', containLabel: true\n        }, xAxis: [{\n            type: 'category', data: xdata, axisTick: {\n                alignWithLabel: true\n            }, inverse: true,\n        }], yAxis: [{\n            type: 'value', name: '(万元)', nameTextStyle: {\n                color: '#333333', // fontSize: changeFontSize(14),\n            }, // nameGap:changeFontSize(12),\n            axisLine: {\n                lineStyle: {\n                    color: '#333333', opacity: 0.5\n                }\n            }, axisTick: {\n                show: false\n            }, axisLabel: {\n                show: true, color: '#333333', // fontSize:changeFontSize(16)\n            }, splitLine: {\n                show: true, lineStyle: {\n                    color: '#b9e1ff', opacity: 0.35, type: 'dashed'\n                }\n            }, // maxInterval:10\n        }, {\n            name: '%', nameTextStyle: {\n                color: '#333333',\n            }, axisLine: {\n                lineStyle: {\n                    color: '#333333', opacity: 0.5\n                }\n            }, axisTick: {\n                show: false\n            }, axisLabel: {\n                show: true, color: '#333333',\n            }, splitLine: {\n                show: false\n            }, /* maxInterval:10,*/\n        }], series: [{\n            name: '申报出口销售额', type: 'bar', barWidth: '10%', data: y1data, itemStyle: {\n                normal: {\n                    color: function (value) {\n                        if (value.data > 0 || value.data == 0) {\n                            return new echarts.graphic.LinearGradient(0, 1, 0, 0, [{\n                                offset: 0, color: \"#7245F4\" // 0% 处的颜色\n                            }, {\n                                offset: 1, color: \"#4297F6\" // 100% 处的颜色\n                            }], false)\n                        } else {\n                            return new echarts.graphic.LinearGradient(0, 1, 0, 0, [{\n                                offset: 0, color: \"#7245F4\" // 0% 处的颜色\n                            }, {\n                                offset: 1, color: \"#4297F6\"// 100% 处的颜色\n                            }], false)\n                        }\n                    }, barBorderRadius: 5,\n                },\n            }\n        }, {\n            name: '申报退（免）税额', type: 'bar', barWidth: '10%', data: y2data, itemStyle: {\n                normal: {\n                    color: function (value) {\n                        if (value.data > 0 || value.data == 0) {\n                            return new echarts.graphic.LinearGradient(0, 1, 0, 0, [{\n                                offset: 0, color: \"#00A26E\" // 0% 处的颜色\n                            }, {\n                                offset: 1, color: \"#8DECCB\" // 100% 处的颜色\n                            }], false)\n                        } else {\n                            return new echarts.graphic.LinearGradient(0, 1, 0, 0, [{\n                                offset: 0, color: \"#00A26E\" // 0% 处的颜色\n                            }, {\n                                offset: 1, color: \"#8DECCB\"// 100% 处的颜色\n                            }], false)\n                        }\n                    }, barBorderRadius: 5,\n                },\n            }\n        }, {\n            name: '申报出口销售额同比',\n            type: 'line',\n            yAxisIndex: 1,\n            symbol: 'emptyCircle',\n            symbolSize: 10,\n            data: y3data,\n            smooth: false,\n            lineStyle: {\n                color: '#B39EDB', width: 2\n            },\n            itemStyle: {\n                color: '#B39EDB', borderColor: '#B39EDB',\n            },\n            emphasis: {\n                itemStyle: {\n                    color: '#B39EDB', borderColor: '#B39EDB',\n                }\n            }\n        }, {\n            name: '申报退（免）税额同比',\n            type: 'line',\n            yAxisIndex: 1,\n            symbol: 'emptyCircle',\n            symbolSize: 10,\n            data: y4data,\n            smooth: false,\n            lineStyle: {\n                color: '#FFA42F', width: 2\n            },\n            itemStyle: {\n                color: '#FFA42F', borderColor: '#FFA42F',\n            },\n            emphasis: {\n                itemStyle: {\n                    color: '#FFA42F', borderColor: '#FFA42F',\n                }\n            }\n        }]\n    };\n    zztEchart.setOption(option);\n    chartsMap[\"zztEchart\"] = zztEchart;\n}\n\nvar xzlist = ['sfwtdbts', 'wmzfqybz', 'sfjtgsjcyqy'];\nvar xzlist2 = ['flgllbmc', 'dqyxkzxxsl'];\nlet wgfxxColContent = '否';\nlet qyycxxColContent = '否';\n\nfunction getYcqkData() {\n    paramsData.result = [{'type': 'map', 'name': 'yhscktsnsrycqkdata'}];\n    paramsData.ckqylxdm = (\"1\" == qylxDm || \"2\" == qylxDm) ? \"'1','2'\" : \"'\" + qylxDm + \"'\";\n    _zdySubmit._zdySubmitData(_zdySubmit.createFormDataForName(paramsData), \"getQueryData\", \"查询\", \"queryYcqkSuccess\");\n}\n\nfunction queryYcqkSuccess(res) {\n    let ycqkxx = JSON.parse(res.getAttr(\"yhscktsnsrycqkdata\"));\n    let wgfxxKeys = [\"sfczrdhpdwsxqx\", \"sffddbrnlyc\", \"sffddbrbtzcktsnsr\", \"sflcyszzswfbxzcf\", \"sfqs\", \"sfjclawja\", \"sfczychd\", \"sfczfxrw\", \"sfzzsfxnsr\", \"sfztslh\"];\n    let qyycxxKeys = [\"syqyfzcbz\", \"syqyzxbz\", \"syqytsedy200wbz\", \"syqytsezbdybfz30bz\", \"syqyychzbdybfz20bz\", \"syqysfczydhcyd\"];\n    $.each(wgfxxKeys, function (i, k) {\n        if ('Y' == ycqkxx[k]) {\n            wgfxxColContent = '是';\n            return;\n        }\n    });\n    $.each(qyycxxKeys, function (i, k) {\n        if ('Y' == ycqkxx[k]) {\n            qyycxxColContent = '是';\n            return;\n        }\n    });\n    setEnable();\n}\n\nfunction setEnable() {\n    $.each(xzlist, function (i, v) {\n        if ($w(\"cktsgyxxForm\").getValue(v) == 'Y') {\n            $($w(\"cktsgyxxForm\").getFieldEl(v)).css({\n                \"color\": \"#0ab1fc\", 'cursor': 'pointer', \"text-decoration\": \"underline\"\n            })\n            $w(\"cktsgyxxForm\").setValue(v, \"是\");\n            $($w(\"cktsgyxxForm\").getFieldEl(v)).click(function (i) {\n                openMxxx(v);\n            })\n        } else {\n            $w(\"cktsgyxxForm\").setValue(v, \"否\");\n        }\n    });\n\n    if (checkNull($w(\"cktsgyxxForm\").getValue(\"flgllbmc\"))) {\n        $($w(\"cktsgyxxForm\").getFieldEl(\"flgllbmc\")).css({\n            \"color\": \"#0ab1fc\", 'cursor': 'pointer', \"text-decoration\": \"underline\"\n        })\n        $($w(\"cktsgyxxForm\").getFieldEl(\"flgllbmc\")).click(function (i) {\n            openMxxx(\"flgllbmc\");\n        })\n    }\n    if (checkNull($w(\"cktsgyxxForm\").getValue(\"dqyxkzxxsl\")) && Number($w(\"cktsgyxxForm\").getValue(\"dqyxkzxxsl\")) > 0) {\n        $($w(\"cktsgyxxForm\").getFieldEl(\"dqyxkzxxsl\")).css({\n            \"color\": \"#0ab1fc\", 'cursor': 'pointer', \"text-decoration\": \"underline\"\n        })\n        $($w(\"cktsgyxxForm\").getFieldEl(\"dqyxkzxxsl\")).click(function (i) {\n            openMxxx(\"dqyxkzxxsl\");\n        })\n    }\n    var xzkey_arr = [\"wgfxxx\", \"ghqyycxx\"];\n    //var xzkey_arr=[\"wgfxxx\"];\n    $.each(xzkey_arr, function (i, v) {\n        $w(\"cktsgyxxForm\").setValue(v, \"wgfxxx\" == v ? wgfxxColContent : qyycxxColContent);\n        $($w(\"cktsgyxxForm\").getFieldEl(v)).css({\n            \"color\": \"#0ab1fc\", 'cursor': 'pointer', \"text-decoration\": \"underline\"\n        });\n        $($w(\"cktsgyxxForm\").getFieldEl(v)).click(function (i) {\n            openWgfxhqyycxx(v);\n        })\n    });\n    /*企业类型=9为其他的时候，不显示同类企业比较情况*/\n    if (checkNull(qylxDm) && qylxDm == \"9\") {\n        $(\"#tlqybjqkDiv\").hide();\n    } else {\n        $(\"#tlqybjqkDiv\").show();\n    }\n\n}\n\nvar _xzParam;\nvar xzshowName = {\n    'flgllbmc': \"分类管理类别信息\",\n    'dqyxkzxxsl': \"扩展信息明细\",\n    'sfwtdbts': \"委托代办退税信息\",\n    'wmzfqybz': \"对应生产企业委托代办退税备案信息\",\n    'sfjtgsjcyqy': \"集团公司成员企业备案信息\"\n}\n\nfunction openMxxx(type) {\n    _xzParam = $.extend({}, paramsData);\n    _xzParam.xztype = type;\n    // var postDataJson = {};\n    // postDataJson.bddyinfo = _xzParam;\n    //处理url\n    /*postDataJson.urlpage = \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/cktsmx.jsp\";\n    postDataJson.ctrl = \"DhcxCtrl_loadNextPage\";\n    var postData = JSON.stringify(postDataJson);\n    var url = '/form.sword?postData=' + postData;\n\n     var params = \"\";\n     var id = \"YXSCX-XX-\" + new Date();\n     addTabItemLocal(url, params, xzshowName[type], id);*/\n\n    var param = {\n        data: _xzParam,\n        url: '/yxscx/yhscx/dhcx/dhcx009/dhcx009017/cktsmx.jsp',\n        title: xzshowName[type],\n        w: getViewPort().width * 0.85,\n        h: 500,\n        minH: 450\n    };\n    yxscxShowModalDialog(param);\n}\n\nfunction openWgfxhqyycxx(type) {\n    let wgfx_url = \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/wgfxxx_cktsxz.jsp\";\n    let qyyc_url = \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/qyycxx_cktsxz.jsp\";\n    let url_text = (type == \"wgfxxx\") ? wgfx_url : qyyc_url;\n    let titleName = (type == \"wgfxxx\") ? \"违规风险信息\" : \"上游供货企业异常情况\"\n    var xzParams = $.extend(true, {}, paramsData);\n    xzParams.ckqylxdm = (\"1\" == qylxDm || \"2\" == qylxDm) ? \"'1','2'\" : \"'\" + qylxDm + \"'\";\n    //if (type == \"wgfxxx\") {\n    var postDataJson = {};\n    postDataJson.bddyinfo = xzParams;\n    //处理url\n    postDataJson.urlpage = (type == \"wgfxxx\") ? wgfx_url : qyyc_url;\n    postDataJson.ctrl = \"DhcxCtrl_loadNextPage\";\n    var postData = JSON.stringify(postDataJson);\n    var url = '/form.sword?postData=' + postData;\n    var params = \"\";\n    var id = \"YXSCX-XX-\" + new Date();\n    addTabItemLocal(url, params, titleName, id);\n    /*} else {\n        var param = {\n            data: xzParams, url: url_text, title: titleName, w: getViewPort().width * 0.85, h: 450, minH: 450\n        };\n        yxscxShowModalDialog(param);\n    }*/\n}\n\nfunction chekQybjDate(formName, sjqName, sjzName, checkbs) {\n    var _name = formName.split(\"-\");\n    var from = $.wingsWidget(_name[0]);\n    var q = from.getValue(sjqName);\n    var z = from.getValue(sjzName);\n    let twoyearsAgo_map = solveDate(24);\n    let msg = \"\";\n    let msg_q = Number(q.replaceAll(\"-\", \"\")) < Number(twoyearsAgo_map.tjnyq.substr(0, 6)) ? \"仅能查询近2年数据\" : \"\";\n    let msg_z = Number(z.replaceAll(\"-\", \"\")) > Number(twoyearsAgo_map.tjnyz.substr(0, 6)) ? \"仅能查询近2年数据\" : \"\";\n    msg = checkNull(msg_q) ? msg_q : (checkNull(msg_z) ? msg_z : \"\");\n    /*20240708临时注释，用于测试*/\n    /*  if (checkNull(msg)) {\n          WingsDialog.alert(msg);\n          if (checkNull(msg_q)) {\n              from.setValue(sjqName, \"\");\n          }\n          if (checkNull(msg_z)) {\n              from.setValue(sjzName, \"\");\n          }\n          return;\n      }*/\n    CheckDate(formName, sjqName, sjzName, checkbs);\n}\n\n\nfunction setQybjcxqz(formName) {\n    var form = $.wingsWidget(formName);\n    let sixmonthsAgo_map = solveDate(7);\n    form.setValue(\"cxqq\", sixmonthsAgo_map.tjnyq.substr(0, 4) + \"-\" + sixmonthsAgo_map.tjnyq.substr(4, 2));\n    form.setValue(\"cxqz\", sixmonthsAgo_map.tjnyz.substr(0, 4) + \"-\" + (sixmonthsAgo_map.tjnyz.substr(4, 2) - 1));\n}\n\nfunction resetQybjqk() {\n    setQybjcxqz(\"qybjcxForm\");\n    $.wingsWidget(\"scxqyghycForm\").clearSetDefValue();\n    $.wingsWidget(\"wmxqyghycForm\").clearSetDefValue();\n    if (checkNull(qylxDm) && qylxDm != \"9\") {\n        if (\"1\" == qylxDm || \"2\" == qylxDm) {\n            $(\"#scqyDiv\").css(\"display\", \"\");//显示\n            $(\"#wmqyDiv\").css(\"display\", \"none\");//显示\n        }\n        if (\"3\" == qylxDm) {\n            $(\"#wmqyDiv\").css(\"display\", \"\");//显示\n            $(\"#scqyDiv\").css(\"display\", \"none\");//显示\n        }\n    } else {\n        $(\"#scqyDiv\").css(\"display\", \"none\");//显示\n        $(\"#wmqyDiv\").css(\"display\", \"none\");//显示\n    }\n}\n\n//生产型企业dataName数组\nlet scqydataNameArr = ['scxqyghycForm', 'scxtqyForm', 'scxtqyzbForm', 'scxtqyjjForm', 'scxtqypjsjForm'];\n//外贸型企业dataName数组\n// let wmqydataNameArr = ['wmxqyghycForm', 'wmxtqyForm', 'wmxtqyzbForm', 'scxtqyjjForm', 'wmxtqyqtForm'];\nlet wmqydataNameArr = ['wmxqyghycForm', 'wmxtqyzbForm', 'wmxtqyjjForm', 'wmxtqyqtForm', 'wmqypjjgsjForm'];\nvar scWmInt = 1;\n\n/**\n * 查询同类型企业比较情况方法\n */\nlet cx_paramsData = {};\n\nfunction queryQybjqk() {\n    //根据qylxDm（企业类型代码）判断该企业是生产企业还是外贸企业 如果企业企业类型代码为空或者为9说明该企业既不是生产企业也不是外贸企业\n    if (checkNull(qylxDm) && qylxDm != \"9\") {\n        cx_paramsData = $.extend(true, {}, paramsData);\n        var from = $.wingsWidget(\"qybjcxForm\");\n        var cxqq = from.getValue(\"cxqq\").replace(/-/g, \"\");\n        var cxqz = from.getValue(\"cxqz\").replace(/-/g, \"\");\n        if (checkNull(cxqq) && checkNull(cxqz)) {\n            cx_paramsData.cxqq = cxqq;\n            cx_paramsData.cxqz = cxqz;\n            //\"1\" == qylxDm || \"2\" == qylxDm 为生产企业，\"3\" == qylxDm外贸企业\n            var resultScOrWm = (\"1\" == qylxDm || \"2\" == qylxDm) ? scqydataNameArr : wmqydataNameArr;\n            cx_paramsData.ckqylxdm = (\"1\" == qylxDm || \"2\" == qylxDm) ? \"'1','2'\" : \"'\" + qylxDm + \"'\";\n            scWmInt = 1;\n            for (var i = 0; i < resultScOrWm.length; i++) {\n                cx_paramsData.result = [{'type': 'form', 'name': resultScOrWm[i]}];\n                _zdySubmit._zdySubmitData(_zdySubmit.createFormDataForName(cx_paramsData, \"scjycxForm\"), \"getQueryData\", \"查询\", \"queryQybjqkSuccess\");\n            }\n        } else {\n            WingsDialog.alert(\"提示\", \"查询期起止不能为空，请先输入\", {\n                onhidden: function () {\n                }\n            });\n            return;\n        }\n    }\n\n}\n\n/**\n * 查询同类企业比较情况成功方法\n * @param res\n */\nfunction queryQybjqkSuccess(res) {\n    openMenban(\"查询中,请稍后。。。\");\n    var resultScOrWm = [];\n    var imgFormName = '';\n    var clickName = '';\n    if (\"1\" == qylxDm || \"2\" == qylxDm) {\n        resultScOrWm = scqydataNameArr;\n        imgFormName = 'scxqyghycForm';\n        clickName = ['scqyckspjj'];\n    } else if (\"3\" == qylxDm) {\n        resultScOrWm = wmqydataNameArr;\n        imgFormName = 'wmxqyghycForm';\n        clickName = ['wmqyckspjj', 'wmqytse', 'wmqypjhhcb', 'wmqypjgjdj'];\n    }\n    //生产/外贸型企业赋值处理\n    $.each(resultScOrWm, function (i, name) {\n        let formData = $pc.getResData(name, res);\n        if (checkNull(formData)) {\n            setformData(imgFormName, name, formData.data);\n        }\n    });\n    if (scWmInt == resultScOrWm.length) {\n        //对生产型企业表格scxqyghycForm 升降图片赋值处理\n        setSjimg(imgFormName);\n        $.each(clickName, function (i, v) {\n            //对生产/外贸型企业“下钻”单击事件处理\n            $(\"#\" + v).css(\"cursor\", \"\");\n            $(\"#\" + v).unbind(\"click\");\n            $(\"#\" + v).css(\"cursor\", \"pointer\");\n            $(\"#\" + v).bind('click', {xztype: v}, openTlxqyxzmx);\n\n            // $(\"#\" + clickName).click(function (text,a,b,c) {\n            //     openTlxqyxzmx();\n            // });\n        })\n\n        offMenban();\n    }\n    scWmInt++;\n}\n\n/**\n * 根据表格名称和dataName和data 对对应表格进行赋值处理方法\n * @param formName\n * @param dataName\n * @param data\n */\nfunction setformData(formName, dataName, data) {\n    let key_arr_tqyf = ['tqydf', 'tqysf', 'tqytrqf', 'tqyyf', 'tqykjrs'];\n    let key_arr_bqy = ['bqydf', 'bqysf', 'bqytrqf', 'bqyyf', 'bqykjrs', 'bqyckspjj', 'bqyckzezb', 'bqypjjgsj'];\n    let key_arr_tqyzb = ['tqyckzezb'];\n    let key_arr_tqypjsj = ['tqypjjgsj'];\n    let key_arr_tqyjj = ['tqyckspjj'];\n    let key_arr_tqyqt = ['tqytse', 'tqypjhhcb'];\n    let key_arr;\n    switch (dataName) {\n        case 'scxqyghycForm':\n            key_arr = key_arr_bqy;\n            break;\n        case 'wmxqyghycForm':\n            key_arr = key_arr_bqy;\n            key_arr.push('bqytse');\n            key_arr.push('bqypjhhcb');\n            break;\n        case 'scxtqyForm' :\n            key_arr = key_arr_tqyf;\n            break;\n        case 'wmxtqyForm':\n            key_arr = key_arr_tqyf;\n            break;\n        case 'scxtqyzbForm' :\n            key_arr = key_arr_tqyzb;\n            break;\n        case 'scxtqypjsjForm' :\n            key_arr = key_arr_tqypjsj;\n            break;\n        case 'wmqypjjgsjForm' :\n            key_arr = key_arr_tqypjsj;\n            break;\n        case 'wmxtqyzbForm':\n            key_arr = key_arr_tqyzb;\n            break;\n        case 'scxtqyjjForm':\n            key_arr = key_arr_tqyjj;\n            break;\n        case 'wmxtqyjjForm':\n            key_arr = key_arr_tqyjj;\n            break;\n        case 'wmxtqyqtForm':\n            key_arr = key_arr_tqyqt;\n            break;\n    }\n    //如果data 不为空对form中的值进行赋值处理\n    if (!$.isEmptyObject(data)) {\n        $.each(data, function (key, map) {\n            var val = (checkNull(map.value) && map.value != '--') ? Number(map.value).toFixed(2) : (map.value == '--' ? '--' : 0.00);\n            if (\"tqyckzezb\" == key || \"bqyckzezb\" == key) {\n                val += \"%\";\n            }\n            $.wingsWidget(formName).setValue(key, val);\n        });\n    } else {\n        //如果data 为空对form中的值进行“--”赋值处理\n        $.each(key_arr, function (i, key) {\n            $.wingsWidget(formName).setValue(key, \"--\");\n        });\n    }\n}\n\n/**\n * 根据forName 对表格中的升降图片设置方法\n * @param formName\n */\nfunction setSjimg(formName) {\n    //生产型企业 form 中的div name前缀\n    let key_arr_sc = ['df', 'sf', 'trqf', 'yf', 'kjrs', 'ckspjj', 'ckzezb', 'pjjgsj'];\n    //外贸型企业 form 中的div name前缀\n    let key_arr_wm = ['ckspjj', 'ckzezb', 'tse', 'pjhhcb', 'pjgjdj', 'pjjgsj'];\n    //生产型、外贸型企业 idStr 判断处理\n    let idStr = (\"scxqyghycForm\" == formName) ? 'sc_img' : 'wm_img';\n    let key_arr = (\"scxqyghycForm\" == formName) ? key_arr_sc : key_arr_wm;\n    //对form中的div 进行值比较，如果本企业的值大于同类型企业就展示上升图片，如果本企业的值小于同类型企业就展示下降图片\n    $.each(key_arr, function (i, key) {\n        let bqyStr = \"bqy\" + key;\n        let tqyStr = \"tqy\" + key;\n        //对form中的本企业和同类企业值 取值\n        let bqyValue = $.wingsWidget(formName).getValue(bqyStr);\n        let tqyValue = $.wingsWidget(formName).getValue(tqyStr);\n        //对form中的本企业、同类企业值比较\n        if ((bqyValue != '--' && tqyValue != '--') && (bqyValue != 0 && tqyValue != 0)) {\n            if (Number(bqyValue.replaceAll('%', '')) > Number(tqyValue.replaceAll('%', ''))) {\n                $(\"#\" + idStr + i).css(\"height\", \"21px\");\n                $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/up.png\");\n            } else if (Number(bqyValue.replaceAll('%', '')) < Number(tqyValue.replaceAll('%', ''))) {\n                $(\"#\" + idStr + i).css(\"height\", \"21px\");\n                $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/down.png\");\n            } else {\n                $(\"#\" + idStr + i).css(\"height\", \"0px\");\n            }\n        } else {\n            if (bqyValue != '--') {\n                //如果本企业值不为“--” 且同类企业为“--” 就展示上升否则展示下降\n                if (tqyValue == '--') {\n                    $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/up.png\");\n                } else {\n                    $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/down.png\");\n                }\n            }\n            if (tqyValue != '--') {\n                if (bqyValue == '--') {\n                    $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/down.png\");\n                } else {\n                    $(\"#\" + idStr + i).attr(\"src\", \"/yxscx/yhscx/dhcx/dhcx009/dhcx009017/img/up.png\");\n                }\n            }\n            //如果 本企业和同类企业都为“--” 就不展示\n            if (bqyValue == '--' && tqyValue == '--') {\n                $(\"#\" + idStr + i).css(\"height\", \"0px\");\n            }\n        }\n    });\n}\n\n/**\n * 点击”同类型企业下钻明细，包含出口商平均价、平均每美元退税额、平均换汇成本、平均购进单价“ 跳转方法\n */\nfunction openTlxqyxzmx(params) {\n    let _xzParam = $.extend({}, cx_paramsData);\n    _xzParam.xztype = params.data.xztype;\n    var param = {\n        data: _xzParam,\n        url: '/yxscx/yhscx/dhcx/dhcx009/dhcx009017/tlxqyxzmx.jsp',\n        title: '明细信息',\n        w: getViewPort().width * 0.85,\n        h: 500,\n        minH: 450\n    };\n    yxscxShowModalDialog(param);\n}\n\nfunction queryCkqyznfxfx() {\n    let sub = new WingsSubmit();\n    sub.setCtrl(\"CktssbqkCtrl_queryCkqyznfxfx\");\n    sub.setFunction(\"onSuccess\", \"queryCkqyznfxfxSuccess()\");\n    sub.setFunction(\"onError\", \"WingsSubmit_onError()\");\n    sub.setFunction(\"onException\", \"WingsSubmit_onError()\");\n    sub.submit();\n}\n\nfunction queryCkqyznfxfxSuccess(res) {\n    path = res.getAttr(\"path\");\n    var kg = res.getAttr(\"kg\");\n    jumpAiReportParam = res.getAttr(\"otherParam\");\n    //判断出口退税tab-概要信息tab-出口企业智能风险分析数据项，可展示用于跳转智能分析报告可见的开关控制\n    //1.系统级全据开关开启 2.配置的跳转路径不为空 3.为出口退税系统接入时\n    let jrxtbm = gyUtils.GetRequest().jrxtbm;\n    if (\"Y\" == kg && !gyUtils.isNull(path) && !gyUtils.isNull(jrxtbm) && jrxtbm == \"WBXT-CKTS\") {\n        $(\"#fxbg1\").show();\n        $(\"#fxbg2\").show();\n    } else {\n        $(\"#fxbg1\").hide();\n        $(\"#fxbg2\").hide();\n    }\n}\n\nfunction ckqyznfxfxXz() {\n    if (path.indexOf(\"#djxh#\")) {\n        path = path.replace(\"#djxh#\", paramsData.djxh);\n    }\n    if (!gyUtils.isNull(jumpAiReportParam)) {\n        let paramStr = new URLSearchParams(JSON.parse(jumpAiReportParam)).toString();\n        if (!gyUtils.isNull(paramStr)) {\n            path = path + \"&\" + paramStr;\n        }\n    }\n    var params = \"\";\n    var id = \"YXSCX-XX-\" + new Date();\n    addTabItemLocalWithUrl(path, params, \"分析报告\", id);\n}\n\n/**\n * WingsSubmit_onError\n * @param res\n * @constructor\n */\nfunction WingsSubmit_onError(res) {\n    var debugObj = {};\n    try {\n        debugObj.exceptionMes = res.exceptionMes;\n        debugObj.debugMes = res.debugMes;\n        WingsDialog.alertDebugMsg(debugObj);\n    } catch (e) {\n        console.log(e);\n    }\n    offMenban();\n}\n"
