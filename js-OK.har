          "content": {
            "size": 15032,
            "mimeType": "text/javascript",
            "compression": 11997,
            "text": "$(function () {\n    \"use strict\";\n    /*日志工具 */\n    var WingsExtConsole = {\n        log: function (a) {\n            try {\n                var b = new Date();\n                if (window.console && window.console.log) {\n                    //console.log(b.toLocaleTimeString() + \" \" + b.getMilliseconds() + \" : \" + a)\n                }\n                return b\n            } catch (e) {\n            }\n        }\n    };\n    WingsExtConsole.log('wings init ext-common begin ...');\n    /*自定义按钮兼容 div[type='button'],button[type='button'],div[data-toggle='buttons']*/\n    $(\"div[type='button'],button[type='button'],div[data-toggle='buttons']\").each(function (i, f) {\n        var h = $(f);\n        var marginleft = h.css(\"margin-left\");\n        if (marginleft == '-120px') {\n            h.css({\n                \"margin-left\": \"-80px\",\n            });\n        }\n        h.css({\n            \"width\": \"max-content\",\n            \"min-width\": \"80px\",\n            \"margin-left\": \"2px\"\n        });\n        var itemSize = h.data(\"size\");\n        if (typeof itemSize == \"undefined\") {\n            h.attr({\n                \"data-size\": \"default\"\n            });\n        }\n        if (h.hasClass(\"btnSave\")) {\n            h.addClass(\"save\");\n        }\n        if (h.hasClass(\"btnReset\")) {\n            h.addClass(\"refresh\");\n        }\n        if (h.hasClass(\"btnDownload\")) {\n            h.addClass(\"export\");\n        }\n        if (h.hasClass(\"btnDownload\")) {\n            h.addClass(\"export\");\n        }\n        if (h.hasClass(\"btnSave\")) {\n            h.addClass(\"save\");\n        }\n        WingsExtConsole.log(h);\n    });\n    $(\"div[data-toggle='buttons']\").each(function (i, f) {\n        var h = $(f);\n        h.css({\n            \"min-width\": \"80px\",\n            \"margin-left\": \"2px\",\n            \"width\": \"99%\"\n        });\n    });\n\n    function processTargetWingsWidget(l) {\n        WingsExtConsole.log('Wings processTargetWingsWidget ext-common begin ...');\n        /*获取公用属性*/\n        var m = {\n            name: l.attr(\"name\"),\n            wings: l.attr(\"wings\"),\n            panel: l.attr(\"panel\"),\n            caption: l.attr(\"caption\")\n        };\n        /*创建包含器*/\n        var hasCaption = true;\n        if (typeof m.caption == \"undefined\") {\n            hasCaption = false;\n        }\n        /* 注释自动加载form、grid表单增加【div-part】属性 */\n        /* var diyheader = $('<div class=\"part_header\"><i></i><span></span></div>');\n         if (hasCaption == true) {\n             m.caption = m.caption.replace(/<i.*\\/>/g, '');\n             diyheader = $('<div class=\"part_header\"><i></i><span>' + m.caption + '</span></div>');\n         }*/\n        var diyPart = $('<div>', {class: \"diy-part\"});\n        /*创建标题部分*/\n\n        /*修改原元素属性*/\n        l.addClass(\"hidden_head\");\n        l.attr({\n            panel: \"false\",\n            border: \"false\"\n        });\n        /*获取显示隐藏状态*/\n        var display = l.css(\"display\");\n        /*if (display == \"none\") {\n            diyPart.css(\"display\", \"none\");\n        }\n        l.wrapAll(diyPart);*/\n\n        var toolbarTarget = \"footWingsToolBar\";\n        var buttonSize = \"default\";\n        var wingsType = 1;\n        if (\"WingsGrid\" == m.wings) {\n            toolbarTarget = \"headWingsToolBar\";\n            buttonSize = \"small\";\n            wingsType = 2;\n        }\n        if (\"WingsForm\" == m.wings) {\n            toolbarTarget = \"footWingsToolBar\";\n            buttonSize = \"default\";\n            wingsType = 1;\n        }\n        /*检查是否绑定了标准工具栏-WingsToolBar*/\n        var targetToolbar = $(\"div[wings='WingsToolBar'][targetWingsWidget='\" + m.name + \"']\");\n        var targetPositionToolbar = {};\n        if (targetToolbar.length > 0) {\n            $.each(targetToolbar, function (i, f) {\n                var toolbar = $(f);\n                toolbar.removeAttr(\"targetWingsWidget\");\n                /*重设工具栏样式*/\n                toolbar.attr({\n                    \"data-target\": toolbarTarget,\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                /*重设按钮样式样式*/\n                toolbar.find(\"div,a\").each(function (i, f) {\n                    var button = $(f);\n                    toolbar.removeAttr(\"targetWingsWidget\");\n                    button.attr({\n                        \"data-size\": buttonSize,\n                        \"data-name\": button.context.getAttribute('type')\n                    });\n\n                    //自定义指定位置放置按钮-1\n                    var tpnw = button.attr('targetPositionWidget');\n                    if (tpnw != 'undefined' || tpnw.length > 0) {\n                        var pnw = $('div[name=\"' + m.name + '\"] div[name=\"' + tpnw + '\"]');\n                        if (pnw.length > 0) {\n                            button.removeAttr(\"targetPositionWidget\");\n                            var h = targetPositionToolbar[tpnw] == undefined ? '' : targetPositionToolbar[tpnw];\n                            targetPositionToolbar[tpnw] = h + button[0].outerHTML;\n                            button.remove();\n                        }\n                    }\n                });\n            });\n\n            //导出按钮添加\n            /*var exportButStr = '<div name=\"exportButton\" type=\"button\" onclick=\"exportPageData()\" class=\"export\" data-size=\"default\" style=\"width: max-content; min-width: 80px; margin-left: 2px;\" data-name=\"button\">导出</div>';\n            targetPositionToolbar.zdyAn = targetPositionToolbar.zdyAn + exportButStr;*/\n\n\n            //自定义指定位置放置按钮-2\n            var targetPositionDiv = $(targetToolbar[0].outerHTML);\n            $.each(targetPositionToolbar, function (n, h) {\n                targetPositionDiv.empty();\n                targetPositionDiv.append(h);\n                $('div[name=\"' + m.name + '\"] div[name=\"' + n + '\"]').append(targetPositionDiv);\n            });\n        }\n\n\n        /*检查是否绑定了非标准按钮-div not wings*/\n        var targetButtonWrapDiv = $(\"div[targetWingsWidget='\" + m.name + \"']\").not(\"[wings]\");\n        if (targetButtonWrapDiv.length > 0) {\n            $.each(targetButtonWrapDiv, function (i, f) {\n                var toolbar = $(f);\n                toolbar.removeAttr(\"targetWingsWidget\");\n                toolbar.attr({\n                    \"data-target\": toolbarTarget,\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                toolbar.css({\n                    position: \"inherit\"\n                });\n                toolbar.find(\"button,a\").each(function (i, f) {\n                    var button = $(f);\n                    button.removeAttr(\"targetWingsWidget\");\n                    button.attr({\n                        \"data-size\": buttonSize,\n                        \"data-name\": button.context.getAttribute('type')\n                    });\n                });\n            });\n        }\n        /*检查是否绑定了非标准按钮-div not Button wapper */\n        var targetButtons = $(\"button[targetWingsWidget='\" + m.name + \"']\");\n        if (targetButtons.length > 0) {\n            $.each(targetButtons, function (i, f) {\n                var toolbar = $(f);\n                toolbar.removeAttr(\"targetWingsWidget\");\n                toolbar.attr({\n                    \"data-target\": toolbarTarget,\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                toolbar.find(\"button,a\").each(function (i, f) {\n                    var button = $(f);\n                    button.removeAttr(\"targetWingsWidget\");\n                    button.attr({\n                        \"data-size\": buttonSize,\n                        \"data-name\": button.context.getAttribute('type')\n                    });\n                });\n            });\n        }\n        var hadDiyheader = false;\n        if (typeof m.panel == \"undefined\") {\n            m.panel = true;\n        }\n        if (!!hasCaption && !!eval(m.panel)) {\n            hadDiyheader = true;\n        }\n        if (1 == wingsType) {\n            if (hadDiyheader == true) {\n                // $(l).parent().prepend(diyheader);\n            }\n            if (targetToolbar.length > 0) $(l).parent().append(targetToolbar);\n            if (targetButtonWrapDiv.length > 0) $(l).parent().append(targetButtonWrapDiv);\n            if (targetButtons.length > 0) $(l).parent().append(targetButtons);\n        }\n        if (2 == wingsType) {\n            if (targetToolbar.length > 0) $(l).parent().prepend(targetToolbar);\n            if (targetButtonWrapDiv.length > 0) $(l).parent().prepend(targetButtonWrapDiv);\n            if (targetButtons.length > 0) $(l).parent().prepend(targetButtons);\n            //$(l).parent().prepend(diyheader);\n        }\n\n        //剔除多余无子元素toolbar\n        for (var i = 0; i < $(\"div[wings='WingsToolBar']\").length; i++) {\n            if ($(\"div[wings='WingsToolBar']\")[i].children.length == 0) {\n                $(\"div[wings='WingsToolBar']\")[i].remove();\n            }\n        }\n\n    }\n\n    function processWingsToolBar(l) {\n        WingsExtConsole.log('Wings init processWingsToolBar ext-common begin ...');\n        var m = {\n            name: l.attr(\"name\"),\n            panel: l.attr(\"panel\"),\n            isFixed: l.attr(\"isFixed\"),\n            caption: l.attr(\"caption\"),\n            targetWingsWidget: l.attr(\"targetWingsWidget\")\n        };\n        if (typeof m.targetWingsWidget != \"undefined\") {\n            return true;\n        }\n        /*兼容直接编写 data-target , */\n        var target = l.data(\"target\");\n        if (typeof target == \"undefined\") {\n            l.attr({\n                \"data-target\": \"footWingsToolBar\",\n            });\n        }\n        l.attr({\n            border: \"false\"\n        });\n        /*复制元素*/\n        var cloneEl = l.clone();\n        cloneEl.empty();\n        var toobars = {};\n        l.find(\"div,a,span\").each(function (i, f) {\n            var button = $(f);\n            button.attr({\n                \"data-size\": \"default\",\n                \"data-name\": button.context.getAttribute('type')\n            });\n            var itemTargetWingsWidget = button.attr(\"targetWingsWidget\");\n            if (typeof itemTargetWingsWidget == \"undefined\") {\n                itemTargetWingsWidget = \"default\";\n            }\n            button.removeAttr(\"targetWingsWidget\");\n            var itemTargetWingsWidgetTools = toobars[itemTargetWingsWidget] || [];\n            itemTargetWingsWidgetTools.push(button.clone());\n            toobars[itemTargetWingsWidget] = itemTargetWingsWidgetTools;\n        });\n        for (var item in toobars) {\n            var cloneElItem = cloneEl.clone();\n            var itemTargetWingsWidgetTools = toobars[item];\n            if (\"default\" == item) {\n                cloneElItem.attr({\n                    \"data-target\": \"footWingsToolBar\",\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                $.each(itemTargetWingsWidgetTools, function (i, v) {\n                    var itemel = $(v);\n                    itemel.attr({\n                        \"data-size\": \"default\"\n                    });\n                    cloneElItem.append(itemel);\n                });\n                /* var diyPart = $('<div>', {class: \"diy-part\"});\n                 diyPart.append(cloneElItem);\n                 var lp = l.parent();\n                 lp.append(diyPart);*/\n                continue;\n            }\n            var fromItem = $(\"div[wings='WingsForm'][name='\" + item + \"']\");\n            if (fromItem.length > 0) {\n                cloneElItem.attr({\n                    \"targetWingsWidget\": item,\n                    \"data-target\": \"footWingsToolBar\",\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                $.each(itemTargetWingsWidgetTools, function (i, v) {\n                    var itemel = $(v);\n                    itemel.attr({\n                        \"data-size\": \"default\"\n                    });\n                    cloneElItem.append(itemel);\n                });\n                //检查元素是否存在 diy-part\n                var haspartEl = fromItem.parent(\".diy-part\");\n                if (haspartEl.length > 0) {\n                    haspartEl.append(cloneElItem);\n                } else {\n                    $(cloneElItem).insertAfter(l);\n                }\n                continue;\n            }\n            var gridItem = $(\"div[wings='WingsGrid'][name='\" + item + \"']\");\n            if (gridItem.length > 0) {\n                cloneElItem.attr({\n                    \"targetWingsWidget\": item,\n                    \"data-target\": \"headWingsToolBar\",\n                    \"isFixed\": \"false\",\n                    \"showType\": \"normal\",\n                });\n                $.each(itemTargetWingsWidgetTools, function (i, v) {\n                    var itemel = $(v);\n                    itemel.attr({\n                        \"data-size\": \"small\"\n                    });\n                    cloneElItem.append(itemel);\n                });\n                //检查元素是否存在 diy-part\n                var haspartEl = gridItem.parent(\".diy-part\");\n                if (haspartEl.length > 0) {\n                    haspartEl.prepend(cloneElItem);\n                } else {\n                    $(cloneElItem).insertAfter(l);\n                }\n                continue;\n            }\n        }\n        l.remove();\n        return true;\n        /*绝对定位处理 不支持\n        if(eval(m.isFixed) == true){\n            l.attr({\n                isfixed: \"false\"\n            });\n            var lp = l.parent();\n            lp.append(l);\n            l.wrapAll(diyPart);\n        }else{\n            var display = l.css(\"display\");\n            if(display == \"none\"){\n                diyPart.css(\"display\",\"none\");\n            }\n            l.wrapAll(diyPart);\n        }*/\n    }\n\n    $(\"div[wings='WingsToolBar']\").each(function (i, f) {\n        var h = $(f).attr(\"wings\");\n        WingsExtConsole.log(h);\n        if (typeof (h) != \"undefined\") {\n            var l = $(f);\n            if (h == \"WingsToolBar\") {\n                processWingsToolBar(l);\n            } else {\n                /**/\n            }\n        }\n    });\n    $(\"div[wings]\").each(function (i, f) {\n        var h = $(f).attr(\"wings\");\n        WingsExtConsole.log(h);\n        if (typeof (h) != \"undefined\") {\n            var l = $(f);\n            if (h == \"WingsForm\") {\n                processTargetWingsWidget(l);\n            } else if (h == \"wingsTree\") {\n                /**/\n            } else if (h == \"WingsGrid\") {\n                processTargetWingsWidget(l);\n            } else if (h == \"WingsSubmit\") {\n                /**/\n            }\n        }\n    });\n    WingsExtConsole.log('wings initData ext-common begin ...');\n});\n\n!(function ($, w) {\n    /**/\n})(jQuery, window);"
          },
