          "content": {
            "size": 2438,
            "mimeType": "text/javascript",
            "compression": 1403,
            "text": ";(function($) {\n\t$.fn.wingsICheck = function(options) {\n\t\t// 设置组件参数\n\t\tvar settings =  $.extend({}, $.fn.wingsICheck.defaults, options);\n\n\t\t//初始化wingsICheck\n\t\t$('input').iCheck(settings);\n\t\t//方法\n\t\tthis.wingsICheck=function(obj,params){\n\t\t\tobj.iCheck(params);\n\t\t};\n\t\t\n\t\t//全选\n\t\tthis.checkAll=function(){\n\t\t\t$(\"input[type='checkbox']\").iCheck(\"check\"); \n\t\t};\n\t\t\n\t    //取消全选\n\t\tthis.removeCheckAll=function(){\n\t\t\t$(\"input[type='checkbox']\").iCheck(\"uncheck\");\n\t\t};\n\t\t\n\t\t//选中奇数\n\t\tthis.checkOdd=function(){\n\t\t\t$(\"input[type='checkbox']:odd\").iCheck(\"check\"); \n\t\t};\n\t\t\n\t\t//选中偶数\n\t\tthis.checkEven=function(){\n\t\t\t$(\"input[type='checkbox']:even\").iCheck(\"check\"); \n\t\t};\n\t\t\n\t\treturn this;\n\t\t\n\t};\n\t// 默认参数\n\t$.fn.wingsICheck.defaults = {\n\t\thandle : '',// 默认值为radio和checkbox，有可选值radio或者checkbox\n\t\tcheckboxClass : 'icheckbox',// 给checkboxj加上checkboxClass样式\n\t\tradioClass : 'iradio',// 给radio加上radioClass样式\n\t\tcheckedClass : 'checked',// 选中(input.checked = true)\n\t\tcheckedCheckboxClass : '',// 如果不是空的，用来代替“checkedclass”选项\n\t\tcheckedRadioClass : '',\n\t\tuncheckedClass : '',// 如果不是空的，在未选中状态添加作为类的名称 (input.checked = false)\n\t\tuncheckedCheckboxClass : '',// 如果不是空的，用来代替“uncheckedclass”选项\n\t\tuncheckedRadioClass : '',\n\t\tdisabledClass : 'disabled',// 禁用状态 (input.disabled = true)\n\t\tdisabledCheckboxClass : '',// 如果不是空的，用来代替“disabledClass”选项'\n\t\tdisabledRadioClass : '',\n\t\tenabledClass : '',// 如果不是空的 表示可用状态(input.disabled = false)\n\t\tenabledCheckboxClass : '',// 如果不是空的，用来代替“ennbledClass”选项'\n\t\tenabledRadioClass : '',\n\t\thoverClass : 'hover',// \"hover\"状态(鼠标移动到input上)\n\t\tfocusClass : 'focus', // 获得焦点\n\t\tactiveClass : 'active',// active状态\n\t\tlabelHover : true,// hoverclass定制输入标签悬停和labelhoverclass标签输入悬停\n\t\tlabelHoverClass : 'hover',// labelhover类添加到标签设置为true\n\t\tincreaseArea : '',// 增加可以点击的区域，用百分比来表示 (负数表示减小)\n\t\tcursor : false,\n\t\tinheritClass : false,// true表示继承原来的input的类\n\t\tinheritID : false,// 如果为true，input的id前缀为iCheck_\n\t\tinsert : ''// insert参数向这个div中放置HTML代码或文本。\n\t};\n\t\n})(window.jQuery);"
          },
