            "mimeType": "text/javascript",
            "compression": 3010,
            "text": "/**\n * select2封装成jquery 插件\n */\n(function($) {\n\t$.fn.wingsMultipleSelector = function(options) {\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsMultipleSelector.defaults, options);\n//\t\tvar outData=opts.data;\n//\t\topts.data = [];\n//\t\tif(outData!=null){\n//\t\t\tfor(var i=0;i<outData.length;i++){\n//\t\t\t\tvar perdata = {\n//\t\t\t\t\t\tid:outData[i].code,\n//\t\t\t\t\t\ttext:outData[i].caption\n//\t\t\t\t}\n//\t\t\t\topts.data.push(perdata);\n//\t\t\t}\n//\t\t}\n\t\t\n\t\tvar $this = $(this);\n\t\tif(opts.data){\n\t\t\t$this.find(\"option\").remove();\n\t\t\tfor(var i=0;i<opts.data.length;i++){\n\t\t\t\tvar text = opts.data[i].caption;\n\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\ttext = opts.data[i].code + '|' +opts.data[i].caption;\n\t\t\t\t}\n\t\t\t\t$this.append('<option value=\"' + opts.data[i].code + '\">' + text + '</option>'); \n\t\t\t}; \n\t\t}\n\t\t\n\t\t// 设置数据方法\n//\t\t\n//\t\tvar select = $this.css('width',opts.width);\n//\t\t$this.select2(opts);\n//\t\tif(opts.value!=null){\n//\t\t\tselect.val(opts.value).trigger(\"change\");\n//\t\t}else{\n//\t\t\tselect.val(null).trigger(\"change\");\n//\t\t}\n//\t\t\n\t\t\n\t\t//onSelect 事件\n\t\tif(opts.onSelect!=null){\n\t\t\t$this.change(function (el) {\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onSelect = wings_getFunc(opts.onSelect);\n\t\t\t\tfor (var b = 0; b < onSelect.length; b++) {\n\t\t\t        var  func = eval(onSelect[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t            \t\tvar result = new func($this.val(),$this.find(\"option:selected\").text());\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t});\n\t\t};\n\t\t\n\t\tthis.getData = function(){\n\t\t\tvar nodes = $this.find(\"option\");\n\t\t\tvar currentData = [];\n\t\t\t$.each(nodes, function(i,item){ \n\t\t\t\tcurrentData[i] = {'code':item.value, 'caption': item.innerHTML};\n\t\t\t});\n\t\t\treturn currentData;\n\t\t};\n\t\t\n\t\tthis.addData = function(data){\n\t\t\tfor(var i=0;i<data.length;i++){\n\t\t\t\tvar text = data[i].caption;\n\t\t\t\tif(data[i].popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\ttext = data[i].code + '|' +data[i].caption;\n\t\t\t\t}\n\t\t\t\t$this.append('<option value=\"' + data[i].code + '\">' + text + '</option>'); \n\t\t\t}; \n\t\t};\n\t\t\n\t\tthis.removeSelectedData = function(){\n\t\t\t$this.find(\"option:selected\").remove();\n\t\t};\n//\t\t\t\n//\t\t\n//\t\t\n//\t\t//获取选中值\n//\t\tthis.getSelections = function(){\n//\t\t\tvar data = [];\n//\t\t\tfor(var i=0;i<select[0].length;i++){\n//\t\t\t\tvar option = $(select[0][i]);\n//\t\t\t\tif(option[0].selected){\n//\t\t\t\t\tdata.push({id:option[0].value,text:option[0].text});\n//\t\t\t\t\tif(!select[0].multiple){\n//\t\t\t\t\t\tbreak;\n//\t\t\t\t\t}\n//\t\t\t\t}\n//\t\t\t}\n//\t\t\tif(select[0].multiple){\n//\t\t\t\treturn data;\n//\t\t\t}else if(data.length>0){\n//\t\t\t\tif(opts.relid != null && opts.relurl !=null){\n//\t\t\t\t$.ajax({\n//\t\t\t\t\turl:opts.relurl,\n//\t\t\t\t\tdata : data[0],\n//\t\t\t\t\ttype:\"POST\",\n//\t\t\t\t\tdataType:'json',\n//\t\t\t\t\tasync:false,\n//\t\t\t\t\tsuccess:function(data){\n//\t\t\t\t\t\t$(\"#\"+opts.relid).data=data;\n//\t\t\t\t\t}\n//\t\t\t\t});\n//\t\t\t}\n//\t\t\t\treturn data[0];\n//\t\t\t}else{\n//\t\t\t\treturn null;\n//\t\t\t}\n//\t\t}\n//\t\tthis.getText = function(){\n//\t\t\tvar text = [];\n//\t\t\tfor(var i=0;i<select[0].length;i++){\n//\t\t\t\tvar option = $(select[0][i]);\n//\t\t\t\tif(option[0].selected){\n//\t\t\t\t\ttext.push(option[0].text);\n//\t\t\t\t\tif(!select[0].multiple){\n//\t\t\t\t\t\tbreak;\n//\t\t\t\t\t}\n//\t\t\t\t}\n//\t\t\t}\n//\t\t\tif(select[0].multiple){\n//\t\t\t\treturn text;\n//\t\t\t}else if(text.length>0){\n//\t\t\t\treturn text[0];\n//\t\t\t}else{\n//\t\t\t\treturn null;\n//\t\t\t}\n//\t\t}\n\t\t\n\t\tthis.convertSword2Normal = function(swordData){\n\t\t\tvar normalData = [];\n\t\t\tif(swordData && swordData.trs){\n\t\t\t\tvar trs = swordData.trs;\n\t\t\t\tfor(var i=0; i<trs.length; i++){\n\t\t\t\t\tvar tds = trs[i].tds;\n\t\t\t\t\tif(tds){\n\t\t\t\t\t\tnormalData[i] = {};\n\t\t\t\t\t\t$.each(tds, function(key, value){\n\t\t\t\t\t\t\tif(value.value)\n\t\t\t\t\t\t\tnormalData[i][key] = value.value;\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn normalData;\n\t\t};\n\t\t\n\t\tthis.getValue = function(){\n\t\t\treturn $this.val();\n\t\t};\n\t\t\n\t\tthis.setValue = function(newValue){\n\t\t\treturn $this.val(newValue).trigger(\"change\");\n\t\t};\n\t\t\n\t\tthis.initData = function(dataObj){\n\t\t\tif(dataObj.data){\n\t\t\t\t$this.find(\"option\").remove();\n\t\t\t\tfor(var i=0;i<dataObj.data.length;i++){\n\t\t\t\t\t$this.append('<option value=\"' + dataObj.data[i].code + '\">' + dataObj.data[i].caption + '</option>'); \n\t\t\t\t}\n\t\t\t}\n\t\t};\n\t\t\n\t\t// add for sword web addTable Method\n\t\tthis.initTableData = function(swordData){\n\t\t\tvar dataObj = {};\n\t\t\tdataObj.data = this.convertSword2Normal(swordData);\n\t\t\tthis.initData(dataObj);\n\t\t};\n\t\t\n\t\treturn this;\n\t};\n\t\n\t\n\t\n\t// 默认设置\n\t$.fn.wingsMultipleSelector.defaults = {\n\t\tvalue : null,\n\t\twidth:'100%',\n\t\tdata : null,\n\t\tparams : null,\n\t\tmultiple:false,\n\t\tplaceholder: \"请选择\",\n\t\tonSelect:null,\n\t\trelid:null,\n\t\trelurl:null,\n\t\tdataName:null\n\t};\n})(window.jQuery);"
          },
