          "content": {
            "size": 20408,
            "mimeType": "text/javascript",
            "compression": 15125,
            "text": "/**\n * select2封装成jquery 插件\n */\n(function($) {\n\t$.fn.wingsSelector = function(options) {\n\t\tvar $selectObj = $(this);\n\t\t\n\t\t// 参数赋值\n\t\tvar opts = $.extend({}, $.fn.wingsSelector.defaults, options);\n\t\t\n\t\topts.baseData = opts.data; \n\t\t\t\t\n\t\t//默认值\n\t\t$selectObj.valueObj = {\n\t\t\tcode:'',\n\t\t\tcaption:''\n\t\t}\n\t\t\n\t\t$selectObj.setRule = function(rules){\n\t\t\topts.rules = rules;\n\t\t};\n\t\t//公共校验方法(传递必要参数即可)\n\t\t$selectObj.validObj = function(){\n  \t\t\t//调用校验规则\n\t\t\tif(opts.isNewValidate == \"true\" && opts.rules && opts.rules.length > 0){\n\t\t\t\treturn $.wingsValidate2.validObj(opts.v_id, $selectObj ,$selectObj.getValue() ,opts.rules);\n\t\t\t}\n\t\t}\n\t\t\n\t\t//创建整个wingsSelect 对象\n\t\t$selectObj.build_selectbox = function(){\n\t\t\tif(options.required == \"required\"){\n\t\t\t\tvar tempV = ' required=\"required\" '\n\t\t\t}\n\t\t\t//创建\n\t\t\t$selectObj._table = $('<table class=\"wingsSelect-table\"><tr><td class = \"wingsSelect-td1\"><input type=\"text\" autocomplete=\"off\"'+tempV+' name=\"'+opts.name+'\" class=\"wingsInput wingsSelect_input_self\" /></td><td class = \" x-trigger-cell x-unselectable\"><div class = \"wingsSelect_down_img wingsSelect_down_img_self\"></div></td></tr></table>');\n\t\t\t\n  \t\t\t//追加校验属性\n  \t\t\t$(this).addClass(\"wdl\");\n\t\t\t$(this).append($selectObj._table);\n\t\t\t$selectObj._input = $(this).find(\".wingsInput\");\n\t\t\t$selectObj._btDiv = $(this).find(\".wingsSelect_down_img\");\n\t\t\t\n\t\t\tif($(this).parent().attr(\"inputreadonly\") == \"true\"){\n\t\t\t\t$selectObj._input.attr(\"readonly\",\"true\");\n\t\t\t}\n\t\t\t\n\t\t\t//追加属性，使chrome下不再出现提示信息\n\t\t\t$selectObj._input.attr('autocomplete','off');\n\t\t\t\n\t\t\tif (opts.placeholder) {\n\t\t\t\t$selectObj._input.attr('placeholder', opts.placeholder);\n\t\t\t}else if(\"undefined\" != typeof $wings_pulltree_select_placeholder ){\n\t\t\t\t$selectObj._input.attr('placeholder', $wings_pulltree_select_placeholder);\n\t\t\t}\n\t\t\t\n\t\t\t$selectObj.createBoxDiv();\n\t\t\t\n\t\t\t$selectObj._btDiv.on('click',function(e){\n\t\t\t\tif($selectObj.disableFlag !== \"true\"){\n\t\t\t\t\t$selectObj._input.focus();\n\t\t\t\t\t$selectObj._input.click();\n\t\t\t\t}\n\t\t\t})\n\t\t\t$selectObj._input.on('click',function(e){\n\t\t\t\t$selectObj.show(e);\n\t\t\t})\n\t\t\t$selectObj._input.on('change',function(){\n\t\t\t\tif((opts.handInput == \"false\")&&($selectObj.display != true)){\n\t\t\t\t\tvar index = \"\";\n\t\t\t\t\tvar same_data = \"\";\n\t\t\t\t\tvar current_data = $(this).val();\n\t\t\t\t\tif(current_data == \"\"){\n\t\t\t\t\t\t$selectObj._saveValueByObj(\"\",\"\",null);\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}else{\n\t\t\t\t\t\tvar flag = false ;\n\t\t\t\t\t\t$.each(opts.data,function(i,e){\n\t\t\t\t\t\t\tif(e.caption.indexOf(current_data) != \"-1\"){\n\t\t\t\t\t\t\t\tindex = i;\n\t\t\t\t\t\t\t\tflag = true;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif(e.code.indexOf(current_data) != \"-1\"){\n\t\t\t\t\t\t\t\tindex = i;\n\t\t\t\t\t\t\t\tflag = true;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t})\n\t\t\t\t\t}\n\t\t\t\t\tif(!flag){\n\t\t\t\t\t\t$selectObj._saveValueByObj(\"\",\"\",null);\n\t\t\t\t\t}else{\n\t\t\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\t\t\tsame_data = opts.data[index].code + '|' + opts.data[index].caption;\n\t\t\t\t\t\t}else if(opts.popDisplay == \"{caption}\"){\n\t\t\t\t\t\t\tsame_data =  opts.data[index].caption;\n\t\t\t\t\t\t}else if(opts.popDisplay == \"{code}\"){\n\t\t\t\t\t\t\tsame_data =  opts.data[index].code; \n\t\t\t\t\t\t}\n\t\t\t\t\t\t$selectObj._saveValueByObj(opts.data[index].code,same_data,opts.data[index]);\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif((opts.handInput == \"true\")&&($selectObj.display != true)){\n\t\t\t\t\tvar current_data = $(this).val();\n\t\t\t\t\t$selectObj._saveValueByObj(current_data,current_data,null);\t\n\t\t\t\t\t\n\t\t\t\t}\n\t\t\t})\n\t\t\t$selectObj._input.on(\"blur\",function(e){\n    \t\t\tif($selectObj.display == true){\n\t    \t\t\tif(opts.selectLeaveSign == false && opts.leaveSign == false){\n\t    \t\t\t\t//完全脱离了下拉框选择区域\n\t    \t\t\t\t\t$selectObj.hide(e);\n\t    \t\t\t}\n\t    \t\t\tif(opts.selectLeaveSign == false && opts.leaveSign == true){\n\t    \t\t\t\t//点击下拉框选择区域的滑动窗口\n\t\t\t\t\t\t$selectObj._input.focus();\n\t    \t\t\t}\n    \t\t\t}\n    \t\t\t$selectObj.validObj();\n\t\t\t});\n\t\t\t$selectObj._input.on('keyup',function(event){\n\t\t\t\t$selectObj.change_item_on_keyup(event);\n\t\t\t\t$selectObj.validObj();\n\t\t\t})\n\t\t\t\n\t\t};\n\t\t//创建下拉选择框外层Div\n\t\t$selectObj.createBoxDiv = function(){\n\t        $selectObj.box_div =$('<div class=\"wingsSelect-list\"><div class=\"wingsSelect-list-inner\" ></div></div>');\n\t        $selectObj.selectbox  = $selectObj.box_div.children(\".wingsSelect-list-inner\");\n\t\t\t$('body').append($selectObj.box_div);\n\t\t\t$selectObj.box_div.css({\n\t\t\t\tdisplay:'none'\n\t\t\t})\n\t\t\t//添加显示隐藏事件\n\t\t\t$selectObj.box_div .on(\"mouseenter\",function(e){\n\t\t\t\topts.leaveSign = true;\n\t\t\t});\n\t\t\t$selectObj.box_div .on(\"mouseleave\",function(e){\n\t\t\t\topts.leaveSign = false;\n\t\t\t});\n\t\t\t$selectObj.selectbox .on(\"mouseenter\",function(e){\n\t\t\t\topts.selectLeaveSign = true;\n\t\t\t});\n\t\t\t$selectObj.selectbox .on(\"mouseleave\",function(e){\n\t\t\t\topts.selectLeaveSign = false;\n\t\t\t});\n\t\t};\n\t\t//创建下拉选择框，里面的选项\n\t\t$selectObj.build_options = function(e){\n\t\t\tif($selectObj.selectbox){\n//\t\t\t\tif(opts.placeholder){\n//\t\t\t\t\topts.data.unshift({code:\"\",caption:\"-请选择-\" });\n//\t\t\t\t}\n\t\t\t\t//解决grid下，没有值的时候报错\n\t\t\t\tif(opts.data == null){\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\t$.each(opts.data ,function(i,obj){\n\t\t\t\t\tvar code = obj.code;\n\t\t\t\t\t\n\t\t\t\t\tvar title = obj.caption;\n\t\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\t\ttitle = obj.code + '|' +obj.caption;\n\t\t\t\t\t}else if(opts.popDisplay == \"{caption}\"){\n\t\t\t\t\t\ttitle = obj.caption;\n\t\t\t\t\t}else if(opts.popDisplay == \"{code}\"){\n\t\t\t\t\t\ttitle = obj.code; \n\t\t\t\t\t}\n\t\t\t\t\t//增加下拉显示title设置属性inputDisplay\n\t\t\t\t\tvar xltitle = obj.caption;\n\t\t\t\t\tif(opts.inputDisplay == \"{code}|{caption}\"){\n\t\t\t\t\t\txltitle = obj.code + '|' +obj.caption;\n\t\t\t\t\t}else if(opts.inputDisplay == \"{caption}\"){\n\t\t\t\t\t\txltitle = obj.caption;\n\t\t\t\t\t}else if(opts.inputDisplay == \"{code}\"){\n\t\t\t\t\t\txltitle = obj.code; \n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tvar temp_id = obj.code;\n\t\t\t\t\tif(opts.submitcontent == \"{code}|{caption}\"){\n\t\t\t\t\t\ttemp_id = obj.code + '|' +obj.caption;\n\t\t\t\t\t}else if(opts.submitcontent == \"{caption}\"){\n\t\t\t\t\t\ttemp_id = obj.caption;\n\t\t\t\t\t}else if(opts.submitcontent == \"{code}\"){\n\t\t\t\t\t\ttemp_id = obj.code;\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\t//设置不可使用\n\t\t\t\t\tvar disableClass = \"\";\n\t\t\t\t\tif(\"true\" == obj.disable){\n\t\t\t\t\t\tdisableClass = \"wingsSelect-disable-class\";\n\t\t\t\t\t};\n\t\t\t\t\t\n\t\t\t\t\tvar divObj = $('<div title=\"' + title +'\" ' +\n\t\t\t\t\t' text =\"' + title +'\" ' +\n\t\t\t\t\t' code=\"' + temp_id +'\" ' +\n\t\t\t\t\t' caption =\"' + title +'\" ' +\n\t\t\t\t\t' index =\"'+ i +'\"' +\n\t\t\t\t\t' class =\"wingsSelect-list-item ' + disableClass + '\" >' + xltitle +'</div>');\n\t\t\t\t\t\n\t\t\t\t\tdivObj.on('mouseover',function(e){\n\t\t\t\t\t\tvar obj = $(e.target);\n\t\t\t\t\t\tif(!obj.hasClass('wingsSelect-disable-class')){\n\t\t\t\t\t\t\tobj.addClass('wingsSelect-selected');\n\t\t\t\t\t\t}\n\t\t\t\t\t}).on('mouseout',function(e){\n\t\t\t\t\t\t$(e.target).removeClass('wingsSelect-selected');\n\t\t\t\t\t});\n\t\t\t\t\t\n\t\t\t\t\tdivObj.on('click',function(e){\n\t\t\t\t\t\tvar obj = $(e.target);\n\t\t\t\t\t\tif(!obj.hasClass('wingsSelect-disable-class')){\n\t\t\t\t\t\t\t//设置值by obj\n\t\t\t\t\t\t\t$selectObj._saveValueByObj($(obj).attr('code'),$(obj).attr('caption'),$(obj));\n\t\t\t\t\t\t\t//关闭下拉框\n\t\t\t\t\t\t\t$selectObj.hide(e,\"true\");\n\t\t\t\t\t\t\t//校验\n\t\t\t\t\t\t\t$selectObj.validObj();\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t$selectObj._input.focus();\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t\t$selectObj.selectbox.append(divObj);\n\t\t\t\t})\n\t\t\t}\n\t\t};\n\t\t\n\t\t//设置值by obj\n\t\t$selectObj._saveValueByObj= function(code , caption,$obj){\n\t\t\tvar showCaption = caption\n\t\t\tif ($selectObj._input && $selectObj.valueObj) {\n\t\t\t\t// 允许自定义显示值\n\t\t\t\tif (opts.showFilter != null) {\n\t\t\t\t\t// 执行前方法\n\t\t\t\t\tvar onShowFilter = wings_getFunc(opts.showFilter);\n\t\t\t\t\tfor (var b = 0; b < onShowFilter.length; b++) {\n\t\t\t\t\t\tvar func = eval(onShowFilter[b]);\n\t\t\t\t\t\tif (typeof func == \"function\") {\n\t\t\t\t\t\t\tshowCaption = func(caption);\n\t\t\t\t\t\t};\n\t\t\t\t\t};\n\t\t\t\t};\n\t\t\t}\n\t\t\t$selectObj._input.val(showCaption);\n\t\t\t\n\t\t\t//值保存起来\n\t\t\t$selectObj.valueObj = {\n\t\t\t\tcode:code,\n\t\t\t\tcaption:caption\n\t\t\t}\n\t\t\t\n\t\t\tif(opts.onSelect!=null && opts.onDtHide == null){\n\t\t\t\t//alert(el.params.data.id + '=' + el.params.data.text );\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onSelect = wings_getFunc(opts.onSelect);\n\t\t\t\tfor (var b = 0; b < onSelect.length; b++) {\n\t\t\t        var  func = eval(onSelect[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t\t\t\t    \tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t    \t\tvar realCaption = \"\";\n\t\t\t\t    \t\tif($selectObj.valueObj.caption != \"\"){\t\n\t\t\t\t    \t\t\t//处理caption中包含\"|\"\n\t\t\t\t    \t\t\tvar start = $selectObj.valueObj.caption.indexOf(\"|\");\n\t\t\t\t    \t\t\trealCaption = $selectObj.valueObj.caption.substring(start);\n\t\t\t\t    \t\t}\n\t\t\t\t    \t\tvar result = new func($selectObj.valueObj.code,realCaption, opts.data);\n\t\t\t\t    \t}else if(opts.popDisplay == \"{code}\"){\n\t\t\t\t    \t\tvar realCaption = \"\";\n\t\t\t\t    \t\tfor(var i in opts.data){\n\t\t\t\t\t\t\t\tvar obj = opts.data[i];\n\t\t\t\t\t\t\t\tif(obj.code && obj.code == $selectObj.valueObj.code){\n\t\t\t\t\t\t\t\t\trealCaption = obj.caption;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t    \t\tvar result = new func($selectObj.valueObj.code,realCaption, opts.data);\n\t\t\t\t    \t}else{\n\t\t\t\t    \t\tvar result = new func($selectObj.valueObj.code,$selectObj.valueObj.caption, opts.data);\n\t\t\t\t    \t}\t\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t};\n\t\t\t//保存当前选中的选项\n\t\t\t//$selectObj.currentElement = $obj;\n\t\t}\n\t\t\n\t\t//显示下拉选择框\n\t\t$selectObj.show = function(e){\n\t\t\tif(!$selectObj.display || $selectObj.display == false){\n\t\t\t\t$selectObj.reBuild(e);//每次点击都重建下拉框\n\t\t\t}\n\t\t\tif($selectObj._input){\n\t\t\t\t$selectObj._input.focus();\n\t\t\t}\n\t\t\t//onshow方法\n            //this.selDiv.addClass(\"swordselect-selimg-over\");\n\t\t\t\n\t\t\tif($selectObj.selectbox && $selectObj.valueObj){\n                $selectObj.def_select($selectObj.valueObj.code);\n\t\t\t}\n\t\t\t$selectObj.display = true;\n\t\t};\n\t\t\n\t\t//设置选中的值高亮\n\t\t$selectObj.def_select = function(code){\n\t\t\t$selectObj.selectbox.find(\".wingsSelect-list-item\").each(function(i,obj){\n\t\t\t\tvar objCode = $(obj).attr(\"code\");\n\t            $(obj).removeClass(\"wingsSelect-selected-fix\");\n\t\t\t\tif(objCode && objCode == code){\n\t\t\t\t\t//保存当前选中的选项\n\t                $selectObj.currentElement = $(obj).addClass(\"wingsSelect-selected-fix\");\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t\t\n\t\t//隐藏下拉选择框\n\t\t$selectObj.hide = function(e,flag){\n\t\t\t//隐藏下拉框\n\t\t\t$selectObj.display = false;//\n\t\t\t$selectObj.box_div.css({\n\t\t\t\tdisplay:'none'\n\t\t\t})\n\t\t\t//消失时默认选一个\n\t\t\tif(flag!==\"true\"){\n            \t//var a = $selectObj.selectbox.find(\".wingsSelect-selected-none\");\n\t\t\t\tvar value = $selectObj._input.val();\n\t\t\t\tif(value && value!=\"\"){\n\t\t\t\t\tvar fixObj = null;\n\t\t\t\t\t$selectObj.selectbox.find(\".wingsSelect-selected-fix\").each(function(i,obj){\n\t\t\t\t\t\tfixObj = i;\n\t\t\t\t\t});\n\t\t\t\t\tif(fixObj!= null){\n\t\t\t\t\t\t//如果选中标记还在，则不变（即没有输入任何值）\n\t\t\t\t\t}else{\n\t\t\t\t\t\tif(opts.handInput == \"true\"){\n\t\t\t\t\t\t\t$selectObj._saveValueByObj(value,value,null);\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t//如果不在，则取最接近的值\n\t\t\t\t\t\t\tvar temp =null;\n\t\t\t\t\t\t\t$selectObj.selectbox.find(\".wingsSelect-list-item\").not(\".wingsSelect-selected-none\")\n\t\t\t\t\t\t\t.not(\".wingsSelect-disable-class\").each(function(i,obj){\n\t\t\t\t\t\t\t\tif(i==0){\n\t\t\t\t\t\t\t\t\ttemp = $(obj);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\tif(temp){\n\t\t\t\t\t\t\t\t//设置值 by obj\n\t\t\t\t\t\t\t\t$selectObj._saveValueByObj(temp.attr('code'),temp.attr('caption'),temp);\n\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t$selectObj._saveValueByObj('','',null);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\t//为空的时候\n\t\t\t\t\t$selectObj.valueObj = {\n\t\t\t\t\t\tcode:'',\n\t\t\t\t\t\tcaption:''\n\t\t\t\t\t}\n\t\t\t\t\t$selectObj._saveValueByObj('','',null);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\t//触发隐藏事件\t\t\t\n\t\t\tif(opts.onDtHide!=null){\n\t\t\t\t//alert(el.params.data.id + '=' + el.params.data.text );\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onDtHide = wings_getFunc(opts.onDtHide);\n\t\t\t\tfor (var b = 0; b < onDtHide.length; b++) {\n\t\t\t        var  func = eval(onDtHide[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t\t\t\t    \tvar code,caption;\n\t\t\t\t    \tif($selectObj.valueObj){\n\t\t\t\t    \t\tcode = $selectObj.valueObj.code;\n\t\t\t\t    \t\tcaption = $selectObj.valueObj.caption;\n\t\t\t\t    \t}\n\t            \t\tvar result = new func(code,caption,opts.data);\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t};\n\t\t\t\n\t\t};\n\t\t\n\t\t//重建selectbox\n\t\t$selectObj.reBuild = function(e){\n\t\t\tif ($selectObj.selectbox){\n\t\t\t\t$selectObj.selectbox.find('div').each(function(i,obj){\n\t\t\t\t\t$(obj).remove();\n\t\t\t\t})\n\t\t\t};\n\t\t\t//dataFilter方法设置过滤方法 \n\t\t\tif(opts.dataFilter!=null ){\n  \t\t\t\t//执行前方法\n  \t\t\t\tvar onDataFilter = wings_getFunc(opts.dataFilter);\n\t\t\t\tfor (var b = 0; b < onDataFilter.length; b++) {\n\t\t\t        var  func = eval(onDataFilter[b]);\n\t\t\t\t    if (typeof func == \"function\") {\n\t            \t\topts.data = new func(opts.baseData);\n\t\t\t       \t};\n\t\t\t    };\n\t\t\t};\n\t\t\t\n\t\t\t\n\t\t\t$selectObj.build_options(e);\n\t\t\tif(e && e.target){\n\t\t\t\tvar obj = $(e.target);\n  \t\t\t\tvar width = opts.dataWidth?opts.dataWidth : obj.outerWidth()+19;\n  \t\t\t\tvar height = opts.dataHeight?opts.dataHeight:\"\";\n  \t\t\t\t//设置默认行高 默认为5行\n  \t\t\t\tif(!opts.dataHeight && opts.data && opts.data.length >5 && $selectObj._input){\n  \t\t\t\t\tvar tempHeight = 0;\n//  \t\t\t\t\t$selectObj.selectbox.find(\".wingsSelect-list-item\").each(function(i,obj){\n//  \t\t\t\t\t\tif(i<5){\n//\t  \t\t\t\t\t\tvar temp = $(obj).css(\"height\");\n//\t  \t\t\t\t\t\tif(temp){\n//\t  \t\t\t\t\t\t\ttemp = temp.replace(\"px\",\"\");\n//\t  \t\t\t\t\t\t\ttempHeight += Number(temp);\n//\t  \t\t\t\t\t\t}\n//  \t\t\t\t\t\t}\n//  \t\t\t\t\t})\n  \t\t\t\t\tvar temp = $selectObj._input.css(\"height\");\n  \t\t\t\t\tif(temp){\n  \t\t\t\t\t\ttemp = temp.replace(\"px\",\"\");\n  \t\t\t\t\t\ttempHeight = Number(temp) * 5;\n  \t\t\t\t\t}\n  \t\t\t\t\t\n  \t\t\t\t\tif(tempHeight != 0){\n  \t\t\t\t\t\theight = tempHeight;\n  \t\t\t\t\t}\n  \t\t\t\t}\n  \t\t\t\t//height = height == \"\"? $selectObj._input.css(\"height\"):height;\n\t\t\t\tvar top = $selectObj._input.offset().top +$selectObj._input.outerHeight()+ \"px\";\n\t\t\t\t\n\t\t\t\tif( opts.upDown == 'up'){\n\t\t\t\t\t//显示在上方\n\t\t\t\t\t/*var temp = $selectObj.box_div.css(\"height\");\n\t  \t\t\t\tif(temp){\n\t  \t\t\t\t\ttemp = temp.replace(\"px\",\"\");\n\t  \t\t\t\t}\n\t\t\t\t\ttop = $selectObj._input.offset().top - temp + \"px\";*/\n\t\t\t\t\t//原来写法取出的temp高度不正确\n\t\t\t\t\tvar upHeight = $selectObj._input.css(\"height\");\n\t\t\t\t\tif(opts.data.length > 5){\n                        upHeight = Number(upHeight.replace(\"px\",\"\")) * 5;\n\t\t\t\t\t}else{\n                        upHeight = Number(upHeight.replace(\"px\",\"\")) * opts.data.length;\n\t\t\t\t\t}\n\n\t\t\t\t\theight = height == \"\" ? upHeight :height;\n\t\t\t\t\ttop = eval($selectObj._input.offset().top -height) + \"px\";\n\t\t\t\t}\n\t\t\t\tvar left= $selectObj._input.offset().left + \"px\";\n\t\t\t\t$selectObj.box_div.css({\n\t\t\t\t\tdisplay:'',\n\t\t\t        width : width,\n\t\t\t        height: height,\n\t\t\t        top:    top,\n\t\t\t        left:   left,\n\t\t\t        \"word-break\":\"keep-all\",\n\t\t\t\t    \"white-space\":\"nowrap\"\n\t\t\t\t})\n\t\t\t}\n\t\t};\n\t\t\n\t\t\n\t\t$selectObj.getSelectedObj = function(){\n\t\t\tvar res = [];\n\t\t\tif($selectObj.valueObj){\t\t\t\t\n\t\t\t\t$.each(opts.data ,function(i,obj){\n\t\t\t\t\tif(opts.submitcontent == \"{caption}\"){\n\t\t\t\t\t\tif(obj.caption && obj.caption  == $selectObj.valueObj.caption){\n\t\t\t\t\t\t\tres.push(obj);\n\t\t\t\t\t\t}\t\n\t\t\t\t\t}else{\n\t\t\t\t\t\tif(obj.code && obj.code  == $selectObj.valueObj.code){\n\t\t\t\t\t\t\tres.push(obj);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\t\t\t\t\t\n\t\t\t\t})\n\t\t\t}\n\t\t\t\n\t\t\treturn res;\n\t\t}\n\t\t\n\t\t$selectObj.getValue = function(){\n\t\t\tvar temp;\n\t\t\tif($selectObj.valueObj){\n\t\t\t\ttemp = $selectObj.valueObj.code;\n\t\t\t}\n\t\t\treturn temp;\n\t\t};\n\t\t$selectObj.getText= function(){\n\t\t\tvar temp;\n\t\t\tif($selectObj.valueObj){\n\t\t\t\ttemp = $selectObj.valueObj.caption;\n\t\t\t}\n\t\t\treturn temp;\n\t\t};\n\t\t$selectObj.getShowValue = function(){\n\t\t\tvar temp;\n\t\t\tif($selectObj.valueObj){\n\t\t\t\ttemp = $selectObj.valueObj.caption;\n\t\t\t}\n\t\t\treturn temp;\n\t\t};\n\t\t\n\t\t$selectObj.setValue = function(code){\n\t\t\t//过滤data值，然后设置值\n\t\t\tvar date = {code:'',\n\t\t\t\tcaption:''}\n\t\t\tfor(var i in opts.data){\n\t\t\t\tvar obj = opts.data[i];\n\t\t\t\tif(obj.code && obj.code == code){\n\t\t\t\t\tdate = {\n\t\t\t\t\t\tcode:obj.code,\n\t\t\t\t\t\tcaption: _wingsSelformatCaption(obj.caption)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar temp_id = \"\";\n\t\t\tvar title = \"\";\n\t\t\tif(code && code!=''){\n\t\t\t\ttitle = date.caption;\n\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\ttitle = date.code + '|' +date.caption;\n\t\t\t\t}else if(opts.popDisplay == \"{caption}\"){\n\t\t\t\t\ttitle = date.caption;\n\t\t\t\t}else if(opts.popDisplay == \"{code}\"){\n\t\t\t\t\ttitle = date.code; \n\t\t\t\t}\n\t\t\t\t\n\t\t\t\ttemp_id = date.code;\n\t\t\t\tif(opts.submitcontent == \"{code}|{caption}\"){\n\t\t\t\t\ttemp_id = date.code + '|' +date.caption;\n\t\t\t\t}else if(opts.submitcontent == \"{caption}\"){\n\t\t\t\t\ttemp_id = date.caption;\n\t\t\t\t}else if(opts.submitcontent == \"{code}\"){\n\t\t\t\t\ttemp_id = date.code;\n\t\t\t\t}\n\t\t\t}\n\t\t\t\t\t\n\t\t\t$selectObj.valueObj = {\n\t\t\t\tcode:temp_id,\n\t\t\t\tcaption:title\n\t\t\t}\n\t\t\t\n\t\t\tif($selectObj._input && $selectObj.valueObj){\n\t\t\t\tvar showCaption = $selectObj.valueObj.caption\n\t\t\t\tif ($selectObj._input && $selectObj.valueObj) {\n\t\t\t\t\t// 允许自定义显示值\n\t\t\t\t\tif (opts.showFilter != null) {\n\t\t\t\t\t\t// 执行前方法\n\t\t\t\t\t\tvar onShowFilter = wings_getFunc(opts.showFilter);\n\t\t\t\t\t\tfor (var b = 0; b < onShowFilter.length; b++) {\n\t\t\t\t\t\t\tvar func = eval(onShowFilter[b]);\n\t\t\t\t\t\t\tif (typeof func == \"function\") {\n\t\t\t\t\t\t\t\tshowCaption = func(caption);\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t};\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\t$selectObj._input.val(showCaption);\n\t\t\t}\n\t\t}\n\t\t\n\t\t//设置不可用\n\t\t$selectObj.setDisable = function(){\n\t\t\t$selectObj.disableFlag = \"true\";\n\t        $selectObj._input.attr('disabled',\"true\");\n\t\t}\n\t\t//设置可用\n\t\t$selectObj.setEnable = function(){\n\t\t\t$selectObj.disableFlag = \"false\";\n\t        $selectObj._input.attr('disabled',null);\n\t\t}\n\t\t\n\t\t$selectObj.initData = function(opt,parem){\n\t\t\t//设置加载数据\n\t\t\tif(opt){\n\t\t\t\topts.baseData = opt.data; \n\t\t\t\topts.data = opt.data;\n\t\t\t}\n\t\t\t//默认值\n\t\t\tif(opts.defValue){\n\t\t\t\t$selectObj.setValue(opts.defValue);\n\t\t\t}\n\t\t}\n\t\t//设置下拉框内容byJson\n\t\t$selectObj.initDataByJson = function(jsonStr){\n\t\t\t//设置加载数据\n\t\t\tif(jsonStr){\n\t\t\t\topts.baseData = $.parseJSON(jsonStr);\n\t\t\t\topts.data = $.parseJSON(jsonStr);\n\t\t\t}\n\t\t}\n\t\t\n\t\t//调用创建方法，生成select\n\t\t$selectObj.build_selectbox ();\n\t\t\n\t\tif(opts.disable == \"true\" ){\n\t\t\t$selectObj.setDisable();\n\t\t}\n\t\t\n\t\t$selectObj.change_item_on_keyup = function(g){\n\t        if (g.key == \"tab\") {\n\t            return true;\n\t        };\n\t        if (g.key == \"Enter\") {\n\t        \t//追加回车事件\n\t    \t\t$selectObj.hide();\n\t            return true;\n\t        };\n\t        if (g.key == \"esc\") {\n\t            $selectObj.hide();\n\t            return true;\n\t        };\n\t        $selectObj.change_element_by_char();\n\t\t}\n\t\t\n\t    $selectObj.change_element_by_char = function() {\n\t    \t\n            $selectObj.selectbox.find(\".wingsSelect-selected-fix\").removeClass(\"wingsSelect-selected-fix\");\n            \n\t        var a = $selectObj._input.val();\n\t        $selectObj.filterSelectBox(a)\n\t    }\n\t    $selectObj.filterSelectBox = function(a) {\n\t    \t$selectObj.selectbox.find('div').each(function(i,obj){\n\t\t\t\tvar caption = $(obj).attr(\"caption\");\n\t\t\t\tvar code = $(obj).attr(\"code\");\n\t\t\t\t//增加popdisplay判断\n\t\t\t\tif(opts.popDisplay == \"{code}|{caption}\"){\n\t\t\t\t\tcaption = caption + code;\n\t\t\t\t}\n\t\t\t\tvar text = $(obj).attr(\"text\");\n\t            if (caption.indexOf(a) == -1 && text.indexOf(a) == -1) {\n\t                $(obj).addClass(\"wingsSelect-selected-none\")\n\t            } else {\n\t                $(obj).removeClass(\"wingsSelect-selected-none\")\n\t            };\n\t            //不可用的选项，搜索不出现\n\t            if($(obj).hasClass('wingsSelect-disable-class')){\n\t                $(obj).addClass(\"wingsSelect-selected-none\")\n\t            }\n\t\t\t});\n\t    }\n\t\t\n\t \t//select销毁方法\n\t\t$selectObj.destroy = function(){\n\t\t\tif ($selectObj.selectbox){\n\t\t\t\t$selectObj.selectbox.find('div').each(function(i,obj){\n\t\t\t\t\t$(obj).remove();\n\t\t\t\t})\n\t\t\t\t//添加显示隐藏事件\n\t\t\t\t$selectObj.selectbox .off(\"mouseenter\");\n\t\t\t\t$selectObj.selectbox .off(\"mouseleave\");\n\t\t\t};\n\t\t\tif ($selectObj.box_div){\n\t\t\t\t$selectObj.box_div.remove();\n\t\t\t}\n    \t\t\n\t\t\t$.each(opts,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$.each($selectObj,function(k,v){\n\t\t\t\tv = null;\n\t\t\t});\n\t\t\t$selectObj.remove();\n\t\t\t$selectObj = null;\n\t\t};\n\t\t\n\t\treturn $selectObj;\n\t\t\n\n\t};\n\t\n\t\n\t\n\t// 默认设置\n\t$.fn.wingsSelector.defaults = {\n\t\turl : null,\n\t\tvalue : null,\n\t\tselectLeaveSign:false,\n\t\tleaveSign:false,\n\t\twidth:'100%',\n\t\tdata : null,\n\t\tbaseData : null,\n\t\tparams : null,\n\t\tmultiple:false,\n\t\tplaceholder: \"请选择\",\n\t\t//tokenSeparators: [',', ' '],\n\t\tonSelect:null,\n\t\trelid:null,\n\t\thandInput:\"false\",\n\t\trelurl:null,\n\t\tdataName:null,\n\t\tplaceholder:'',\n  \t\tallowClear:\"false\",\n  \t\tvalueObj:{code:'',caption:''}\n\t};\n})(window.jQuery);"
