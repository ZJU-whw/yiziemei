            "text": "/**\n * @Description:\n * @CreateAuthor: Mr_MN\n * @Date: 2019/10/16 16:10\n * @LastEditTime: 2019/10/16 16:10\n * @LastEditors: Administrator\n * @Version: 1\n * desc:引入自定义文件\n * 包括以下内容：\n * 1.对wings框架不兼容插件的替换：echarts\n * 2.blue_wings各个组件样式的引用\n */\n\nvar $wings_cdnurl = '/yxscx/theme/wings/blueWingsNew';\nif (\"undefined\" != typeof cdnurl) {\n    $wings_cdnurl = cdnurl;\n}\n/* 2023-06-01 add chen */\ndocument.write('<script src=\"/yxscx/theme/wings/zdyCommon/js/wingsDataTables.js\"></script>');\n\n//1.对wings框架不兼容插件的替换：echarts,以及一些wings框架js修改和wings框架没有的功能开发\ndocument.write('<script src=\"' + $wings_cdnurl + '/public/echarts.min.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/js/select.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/js/side_bar.js\"></script>');\n//2.blue_wings各个组件样式的引用\n// document.write('<link href=\"' + $wings_cdnurl + '/css/config.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/breadcrumb_nav.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/checkbox_radio.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/move.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/date.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/gird.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/grid_fzbtid.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/input.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/input_tree.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/input_tree1.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $wings_cdnurl + '/css/input_tree2.css\" rel=\"stylesheet\" />');\n// document.write('<link href=\"' + $w