            "size": 11876,
            "mimeType": "text/javascript",
            "text": "/**\n * @Description:According to their own needs, self-configuration\n * @CreateAuthor: Mr_MN\n * @Date: 2019/9/25 20:06\n * @LastEditTime: 2019/9/25 20:06\n * @LastEditors: Administrator\n * @Version: 1\n */\nvar $wings_cdnurl = '';\nif (\"undefined\" != typeof cdnurl) {\n    $wings_cdnurl = cdnurl;\n}\n/**\n *\n * wings框架的初始化文件合集\n * 默认引入即可\n *\n * */\n\n//兼容性IE低\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/excanvas.min.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/html5shiv.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/respond.min.js\"></script>');\n\n//[if lt IE 8]\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/jquery/1.10.2/jquery.min.js\"></script>');\n//[if !IE]>\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/jquery/2.1.1/jquery.min.js\"></script>');\n\n//基础样式\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/include/bootstrap/3.3.7/css/bootstrap.css\" rel=\"stylesheet\" />');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/bootstrap/3.3.7/js/bootstrap.min.js\"></script>');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/include/font/font-awesome.min.css\" rel=\"stylesheet\" />');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/include/bootstrap/3.3.7/css/bootstrap.wings.css\" rel=\"stylesheet\" />');\n// css框架样式\n//css styles\n//document.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/css.min.css\" rel=\"stylesheet\" />');\n//document.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/css-rtl.min.css\" rel=\"stylesheet\" />');\n//document.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/css-skins.min.css\" rel=\"stylesheet\" />');\n//[if lt IE 8]\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/css-ie.min.css\" rel=\"stylesheet\" />');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/exception_dialog.css\" rel=\"stylesheet\" />');\n\n//wings框架的js文件\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/js/common.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/js/wings.min.js\"></script>');\n//格式化后台传回的json数据\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/json2.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/json2.min.js\"></script>');\n//扩展jquery ajax 使之支持sword\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/js/SwordAdapter.js\"></script>');\n\n\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/plugins/dialog/bootstrap-dialog.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDialog/wingsDialog.js\"></script>');\n\n//tab\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsTab/wingsTab.js\"></script>');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsTab/wingsTab.css\" rel=\"stylesheet\" />');\n\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/plugins/bootstrapSuggest/bootstrap-suggest-forwings.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSuggest/wingsSuggest.js\"></script>');\n\n//进度条\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/plugins/progressbar/spin.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsprogressbar/wingsprogressbar.js\"></script>');\n\n// 左右选择器\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/plugins/move/multiselect.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsMove/wingsMove.js\"></script>');\n//不采用缓存的设置\ndocument.write('<META HTTP-EQUIV=\"pragma\" CONTENT=\"no-cache\">');\ndocument.write('<META HTTP-EQUIV=\"Cache-Control\" CONTENT=\"no-cache, must-revalidate\">');\ndocument.write('<META HTTP-EQUIV=\"expires\" CONTENT=\"0\">');\n\n/**\n *\n * 引入wings框架的各种明细组件\n * 根据项目需求，自行进行添加或删除\n *\n * */\n//wingsDateTime\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatetime/bootstrap-datetimepicker.min.css\" rel=\"stylesheet\" />');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatetime/bootstrap-datetimepicker.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatetime/bootstrap-datetimepicker.zh-CN.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatetime/wingsDatetime.js\"></script>');\n//wingsToolbar\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsToolbar/wingsToolbar.js\"></script>');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/css/wingsToolbars.css\" rel=\"stylesheet\" />');\n//select\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/select2.css\" rel=\"stylesheet\" />');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/wingsSelector.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/select2.js\"></script>');\n// wingsMultipleSelector\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/wingsMultipleSelector.js\"></script>');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/wingsSelect2.css\" rel=\"stylesheet\" />');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsSelector/wingsSelector2.js\"></script>');\n//gird\ndocument.write('<link rel=\"stylesheet\" type=\"text/css\" href=\"'+$wings_cdnurl+'/wings/include/plugins/datatable/1.10.12/css/jquery.dataTables.css\">');\ndocument.write('<link rel=\"stylesheet\" type=\"text/css\" href=\"'+$wings_cdnurl+'/wings/include/plugins/datatable/1.10.12/css/dataTables.bootstrap.css\">');\ndocument.write('<link rel=\"stylesheet\" type=\"text/css\" href=\"'+$wings_cdnurl+'/wings/core/plugins/wingsDatatable/wingsDataTables.css\">');\n//document.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatatable/wingsDataTables.min.css\" rel=\"stylesheet\" />');\ndocument.write('<script type=\"text/javascript\" src=\"'+$wings_cdnurl+'/wings/include/plugins/datatable/1.10.12/js/jquery.dataTables.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/plugins/datatable/1.10.12/js/jquery.dataTables.min.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsDatatable/wingsDataTables.min.js\"></script>');\ndocument.write('<script type=\"text/javascript\" src=\"'+$wings_cdnurl+'/wings/core/plugins/wingsDatatable/wingsDataTables.js\"></script>');\ndocument.write('<script type=\"text/javascript\" src=\"'+$wings_cdnurl+'/wings/core/plugins/wingsDatatable/extensions/wingsDataTables.plugins.js\"></script>');\n\n//wingsValidate\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/core/plugins/wingsValidate/wingsValidate.css\" rel=\"stylesheet\" />');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/common/jquery.validate.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsValidate/wingsValidate.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsValidate/wingsValidate2.js\"></script>');\n//wingsICheck\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/include/iCheck/icheck.min.js\"></script>');\ndocument.write('<script src=\"' + $wings_cdnurl + '/wings/core/plugins/wingsICheck/wingsICheck.js\"></script>');\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/include/iCheck/skins/all.css\" rel=\"stylesheet\" />');\n//tree\ndocument.write('<link href=\"' + $wings_cdnurl + '/wings/include/plugins/ztree/zTreeStyle/zTreeStyle.css\" rel=\"stylesheet\" />');\ndocument.write('<link href=\