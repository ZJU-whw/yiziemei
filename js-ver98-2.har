          "content": {
            "size": 18346,
            "mimeType": "text/html",
            "compression": 13340,
            "text": "\n<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\"/>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\"/>\n    <title>一户式查询基本信息</title>\n    \n\n\n<script type=\"text/javascript\" src=\"/yxscx/common/js/domain.js\"></script>\n<script type=\"text/javascript\"\n        src=\"/yxscx/theme/wings/blueWingsNew/public/common_wings_config.js\"></script>\n<script type=\"text/javascript\"\n        src=\"/yxscx/theme/wings/blueWingsNew/public/diy_wings_config.js\"></script>\n\n\n\n\n\n\n\n\n<link rel=\"stylesheet\" href=\"/wings/core/plugins/wingsFileUpload/wingsFileUpload.css\"/>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/vendor/jquery.ui.widget.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.iframe-transport.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-ui.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-process.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-image.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-audio.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-video.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/include/plugins/uploadfile/js/jquery.fileupload-validate.js\"></script>\n<script src=\"/wings/core/plugins/wingsFileUpload/wingsFileUpload.js\"></script>\n<!-- wingsUploader组件 -->\n<link href=\"/wings/include/webuploader/webuploader.css\" rel=\"stylesheet\">\n<script src=\"/wings/include/webuploader/webuploader.js\"></script>\n\n\n\n\n\n\n\n<!-- frametab & 手风琴  & tab -->\n<link href=\"/wings/core/plugins/wingsFrameTab/wingsFrameTab.css\" rel=\"stylesheet\">\n<link href=\"/wings/core/plugins/wingsAccordion/wingsAccordion.css\" rel=\"stylesheet\">\n<script src=\"/wings/core/plugins/wingsFrameTab/wingsFrameTab.js\"></script>\n<script src=\"/wings/core/plugins/wingsAccordion/wingsAccordion.js\"></script>\n\n<!-- 左右选择器 -->\n<script type=\"text/javascript\" src=\"/wings/include/plugins/move/multiselect.js\"></script>\n<script type=\"text/javascript\" src=\"/wings/core/plugins/wingsMove/wingsMove.js\"></script>\n\n\n<!-- menu -->\n<link rel=\"stylesheet\" href=\"/wings/core/plugins/wingsMenu/wingsMenuStyle.css\" />\n<script type=\"text/javascript\" src=\"/wings/core/plugins/wingsMenu/wingsMenu.js\"></script>\n\n<!-- wingsTabSelect -->\n<link href=\"/wings/core/plugins/wingsTabSelect/wingsTabSelect.css\" rel=\"stylesheet\">\n<script src=\"/wings/core/plugins/wingsTabSelect/wingsTabSelect.js\"></script>\n\n\n\n\n\n<link rel=\"stylesheet\" href=\"/yxscx/theme/wings/zdyCommon/css/uploading.css\"/>\n<link rel=\"stylesheet\" href=\"/yxscx/theme/wings/zdyCommon/css/wingsZdyCommon.css\"/>\n<link rel=\"stylesheet\" href=\"/yxscx/theme/wings/zdyCommon/css/zdyCommon.css\"/>\n\n\n<link type=\"text/css\" rel=\"stylesheet\" href=\"/yxscx/common/css/pages.css\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/yxscx/common/css/table_center.css\"/>\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/yxscx/common/watermark/watermark.css\"/>\n\n\n<script type=\"text/javascript\" src=\"/yxscx/common/js/crypto-js.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/theme/wings/zdyCommon/js/afterCommon.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/theme/wings/zdyCommon/js/zdyToolbar.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/js/numberFormat.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/js/common.js\"></script>\n<script type=\"text/javascript\" src=\"/wingWeb/domain.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/js/submitUtils.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/js/gy_utils.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/js/yxscxDownload.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/common/watermark/watermark.js\"></script>\n\n<script type=\"text/javascript\" src=\"/yxscx/common/js/commformat.js\"></script>\n<script type=\"text/javascript\" src=\"/yxscx/wings/wingsZdyInclude.js\"></script>\n\n\n<script type=\"text/javascript\" src=\"/yxscx/theme/wings/zdyCommon/js/exportPageData.js\"></script>\n\n<script>\n    //wingsGrid数据置空异常处理\n    /*var zdyAjaxLoading = {\n        opt: $.extend({}, wingsPageLoading_defaults, {}),\n        setOption: function (a) {\n            this.opt = $.extend({}, wingsPageLoading_defaults, a)\n        },\n        show: function (doc) {\n            var a = '<div class=\"modal-jbbackdrop\" style=\"background-color:transparent;\" >'\n                + ' <div class=\"wingsPageLoadingDiv\" ' + ' style=\"color:red;position: absolute;width:10%;height:15%;left:40%;top:40%;\"> '\n                + '<div class=\"pic\">加载中,请稍后...</div>' + '</div> ' + '</div>';\n            $(doc).append(a)\n        },\n        hide: function (doc) {\n            $(doc).find(\".modal-jbbackdrop\").remove();\n        }\n    };\n\n    (function ($) {\n            $.fn.wingsDataTables_old = $.fn.wingsDataTables;\n            $.fn.wingsDataTables = function (options) {\n                var $this = $(this).wingsDataTables_old(options);\n                $this.emptyData = function () {\n                    $this.gridData.trs = [];\n                    $this.gridData.rows = 0;\n                    $this.gridData.totalRows = 0;\n                    this.initData($this.gridData);\n                }\n                $this.setMask = function (isShow) {\n                    debugger;\n                    var tableId = $this.getOptions().tableId;\n                    if (tableId == undefined || tableId == 'undefined') {\n                        tableId = $this[0].id;\n                    }\n                    var tableDiVDoc = $('#' + tableId + '_wrapper');\n                    if (isShow) {\n                        zdyAjaxLoading.show(tableDiVDoc[0])\n                    } else {\n                        zdyAjaxLoading.hide(tableDiVDoc[0])\n                    }\n                }\n\n                return $this;\n            }\n            $.fn.wingsDataTables.defaults = $.fn.wingsDataTables_old.defaults;\n        }\n    )(window.jQuery);*/\n\n    var _onReady = {\n        //重新加载窗口高度，页面长度过长，导致弹窗显示位置异常处理\n        reWindowHeight: function () {\n            var dialog = $(\"body\", parent.document).find('div.modal-dialog');\n            if (!($('body').attr('zdyDialogHegiht') != undefined && $('body').attr('zdyDialogHegiht') == 'true')) {\n                if (dialog.length > 0) {\n                    if (window.parent.parent.innerHeight < window.parent.innerHeight) {\n                        var topId = window.parent.parent.document.getElementById(\"dhcxTopId\");\n                        var scrollTop = topId.scrollTop; //滚动距离\n                        var scrollHeight = topId.scrollHeight;//滚动条高度\n                        var clientHeight = topId.clientHeight;//页面高度\n                        //判断是否出现滚动条\n                        if (scrollHeight > clientHeight) {\n                            var topDiy = $(topId).find('div.diy-part');\n                            var height = scrollTop > clientHeight ? 100 : clientHeight / 3;\n                            var minHeight = topDiy[0].clientHeight + topDiy[1].clientHeight;\n                            height = minHeight + 100 > height ? minHeight + 100 : height;\n                            dialog.css('top', height + scrollTop + 'px');\n                        }\n                    }\n                }\n            }\n        },\n        //自定义设置样式\n        reDiyGridStyle: function () {\n            //增加grid表格的td值显示title鼠标悬浮显示文本\n            var wingsGrids = $('div[wings=\"WingsGrid\"]');\n            for (var i = 0; i < wingsGrids.length; i++) {\n                var gridName = $(wingsGrids[i]).attr('name');\n\n                var grid = $.wingsWidget(gridName);\n\n                //分页查询时处理默认点击排序异常(默认没有点击grid查询，点击表头抛出异常)\n                var ajaxParam = grid.getAjaxParam();\n                if (checkNull(grid.getOptions().ptid) && (!checkNull(ajaxParam) || JSON.stringify(ajaxParam) === '{}')) {\n                    grid.setAjaxParam({'gridName': gridName});\n                }\n\n                //wingsGrid数据置空优化，修复置空后点击排序报错异常\n                grid.emptyData = function () {\n                    var g = this.getOptions().name;\n                    $.wingsWidget(g).gridData.trs = [];\n                    $.wingsWidget(g).gridData.rows = 0;\n                    $.wingsWidget(g).gridData.totalRows = 0;\n                    $.wingsWidget(g).initData($.wingsWidget(g).gridData);\n                    $.wingsWidget(g).setAjaxParam({'gridName': g});\n\n                    //重置后去除排序箭头\n                    $('table[id^=\"' + g + '\"] a[sort=\"up\"]').addClass('wingsGridSort');\n                    $('table[id^=\"' + g + '\"] a[sort=\"up\"]').text('');\n                    $('table[id^=\"' + g + '\"] a[sort=\"down\"]').addClass('wingsGridSort');\n                    $('table[id^=\"' + g + '\"] a[sort=\"down\"]').text('');\n                    $('table[id^=\"' + g + '\"] a[sort=\"down\"]').attr('sort', 'up');\n                }\n\n                grid.initDataAfterCallback_old = grid.initDataAfterCallback;\n                grid.initDataAfterCallback = function () {\n                    var g = this.getOptions().name;\n                    $.wingsWidget(g).initDataAfterCallback_old();\n\n                    //增加表格标题属性\n                    addGridTdTitle(g);\n\n                    //回调页面数据初始完成绑定事件\n                    var afterInitDataFun = $.wingsWidget(g).getOptions().onAfterInitData;\n                    if (checkNull(afterInitDataFun)) {\n                        if (afterInitDataFun.indexOf('onAfterInitZdyShowHj') >= 0) {\n                            //$(\"#\" + g + \"_hjtr\").css(\"display\", \"none\");\n                            //onAfterInitZdyShowHj(g);\n                        } else {\n                            var _funs = afterInitDataFun.split(';');\n                            for (var i = 0; i < _funs.length; i++) {\n                                var a = _funs[i];\n                                if (checkNull(a) && afterInitDataFun.indexOf('onAfterInitZdyShowHj') < 0) {\n                                    // eval(a); /* 暂注释，自定义初始化Grid数据后多回调方法调用 */\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        },\n        //增加页面水印\n        addWatermark: function () {\n            //EncryptUtils.jmbz = true;\n            var sub = new WingsSubmit();\n            sub.setOptions({\n                async: \"true\",// 选填，默认true\n                ctrl: \"YxscxGyCtrl_getYmsybz\",\n                onSuccess: function (res) {\n                    var sybz = res.getAttr('sybz');\n                    if (sybz == \"Y\") {\n                        try {\n                            addWaterMark(res.getAttr('showText'));\n                        } catch (e) {\n                            console.log();\n                        }\n                    }\n                }\n            });\n            sub.setFunction(\"onException\", \"gyException()\");\n            sub.setFunction(\"onError\", \"Error()\");\n            sub.submit();\n        },\n        addUpdateDataTime: function () {//加载数据更新时间\n            //页面初始化缓存数据\n            var SwordPageData = $('#SwordPageData').attr('data');\n            if (checkNull(SwordPageData)) {\n                SwordPageData = $.parseJSON(SwordPageData).data;\n                var dhcxPageObj = \"\";\n                for (var i = 0; i < SwordPageData.length; i++) {\n                    if (SwordPageData[i].name == \"dhcxPageObj\") {\n                        dhcxPageObj = SwordPageData[i].value;\n                        break;\n                    }\n                }\n                if (checkNull(dhcxPageObj)) {\n                    var baseData = jQuery.parseJSON(dhcxPageObj);\n                    var updateDataTime = $(\"#updateDataTime\", parent.document);\n                    updateDataTime.empty();\n                    updateDataTime.css({\"top\": \"10px\", \"position\": \"absolute\", \"left\": \"\"});\n                    if (checkNull(baseData.updateTime)) {\n                        var head = $('div.diy-part-firstChild >div[wings=\"WingsForm\"]').attr('class');\n                        var fdph = $('div.diy-part-firstChild >div.part_header');\n                        var hiddenHead = $('div.firstChild-HiddenHead');\n                        var updateTimeStr = baseData.updateTime;\n                        //数据更新时间只保留到小时\n                        updateTimeStr = updateTimeStr.split(':')[0];\n                        if (checkNull(head) && fdph.length == 0 && head.indexOf('hidden_head') >= 0 || hiddenHead.length > 0) {\n                            updateDataTime.css({\"top\": \"0px\", \"background\": \"white\", \"position\": \"relative\", \"text-align\": \"right\", \"left\": \"0px\"});\n                            updateDataTime.append(\"<div style='margin-right: 20px;'><span>数据更新于：</span><span>\" + updateTimeStr + \"</span></div>\");\n                        } else {\n                            updateDataTime.append(\"<span>数据更新于：</span><span>\" + updateTimeStr + \"</span>\");\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n\n    $(function () {\n        try {\n            _onReady.reWindowHeight();\n            _onReady.reDiyGridStyle();\n            _onReady.addWatermark();\n            _onReady.addUpdateDataTime();\n        } catch (e) {\n            console.log('wingsZdyInclude.jsp公用加载初始化加载异常：' + e);\n        }\n    });\n\n</script>\n\n\n\n\n\n\n\n    <link rel=\"stylesheet\" href=\"/yxscx/yhscx/dhcx/dhcx000/common.css\" type=\"text/css\">\n    <link type=\"text/css\" rel=\"stylesheet\" href=\"/yxscx/yhscx/common/css/page_nsrxxList.css\"/>\n    <link rel=\"stylesheet\" href=\"/yxscx/yhscx/dhcx/dhcx000/dhcx.css\" type=\"text/css\">\n\n    <script src=\"/yxscx/common/js/wbxt.js\"></script>\n    <script type=\"text/javascript\" src=\"/yxscx/yhscx/dhcx/dhcx000/dhcx.js\"></script>\n    <style>\n        .contentItem {\n            width: 100%;\n        }\n\n        .pageframe {\n            background: linear-gradient(90deg, rgba(102, 125, 182, 1) 0%, rgba(102, 125, 182, 1) 0%, rgba(80, 123, 181, 1) 20%, rgba(0, 127, 195, 1) 39%, rgba(0, 126, 196, 1) 59%, rgba(21, 126, 192, 1) 72%, rgba(90, 122, 179, 1) 87%, rgba(102, 125, 181, 1) 100%, rgba(102, 125, 181, 1) 100%);\n        }\n    </style>\n</head>\n<body id=\"dhcxTopId\">\n<div wings=\"PageInit\" onSuccess=\"initSuccess();\"></div>\n<div class=\"diy-part\" data-margin-top=\"15\" style=\"position: relative;\" id=\"nsrxxList_content_box\">\n    <div class=\"nsrxxList_content nsrxxList_content_qyxx nsrxxList_content_dhcx\">\n        <div class=\"img\"></div>\n        <div>\n            <div class=\"qyxx_title\">\n                <span id=\"nsrmc\"></span> <span class=\"nsrzt\" id=\"nsrztmc\"></span> <span id=\"kjjypzl\" style=\"margin-left: 10px\"></span>\n            </div>\n            <div class=\"qyxx_jbxx\">\n                <div class=\"float\">\n                    <span style=\"text-align: left;width: auto;\">统一社会信用代码（纳税人识别号）：</span> <span id=\"shxydm\" style=\"width:auto\"></span>\n                </div>\n                <div class=\"float\">\n                    <!--一体式